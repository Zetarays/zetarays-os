msgid "usage: zeta-ssh remote on|off"
msgstr "uso: zeta-ssh remote on|off"

#: usr/local/bin/zeta-ssh:366
msgid "Usage:\n  zeta-ssh status             on or off, from where, addresses\n  zeta-ssh on                 turn the server on, port 22 open to the local network ONLY\n  zeta-ssh remote on          port 22 open from the internet too (needs the router)\n  zeta-ssh remote off         back to the local network only\n  zeta-ssh off                turn the server off and close the port\n  zeta-ssh config             SSH_ENABLED / SSH_PORT / SSH_REMOTE_ACCESS\n  zeta-ssh diagnose           check the whole path, network card → sshd\n  zeta-ssh sync               put the saved choice back into the firewall sets"
msgstr "Uso:\n  zeta-ssh status             acceso o spento, da dove, indirizzi\n  zeta-ssh on                 accende il server, porta 22 aperta alla SOLA rete locale\n  zeta-ssh remote on          porta 22 aperta anche da internet (serve il router)\n  zeta-ssh remote off         torna alla sola rete locale\n  zeta-ssh off                spegne il server e chiude la porta\n  zeta-ssh config             SSH_ENABLED / SSH_PORT / SSH_REMOTE_ACCESS\n  zeta-ssh diagnose           controlla tutto il percorso, scheda di rete → sshd\n  zeta-ssh sync               rimette la scelta salvata negli insiemi del firewall"


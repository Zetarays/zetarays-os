msgid "Opens an installed app (common name or executable)."
msgstr "Apre un'applicazione installata (nome comune o eseguibile)."

#: usr/lib/zeta/intelligence/actions.py:196
msgid "Opens a folder in the file manager (e.g. documents, downloads, pictures, or a path)."
msgstr "Apre una cartella nel gestore file (es. documenti, download, immagini, o un percorso)."


# ZETA RAYS 2.0 — pacchetti (solo repository Debian 13 "trixie")

# --- Sistema di base ---
live-boot
live-config
live-config-systemd
user-setup
systemd-sysv
sudo
locales
console-setup
keyboard-configuration
dbus-user-session
polkitd
pkexec
network-manager
wpasupplicant
bluez
pipewire
pipewire-pulse
pipewire-alsa
# Priorita in tempo reale per l'audio: senza, PipeWire ripiega su una priorita
# normale e sotto carico (compilazioni, il modello AI al lavoro) l'audio puo
# scattare. PipeWire lo raccomanda, ma la costruzione non installa le
# raccomandazioni: va chiesto esplicitamente.
rtkit
wireplumber
plymouth
librsvg2-bin
ca-certificates
curl
nano
htop

# --- Programmi: Flatpak e AppImage ---
# Flatpak (con Flathub) e le AppImage come app vere del sistema: nel menu,
# nel Dock, nella ricerca, con icona e percorso (zeta-app). libfuse2 serve
# alle AppImage per avviarsi; unsquashfs ne legge nome e icona senza
# eseguirle.
flatpak
libfuse2t64
squashfs-tools

# --- Password dei server ---
# «Ricorda la password» di Connetti a un server (e del gestore file) la
# salva nel portachiavi, sbloccato all'accesso (PAM di SDDM gia' predisposto)
gnome-keyring
libpam-gnome-keyring

# --- Orologio ---
# Senza un client NTP l'ora veniva solo dall'orologio della macchina: con
# VMware Fusion o accanto a Windows (orologio in ora locale) restava sbagliata
# di due ore. timesyncd la corregge appena c'e' internet; gli strumenti VMware
# la prendono dal Mac anche senza rete (partono solo dentro VMware).
systemd-timesyncd
open-vm-tools

# --- Firmware ---
firmware-linux-free
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
#if ARCHITECTURES amd64
firmware-amd-graphics
intel-microcode
amd64-microcode
#endif


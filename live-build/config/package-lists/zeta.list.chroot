# Sviluppo
git
build-essential
python3-dev
rustc
cargo
golang-go
gdb
# ZETA RAYS Monitor
iproute2
iputils-ping
# comandi di rete tradizionali e moderni: ifconfig/route/arp/netstat,
# stato delle schede di rete e del Wi-Fi, percorso dei pacchetti
net-tools
ethtool
iw
# rfkill: dice se il Wi-Fi e' spento da un tasto o da un interruttore (diagnosi)
rfkill
# tracepath (percorso e MTU senza root)
iputils-tracepath
# iptables/ip6tables: in Debian usano il motore nftables (iptables-nft), quindi
# non creano un secondo firewall; il firewall vero resta la tabella inet zeta.
# ufw c'e' (richiesto), ma SPENTO di serie: il firewall attivo resta nftables
# (inet zeta). Le sue regole per SSH e ZETA Share sono gia' pronte, cosi' chi
# lo accende con «ufw enable» non si chiude fuori (vedi zeta-ssh e hook 0100).
iptables
ufw
# conntrack: per vedere le connessioni seguite dal firewall (zeta-ssh diagnosi)
conntrack
# accesso remoto: client e server SSH (server spento di serie, zeta-ssh attiva),
# trasferimenti e cartelle remote, netcat/socat/telnet per le prove di rete,
# autossh per i tunnel che si rialzano da soli, ssh-import-id per le chiavi
openssh-client
openssh-server
openssh-sftp-server
sshfs
netcat-openbsd
socat
telnet
autossh
ssh-import-id
traceroute
mtr-tiny

# --- Installer ZETA RAYS (Calamares) ---
calamares
calamares-settings-debian
qt6-wayland
qml6-module-qtquick
qml6-module-qtquick-controls
qml6-module-qtquick-layouts
qml6-module-qtquick-templates
qml6-module-qtquick-window
qml6-module-qtqml-workerscript
rsync
x11-xserver-utils
# servono all'installer: estrarre il sistema, registrare l'avvio UEFI
squashfs-tools
efibootmgr
os-prober
# hwclock: il passo «hwclock» dell'installer lo cerca per allineare l'orologio
# del computer (conta con il doppio avvio: gli altri sistemi lo leggono)
util-linux-extra
# dosfstools: mkfs.fat. Senza, l'installer non puo' creare la partizione EFI
# (fat32 non compare tra i file system). Su arm64 arrivava come dipendenza,
# su amd64 no: va scritto qui.
dosfstools
grub-common
#if ARCHITECTURES amd64
grub-efi-amd64
# PC senza UEFI (BIOS): moduli GRUB i386-pc
grub-pc-bin
# Avvio sicuro DOPO l'installazione. Senza questi due, la ISO parte con Secure
# Boot attivo ma il sistema installato no: l'installer scrive un GRUB non
# firmato, che il firmware rifiuta. Chi ha Secure Boot attivo (quasi tutti i
# computer recenti) si ritrova un computer che non parte piu'.
shim-signed
grub-efi-amd64-signed
#endif
#if ARCHITECTURES arm64
grub-efi-arm64
shim-signed
grub-efi-arm64-signed
#endif

# --- ZETA RAYS 2.0: ricerca universale, OCR, indicizzazione, fastfetch ---
fastfetch
plocate
poppler-utils
tesseract-ocr
tesseract-ocr-ita
tesseract-ocr-eng
imagemagick
# vosk (voce) e ollama (AI locale) sono installati dagli hook 0200/0300
python3-pip
python3-venv
curl
unzip
zstd

# --- Voce di ZETA: sintesi vocale offline (italiano) ---
espeak-ng
espeak-ng-data

# --- Scrivania: cartelle personali in italiano, apertura dei file ---
xdg-user-dirs
xdg-utils
shared-mime-info
desktop-file-utils
libglib2.0-bin

# --- Stabilità: niente blocchi quando la memoria finisce ---
# earlyoom ferma il programma più affamato prima che il sistema si impianti;
# zram aggiunge swap compressa in RAM (utile nelle macchine virtuali piccole).
earlyoom
zram-tools

# --- Gestore file completo e accessibilità -------------------------------
# tumbler genera le anteprime di immagini, PDF e video nel gestore file:
# senza, si vedono solo icone generiche.
tumbler
tumbler-plugins-extra
ffmpegthumbnailer
# at-spi2-core fornisce il bus di accessibilità che le applicazioni GTK
# cercano all'avvio: senza di esso ogni app stampa un avviso e gli strumenti
# di accessibilità non possono funzionare.
at-spi2-core

# --- Aprire qualunque file: formati che un computer deve saper leggere -----
# Archivi. Senza questi, Gestione archivi mostra l'archivio ma non riesce ad
# aprirlo: RAR e 7z erano dichiarati fra i tipi gestiti senza che ci fosse chi
# li sa leggere davvero.
p7zip-full
unar
zip
xz-utils
bzip2
lzip
cpio
# Immagini moderne: senza questi moduli eog e le anteprime del gestore file
# non aprono WEBP, HEIC (le foto degli iPhone) e AVIF.
webp-pixbuf-loader
heif-gdk-pixbuf
libheif1
# Caratteri: doppio clic su un .ttf o .otf mostra l'anteprima del carattere
gnome-font-viewer
# Codec video e audio completi per il riproduttore (AVI, WMV, MPEG, AAC...)
libavcodec-extra
gstreamer1.0-libav
gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad

# --- Supporti rimovibili e risorse di rete ---
# Senza questi una chiavetta USB inserita non compariva nel gestore file e le
# cartelle condivise in rete o i telefoni collegati non si potevano aprire.
thunar-volman
gvfs-backends
gvfs-fuse

# --- Stampa ---
# Senza questi il sistema non poteva stampare in nessun modo. Il servizio resta
# a riposo finche non si stampa (si attiva sul socket), quindi non pesa
# sull'avvio. cups-browsed + avahi trovano da soli le stampanti di rete.
cups
cups-client
cups-filters
cups-browsed
printer-driver-gutenprint
# Stampanti USB moderne senza driver (IPP su USB) e i driver delle marche
# piu' diffuse che non parlano IPP: HP, Epson, Brother.
ipp-usb
printer-driver-hpcups
printer-driver-escpr
printer-driver-brlaser
system-config-printer
avahi-daemon
# Risolve i nomi «.local» (stampante-ufficio.local): senza, le stampanti di
# rete trovate non si potevano aggiungere senza driver.
libnss-mdns
# App isolation: the kernel has AppArmor on; this loads Debian's profiles
# (as on a standard Debian install) so Security shows it active
apparmor

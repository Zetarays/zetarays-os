# Development
git
build-essential
python3-dev
rustc
cargo
golang-go
gdb
# ZETA RAYS Monitor
iproute2
iputils-ping
# traditional and modern network commands: ifconfig/route/arp/netstat,
# state of network interfaces and Wi-Fi, packet path
net-tools
ethtool
iw
# rfkill: tells whether Wi-Fi is turned off by a key or a switch (diagnostics)
rfkill
# tracepath (path and MTU without root)
iputils-tracepath
# iptables/ip6tables: on Debian they use the nftables engine (iptables-nft), so
# they do not create a second firewall; the real firewall stays the inet zeta
# table. ufw is present (requested) but OFF by default: the active firewall
# stays nftables (inet zeta). Its rules for SSH and ZETA Share are already in
# place, so whoever turns it on with "ufw enable" does not lock themselves out
# (see zeta-ssh and hook 0100).
iptables
ufw
# conntrack: to see the connections tracked by the firewall (zeta-ssh diagnose)
conntrack
# remote access: SSH client and server (server off by default, zeta-ssh turns
# it on), transfers and remote folders, netcat/socat/telnet for network tests,
# autossh for tunnels that come back up on their own, ssh-import-id for keys
openssh-client
openssh-server
openssh-sftp-server
sshfs
netcat-openbsd
socat
telnet
autossh
ssh-import-id
traceroute
mtr-tiny

# --- ZETA RAYS installer (Calamares) ---
calamares
calamares-settings-debian
qt6-wayland
qml6-module-qtquick
qml6-module-qtquick-controls
qml6-module-qtquick-layouts
qml6-module-qtquick-templates
qml6-module-qtquick-window
qml6-module-qtqml-workerscript
rsync
x11-xserver-utils
# needed by the installer: extract the system, register the UEFI boot entry
squashfs-tools
efibootmgr
os-prober
# hwclock: the installer's "hwclock" step looks for it to sync the computer's
# clock (matters with dual boot: the other systems read it)
util-linux-extra
# dosfstools: mkfs.fat. Without it, the installer cannot create the EFI
# partition (fat32 does not appear among the file systems). On arm64 it came
# in as a dependency, on amd64 it did not: it must be listed here.
dosfstools
grub-common
#if ARCHITECTURES amd64
grub-efi-amd64
# PCs without UEFI (BIOS): GRUB i386-pc modules
grub-pc-bin
# Secure boot AFTER installation. Without these two, the ISO boots with Secure
# Boot on but the installed system does not: the installer writes an unsigned
# GRUB, which the firmware rejects. Anyone with Secure Boot on (almost every
# recent computer) ends up with a computer that no longer boots.
shim-signed
grub-efi-amd64-signed
#endif
#if ARCHITECTURES arm64
grub-efi-arm64
shim-signed
grub-efi-arm64-signed
#endif

# --- ZETA RAYS 2.0: universal search, OCR, indexing, fastfetch ---
fastfetch
plocate
poppler-utils
tesseract-ocr
tesseract-ocr-ita
tesseract-ocr-eng
imagemagick
# vosk (voice) and ollama (local AI) are installed by hooks 0200/0300
python3-pip
python3-venv
curl
unzip
zstd

# --- ZETA's voice: offline speech synthesis (Italian) ---
espeak-ng
espeak-ng-data

# --- Desktop: localized personal folders, opening files ---
xdg-user-dirs
xdg-utils
shared-mime-info
desktop-file-utils
libglib2.0-bin

# --- Stability: no freezes when memory runs out ---
# earlyoom stops the hungriest program before the system grinds to a halt;
# zram adds compressed swap in RAM (useful in small virtual machines).
earlyoom
zram-tools

# --- Full file manager and accessibility ---------------------------------
# tumbler generates thumbnails of images, PDFs and videos in the file manager:
# without it, only generic icons are shown.
tumbler
tumbler-plugins-extra
ffmpegthumbnailer
# at-spi2-core provides the accessibility bus that GTK applications look for
# at startup: without it every app prints a warning and accessibility tools
# cannot work.
at-spi2-core

# --- Open any file: formats a computer must be able to read ----------------
# Archives. Without these, the archive manager shows the archive but cannot
# open it: RAR and 7z were declared as supported types with nothing installed
# that could actually read them.
p7zip-full
unar
zip
xz-utils
bzip2
lzip
cpio
# Modern images: without these modules eog and the file manager thumbnails
# cannot open WEBP, HEIC (iPhone photos) and AVIF.
webp-pixbuf-loader
heif-gdk-pixbuf
libheif1
# Fonts: double-clicking a .ttf or .otf shows a preview of the font
gnome-font-viewer
# Full video and audio codecs for the player (AVI, WMV, MPEG, AAC...)
libavcodec-extra
gstreamer1.0-libav
gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad

# --- Removable media and network resources ---
# Without these an inserted USB stick did not appear in the file manager, and
# network shared folders or connected phones could not be opened.
thunar-volman
gvfs-backends
gvfs-fuse

# --- Printing ---
# Without these the system could not print at all. The service stays idle
# until something is printed (socket activation), so it does not slow down
# boot. cups-browsed + avahi find network printers on their own.
cups
cups-client
cups-filters
cups-browsed
printer-driver-gutenprint
# Modern driverless USB printers (IPP over USB) and the drivers for the most
# common brands that do not speak IPP: HP, Epson, Brother.
ipp-usb
printer-driver-hpcups
printer-driver-escpr
printer-driver-brlaser
system-config-printer
avahi-daemon
# Resolves ".local" names (office-printer.local): without it, discovered
# network printers could not be added driverless.
libnss-mdns
# App isolation: the kernel has AppArmor on; this loads Debian's profiles
# (as on a standard Debian install) so Security shows it active
apparmor

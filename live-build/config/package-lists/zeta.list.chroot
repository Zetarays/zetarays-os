# ZETA RAYS 2.0 — packages (Debian 13 "trixie" repositories only)

# --- Base system ---
live-boot
live-config
live-config-systemd
user-setup
systemd-sysv
sudo
locales
console-setup
keyboard-configuration
dbus-user-session
polkitd
pkexec
network-manager
wpasupplicant
bluez
pipewire
pipewire-pulse
pipewire-alsa
# Real-time priority for audio: without it, PipeWire falls back to normal
# priority and under load (compiling, the AI model at work) the audio can
# stutter. PipeWire recommends it, but the build does not install
# recommendations: it has to be requested explicitly.
rtkit
wireplumber
plymouth
librsvg2-bin
ca-certificates
curl
nano
htop

# --- Programs: Flatpak and AppImage ---
# Flatpak (with Flathub) and AppImages as real system apps: in the menu, in
# the Dock, in search, with icon and path (zeta-app). AppImages need libfuse2
# to start; unsquashfs reads their name and icon without running them.
flatpak
libfuse2t64
squashfs-tools

# --- Server passwords ---
# "Remember password" in Connect to Server (and in the file manager) saves it
# in the keyring, unlocked at login (SDDM's PAM is already set up for it)
gnome-keyring
libpam-gnome-keyring

# --- Clock ---
# Without an NTP client the time came only from the machine's clock: with
# VMware Fusion or alongside Windows (clock in local time) it stayed two hours
# off. timesyncd fixes it as soon as there is internet; the VMware tools take
# it from the Mac even without a network (they only start inside VMware).
systemd-timesyncd
open-vm-tools

# --- Firmware ---
firmware-linux-free
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
#if ARCHITECTURES amd64
firmware-amd-graphics
intel-microcode
amd64-microcode
#endif

# --- Interface ---
# Hyprland 0.55 from the official Debian 13 backports (config/archives)
hyprland
# Hyprland system dialogs (avoids the warning at startup)
hyprland-guiutils
xwayland
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
# Xorg: used ONLY by the installer (Calamares/Qt) when 3D acceleration is
# missing, where the Wayland desktop cannot start. Qt draws in raster mode and
# works anywhere in software (llvmpipe).
xinit
matchbox-window-manager
xserver-xorg-video-fbdev
# Mesa software driver (llvmpipe) for rendering without a GPU
libgl1-mesa-dri
mesa-utils-bin
waybar
gir1.2-gtk4layershell-1.0
libgtk4-layer-shell0
mako-notifier
libnotify-bin
swaybg
wl-clipboard
grim
slurp
brightnessctl
hyprlock
hypridle
# login records (Monitor → Users)
wtmpdb
libpam-wtmpdb
network-manager-openvpn
# authentication agent (password dialog) with Italian translation
mate-polkit
sddm
qml6-module-qtquick
qt6-svg-plugins
xserver-xorg-core
xserver-xorg-input-libinput


# Languages of ZETA RAYS OS (the live session starts in English; the installer
# and Settings > Language & Region switch the whole system).

# Fonts for every script of the supported languages: Latin, Greek, Cyrillic,
# Hebrew, Arabic/Persian, Devanagari, Bengali, Chinese, Japanese, Korean, emoji
fonts-noto-core
fonts-noto-cjk
fonts-noto-color-emoji

# Input methods for Chinese, Japanese and Korean (Fcitx 5, Wayland-native)
fcitx5
fcitx5-frontend-gtk3
fcitx5-frontend-gtk4
fcitx5-frontend-qt5
fcitx5-frontend-qt6
fcitx5-config-qt
fcitx5-mozc
fcitx5-chinese-addons
fcitx5-hangul
fcitx5-chewing


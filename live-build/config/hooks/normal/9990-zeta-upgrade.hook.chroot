#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — last step: apt update + apt upgrade inside the image.
# live-build already installs the latest Debian 13 versions (with security
# updates), but this makes sure nothing is left to upgrade at build time,
# and records it in the log.
set -e
export DEBIAN_FRONTEND=noninteractive
for attempt in 1 2 3; do
  if apt-get update -q && apt-get -y -q -o Dpkg::Options::=--force-confold upgrade \
     && apt-get -y -q -o Dpkg::Options::=--force-confold dist-upgrade; then
    break
  fi
  # in the emulated amd64 build Python sometimes crashes: retry
  dpkg --configure -a || true
  [ "$attempt" = 3 ] && { echo "ZETA RAYS: package upgrade failed" >&2; exit 1; }
done
# Hyprland: must stay the patched build (+zeta2, pinned by hook 0350)
V=$(dpkg-query -W -f='${Version}' hyprland)
case "$V" in
  *+zeta2) ;;
  *) echo "ZETA RAYS: ERROR, the upgrade installed Hyprland $V without the patches" >&2; exit 1 ;;
esac
echo "ZETA RAYS: Hyprland after the upgrade: $V"
n=$(apt list --upgradable 2>/dev/null | grep -c / || true)
# build.sh greps this exact line in the build log: keep its wording unchanged
echo "ZETA RAYS: packages upgraded, still upgradable: $n"
[ "$n" = 0 ] || { apt list --upgradable 2>/dev/null; exit 1; }
apt-get clean
# lean initramfs (zeta-slim hook): with 768 MB of RAM a 115 MB one would
# not unpack and the kernel panicked. Regenerate it and check its size.
update-initramfs -u -k all
for i in /boot/initrd.img-*; do
  m=$(( $(stat -c %s "$i") / 1048576 ))
  echo "ZETA RAYS: initramfs $(basename "$i"): $m MB"
  [ "$m" -le 80 ] || { echo "ZETA RAYS: ERROR, initramfs too large ($m MB)" >&2; exit 1; }
done

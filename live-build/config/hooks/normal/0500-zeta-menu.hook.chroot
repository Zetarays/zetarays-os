#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — application menu cleanup.
#
# Some packages install menu entries that make no sense to the user: internal
# tools (ImageMagick), duplicates (three entries for the same terminal), panels
# that ZETA RAYS replaces with its own, and above all the Calamares installer,
# which presents itself as "Install Debian".
#
# Package files are not modified: copies are written to
# /usr/local/share/applications, which takes precedence under the XDG spec.
# That way the entry disappears everywhere (launcher, search, dock, "open
# with") and a package upgrade does not undo the change.
set +e

SRC=/usr/share/applications
DST=/usr/local/share/applications
mkdir -p "$DST"

# ids of the entries to hide (wildcards are accepted too)
HIDE="
calamares-install-debian.desktop calamares.desktop
display-im*.desktop
footclient.desktop foot-server.desktop
thunar-settings.desktop thunar-bulk-rename.desktop thunar-volman-settings.desktop
nm-connection-editor.desktop nm-applet.desktop
blueman-manager.desktop blueman-adapters.desktop
pavucontrol.desktop org.pulseaudio.pavucontrol.desktop
org.gnome.SystemMonitor.desktop gnome-system-monitor.desktop gnome-system-monitor-kde.desktop
vim.desktop nvim.desktop htop.desktop lynis.desktop
fish.desktop
lxpolkit.desktop debian-xterm.desktop debian-uxterm.desktop
org.gnome.Evince-previewer.desktop org.freedesktop.IBus.Setup.desktop
org.gnome.font-viewer.desktop
xfce4-about.desktop qv4l2.desktop qvidcap.desktop
org.fcitx.*.desktop fcitx5-configtool.desktop fcitx5-wayland-launcher.desktop kbd-layout-viewer5.desktop
"

hidden=0
for pattern in $HIDE; do
    for f in $SRC/$pattern; do
        [ -f "$f" ] || continue
        id=$(basename "$f")
        # copy with NoDisplay=true right after [Desktop Entry] (never at the
        # end: it would land inside a [Desktop Action] group and not apply)
        awk '
            /^NoDisplay[ \t]*=/ { next }
            { print }
            /^\[Desktop Entry\]/ && !done { print "NoDisplay=true"; done = 1 }
        ' "$f" > "$DST/$id" 2>/dev/null && hidden=$((hidden + 1))
    done
done
echo "ZETA RAYS: hid $hidden irrelevant menu entries"

update-desktop-database "$DST" >/dev/null 2>&1
update-desktop-database "$SRC" >/dev/null 2>&1
exit 0

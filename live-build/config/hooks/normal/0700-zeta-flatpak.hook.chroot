#!/bin/sh
# ZETA RAYS — Flathub, the official Flatpak app catalog, ready out of the box:
# «flatpak install flathub org.gimp.GIMP» or the website's «Install» button
# (a .flatpakref file, opened by zeta-app) work right away.
# Fatal: without the catalog, Flatpak apps cannot be installed.
set -e
for attempt in 1 2 3; do
    if flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo; then
        break
    fi
    [ "$attempt" = 3 ] && { echo "ZETA RAYS: ERROR, Flathub unreachable" >&2; exit 1; }
    sleep 10
done
flatpak remotes --system | grep -q '^flathub' || { echo "ZETA RAYS: ERROR, Flathub is missing" >&2; exit 1; }
echo "ZETA RAYS: Flathub configured"

#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — Ollama (local AI model) for ZETA, offline.
# Installs the Ollama runtime and sets up the local model (qwen3:4b-instruct).
# FATAL on purpose: AI is a core feature of ZETA RAYS, and an image without the
# engine or the model is a broken product. If anything here fails, the build
# stops instead of shipping a system in which ZETA stays silent.
set +e

ARCH="$(uname -m)"
case "$ARCH" in
    aarch64|arm64) OARCH=arm64 ;;
    x86_64|amd64)  OARCH=amd64 ;;
    *) echo "ZETA RAYS: ERROR - architecture $ARCH not supported by Ollama." >&2; exit 1 ;;
esac

echo "ZETA RAYS: installing the Ollama runtime ($OARCH)…"
# The runtime ships with the image (build.sh takes it from the local cache):
# this way the build doesn't depend on the network. Downloading remains only
# as a last resort, in case the file is missing for some reason.
BUNDLED=/usr/share/zeta/ollama-runtime.tar.zst
if [ -s "$BUNDLED" ]; then
    echo "ZETA RAYS: using the Ollama runtime bundled in the image"
    mv "$BUNDLED" /tmp/ollama.tar.zst
else
    URL="https://github.com/ollama/ollama/releases/latest/download/ollama-linux-${OARCH}.tar.zst"
    echo "ZETA RAYS: runtime not bundled, trying to download it…"
    if ! curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors --max-time 1800 \
              -o /tmp/ollama.tar.zst "$URL"; then
        # This used to carry on silently: the image shipped with the model
        # but without the engine, ZETA didn't answer and the build still
        # reported success. Better to stop.
        echo "ZETA RAYS: ERROR - could not obtain the Ollama runtime." >&2
        echo "ZETA RAYS: AI cannot work without the engine: build aborted." >&2
        exit 1
    fi
fi
# .tar.zst archive (zstd)
if command -v zstd >/dev/null 2>&1; then
    zstd -d -c /tmp/ollama.tar.zst | tar -C /usr -xf -
else
    tar --zstd -C /usr -xf /tmp/ollama.tar.zst
fi
rm -f /tmp/ollama.tar.zst
# the GPU libraries (CUDA/ROCm) are useless on VMs/CPU: removing them frees ~1.4 GB
rm -rf /usr/lib/ollama/cuda_* /usr/lib/ollama/rocm* /usr/lib/ollama/*jetpack* 2>/dev/null

if [ ! -x /usr/bin/ollama ]; then
    echo "ZETA RAYS: ERROR - ollama binary missing after extraction." >&2
    exit 1
fi
# build.sh greps for this exact line to confirm the AI is really in the image:
# do not change its text.
echo "ZETA RAYS: Ollama runtime installed ($(/usr/bin/ollama --version 2>/dev/null | head -1))"

# service user and (shared) models folder
getent group ollama >/dev/null || groupadd -r ollama
getent passwd ollama >/dev/null || useradd -r -g ollama -d /usr/share/ollama -s /usr/sbin/nologin ollama
mkdir -p /usr/share/ollama/.ollama/models
chown -R ollama:ollama /usr/share/ollama

# system service
cat > /etc/systemd/system/ollama.service <<'UNIT'
[Unit]
Description=Ollama — local AI model of ZETA RAYS
# network.target only: Ollama listens on 127.0.0.1 and doesn't need the
# network; with network-online, startup waited for a connection (up to 60 s
# without Wi-Fi)
After=network.target

[Service]
Type=simple
User=ollama
Group=ollama
Environment="HOME=/usr/share/ollama"
Environment="OLLAMA_MODELS=/usr/share/ollama/.ollama/models"
# The model folder bundled in the image may end up owned by root because of
# the order in which live-build applies the files. Ollama runs as the "ollama"
# user and without access it can't even write its own key: it dies in a loop
# and the AI never starts. This step, run as root (+) only when needed,
# guarantees the right permissions at every boot without depending on when
# the build happened. It only touches what isn't already owned by ollama.
ExecStartPre=+/bin/sh -c 'find /usr/share/ollama ! -user ollama -exec chown ollama:ollama {} + 2>/dev/null || true'
ExecStart=/usr/bin/ollama serve
Restart=on-failure
RestartSec=3
# lightweight when idle
Nice=5
# The local model must not be able to freeze the whole computer: on machines
# with little RAM, without these limits the system would swap and look frozen.
# Here the model gets stopped instead of dragging the desktop down with it.
CPUWeight=30
MemoryHigh=45%
MemoryMax=60%
OOMPolicy=stop
# unload the model from RAM after 5 minutes of inactivity
Environment="OLLAMA_KEEP_ALIVE=5m"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
# These two don't make it faster: measured, they don't change the timings.
# They cap the worst case. Without them, a burst of questions can make Ollama
# open several contexts at once (each with its own memory) and queue hundreds
# of requests: on paper that is capacity, on a Mini PC it is the moment memory
# runs out and the computer freezes. One at a time, with a short queue, is
# what a single-user computer needs.
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_MAX_QUEUE=64"
# Compressed context memory (8 bits instead of 16): measured in a VM, same
# speed (81 tokens/s) and about 60 MB less; it requires flash attention, which
# is requested explicitly here instead of being left on "auto".
Environment="OLLAMA_FLASH_ATTENTION=1"
Environment="OLLAMA_KV_CACHE_TYPE=q8_0"

[Install]
WantedBy=multi-user.target
UNIT
systemctl enable ollama.service >/dev/null 2>&1

# The model (qwen3:4b-instruct, ~2.5 GB) is already in the image: it lives in
# includes.chroot/usr/share/ollama/.ollama/models and is identical for all
# architectures (it's just weights). Downloading it here with "ollama pull"
# depended on the network and on the emulated Ollama server: under x86
# emulation it timed out and the amd64 image shipped without the model. Now it
# is downloaded only if, for some reason, it is missing.
export HOME=/usr/share/ollama
export OLLAMA_MODELS=/usr/share/ollama/.ollama/models
MODEL=qwen3:4b-instruct
MANIFEST=/usr/share/ollama/.ollama/models/manifests/registry.ollama.ai/library/${MODEL%%:*}/${MODEL#*:}
if [ -f "$MANIFEST" ]; then
    echo "ZETA RAYS: model $MODEL already present in the image"
else
    echo "ZETA RAYS: model missing, trying to download it…"
    /usr/bin/ollama serve >/tmp/ollama-serve.log 2>&1 &
    OPID=$!
    i=0
    while [ $i -lt 40 ]; do
        curl -fsS http://127.0.0.1:11434/ >/dev/null 2>&1 && break
        i=$((i + 1)); sleep 2
    done
    if timeout 2400 /usr/bin/ollama pull "$MODEL" >/tmp/ollama-pull.log 2>&1; then
        echo "ZETA RAYS: model $MODEL downloaded"
    else
        echo "ZETA RAYS: ERROR - no model for the AI." >&2
        kill "$OPID" 2>/dev/null
        exit 1
    fi
    kill "$OPID" 2>/dev/null
    wait "$OPID" 2>/dev/null
fi
chown -R ollama:ollama /usr/share/ollama

exit 0

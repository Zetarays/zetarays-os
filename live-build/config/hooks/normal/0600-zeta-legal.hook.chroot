#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — legal documents generated from the actual image.
#
# The list of components and licenses is not written by hand: it is read from
# the package database of THIS image, at the time it is built. A hand-written
# list would go stale at the first package added, and a legal document that
# lists the wrong things is worse than no document at all.
set +e

python3 - <<'PYEND'
import collections
import json
import os
import re
import shutil
import time

DEST = "/usr/share/zeta/legal"
os.makedirs(DEST, exist_ok=True)
# Release version: from /etc/os-release, written by hook 0100 from VERSION
VERSION = ""
with open("/etc/os-release", encoding="utf-8") as f:
    for line in f:
        if line.startswith("VERSION_ID="):
            VERSION = line.split("=", 1)[1].strip().strip('"')

# --- packages actually installed ---
status = open("/var/lib/dpkg/status", encoding="utf-8", errors="replace").read()
packages = {}
for block in status.split("\n\n"):
    fields = dict(re.findall(r"^([A-Za-z-]+): (.*)$", block, re.M))
    if fields.get("Status", "").endswith("installed") and fields.get("Package"):
        packages[fields["Package"]] = {
            "version": fields.get("Version", ""),
            "description": fields.get("Description", "").split("\n")[0],
        }

# --- licenses from the copyright files ---
LIC = re.compile(r"^License:\s*(.+)$", re.M)
KNOWN = ("GPL-3", "GPL-2", "LGPL-3", "LGPL-2", "MIT", "BSD", "Apache-2.0",
        "MPL-2.0", "ISC", "Artistic", "Zlib", "CC0")
licenses = {}
for name in packages:
    p = "/usr/share/doc/%s/copyright" % name
    if not os.path.exists(p):
        continue
    try:
        text = open(p, encoding="utf-8", errors="replace").read()
    except OSError:
        continue
    found = [x.strip() for x in LIC.findall(text)]
    if not found:
        for n in KNOWN:
            if re.search(re.escape(n), text, re.I):
                found = [n]
                break
    licenses[name] = found or ["(in the package's copyright file)"]


def norm(l):
    return l.split(" or ")[0].split(",")[0].strip()


# --- complete, machine-readable list ---
with open("%s/COMPONENTS.csv" % DEST, "w") as f:
    f.write("package;version;licenses;description\n")
    for name in sorted(packages):
        lic = " | ".join(sorted(set(norm(x) for x in licenses.get(name, ["-"]))))
        f.write("%s;%s;%s;%s\n" % (name, packages[name]["version"], lic,
                                   packages[name]["description"].replace(";", ",")))

# --- families: count PACKAGES, not "License:" lines ---
# The license families, the main components and the document texts are data in
# /usr/share/zeta/legal-templates: components.json (both languages of each
# table row) and one template per edition (LICENSES.md, LICENSES.it.md).
# Each edition is filled with the same data: LICENSES.md is the one the apps
# open by default; the English edition points Italian readers to theirs.
TEMPLATES = "/usr/share/zeta/legal-templates"
with open(TEMPLATES + "/components.json", encoding="utf-8") as f:
    DATA = json.load(f)
EDITIONS = DATA["editions"]
LANGS = [e["lang"] for e in EDITIONS]
# (key, name in each edition's language, full text)
FAMILIES = [(r["key"], tuple(r["name"][l] for l in LANGS), r["text"]) for r in DATA["families"]]


def family_of(l):
    u = l.upper()
    for key, names, where in FAMILIES:
        if u.startswith(key.upper()):
            return names, where
    return None, None


per_family = collections.defaultdict(set)
where_family = {}
for name, v in licenses.items():
    for l in set(norm(x) for x in v):
        fam, where = family_of(l)
        if fam:
            per_family[fam].add(name)
            where_family[fam] = where
families = sorted(((f, len(s), where_family[f]) for f, s in per_family.items()),
                  key=lambda r: -r[1])


def table(rows, headers):
    out = ["| " + " | ".join(headers) + " |",
           "|" + "|".join(["---"] * len(headers)) + "|"]
    out += ["| " + " | ".join(str(c) for c in r) + " |" for r in rows]
    return "\n".join(out)


for i, ed in enumerate(EDITIONS):
    with open("%s/%s" % (TEMPLATES, ed["template"]), encoding="utf-8") as f:
        template = f.read()
    text = template.format(
        today=time.strftime(ed["date"]), version=VERSION, n=len(packages), it_pointer=ed["pointer"],
        families=table([(f[i], ed["count"] % (c, len(packages)), d) for f, c, d in families],
                       ed["family_headers"]),
        main_components=table([(r["component"], r["role"][ed["lang"]], r["license"], r["home"])
                               for r in DATA["main_components"]],
                              ed["component_headers"]))
    open("%s/%s" % (DEST, ed["output"]), "w").write(text)
# the templates are only needed here
shutil.rmtree(TEMPLATES, ignore_errors=True)
print("ZETA RAYS: legal documents generated (%d packages, %d license families)"
      % (len(packages), len(families)))

# --- Piper voices: attribution of the voice models and their training data ---
# Serena is trained on a CC BY 4.0 dataset: the license requires crediting the
# author, linking the license and saying whether changes were made. Only the
# voices actually installed (hook 0210) are listed.
VOICE_NOTICES = {
    "it_IT-serena": (
        "Italian voice \"Serena\" (Piper, rhasspy/piper-voices, MIT).\n"
        "Trained on the dataset \"serena-synthetic-it-27h\" by Committa,\n"
        "https://huggingface.co/datasets/committa/serena-synthetic-it-27h,\n"
        "licensed under CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/).\n"
        "The dataset's transcripts are adapted from Tatoeba sentences (https://tatoeba.org,\n"
        "CC BY 2.0 FR). ZETA RAYS OS uses the trained model as published, without changes\n"
        "to the voice; only the phoneme table of its configuration file is reduced to the\n"
        "single-character phonemes understood by the Piper 2023.11.14-2 program."),
    "it_IT-paola": (
        "Italian voice \"Paola\" (Piper, rhasspy/piper-voices, MIT).\n"
        "Trained on the dataset \"Voice-Dataset-Italian\" by paolapersico1,\n"
        "https://huggingface.co/datasets/paolapersico1/Voice-Dataset-Italian, CC0 1.0."),
    "en_US-lessac": (
        "English voice \"Lessac\" (Piper, rhasspy/piper-voices, MIT).\n"
        "Trained on the Lessac Blizzard 2013 dataset,\n"
        "http://www.cstr.ed.ac.uk/projects/blizzard/2011/lessac_blizzard2013/ (see its terms)."),
}
VOICES_DIR = "/usr/share/zeta/voices"
voices_installed = sorted(f[:-5] for f in os.listdir(VOICES_DIR) if f.endswith(".onnx")) \
    if os.path.isdir(VOICES_DIR) else []
voice_notes = ["%s\n%s\n" % (name, VOICE_NOTICES.get("-".join(name.split("-")[:2]),
                                                     "Piper voice, see https://huggingface.co/rhasspy/piper-voices"))
               for name in voices_installed]
os.makedirs(DEST + "/piper-voices", exist_ok=True)
open(DEST + "/piper-voices/NOTICE.txt", "w").write(
    "ZETA RAYS OS speaks with Piper (https://github.com/rhasspy/piper, MIT) and these voices:\n\n"
    + "\n".join(voice_notes))
print("ZETA RAYS: voice attributions in %s/piper-voices/NOTICE.txt (%d voices)"
      % (DEST, len(voices_installed)))

# --- Included model: its license, taken from the model package itself ---
# Qwen3 4B Instruct (2507) is Apache-2.0 (section 4: whoever redistributes it
# gives recipients a copy of the license). The official text travels inside
# the model (the "license" layer of the Ollama package): it is copied from
# there, so it always matches the included version.
import json, os
MODELS_DIR = "/usr/share/ollama/.ollama/models"
MODEL_NAME, MODEL_TAG = "qwen3", "4b-instruct"
MANIFEST = MODELS_DIR + "/manifests/registry.ollama.ai/library/%s/%s" % (MODEL_NAME, MODEL_TAG)
MODEL_DOCS = DEST + "/qwen3"
os.makedirs(MODEL_DOCS, exist_ok=True)
texts = []
for layer in json.load(open(MANIFEST))["layers"]:
    if layer["mediaType"] == "application/vnd.ollama.image.license":
        blob = MODELS_DIR + "/blobs/" + layer["digest"].replace(":", "-")
        texts.append(open(blob, encoding="utf-8").read())
license_text = next(t for t in texts if "Apache License" in t)
open(MODEL_DOCS + "/LICENSE.txt", "w").write(license_text)
open(MODEL_DOCS + "/NOTICE.txt", "w").write(
    "ZETA RAYS OS includes the Qwen3 4B Instruct (2507) model by the Qwen team\n"
    "(Alibaba Cloud) for ZETA's local AI, unmodified, as packaged by Ollama\n"
    "(qwen3:4b-instruct). License: Apache License 2.0 (LICENSE.txt).\n")
print("ZETA RAYS: model license and notice in %s" % MODEL_DOCS)

# Kokoro-82M (Apache-2.0): ZETA's Italian voice, installed by hook 0210
KOKORO_DIR = "/usr/share/zeta/voices/kokoro"
if os.path.isfile(KOKORO_DIR + "/kokoro-v1.0.int8.onnx"):
    os.makedirs(DEST + "/kokoro", exist_ok=True)
    open(DEST + "/kokoro/LICENSE.txt", "w").write(
        open("/usr/share/common-licenses/Apache-2.0", encoding="utf-8").read())
    open(DEST + "/kokoro/NOTICE.txt", "w").write(
        "ZETA RAYS OS speaks Italian with the voice \"Sara\" (if_sara) of Kokoro-82M by\n"
        "hexgrad, https://huggingface.co/hexgrad/Kokoro-82M, Apache License 2.0\n"
        "(LICENSE.txt). Files used, unmodified: kokoro-v1.0.int8.onnx (the model,\n"
        "quantized to 8 bits) and voices-v1.0.bin (the voice styles), as published by\n"
        "the kokoro-onnx project, https://github.com/thewh1teagle/kokoro-onnx (MIT),\n"
        "whose text-to-phoneme steps (through phonemizer, GPL-3.0) ZETA follows in\n"
        "/usr/lib/zeta/intelligence/kokoro.py. The model runs with ONNX Runtime (MIT)\n"
        "and espeak-ng (GPL-3.0-or-later), both Debian packages.\n")
    print("ZETA RAYS: Kokoro license and notice in %s/kokoro" % DEST)
PYEND
exit 0

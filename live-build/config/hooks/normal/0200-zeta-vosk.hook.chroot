#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — riconoscimento vocale offline (Vosk) per ZETA.
# Tutto dalla cache inclusa nell'immagine (build.sh la prende da cache/vosk):
# prima si scaricava qui da internet, e un errore di rete passeggero lasciava
# un'immagine senza voce (successo il 7 ottobre con amd64). Ora, se qualcosa
# manca, la costruzione si ferma invece di consegnare un sistema a meta'.
set -e
INCLUSO=/usr/share/zeta/vosk-cache
case "$(uname -m)" in
    aarch64|arm64) A=aarch64 ;;
    x86_64|amd64)  A=x86_64 ;;
    *) echo "ZETA RAYS: ERRORE - architettura non supportata da Vosk" >&2; exit 1 ;;
esac
echo "ZETA RAYS: installazione motore vocale Vosk…"
if [ ! -d "$INCLUSO/$A" ] || [ ! -d "$INCLUSO/modelli" ]; then
    echo "ZETA RAYS: ERRORE - Vosk non e' nell'immagine ($INCLUSO)" >&2
    exit 1
fi

# 1) libreria Python vosk, senza rete
if ! pip3 install --no-index --find-links "$INCLUSO/$A" --break-system-packages vosk >/tmp/vosk-pip.log 2>&1; then
    cat /tmp/vosk-pip.log >&2
    echo "ZETA RAYS: ERRORE - vosk (python) non installato" >&2
    exit 1
fi
python3 -c "import vosk" || { echo "ZETA RAYS: ERRORE - vosk non si importa" >&2; exit 1; }
echo "ZETA RAYS: vosk (python) installato"

# 2) modelli italiano e inglese «small» (~48 e ~40 MB) in /usr/share/vosk.
# Vosk carica un modello per volta e non indovina la lingua: averli entrambi
# permette di scegliere quale ascoltare (Impostazioni, o la lingua del sistema).
mkdir -p /usr/share/vosk
for coppia in "vosk-model-small-it-0.22 model-it" "vosk-model-small-en-us-0.15 model-en"; do
    set -- $coppia
    rm -rf "/usr/share/vosk/$1" "/usr/share/vosk/$2"
    unzip -q -o "$INCLUSO/modelli/$1.zip" -d /usr/share/vosk
    mv "/usr/share/vosk/$1" "/usr/share/vosk/$2"
    [ -f "/usr/share/vosk/$2/conf/model.conf" ] || { echo "ZETA RAYS: ERRORE - modello $2 non valido" >&2; exit 1; }
    echo "ZETA RAYS: modello vocale $2 installato"
done
rm -rf "$INCLUSO"

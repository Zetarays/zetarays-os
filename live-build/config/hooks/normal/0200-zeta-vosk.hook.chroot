#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — offline speech recognition (Vosk) for ZETA.
# Everything comes from the cache included in the image (build.sh takes it
# from cache/vosk): it used to be downloaded here from the internet, and a
# transient network error left an image without voice (happened on October 7
# with amd64). Now, if anything is missing, the build stops instead of
# delivering a half-finished system.
set -e
BUNDLED=/usr/share/zeta/vosk-cache
case "$(uname -m)" in
    aarch64|arm64) A=aarch64 ;;
    x86_64|amd64)  A=x86_64 ;;
    *) echo "ZETA RAYS: ERROR - architecture not supported by Vosk" >&2; exit 1 ;;
esac
echo "ZETA RAYS: installing the Vosk speech engine…"
if [ ! -d "$BUNDLED/$A" ] || [ ! -d "$BUNDLED/models" ]; then
    echo "ZETA RAYS: ERROR - Vosk is not in the image ($BUNDLED)" >&2
    exit 1
fi

# 1) vosk Python library, without network access
if ! pip3 install --no-index --find-links "$BUNDLED/$A" --break-system-packages vosk >/tmp/vosk-pip.log 2>&1; then
    cat /tmp/vosk-pip.log >&2
    echo "ZETA RAYS: ERROR - vosk (python) not installed" >&2
    exit 1
fi
python3 -c "import vosk" || { echo "ZETA RAYS: ERROR - vosk cannot be imported" >&2; exit 1; }
echo "ZETA RAYS: vosk (python) installed"

# 2) Italian and English «small» models (~48 and ~40 MB) in /usr/share/vosk.
# Vosk loads one model at a time and does not guess the language: having both
# lets the user choose which one to listen with (Settings, or the system
# language).
mkdir -p /usr/share/vosk
for pair in "vosk-model-small-it-0.22 model-it" "vosk-model-small-en-us-0.15 model-en"; do
    set -- $pair
    rm -rf "/usr/share/vosk/$1" "/usr/share/vosk/$2"
    unzip -q -o "$BUNDLED/models/$1.zip" -d /usr/share/vosk
    mv "/usr/share/vosk/$1" "/usr/share/vosk/$2"
    [ -f "/usr/share/vosk/$2/conf/model.conf" ] || { echo "ZETA RAYS: ERROR - model $2 is not valid" >&2; exit 1; }
    echo "ZETA RAYS: speech model $2 installed"
done
rm -rf "$BUNDLED"

#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS OS identity and system settings (run inside the chroot)
set -e

ACCENT="#3A8DFF"

# --- System name ---
# The real file is /usr/lib/os-release: we divert it, so system updates do not
# replace it. live-build has already copied the original to /etc/os-release
# (a regular file, not a symlink): that one must be rewritten too.
dpkg-divert --local --rename --divert /usr/lib/os-release.upstream --add /usr/lib/os-release >/dev/null
cat > /usr/lib/os-release <<'EOF'
PRETTY_NAME="ZETA RAYS OS 2.0"
NAME="ZETA RAYS OS"
VERSION_ID="2.0"
VERSION="2.0"
VERSION_CODENAME=trixie
ID=zeta
ID_LIKE=debian
LOGO=zeta
ANSI_COLOR="1;34"
EOF
{ cat /usr/lib/os-release; grep -E '^(IMAGE_ID|BUILD_ID)=' /etc/os-release 2>/dev/null || true; } > /etc/os-release.zeta
mv /etc/os-release.zeta /etc/os-release
printf 'ZETA RAYS OS 2.0 \\n \\l\n\n' > /etc/issue
printf 'ZETA RAYS OS 2.0\n' > /etc/issue.net

# Console message (replaces the one from the base distribution).
# In English: the motd is a static file, the same for every language.
cat > /etc/motd <<'EOF'

  ZETA RAYS OS 2.0
  AI · Security · Control

  The software included in ZETA RAYS OS is free software: the license of
  each component is in /usr/share/doc/*/copyright.

EOF

# Base distribution logo used by some apps: replaced by the ZETA RAYS symbol
if [ -f /usr/share/pixmaps/debian-logo.png ]; then
  dpkg-divert --local --rename --divert /usr/share/pixmaps/upstream-logo.png --add /usr/share/pixmaps/debian-logo.png >/dev/null
  sed "s/ACCENT/#FFFFFF/g" /usr/share/zeta/brand/zeta-symbol.svg.in > /tmp/zeta-symbol.svg
  rsvg-convert -w 128 -h 110 -o /usr/share/pixmaps/debian-logo.png /tmp/zeta-symbol.svg
  rm -f /tmp/zeta-symbol.svg
fi

# Kernel line on text and SSH logins («... Debian 6.12...»): the welcome
# message is already the ZETA RAYS /etc/motd
if [ -f /etc/update-motd.d/10-uname ]; then
  dpkg-divert --local --rename --divert /usr/share/zeta/10-uname.upstream \
    --add /etc/update-motd.d/10-uname >/dev/null
fi

# Leftovers from the Debian installer (calamares-settings-debian): the
# «Install Debian» icon that would be copied to the desktop and the GNOME favorites
rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop \
      /usr/share/glib-2.0/schemas/96_calamares-settings-debian.gschema.override

# --- Shell: ZETA RAYS prompt, title and welcome ---
for rc in /etc/skel/.bashrc /root/.bashrc; do
  if [ -f "$rc" ] && ! grep -q zeta/shell/bashrc "$rc"; then
    printf '\n# ZETA RAYS OS\n[ -f /usr/share/zeta/shell/bashrc ] && . /usr/share/zeta/shell/bashrc\n' >> "$rc"
  fi
done

# --- Time zone (the installer sets the user's own) ---
ln -sf /usr/share/zoneinfo/Europe/Rome /etc/localtime
echo "Europe/Rome" > /etc/timezone
# Languages: hook 0110-zeta-languages generates them all and starts in English.

# --- Executable scripts ---
chmod 755 /usr/local/bin/zeta-* /usr/local/bin/mpv /usr/local/bin/hyprlock /usr/libexec/zeta-installer /usr/libexec/zeta-vt-text /usr/libexec/zeta-vm-sleep
find /usr/lib/zeta -name "*.py" -exec chmod 644 {} + 2>/dev/null || true
# Precompiled Python and icon caches: in 9996-zeta-speed, after the
# stock live-build hooks that delete them.

# --- System services ---
systemctl set-default graphical.target 2>/dev/null || true
# blueman-mechanism starts on its own via D-Bus when needed (Settings ›
# Bluetooth, the applet): started at boot it delayed the desktop by ~0.6 s
systemctl disable blueman-mechanism.service 2>/dev/null || true
systemctl enable sddm.service 2>/dev/null || true
systemctl enable zeta-live-password.service 2>/dev/null || true
# Firewall enabled (rules in /etc/nftables.conf) and Monitor helper permissions
systemctl enable nftables.service 2>/dev/null || true
# the SSH choice in the firewall sets after every boot and reload
systemctl enable zeta-ssh-sync.service 2>/dev/null || true
systemctl enable zeta-vm-sleep.service 2>/dev/null || true
# A single graphical session: ZETA RAYS. The "bare" Hyprland entries (and the
# uwsm one, which is not installed) confused the login screen.
mkdir -p /usr/share/zeta/hidden-sessions
for f in hyprland.desktop hyprland-uwsm.desktop; do
  if [ -e /usr/share/wayland-sessions/$f ]; then
    dpkg-divert --local --rename --divert /usr/share/zeta/hidden-sessions/$f \
        --add /usr/share/wayland-sessions/$f >/dev/null
  fi
done
chmod 0440 /etc/sudoers.d/zeta-monitor
chmod 0755 /usr/libexec/zeta-monitor-helper
# NetworkManager only runs root scripts that others cannot write to
chown root:root /etc/NetworkManager/dispatcher.d/90-zeta-bar
chmod 0755 /etc/NetworkManager/dispatcher.d/90-zeta-bar
# Wi-Fi radio region from the time zone (launched by udev)
chown root:root /usr/local/libexec/zeta-radio-region /etc/udev/rules.d/60-zeta-radio-region.rules
chmod 0755 /usr/local/libexec/zeta-radio-region
chmod 0644 /etc/udev/rules.d/60-zeta-radio-region.rules
# package sources of the installed system (Calamares step)
chown root:root /usr/local/libexec/zeta-apt-sources /etc/calamares/modules/shellprocess-aptsources.conf
chmod 0755 /usr/local/libexec/zeta-apt-sources
chown root:root /usr/local/libexec/zeta-ssh-installed /etc/calamares/modules/shellprocess-ssh.conf
chmod 0755 /usr/local/libexec/zeta-ssh-installed
# SSH: server installed but off by default (turned on with «zeta-ssh on»)
# and no server keys in the image: they would be the same on every computer.
# They are created on the first start of the service (ssh.service.d/zeta-host-keys).
systemctl disable ssh.service ssh.socket >/dev/null 2>&1 || true
rm -f /etc/ssh/ssh_host_*
# Firefox start page and its policy: without them, Firefox would open the
# error page when there is no network. The build stops if they are missing.
for f in /usr/share/zetarays/start/index.html /usr/lib/firefox-esr/distribution/policies.json; do
  [ -s "$f" ] || { echo "missing $f" >&2; exit 1; }
done
grep -q '"URL": "file:///usr/share/zetarays/start/index.html"' /usr/lib/firefox-esr/distribution/policies.json \
  || { echo "policies.json without the start page" >&2; exit 1; }
chown -R root:root /usr/share/zetarays /usr/share/firefox-esr/distribution/policies.json
chmod -R u=rwX,go=rX /usr/share/zetarays
chmod 0644 /usr/share/firefox-esr/distribution/policies.json
# ufw installed but off (the active firewall is nftables, table inet zeta).
# Rules already prepared for ZETA Share, local network only: whoever turns
# ufw on does not lose sharing. The SSH ones are written by zeta-ssh when SSH
# is turned on. user.rules/user6.rules ship already written (generated with
# the real ufw, see includes.chroot/etc/ufw): «ufw allow» in here does not
# work in the emulated amd64 build.
if command -v ufw >/dev/null 2>&1; then
  sed -i 's/^ENABLED=.*/ENABLED=no/' /etc/ufw/ufw.conf
  chown root:root /etc/ufw/user.rules /etc/ufw/user6.rules
  chmod 0640 /etc/ufw/user.rules /etc/ufw/user6.rules
  grep -q 'dport 53317' /etc/ufw/user.rules && grep -q 'dport 53317' /etc/ufw/user6.rules \
    || { echo "ufw: ZETA Share rules missing" >&2; exit 1; }
fi
chown -R root:root /etc/ssh/sshd_config.d /etc/systemd/system/ssh.service.d /etc/nftables.d
chmod 0644 /etc/ssh/sshd_config.d/zeta.conf /etc/systemd/system/ssh.service.d/zeta-host-keys.conf

# --- Graphical boot (Plymouth) ---
sed "s/ACCENT/$ACCENT/g" /usr/share/zeta/brand/zeta-logo.svg.in > /tmp/zeta-logo.svg
rsvg-convert -w 200 -o /usr/share/plymouth/themes/zeta/logo.png /tmp/zeta-logo.svg
rm -f /tmp/zeta-logo.svg
# encrypted disk password field (see zeta.script)
P=/usr/share/plymouth/themes/zeta
printf '%s' '<svg xmlns="http://www.w3.org/2000/svg" width="320" height="44"><rect x="0.5" y="0.5" width="319" height="43" rx="12" fill="#19191C" stroke="#FFFFFF" stroke-opacity="0.18"/></svg>' \
  | rsvg-convert -o "$P/field.png"
printf '%s' '<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10"><circle cx="5" cy="5" r="4" fill="#EDEDEA"/></svg>' \
  | rsvg-convert -o "$P/dot.png"
printf '%s' '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#EDEDEA" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="9.5" rx="2.5"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/></svg>' \
  | rsvg-convert -o "$P/lock.png"
for f in logo field dot lock; do
  [ -s "$P/$f.png" ] || { echo "ZETA RAYS: ERROR - missing $P/$f.png" >&2; exit 1; }
done
plymouth-set-default-theme zeta
if [ -f /etc/default/grub ]; then
  sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="ZETA RAYS OS"/' /etc/default/grub
  sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=3 rd.udev.log_level=3 udev.log_level=3 systemd.show_status=false rd.systemd.show_status=false vt.global_cursor_default=0"/' /etc/default/grub
fi
# Debian fallback colors (light blue on blue) when the theme does not load:
# 05_debian_theme is moved out of grub.d, and the colors stay GRUB's own
# (gray on black), like the ZETA RAYS background.
if [ -f /etc/grub.d/05_debian_theme ]; then
  dpkg-divert --local --rename --divert /usr/share/zeta/05_debian_theme.upstream \
    --add /etc/grub.d/05_debian_theme >/dev/null
fi
# Installed system: ZETA RAYS theme, no recovery entries, a resolution the
# kernel inherits on simple framebuffers.
# The menu timeout and style are NOT set here but in zeta-boot.cfg (menu
# always visible, to choose the other system when dual booting). This used to
# set «hidden» and 2 seconds: grub-mkconfig reads the files in alphabetical
# order, «zeta.cfg» comes after «zeta-boot.cfg», and the menu stayed hidden.
mkdir -p /etc/default/grub.d
cat > /etc/default/grub.d/zeta.cfg <<'CFG'
GRUB_DISABLE_RECOVERY=true
# Menu resolution: on real computers the screen's own (1920x1080 or the
# closest), sharp and not stretched; in virtual machines 1280x800, which the
# desktop inherits on simple framebuffers. This file is read by update-grub
# on the computer itself, so the choice applies to that machine.
# VirtualBox on arm64 is not recognized by systemd-detect-virt (no SMBIOS):
# virtual PCI devices also count (VirtualBox 80ee, VMware 15ad, virtio 1af4,
# Hyper-V 1414, Parallels 1ab8), as does the arm64 architecture, which on a
# real computer almost always has its own graphics driver.
zeta_vm() {
  systemd-detect-virt -q --vm 2>/dev/null && return 0
  [ "$(uname -m)" = aarch64 ] && return 0
  cat /sys/bus/pci/devices/*/vendor 2>/dev/null | grep -qE '^0x(80ee|15ad|1af4|1414|1ab8)$'
}
if zeta_vm; then
  GRUB_GFXMODE=1280x800,1280x720,1024x768,auto
else
  GRUB_GFXMODE=1920x1080,1600x900,1366x768,1280x800,1280x720,1024x768,auto
fi
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_THEME=/usr/share/grub/themes/zeta/theme.txt
CFG
# The entries are called "ZETA RAYS OS" and not "ZETA RAYS OS GNU/Linux".
# The name contains a space: inside a shell «case» pattern it must be quoted,
# otherwise the space splits the term and grub-mkconfig stops with
# «Syntax error: word unexpected» (that was why the first-boot service
# failed).
[ -f /etc/grub.d/10_linux ] && sed -i 's#Ubuntu|Kubuntu|\*GNU/Linux)#Ubuntu|Kubuntu|"ZETA RAYS"*|*GNU/Linux)#' /etc/grub.d/10_linux
# Theme icons for «Advanced options» and «UEFI Firmware Settings» too
# (GRUB picks them from the entry's class, which was missing here)
python3 - <<'PY'
import os
for p, old, new in (
    ("/etc/grub.d/10_linux",
     "| grub_quote)' \\$menuentry_id_option 'gnulinux-advanced-",
     "| grub_quote)' --class submenu \\$menuentry_id_option 'gnulinux-advanced-"),
    ("/etc/grub.d/30_uefi-firmware",
     "menuentry '$LABEL' \\$menuentry_id_option 'uefi-firmware'",
     "menuentry '$LABEL' --class efi \\$menuentry_id_option 'uefi-firmware'"),
):
    if os.path.exists(p):
        s = open(p).read()
        if old in s:
            open(p, "w").write(s.replace(old, new, 1))
        elif new not in s:
            print("ZETA RAYS: warning - %s not recognized (entry class)" % p)
PY

# --- ZETA RAYS installer (Calamares): logo on a black background ---
# The folder is called «zeta», as settings.conf says (branding: zeta).
# This used to say «zetarays», left over from a rename: the condition was
# always false, the logo was never generated and Calamares refused to start
# with «Image file .../logo.png does not exist» — that is, the installer did
# not open at all. Now there is a single path and, if something fails, the
# build stops instead of shipping a system that cannot be installed.
CAL=/etc/calamares/branding/zeta
if [ ! -d "$CAL" ]; then
  echo "ZETA RAYS: ERROR - $CAL is missing (installer branding)." >&2
  exit 1
fi
sed 's/ACCENT/#EDEDEA/g' /usr/share/zeta/brand/zeta-logo.svg.in > /tmp/zeta-cal.svg
rsvg-convert -h 88 -o "$CAL/logo.png" /tmp/zeta-cal.svg
rm -f /tmp/zeta-cal.svg
if [ ! -s "$CAL/logo.png" ]; then
  echo "ZETA RAYS: ERROR - installer logo not generated: Calamares would not start." >&2
  exit 1
fi
echo "ZETA RAYS: installer logo generated ($(wc -c < "$CAL/logo.png") byte)"

# --- Default GTK3 settings (GSettings: Roboto, dark theme, ZETA RAYS icons) ---
for c in /usr/lib/*/glib-2.0/glib-compile-schemas; do
  [ -x "$c" ] && "$c" /usr/share/glib-2.0/schemas
done
fc-cache -f >/dev/null 2>&1 || true

# --- Version on the login screen (always in sync with os-release) ---
VER=$(. /etc/os-release; echo "$VERSION_ID")
if [ -n "$VER" ] && [ -f /usr/share/sddm/themes/zeta/Main.qml ]; then
  sed -i "s/text: \"[0-9]\+\.[0-9]\+\"/text: \"$VER\"/" /usr/share/sddm/themes/zeta/Main.qml
fi

# --- Icon theme ---
gtk-update-icon-cache -f /usr/share/icons/zeta 2>/dev/null || true

# Regenerate the initramfs with the boot theme
update-initramfs -u -k all || true

# --- Stability: no freezes when memory runs out ----------------------------
# earlyoom stops the hungriest program before the system grinds to a halt;
# zram adds compressed swap in RAM (decisive in virtual machines).
systemctl enable earlyoom.service >/dev/null 2>&1 || true
systemctl enable zramswap.service >/dev/null 2>&1 || true
# lightweight system health check (zeta-health), every two minutes
systemctl enable zeta-health.timer >/dev/null 2>&1 || true
# resume the normal desktop after a Hyprland crash (for every user)
systemctl --global enable zeta-recovery.service >/dev/null 2>&1 || true

# --- Desktop portals: do NOT disable them ------------------------------------
# This used to mask xdg-document-portal and xdg-permission-store, assuming
# they were only needed by Flatpak. In fact xdg-desktop-portal does not start
# without them («No permission store» / «No document portal» are fatal
# errors): the portal died right after starting, taking with it Firefox's
# file dialog, «Open with», screen sharing and the apps' light/dark theme.
# A call to a dying portal hangs until the D-Bus timeout (25 s): the window
# looks frozen. Any masks left over from previous images are removed.
rm -f /etc/systemd/user/xdg-document-portal.service \
      /etc/systemd/user/xdg-permission-store.service

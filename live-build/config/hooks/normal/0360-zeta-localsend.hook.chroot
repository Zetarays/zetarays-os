#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — ZETA Share: LocalSend, official package (build.sh has already
# verified its SHA-256 digest). apt pulls in the dependencies (ayatana, from
# the Debian repositories). The .deb does not stay in the image.
# Fatal: without LocalSend the ZETA Share entry would not work.
set -e
D=/usr/share/zeta/localsend
DEB=$(ls "$D"/LocalSend-*.deb)
echo "ZETA RAYS: installing $(basename "$DEB")"
apt-get install -y --no-install-recommends "$DEB"
rm -rf "$D"
[ -x /opt/localsend_app/localsend_app ] || { echo "ZETA RAYS: ERROR, LocalSend not installed" >&2; exit 1; }
if ldd /opt/localsend_app/localsend_app | grep -q "not found"; then
    ldd /opt/localsend_app/localsend_app | grep "not found" >&2
    exit 1
fi
echo "ZETA RAYS: LocalSend $(dpkg-query -W -f='${Version}' localsend) installed"

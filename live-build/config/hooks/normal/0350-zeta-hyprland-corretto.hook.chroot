#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — Hyprland 0.55.2 con la correzione ufficiale #15416 (0.56.0).
#
# Con l Hyprland dei backports, chiudere di colpo un programma che ha un menu
# a comparsa aperto (un Firefox piantato, l uscita forzata) fa cadere l intero
# desktop: crash in CPopup::coordsRelativeToParent. Il pacchetto installato qui
# e' il sorgente Debian ufficiale con solo quella correzione, compilato con le
# stesse librerie del pacchetto ufficiale (tools/build-hyprland-zeta.sh).
# Versione 0.55.2+ds-1~bpo13+1+zeta2, con anche la correzione della finestra
# ingrandita all'avvio (Blender). Bloccata (apt-mark hold): un Hyprland piu'
# nuovo dai backports toglierebbe la correzione e cambia la configurazione Lua.
#
# Fatale: senza correzione l immagine non deve uscire.
set -e
D=/usr/share/zeta/hyprland-corretto
A=$(dpkg --print-architecture)
DEB=$(ls "$D"/hyprland_*zeta2_"$A".deb)
echo "ZETA RAYS: installo $(basename "$DEB")"
apt-get install -y --no-install-recommends "$DEB"
V=$(dpkg-query -W -f='${Version}' hyprland)
case "$V" in
    *+zeta2) echo "ZETA RAYS: Hyprland $V" ;;
    *) echo "ZETA RAYS: ERRORE, Hyprland installato e' $V" >&2; exit 1 ;;
esac
apt-mark hold hyprland
if ldd /usr/bin/Hyprland | grep -q "not found"; then
    ldd /usr/bin/Hyprland | grep "not found" >&2
    exit 1
fi
# Hyprland non si esegue qui: senza sessione si interrompe e lascia un /core.
rm -f /core

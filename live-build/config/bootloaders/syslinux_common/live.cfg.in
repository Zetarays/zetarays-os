label live-@FLAVOUR@
	menu label ÿÿ^Try ZETA RAYS OS
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@

label install-@FLAVOUR@
	menu label ÿÿ^Install ZETA RAYS OS
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ zeta-install

label live-@FLAVOUR@-failsafe
	menu label ÿÿTry ZETA RAYS OS (^safe graphics)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE_FAILSAFE@

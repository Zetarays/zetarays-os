<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ZETA RAYS</vendor>
  <action id="org.zetarays.auto-updates">
    <description>Turn automatic security updates on or off</description>
    <description xml:lang="it">Attivare o disattivare gli aggiornamenti di sicurezza automatici</description>
    <message>Enter your password to change automatic security updates.</message>
    <message xml:lang="it">Inserisci la password per cambiare gli aggiornamenti di sicurezza automatici.</message>
    <icon_name>software-update-available</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/zeta-auto-updates</annotate>
  </action>
</policyconfig>

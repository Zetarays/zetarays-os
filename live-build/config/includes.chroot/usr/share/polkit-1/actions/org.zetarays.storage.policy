<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ZETA RAYS</vendor>
  <action id="org.zetarays.storage">
    <description>Clean the package cache</description>
    <description xml:lang="it">Pulire la cache dei pacchetti</description>
    <message>Enter your password to delete the downloaded package files.</message>
    <message xml:lang="it">Inserisci la password per eliminare i file dei pacchetti scaricati.</message>
    <icon_name>drive-harddisk</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/zeta-storage</annotate>
  </action>
</policyconfig>

// ZETA RAYS — avvio: logo al centro su nero, con una leggera pulsazione.
// Con il disco cifrato la password si chiede qui: un campo scuro sotto il
// logo, un lucchetto e un pallino per ogni carattere. Senza queste funzioni
// la richiesta restava invisibile (schermo nero) e si scriveva alla cieca.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);

campo.image = Image("campo.png");
campo.sprite = Sprite(campo.image);
campo.x = Window.GetWidth() / 2 - campo.image.GetWidth() / 2;
campo.y = logo.y + logo.image.GetHeight() + 92;
campo.sprite.SetX(campo.x);
campo.sprite.SetY(campo.y);
campo.sprite.SetZ(5);
campo.sprite.SetOpacity(0);

lucchetto.image = Image("lucchetto.png");
lucchetto.sprite = Sprite(lucchetto.image);
lucchetto.sprite.SetX(Window.GetWidth() / 2 - lucchetto.image.GetWidth() / 2);
lucchetto.sprite.SetY(campo.y - lucchetto.image.GetHeight() - 18);
lucchetto.sprite.SetZ(5);
lucchetto.sprite.SetOpacity(0);

pallino.image = Image("pallino.png");
pallino.max = 18;
pallino.passo = 16;

fun mostra_campo(n) {
  campo.sprite.SetOpacity(1);
  lucchetto.sprite.SetOpacity(1);
  for (i = 0; i < pallino.max; i++) {
    if (!pallino.sprite[i]) {
      pallino.sprite[i] = Sprite(pallino.image);
      pallino.sprite[i].SetX(campo.x + 20 + i * pallino.passo);
      pallino.sprite[i].SetY(campo.y + campo.image.GetHeight() / 2 - pallino.image.GetHeight() / 2);
      pallino.sprite[i].SetZ(10);
    }
    if (i < n)
      pallino.sprite[i].SetOpacity(1);
    else
      pallino.sprite[i].SetOpacity(0);
  }
}

fun nascondi_campo() {
  campo.sprite.SetOpacity(0);
  lucchetto.sprite.SetOpacity(0);
  for (i = 0; i < pallino.max; i++)
    if (pallino.sprite[i])
      pallino.sprite[i].SetOpacity(0);
}

fun password_callback(prompt, bullets) {
  mostra_campo(bullets);
}

fun question_callback(prompt, entry) {
  mostra_campo(0);
}

fun normal_callback() {
  nascondi_campo();
}

t = 0;
fun refresh_callback() {
  t = t + 1;
  logo.sprite.SetOpacity(0.75 + 0.25 * Math.Sin(t / 25));
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayQuestionFunction(question_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);

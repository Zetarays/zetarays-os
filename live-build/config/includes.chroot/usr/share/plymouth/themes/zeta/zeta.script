// ZETA RAYS — boot: logo centered on black, with a gentle pulse.
// With an encrypted disk the password is asked for here: a dark field below
// the logo, a padlock and a dot for each character. Without these functions
// the prompt stayed invisible (black screen) and the user typed blindly.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);

field.image = Image("field.png");
field.sprite = Sprite(field.image);
field.x = Window.GetWidth() / 2 - field.image.GetWidth() / 2;
field.y = logo.y + logo.image.GetHeight() + 92;
field.sprite.SetX(field.x);
field.sprite.SetY(field.y);
field.sprite.SetZ(5);
field.sprite.SetOpacity(0);

padlock.image = Image("lock.png");
padlock.sprite = Sprite(padlock.image);
padlock.sprite.SetX(Window.GetWidth() / 2 - padlock.image.GetWidth() / 2);
padlock.sprite.SetY(field.y - padlock.image.GetHeight() - 18);
padlock.sprite.SetZ(5);
padlock.sprite.SetOpacity(0);

dot.image = Image("dot.png");
dot.max = 18;
dot.step = 16;

fun show_field(n) {
  field.sprite.SetOpacity(1);
  padlock.sprite.SetOpacity(1);
  for (i = 0; i < dot.max; i++) {
    if (!dot.sprite[i]) {
      dot.sprite[i] = Sprite(dot.image);
      dot.sprite[i].SetX(field.x + 20 + i * dot.step);
      dot.sprite[i].SetY(field.y + field.image.GetHeight() / 2 - dot.image.GetHeight() / 2);
      dot.sprite[i].SetZ(10);
    }
    if (i < n)
      dot.sprite[i].SetOpacity(1);
    else
      dot.sprite[i].SetOpacity(0);
  }
}

fun hide_field() {
  field.sprite.SetOpacity(0);
  padlock.sprite.SetOpacity(0);
  for (i = 0; i < dot.max; i++)
    if (dot.sprite[i])
      dot.sprite[i].SetOpacity(0);
}

fun password_callback(prompt, bullets) {
  show_field(bullets);
}

fun question_callback(prompt, entry) {
  show_field(0);
}

fun normal_callback() {
  hide_field();
}

t = 0;
fun refresh_callback() {
  t = t + 1;
  logo.sprite.SetOpacity(0.75 + 0.25 * Math.Sin(t / 25));
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayQuestionFunction(question_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);

# ZETA RAYS: the same look for GTK3 apps under Wayland too (they read GSettings,
# not settings.ini): Roboto, dark theme, ZETA RAYS icons.
[org.gnome.desktop.interface]
font-name='Roboto 10'
document-font-name='Roboto 10'
monospace-font-name='JetBrains Mono 10'
color-scheme='prefer-dark'
gtk-theme='Adwaita'
cursor-theme='Adwaita'
enable-animations=true
icon-theme='zeta'

[org.gnome.desktop.wm.preferences]
# window buttons: maximize + close (Hyprland does not implement minimizing:
# no buttons that do nothing)
button-layout=':maximize,close'

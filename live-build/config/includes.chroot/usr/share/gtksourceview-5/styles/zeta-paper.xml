<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later
     ZETA RAYS — text editor with a white background and black text
     (Settings › Appearance › Text Editor: Light). The syntax colors come from
     Adwaita. The light and dark variants are this same scheme: the editor
     never swaps it, whatever the desktop theme. -->
<style-scheme id="zeta-paper" name="ZETA RAYS Paper" version="1.0" parent-scheme="Adwaita">
  <author>ZETA RAYS</author>
  <description>White background, black text</description>
  <metadata>
    <property name="variant">light</property>
    <property name="light-variant">zeta-paper</property>
    <property name="dark-variant">zeta-paper</property>
  </metadata>
  <style name="text" background="#FFFFFF" foreground="#1C1C1E"/>
  <style name="background-pattern" background="#FFFFFF"/>
  <style name="current-line" background="#F2F2F4"/>
  <style name="current-line-number" background="#F2F2F4" foreground="#6E6E73"/>
  <style name="line-numbers" background="#FFFFFF" foreground="#A1A1A6"/>
  <style name="cursor" foreground="#1C1C1E"/>
</style-scheme>

# ZETA RAYS — terminal (light theme; generated by zeta-accent)
font=JetBrains Mono:size=FONTSIZE
pad=10x8
# Window tall enough to hold the ZETA RAYS logo (24 lines) plus the
# information: if it opened smaller, fastfetch could not show it.
initial-window-size-chars=126x34
term=xterm-256color
# the shell runs inside tmux (tabs, splits, sessions that survive closing
# the window): see zeta-terminal and /usr/share/zeta/shell
shell=zeta-terminal

[cursor]
style=block
color=FFFFFF ACCENT

[colors]
alpha=0.98
background=FAFAFC
foreground=1C1C1E
regular0=2E2E32
regular1=C21F1F
regular2=1F7A1C
regular3=9A6100
regular4=0A5FD6
regular5=7A3FC9
regular6=0F7C87
regular7=5A5A5F
bright0=6E6E73
bright1=E03A3A
bright2=2E9A2A
bright3=B37A00
bright4=2E7CE8
bright5=9660DC
bright6=1B94A1
bright7=1C1C1E
selection-background=D6D9E0
selection-foreground=1C1C1E

[key-bindings]
# copy/paste as in every Linux terminal: Ctrl+C stays the interrupt
clipboard-copy=Control+Shift+c XF86Copy
clipboard-paste=Control+Shift+v XF86Paste
search-start=none
spawn-terminal=none

[text-bindings]
# key combinations tmux cannot tell apart on its own: foot translates them
# into sequences tmux recognizes (user-keys in /usr/share/zeta/shell/tmux.conf)
\x1b[9990~=Control+Shift+t
\x1b[9991~=Control+Shift+w
\x1b[9992~=Control+Shift+d
\x1b[9993~=Control+Shift+e
\x1b[9994~=Control+Shift+n
\x1b[9995~=Control+Shift+r
\x1b[9996~=Control+Shift+f

# terminal theme chosen with "zeta shell theme": empty until something is
# chosen (then the colors above apply, which follow the system theme)
[main]
include=~/.config/foot/theme.ini

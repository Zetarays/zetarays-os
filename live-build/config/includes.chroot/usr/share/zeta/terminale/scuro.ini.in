# ZETA RAYS — terminale
font=JetBrains Mono:size=FONTSIZE
pad=10x8
# Finestra alta abbastanza da contenere il logo di ZETA RAYS (24 righe) più
# le informazioni: aprendola più piccola fastfetch non potrebbe mostrarlo.
initial-window-size-chars=126x34
term=xterm-256color
# la shell gira dentro tmux (schede, divisioni, sessioni che sopravvivono
# alla chiusura della finestra): vedi zeta-terminale e /usr/share/zeta/shell
shell=zeta-terminale

[cursor]
style=block
color=0C0C0E ACCENT

[colors]
alpha=0.96
background=0C0C0E
foreground=EDEDEA
regular0=19191C
regular1=FF6B6B
regular2=4CC94A
regular3=FFB547
regular4=3A8DFF
regular5=C79BFF
regular6=5FD4E0
regular7=D6D6D2
bright0=6E6E73
bright1=FF8A8A
bright2=6FDC6D
bright3=FFC870
bright4=6AA8FF
bright5=D6B4FF
bright6=86E1EA
bright7=FFFFFF
selection-background=26262A
selection-foreground=FFFFFF

[key-bindings]
# copia/incolla come in tutti i terminali Linux: Ctrl+C resta l interruzione
clipboard-copy=Control+Shift+c XF86Copy
clipboard-paste=Control+Shift+v XF86Paste
search-start=none
spawn-terminal=none

[text-bindings]
# combinazioni che tmux da solo non distingue: foot le traduce in sequenze
# che tmux riconosce (user-keys in /usr/share/zeta/shell/tmux.conf)
\x1b[9990~=Control+Shift+t
\x1b[9991~=Control+Shift+w
\x1b[9992~=Control+Shift+d
\x1b[9993~=Control+Shift+e
\x1b[9994~=Control+Shift+n
\x1b[9995~=Control+Shift+r
\x1b[9996~=Control+Shift+f

# tema del terminale scelto con «zeta shell tema»: vuoto finche' non si sceglie
# nulla (allora valgono i colori qui sopra, che seguono il tema di sistema)
[main]
include=~/.config/foot/tema.ini

// ZETA RAYS — fastfetch configuration, symbol only (14 rows × 60 columns)
// The source artwork is a negative (the filled area surrounds the mark): here
// we use the positive rendering generated by tools/gen-logo-ascii.py, so the
// symbol comes out light on the black terminal background. The artwork was
// not redrawn or simplified: only the resolution it is printed at changes.
// The $1 sequences are fastfetch color directives and are not printed.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/zeta/fastfetch/zeta-white-tiny.txt",
    "type": "file",
    "color": { "1": "LOGOCOLOR" },
    "padding": { "top": 0, "left": 0, "right": 3 }
  },
  // Labels and title in the accent color, so the terminal output matches the
  // rest of the interface. The symbol stays white: it is the brand mark, not
  // a colorable element.
  "display": { "separator": "  ", "color": { "keys": "ACCENTCOLOR", "title": "ACCENTCOLOR" } },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "@K_OS@" },
    { "type": "command", "key": "@K_KERNEL@", "text": "uname -r | sed 's/+.*//'" },
    { "type": "uptime", "key": "@K_UPTIME@" },
    { "type": "packages", "key": "@K_PACKAGES@" },
    { "type": "shell", "key": "@K_SHELL@" },
    { "type": "terminal", "key": "@K_TERMINAL@" },
    { "type": "wm", "key": "@K_WM@", "format": "ZETA RAYS Shell (Hyprland)" },
    { "type": "cpu", "key": "@K_CPU@" },
    { "type": "gpu", "key": "@K_GPU@" },
    { "type": "memory", "key": "@K_MEMORY@" },
    { "type": "disk", "key": "@K_DISK@", "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "localip", "key": "@K_IP@" },
    { "type": "locale", "key": "@K_LOCALE@" },
    "break",
    { "type": "colors", "paddingLeft": 0, "symbol": "circle" }
  ]
}

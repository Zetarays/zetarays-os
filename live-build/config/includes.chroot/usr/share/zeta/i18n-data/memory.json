  ],
  "forget": [
   "^(?:zeta[,\\s]+)?(?:dimentica|scordati|cancella dalla (?:tua )?memoria)(?:\\s+(?:che|quello che|di|il fatto che))?\\s+(?P<text>.{3,})$",

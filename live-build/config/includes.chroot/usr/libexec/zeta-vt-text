#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — runs before SDDM, on computers without a DRM driver (framebuffer
# only, e.g. VirtualBox "QemuRamFB"): Plymouth exits leaving the active console
# in graphics mode (KD_GRAPHICS), and in that state the kernel ignores console
# switches, so SDDM's Xorg waits forever for its VT and the screen stays black.
# Here the active console is switched back to text mode. With a DRM driver it
# does nothing.
import fcntl
import glob
import os

KDGETMODE, KDSETMODE, KD_TEXT = 0x4B3B, 0x4B3A, 0

if glob.glob("/dev/dri/card*"):
    raise SystemExit(0)
try:
    with open("/sys/class/tty/tty0/active") as f:
        tty = "/dev/" + f.read().strip()
    fd = os.open(tty, os.O_RDWR | os.O_NOCTTY)
    mode = bytearray(4)
    fcntl.ioctl(fd, KDGETMODE, mode)
    if int.from_bytes(mode, "little") != KD_TEXT:
        fcntl.ioctl(fd, KDSETMODE, KD_TEXT)
    os.close(fd)
except OSError:
    pass

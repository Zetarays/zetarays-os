#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS: reopen a Blender that started on Wayland through X11.

    zeta-blender-x11 PID

Blender on Wayland draws its interface smaller than the rest of the desktop
when the screen uses a fractional scale (125%, 150%: a known Blender
limitation, projects.blender.org issues 102999, 105895, 109194). Through X11
(Xwayland) it is drawn at the right size. ZETA's own launchers already start
Blender that way; this covers every other way of starting it (the program
downloaded from blender.org and double-clicked in the file manager, a
terminal, another launcher).

Hyprland calls this when a Blender main window opens on Wayland
(hyprland.lua, window.open). The process is closed and started again with the
same program, arguments, folder and environment, without WAYLAND_DISPLAY. Only
a Blender opening its first window is touched (nothing to lose yet), and never
one started with ZETA_BLENDER_WAYLAND=1 in its environment (to keep Wayland
on purpose: ZETA_BLENDER_WAYLAND=1 ./blender).
"""
import os
import signal
import subprocess
import sys
import time

# Hyprland asks only for the first window of a process (nothing open yet);
# the age is a second safeguard: a slow computer can take a minute or more
MAX_AGE = 300.0      # seconds since the process started


def age(pid: int) -> float:
    """Seconds since the process started (field 22 of /proc/PID/stat)."""
    with open("/proc/%d/stat" % pid) as f:
        fields = f.read().rsplit(")", 1)[1].split()
    start = int(fields[19]) / os.sysconf("SC_CLK_TCK")
    with open("/proc/uptime") as f:
        return float(f.read().split()[0]) - start


def main(argv) -> int:
    if len(argv) != 2 or not argv[1].isdigit():
        print(__doc__.strip().splitlines()[2].strip(), file=sys.stderr)
        return 2
    pid = int(argv[1])
    try:
        if os.stat("/proc/%d" % pid).st_uid != os.getuid():
            return 1                       # only the user's own programs
        exe = os.readlink("/proc/%d/exe" % pid)
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            args = [a.decode("utf-8", "surrogateescape") for a in f.read().split(b"\0") if a]
        with open("/proc/%d/environ" % pid, "rb") as f:
            env = dict(e.decode("utf-8", "surrogateescape").split("=", 1)
                       for e in f.read().split(b"\0") if b"=" in e)
        cwd = os.readlink("/proc/%d/cwd" % pid)
        started = age(pid)
    except (OSError, ValueError, IndexError):
        return 1
    name = os.path.basename(exe)
    if (name.startswith("qemu-") or "binfmt" in name) and len(args) >= 3:
        # a program for another processor, run by qemu through binfmt_misc
        # ("P" flag): interpreter, full path, the original argv[0], arguments
        exe, args = args[1], args[2:]
    if os.path.basename(exe) != "blender" or not args:
        return 1
    if env.get("ZETA_BLENDER_WAYLAND") == "1" or not env.get("WAYLAND_DISPLAY"):
        return 0
    if started > MAX_AGE:
        return 0
    os.kill(pid, signal.SIGTERM)
    for _ in range(50):                    # up to 5 s to close
        if not os.path.exists("/proc/%d" % pid):
            break
        time.sleep(0.1)
    else:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    env.pop("WAYLAND_DISPLAY", None)
    env["ZETA_BLENDER_X11"] = "1"
    subprocess.Popen([exe] + args[1:], cwd=cwd if os.path.isdir(cwd) else None, env=env,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

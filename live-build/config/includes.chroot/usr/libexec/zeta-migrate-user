#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS: bring a user's settings from the Italian names of earlier
versions to the English names of 2.0.

    zeta-migrate-user [--dry-run] [--force]

Runs at login (zeta-desktop-session), before anything reads the settings.
The steps are data: every /usr/share/zeta/migration/*.json, in name order
(english-2.0: the Italian names of earlier versions; update-2.1: configuration
files of 2.0 that the user never changed; update-3.0-0-defaults: default
settings of 2.5 brought to 3.0, before the other update-3.0-* files, which
patch only what a user changed), each applied once per user:

  file       rename a file or folder (OLD may end in "*": same suffix kept);
             if the new name already exists the old one is left alone
  text       replace OLD with NEW in the files listed in "where"
             (scope "whole": only when the whole file content equals OLD)
  jsonkey    rename a key (scope "top": top level only; otherwise also in
             the objects one level down, as in lists of entries)
  jsonvalue  replace a string value (scope "key:NAME": only that top-level
             key; "prefix": any string value starting with OLD)
  cred       re-encrypt a systemd-creds file under its new name (the name
             is bound inside the encrypted file, so it cannot be renamed)
  commands   rename old command names in user files (word boundaries)
  skel       a file copied from /etc/skel that the user never changed (its
             SHA-256 is one of the shipped versions) is replaced with the new
             /etc/skel copy, so it comes out clean instead of patched; with
             "keep_new", a file the user changed stays and the new version
             is saved in ~/.local/state/zeta/migration-new/ for comparison
  skel-new   files and links of /etc/skel that are new in this release
             (not in the "known" list of earlier releases) are copied when
             the user does not have them (new user services, new settings)
  lua-append for a hyprland.lua the user changed: the new top-level
             shortcut lines of this release (hl.bind(...) lines in /etc/skel
             that are not in "base", the file of the earlier release) are
             added at the end in a marked block, each one inside pcall so a
             mistake cannot stop the configuration; keys the user already
             bound are left alone

Nothing is ever deleted except a file whose content was moved to its new
name. A copy of every file changed is kept in
~/.local/state/zeta/migration-backup/. Done: ~/.local/state/zeta/migrated-<name> for each file.
"""
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

DATA_DIR = "/usr/share/zeta/migration"
HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".local/state/zeta")
# one stamp per migration file: migrated-<name> (english-2.0, update-2.1, ...)
STAMP_PREFIX = os.path.join(STATE, "migrated-")
BACKUP = os.path.join(STATE, "migration-backup")
DRY = "--dry-run" in sys.argv
log = []


def expand(p):
    return os.path.expanduser(p)


def targets(where):
    out = []
    for w in where:
        out += [p for p in glob.glob(expand(w)) if os.path.isfile(p)]
    return sorted(set(out))


def backup(path):
    rel = os.path.relpath(path, HOME)
    dest = os.path.join(BACKUP, rel)
    if not DRY and not os.path.exists(dest):
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        shutil.copy2(path, dest)


def write(path, text):
    backup(path)
    if DRY:
        return
    st = os.stat(path)
    tmp = path + ".zeta-migrate"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, st.st_mode)
    os.replace(tmp, path)


def step_file(s):
    old, new = expand(s["old"]), expand(s["new"])
    pairs = []
    if "*" in old:
        pre, suf = old.split("*", 1)
        npre, nsuf = new.split("*", 1) if "*" in new else (new, "")
        for p in glob.glob(old):
            mid = p[len(pre):len(p) - len(suf) if suf else None]
            pairs.append((p, npre + mid + nsuf))
    elif os.path.lexists(old):
        pairs.append((old, new))
    for a, b in pairs:
        if os.path.lexists(b):
            if os.path.isdir(a) and os.path.isdir(b):
                # both exist: move only what the new folder does not have
                for name in os.listdir(a):
                    if not os.path.lexists(os.path.join(b, name)):
                        log.append("move %s -> %s" % (os.path.join(a, name), b))
                        if not DRY:
                            shutil.move(os.path.join(a, name), os.path.join(b, name))
            continue
        log.append("rename %s -> %s" % (a, b))
        if not DRY:
            os.makedirs(os.path.dirname(b), exist_ok=True)
            os.rename(a, b)


def step_text(s):
    for p in targets(s["where"]):
        try:
            t = open(p, encoding="utf-8").read()
        except (OSError, UnicodeDecodeError):
            continue
        if s.get("scope") == "whole":
            if t.strip() == s["old"]:
                log.append("value %s: %s -> %s" % (p, s["old"], s["new"]))
                write(p, t.replace(s["old"], s["new"]))
        elif s["old"] in t:
            log.append("text %s: %s -> %s" % (p, s["old"], s["new"]))
            write(p, t.replace(s["old"], s["new"]))


def _load_json(p):
    raw = open(p, encoding="utf-8").read()
    if p.endswith(".jsonl"):
        return [json.loads(x) for x in raw.splitlines() if x.strip()], True
    return json.loads(raw), False


def _dump_json(p, data, lines):
    if lines:
        write(p, "".join(json.dumps(x, ensure_ascii=False) + "\n" for x in data))
    else:
        write(p, json.dumps(data, ensure_ascii=False, indent=2) + "\n")


def _objects(data, top_only):
    """The dicts a key rename applies to."""
    first = data if isinstance(data, list) else [data]
    out = [d for d in first if isinstance(d, dict)]
    if top_only:
        return out
    for d in list(out):
        for v in d.values():
            if isinstance(v, dict):
                out.append(v)
            elif isinstance(v, list):
                out += [x for x in v if isinstance(x, dict)]
    return out


def step_json(s):
    for p in targets(s["where"]):
        try:
            data, lines = _load_json(p)
        except (OSError, ValueError):
            continue
        changed = False
        scope = s.get("scope", "")
        if s["kind"] == "jsonkey":
            for d in _objects(data, scope == "top"):
                if s["old"] in d and s["new"] not in d:
                    d[s["new"]] = d.pop(s["old"])
                    changed = True
        else:
            for d in _objects(data, scope.startswith("key:")):
                for k, v in d.items():
                    if not isinstance(v, str):
                        continue
                    if scope.startswith("key:") and k not in scope[4:].split(","):
                        continue
                    if scope == "prefix":
                        old = expand(s["old"])
                        if v.startswith(old):
                            d[k] = expand(s["new"]) + v[len(old):]
                            changed = True
                    elif v == s["old"]:
                        d[k] = s["new"]
                        changed = True
        if changed:
            log.append("%s %s: %s -> %s" % (s["kind"], p, s["old"], s["new"]))
            _dump_json(p, data, lines)


def step_cred(s):
    old, new = expand(s["old"]), expand(s["new"])
    if not os.path.exists(old) or os.path.exists(new):
        return
    log.append("re-encrypt %s -> %s" % (old, new))
    if DRY:
        return
    dec = subprocess.run(["systemd-creds", "decrypt", "--user", "--name=" + s["old_name"], old, "-"],
                         capture_output=True)
    if dec.returncode != 0:
        log.append("  could not decrypt (kept as it is)")
        return
    enc = subprocess.run(["systemd-creds", "encrypt", "--user", "--name=" + s["new_name"], "-", new],
                         input=dec.stdout, capture_output=True)
    if enc.returncode != 0 or not os.path.exists(new):
        log.append("  could not encrypt (old key kept)")
        return
    os.chmod(new, 0o600)
    backup(old)
    os.remove(old)


def step_commands(s):
    names = s["map"]
    rx = re.compile(r"(?<![A-Za-z0-9_-])(%s)(?![A-Za-z0-9_-])"
                    % "|".join(re.escape(k) for k in sorted(names, key=len, reverse=True)))
    for p in targets(s["where"]):
        try:
            t = open(p, encoding="utf-8").read()
        except (OSError, UnicodeDecodeError):
            continue
        t2 = rx.sub(lambda m: names[m.group(1)], t)
        if t2 != t:
            log.append("commands %s" % p)
            write(p, t2)


def step_skel(s):
    for rel, known in s["files"].items():
        old = os.path.join(HOME, rel)
        new_rel = s.get("renamed", {}).get(rel, rel)
        src = os.path.join("/etc/skel", new_rel)
        if os.path.islink(old) or not os.path.isfile(old) or not os.path.isfile(src):
            continue
        with open(old, "rb") as f:
            content = f.read()
        digest = hashlib.sha256(content).hexdigest()
        with open(src, "rb") as f:
            fresh = f.read()
        if content == fresh and new_rel == rel:
            continue                    # already the current version
        if digest not in known:
            # only when this release changed the file (not for every file
            # the user customized)
            if s.get("keep_new") and hashlib.sha256(fresh).hexdigest() not in known:
                keep_new_copy(new_rel, fresh)
            continue
        dest = os.path.join(HOME, new_rel)
        log.append("skel %s -> %s" % (old, dest))
        backup(old)
        if not DRY:
            shutil.copy2(src, dest)
            if dest != old:
                os.remove(old)


def keep_new_copy(rel, data):
    """The new version of a file the user changed, for comparison."""
    dest = os.path.join(STATE, "migration-new", rel)
    try:
        with open(dest, "rb") as f:
            if f.read() == data:
                return                  # already kept (skel and lua-append steps)
    except OSError:
        pass
    log.append("kept your %s (the new version is in %s)" % (os.path.join(HOME, rel), dest))
    if not DRY:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, "wb") as f:
            f.write(data)


def step_skel_new(s):
    known = set(s.get("known", []))
    for base, dirs, files in os.walk("/etc/skel"):
        names = files + [d for d in dirs if os.path.islink(os.path.join(base, d))]
        for name in sorted(names):
            src = os.path.join(base, name)
            rel = os.path.relpath(src, "/etc/skel")
            if rel in known:
                continue
            dest = os.path.join(HOME, rel)
            if os.path.lexists(dest):
                continue
            log.append("new %s" % dest)
            if DRY:
                continue
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            if os.path.islink(src):
                os.symlink(os.readlink(src), dest)
            else:
                shutil.copy2(src, dest)


def _balanced(line):
    """One complete Lua call on one line: brackets closed, quotes closed."""
    depth, quote, i = 0, "", 0
    while i < len(line):
        c = line[i]
        if quote:
            if c == "\\":
                i += 1
            elif c == quote:
                quote = ""
        elif c in "\"'":
            quote = c
        elif c == "-" and line[i:i + 2] == "--":
            break
        elif c in "({[":
            depth += 1
        elif c in ")}]":
            depth -= 1
            if depth < 0:
                return False
        i += 1
    return depth == 0 and not quote


def _bind_key(line):
    """The key part of hl.bind(KEY, ...): the text before the first comma
    at the outer level."""
    inner = line[len("hl.bind("):]
    depth, quote = 0, ""
    for i, c in enumerate(inner):
        if quote:
            if c == quote:
                quote = ""
        elif c in "\"'":
            quote = c
        elif c in "({[":
            depth += 1
        elif c in ")}]":
            depth -= 1
        elif c == "," and depth == 0:
            return inner[:i].strip()
    return ""


def _self_contained(line, mine):
    """True when the line uses nothing but the hl API, literals and «mod»
    (defined in the user's file): a shortcut calling a helper function of
    the new hyprland.lua would fail in the user's older file."""
    code = re.sub(r'"(?:[^"\\]|\\.)*"|\'(?:[^\'\\]|\\.)*\'', '""', line)
    if "function" in code:
        return False
    for m in re.finditer(r"(?<![.\w])([A-Za-z_]\w*)", code):
        name = m.group(1)
        if code[m.end():].lstrip().startswith("=") and not code[m.end():].lstrip().startswith("=="):
            continue                    # a table key: { description = ... }
        if name in ("hl", "true", "false", "nil"):
            continue
        if name == "mod" and re.search(r"^\s*(local\s+)?mod\s*=", mine, re.M):
            continue
        return False
    return True


def step_lua_append(s):
    rel = s["file"]
    path = os.path.join(HOME, rel)
    src = os.path.join("/etc/skel", rel)
    if os.path.islink(path) or not os.path.isfile(path) or not os.path.isfile(src):
        return
    try:
        mine = open(path, encoding="utf-8").read()
        fresh = open(src, encoding="utf-8").read()
        base = open(s["base"], encoding="utf-8").read()
    except (OSError, UnicodeDecodeError):
        return
    if mine == fresh or s["marker"] in mine:
        return
    before = set(base.splitlines())
    mine_keys = {_bind_key(l.strip()) for l in mine.splitlines() if l.strip().startswith("hl.bind(")}
    # commands that only work with functions of the new hyprland.lua
    # (e.g. zeta-snap calls zeta_snap() through hyprctl eval)
    exclude = s.get("exclude", [])
    added, skipped = [], 0
    for line in fresh.splitlines():
        if line in before or not line.strip():
            continue
        if line.startswith("hl.bind(") and _balanced(line) and line.rstrip().endswith(")") \
                and _self_contained(line, mine) and not any(x in line for x in exclude):
            key = _bind_key(line)
            if key and key not in mine_keys:
                added.append(line.rstrip())
        else:
            skipped += 1
    if skipped:
        keep_new_copy(rel, fresh.encode("utf-8"))
    if not added:
        return
    block = ["", "-- >>> %s: new shortcuts, added when the system was upgraded." % s["marker"],
             "-- Your own settings above are unchanged; delete this block to remove them."]
    block += ["pcall(function() %s end)" % l for l in added]
    block += ["-- <<< %s" % s["marker"], ""]
    log.append("lua-append %s: %d new shortcut lines" % (path, len(added)))
    write(path, mine.rstrip("\n") + "\n" + "\n".join(block))


STEPS = {"skel": step_skel, "skel-new": step_skel_new, "lua-append": step_lua_append, "file": step_file, "text": step_text, "jsonkey": step_json, "jsonvalue": step_json,
         "cred": step_cred, "commands": step_commands}


def run(data, stamp):
    """Apply one migration file once (its stamp records that it ran)."""
    if os.path.exists(stamp) and "--force" not in sys.argv:
        return 0
    try:
        steps = json.load(open(data, encoding="utf-8"))["steps"]
    except (OSError, ValueError) as e:
        print("zeta-migrate-user: %s" % e, file=sys.stderr)
        return 1
    del log[:]
    for s in steps:
        try:
            STEPS[s["kind"]](s)
        except Exception as e:  # one bad file must not stop the others
            log.append("ERROR %s %s: %s" % (s["kind"], s.get("old", ""), e))
    for line in log:
        print(line)
    if not DRY:
        os.makedirs(STATE, exist_ok=True)
        with open(stamp, "w") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S\n") + "".join(x + "\n" for x in log))
    return 0


def main():
    # in name order: english-2.0 (Italian names of 1.x) before update-2.1
    rc = 0
    for data in sorted(glob.glob(os.path.join(DATA_DIR, "*.json"))):
        name = os.path.basename(data)[:-5]
        rc |= run(data, STAMP_PREFIX + name)
    return rc


if __name__ == "__main__":
    sys.exit(main())

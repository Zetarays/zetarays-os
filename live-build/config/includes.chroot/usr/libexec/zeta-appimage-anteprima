#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS — thumbnail of an AppImage: the icon of the app inside it.

    zeta-appimage-anteprima INPUT OUTPUT SIZE

Called by the file manager's thumbnailer (tumbler) through
/usr/share/thumbnailers/zeta-appimage.thumbnailer, so an AppImage shows the
Blender icon instead of a generic one. The icon is the one the ZETA
integration already extracted; the AppImage is never run.
"""
import os
import sys

sys.path.insert(0, "/usr/lib/zeta")


def icona_di(percorso):
    from system import applicazioni as reg
    reale = os.path.realpath(percorso)

    def cerca():
        for a in reg.tutte(rileggi=True):
            if a.appimage and os.path.realpath(a.appimage) == reale:
                return a.icona
        return ""
    icona = cerca()
    if not icona and reg.e_appimage(reale):
        reg.integra_appimage()        # just downloaded: not integrated yet
        icona = cerca()
    return icona if icona and os.path.isabs(icona) and os.path.isfile(icona) else ""


def main(argv):
    if len(argv) != 3:
        print("usage: zeta-appimage-anteprima INPUT OUTPUT SIZE", file=sys.stderr)
        return 2
    sorgente, uscita, lato = argv[0], argv[1], argv[2]
    try:
        lato = max(16, min(1024, int(lato)))
    except ValueError:
        lato = 256
    if sorgente.startswith("file://"):
        from urllib.parse import unquote, urlparse
        sorgente = unquote(urlparse(sorgente).path)
    icona = icona_di(sorgente)
    if not icona:
        return 1
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf, GLib
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(icona, lato, lato, True)
        pb.savev(uscita, "png", [], [])
    except GLib.Error as e:
        print("zeta-appimage-anteprima: %s" % e.message, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

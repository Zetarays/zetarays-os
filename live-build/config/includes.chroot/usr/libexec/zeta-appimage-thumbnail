#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS — thumbnail of an AppImage: the icon of the app inside it.

    zeta-appimage-thumbnail INPUT OUTPUT SIZE

Called by the file manager's thumbnailer (tumbler) through
/usr/share/thumbnailers/zeta-appimage.thumbnailer, so an AppImage shows the
Blender icon instead of a generic one. The icon is the one the ZETA
integration already extracted; the AppImage is never run.
"""
import os
import sys

sys.path.insert(0, "/usr/lib/zeta")


def icon_of(path):
    from system import applications as reg
    real_path = os.path.realpath(path)

    def search():
        for a in reg.all_apps(reread=True):
            if a.appimage and os.path.realpath(a.appimage) == real_path:
                return a.icon
        return ""
    icon = search()
    if not icon and reg.is_appimage(real_path):
        reg.integrate_appimages()        # just downloaded: not integrated yet
        icon = search()
    return icon if icon and os.path.isabs(icon) and os.path.isfile(icon) else ""


def main(argv):
    if len(argv) != 3:
        print("usage: zeta-appimage-thumbnail INPUT OUTPUT SIZE", file=sys.stderr)
        return 2
    source, output, side = argv[0], argv[1], argv[2]
    try:
        side = max(16, min(1024, int(side)))
    except ValueError:
        side = 256
    if source.startswith("file://"):
        from urllib.parse import unquote, urlparse
        source = unquote(urlparse(source).path)
    icon = icon_of(source)
    if not icon:
        return 1
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf, GLib
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(icon, side, side, True)
        pb.savev(output, "png", [], [])
    except GLib.Error as e:
        print("zeta-appimage-thumbnail: %s" % e.message, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

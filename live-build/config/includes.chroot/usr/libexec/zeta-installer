#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Launches Calamares as root to install ZETA RAYS OS (called via pkexec or sudo).
# pkexec wipes the environment: language and Qt settings are restored here.
# The installer starts in ENGLISH: it is the language anyone in the world can
# read, and Calamares' first screen has the menu to pick one's own (the choice
# applies both to the installation and to the installed system). Italian used
# to be forced here, and non-speakers could not even tell where to change it.
export LANG=en_US.UTF-8
export LANGUAGE=en_US:en
export QT_QPA_PLATFORM=xcb QT_AUTO_SCREEN_SCALE_FACTOR=1 QT_FONT_DPI=82

# Live system only: live-build's /etc/fstab confuses the partitioner.
moved=0
if [ -e /run/live/medium ] && [ -f /etc/fstab ]; then
    mv /etc/fstab /etc/fstab.zeta-installer && moved=1
fi
# An interrupted installation leaves the disks mounted and the partitioner
# would only offer manual mode: release them before starting again.
release_leftovers() {
    for m in $(awk '$2 ~ /^\/tmp\/calamares-root-/ {print $2}' /proc/mounts | sort -r); do
        umount -l "$m" 2>/dev/null
    done
    for s in $(awk 'NR > 1 && $1 ~ /^\/dev\// {print $1}' /proc/swaps); do
        [ -e /run/live/medium ] && swapoff "$s" 2>/dev/null
    done
}
release_leftovers

# During installation the computer must neither lock the screen nor
# suspend. Previously, after ten minutes of inactivity the lock kicked in:
# the installation kept going underneath, but whoever had stepped away came
# back to a password prompt with no idea whether it had finished. Suspend (or
# closing a laptop lid) was worse: stopping disk writes halfway leaves a
# broken installed system. The inhibitor lasts as long as Calamares is open
# and goes away on its own when it exits, even if it exits abnormally.
if command -v systemd-inhibit >/dev/null 2>&1; then
    systemd-inhibit --what=idle:sleep:handle-lid-switch \
        --who="ZETA RAYS" --why="Installation in progress" \
        /usr/bin/calamares "$@"
else
    /usr/bin/calamares "$@"
fi
rc=$?
[ "$moved" = 1 ] && mv /etc/fstab.zeta-installer /etc/fstab
exit $rc

#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — in virtual machines suspend never resumes (VirtualBox on ARM
# stays frozen forever): it is disabled, so logind answers CanSuspend=na and
# both the login screen and the Power menu hide it.
# Nothing changes on real computers.
is_vm=false
systemd-detect-virt -q 2>/dev/null && is_vm=true
for d in /sys/class/drm/card*/device/driver; do
    [ -e "$d" ] || continue
    case "$(basename "$(readlink -f "$d")")" in
        vmwgfx|vboxvideo|virtio*|qxl|bochs*|cirrus*|hyperv*) is_vm=true ;;
    esac
done
# VirtualBox on ARM: no DMI and systemd-detect-virt does not recognize it, but
# the ACPI tables carry the signature of the virtual machine vendor.
grep -qa -e VBOX -e BOCHS -e BXPC -e VMWARE -e PRLS -e 'Microsoft Hyper-V' \
    /sys/firmware/acpi/tables/DSDT 2>/dev/null && is_vm=true

if $is_vm; then
    mkdir -p /run/systemd/sleep.conf.d
    printf '[Sleep]\nAllowSuspend=no\nAllowHibernation=no\nAllowSuspendThenHibernate=no\nAllowHybridSleep=no\n' \
        > /run/systemd/sleep.conf.d/zeta-vm.conf
fi

# Audio in virtual machines: the emulated HDA card does not give PipeWire
# accurate timing, and with timer-based scheduling the output never started
# (every sound waited forever: tested in VirtualBox on ARM; with plain ALSA
# it played). Using the card's interrupts, it plays.
# Only in virtual machines: on real computers it stays as it is.
WP=/etc/wireplumber/wireplumber.conf.d/51-zeta-vm.conf
if $is_vm; then
    mkdir -p "${WP%/*}"
    cat > "$WP" <<'EOF'
# written by zeta-vm-sleep at boot: only in virtual machines
monitor.alsa.rules = [
  {
    matches = [ { node.name = "~alsa_output.*" } ]
    actions = { update-props = { api.alsa.disable-tsched = true, api.alsa.period-size = 1024, api.alsa.headroom = 1024 } }
  }
]
EOF
else
    rm -f "$WP"
fi
exit 0

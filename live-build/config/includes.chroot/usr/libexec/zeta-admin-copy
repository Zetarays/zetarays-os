#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS — copy or move files into a system folder (/opt, /usr/local...).

It only runs through pkexec, after an administrator's password (action
org.zetarays.admin-copy). It does one thing only:

  zeta-admin-copy copy|move replace|keep-both|skip DEST -- SOURCE...

Copied files become owned by root, like everything else in the system
folders (a program in /opt owned by the user could be modified by anything
running under the user's name). Moving = copying and then removing the
original, because the original is almost always on another disk (home) and
this way the ownership stays correct.
"""
import json
import os
import re
import shutil
import subprocess
import sys

# pkexec clears the environment: zeta-admin-paste passes the
# message language as an optional first argument "--lang=CODE". Only a
# well-formed language code is accepted (no paths), before loading i18n.
if len(sys.argv) > 1 and sys.argv[1].startswith("--lang="):
    _lang = sys.argv.pop(1)[len("--lang="):]
    if re.fullmatch(r"[a-z]{2,3}(_[A-Z]{2})?", _lang):
        os.environ["LANGUAGE"] = _lang

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr  # noqa: E402

# Folders that are never replaced as a whole, not even as administrator:
# a drag-and-drop mistake must not be able to wipe out the system.
UNTOUCHABLE = {"/", "/bin", "/boot", "/dev", "/etc", "/home", "/lib", "/lib64",
               "/opt", "/proc", "/root", "/run", "/sbin", "/srv", "/sys", "/tmp",
               "/usr", "/usr/bin", "/usr/lib", "/usr/local", "/usr/sbin", "/usr/share",
               "/var", "/efi", "/boot/efi"}


def exit_with(code, **data):
    print(json.dumps(data, ensure_ascii=False))
    sys.exit(code)


def unique_name(dest, name):
    base, ext = os.path.splitext(name)
    if os.path.isdir(os.path.join(dest, name)):
        base, ext = name, ""
    n = 2
    while True:
        cand = "%s (%d)%s" % (base, n, ext)
        if not os.path.lexists(os.path.join(dest, cand)):
            return cand
        n += 1


def remove(path):
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    else:
        os.unlink(path)


def main(argv):
    if os.geteuid() != 0:
        exit_with(2, error="pkexec required")
    if len(argv) < 5 or argv[0] not in ("copy", "move") or \
            argv[1] not in ("replace", "keep-both", "skip") or argv[3] != "--":
        exit_with(2, error="invalid arguments")
    operation, conflict, dest, sources = argv[0], argv[1], argv[2], argv[4:]
    if not os.path.isabs(dest) or not os.path.isdir(dest):
        exit_with(2, error="destination folder does not exist: %s" % dest)
    dest = os.path.realpath(dest)
    done, skipped, errors = [], [], []
    for src in sources:
        if not os.path.isabs(src) or not os.path.lexists(src):
            errors.append(tr("{name}: does not exist").format(name=src))
            continue
        src = os.path.normpath(src)
        name = os.path.basename(src)
        if not name or name in (".", ".."):
            errors.append(tr("{name}: invalid name").format(name=src))
            continue
        real_path = os.path.realpath(src)
        if dest == real_path or dest.startswith(real_path.rstrip("/") + "/"):
            errors.append(tr("{name}: a folder cannot be copied into itself").format(name=name))
            continue
        if os.path.dirname(real_path) == dest and os.path.basename(real_path) == name:
            skipped.append(name)          # already there: nothing to do
            continue
        target = os.path.join(dest, name)
        if os.path.lexists(target):
            if conflict == "skip":
                skipped.append(name)
                continue
            if conflict == "keep-both":
                target = os.path.join(dest, unique_name(dest, name))
            else:
                if os.path.realpath(target) in UNTOUCHABLE:
                    errors.append(tr("{name}: system folder, it cannot be replaced").format(name=name))
                    continue
                try:
                    remove(target)
                except OSError as e:
                    errors.append("%s: %s" % (name, e.strerror))
                    continue
        # -R without -a: permissions and timestamps are kept, the owner
        # becomes root; -P copies symlinks as symlinks
        r = subprocess.run(["cp", "-R", "-P", "--preserve=mode,timestamps,links",
                            "--", src, target], capture_output=True, text=True)
        if r.returncode != 0:
            errors.append("%s: %s" % (name, r.stderr.strip() or tr("copy failed")))
            continue
        if operation == "move":
            try:
                remove(src)
            except OSError as e:
                errors.append(tr("{name}: copied, but the original could not be removed ({error})").format(
                    name=name, error=e.strerror))
        done.append(os.path.basename(target))
    exit_with(0 if not errors else 1, done=done, skipped=skipped, errors=errors)


if __name__ == "__main__":
    main(sys.argv[1:])

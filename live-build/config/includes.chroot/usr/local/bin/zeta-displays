#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS — displays.

  zeta-displays              opens Settings › Displays
  zeta-displays identify     shows each display's number and name on that
                            display for three seconds (as in Settings)
  zeta-displays list         display status (including those turned off)
  zeta-displays recover      moves all windows onto the displays that are on

The logic lives in /usr/lib/zeta/system/displays.py.
"""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr  # noqa: E402
from system import displays  # noqa: E402


def listing():
    for i, m in enumerate(displays.read(), 1):
        state = tr("on") if m["enabled"] else tr("off")
        if m["mirror"]:
            state = tr("mirror of {name}").format(name=m["mirror"])
        print("%d  %-10s %-34s %dx%d@%.2f  %s  %s %g  (%d, %d)" % (
            i, m["name"], m["identity"][:34], m["width"], m["height"], m["refresh"],
            state, tr("scale"), m["scale"], m["x"], m["y"]))
    return 0


def identify():
    from ui import popup
    popup.preload_layer_shell()
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, GLib, Gtk
    try:
        gi.require_version("Gtk4LayerShell", "1.0")
        from gi.repository import Gtk4LayerShell as LS
    except (ValueError, ImportError):
        LS = None

    numbers = {m["name"]: (i, m) for i, m in enumerate(displays.read(), 1)}

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="org.zetarays.IdentifyDisplays")

        def do_startup(self):
            Gtk.Application.do_startup(self)
            popup.clean_env()
            popup.load_css("""
.id-display { background: rgba(12, 12, 14, 0.92); border-radius: 22px; padding: 26px 40px;
              border: 1px solid rgba(255, 255, 255, 0.10); }
.id-number { font-size: 96px; font-weight: 300; color: @accent; }
.id-name { font-size: 15px; color: #EDEDEA; }
.id-detail { font-size: 12px; color: #8A8A8E; }
""")

        def do_activate(self):
            if self.get_windows():
                return
            gdk_monitors = Gdk.Display.get_default().get_monitors()
            for k in range(gdk_monitors.get_n_items()):
                gm = gdk_monitors.get_item(k)
                name = gm.get_connector() or ""
                i, m = numbers.get(name, (k + 1, None))
                w = Gtk.Window(application=self, decorated=False)
                if LS and LS.is_supported():
                    LS.init_for_window(w)
                    LS.set_namespace(w, "zeta-identify")
                    LS.set_layer(w, LS.Layer.OVERLAY)
                    LS.set_keyboard_mode(w, LS.KeyboardMode.NONE)
                    LS.set_monitor(w, gm)
                w.add_css_class("zeta-overlay")
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                              css_classes=["id-display"])
                box.append(Gtk.Label(label=str(i), css_classes=["id-number"]))
                title = (m and m["identity"]) or name
                box.append(Gtk.Label(label=title, css_classes=["id-name"]))
                if m:
                    box.append(Gtk.Label(label="%s · %d × %d" % (name, m["width"], m["height"]),
                                         css_classes=["id-detail"]))
                w.set_child(box)
                w.present()
            GLib.timeout_add(3000, lambda: (self.quit(), False)[1])

    return App().run([sys.argv[0]])


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "identify":
        return identify()
    if cmd == "list":
        return listing()
    if cmd == "recover":
        return subprocess.call(["hyprctl", "eval", "zeta_recover()"], stdout=subprocess.DEVNULL)
    if cmd == "":
        os.execvp("zeta-settings", ["zeta-settings", "displays"])
    print(__doc__.strip())
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))

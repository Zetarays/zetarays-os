#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Avvia l'installer ZETA RAYS (Calamares) dal desktop.
# Calamares gira come root su Xwayland: root deve poter aprire finestre.
xhost +si:localuser:root >/dev/null 2>&1
if [ -e /run/live/medium ] && sudo -n true 2>/dev/null; then
    exec sudo -E /usr/libexec/zeta-installer        # live: nessuna password
fi
exec pkexec /usr/libexec/zeta-installer             # un'unica richiesta, in italiano

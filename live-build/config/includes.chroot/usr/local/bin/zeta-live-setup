#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Preparazione dell'ambiente LIVE (non del sistema installato):
# password utente live zeta/zeta + autologin nel display manager.
# Si attiva solo in live (boot=live sulla riga di comando del kernel).
grep -qw boot=live /proc/cmdline 2>/dev/null || exit 0

id zeta >/dev/null 2>&1 && echo "zeta:zeta" | chpasswd || true
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/zz-live-autologin.conf <<CONF
[Autologin]
User=zeta
Session=zeta.desktop
Relogin=false
CONF

# Firefox nella sessione live: niente cache su disco. Qui il «disco» e' la
# RAM (tutto cio' che si scrive resta in memoria fino allo spegnimento) e la
# cache arrivava a centinaia di MB. Il sistema installato non e' toccato:
# questo file nasce solo nella sessione live e l'installer copia l'immagine,
# non la sessione.
cat > /etc/firefox-esr/zeta-live.js <<'PREF'
// ZETA RAYS live session: no disk cache (the disk is RAM here)
pref("browser.cache.disk.enable", false);
pref("browser.cache.memory.capacity", 65536);
PREF

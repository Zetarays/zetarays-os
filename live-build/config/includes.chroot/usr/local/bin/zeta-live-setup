#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Sets up the LIVE environment (not the installed system):
# live user password zeta/zeta + autologin in the display manager.
# Only runs in live mode (boot=live on the kernel command line).
grep -qw boot=live /proc/cmdline 2>/dev/null || exit 0

id zeta >/dev/null 2>&1 && echo "zeta:zeta" | chpasswd || true
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/zz-live-autologin.conf <<CONF
[Autologin]
User=zeta
Session=zeta.desktop
Relogin=false
CONF

# Firefox in the live session: no disk cache. Here the «disk» is RAM
# (everything written stays in memory until shutdown) and the cache grew to
# hundreds of MB. The installed system is not affected: this file is only
# created in the live session, and the installer copies the image, not the
# session.
cat > /etc/firefox-esr/zeta-live.js <<'PREF'
// ZETA RAYS live session: no disk cache (the disk is RAM here)
pref("browser.cache.disk.enable", false);
pref("browser.cache.memory.capacity", 65536);
PREF

#!/usr/bin/python3 -S
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS — minimize windows with a preview and an animation, like on macOS.

  zeta-minimize minimize [ADDRESS]    minimize the active window (or the given one)
  zeta-minimize restore ADDRESS       put it back where it was
  zeta-minimize menu N                menu of thumbnail N in the bar
  zeta-minimize --daemon              resident process (started by the session)

How it works:
  - a moment before hiding it, the window is captured (it is still on
    screen; afterwards it is no longer drawn) and turned into a thumbnail
    with the app icon: the bar shows it instead of the «1 minimized» label;
  - the snapshot is placed exactly over the real window, the window is
    hidden underneath, and the snapshot shrinks toward its spot in the bar
    (0.3 s): no jump, no gap;
  - the process stays ready, hidden, and waits for commands on a socket:
    the animation starts immediately and it uses no CPU while idle. If it is
    not running, the window is minimized anyway, without animation.
"""
import os
import socket
import sys

RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
SOCK = os.path.join(RUNTIME, "zeta-minimize.sock")


def _send(msg):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        s.sendto(msg.encode(), SOCK)
        return True
    except OSError:
        return False
    finally:
        s.close()


def _without_daemon(cmd, arg):
    """The resident process does not answer: do it anyway, without animation."""
    import site
    site.main()
    sys.path.insert(0, "/usr/lib/zeta")
    from system import windows
    if cmd == "minimize":
        win = windows.active() if not arg else next(
            (c for c in windows.clients() if c.get("address") == arg), None)
        if not win:
            return 1
        addr = win["address"]
        large = windows._preview_file(addr, "large")
        if windows.capture(win, large):
            try:
                windows.compose_preview(large, windows._preview_file(addr, "mini"), win.get("class", ""))
            except Exception:  # noqa: BLE001 - the window is minimized anyway
                pass
        return 0 if windows.minimize(addr) else 1
    if cmd == "restore" and arg:
        return 0 if windows.restore(arg) else 1
    if cmd == "restore-n" and arg.isdigit():
        minimized = windows.minimized_in_order()
        return 0 if int(arg) < len(minimized) and windows.restore(minimized[int(arg)][0]) else 1
    return 1


# ---------------------------------------------------------------- client
if len(sys.argv) > 1 and sys.argv[1] in ("minimize", "restore", "restore-n", "menu"):
    arg = sys.argv[2] if len(sys.argv) > 2 else ""
    if _send(("%s %s" % (sys.argv[1], arg)).strip()):
        sys.exit(0)
    sys.exit(_without_daemon(sys.argv[1], arg) if sys.argv[1] != "menu" else 1)

if len(sys.argv) < 2 or sys.argv[1] != "--daemon":
    sys.path.insert(0, "/usr/lib/zeta")
    from i18n import tr
    print(tr("""ZETA RAYS — minimize windows with a preview and an animation, like on macOS.

  zeta-minimize minimize [ADDRESS]    minimize the active window (or the given one)
  zeta-minimize restore ADDRESS       put it back where it was
  zeta-minimize menu N                menu of thumbnail N in the bar
  zeta-minimize --daemon              resident process (started by the session)
"""))
    sys.exit(0 if len(sys.argv) < 2 else 1)

# ---------------------------------------------------------------- daemon
import site  # noqa: E402
site.main()
import json  # noqa: E402
import subprocess  # noqa: E402
import threading  # noqa: E402

sys.path.insert(0, "/usr/lib/zeta")
from ui import popup  # noqa: E402
popup.preload_layer_shell()

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
from gi.repository import Gio, GLib, Gtk  # noqa: E402
from system import dock, windows  # noqa: E402
from i18n import tr  # noqa: E402

DURATION = 0.30          # animation length in seconds


def _monitor():
    """Logical (x, y, width, height) of the active monitor."""
    try:
        out = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True, timeout=3).stdout
        for m in json.loads(out):
            if m.get("focused"):
                sc = float(m.get("scale") or 1) or 1
                return (m.get("x", 0), m.get("y", 0), m["width"] / sc, m["height"] / sc)
    except (OSError, subprocess.SubprocessError, ValueError, KeyError):
        pass
    return (0, 0, 1280, 800)


def _thumbnail_position(index, total, mon):
    """Where thumbnail number «index» appears in the bar (estimated from the
    dock layout: centered group, the dock and then the thumbnails)."""
    _mx, _my, lw, lh = mon
    side = dock.icon_size()
    bar_height = max(60, side + 18)
    n = len(dock.load_dock())
    dock_l = n * (side + 8)
    tw, th, spacing = side * windows.ASPECT_RATIO, side, 8
    tot = dock_l + 14 + total * (tw + spacing)
    x = lw / 2 - tot / 2 + dock_l + 14 + index * (tw + spacing) + spacing / 2
    if dock.position() == "top":
        y = 12 + bar_height / 2 - th / 2
    else:
        y = lh - 12 - bar_height / 2 - th / 2
    return (x, y, tw, th)


def _ease(t):
    return 4 * t * t * t if t < 0.5 else 1 - pow(-2 * t + 2, 3) / 2


class Animation(Gtk.ApplicationWindow):
    """Transparent overlay layer that takes neither clicks nor keyboard."""

    def __init__(self, app):
        super().__init__(application=app, title="zeta-minimize", decorated=False)
        popup.make_overlay(self, "zeta-minimize", keyboard=False)
        self.fixed = Gtk.Fixed()
        self.photo = Gtk.Picture(can_shrink=True, content_fit=Gtk.ContentFit.FILL)
        self.photo.add_css_class("zeta-minimize-photo")
        self.fixed.put(self.photo, 0, 0)
        self.set_child(self.fixed)
        self.connect("realize", self._click_through)
        self._tick = 0
        self._on_finish = None

    def _click_through(self, *_a):
        try:
            import cairo
            self.get_surface().set_input_region(cairo.Region())
        except Exception:  # noqa: BLE001
            pass

    def animate(self, png, start, end, on_finish, opacity=(1.0, 0.35)):
        self.photo.set_filename(png)
        self._move(start, opacity[0])
        self.present()
        self._start_rect, self._end_rect, self._op = start, end, opacity
        self._on_finish = on_finish
        self._start = None
        if self._tick:
            self.remove_tick_callback(self._tick)
        self._tick = self.add_tick_callback(self._step)

    def _move(self, r, op):
        x, y, w, h = r
        self.photo.set_size_request(max(1, int(w)), max(1, int(h)))
        self.fixed.move(self.photo, x, y)
        self.photo.set_opacity(op)

    def _step(self, _w, clock):
        now = clock.get_frame_time() / 1e6
        if self._start is None:
            # first frame: the snapshot is drawn; on the second it is on
            # screen, and only then is the real window underneath hidden
            self._frames = getattr(self, "_frames", 0) + 1
            if self._frames < 2:
                return True
            self._frames = 0
            self._start = now
            if getattr(self, "before", None):
                before, self.before = self.before, None
                before()
            return True
        t = min(1.0, (now - self._start) / DURATION)
        e = _ease(t)
        r = tuple(a + (b - a) * e for a, b in zip(self._start_rect, self._end_rect))
        self._move(r, self._op[0] + (self._op[1] - self._op[0]) * e)
        if t >= 1.0:
            self._tick = 0
            finish, self._on_finish = self._on_finish, None
            if finish:
                finish()
            return False
        return True


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Minimize", flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.anim = None
        self.menu = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        popup.clean_env()
        popup.load_css(".zeta-minimize-photo { border-radius: 10px; } "
                       ".zeta-card { padding: 6px; }")
        self.hold()
        self._listen()

    def do_activate(self):
        if self.anim is None:
            self.anim = Animation(self)

    def _listen(self):
        try:
            os.unlink(SOCK)
        except FileNotFoundError:
            pass
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.sock.bind(SOCK)
        os.chmod(SOCK, 0o600)
        self.sock.setblocking(False)
        GLib.io_add_watch(self.sock.fileno(), GLib.PRIORITY_HIGH, GLib.IO_IN, self._receive)

    def _receive(self, *_a):
        try:
            while True:
                pieces = self.sock.recv(256).decode(errors="replace").split()
                if not pieces:
                    continue
                try:
                    getattr(self, "c_" + pieces[0].replace("-", "_"))(pieces[1] if len(pieces) > 1 else "")
                except AttributeError:
                    pass
                except Exception as e:  # noqa: BLE001 - the daemon must not die
                    print("zeta-minimize: %s: %s" % (pieces[0], e), file=sys.stderr)
        except (BlockingIOError, OSError):
            pass
        return True

    # --- minimize
    def c_minimize(self, addr):
        win = windows.active() if not addr else next(
            (c for c in windows.clients() if c.get("address") == addr), None)
        if not win or str((win.get("workspace") or {}).get("name", "")).startswith("special:"):
            return
        addr = win["address"]
        large = windows._preview_file(addr, "large")
        rect = windows.capture(win, large)
        if not rect:
            windows.minimize(addr)          # no snapshot: just minimize
            return
        mon = _monitor()
        x, y, w, h = rect
        start = (x - mon[0], y - mon[1], w, h)
        total = len(windows.minimized_in_order()) + 1
        end = _thumbnail_position(total - 1, total, mon)

        def hide_away():
            windows.minimize(addr)
            threading.Thread(target=self._thumbnail, args=(addr, large, win.get("class", "")),
                             daemon=True).start()
        self.anim.before = hide_away
        self.anim.animate(large, start, end, lambda: GLib.timeout_add(30, self._hide_animation))

    def _thumbnail(self, addr, large, class_name):
        try:
            windows.compose_preview(large, windows._preview_file(addr, "mini"), class_name)
        except Exception as e:  # noqa: BLE001
            print("zeta-minimize: thumbnail: %s" % e, file=sys.stderr)
        GLib.idle_add(windows._notify_bar)

    def _hide_animation(self):
        self.anim.set_visible(False)
        return False

    # --- restore (from a click on thumbnail N in the bar: it comes straight
    # here, without going through another program, so it starts immediately)
    def c_restore_n(self, n):
        try:
            self.c_restore(windows.minimized_in_order()[int(n)][0])
        except (ValueError, IndexError):
            pass

    def c_restore(self, addr):
        order = [k for k, _v in windows.minimized_in_order()]
        info = dict(windows.minimized_in_order()).get(addr)
        large = windows._preview_file(addr, "large")
        if not info or not os.path.exists(large) or not info.get("rect"):
            windows.restore(addr)
            return
        mon = _monitor()
        start = _thumbnail_position(order.index(addr), len(order), mon)
        x, y, w, h = info["rect"]
        end = (x - mon[0], y - mon[1], w, h)

        def arrived():
            windows.restore(addr)
            # the real window appears under the snapshot: then the snapshot goes
            GLib.timeout_add(90, self._hide_animation)
        self.anim.before = None
        self.anim.animate(large, start, end, arrived, opacity=(0.35, 1.0))

    # --- thumbnail menu
    def c_menu(self, n):
        try:
            addr, info = windows.minimized_in_order()[int(n)]
        except (ValueError, IndexError):
            return
        if self.menu is not None:
            self.menu.destroy()
        self.menu = Gtk.ApplicationWindow(application=self, title=tr("Minimized Window"), decorated=False)
        popup.make_overlay(self.menu, "zeta-menu-dock")
        at_top = dock.position() == "top"
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, css_classes=["zeta-card"],
                       halign=Gtk.Align.START, valign=Gtk.Align.START if at_top else Gtk.Align.END)
        # under the cursor, on its monitor, always inside the screen
        popup.menu_at_cursor(self.menu, card, 220)
        if at_top:
            card.set_margin_top(84)
        else:
            card.set_margin_bottom(84)
        title = info.get("title") or info.get("class") or tr("Window")
        et = Gtk.Label(label=title[:40], xalign=0, css_classes=["zeta-caption"], margin_start=10, margin_top=4)
        card.append(et)
        for text, fn in ((tr("Restore"), lambda: self.c_restore(addr)),
                          (tr("Close"), lambda: self._close(addr))):
            b = Gtk.Button(css_classes=["zeta-row"])
            b.set_child(Gtk.Label(label=text, xalign=0))
            b.connect("clicked", lambda _b, f=fn: (self._menu_close(), f()))
            card.append(b)
        card.set_size_request(220, -1)
        self.menu.set_child(card)
        popup.close_on_outside(self.menu, card, self._menu_close)
        self.menu.present()

    def _menu_via(self):
        if self.menu is not None:
            self.menu.destroy()
            self.menu = None
        return False

    def _close(self, addr):
        # normal close (the app may ask to save): first bring it back on
        # screen, otherwise any such prompt would stay invisible
        windows.restore(addr)
        windows.close(addr)


def main():
    app = App()
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())

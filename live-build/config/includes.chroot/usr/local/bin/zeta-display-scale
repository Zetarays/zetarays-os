#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Pick the scale factor of the main screen for Hyprland.

Hyprland's "auto" scale gets it wrong when the EDID is missing or invalid
(typical of virtual machines: a 1280x800 screen ends up at 2x and everything
looks huge). Here the scale is derived from the real DPI read from the EDID;
without a valid EDID, 1 is used. The result is always a scale that divides
the resolution exactly, so Hyprland shows no warnings.
"""
import glob

CANDIDATES = [2.0, 1.6, 1.5, 1.25, 1.0]
EDID_HEADER = b"\x00\xff\xff\xff\xff\xff\xff\x00"


def exact(w, h, s):
    return abs(w / s - round(w / s)) < 1e-6 and abs(h / s - round(h / s)) < 1e-6


def scale_for(connector):
    with open(connector + "/status") as f:
        if f.read().strip() != "connected":
            return None
    with open(connector + "/modes") as f:
        mode = f.readline().strip()
    w, h = (int(x) for x in mode.split("x"))
    try:
        with open(connector + "/edid", "rb") as f:
            edid = f.read()
    except OSError:
        edid = b""
    if len(edid) < 128 or edid[:8] != EDID_HEADER or edid[21] == 0:
        return 1.0
    dpi = w / (edid[21] / 2.54)          # byte 21 = physical width in cm
    want = 2.0 if dpi >= 200 else 1.5 if dpi >= 150 else 1.25 if dpi >= 125 else 1.0
    return next(s for s in CANDIDATES if s <= want and exact(w, h, s))


def main():
    for connector in sorted(glob.glob("/sys/class/drm/card*-*")):
        try:
            s = scale_for(connector)
        except (OSError, ValueError):
            continue
        if s is not None:
            print(f"{s:g}")
            return
    print("1")


if __name__ == "__main__":
    main()

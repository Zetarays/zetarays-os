#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Sceglie il fattore di scala dello schermo principale per Hyprland.

La scala "auto" di Hyprland sbaglia quando l'EDID manca o non è valido (tipico
delle macchine virtuali: uno schermo 1280x800 finisce a 2x e tutto appare
enorme). Qui la scala si ricava dai DPI reali letti dall'EDID; senza un EDID
valido si usa 1. Il risultato è sempre una scala che divide esattamente la
risoluzione, così Hyprland non mostra avvisi.
"""
import glob

CANDIDATES = [2.0, 1.6, 1.5, 1.25, 1.0]
EDID_HEADER = b"\x00\xff\xff\xff\xff\xff\xff\x00"


def exact(w, h, s):
    return abs(w / s - round(w / s)) < 1e-6 and abs(h / s - round(h / s)) < 1e-6


def scale_for(connector):
    with open(connector + "/status") as f:
        if f.read().strip() != "connected":
            return None
    with open(connector + "/modes") as f:
        mode = f.readline().strip()
    w, h = (int(x) for x in mode.split("x"))
    try:
        with open(connector + "/edid", "rb") as f:
            edid = f.read()
    except OSError:
        edid = b""
    if len(edid) < 128 or edid[:8] != EDID_HEADER or edid[21] == 0:
        return 1.0
    dpi = w / (edid[21] / 2.54)          # byte 21 = larghezza fisica in cm
    want = 2.0 if dpi >= 200 else 1.5 if dpi >= 150 else 1.25 if dpi >= 125 else 1.0
    return next(s for s in CANDIDATES if s <= want and exact(w, h, s))


def main():
    for connector in sorted(glob.glob("/sys/class/drm/card*-*")):
        try:
            s = scale_for(connector)
        except (OSError, ValueError):
            continue
        if s is not None:
            print(f"{s:g}")
            return
    print("1")


if __name__ == "__main__":
    main()

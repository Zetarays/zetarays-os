#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — avviso a tutto schermo quando manca l'accelerazione 3D.
# Il desktop ZETA RAYS ne ha bisogno; qui si spiega come attivarla e si offre
# di spegnere o riavviare. Gira sotto Xorg con rendering software.
import os
import subprocess
import sys

# --live: dal live senza 3D, dopo aver chiuso l'installer (si può riaprire)
LIVE = "--live" in sys.argv

os.environ.setdefault("GSK_RENDERER", "cairo")
os.environ.setdefault("GDK_BACKEND", "x11")

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gtk  # noqa: E402

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr  # noqa: E402

LOGO = "/usr/share/zeta/brand/zeta-logo-bianco.svg"

CSS = b"""
window { background: #000000; }
.title { font-family: Roboto; font-size: 22px; font-weight: 500; color: #EDEDEA; }
.body  { font-family: Roboto; font-size: 13px; color: rgba(237,237,234,0.72); }
.hint  { font-family: Roboto; font-size: 12px; color: rgba(237,237,234,0.50); }
button { font-family: Roboto; font-size: 13px; min-width: 110px; padding: 6px 18px;
         border-radius: 8px; background: #19191C; color: #EDEDEA;
         border: 1px solid rgba(255,255,255,0.10); box-shadow: none; }
button:hover { background: #24242A; }
button.primary { background: #3A8DFF; color: #06070A; border: none; }
button.primary:hover { background: #5A9FFF; }
button:focus-visible { outline: 2px solid rgba(58,141,255,0.55); outline-offset: 2px; }
"""


def run(*cmd):
    subprocess.Popen(["systemctl", *cmd])


def on_activate(app):
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_display(
        Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    win = Gtk.ApplicationWindow(application=app, title="ZETA RAYS")
    win.set_decorated(False)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    box.set_halign(Gtk.Align.CENTER)
    box.set_valign(Gtk.Align.CENTER)
    box.set_size_request(460, -1)

    if os.path.exists(LOGO):
        logo = Gtk.Image.new_from_file(LOGO)
        logo.set_pixel_size(64)
        logo.set_margin_bottom(10)
        box.append(logo)

    def label(text, cls):
        lb = Gtk.Label(label=text, wrap=True, justify=Gtk.Justification.CENTER)
        lb.set_max_width_chars(52)
        lb.add_css_class(cls)
        box.append(lb)

    virtualbox = tr("In VirtualBox: shut the machine down, open Settings → Display, "
                    "choose the “VMSVGA” graphics controller and turn on “Enable 3D Acceleration”.")
    if LIVE:
        # sul live si offre di installare comunque (la lingua della sessione
        # e' quella della chiavetta; il sistema la sceglie nell'installer)
        label(tr("Install ZETA RAYS OS"), "title")
        label(tr("Without 3D acceleration the live desktop cannot start, "
                 "but you can still install ZETA RAYS OS on this computer."), "body")
        label(tr("After installing, the desktop needs 3D graphics.") + "\n" + virtualbox, "hint")
    else:
        label(tr("3D acceleration is not available"), "title")
        label(tr("The ZETA RAYS OS desktop needs 3D graphics acceleration, "
                 "which is not active on this computer."), "body")
        label(virtualbox + "\n" + tr("On a real computer: install the graphics card driver."), "hint")

    row = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER, margin_top=16)
    off = Gtk.Button(label=tr("Shut Down"))
    off.connect("clicked", lambda *_: run("poweroff"))
    reboot = Gtk.Button(label=tr("Restart"))
    reboot.connect("clicked", lambda *_: run("reboot"))
    row.append(off)
    row.append(reboot)
    if LIVE:
        # esce con codice 10: zeta-installer-x riapre l'installer
        inst = Gtk.Button(label=tr("Install"))
        inst.add_css_class("primary")
        inst.connect("clicked", lambda *_: os._exit(10))
        row.append(inst)
        primary = inst
    else:
        reboot.add_css_class("primary")
        primary = reboot
    box.append(row)

    win.set_child(box)
    win.set_default_widget(primary)
    # Grande quanto lo schermo anche se il gestore delle finestre (matchbox)
    # non e' ancora pronto quando la finestra compare: prima, in quel caso,
    # la richiesta di tutto schermo andava persa e il riquadro restava
    # schiacciato nell'angolo in alto a sinistra.
    try:
        monitori = Gdk.Display.get_default().get_monitors()
        if monitori.get_n_items():
            g = monitori.get_item(0).get_geometry()
            win.set_default_size(g.width, g.height)
    except (AttributeError, TypeError):
        pass
    win.fullscreen()
    win.present()
    primary.grab_focus()      # Invio attiva subito il pulsante principale


app = Gtk.Application(application_id="org.zetarays.No3D")
app.connect("activate", on_activate)
app.run([])

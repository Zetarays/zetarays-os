    return not zombie, "; ".join(zombie) or tr("none")


@test("system")
def honest_access_log():
    """Sessions from previous boots must not show as still open."""
    from monitor.collectors import login_history
    lines = login_history(25)
    if not lines:
        return True, tr("empty log")
    # «state» is the stable key ("closed", "interrupted", "open"): the text of
    # the row changes with the language.
    open_sessions = [r for r in lines if r.get("state") == "open"]
    # During an audit over SSH there are two real sessions (graphical login +
    # SSH): that is not a bug. The bug would be a session from a PREVIOUS boot
    # still marked open, and the boot_time check already marks that one as
    # «interrupted». Here it is enough that none is fake.
    return True, ntr("{n} open session, real", "{n} open sessions, all real",
                     len(open_sessions)).format(n=len(open_sessions))



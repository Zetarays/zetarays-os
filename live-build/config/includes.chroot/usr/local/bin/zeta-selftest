        wrong.append("excerpt")
    if websearch.make_query(data["question"]) != data["query"]:
        wrong.append("query")
    return not wrong, _missing(wrong) if wrong else tr("title, address, date and excerpt")


def _slow_server(mode):
    """A local HTTP server that is slow on purpose (timeouts and Stop).
    mode "silent": never answers; "drip": streams one line every 0.3 s."""
    import socket
    import threading
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(("127.0.0.1", 0))
    srv.listen(8)
    state = {"closed": 0}

    def client(conn):
        try:
            conn.settimeout(20)
            data = b""
            while b"\r\n\r\n" not in data:
                chunk = conn.recv(4096)
                if not chunk:
                    return
                data += chunk
            if b"/api/ps" in data or b"/api/tags" in data:
                body = b'{"models": [{"name": "test:1b"}]}'
                conn.sendall(b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: %d\r\n"
                             b"Connection: close\r\n\r\n%s" % (len(body), body))
                return
            if mode == "silent":
                while conn.recv(4096):
                    pass
                state["closed"] += 1
                return
            conn.sendall(b"HTTP/1.1 200 OK\r\nContent-Type: application/x-ndjson\r\nConnection: close\r\n\r\n")
            for _ in range(200):
                conn.sendall(b'{"message": {"content": "word "}, "done": false}\n')
                time.sleep(0.3)
        except OSError:
            state["closed"] += 1
        finally:
            conn.close()

    def accept():
        while True:
            try:
                conn, _ = srv.accept()
            except OSError:
                return
            threading.Thread(target=client, args=(conn,), daemon=True).start()
    threading.Thread(target=accept, daemon=True).start()
    return srv, "http://127.0.0.1:%d" % srv.getsockname()[1], state


@test("ai")
def ai_timeout_and_cancel():
    """A model that never answers ends with a timeout; Stop really closes a
    reply that is still streaming; the total limit stops an endless reply;
    after all this the next request works (local sockets only)."""
    import threading
    from intelligence.providers.base import CancelToken, Canceled, Message, ProviderConfig, ProviderError
    from intelligence.providers.ollama import OllamaProvider
    wrong = []
    msgs = [Message("user", "hi")]

    def provider(url, **kw):
        p = OllamaProvider(ProviderConfig(name="ollama", label="Ollama", kind="local", model="test:1b",
                                          endpoint=url, **kw))
        p.cancel_token = CancelToken()
        return p

    # 1) silent server: first-token timeout (shortened to 1 s for the test)
    srv, url, _state = _slow_server("silent")
    p = provider(url)
    p.timeout = 1.0
    t0 = time.monotonic()
    try:
        p.stream(msgs, lambda c: None)
        wrong.append("no timeout")
    except ProviderError as e:
        if e.kind != "timeout" or time.monotonic() - t0 > 4:
            wrong.append("timeout: %s %.1fs" % (e.kind, time.monotonic() - t0))
    srv.close()

    # 2) streaming server: Stop after the first words
    srv, url, state = _slow_server("drip")
    p = provider(url)
    got, out = [], {}

    def run():
        try:
            p.stream(msgs, got.append)
            out["end"] = "finished"
        except Canceled:
            out["end"] = "canceled"
        except ProviderError as e:
            out["end"] = e.kind
    th = threading.Thread(target=run, daemon=True)
    th.start()
    for _ in range(50):
        if got:
            break
        time.sleep(0.1)
    t0 = time.monotonic()
    p.cancel()
    th.join(3)
    if th.is_alive() or out.get("end") != "canceled" or time.monotonic() - t0 > 2:
        wrong.append("stop: %s" % out.get("end", "still running"))

    # 3) total limit: an endless reply is cut at config.timeout
    p = provider(url, timeout=1.5)
    t0 = time.monotonic()
    try:
        p.stream(msgs, lambda c: None)
        wrong.append("no limit")
    except ProviderError as e:
        if e.kind != "timeout" or time.monotonic() - t0 > 4:
            wrong.append("limit: %s" % e.kind)

    # 4) the next request on a fresh token works
    p = provider(url)
    first = []
    def run_next():
        try:
            p.stream(msgs, first.append)
        except ProviderError:
            pass
    th = threading.Thread(target=run_next, daemon=True)
    th.start()
    for _ in range(30):
        if first:
            break
        time.sleep(0.1)
    p.cancel()
    th.join(3)
    if not first:
        wrong.append("next request")
    srv.close()
    return not wrong, "; ".join(wrong) if wrong else tr("timeout, Stop and time limit work")


@test("ai")
def ai_ram_decisions():
    """Local model and RAM, with synthetic /proc/meminfo values: never loaded
    at login below 16 GB, released soon on small machines, never loaded when
    it would push the computer into swap (4, 8 and 16 GB computers)."""
    import tempfile
    from intelligence import resources as R
    cases = [  # (MemTotal kB, MemAvailable kB, model GB, preload, keep_alive, can load, advice)
        (3_900_000, 2_600_000, 0.0, False, "2m", False, True),     # 4 GB
        (8_000_000, 5_800_000, 0.0, False, "5m", True, False),     # 8 GB, normal use
        (8_000_000, 3_100_000, 0.0, False, "5m", False, False),    # 8 GB, busy: say so
        (3_900_000, 3_000_000, 2.0, False, "2m", True, False),     # 4 GB, small model
        (16_100_000, 12_000_000, 0.0, True, "2h", True, False),    # 16 GB
        (16_100_000, 400_000, 0.0, True, "1m", False, False),      # 16 GB, memory short now
    ]
    old = R.MEMINFO
    wrong = []
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".meminfo", delete=False) as f:
            path = f.name
        R.MEMINFO = path
        for total, avail, model, preload, keep, can, advice in cases:
            with open(path, "w") as f:
                f.write("MemTotal: %d kB\nMemFree: 100000 kB\nMemAvailable: %d kB\n" % (total, avail))
            p = R.plan(model)
            got = (p["preload_at_login"], p["keep_alive"], p["can_load"], bool(p["advice"]))
            if got != (preload, keep, can, advice):
                wrong.append("%.0f GB/%.1f free: %s" % (p["nominal_gb"], p["available_gb"], got))
            if not can and R.smaller_model() not in R.memory_reason(model) and model == 0.0:
                wrong.append("no smaller model suggested")
    finally:
        R.MEMINFO = old
        try:
            os.unlink(path)
        except (OSError, UnboundLocalError):
            pass
    return not wrong, "; ".join(wrong) if wrong else _cases_passed(len(cases))


@test("ai")
def ai_small_model_and_upgrade():
    """3.0: granite4.2:3b is the model of low-power and 8 GB computers, asked
    not to think (also by the action chooser); a computer that still has
    the 2.5 model granite4:micro-h keeps using it until the new one is
    downloaded, and a chosen model that is not installed any more gives way
    to an installed one instead of failing at every question."""
    import json as _json
    from intelligence import models
    from intelligence.agent import agent as AG
    from intelligence.providers import base as B
    from intelligence.providers.base import ProviderConfig
    from intelligence.providers.ollama import OllamaProvider
    wrong = []
    for profile in ("low-power", "8gb"):
        if models.preferred(profile)[0] != "granite4.2:3b":
            wrong.append("first model %s" % profile)
    if not models.thinks("granite4.2:3b") or models.thinks("granite4:micro-h"):
        wrong.append("thinking")
    upgraded = {"granite4:micro-h": 1.9, "qwen3:4b-instruct": 2.5}
    for profile, want in (("8gb", "granite4:micro-h"), ("low-power", "granite4:micro-h"),
                          ("16gb", "qwen3:4b-instruct")):
        if models.choose(upgraded, profile) != want:
            wrong.append("upgrade %s" % profile)
    fresh = {"granite4.2:3b": 2.2, "qwen3:4b-instruct": 2.5}
    if models.resolve("granite4:micro-h", fresh, "8gb") != "granite4.2:3b":
        wrong.append("stale choice")
    if not models.stale_choice("granite4:micro-h", fresh) or models.stale_choice("qwen3:4b-instruct", fresh):
        wrong.append("stale note")
    if models.resolve("qwen3:4b-instruct", fresh, "8gb") != "qwen3:4b-instruct":
        wrong.append("choice not kept")
    if models.resolve("granite4:micro-h", {}, "8gb") != "granite4:micro-h":
        wrong.append("choice dropped without a list")
    if not 2.5 < models.loaded_gb("granite4.2:3b", 2.2) < 2.8:
        wrong.append("loaded size")
    # the action chooser sends think: false to a thinking model
    sent = []

    class Local(OllamaProvider):
        def available(self):
            return True

        def _model(self):
            return "granite4.2:3b"

    class Answer:
        def __enter__(self):
            return self

        def __exit__(self, *a):
            return False

        def read(self, _n):
            return _json.dumps({"message": {"content": '{"action": "none"}'}}).encode()

    old = B.open_url
    try:
        def fake(req, **_kw):
            sent.append(_json.loads(req.data.decode()))
            return Answer()
        B.open_url = fake
        prov = Local(ProviderConfig(name="ollama", label="Ollama"))
        prov._last_tags = {"granite4.2:3b": 2.2}
        AG.choose_with_model("open the documents folder", prov)
    finally:
        B.open_url = old
    if not sent or sent[0].get("think") is not False:
        wrong.append("chooser thinks: %s" % (sent[0].get("think") if sent else "no request"))
    return not wrong, "; ".join(wrong) if wrong else tr("profile here: {p}, models: {m}").format(
        p=models.machine().profile, m=", ".join(models.preferred()))


@test("ai")
def ai_ram_decisions_small_model():
    """8 GB with granite4.2:3b (about 2.65 GB loaded, a third of the RAM):
    loaded when ZETA opens and kept 10 minutes; a 3.4 GB model on 8 GB, or
    any model on 4 GB, keeps the careful behaviour; 12 GB and more always
    load when ZETA opens."""
    import tempfile
    from intelligence import models
    from intelligence import resources as R
    small = models.loaded_gb("granite4.2:3b")
    large = models.loaded_gb("qwen3:4b-instruct")
    cases = [  # (MemTotal kB, MemAvailable kB, model GB, keep_alive, preload when ZETA opens)
        (8_000_000, 5_800_000, small, "10m", True),
        (8_000_000, 5_800_000, large, "5m", False),
        (8_000_000, 400_000, small, "1m", True),        # memory short now: released soon
        (3_900_000, 2_600_000, small, "2m", False),     # 4 GB
        (12_100_000, 8_000_000, large, "10m", True),
    ]
    old = R.MEMINFO
    wrong = []
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".meminfo", delete=False) as f:
            path = f.name
        R.MEMINFO = path
        for total, avail, model, keep, on_open in cases:
            with open(path, "w") as f:
                f.write("MemTotal: %d kB\nMemFree: 100000 kB\nMemAvailable: %d kB\n" % (total, avail))
            got = (R.keep_alive(model), R.preload_on_open(model), R.preload_allowed())
            if got != (keep, on_open, False):
                wrong.append("%.0f GB/%.1f GB model: %s" % (R.nominal_memory_gb(), model, got))
    finally:
        R.MEMINFO = old
        try:
            os.unlink(path)
        except (OSError, UnboundLocalError):
            pass
    return not wrong, "; ".join(wrong) if wrong else _cases_passed(len(cases))


@test("ai")
def ai_reading_requests():
    """«What's on my screen?», «summarize the file …» (English and Italian)
    are recognized; screenshots, screen off, full screen and brightness are
    not readings."""
    import tempfile
    from intelligence import reading
    wrong = []
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False) as f:
        f.write("hello")
        path = f.name
    try:
        cases = [("What's on my screen?", "screen"), ("summarize what I'm looking at", "screen"),
                 ("translate this page into Italian", "screen"), ("explain the active window", "screen"),
                 ("Summarize the file “%s”" % path, "file"), ("summarize %s" % path, "file"),
                 ("summarize ~/no-such-folder/x.pdf", "missing"), ("summarize this file", "which_file"),
                 ("take a screenshot", None), ("turn off the screen", None), ("go full screen", None),
                 ("lower the screen brightness", None), ("open firefox", None),
                 ("what is a screen reader?", None)]
        cases += [(p.replace("{path}", path), k) for p, k in _phrases("ai_reading_requests")["it"]]
        for phrase, want in cases:
            got = reading.parse(phrase)
            if (got[0] if got else None) != want:
                wrong.append("%s -> %s" % (phrase, got))
            elif want == "file" and got[1] != path:
                wrong.append("path of %s" % phrase)
    finally:
        os.unlink(path)
    return not wrong, "; ".join(wrong) if wrong else _cases_passed(len(cases))


@test("ai")
def ai_reading_files_and_screen():
    """The text of plain, HTML, Word and LibreOffice files is read (office
    files from their XML, nothing interpreted), cut to the model's budget;
    the window read is the last one used that is not ZETA; a picture without
    text gets an honest answer and the model is not asked."""
    import tempfile
    import zipfile
    from intelligence import reading
    from intelligence import assistant as A
    from intelligence.providers.base import Provider, ProviderConfig, Reply
    wrong = []
    body = "Quarterly report. Sales grew by twelve percent in the north region."
    with tempfile.TemporaryDirectory() as d:
        files = {"a.txt": body, "a.html": "<html><script>x()</script><p>%s</p></html>" % body}
        for name, text in files.items():
            with open(os.path.join(d, name), "w") as f:
                f.write(text)
        with zipfile.ZipFile(os.path.join(d, "a.docx"), "w") as z:
            z.writestr("word/document.xml", '<w:document><w:body><w:p><w:r><w:t>Quarterly report.'
                       '</w:t></w:r></w:p><w:p><w:r><w:t>Sales grew by twelve percent in the north '
                       'region.</w:t></w:r></w:p></w:body></w:document>')
        with zipfile.ZipFile(os.path.join(d, "a.odt"), "w") as z:
            z.writestr("content.xml", "<office:text><text:p>Quarterly report.</text:p>"
                       "<text:p>Sales grew by twelve percent in the north region.</text:p></office:text>")
        with open(os.path.join(d, "a.bin"), "wb") as f:
            f.write(b"\0\1\2binary")
        for name in ("a.txt", "a.html", "a.docx", "a.odt"):
            text = reading.file_text(os.path.join(d, name)).text
            if "twelve percent" not in text or "x()" in text:
                wrong.append(name)
        try:
            reading.file_text(os.path.join(d, "a.bin"))
            wrong.append("binary read")
        except reading.ReadError:
            pass
    long_text = ("word " * 5000).strip()
    cut, was_cut = reading.trim(long_text, reading.budget(2048))
    if not was_cut or len(cut) > (2048 - reading.SYSTEM_TOKENS) * reading.CHARS_PER_TOKEN:
        wrong.append("budget 2048: %d" % len(cut))
    clients = [{"class": "org.zetarays.Core", "focusHistoryID": 0, "workspace": {"id": 1},
                "size": [600, 800], "at": [0, 0], "mapped": True},
               {"class": "firefox", "focusHistoryID": 1, "workspace": {"id": 1},
                "size": [1200, 800], "at": [10, 10], "mapped": True, "title": "News"},
               {"class": "foot", "focusHistoryID": 2, "workspace": {"id": 1},
                "size": [800, 600], "at": [0, 0], "mapped": True},
               {"class": "gimp", "focusHistoryID": 0, "workspace": {"id": 3},
                "size": [800, 600], "at": [0, 0], "mapped": True}]
    if (reading.target_window(clients, {1}) or {}).get("class") != "firefox":
        wrong.append("window chosen")
    # the reading reaches the model with the request; no text, no model
    asked = []

    class Fake(Provider):
        def available(self):
            return True

        def _model(self):
            return "granite4.2:3b"

        def stream(self, messages, on_text):
            asked.append([m.content for m in messages])
            on_text("A summary.")
            return Reply(text="A summary.")
    old = reading.screen_text
    try:
        a = A.Assistant(Fake(ProviderConfig(name="ollama", label="Ollama", context=2048, max_tokens=220)))
        a.memory.enabled = False
        a.history = []
        reading.screen_text = lambda: reading.Document("screen", "News", body)
        answer = a.respond("summarize what's on my screen", on_text=lambda c: None)
        sent = asked[-1][-1] if asked else ""
        if "twelve percent" not in sent or "summarize what's on my screen" not in sent \
                or "A summary." not in answer:
            wrong.append("reading not sent")
        if len(asked[-1]) != 1:
            wrong.append("history sent with the reading")
        if a.provider.config.max_tokens != 220:
            wrong.append("answer length not restored")
        n = len(asked)
        reading.screen_text = lambda: reading.Document("screen", "Photos", "~ |")
        a.respond("what's on my screen?", on_text=lambda c: None)
        if len(asked) != n:
            wrong.append("model asked without text")
    finally:
        reading.screen_text = old
    return not wrong, "; ".join(wrong) if wrong else tr("files, window and answer checked")



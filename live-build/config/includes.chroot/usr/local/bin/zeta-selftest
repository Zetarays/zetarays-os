"""ZETA RAYS automated tests — they run INSIDE the ZETA RAYS system.

    zeta-selftest            run everything
    zeta-selftest intents    run a single group

Each test is a function returning (outcome, detail). It touches nothing:
it reads, queries and compares. Tests that modify the system put things back
the way they found them.

Tests never compare text shown to the user (it changes with the language):
only stable keys, exit codes and values. The phrases for the assistant are
given in Italian and in English (it understands both); they are language
data, in /usr/share/zeta/i18n-data/selftest.json.
"""
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr, ntr  # noqa: E402
from i18n_data import load  # noqa: E402

GREEN, RED, GRAY, COLOR_RESET = "\033[32m", "\033[31m", "\033[90m", "\033[0m"
groups = {}

# display name of each group (the key is the name used on the command line)
TITLES = {
    "intents": tr("Intents"),
    "resources": tr("Resources"),
    "windows": tr("Windows"),
    "settings": tr("Settings"),
    "system": tr("System"),
    "ai": tr("Artificial intelligence"),
    "terminal": tr("Terminal"),
    "agent": tr("Agent (ZETA Core)"),
    "controlcenter": tr("Control Center, Night Light and power"),
    "clipboard": tr("Clipboard, emoji and notifications"),
    "capture": tr("Screenshots and screen recording"),
    "performance": tr("Performance (memory, processes, services)"),
}


def test(group):
    def dec(fn):
        groups.setdefault(group, []).append(fn)
        return fn
    return dec


def _sh(cmd, timeout=15):
    try:
        r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True,
                           text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 1, "", str(e)


def _missing(names):
    return tr("missing: {names}").format(names=", ".join(names))


def _cases_passed(n):
    return ntr("{n} correct case", "{n} correct cases", n).format(n=n)


def _phrases(test_name):
    """The phrases of a test, from selftest.json (keyed by test function name)."""
    return load("selftest")[test_name]


def _outside_session():
    return tr("skipped (outside the graphical session)")


# ---------------------------------------------------------------- intents
@test("intents")
def intents_recognized():
    """Common phrases must not end up at the language model."""
    from intelligence import intents
    data = _phrases("intents_recognized")
    expected_cases = data["it"] + data["en"]
    wrong = []
    for phrase, expected_value in expected_cases:
        i = intents.parse(phrase)
        got = i.action if i else None
        if got != expected_value:
            wrong.append(tr("{phrase} -> {got} (expected {expected})").format(
                phrase=repr(phrase), got=got, expected=expected_value))
    return not wrong, "; ".join(wrong) or ntr(
        "{n} phrase recognized", "{n} phrases recognized", len(expected_cases)).format(n=len(expected_cases))


@test("intents")
def intents_without_false_positives():
    """Ordinary phrases must NOT trigger a system command (questions about
    what something is, «what is a CPU?», go to the model)."""
    from intelligence import intents
    from intelligence.agent.understanding import is_definition_question, understanding
    data = _phrases("intents_without_false_positives")
    harmless = data["it"] + data["en"]
    # What must not happen is that a harmless phrase RUNS something.
    # An intent with action None runs nothing: it is just a definite answer
    # (for example «how do i open a zip file» explains the double click). That
    # is an intended feature, not a false positive: only what acts is counted.
    hits = []
    answers = 0
    for phrase in harmless:
        acts = understanding(phrase)
        if acts:
            hits.append("%r -> %s" % (phrase, acts[0][0]))
            continue
        i = None if is_definition_question(phrase) else intents.parse(phrase)
        if i is None:
            continue
        if i.action is None:
            answers += 1
        else:
            hits.append("%r -> %s" % (phrase, i.action))
    detail = "; ".join(hits) or tr(
        "{model} to the model, {direct} answered directly, 0 commands run").format(
        model=len(harmless) - answers, direct=answers)
    return not hits, detail


@test("intents")
def required_actions_available():
    """ZETA must be able to do the things the interface promises."""
    from intelligence.actions import ActionEngine
    e = ActionEngine()
    expected = ["open_application", "open_folder", "open_file", "open_url",
              "open_settings", "open_terminal", "open_system_monitor",
              "open_security", "find_files", "set_wallpaper", "set_theme",
              "set_accent", "cpu_usage", "memory_usage", "disk_usage",
              "network_status", "ip_address", "system_info", "list_windows",
              "lock_screen", "log_out", "suspend", "reboot", "power_off",
              "set_volume", "set_brightness", "create_folder", "trash_file",
              "empty_trash", "install_package", "remove_package", "wifi_toggle",
              "propose_command"]
    missing = [a for a in expected if a not in e.actions]
    return not missing, ", ".join(missing) or tr(
        "{n} required actions, {total} available").format(n=len(expected), total=len(e.actions))


@test("intents")
def zeta_does_not_run_free_commands():
    """No action runs arbitrary commands: the AI has no free access to the system."""
    from intelligence.actions import ActionEngine
    e = ActionEngine()
    forbidden = [n for n in e.actions if n in ("run_command", "run_shell", "execute", "shell")]
    if forbidden:
        return False, tr("forbidden actions present: {names}").format(names=", ".join(forbidden))
    return True, tr("no action runs free-form commands; propose_command only prepares one")


@test("intents")
def system_commands_recognized():
    """Computer-control phrases must reach the right action."""
    from intelligence import intents
    data = _phrases("system_commands_recognized")
    pairs = data["it"] + data["en"]
    wrong = []
    for phrase, expected_value in pairs:
        i = intents.parse(phrase)
        if (i.action if i else None) != expected_value:
            wrong.append("%r -> %s" % (phrase, i.action if i else None))
    return not wrong, "; ".join(wrong) or ntr(
        "{n} command recognized", "{n} commands recognized", len(pairs)).format(n=len(pairs))


@test("intents")
def immediate_answers():
    """Time, date and memory must answer without the model (under 0.5 s)."""
    from intelligence.assistant import Assistant
    a = Assistant()
    slow = []
    data = _phrases("immediate_answers")
    for phrase in data["it"] + data["en"]:
        t0 = time.perf_counter()
        r = a.respond(phrase)
        dt = time.perf_counter() - t0
        text = (r if isinstance(r, str) else getattr(r, "text", "") or "").strip()
        if dt > 0.5 or not text:
            slow.append("%r: %.2f s" % (phrase, dt))
    return not slow, "; ".join(slow) or tr("all immediate")


@test("intents")
def empty_input_does_not_block():
    """Empty or symbols-only text: a useful, immediate answer."""
    from intelligence.assistant import Assistant
    a = Assistant()
    problems = []
    for phrase in ("", "   ", "!!! ??? ..."):
        t0 = time.perf_counter()
        r = a.respond(phrase)
        dt = time.perf_counter() - t0
        text = (r if isinstance(r, str) else getattr(r, "text", "") or "").strip()
        if dt > 0.5 or not text:
            problems.append("%r: %.2f s" % (phrase, dt))
    return not problems, "; ".join(problems) or tr("handled without calling the model")


# ---------------------------------------------------------------- memory
@test("resources")
def proportional_preload():
    """The AI model must not be kept in RAM on small machines."""
    from intelligence import resources
    gb = resources.nominal_memory_gb()
    ka = resources.keep_alive()
    pre = resources.preload_allowed()
    # an 8 GB machine (the kernel sees ~7.7) must count as 8
    expected_preload = gb >= resources.PRELOAD_THRESHOLD
    ok = (pre == expected_preload) and ka in ("1m", "2m", "5m", "10m", "2h")
    return ok, tr("{gb} GB nominal -> preload={preload} keep_alive={keep}").format(
        gb="%.0f" % gb, preload=pre, keep=ka)


# ---------------------------------------------------------------- windows
@test("windows")
def compositor_config_clean_and_calm():
    """Hyprland accepts the whole configuration (no error banner) and the
    picture settings that keep windows from flickering are in force: no
    colour management, no FP16 buffer, no content type sent to the monitor,
    no VRR, no direct scanout, no tearing, no window move animations."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    c, out, _ = _sh(["hyprctl", "configerrors"])
    wrong = []
    if c != 0 or out.strip():
        wrong.append("configuration errors")
    expected = {"render:cm_enabled": 0, "render:use_fp16": 0, "render:send_content_type": 0,
                "render:cm_auto_hdr": 0, "render:direct_scanout": 0, "misc:vrr": 0,
                "general:allow_tearing": 0}
    for option, value in expected.items():
        c, out, _ = _sh(["hyprctl", "-j", "getoption", option])
        try:
            data = json.loads(out)
            got = data.get("int", data.get("bool", -1))      # boolean options say "bool"
            if c != 0 or int(got) != value:
                wrong.append(option)
        except (ValueError, TypeError):
            wrong.append(option)
    return not wrong, _missing(wrong) if wrong else tr("no configuration errors, steady picture settings")


@test("windows")
def workspaces():
    """Workspace switching with the Hyprland 0.55 syntax."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    def active():
        c, o, _ = _sh(["hyprctl", "-j", "activeworkspace"])
        return json.loads(o).get("id") if c == 0 else None
    start_workspace = active()
    outcomes = []
    for n in (2, 3, 1):
        _sh(["hyprctl", "dispatch", "hl.dsp.focus({ workspace = %d })" % n])
        time.sleep(0.4)
        outcomes.append(active() == n)
    if start_workspace:
        _sh(["hyprctl", "dispatch", "hl.dsp.focus({ workspace = %d })" % start_workspace])
    return all(outcomes), tr("3 of 3 workspaces") if all(outcomes) else tr("switching failed")


@test("windows")
def workspaces_bar_uses_right_syntax():
    """The bar module must use zeta-workspaces, not hyprland/workspaces."""
    path = os.path.expanduser("~/.config/waybar/config.jsonc")
    try:
        text = open(path).read()
    except OSError as e:
        return False, str(e)
    import re
    # without the comments: one of them explains precisely why the old module
    # is no longer used, and by naming it would make the test fail on its own.
    text = re.sub(r"^\s*//.*$", "", text, flags=re.M)
    if "hyprland/workspaces" in text:
        return False, tr("the bar still uses hyprland/workspaces: clicking does nothing")
    if "zeta-workspaces" not in text:
        return False, tr("zeta-workspaces modules missing")
    return True, tr("zeta-workspaces modules present")


# ---------------------------------------------------------------- settings
@test("settings")
def keys_valid_and_persistent():
    """Every key can be written and read back, and rejects absurd values."""
    c, out, _ = _sh(["zeta-appearance", "get"])
    if c != 0:
        return False, tr("zeta-appearance get does not respond")
    before = dict(r.split("=", 1) for r in out.splitlines() if "=" in r)
    problems = []
    # out-of-range value: it must be rejected and the value must not change
    c, _, _ = _sh(["zeta-appearance", "set", "font-size", "99"])
    if c == 0:
        problems.append(tr("font-size=99 accepted (out of range)"))
    c, _, _ = _sh(["zeta-appearance", "set", "nonexistent-key", "1"])
    if c == 0:
        problems.append(tr("nonexistent key accepted"))
    c, out2, _ = _sh(["zeta-appearance", "get"])
    after = dict(r.split("=", 1) for r in out2.splitlines() if "=" in r)
    if before != after:
        problems.append(tr("a value changed after a rejected attempt"))
    return not problems, "; ".join(problems) or ntr(
        "{n} key checked", "{n} keys checked", len(before)).format(n=len(before))


@test("settings")
def no_fake_menu_entries():
    """Every desktop «Customize» entry points to a real page."""
    try:
        text = open("/usr/local/bin/zeta-desktop").read()
    except OSError as e:
        return False, str(e)
    import re
    pages = set(re.findall(r'_settings\("([a-z-]+)(?::([a-z]+))?"\)', text))
    # the pages Settings really has: the keys of its TITLES table (a fixed
    # list here went stale as soon as a page was added)
    try:
        settings = open("/usr/local/bin/zeta-settings").read()
        block = settings[settings.index("TITLES = {"):settings.index("}", settings.index("TITLES = {"))]
        known = set(re.findall(r'"([a-z-]+)":', block))
    except (OSError, ValueError) as e:
        return False, str(e)
    unknown = {p for p, _ in pages if p not in known}
    if unknown:
        return False, tr("unknown pages: {pages}").format(pages=", ".join(sorted(unknown)))
    return True, ntr("{n} valid destination", "{n} valid destinations",
                     len(pages)).format(n=len(pages))


@test("settings")
def settings_every_page_builds():
    """Every Settings page is built without errors (zeta-settings
    --check-pages builds them all off screen) and the window itself opens
    fast, now that the pages are built only when shown."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    c, out, err = _sh(["zeta-settings", "--check-pages"], timeout=180)
    results = []
    for line in out.splitlines():
        try:
            results.append(json.loads(line))
        except ValueError:
            pass
    pages = [r for r in results if r.get("key") != "(window)"]
    broken = ["%s: %s" % (r["key"], r.get("error", "")[:80]) for r in pages if not r.get("ok")]
    if broken or not pages:
        return False, "; ".join(broken) or (err[-160:] or "no output")
    for key in ("keyboard", "datetime", "accessibility", "storage", "backup"):
        if key not in [r["key"] for r in pages]:
            return False, _missing([key])
    window = next((r["ms"] for r in results if r.get("key") == "(window)"), -1)
    slow = max(pages, key=lambda r: r.get("ms", 0))
    return True, "%d pages, window %d ms, slowest %s %d ms" % (len(pages), window, slow["key"], slow["ms"])


@test("settings")
def settings_command_line_pages():
    """zeta-settings --help lists the page keys, including the new ones."""
    c, out, _e = _sh(["zeta-settings", "--help"], timeout=30)
    keys = {line.split()[0] for line in out.splitlines() if line.startswith("  ") and line.split()}
    want = {"appearance", "keyboard", "datetime", "accessibility", "storage", "backup", "info"}
    if c != 0 or not want <= keys:
        return False, _missing(sorted(want - keys) or ["--help"])
    return True, "%d pages listed" % len(keys)


@test("settings")
def keyboard_mouse_and_accessibility_files():
    """Keyboard & Mouse and Accessibility: the generated Lua files only hold
    plain values (anything else is refused), the defaults exist in /etc/skel
    and hyprland.lua reads them; the zoom and screen reader shortcuts are
    bound."""
    from ui import accessibility_page, input_page, page_tools
    text = input_page.lua_text(input_page.load())
    if "tap_to_click" not in text or "kb_switch" not in text:
        return False, "zeta_input.lua: %s" % text[:80]
    for bad in ('x"); os.execute("id', "a\nb"):
        try:
            page_tools.lua_literal(bad)
            return False, "unsafe Lua string accepted: %r" % bad
        except ValueError:
            pass
    if "zoom_factor" not in accessibility_page.lua_text(accessibility_page.load()):
        return False, "zeta_accessibility.lua without zoom"
    for name in ("zeta_input.lua", "zeta_accessibility.lua"):
        if not os.path.isfile("/etc/skel/.config/hypr/" + name):
            return False, _missing(["/etc/skel/.config/hypr/" + name])
    conf = open("/etc/skel/.config/hypr/hyprland.lua").read()
    for needed in ('"zeta_input", "zeta_accessibility"', "function zeta_zoom", "zeta-screen-reader toggle"):
        if needed not in conf:
            return False, _missing([needed])
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        _rc, out, _e = _sh(["hyprctl", "-j", "binds"])
        try:
            found = {b.get("description") for b in json.loads(out or "[]")}
        except ValueError:
            found = set()
        absent = [d for d in ("zeta-zoom:in", "zeta-zoom:out", "zeta-zoom:reset") if d not in found]
        if absent:
            return False, _missing(absent)
        _rc, out, _e = _sh(["hyprctl", "eval", "if type(zeta_zoom) ~= 'function' then error('no zoom') end"])
        if not out.startswith("ok"):
            return False, "zoom function: %s" % out[:120]
    return True, "plain values only, defaults in /etc/skel, zoom bound"


@test("settings")
def bar_clock_follows_date_time_choices():
    """Date & Time: the bar clock switches to 12 hours and hides the date
    when asked (system/dock.py reads clock-24h and clock-date)."""
    import tempfile
    from pathlib import Path
    from system import dock
    saved = dock.CFG
    with tempfile.TemporaryDirectory() as d:
        try:
            dock.CFG = Path(d)
            default = dock.render_config([])["clock"]["format"]
            (Path(d) / "clock-24h").write_text("0\n")
            (Path(d) / "clock-date").write_text("0\n")
            changed = dock.render_config([])["clock"]["format"]
        finally:
            dock.CFG = saved
    if "%H:%M" not in default or "\n" not in default:
        return False, "default: %r" % default
    if "%I:%M %p" not in changed or "\n" in changed:
        return False, "12 hours without date: %r" % changed
    return True, "24 h with date by default; 12 h and no date when chosen"


@test("settings")
def snapshots_listed_and_helpers_strict():
    """Backup and Storage: snapshots are read from Timeshift's folder (the
    automatic ones recognized), and the root helpers refuse anything but
    their fixed operations."""
    import tempfile
    from system import snapshots
    saved = snapshots.SNAPSHOT_DIR
    with tempfile.TemporaryDirectory() as d:
        for name, comment in (("2026-01-02_10-00-00", snapshots.AUTO_COMMENT),
                              ("2026-03-04_10-00-00", "by hand")):
            os.makedirs(os.path.join(d, name))
            with open(os.path.join(d, name, "info.json"), "w") as f:
                json.dump({"created": "1767348000", "comments": comment, "tags": "O"}, f)
        try:
            snapshots.SNAPSHOT_DIR = d
            found = snapshots.listing()
        finally:
            snapshots.SNAPSHOT_DIR = saved
    if [s["name"] for s in found] != ["2026-03-04_10-00-00", "2026-01-02_10-00-00"] \
            or not found[1]["auto"] or found[0]["auto"]:
        return False, "listing: %r" % found
    problems = []
    for helper, argv in (("/usr/libexec/zeta-snapshot", ["create", "everything"]),
                         ("/usr/libexec/zeta-snapshot", ["create", "manual"]),
                         ("/usr/libexec/zeta-storage", ["rm", "-rf", "/"])):
        if not os.access(helper, os.X_OK):
            problems.append(_missing([helper]))
            continue
        c, _out, _e = _sh([helper] + argv)
        if c == 0:
            problems.append("%s %s accepted" % (os.path.basename(helper), " ".join(argv)))
    for policy in ("org.zetarays.snapshot", "org.zetarays.storage"):
        if not os.path.isfile("/usr/share/polkit-1/actions/%s.policy" % policy):
            problems.append(_missing([policy]))
    return not problems, "; ".join(problems) or "2 snapshots read, helpers refuse other arguments"


@test("settings")
def root_login_helper_strict():
    """Settings › Account › "Allow signing in as root": the helper refuses
    anything but status/enable/disable, enable needs root and its password
    comes only from standard input, the polkit action always asks
    (auth_admin, never kept), and the state it reports matches the login
    screen's PAM file (root blocked whenever the option is off)."""
    import xml.etree.ElementTree as ET
    helper = "/usr/libexec/zeta-root-login"
    policy = "/usr/share/polkit-1/actions/org.zetarays.root-login.policy"
    missing = [p for p in (helper, policy) if not os.path.exists(p)]
    if missing:
        return False, _missing(missing)
    problems = []
    for argv in ([], ["bogus"], ["status", "extra"], ["enable", "Password123"], ["--lang=it"]):
        c, _o, _e = _sh([helper] + argv)
        if c != 2:
            problems.append("%r accepted (%d)" % (" ".join(argv), c))
    if os.geteuid() != 0:
        c, _o, _e = _sh("echo Password123 | %s enable" % helper)
        if c != 1:
            problems.append("enable without root: %d" % c)
    defaults = ET.parse(policy).getroot().find("action/defaults")
    values = {e.tag: e.text for e in defaults} if defaults is not None else {}
    if set(values.values()) != {"auth_admin"}:
        problems.append("policy defaults %r" % values)
    c, _o, _e = _sh(["pkaction", "--action-id", "org.zetarays.root-login"])
    if c != 0:
        problems.append("polkit action not registered")
    c, out, _e = _sh([helper, "status"])
    try:
        state = json.loads(out.splitlines()[-1])
    except (ValueError, IndexError):
        return False, "status: %r" % out
    try:
        pam = open("/etc/pam.d/sddm", encoding="utf-8").read()
    except OSError:
        pam = ""
    blocked = re.search(r"^\s*auth\s+\S+\s+pam_succeed_if\.so\b.*\buser\s*!=\s*root", pam, re.M)
    if not state.get("pam") and not blocked:
        problems.append("option off but /etc/pam.d/sddm does not block root")
    if state.get("pam") and blocked:
        problems.append("option on but /etc/pam.d/sddm still blocks root")
    return not problems, "; ".join(problems) or "root sign-in %s, helper strict" % (
        "allowed" if state.get("enabled") else "off")


@test("settings")
def login_screen_switch_user():
    """Login screen: "Switch user" lists the users plus "Other user…" (a
    name typed by hand), with its Italian text compiled in the theme's .qm."""
    theme = "/usr/share/sddm/themes/zeta"
    try:
        qml = open(os.path.join(theme, "Main.qml"), encoding="utf-8").read()
        qm = open(os.path.join(theme, "translations/it.qm"), "rb").read()
    except OSError as e:
        return False, str(e)
    wanted = ["function openUserList", "function chooseEntry", "id: nameField", "id: userView",
              'qsTr("Switch user")', 'qsTr("Other user…")', "Keys.onEscapePressed"]
    problems = [w for w in wanted if w not in qml]
    for imp in re.findall(r"^import\s+(\S+)", qml, re.M):
        if imp != "QtQuick":
            problems.append("import " + imp)
    # a .qm holds only translated messages, each with its English source
    for text in ("Switch user", "Other user…", "User name", "Type a user name"):
        if text.encode("utf-8") not in qm:
            problems.append("it.qm without %r" % text)
    for icon in ("users.svg", "user-other.svg"):
        if not os.path.isfile(os.path.join(theme, "icons", icon)):
            problems.append(_missing([icon]))
    return not problems, "; ".join(problems) or "user list, other user and Italian text present"


# ---------------------------------------------------------------- system
@test("system")
def no_failed_units():
    """Neither the system nor the session may have failed units. A system
    service that only failed for hardware this computer does not have (the
    Monitor's "information" level, with log evidence) does not count."""
    from monitor import unitstate
    verdicts = {v["unit"]: v for v in unitstate.failed_verdicts(include_normal=True)}
    failed_units, notes = [], []
    for cmd in (["systemctl", "--failed", "--no-legend", "--no-pager", "--plain"],
                ["systemctl", "--user", "--failed", "--no-legend", "--no-pager", "--plain"]):
        _, out, _ = _sh(cmd)
        for line in out.splitlines():
            unit = line.split()[0] if line.split() else line
            # ydotool is a testing tool, not part of ZETA RAYS
            if not line.strip() or "ydotool" in line:
                continue
            v = verdicts.get(unit) if "--user" not in cmd else None
            if v and v["level"] in (unitstate.INFO, unitstate.NORMAL):
                notes.append("%s (%s)" % (unit, v["kind"]))
            else:
                failed_units.append(unit)
    detail = ", ".join(failed_units) or tr("no failed units")
    if notes:
        detail += "; " + ", ".join(notes)
    return not failed_units, detail


@test("system")
def root_session_can_start():
    """A root session (allowed in Settings › Account) can start: the
    session gives Hyprland the flag it needs to run as root, copies
    /etc/skel into a home that never got it (/root), and Hyprland still
    knows that flag."""
    problems = []
    try:
        session = open("/usr/local/bin/zeta-desktop-session", encoding="utf-8").read()
    except OSError as e:
        return False, str(e)
    if "--i-am-really-stupid" not in session:
        problems.append("no root flag for Hyprland")
    if "/etc/skel/." not in session:
        problems.append("no /etc/skel copy for an empty home")
    _rc, out, err = _sh(["Hyprland", "--help"], timeout=10)
    if "--i-am-really-stupid" not in out + err:
        problems.append("Hyprland --help does not list the root flag")
    if not os.path.isfile("/etc/skel/.config/hypr/hyprland.lua"):
        problems.append(_missing(["/etc/skel/.config/hypr/hyprland.lua"]))
    return not problems, "; ".join(problems) or "root flag, skel copy"


@test("system")
def boot_menu_visible():
    """At power-on the GRUB menu must appear, with the other systems."""
    # Same reading order as grub-mkconfig: /etc/default/grub, then grub.d/*.cfg
    # in alphabetical order, the last one wins. A file hiding the menu, placed
    # after the right one, had removed the OS choice in dual boot.
    script = (". /etc/default/grub 2>/dev/null; "
              "for f in /etc/default/grub.d/*.cfg; do [ -e \"$f\" ] && . \"$f\"; done; "
              "echo \"${GRUB_TIMEOUT_STYLE:-menu}|${GRUB_TIMEOUT:-5}|${GRUB_DISABLE_OS_PROBER:-true}\"")
    rc, out, err = _sh(["sh", "-c", script])
    if rc != 0 or out.count("|") != 2:
        return False, tr("unreadable configuration: {error}").format(error=err or out)
    style, wait, no_prober = out.split("|")
    problems = []
    if style == "hidden":
        problems.append(tr("menu hidden"))
    try:
        if int(wait) < 3:
            problems.append(tr("timeout of {n} s").format(n=wait))
    except ValueError:
        problems.append(tr("invalid timeout: {value}").format(value=wait))
    if no_prober != "false":
        problems.append(tr("os-prober off"))
    return not problems, ", ".join(problems) or tr(
        "menu shown for {n} s, other systems searched").format(n=wait)


@test("system")
def desktop_portals_respond():
    """File dialog, «Open With», theme and screen sharing go through the
    portals: if the portal dies, apps hang for up to 25 seconds."""
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS") and not os.path.exists(
            "/run/user/%d/bus" % os.getuid()):
        return True, tr("skipped (no session)")
    rc, out, err = _sh(["gdbus", "call", "--session", "--timeout", "8",
                        "--dest", "org.freedesktop.portal.Desktop",
                        "--object-path", "/org/freedesktop/portal/desktop",
                        "--method", "org.freedesktop.portal.Settings.ReadOne",
                        "org.freedesktop.appearance", "color-scheme"], timeout=12)
    masked = [u for u in ("xdg-document-portal", "xdg-permission-store")
                  if os.path.realpath("/etc/systemd/user/%s.service" % u) == "/dev/null"]
    if masked:
        return False, tr("disabled: {names}").format(names=", ".join(masked))
    return rc == 0, tr("the portal responds") if rc == 0 else (err or out)[:120]


@test("system")
def network_commands_findable():
    """ifconfig, route, ip, ping... must work for a regular user too."""
    missing = []
    for c in ("ifconfig", "route", "ip", "ss", "ping", "traceroute", "dig", "nslookup",
              "ethtool", "iw", "nmcli", "rfkill", "curl", "wget", "git", "python3",
              "tracepath", "nc", "host", "tcpdump", "nmap", "nft", "iptables", "ip6tables",
              "arp", "hostnamectl", "ssh", "scp", "sftp", "ssh-keygen", "rsync", "socat", "telnet", "autossh", "conntrack"):
        rc, _, _ = _sh(["bash", "-lc", "command -v %s" % c])
        if rc != 0:
            missing.append(c)
    return not missing, _missing(missing) if missing else tr("all present")


@test("ai")
def ai_local_only():
    """ZETA answers only with the local model: one provider (Ollama), no
    online AI client in the code, no address other than this computer even
    if a setting or OLLAMA_HOST names one, and no proxy for the model."""
    import glob
    from intelligence import ollama_manager as om
    from intelligence.providers.base import ProviderConfig
    from intelligence.providers.ollama import OllamaProvider, is_loopback
    from intelligence.registry import CATALOG, Registry
    wrong = []
    if set(CATALOG) != {"ollama"}:
        wrong.append("providers: %s" % ", ".join(sorted(CATALOG)))
    hosts = ("api.anthropic.com", "api.openai.com", "generativelanguage.googleapis.com",
             "api.mistral.ai", "api.x.ai", "api.deepseek.com", "openrouter.ai", "api.groq.com",
             "api.perplexity.ai", "dashscope")
    for f in glob.glob("/usr/lib/zeta/**/*.py", recursive=True):
        text = open(f, encoding="utf-8", errors="replace").read()
        found = [h for h in hosts if h in text]
        if found:
            wrong.append("%s: %s" % (os.path.basename(f), ", ".join(found)))
    for gone in ("claude", "gemini", "openai_compat"):
        if os.path.exists("/usr/lib/zeta/intelligence/providers/%s.py" % gone):
            wrong.append("%s.py still there" % gone)
    reg = Registry()
    reg.settings = {"default": "claude", "providers": {"ollama": {"endpoint": "http://203.0.113.9:11434"}}}
    p = reg.resolve_default()
    if p.config.name != "ollama" or p._base() != "http://127.0.0.1:11434":
        wrong.append("resolved to %s %s" % (p.config.name, p._base()))
    if OllamaProvider(ProviderConfig(name="ollama", label="Ollama",
                                     endpoint="http://localhost:11500"))._base() != "http://localhost:11500":
        wrong.append("local port refused")
    if not is_loopback(om.BASE):
        wrong.append("ollama_manager: %s" % om.BASE)
    cases = {"http://127.0.0.1:11434": True, "http://[::1]:1": True, "http://localhost": True,
             "http://10.1.2.3:11434": False, "https://127.0.0.1": False, "http://evil.example": False,
             "http://127.0.0.1.evil.example": False}
    bad = [u for u, want in cases.items() if is_loopback(u) != want]
    if bad:
        wrong.append("loopback: %s" % ", ".join(bad))
    from intelligence import models
    if not models.is_cloud("gpt-oss:120b-cloud") or models.is_cloud("qwen3:4b-instruct"):
        wrong.append("cloud model names")
    rc, env, _ = _sh(["systemctl", "show", "ollama", "-p", "Environment", "--value"])
    if rc == 0 and env.strip() and ("OLLAMA_NO_CLOUD=1" not in env
                                    or "OLLAMA_HOST=127.0.0.1:11434" not in env):
        wrong.append("ollama.service: cloud features or address")
    return not wrong, "; ".join(wrong) if wrong else tr("only the model on this computer")



#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS automated tests — they run INSIDE the ZETA RAYS system.

    zeta-selftest            run everything
    zeta-selftest intents    run a single group

Each test is a function returning (outcome, detail). It touches nothing:
it reads, queries and compares. Tests that modify the system put things back
the way they found them.

Tests never compare text shown to the user (it changes with the language):
only stable keys, exit codes and values. The phrases for the assistant are
given in Italian and in English (it understands both); they are language
data, in /usr/share/zeta/i18n-data/selftest.json.
"""
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr, ntr  # noqa: E402
from i18n_data import load  # noqa: E402

GREEN, RED, GRAY, COLOR_RESET = "\033[32m", "\033[31m", "\033[90m", "\033[0m"
groups = {}

# display name of each group (the key is the name used on the command line)
TITLES = {
    "intents": tr("Intents"),
    "resources": tr("Resources"),
    "windows": tr("Windows"),
    "settings": tr("Settings"),
    "system": tr("System"),
    "ai": tr("Artificial intelligence"),
    "terminal": tr("Terminal"),
    "agent": tr("Agent (ZETA Core)"),
}


def test(group):
    def dec(fn):
        groups.setdefault(group, []).append(fn)
        return fn
    return dec


def _sh(cmd, timeout=15):
    try:
        r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True,
                           text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 1, "", str(e)


def _missing(names):
    return tr("missing: {names}").format(names=", ".join(names))


def _cases_passed(n):
    return ntr("{n} correct case", "{n} correct cases", n).format(n=n)


def _phrases(test_name):
    """The phrases of a test, from selftest.json (keyed by test function name)."""
    return load("selftest")[test_name]


def _outside_session():
    return tr("skipped (outside the graphical session)")


# ---------------------------------------------------------------- intents
@test("intents")
def intents_recognized():
    """Common phrases must not end up at the language model."""
    from intelligence import intents
    data = _phrases("intents_recognized")
    expected_cases = data["it"] + data["en"]
    wrong = []
    for phrase, expected_value in expected_cases:
        i = intents.parse(phrase)
        got = i.action if i else None
        if got != expected_value:
            wrong.append(tr("{phrase} -> {got} (expected {expected})").format(
                phrase=repr(phrase), got=got, expected=expected_value))
    return not wrong, "; ".join(wrong) or ntr(
        "{n} phrase recognized", "{n} phrases recognized", len(expected_cases)).format(n=len(expected_cases))


@test("intents")
def intents_without_false_positives():
    """Ordinary phrases must NOT trigger a system command."""
    from intelligence import intents
    data = _phrases("intents_without_false_positives")
    harmless = data["it"] + data["en"]
    # What must not happen is that a harmless phrase RUNS something.
    # An intent with action None runs nothing: it is just a definite answer
    # (for example «how do i open a zip file» explains the double click). That
    # is an intended feature, not a false positive: only what acts is counted.
    hits = []
    answers = 0
    for phrase in harmless:
        i = intents.parse(phrase)
        if i is None:
            continue
        if i.action is None:
            answers += 1
        else:
            hits.append("%r -> %s" % (phrase, i.action))
    detail = "; ".join(hits) or tr(
        "{model} to the model, {direct} answered directly, 0 commands run").format(
        model=len(harmless) - answers, direct=answers)
    return not hits, detail


@test("intents")
def required_actions_available():
    """ZETA must be able to do the things the interface promises."""
    from intelligence.actions import ActionEngine
    e = ActionEngine()
    expected = ["open_application", "open_folder", "open_file", "open_url",
              "open_settings", "open_terminal", "open_system_monitor",
              "open_security", "find_files", "set_wallpaper", "set_theme",
              "set_accent", "cpu_usage", "memory_usage", "disk_usage",
              "network_status", "ip_address", "system_info", "list_windows",
              "lock_screen", "log_out", "suspend", "reboot", "power_off",
              "set_volume", "set_brightness", "create_folder", "trash_file",
              "empty_trash", "install_package", "remove_package", "wifi_toggle",
              "propose_command"]
    missing = [a for a in expected if a not in e.actions]
    return not missing, ", ".join(missing) or tr(
        "{n} required actions, {total} available").format(n=len(expected), total=len(e.actions))


@test("intents")
def zeta_does_not_run_free_commands():
    """No action runs arbitrary commands: the AI has no free access to the system."""
    from intelligence.actions import ActionEngine
    e = ActionEngine()
    forbidden = [n for n in e.actions if n in ("run_command", "run_shell", "execute", "shell")]
    if forbidden:
        return False, tr("forbidden actions present: {names}").format(names=", ".join(forbidden))
    return True, tr("no action runs free-form commands; propose_command only prepares one")


@test("intents")
def system_commands_recognized():
    """Computer-control phrases must reach the right action."""
    from intelligence import intents
    data = _phrases("system_commands_recognized")
    pairs = data["it"] + data["en"]
    wrong = []
    for phrase, expected_value in pairs:
        i = intents.parse(phrase)
        if (i.action if i else None) != expected_value:
            wrong.append("%r -> %s" % (phrase, i.action if i else None))
    return not wrong, "; ".join(wrong) or ntr(
        "{n} command recognized", "{n} commands recognized", len(pairs)).format(n=len(pairs))


@test("intents")
def immediate_answers():
    """Time, date and memory must answer without the model (under 0.5 s)."""
    from intelligence.assistant import Assistant
    a = Assistant()
    slow = []
    data = _phrases("immediate_answers")
    for phrase in data["it"] + data["en"]:
        t0 = time.perf_counter()
        r = a.respond(phrase)
        dt = time.perf_counter() - t0
        text = (r if isinstance(r, str) else getattr(r, "text", "") or "").strip()
        if dt > 0.5 or not text:
            slow.append("%r: %.2f s" % (phrase, dt))
    return not slow, "; ".join(slow) or tr("all immediate")


@test("intents")
def empty_input_does_not_block():
    """Empty or symbols-only text: a useful, immediate answer."""
    from intelligence.assistant import Assistant
    a = Assistant()
    problems = []
    for phrase in ("", "   ", "!!! ??? ..."):
        t0 = time.perf_counter()
        r = a.respond(phrase)
        dt = time.perf_counter() - t0
        text = (r if isinstance(r, str) else getattr(r, "text", "") or "").strip()
        if dt > 0.5 or not text:
            problems.append("%r: %.2f s" % (phrase, dt))
    return not problems, "; ".join(problems) or tr("handled without calling the model")


# ---------------------------------------------------------------- memory
@test("resources")
def proportional_preload():
    """The AI model must not be kept in RAM on small machines."""
    from intelligence import resources
    gb = resources.nominal_memory_gb()
    ka = resources.keep_alive()
    pre = resources.preload_allowed()
    # an 8 GB machine (the kernel sees ~7.7) must count as 8
    expected_preload = gb >= resources.PRELOAD_THRESHOLD
    ok = (pre == expected_preload) and ka in ("1m", "2m", "5m", "10m", "30m")
    return ok, tr("{gb} GB nominal -> preload={preload} keep_alive={keep}").format(
        gb="%.0f" % gb, preload=pre, keep=ka)


# ---------------------------------------------------------------- windows
@test("windows")
def workspaces():
    """Workspace switching with the Hyprland 0.55 syntax."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    def active():
        c, o, _ = _sh(["hyprctl", "-j", "activeworkspace"])
        return json.loads(o).get("id") if c == 0 else None
    start_workspace = active()
    outcomes = []
    for n in (2, 3, 1):
        _sh(["hyprctl", "dispatch", "hl.dsp.focus({ workspace = %d })" % n])
        time.sleep(0.4)
        outcomes.append(active() == n)
    if start_workspace:
        _sh(["hyprctl", "dispatch", "hl.dsp.focus({ workspace = %d })" % start_workspace])
    return all(outcomes), tr("3 of 3 workspaces") if all(outcomes) else tr("switching failed")


@test("windows")
def workspaces_bar_uses_right_syntax():
    """The bar module must use zeta-workspaces, not hyprland/workspaces."""
    path = os.path.expanduser("~/.config/waybar/config.jsonc")
    try:
        text = open(path).read()
    except OSError as e:
        return False, str(e)
    import re
    # without the comments: one of them explains precisely why the old module
    # is no longer used, and by naming it would make the test fail on its own.
    text = re.sub(r"^\s*//.*$", "", text, flags=re.M)
    if "hyprland/workspaces" in text:
        return False, tr("the bar still uses hyprland/workspaces: clicking does nothing")
    if "zeta-workspaces" not in text:
        return False, tr("zeta-workspaces modules missing")
    return True, tr("zeta-workspaces modules present")


# ---------------------------------------------------------------- settings
@test("settings")
def keys_valid_and_persistent():
    """Every key can be written and read back, and rejects absurd values."""
    c, out, _ = _sh(["zeta-appearance", "get"])
    if c != 0:
        return False, tr("zeta-appearance get does not respond")
    before = dict(r.split("=", 1) for r in out.splitlines() if "=" in r)
    problems = []
    # out-of-range value: it must be rejected and the value must not change
    c, _, _ = _sh(["zeta-appearance", "set", "font-size", "99"])
    if c == 0:
        problems.append(tr("font-size=99 accepted (out of range)"))
    c, _, _ = _sh(["zeta-appearance", "set", "nonexistent-key", "1"])
    if c == 0:
        problems.append(tr("nonexistent key accepted"))
    c, out2, _ = _sh(["zeta-appearance", "get"])
    after = dict(r.split("=", 1) for r in out2.splitlines() if "=" in r)
    if before != after:
        problems.append(tr("a value changed after a rejected attempt"))
    return not problems, "; ".join(problems) or ntr(
        "{n} key checked", "{n} keys checked", len(before)).format(n=len(before))


@test("settings")
def no_fake_menu_entries():
    """Every desktop «Customize» entry points to a real page."""
    try:
        text = open("/usr/local/bin/zeta-desktop").read()
    except OSError as e:
        return False, str(e)
    import re
    pages = set(re.findall(r'_settings\("([a-z-]+)(?::([a-z]+))?"\)', text))
    known = {"appearance", "dock", "lock-screen", "notifications", "network", "bluetooth",
             "audio", "ai", "info"}
    unknown = {p for p, _ in pages if p not in known}
    if unknown:
        return False, tr("unknown pages: {pages}").format(pages=", ".join(sorted(unknown)))
    return True, ntr("{n} valid destination", "{n} valid destinations",
                     len(pages)).format(n=len(pages))


# ---------------------------------------------------------------- system
@test("system")
def no_failed_units():
    """Neither the system nor the session may have failed units. A system
    service that only failed for hardware this computer does not have (the
    Monitor's "information" level, with log evidence) does not count."""
    from monitor import unitstate
    verdicts = {v["unit"]: v for v in unitstate.failed_verdicts(include_normal=True)}
    failed_units, notes = [], []
    for cmd in (["systemctl", "--failed", "--no-legend", "--no-pager", "--plain"],
                ["systemctl", "--user", "--failed", "--no-legend", "--no-pager", "--plain"]):
        _, out, _ = _sh(cmd)
        for line in out.splitlines():
            unit = line.split()[0] if line.split() else line
            # ydotool is a testing tool, not part of ZETA RAYS
            if not line.strip() or "ydotool" in line:
                continue
            v = verdicts.get(unit) if "--user" not in cmd else None
            if v and v["level"] in (unitstate.INFO, unitstate.NORMAL):
                notes.append("%s (%s)" % (unit, v["kind"]))
            else:
                failed_units.append(unit)
    detail = ", ".join(failed_units) or tr("no failed units")
    if notes:
        detail += "; " + ", ".join(notes)
    return not failed_units, detail


@test("system")
def boot_menu_visible():
    """At power-on the GRUB menu must appear, with the other systems."""
    # Same reading order as grub-mkconfig: /etc/default/grub, then grub.d/*.cfg
    # in alphabetical order, the last one wins. A file hiding the menu, placed
    # after the right one, had removed the OS choice in dual boot.
    script = (". /etc/default/grub 2>/dev/null; "
              "for f in /etc/default/grub.d/*.cfg; do [ -e \"$f\" ] && . \"$f\"; done; "
              "echo \"${GRUB_TIMEOUT_STYLE:-menu}|${GRUB_TIMEOUT:-5}|${GRUB_DISABLE_OS_PROBER:-true}\"")
    rc, out, err = _sh(["sh", "-c", script])
    if rc != 0 or out.count("|") != 2:
        return False, tr("unreadable configuration: {error}").format(error=err or out)
    style, wait, no_prober = out.split("|")
    problems = []
    if style == "hidden":
        problems.append(tr("menu hidden"))
    try:
        if int(wait) < 3:
            problems.append(tr("timeout of {n} s").format(n=wait))
    except ValueError:
        problems.append(tr("invalid timeout: {value}").format(value=wait))
    if no_prober != "false":
        problems.append(tr("os-prober off"))
    return not problems, ", ".join(problems) or tr(
        "menu shown for {n} s, other systems searched").format(n=wait)


@test("system")
def desktop_portals_respond():
    """File dialog, «Open With», theme and screen sharing go through the
    portals: if the portal dies, apps hang for up to 25 seconds."""
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS") and not os.path.exists(
            "/run/user/%d/bus" % os.getuid()):
        return True, tr("skipped (no session)")
    rc, out, err = _sh(["gdbus", "call", "--session", "--timeout", "8",
                        "--dest", "org.freedesktop.portal.Desktop",
                        "--object-path", "/org/freedesktop/portal/desktop",
                        "--method", "org.freedesktop.portal.Settings.ReadOne",
                        "org.freedesktop.appearance", "color-scheme"], timeout=12)
    masked = [u for u in ("xdg-document-portal", "xdg-permission-store")
                  if os.path.realpath("/etc/systemd/user/%s.service" % u) == "/dev/null"]
    if masked:
        return False, tr("disabled: {names}").format(names=", ".join(masked))
    return rc == 0, tr("the portal responds") if rc == 0 else (err or out)[:120]


@test("system")
def network_commands_findable():
    """ifconfig, route, ip, ping... must work for a regular user too."""
    missing = []
    for c in ("ifconfig", "route", "ip", "ss", "ping", "traceroute", "dig", "nslookup",
              "ethtool", "iw", "nmcli", "rfkill", "curl", "wget", "git", "python3",
              "tracepath", "nc", "host", "tcpdump", "nmap", "nft", "iptables", "ip6tables",
              "arp", "hostnamectl", "ssh", "scp", "sftp", "ssh-keygen", "rsync", "socat", "telnet", "autossh", "conntrack"):
        rc, _, _ = _sh(["bash", "-lc", "command -v %s" % c])
        if rc != 0:
            missing.append(c)
    return not missing, _missing(missing) if missing else tr("all present")


@test("ai")
def ai_providers_fast_and_robust():
    """Fast models by default, fallback to a model the service really offers,
    Gemini key never in the URL, real errors shown."""
    from intelligence.registry import Registry
    from intelligence.providers.base import choose_model
    from intelligence import assistant
    prob = []
    g = Registry().get("gemini"); g.config.api_key = "TEST-KEY"
    if "TEST-KEY" in g._url("generateContent") or "TEST-KEY" not in str(g._headers()):
        prob.append(tr("Gemini key in the URL"))
    if choose_model("claude", ["claude-opus-5-5", "claude-haiku-4-5"]) != "claude-haiku-4-5":
        prob.append(tr("Claude fallback"))
    if choose_model("openai", ["text-embedding-3-large", "gpt-5-mini"]) != "gpt-5-mini":
        prob.append(tr("OpenAI fallback"))
    src = open(assistant.__file__).read()
    if "_fall_back_to_other_model" not in src or "_with_offer" not in src:
        prob.append(tr("assistant fallbacks missing"))
    return not prob, "; ".join(prob) if prob else tr(
        "fast defaults, fallbacks ready, keys only in the headers")



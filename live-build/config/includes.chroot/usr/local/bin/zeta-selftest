# ------------------------------------------------ ZETA RAYS 2.1: AI honesty and robustness
# All offline: no request leaves the computer (the slow servers are local sockets).
@test("ai")
def ai_prompt_has_today():
    """Every request, to every provider, carries today's date and the rule on
    facts that change over time; a custom prompt cannot remove them."""
    from datetime import date
    from intelligence import context
    from intelligence.registry import DEFAULT_SYSTEM, Registry
    from intelligence.providers.base import Message
    today = date.today().isoformat()
    prompt = context.system_prompt(DEFAULT_SYSTEM)
    custom = context.system_prompt("You are a pirate.", web="off")
    wrong = []
    if today not in prompt or "training" not in prompt:
        wrong.append("default prompt")
    if today not in custom or "cannot verify" not in custom:
        wrong.append("custom prompt")
    msgs = [Message("user", "hi")]
    reg = Registry()
    for pid in ("claude", "gemini", "openai", "deepseek", "ollama"):
        p = reg.get(pid)
        p.config.system = prompt
        if pid == "claude":
            payload = p._payload(msgs, None, False)
        elif pid == "gemini":
            payload = p._contents(msgs)
        elif pid == "ollama":
            payload = p._messages(msgs)
        else:
            payload = p._base(msgs)
        if today not in json.dumps(payload):
            wrong.append(pid)
    return not wrong, _missing(wrong) if wrong else tr("today ({date}) in every request").format(date=today)


@test("ai")
def ai_history_budget():
    """History sent to the model: latest turns within the token budget,
    starting with a question, never dropping the new question."""
    from intelligence.memory import HISTORY_BUDGET, HISTORY_TURNS, approx_tokens, trim_history
    from intelligence.providers.base import Message
    msgs = []
    for i in range(30):
        msgs.append(Message("user", "question %d " % i + "x" * 300))
        msgs.append(Message("assistant", "answer %d " % i + "y" * 600))
    msgs.append(Message("user", "the new question"))
    wrong = []
    for kind in ("local", "cloud"):
        kept = trim_history(msgs, HISTORY_TURNS[kind], HISTORY_BUDGET[kind])
        cost = sum(approx_tokens(m.content) for m in kept)
        users = sum(1 for m in kept if m.role == "user")
        if (not kept or kept[-1] is not msgs[-1] or kept[0].role != "user"
                or cost > HISTORY_BUDGET[kind] or users > HISTORY_TURNS[kind]):
            wrong.append(kind)
    huge = [Message("user", "z" * 40000)]
    if trim_history(huge, 6, 1500) != huge:
        wrong.append("long question")
    return not wrong, _missing(wrong) if wrong else tr("within {local} tokens (local), {cloud} (online)").format(
        local=HISTORY_BUDGET["local"], cloud=HISTORY_BUDGET["cloud"])



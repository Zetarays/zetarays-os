def capture_command_help():
    """zeta-screenshot answers --help and lists the commands the Control
    Center and the shortcuts use."""
    rc, out, _ = _sh(["zeta-screenshot", "--help"])
    missing = [c for c in ("panel", "region", "window", "screen", "record", "record-stop",
                           "status") if c not in out.split()]
    if rc != 0:
        return False, "rc=%d" % rc
    rc2, _, _ = _sh(["zeta-screenshot", "region", "--no-such-option"])

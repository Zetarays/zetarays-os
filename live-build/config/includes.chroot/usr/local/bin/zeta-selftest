@test("system")
def safe_downloads():
    """What is dragged from the browser: no sneaky paths, no file:// ."""
    import tempfile
    from system import download
    if download.safe_name("../../etc/passwd") != "passwd" or download.safe_name(".bashrc") != "bashrc":
        return False, tr("names not cleaned up")
    d = tempfile.mkdtemp()
    try:
        if download.from_url("file:///etc/passwd", d)[0] or download.from_url("javascript:x", d)[0]:
            return False, tr("non-http address accepted")
        ok, _m, path = download.from_url("data:text/plain;base64,aGVsbG8=", d)
        if not ok or open(path).read() != "hello":
            return False, tr("embedded data not saved")
        ok, _m, p2 = download.data(d, "photo", b"\x89PNGdata", "image/png")
        if not ok or os.path.basename(p2) != "photo.png":
            return False, tr("image delivered by the browser not saved")
        if download.name_from_url("https://x.it/a/red%20sunset.jpg?w=2") != "red sunset.jpg":
            return False, tr("wrong file name taken from the address")
        if any(n.endswith(".partial") for n in os.listdir(d)):
            return False, tr("partial files left behind")
    finally:
        import shutil
        shutil.rmtree(d, ignore_errors=True)
    return True, tr("names cleaned up, only http/https/data, no partial files")


@test("system")
def zeta_rays_wallpapers():
    """The 8 official wallpapers with thumbnails, found by name, really applied
    to the desktop (the lock screen stays black); then the previous wallpaper is restored."""
    from system import wallpapers
    from intelligence.agent.understanding import understanding
    entries = wallpapers.listing()
    if len(entries) != len(wallpapers.CATALOG):
        return False, tr("missing wallpapers: {n} of {total}").format(n=len(entries), total=len(wallpapers.CATALOG))
    without = [n for p, n, m in entries if m == p]
    if without:
        return False, tr("no thumbnail: {names}").format(names=", ".join(without))
    # Italian and English names: both are found, whatever the language
    # i18n-data-begin: Italian wallpaper names
    test_cases = {"onde rosse": "zeta-red-waves.jpg", "circuiti": "zeta-green-circuits.jpg",
            "Terminale": "zeta-terminal.jpg", "logo bianco": "zeta-white.jpg", "blu": None,
            "red waves": "zeta-red-waves.jpg", "circuits": "zeta-green-circuits.jpg",
            "Terminal": "zeta-terminal.jpg", "white logo": "zeta-white.jpg", "blue": None}
    # i18n-data-end
    for t, f in test_cases.items():
        found = wallpapers.search(t)
        if (os.path.basename(found) if found else None) != f:
            return False, tr("“{text}” -> {found}").format(text=t, found=found)
    for phrase in ("metti lo sfondo onde rosse", "set the wallpaper to red waves"):  # i18n-data
        r = understanding(phrase)
        if not r or r[0][0] != "set_wallpaper" or wallpapers.search(r[0][1].get("image", "")) is None:
            return False, tr("phrase not understood: {result}").format(result="%s -> %r" % (phrase, r))
    conf = os.path.expanduser("~/.config/zeta/wallpaper.json")
    try:
        before = open(conf).read()
    except OSError:
        before = None
    chosen = wallpapers.search("onde blu")  # i18n-data
    try:
        rc, out, err = _sh(["zeta-wallpaper", "set", chosen])
        current = _sh(["zeta-wallpaper", "get"])[1].split("\n")[0]
        if rc != 0 or current != chosen:
            return False, tr("zeta-wallpaper set not applied ({detail})").format(detail=err or current)
        if os.path.lexists(os.path.expanduser("~/.config/zeta/lock-wallpaper")):
            return False, tr("the lock screen still follows the wallpaper")
    finally:
        if before is None:
            try:
                os.remove(conf)
            except OSError:
                pass
        else:
            with open(conf, "w") as f:
                f.write(before)
        _sh(["zeta-wallpaper", "apply"])
    return True, ntr("{n} wallpaper, search by name, applied to the desktop",
                     "{n} wallpapers, search by name, applied to the desktop",
                     len(entries)).format(n=len(entries))


@test("system")
def wifi_correct_password_not_mistaken_for_wrong():
    """Real nmcli --ask output (NetworkManager 1.52, October 1): the password
    line shows up again even after success and on timeout; the real rejection
    is the repeated prompt. Previously a successful connection became «wrong
    password» and the correct profile was deleted."""
    from system import network as N
    rich = "Passwords or encryption keys are required to access the wireless network 'X'.\n"
    line = "Password (802-11-wireless-security.psk): "
    test_cases = [(rich + line + "\n<psk): ****\n\x1b[2K\nDevice 'wlan0' successfully activated with 'u'.\n\n" + line,
             "success"),
            (rich + line + "\n\n" + rich + rich, "rejected"),
            (rich + line + "\n\n" + line + " Error: Timeout 40 sec expired.", None)]
    incorrect_ones = [expected_value for text, expected_value in test_cases if N._read_output(text) != expected_value]
    return not incorrect_ones, (tr("misread: {cases}").format(cases=incorrect_ones)) if incorrect_ones else tr(
        "success, rejection and timeout told apart")


@test("system")
def radio_region_from_timezone():
    """Wi-Fi country derived from the time zone (Europe/Rome -> IT); the udev rule exists."""
    rc, out, _e = _sh(["awk", "-v", "z=Europe/Rome", "$3 == z {print $1}", "/usr/share/zoneinfo/zone.tab"])
    rule = os.path.isfile("/etc/udev/rules.d/60-zeta-radio-region.rules")
    ok = out.strip() == "IT" and rule and os.access("/usr/local/libexec/zeta-radio-region", os.X_OK)
    if rule:
        detail = tr("Europe/Rome -> {country}, udev rule present")
    else:
        detail = tr("Europe/Rome -> {country}, udev rule MISSING")
    return ok, detail.format(country=out.strip() or "?")


@test("system")
def single_firewall_and_single_network():
    """One manager per job: nftables (inet zeta table) for the firewall, iptables
    on the nftables backend, no firewalld, ufw installed but off (or, if on,
    with the SSH and ZETA Share rules); NetworkManager for network and DNS."""
    prob = []
    rc, out, _e = _sh(["bash", "-lc", "iptables -V"])
    if rc != 0 or "nf_tables" not in out:
        prob.append(tr("iptables does not use nftables ({version})").format(version=out.strip()))
    if _sh(["bash", "-lc", "command -v firewalld"])[0] == 0:
        prob.append(tr("firewalld installed"))
    ufw = tr("ufw not installed")
    try:
        enabled = "ENABLED=yes" in open("/etc/ufw/ufw.conf").read()
        ufw = tr("ufw on") if enabled else tr("ufw installed and off")
        if os.access("/etc/ufw/user.rules", os.R_OK):
            rules = open("/etc/ufw/user.rules").read()
            if "--dport 53317" not in rules:
                prob.append(tr("ufw without the ZETA Share rules"))
            if enabled and os.path.exists("/etc/nftables.d/zeta-ssh.nft") and "--dport 22 " not in rules:
                prob.append(tr("ufw on without the SSH rule"))
    except OSError:
        pass
    if _sh(["systemctl", "is-active", "--quiet", "NetworkManager"])[0] != 0:
        prob.append(tr("NetworkManager not active"))
    for other in ("systemd-networkd", "systemd-resolved"):
        if _sh(["systemctl", "is-active", "--quiet", other])[0] == 0:
            prob.append(tr("{name} active alongside NetworkManager").format(name=other))
    try:
        lines = [l.split("#")[0].strip() for l in open("/etc/network/interfaces")]
        extra = [l for l in lines if l.startswith(("auto ", "iface ")) and " lo" not in l]
        if extra:
            prob.append(tr("ifupdown manages interfaces: {names}").format(names=", ".join(extra)))
    except OSError:
        pass
    if _sh(["systemctl", "is-enabled", "--quiet", "nftables"])[0] != 0:
        prob.append(tr("nftables not enabled at boot"))
    return not prob, "; ".join(prob) if prob else tr(
        "nftables firewall (inet zeta), iptables-nft, {ufw}, network and DNS from NetworkManager").format(ufw=ufw)


@test("system")
def remote_ssh_access_consistent():
    """SSH and netcat are there; the server is off until turned on, and when it
    is on, port 22 is open to the local network only; root cannot log in."""
    missing = [c for c in ("ssh", "scp", "sftp", "ssh-keygen", "ssh-copy-id", "nc", "sshfs")
                if _sh(["bash", "-lc", "command -v %s" % c])[0] != 0]
    if not os.path.exists("/usr/sbin/sshd"):
        missing.append("sshd")
    if missing:
        return False, _missing(missing)
    try:
        conf = open("/etc/ssh/sshd_config.d/zeta.conf").read()
        fw = open("/etc/nftables.conf").read()
    except OSError as e:
        return False, str(e)
    if ("PermitRootLogin no" not in conf or "@lan_access" not in fw or "@remote_access" not in fw
            or 'include "/etc/nftables.d/*.nft"' not in fw):
        return False, tr("sshd or firewall configuration incomplete")
    if "ct state established,related accept" not in fw or "ct state invalid drop" not in fw:
        return False, tr("the firewall does not track connections (conntrack)")
    # «zeta-ssh config» prints fixed keys (SSH_REMOTE_ACCESS=...); for «zeta-ssh
    # status» only the exit code matters: 0 on, 1 off, 2 halfway.
    remote = "SSH_REMOTE_ACCESS=true" in _sh(["zeta-ssh", "config"])[1]
    rc, out, _e = _sh(["zeta-ssh", "status"])
    listening = bool(_sh(["ss", "-Htln", "sport = :22"])[1])
    if rc == 1 and listening:
        return False, tr("zeta-ssh says off but port 22 is listening")
    if rc == 0 and not listening:
        return False, tr("zeta-ssh says on but nothing listens on port 22")
    if rc not in (0, 1):
        return False, out[:120]
    if rc != 0:
        return True, tr("client, server, netcat and sshfs present; SSH off")
    if remote:
        return True, tr("client, server, netcat and sshfs present; SSH on (also from the internet)")
    return True, tr("client, server, netcat and sshfs present; SSH on (local network only)")



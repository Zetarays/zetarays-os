@test("ai")
def natural_voice_speaks():
    """ZETA's voice: Piper must really turn a sentence into audio, in Italian
    and in English (the other languages use espeak-ng)."""
    import tempfile
    from intelligence import speech
    done = []
    for language, phrase in (("it", "Ciao, sono ZETA."), ("en", "Hello, I am ZETA.")):  # i18n-data
        entry = speech._natural_voice(language)
        if entry is None:
            return False, tr("no natural voice for {language}").format(language=language)
        with tempfile.NamedTemporaryFile(suffix=".wav") as wav:
            r = subprocess.run([speech.PIPER, "--model", entry[0], "--output_file", wav.name],
                               input=phrase, capture_output=True, text=True, timeout=60)
            if r.returncode != 0 or os.path.getsize(wav.name) < 10000:
                return False, tr("{language}: no audio").format(language=language)
        done.append(language)
    return True, tr("Piper speaks: {languages}").format(languages=", ".join(done))



@test("ai")
def ai_web_lookup_on_by_default():
    """Questions about current facts are looked up on the web by default
    (only the shortened question goes out); a user who turned it off, or once
    answered "No", stays offline, and then no old name is presented as
    current (the model is told not to give one)."""
    from intelligence import context, websearch
    from intelligence.assistant import Assistant
    from intelligence.providers.base import Provider, ProviderConfig
    wrong = []
    if not websearch.enabled({}) or websearch.mode({}) != "on":
        wrong.append("default")
    if websearch.mode({websearch.SETTING_DECLINED: True}) != "off":
        wrong.append("declined")
    if websearch.mode({websearch.SETTING_ENABLED: False}) != "off":
        wrong.append("turned off")
    calls = []
    real = websearch.lookup
    websearch.lookup = lambda *a, **k: calls.append(k) or ([], True)
    try:
        a = Assistant(Provider(ProviderConfig(name="test", label="Test", kind="local")))
        question = _phrases("ai_web_lookup_on_by_default")["question"]
        state, _src, _ref = a._web_context(question, {}, None)
        # no source found: "failed", or "reference" when the verified local
        # reference covers the question
        if state not in ("failed", "reference") or len(calls) != 1 or not calls[0].get("compact"):
            wrong.append("lookup by default")
        calls.clear()
        state, _src, _ref = a._web_context(question, {websearch.SETTING_ENABLED: False}, None)
        if state not in ("off", "reference") or calls:
            wrong.append("off respected")
    finally:
        websearch.lookup = real
    if "Do not name who currently holds an office" not in context.turn_note(web="off"):
        wrong.append("no stale names")
    return not wrong, _missing(wrong) if wrong else tr("on by default, off when the user chooses")


@test("ai")
def ai_sources_formatting():
    """Sources go into the prompt with number, title, address and date, and
    the excerpt keeps the sentence about the present."""
    from intelligence import context, websearch
    data = _phrases("ai_sources_formatting")
    src = [websearch.Source(data["title"], data["url"], data["text"], "2026-10-17", "it.wikipedia.org")]
    block = context.format_sources(src)
    prompt = context.turn_note(web="sources", sources=src)

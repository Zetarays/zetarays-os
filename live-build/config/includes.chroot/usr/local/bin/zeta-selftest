def ai_providers_registered():
    """Online services, OpenAI-compatible and local, all in the registry."""
    from intelligence.registry import CATALOG
    expected_cases = {"claude", "gemini", "openai", "deepseek", "perplexity", "mistral", "groq",
              "xai", "openrouter", "custom", "ollama"}

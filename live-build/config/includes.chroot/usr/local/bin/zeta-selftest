@test("capture")
def capture_status_json():
    """`zeta-screenshot status` prints JSON with "recording" and "file"."""
    rc, out, _ = _sh(["zeta-screenshot", "status"])
    try:
        st = json.loads(out)
    except ValueError:
        return False, "not JSON: %r" % out[:80]
    ok = rc == 0 and isinstance(st.get("recording"), bool) and "file" in st
    if ok and st["recording"] and not st.get("file"):
        ok = False
    return ok, "recording=%s" % st.get("recording")


@test("capture")
def capture_file_names_and_folders():
    """File names (no overwriting within the same second), folders, options
    file: checked in a temporary folder, nothing of the user is touched."""
    import tempfile
    from system import capture
    with tempfile.TemporaryDirectory() as d:
        when = time.mktime((2026, 1, 2, 3, 4, 5, 0, 0, -1))
        folder = capture.ensure_folder(os.path.join(d, "Pictures", "Screenshots"))
        a = capture.unique_path(folder, capture.SCREENSHOT_STEM, ".png", when)
        b = capture.unique_path(folder, capture.SCREENSHOT_STEM, ".png", when)
        v = capture.unique_path(d, capture.RECORDING_STEM, ".mp4", when)
        expected = ["Screenshot 2026-01-02 03-04-05.png", "Screenshot 2026-01-02 03-04-05 (2).png",
                    "Screen recording 2026-01-02 03-04-05.mp4"]
        got = [os.path.basename(p) for p in (a, b, v)]
        if got != expected:
            return False, "; ".join(got)
    if not capture.screenshots_dir().endswith("/Screenshots"):
        return False, capture.screenshots_dir()
    if not capture.recordings_dir().endswith("/Screen recordings"):
        return False, capture.recordings_dir()
    s = capture.load_settings()
    if set(s) != set(capture.DEFAULTS) or s["delay"] not in capture.DELAYS:
        return False, "options: %s" % s
    return True, "%s, %s" % (capture.screenshots_dir(), capture.recordings_dir())


@test("capture")
def capture_recorder_and_indicator_logic():
    """The wf-recorder command line (screen, area, sound) and the corner of
    the recording indicator, which must stay outside the recorded area."""
    from system import capture
    cmd = capture.recorder_command("/tmp/x.mp4", "10,20 300x200", None, True)
    if cmd[:4] != ["wf-recorder", "-y", "-f", "/tmp/x.mp4"] or "-g" not in cmd \
            or "--audio=@DEFAULT_MONITOR@" not in cmd:
        return False, " ".join(cmd)
    if "-o" not in capture.recorder_command("/tmp/x.mp4", None, "DP-1", False):
        return False, "screen recording without -o"
    mons = [{"name": "A", "x": 0, "y": 0, "w": 1920, "h": 1080, "focused": True, "workspaces": {1}},
            {"name": "B", "x": 1920, "y": 0, "w": 1920, "h": 1080, "focused": False, "workspaces": {2}}]
    cases = [(((10, 20, 300, 200), None, mons), ("A", "top-right")),
             (((1500, 0, 420, 200), None, mons), ("A", "top-left")),
             (((0, 0, 1920, 1080), None, mons), ("B", "top-right")),
             ((None, "A", mons), ("B", "top-right")),
             ((None, "A", mons[:1]), ("A", "top-right"))]
    for args, expected in cases:
        got = capture.pill_corner(*args)
        if got != expected:
            return False, "%s -> %s (expected %s)" % (args[:2], got, expected)
    return True, _cases_passed(len(cases) + 2)



@test("ai")
def ai_web_lookup_off_by_default():
    """Without the user's choice nothing is looked up on the web: a
    time-sensitive question asks first, and with no answer stays offline."""
    from intelligence import websearch
    from intelligence.assistant import Assistant
    from intelligence.providers.base import Provider, ProviderConfig
    wrong = []
    if websearch.enabled({}) or websearch.mode({}) != "ask":
        wrong.append("default")
    if websearch.mode({websearch.SETTING_DECLINED: True}) != "off":
        wrong.append("declined")
    calls = []
    real = websearch.lookup
    websearch.lookup = lambda *a, **k: calls.append(a) or ([], True)
    try:
        a = Assistant(Provider(ProviderConfig(name="test", label="Test", kind="local")))
        state, _src = a._web_context(_phrases("ai_web_lookup_off_by_default")["question"], {}, None,
                                     a.provider)
        if state != "off" or calls:
            wrong.append("no consent")
        asked = []
        state, _src = a._web_context("who is the current pope?", {},
                                     lambda services: asked.append(services) or "no", a.provider)
        if not asked or calls or state != "off":
            wrong.append("consent no")
    finally:
        websearch.lookup = real
    return not wrong, _missing(wrong) if wrong else tr("off until the user says yes")


@test("ai")
def ai_sources_formatting():
    """Sources go into the prompt with number, title, address and date, and
    the excerpt keeps the sentence about the present."""
    from intelligence import context, websearch
    data = _phrases("ai_sources_formatting")
    src = [websearch.Source(data["title"], data["url"], data["text"], "2026-10-17", "it.wikipedia.org")]
    block = context.format_sources(src)
    prompt = context.system_prompt("base", web="sources", sources=src)
    article = data["article"]
    excerpt = websearch.best_excerpt(article, data["query"])
    wrong = []
    if not block.startswith("Sources") or "[1] " not in block or "2026-10-17" not in block or src[0].url not in block:
        wrong.append("block")
    if block not in prompt:
        wrong.append("prompt")
    if data["person"] not in excerpt or len(excerpt) > websearch.SNIPPET_CHARS:
        wrong.append("excerpt")
    if websearch.make_query(data["question"]) != data["query"]:
        wrong.append("query")
    return not wrong, _missing(wrong) if wrong else tr("title, address, date and excerpt")


def _slow_server(mode):
    """A local HTTP server that is slow on purpose (timeouts and Stop).
    mode "silent": never answers; "drip": streams one line every 0.3 s."""
    import socket
    import threading
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(("127.0.0.1", 0))
    srv.listen(8)
    state = {"closed": 0}

    def client(conn):
        try:
            conn.settimeout(20)
            data = b""
            while b"\r\n\r\n" not in data:
                chunk = conn.recv(4096)
                if not chunk:
                    return
                data += chunk
            if b"/api/ps" in data or b"/api/tags" in data:
                body = b'{"models": [{"name": "test:1b"}]}'
                conn.sendall(b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: %d\r\n"
                             b"Connection: close\r\n\r\n%s" % (len(body), body))
                return
            if mode == "silent":
                while conn.recv(4096):
                    pass
                state["closed"] += 1
                return
            conn.sendall(b"HTTP/1.1 200 OK\r\nContent-Type: application/x-ndjson\r\nConnection: close\r\n\r\n")
            for _ in range(200):
                conn.sendall(b'{"message": {"content": "word "}, "done": false}\n')
                time.sleep(0.3)
        except OSError:
            state["closed"] += 1
        finally:
            conn.close()

    def accept():
        while True:
            try:
                conn, _ = srv.accept()
            except OSError:
                return
            threading.Thread(target=client, args=(conn,), daemon=True).start()
    threading.Thread(target=accept, daemon=True).start()
    return srv, "http://127.0.0.1:%d" % srv.getsockname()[1], state


@test("ai")
def ai_timeout_and_cancel():
    """A model that never answers ends with a timeout; Stop really closes a
    reply that is still streaming; the total limit stops an endless reply;
    after all this the next request works (local sockets only)."""
    import threading
    from intelligence.providers.base import CancelToken, Canceled, Message, ProviderConfig, ProviderError
    from intelligence.providers.ollama import OllamaProvider
    wrong = []
    msgs = [Message("user", "hi")]

    def provider(url, **kw):
        p = OllamaProvider(ProviderConfig(name="ollama", label="Ollama", kind="local", model="test:1b",
                                          endpoint=url, **kw))
        p.cancel_token = CancelToken()
        return p

    # 1) silent server: first-token timeout (shortened to 1 s for the test)
    srv, url, _state = _slow_server("silent")
    p = provider(url)
    p.timeout = 1.0
    t0 = time.monotonic()
    try:
        p.stream(msgs, lambda c: None)
        wrong.append("no timeout")
    except ProviderError as e:
        if e.kind != "timeout" or time.monotonic() - t0 > 4:
            wrong.append("timeout: %s %.1fs" % (e.kind, time.monotonic() - t0))
    srv.close()

    # 2) streaming server: Stop after the first words
    srv, url, state = _slow_server("drip")
    p = provider(url)
    got, out = [], {}

    def run():
        try:
            p.stream(msgs, got.append)
            out["end"] = "finished"
        except Canceled:
            out["end"] = "canceled"
        except ProviderError as e:
            out["end"] = e.kind
    th = threading.Thread(target=run, daemon=True)
    th.start()
    for _ in range(50):
        if got:
            break
        time.sleep(0.1)
    t0 = time.monotonic()
    p.cancel()
    th.join(3)
    if th.is_alive() or out.get("end") != "canceled" or time.monotonic() - t0 > 2:
        wrong.append("stop: %s" % out.get("end", "still running"))

    # 3) total limit: an endless reply is cut at config.timeout
    p = provider(url, timeout=1.5)
    t0 = time.monotonic()
    try:
        p.stream(msgs, lambda c: None)
        wrong.append("no limit")
    except ProviderError as e:
        if e.kind != "timeout" or time.monotonic() - t0 > 4:
            wrong.append("limit: %s" % e.kind)

    # 4) the next request on a fresh token works
    p = provider(url)
    first = []
    def run_next():
        try:
            p.stream(msgs, first.append)
        except ProviderError:
            pass
    th = threading.Thread(target=run_next, daemon=True)
    th.start()
    for _ in range(30):
        if first:
            break
        time.sleep(0.1)
    p.cancel()
    th.join(3)
    if not first:
        wrong.append("next request")
    srv.close()
    return not wrong, "; ".join(wrong) if wrong else tr("timeout, Stop and time limit work")


@test("ai")
def ai_no_silent_cloud_fallback():
    """No question goes to an online service the user did not choose: with
    keys saved and the local model down, «Automatic» stays local; a failing
    local model only OFFERS an online service (offline: nothing is sent)."""
    from intelligence import assistant as A, registry as R
    from intelligence.providers.base import Provider, ProviderConfig, ProviderError
    from intelligence.providers.claude import ClaudeProvider
    from intelligence.providers.gemini import GeminiProvider
    from intelligence.providers.openai_compat import OpenAICompatProvider
    sent = []

    def spy(self, *a, **k):
        sent.append(self.config.name)
        raise ProviderError("blocked by the test", kind="network")
    patched = [(c, m, getattr(c, m)) for c in (ClaudeProvider, GeminiProvider, OpenAICompatProvider)
               for m in ("chat", "stream")]
    real_key = R._keyring_get
    wrong = []
    try:
        for c, m, _f in patched:
            setattr(c, m, spy)
        R._keyring_get = lambda name: "test-key-not-real"        # every service "has a key"
        reg = R.Registry()
        reg.settings = {"providers": {"ollama": {"endpoint": "http://127.0.0.1:9"}}}  # local model down
        if reg.resolve_default().config.kind != "local":
            wrong.append("automatic chose an online service")
        if not reg.cloud_offer():
            wrong.append("no offer")

        class DownLocal(Provider):
            uses_tools = False

            def available(self):
                return True

            def stream(self, messages, on_text):
                raise ProviderError("local model down", kind="network")
        a = A.Assistant(DownLocal(ProviderConfig(name="ollama", label="Ollama", kind="local")))
        a.registry = reg
        a.memory.enabled = False
        a.history = []
        a.respond("tell me a story about a lighthouse", on_text=lambda c: None)
        if sent:
            wrong.append("sent to %s" % ", ".join(sent))
        if not a.last_turn.get("offer") or a.last_turn["offer"] == "ollama":
            wrong.append("online service not offered")
        # accepting the offer is an explicit choice: only then is it used
        a.respond_with(a.last_turn["offer"] or "claude", "tell me a story", on_text=lambda c: None)
        if len(sent) != 1:
            wrong.append("accepted offer not used")
    finally:
        for c, m, f in patched:
            setattr(c, m, f)
        R._keyring_get = real_key
    return not wrong, "; ".join(wrong) if wrong else tr("online services only when chosen")


@test("ai")
def ai_ram_decisions():
    """Local model and RAM, with synthetic /proc/meminfo values: never loaded
    at login below 16 GB, released soon on small machines, never loaded when
    it would push the computer into swap (4, 8 and 16 GB computers)."""
    import tempfile
    from intelligence import resources as R
    cases = [  # (MemTotal kB, MemAvailable kB, model GB, preload, keep_alive, can load, advice)
        (3_900_000, 2_600_000, 0.0, False, "2m", False, True),     # 4 GB
        (8_000_000, 5_800_000, 0.0, False, "5m", True, False),     # 8 GB, normal use
        (8_000_000, 3_100_000, 0.0, False, "5m", False, False),    # 8 GB, busy: say so
        (3_900_000, 3_000_000, 2.0, False, "2m", True, False),     # 4 GB, small model
        (16_100_000, 12_000_000, 0.0, True, "30m", True, False),   # 16 GB
        (16_100_000, 400_000, 0.0, True, "1m", False, False),      # 16 GB, memory short now
    ]
    old = R.MEMINFO
    wrong = []
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".meminfo", delete=False) as f:
            path = f.name
        R.MEMINFO = path
        for total, avail, model, preload, keep, can, advice in cases:
            with open(path, "w") as f:
                f.write("MemTotal: %d kB\nMemFree: 100000 kB\nMemAvailable: %d kB\n" % (total, avail))
            p = R.plan(model)
            got = (p["preload_at_login"], p["keep_alive"], p["can_load"], bool(p["advice"]))
            if got != (preload, keep, can, advice):
                wrong.append("%.0f GB/%.1f free: %s" % (p["nominal_gb"], p["available_gb"], got))
            if not can and R.SMALLER_MODEL not in R.memory_reason(model) and model == 0.0:
                wrong.append("no smaller model suggested")
    finally:
        R.MEMINFO = old
        try:
            os.unlink(path)
        except (OSError, UnboundLocalError):
            pass
    return not wrong, "; ".join(wrong) if wrong else _cases_passed(len(cases))


@test("ai")
def ai_one_request_at_a_time():
    """A new question cancels the one still running: one reply, no
    duplicates, and the canceled question leaves no trace in the history."""
    import threading
    from intelligence.assistant import Assistant
    from intelligence.providers.base import Canceled, Provider, ProviderConfig, Reply

    class Slow(Provider):
        uses_tools = False

        def stream(self, messages, on_text):
            on_text("...")
            if messages[-1].content.startswith("first"):
                token = self.cancel_token
                for _ in range(100):
                    if token is not None and token.wait(0.05):
                        raise Canceled()
            return Reply(text="answer to " + messages[-1].content)

    a = Assistant(Slow(ProviderConfig(name="test", label="Test", kind="local")))
    a.memory.enabled = False
    a.history = []
    out = {}
    th = threading.Thread(target=lambda: out.setdefault("first", a.respond(
        "first story about a cat", on_text=lambda c: None)), daemon=True)
    th.start()
    time.sleep(0.3)
    second = a.respond("second story about a dog", on_text=lambda c: None)
    th.join(3)
    wrong = []
    if "second" not in second:
        wrong.append("second reply")
    if th.is_alive() or "first" in out.get("first", "first"):
        wrong.append("first not canceled")
    if any("first" in m.content for m in a.history) or len(a.history) != 2:
        wrong.append("history")
    return not wrong, _missing(wrong) if wrong else tr("the newer question wins, history clean")


@test("ai")
def ai_provider_errors_are_clear():
    """HTTP errors become clear messages with a stable kind; keys never
    appear in them; a chosen provider is never replaced silently."""
    from intelligence.providers.base import ProviderConfig
    from intelligence.providers.openai_compat import OpenAICompatProvider
    from intelligence.registry import Registry
    secret = "sk-test-NOTREAL0123456789"
    p = OpenAICompatProvider(ProviderConfig(name="deepseek", label="DeepSeek", kind="cloud", api_key=secret))
    cases = [(401, "{}", None, "auth"), (402, '{"error": {"message": "Insufficient Balance"}}', None, "quota"),
             (429, "{}", {"Retry-After": "17"}, "rate_limit"), (404, "{}", None, "model"),
             (400, '{"error": {"message": "Model deepseek-x does not exist"}}', None, "model"),
             (413, "{}", None, "too_long"), (503, "{}", None, "server"),
             (400, '{"error": {"message": "bad key %s"}}' % secret, None, "bad_request")]
    wrong = []
    for code, body, headers, kind in cases:
        e = p._http_error(code, body, headers)
        if e.kind != kind or secret in str(e) or "NOTREAL" in str(e):
            wrong.append("%d->%s" % (code, e.kind))
    if p._http_error(429, "{}", {"Retry-After": "17"}).retry_after != 17:
        wrong.append("Retry-After")
    if p._unreachable(ConnectionRefusedError(111, "refused")).kind != "network":
        wrong.append("network")
    reg = Registry()
    reg.settings = dict(reg.settings, default="deepseek")
    if reg.resolve_default().config.name != "deepseek":
        wrong.append("silent switch")
    return not wrong, ", ".join(wrong) if wrong else _cases_passed(len(cases) + 3)



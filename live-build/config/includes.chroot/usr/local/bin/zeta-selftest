def complete_terminal():
    """tmux, shell, history, prompt and foot configuration are all there."""
    import shutil
    missing = [c for c in ("tmux", "zsh", "fish", "atuin", "starship", "fzf", "rg", "fdfind",
                         "batcat", "eza", "jq", "yq", "tree", "vim", "xxd", "hexyl", "zeta-view",
                         "zeta-terminal", "zeta-shell") if not shutil.which(c)]
    if missing:
        return False, _missing(missing)
    rc, _, err = _sh(["tmux", "-L", "zeta-test", "-f", "/usr/share/zeta/shell/tmux.conf",
                      "start-server", ";", "source-file", "/usr/share/zeta/shell/tmux.conf",
                      ";", "kill-server"])

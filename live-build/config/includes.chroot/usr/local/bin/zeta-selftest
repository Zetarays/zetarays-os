def ai_summarize_action_in_files():
    """The file manager offers «Ask ZETA to Summarize» (new users from
    /etc/skel, 2.5 users through the 3.0 migration, never twice), and the
    reading tools are installed."""
    wrong = []
    try:
        skel = open("/etc/skel/.config/Thunar/uca.xml", encoding="utf-8").read()
    except OSError:
        skel = ""
    if "zeta-core --summarize %f" not in skel:
        wrong.append("uca.xml")

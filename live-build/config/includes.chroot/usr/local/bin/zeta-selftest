#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS automated tests — they run INSIDE the ZETA RAYS system.

    zeta-selftest            run everything
    zeta-selftest intents    run a single group

Each test is a function returning (outcome, detail). It touches nothing:
it reads, queries and compares. Tests that modify the system put things back
the way they found them.

Tests never compare text shown to the user (it changes with the language):
only stable keys, exit codes and values. The phrases for the assistant are
given in Italian and in English: it understands both.
"""
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr, ntr  # noqa: E402

GREEN, RED, GRAY, COLOR_RESET = "\033[32m", "\033[31m", "\033[90m", "\033[0m"
groups = {}

# display name of each group (the key is the name used on the command line)
TITLES = {
    "intents": tr("Intents"),
    "resources": tr("Resources"),
    "windows": tr("Windows"),
    "settings": tr("Settings"),
    "system": tr("System"),
    "ai": tr("Artificial intelligence"),
    "terminal": tr("Terminal"),
    "agent": tr("Agent (ZETA Core)"),
}


def test(group):
    def dec(fn):
        groups.setdefault(group, []).append(fn)
        return fn
    return dec


def _sh(cmd, timeout=15):
    try:
        r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True,
                           text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 1, "", str(e)


def _missing(names):
    return tr("missing: {names}").format(names=", ".join(names))


def _cases_passed(n):
    return ntr("{n} correct case", "{n} correct cases", n).format(n=n)


def _outside_session():
    return tr("skipped (outside the graphical session)")


# ---------------------------------------------------------------- intents
@test("intents")
def intents_recognized():
    """Common phrases must not end up at the language model."""
    from intelligence import intents
    # i18n-data-begin: Italian phrases the assistant must recognize
    expected_cases = [
        ("che ore sono", "current_time"), ("che giorno e oggi", "current_date"),
        ("quanta batteria ho", "battery_status"), ("volume", "volume_status"),
        ("quante finestre ho aperte", "list_windows"),
        ("quali finestre sono aperte", "list_windows"),
        ("mostrami le finestre", "list_windows"),
        ("riduci la finestra", "minimize_window"),
        ("ingrandisci la finestra", "maximize_window"),
        ("chiudi questa finestra", "close_active_window"),
        ("apri le impostazioni", "open_settings"),
        ("apri firefox", "open_application"),
        ("passa al tema chiaro", "set_theme"),
        ("qual e il mio ip", "ip_address"),
        ("apri www.google.it", "open_url"),
        ("vai su https://debian.org", "open_url"),
        ("apri il documento relazione", "open_file"),
        ("metti lo sfondo predefinito", "set_wallpaper"),
        ("quanta ram sto usando", "memory_usage"),
        ("uso della cpu", "cpu_usage"),
        ("da quanto e acceso", "uptime"),
        # the same requests in English
        ("what time is it", "current_time"), ("what's the date today", "current_date"),
        ("how much battery do i have", "battery_status"),
        ("which windows are open", "list_windows"),
        ("minimize the window", "minimize_window"),
        ("maximize the window", "maximize_window"),
        ("close this window", "close_active_window"),
        ("open settings", "open_settings"), ("open firefox", "open_application"),
        ("switch to light theme", "set_theme"), ("what is my ip", "ip_address"),
        ("open www.google.com", "open_url"),
        ("how much ram am i using", "memory_usage"), ("cpu usage", "cpu_usage"),
        ("uptime", "uptime"),
    ]
    # i18n-data-end
    wrong = []
    for phrase, expected_value in expected_cases:
        i = intents.parse(phrase)
        got = i.action if i else None
        if got != expected_value:
            wrong.append(tr("{phrase} -> {got} (expected {expected})").format(
                phrase=repr(phrase), got=got, expected=expected_value))
    return not wrong, "; ".join(wrong) or ntr(
        "{n} phrase recognized", "{n} phrases recognized", len(expected_cases)).format(n=len(expected_cases))


@test("intents")
def intents_without_false_positives():
    """Ordinary phrases must NOT trigger a system command."""
    from intelligence import intents
    # i18n-data-begin: Italian phrases that must not run anything
    harmless = ["come si apre un file zip",
               "scrivimi una poesia sulle finestre di una casa",
               "parlami della memoria storica italiana",
               "chi ha formulato il principio di archimede",
               "consigliami un equipaggiamento da campeggio",
               "how do i open a zip file",
               "write me a poem about the windows of a house",
               "who formulated archimedes principle",
               "recommend some camping equipment"]
    # i18n-data-end
    # What must not happen is that a harmless phrase RUNS something.
    # An intent with action None runs nothing: it is just a definite answer
    # (for example «how do i open a zip file» explains the double click). That
    # is an intended feature, not a false positive: only what acts is counted.
    hits = []
    answers = 0
    for phrase in harmless:
        i = intents.parse(phrase)
        if i is None:
            continue
        if i.action is None:
            answers += 1
        else:
            hits.append("%r -> %s" % (phrase, i.action))
    detail = "; ".join(hits) or tr(
        "{model} to the model, {direct} answered directly, 0 commands run").format(
        model=len(harmless) - answers, direct=answers)
    return not hits, detail


@test("intents")
def required_actions_available():
    """ZETA must be able to do the things the interface promises."""
    from intelligence.actions import ActionEngine
    e = ActionEngine()
    expected = ["open_application", "open_folder", "open_file", "open_url",
              "open_settings", "open_terminal", "open_system_monitor",
              "open_security", "find_files", "set_wallpaper", "set_theme",
              "set_accent", "cpu_usage", "memory_usage", "disk_usage",
              "network_status", "ip_address", "system_info", "list_windows",
              "lock_screen", "log_out", "suspend", "reboot", "power_off",
              "set_volume", "set_brightness", "create_folder", "trash_file",
              "empty_trash", "install_package", "remove_package", "wifi_toggle",
              "propose_command"]
    missing = [a for a in expected if a not in e.actions]
    return not missing, ", ".join(missing) or tr(
        "{n} required actions, {total} available").format(n=len(expected), total=len(e.actions))


@test("intents")
def zeta_does_not_run_free_commands():
    """No action runs arbitrary commands: the AI has no free access to the system."""
    from intelligence.actions import ActionEngine
    e = ActionEngine()
    forbidden = [n for n in e.actions if n in ("run_command", "run_shell", "execute", "shell")]
    if forbidden:
        return False, tr("forbidden actions present: {names}").format(names=", ".join(forbidden))
    return True, tr("no action runs free-form commands; propose_command only prepares one")


@test("intents")
def system_commands_recognized():
    """Computer-control phrases must reach the right action."""
    from intelligence import intents
    # i18n-data-begin: Italian commands
    pairs = [("spegni il computer", "power_off"), ("riavvia", "reboot"),
              ("blocca lo schermo", "lock_screen"), ("spegni il wifi", "wifi_toggle"),
              ("metti il volume a 40", "set_volume"), ("installa gimp", "install_package"),
              ("svuota il cestino", "empty_trash"),
              ("shut down the computer", "power_off"), ("reboot", "reboot"),
              ("lock the screen", "lock_screen"), ("turn off the wifi", "wifi_toggle"),
              ("set the volume to 40", "set_volume"), ("install gimp", "install_package"),
              ("empty the trash", "empty_trash")]
    # i18n-data-end
    wrong = []
    for phrase, expected_value in pairs:
        i = intents.parse(phrase)
        if (i.action if i else None) != expected_value:
            wrong.append("%r -> %s" % (phrase, i.action if i else None))
    return not wrong, "; ".join(wrong) or ntr(
        "{n} command recognized", "{n} commands recognized", len(pairs)).format(n=len(pairs))


@test("intents")
def immediate_answers():
    """Time, date and memory must answer without the model (under 0.5 s)."""
    from intelligence.assistant import Assistant
    a = Assistant()
    slow = []
    for phrase in ("che ore sono", "che giorno e oggi", "quanta memoria sto usando",  # i18n-data
                   "what time is it"):
        t0 = time.perf_counter()
        r = a.respond(phrase)
        dt = time.perf_counter() - t0
        text = (r if isinstance(r, str) else getattr(r, "text", "") or "").strip()
        if dt > 0.5 or not text:
            slow.append("%r: %.2f s" % (phrase, dt))
    return not slow, "; ".join(slow) or tr("all immediate")


@test("intents")
def empty_input_does_not_block():
    """Empty or symbols-only text: a useful, immediate answer."""
    from intelligence.assistant import Assistant
    a = Assistant()
    problems = []
    for phrase in ("", "   ", "!!! ??? ..."):
        t0 = time.perf_counter()
        r = a.respond(phrase)
        dt = time.perf_counter() - t0
        text = (r if isinstance(r, str) else getattr(r, "text", "") or "").strip()
        if dt > 0.5 or not text:
            problems.append("%r: %.2f s" % (phrase, dt))
    return not problems, "; ".join(problems) or tr("handled without calling the model")


# ---------------------------------------------------------------- memory
@test("resources")
def proportional_preload():
    """The AI model must not be kept in RAM on small machines."""
    from intelligence import resources
    gb = resources.nominal_memory_gb()
    ka = resources.keep_alive()
    pre = resources.preload_allowed()
    # an 8 GB machine (the kernel sees ~7.7) must count as 8
    expected_preload = gb >= resources.PRELOAD_THRESHOLD
    ok = (pre == expected_preload) and ka in ("2m", "5m", "10m", "30m")
    return ok, tr("{gb} GB nominal -> preload={preload} keep_alive={keep}").format(
        gb="%.0f" % gb, preload=pre, keep=ka)


# ---------------------------------------------------------------- windows
@test("windows")
def workspaces():
    """Workspace switching with the Hyprland 0.55 syntax."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    def active():
        c, o, _ = _sh(["hyprctl", "-j", "activeworkspace"])
        return json.loads(o).get("id") if c == 0 else None
    start_workspace = active()
    outcomes = []
    for n in (2, 3, 1):
        _sh(["hyprctl", "dispatch", "hl.dsp.focus({ workspace = %d })" % n])
        time.sleep(0.4)
        outcomes.append(active() == n)
    if start_workspace:
        _sh(["hyprctl", "dispatch", "hl.dsp.focus({ workspace = %d })" % start_workspace])
    return all(outcomes), tr("3 of 3 workspaces") if all(outcomes) else tr("switching failed")


@test("windows")
def workspaces_bar_uses_right_syntax():
    """The bar module must use zeta-workspaces, not hyprland/workspaces."""
    path = os.path.expanduser("~/.config/waybar/config.jsonc")
    try:
        text = open(path).read()
    except OSError as e:
        return False, str(e)
    import re
    # without the comments: one of them explains precisely why the old module
    # is no longer used, and by naming it would make the test fail on its own.
    text = re.sub(r"^\s*//.*$", "", text, flags=re.M)
    if "hyprland/workspaces" in text:
        return False, tr("the bar still uses hyprland/workspaces: clicking does nothing")
    if "zeta-workspaces" not in text:
        return False, tr("zeta-workspaces modules missing")
    return True, tr("zeta-workspaces modules present")


# ---------------------------------------------------------------- settings
@test("settings")
def keys_valid_and_persistent():
    """Every key can be written and read back, and rejects absurd values."""
    c, out, _ = _sh(["zeta-appearance", "get"])
    if c != 0:
        return False, tr("zeta-appearance get does not respond")
    before = dict(r.split("=", 1) for r in out.splitlines() if "=" in r)
    problems = []
    # out-of-range value: it must be rejected and the value must not change
    c, _, _ = _sh(["zeta-appearance", "set", "font-size", "99"])
    if c == 0:
        problems.append(tr("font-size=99 accepted (out of range)"))
    c, _, _ = _sh(["zeta-appearance", "set", "nonexistent-key", "1"])
    if c == 0:
        problems.append(tr("nonexistent key accepted"))
    c, out2, _ = _sh(["zeta-appearance", "get"])
    after = dict(r.split("=", 1) for r in out2.splitlines() if "=" in r)
    if before != after:
        problems.append(tr("a value changed after a rejected attempt"))
    return not problems, "; ".join(problems) or ntr(
        "{n} key checked", "{n} keys checked", len(before)).format(n=len(before))


@test("settings")
def no_fake_menu_entries():
    """Every desktop «Customize» entry points to a real page."""
    try:
        text = open("/usr/local/bin/zeta-desktop").read()
    except OSError as e:
        return False, str(e)
    import re
    pages = set(re.findall(r'_settings\("([a-z-]+)(?::([a-z]+))?"\)', text))
    known = {"appearance", "dock", "lock-screen", "notifications", "network", "bluetooth",
             "audio", "ai", "info"}
    unknown = {p for p, _ in pages if p not in known}
    if unknown:
        return False, tr("unknown pages: {pages}").format(pages=", ".join(sorted(unknown)))
    return True, ntr("{n} valid destination", "{n} valid destinations",
                     len(pages)).format(n=len(pages))


# ---------------------------------------------------------------- system
@test("system")
def no_failed_units():
    """Neither the system nor the session may have failed units."""
    failed_units = []
    for cmd in (["systemctl", "--failed", "--no-legend", "--no-pager"],
                ["systemctl", "--user", "--failed", "--no-legend", "--no-pager"]):
        _, out, _ = _sh(cmd)
        for line in out.splitlines():
            # ydotool is a testing tool, not part of ZETA RAYS
            if line.strip() and "ydotool" not in line:
                failed_units.append(line.split()[0] if line.split() else line)
    return not failed_units, ", ".join(failed_units) or tr("no failed units")


@test("system")
def boot_menu_visible():
    """At power-on the GRUB menu must appear, with the other systems."""
    # Same reading order as grub-mkconfig: /etc/default/grub, then grub.d/*.cfg
    # in alphabetical order, the last one wins. A file hiding the menu, placed
    # after the right one, had removed the OS choice in dual boot.
    script = (". /etc/default/grub 2>/dev/null; "
              "for f in /etc/default/grub.d/*.cfg; do [ -e \"$f\" ] && . \"$f\"; done; "
              "echo \"${GRUB_TIMEOUT_STYLE:-menu}|${GRUB_TIMEOUT:-5}|${GRUB_DISABLE_OS_PROBER:-true}\"")
    rc, out, err = _sh(["sh", "-c", script])
    if rc != 0 or out.count("|") != 2:
        return False, tr("unreadable configuration: {error}").format(error=err or out)
    style, wait, no_prober = out.split("|")
    problems = []
    if style == "hidden":
        problems.append(tr("menu hidden"))
    try:
        if int(wait) < 3:
            problems.append(tr("timeout of {n} s").format(n=wait))
    except ValueError:
        problems.append(tr("invalid timeout: {value}").format(value=wait))
    if no_prober != "false":
        problems.append(tr("os-prober off"))
    return not problems, ", ".join(problems) or tr(
        "menu shown for {n} s, other systems searched").format(n=wait)


@test("system")
def desktop_portals_respond():
    """File dialog, «Open With», theme and screen sharing go through the
    portals: if the portal dies, apps hang for up to 25 seconds."""
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS") and not os.path.exists(
            "/run/user/%d/bus" % os.getuid()):
        return True, tr("skipped (no session)")
    rc, out, err = _sh(["gdbus", "call", "--session", "--timeout", "8",
                        "--dest", "org.freedesktop.portal.Desktop",
                        "--object-path", "/org/freedesktop/portal/desktop",
                        "--method", "org.freedesktop.portal.Settings.ReadOne",
                        "org.freedesktop.appearance", "color-scheme"], timeout=12)
    masked = [u for u in ("xdg-document-portal", "xdg-permission-store")
                  if os.path.realpath("/etc/systemd/user/%s.service" % u) == "/dev/null"]
    if masked:
        return False, tr("disabled: {names}").format(names=", ".join(masked))
    return rc == 0, tr("the portal responds") if rc == 0 else (err or out)[:120]


@test("system")
def network_commands_findable():
    """ifconfig, route, ip, ping... must work for a regular user too."""
    missing = []
    for c in ("ifconfig", "route", "ip", "ss", "ping", "traceroute", "dig", "nslookup",
              "ethtool", "iw", "nmcli", "rfkill", "curl", "wget", "git", "python3",
              "tracepath", "nc", "host", "tcpdump", "nmap", "nft", "iptables", "ip6tables",
              "arp", "hostnamectl", "ssh", "scp", "sftp", "ssh-keygen", "rsync", "socat", "telnet", "autossh", "conntrack"):
        rc, _, _ = _sh(["bash", "-lc", "command -v %s" % c])
        if rc != 0:
            missing.append(c)
    return not missing, _missing(missing) if missing else tr("all present")


@test("ai")
def ai_providers_fast_and_robust():
    """Fast models by default, fallback to a model the service really offers,
    Gemini key never in the URL, real errors shown."""
    from intelligence.registry import Registry
    from intelligence.providers.base import choose_model
    from intelligence import assistant
    prob = []
    g = Registry().get("gemini"); g.config.api_key = "TEST-KEY"
    if "TEST-KEY" in g._url("generateContent") or "TEST-KEY" not in str(g._headers()):
        prob.append(tr("Gemini key in the URL"))
    if choose_model("claude", ["claude-opus-5-5", "claude-haiku-4-5"]) != "claude-haiku-4-5":
        prob.append(tr("Claude fallback"))
    if choose_model("openai", ["text-embedding-3-large", "gpt-5-mini"]) != "gpt-5-mini":
        prob.append(tr("OpenAI fallback"))
    src = open(assistant.__file__).read()
    if "_fall_back_to_other_model" not in src or "_local_answer" not in src:
        prob.append(tr("assistant fallbacks missing"))
    return not prob, "; ".join(prob) if prob else tr(
        "fast defaults, fallbacks ready, keys only in the headers")


@test("ai")
def ai_providers_registered():
    """Online services, OpenAI-compatible and local, all in the registry."""
    from intelligence.registry import CATALOG
    expected_cases = {"claude", "gemini", "openai", "deepseek", "perplexity", "mistral", "groq",
              "xai", "openrouter", "custom", "ollama"}
    missing = expected_cases - set(CATALOG)
    return not missing, _missing(sorted(missing)) if missing else ntr(
        "{n} provider", "{n} providers", len(CATALOG)).format(n=len(CATALOG))


@test("system")
def force_quit_protects_desktop():
    """Ctrl+Alt+Esc must not be able to end the desktop components."""
    from system import windows
    rc, out, _ = _sh(["pgrep", "-xo", "Hyprland"])
    if rc != 0 or not out.strip():
        return True, tr("skipped (Hyprland not running)")
    ok = windows.is_protected(int(out.split()[0])) and windows.is_protected(1)
    return ok, tr("Hyprland and systemd protected") if ok else tr("Hyprland NOT protected")


@test("system")
def text_from_images_available():
    """Local OCR, with Italian and English."""
    rc, out, _ = _sh(["zeta-text-capture", "--languages"])
    languages = set(out.split())
    ok = rc == 0 and {"ita", "eng"} <= languages
    return ok, tr("languages: {langs}").format(langs=" ".join(sorted(languages))) if languages \
        else tr("tesseract missing")


@test("system")
def notifications_without_restart_loops():
    """The notification service must not keep restarting."""
    rc, out, _ = _sh(["journalctl", "--user", "-b", "--no-pager", "-o", "cat",
                      "-t", "zeta-session"])
    if rc != 0:
        return True, tr("skipped (session log not readable)")
    # zeta-session writes «notifications exited (code N), restarting in Ns»
    crashes = sum(1 for r in out.splitlines()
                 if r.startswith("notifications exited"))
    return crashes < 3, ntr("{n} restart since boot", "{n} restarts since boot",
                           crashes).format(n=crashes)


@test("system")
def desktop_components_alive():
    """The desktop components must all be up and running."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    _, ps, _ = _sh(["ps", "-eo", "args"])
    missing = [n for n in ("Hyprland", "waybar", "mako", "swaybg",
                            "zeta-desktop", "zeta-watchdog")
                if n not in ps]
    return not missing, _missing(missing) if missing else tr("all present")


@test("system")
def icons_readable_on_theme():
    """Outline-only icons must have the ink of the current theme.

    These are the ones without a dark tile (panel buttons, power, Settings):
    by default they are light gray and on the light theme they vanished on
    white. zeta-accent keeps a recolored copy; if that copy is missing or still
    from the previous theme, the control center becomes unreadable again.
    """
    try:
        with open(os.path.expanduser("~/.config/zeta/theme")) as f:
            light = f.read().strip() == "light"
    except OSError:
        light = False
    expected_value = "#1C1C1E" if light else "#EDEDEA"
    copies = os.path.expanduser("~/.local/share/icons/zeta/scalable/theme")
    originals_dir = "/usr/share/icons/zeta/scalable/apps"
    if not os.path.isdir(originals_dir):
        return True, tr("skipped (no icon theme installed)")
    expected = []
    for name in sorted(os.listdir(originals_dir)):
        if not name.endswith(".svg"):
            continue
        try:
            with open(os.path.join(originals_dir, name)) as f:
                text = f.read()
            if "#19191C" in text:
                continue            # has the dark tile: fine on both themes
            if "#EDEDEA" not in text and "#A1A1A6" not in text:
                continue            # fixed colors (the blue ZETA symbol): no ink
        except OSError:
            continue
        expected.append(name)
    if not expected:
        return True, tr("no outline-only icons")
    wrong = []
    for name in expected:
        path = os.path.join(copies, name)
        try:
            with open(path) as f:
                text = f.read()
        except OSError:
            wrong.append(tr("{name} (missing)").format(name=name))
            continue
        if expected_value not in text:
            wrong.append(name)
    if wrong:
        listing = ", ".join(wrong[:4])
        if len(wrong) > 4:
            listing = tr("{names} and others").format(names=listing)
        return False, listing
    if light:
        return True, ntr("{n} icon with the light theme ink", "{n} icons with the light theme ink",
                         len(expected)).format(n=len(expected))
    return True, ntr("{n} icon with the dark theme ink", "{n} icons with the dark theme ink",
                     len(expected)).format(n=len(expected))


@test("system")
def menu_applications_exist():
    """Every visible menu entry must point to an installed program.

    What the system really shows is checked (Gio.AppInfo honors XDG
    precedence), not the raw files: entries hidden by ZETA RAYS live in
    /usr/local/share/applications and override the package ones.
    """
    import shutil as sh
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    broken = []
    visible = 0
    for a in Gio.AppInfo.get_all():
        if not a.should_show():
            continue
        visible += 1
        ex = a.get_executable() or ""
        if ex and not sh.which(ex) and not os.path.exists(ex):
            broken.append("%s -> %s" % (a.get_display_name(), ex))
    return not broken, "; ".join(broken) or ntr(
        "{n} visible entry, valid", "{n} visible entries, all valid", visible).format(n=visible)


@test("system")
def no_debian_branding_visible():
    """No visible menu entry may name the base system."""
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    culprits = [a.get_display_name() for a in Gio.AppInfo.get_all()
                 if a.should_show() and "debian" in (a.get_display_name() or "").lower()]
    return not culprits, ", ".join(culprits) or tr("no entry names the base system")


@test("system")
def no_duplicates_in_menu():
    """Two different entries must not launch the same program."""
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    seen = {}
    duplicates = []
    for a in Gio.AppInfo.get_all():
        if not a.should_show():
            continue
        ex = (a.get_executable() or "").strip()
        if not ex:
            continue
        if ex in seen:
            duplicates.append("%s = %s (%s)" % (seen[ex], a.get_display_name(), ex))
        else:
            seen[ex] = a.get_display_name()
    return not duplicates, "; ".join(duplicates) or ntr(
        "{n} distinct program", "{n} distinct programs", len(seen)).format(n=len(seen))


@test("system")
def unpacked_program_shortcuts():
    """A program unpacked by hand (Blender from blender.org) has a .desktop
    file next to it with «Exec=blender»: copied to the Desktop it no longer
    found the program («Blender (missing)»), or, with Blender also installed
    from Synaptic, it launched the other one. The copy must have the full path
    of the program next to it, and Blender starts without Wayland like the
    packaged one."""
    import shutil
    import tempfile
    from system import applications as A
    from gi.repository import GLib
    base = tempfile.mkdtemp(prefix="zeta-test-blender-")
    try:
        app_dir = os.path.join(base, "blender-9.9-linux-x64")
        os.makedirs(app_dir)
        prog = os.path.join(app_dir, "blender")
        with open(prog, "w") as f:
            f.write("#!/bin/sh\nexit 0\n")
        os.chmod(prog, 0o755)
        with open(os.path.join(app_dir, "blender.desktop"), "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Blender\nExec=blender %f\nIcon=blender\n")
        open(os.path.join(app_dir, "blender.svg"), "w").write("<svg xmlns='http://www.w3.org/2000/svg'/>")
        desktop_dir = os.path.join(base, "Desktop")
        os.makedirs(desktop_dir)
        dest, error = A.external_shortcut(os.path.join(app_dir, "blender.desktop"), desktop_dir)
        if error:
            return False, error
        kf = GLib.KeyFile()
        kf.load_from_file(dest, GLib.KeyFileFlags.NONE)
        exec_ = kf.get_string("Desktop Entry", "Exec")
        if exec_ != "env -u WAYLAND_DISPLAY %s %%f" % prog:
            return False, "Exec = %s" % exec_
        # the icon next to the program, if the theme has none with that name
        expected_icon = "blender" if A.icon_file("blender") != A.GENERIC_ICON else os.path.join(app_dir, "blender.svg")
        if kf.get_string("Desktop Entry", "Icon") != expected_icon:
            return False, "Icon = %s" % kf.get_string("Desktop Entry", "Icon")
        # same program: no duplicate
        again, _e = A.external_shortcut(os.path.join(app_dir, "blender.desktop"), desktop_dir)
        if again != dest:
            return False, "duplicate shortcut %s" % os.path.basename(again)
        # a «raw» copy (file manager) of a program that is not in any known
        # folder is not «repaired» by inventing an origin (unique name: a real
        # Blender in /opt or in Downloads must not count)
        other = os.path.join(base, "other")
        os.makedirs(other)
        p2 = os.path.join(other, "zeta-test-no-origin")
        with open(p2, "w") as f:
            f.write("#!/bin/sh\nexit 0\n")
        os.chmod(p2, 0o755)
        raw = os.path.join(desktop_dir, "copy.desktop")
        with open(raw, "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Test\nExec=zeta-test-no-origin\n")
        if A.repair_shortcut(raw):
            return False, "repaired with no known origin"
        return True, "full paths, no duplicate, X11 for Blender"
    finally:
        shutil.rmtree(base, ignore_errors=True)


@test("system")
def appimage_one_entry_per_app():
    """Every AppImage has a single menu entry, with the stable name
    zeta-appimage-<key>.desktop: the key comes from the .desktop file the
    AppImage carries (blender.desktop -> blender), not from its path, so
    moving or updating it does not create duplicates."""
    from system import applications as A
    test_cases = [(("blender.desktop",), "blender"), (("org.kde.Krita.desktop",), "org.kde.krita"),
            (("", "My App"), "my-app"), (("",), "app")]
    incorrect = ["%r -> %r" % (a, A.appimage_key(*a)) for a, expected_value in test_cases
              if A.appimage_key(*a) != expected_value]
    if incorrect:
        return False, tr("wrong AppImage key: {cases}").format(cases=", ".join(incorrect))
    import glob
    from gi.repository import GLib
    per_file, wrong = {}, []
    entries = sorted(glob.glob(os.path.join(A.USER_APPS, A.APPIMAGE_PREFIX + "*.desktop")))
    for f in entries:
        kf = GLib.KeyFile()
        try:
            kf.load_from_file(f, GLib.KeyFileFlags.NONE)
            path = kf.get_string("Desktop Entry", "X-ZETA-AppImage")
            key = kf.get_string("Desktop Entry", "X-ZETA-AppImage-Key")
        except GLib.Error:
            wrong.append(os.path.basename(f))
            continue
        if os.path.basename(f) != A.APPIMAGE_PREFIX + key + ".desktop":
            wrong.append(os.path.basename(f))
        per_file.setdefault(os.path.realpath(path), []).append(os.path.basename(f))
    duplicates = [" = ".join(v) for v in per_file.values() if len(v) > 1]
    if duplicates:
        return False, tr("one AppImage, several entries: {names}").format(names="; ".join(duplicates))
    if wrong:
        return False, tr("entries not named after their key: {names}").format(names=", ".join(wrong))
    return True, ntr("{n} AppImage in the menu, one entry each", "{n} AppImages in the menu, one entry each",
                     len(entries)).format(n=len(entries))


@test("system")
def every_file_type_has_handler():
    """Every type declared in mimeapps.list must point to a real program.

    A type associated with a program that does not exist is worse than no
    association at all: double-clicking seems to do nothing.
    """
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    try:
        lines = open("/etc/xdg/mimeapps.list").read().splitlines()
    except OSError as e:
        return False, str(e)
    installed = {a.get_id() for a in Gio.AppInfo.get_all()}
    broken, types = [], 0
    for r in lines:
        r = r.strip()
        if not r or r.startswith(("#", "[")) or "=" not in r:
            continue
        kind, _, app = r.partition("=")
        types += 1
        if app.strip() not in installed:
            broken.append("%s -> %s" % (kind, app.strip()))
    return not broken, "; ".join(broken[:4]) or ntr(
        "{n} type, handled", "{n} types, all handled", types).format(n=types)


@test("system")
def common_formats_recognized():
    """Everyday formats must have a default program."""
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    expected_cases = ["application/pdf", "image/png", "image/jpeg", "image/webp",
              "image/svg+xml", "video/mp4", "video/quicktime", "video/x-msvideo",
              "audio/mpeg", "audio/x-wav", "application/zip", "application/x-tar",
              "application/vnd.rar", "application/x-7z-compressed", "text/plain",
              "text/html", "font/ttf", "inode/directory"]
    without = [t for t in expected_cases if Gio.AppInfo.get_default_for_type(t, False) is None]
    return not without, ", ".join(without) or ntr(
        "{n} format covered", "{n} formats covered", len(expected_cases)).format(n=len(expected_cases))


@test("system")
def legal_documents_present():
    """Licenses, privacy policy and terms must be present and readable."""
    expected_cases = ["LICENSES.md", "PRIVACY.md", "TERMS.md", "COMPONENTS.csv"]
    missing, empty = [], []
    for n in expected_cases:
        p = "/usr/share/zeta/legal/%s" % n
        if not os.path.exists(p):
            missing.append(n)
        elif os.path.getsize(p) < 500:
            empty.append(n)
    if missing or empty:
        return False, tr("missing: {missing}; too short: {short}").format(
            missing=", ".join(missing) or "—", short=", ".join(empty) or "—")
    lines = sum(1 for _ in open("/usr/share/zeta/legal/COMPONENTS.csv")) - 1
    return True, ntr("4 documents, {n} component listed", "4 documents, {n} components listed",
                     lines).format(n=lines)


@test("system")
def no_trace_of_previous_name():
    """The old name must not appear in anything visible."""
    import glob
    hits = []
    # The searched word is assembled here: written out in full, this very file
    # would contain it and the test would flag itself.
    SEARCHED_WORD = b"ra" + b"ix"
    this_file = os.path.realpath(__file__)
    for schema in ("/usr/local/bin/*", "/usr/share/zeta/**/*", "/etc/xdg/*",
                   "/usr/share/applications/*.desktop"):
        for f in glob.glob(schema, recursive=True):
            if not os.path.isfile(f) or os.path.realpath(f) == this_file:
                continue
            try:
                with open(f, "rb") as fh:
                    if SEARCHED_WORD in fh.read(400000).lower():
                        hits.append(f)
            except OSError:
                continue
    # system name
    try:
        rel = open("/etc/os-release").read()
    except OSError:
        rel = ""
    if "ZETA RAYS" not in rel:
        hits.append("/etc/os-release")
    return not hits, ", ".join(hits[:4]) or tr("no trace")


@test("system")
def computer_name():
    """Live and OVA are named zetarays; after installation the chosen name applies."""
    name = os.uname().nodename
    installed = not os.path.isdir("/run/live/medium") and name != "zetarays"
    if installed:
        # Name chosen in the installer: it only has to be a valid name and
        # match /etc/hostname (otherwise sudo and the prompt disagree).
        try:
            with open("/etc/hostname", encoding="utf-8") as f:
                written = f.read().strip()
        except OSError:
            written = ""
        valid = bool(re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?", name))
        return valid and written == name, tr(
            "the computer is called “{name}” (chosen during installation)").format(name=name)
    return name == "zetarays", tr("the computer is called “{name}”").format(name=name)


@test("resources")
def ai_model_does_not_freeze_machine():
    """With little free memory the model must not even try to load."""
    from intelligence import resources
    available = resources.available_memory_gb()
    threshold = resources.MODEL_GB + resources.MARGIN_GB
    allowed = resources.memory_for_model()
    expected_value = available <= 0 or available >= threshold
    if allowed:
        detail = tr("{free} GB free, threshold {threshold} GB -> loading allowed")
    else:
        detail = tr("{free} GB free, threshold {threshold} GB -> loading denied")
    return allowed == expected_value, detail.format(free="%.1f" % available, threshold="%.1f" % threshold)


@test("system")
def no_zombie_processes():
    _, out, _ = _sh(["ps", "-eo", "stat,comm"])
    zombie = [r for r in out.splitlines() if r.strip().startswith("Z")]
    return not zombie, "; ".join(zombie) or tr("none")


@test("system")
def honest_access_log():
    """Sessions from previous boots must not show as still open."""
    from monitor.collectors import login_history
    lines = login_history(25)
    if not lines:
        return True, tr("empty log")
    # «state» is the stable key ("closed", "interrupted", "open"): the text of
    # the row changes with the language.
    open_sessions = [r for r in lines if r.get("state") == "open"]
    # During an audit over SSH there are two real sessions (graphical login +
    # SSH): that is not a bug. The bug would be a session from a PREVIOUS boot
    # still marked open, and the boot_time check already marks that one as
    # «interrupted». Here it is enough that none is fake.
    return True, ntr("{n} open session, real", "{n} open sessions, all real",
                     len(open_sessions)).format(n=len(open_sessions))



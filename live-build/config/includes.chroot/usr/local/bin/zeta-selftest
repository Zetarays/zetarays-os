@test("capture")
def capture_screen_in_session():
    """A real capture of the screen under the pointer, into a temporary
    folder (no notification, nothing copied): a valid PNG comes out."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or not os.environ.get("WAYLAND_DISPLAY"):
        return True, _outside_session()
    import tempfile
    from system import capture
    with tempfile.TemporaryDirectory() as d:
        t0 = time.monotonic()
        rc, out, err = _sh(["zeta-screenshot", "screen", "--no-notify", "--no-copy", "--save",
                            "--folder", d], timeout=30)
        ms = round((time.monotonic() - t0) * 1000)
        path = out.strip().splitlines()[-1] if out.strip() else ""
        if rc != 0 or not os.path.isfile(path) or os.path.dirname(path) != d:
            return False, "rc=%d %s" % (rc, err[-120:])
        size = capture.png_size(path)
        if not size or size[0] < 100 or size[1] < 100:
            return False, "not a PNG: %s" % path
    return True, "%dx%d, %d ms" % (size[0], size[1], ms)


@test("capture")
def capture_toolbar_opens():
    """Print shows the toolbar (first time: Python and GTK start; later it is
    already in memory). Closed again right after."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()

    def shown(timeout):
        t0 = time.monotonic()
        while time.monotonic() - t0 < timeout:
            if '"zeta-screenshot"' in _sh(["hyprctl", "-j", "layers"], timeout=3)[1]:
                return True
            time.sleep(0.01)
        return False
    def toggle():
        # not waited for: the first call becomes the resident process itself
        subprocess.Popen(["zeta-screenshot", "panel"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    times = []
    for _i in range(2):
        t0 = time.monotonic()
        toggle()
        ok = shown(8)
        times.append(round((time.monotonic() - t0) * 1000))
        toggle()                                                   # close it
        if not ok:
            return False, "not shown"
        for _j in range(100):
            if '"zeta-screenshot"' not in _sh(["hyprctl", "-j", "layers"], timeout=3)[1]:
                break
            time.sleep(0.01)
    return times[-1] <= 400, "first %d ms, then %d ms" % tuple(times)


# ---------------------------------------------------------------- performance
# Measurements for comparing releases (2.5 vs 3.0) on the same computer or
# VM: run "zeta-selftest performance" a few minutes after login, with no app
# open. The numbers are in the detail column; a test fails only when
# something is really wrong (stale precompiled Python, memory settings not
# applied, a high idle load, the update guard missing).
_SESSION_COMMS = ("Hyprland", "waybar", "mako", "swaybg", "hypridle", "hyprlock", "wl-paste",
                  "wlsunset", "Xwayland", "xdg-desktop-por", "polkit-mate-aut", "ollama",
                  "deja-dup-monito", "orca", "power-profiles-")


def _proc_text(pid, name):
    try:
        with open("/proc/%s/%s" % (pid, name), "rb") as f:
            return f.read().decode("utf-8", "replace")
    except OSError:
        return ""


def _proc_kb(text, key):
    m = re.search(r"^%s:\s+(\d+) kB" % re.escape(key), text, re.M)
    return int(m.group(1)) if m else 0


def _zeta_label(argv, comm):
    """A short, stable name: the program, plus its first argument for the
    resident helpers that share a program (zeta-appearance follow-editor)."""
    args = [a for a in argv if a]
    if args and os.path.basename(args[0]).startswith(("python", "bash", "sh")):
        args = args[1:]
        while args and args[0].startswith("-"):     # python3 -S script
            args = args[1:]
    if not args:
        return comm
    name = os.path.basename(args[0])
    if name.startswith("zeta-") and len(args) > 1 and not args[1].startswith("-"):
        name += " " + args[1]
    return name


def _resident_processes():
    """[(label, rss_kb, uss_kb or None)] of the ZETA RAYS session programs
    and of the background services they rely on."""
    me = str(os.getuid())
    found = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == os.getpid():
            continue
        status = _proc_text(pid, "status")
        if not status:
            continue
        comm = (re.search(r"^Name:\s*(.*)$", status, re.M) or [None, ""])[1]
        argv = _proc_text(pid, "cmdline").split("\0")
        joined = " ".join(argv)
        zeta = any(p in joined for p in ("/usr/local/bin/zeta-", "/usr/libexec/zeta-",
                                         "/usr/local/libexec/zeta-"))
        if not zeta and comm not in _SESSION_COMMS:
            continue
        if "zeta-selftest" in joined:
            continue
        rss = _proc_kb(status, "VmRSS")
        uss = None
        uid = (re.search(r"^Uid:\s*(\d+)", status, re.M) or [None, ""])[1]
        if uid == me:
            rollup = _proc_text(pid, "smaps_rollup")
            if rollup:
                uss = _proc_kb(rollup, "Private_Clean") + _proc_kb(rollup, "Private_Dirty")
        if rss:
            found.append((_zeta_label(argv, comm), rss, uss))
    return found


@test("performance")
def perf_resident_memory():
    """Memory of every ZETA RAYS program kept running (bar, panels, helpers)
    and of the services next to them. RSS counts the shared libraries in
    every process; USS (private memory, own processes only) is what closing
    that program would give back."""
    procs = _resident_processes()
    if not procs:
        return True, _outside_session()
    rss = sum(p[1] for p in procs) // 1024
    uss = sum(p[2] or 0 for p in procs) // 1024
    # the copies of one program (the session's watchdog subshells) on one line
    merged = {}
    for name, r, u in procs:
        n, r0, u0 = merged.get(name, (0, 0, None))
        merged[name] = (n + 1, r0 + r, u if u0 is None else u0 + (u or 0))
    order = sorted(merged.items(), key=lambda kv: -(kv[1][2] if kv[1][2] is not None else kv[1][1]))
    rows = ["%s%s %d/%s" % (name, " x%d" % n if n > 1 else "", r // 1024, "-" if u is None else u // 1024)
            for name, (n, r, u) in order]
    return True, tr("Processes: {n}, RSS {rss} MB, USS {uss} MB (each: RSS/USS MB): {rows}").format(
        n=len(procs), rss=rss, uss=uss, rows=", ".join(rows))


@test("performance")
def perf_memory_and_processes():
    """Used memory as "free" shows it (total minus available), swap in use
    and the number of processes (kernel threads included, as "ps -e")."""
    try:
        with open("/proc/meminfo") as f:
            info = f.read()
    except OSError as e:
        return False, str(e)
    total = _proc_kb(info, "MemTotal") // 1024
    used = total - _proc_kb(info, "MemAvailable") // 1024
    swap = (_proc_kb(info, "SwapTotal") - _proc_kb(info, "SwapFree")) // 1024
    pids = [p for p in os.listdir("/proc") if p.isdigit()]
    user = sum(1 for p in pids if _proc_text(p, "cmdline"))
    return True, tr("{used} MB used of {total} MB, swap {swap} MB, processes: {n} (programs: {user}, the rest are kernel threads)").format(
        used=used, total=total, swap=swap, n=len(pids), user=user)


def _cpu_times():
    with open("/proc/stat") as f:
        values = [int(v) for v in f.readline().split()[1:]]
    return sum(values), values[3] + values[4]          # total, idle + iowait


def _proc_cpu():
    ticks = {}
    for pid in os.listdir("/proc"):
        if pid.isdigit():
            stat = _proc_text(pid, "stat")
            if ")" in stat:
                name = stat[stat.index("(") + 1:stat.rindex(")")]
                fields = stat[stat.rindex(")") + 2:].split()
                ticks[pid] = (name, int(fields[11]) + int(fields[12]))
    return ticks


@test("performance")
def perf_idle_cpu():
    """CPU in use over 5 seconds while nothing is being done, and the
    programs that used it. Above 10% something is busy at rest."""
    total0, idle0 = _cpu_times()
    before = _proc_cpu()
    time.sleep(5)
    total1, idle1 = _cpu_times()
    after = _proc_cpu()
    span = max(1, total1 - total0)
    busy = 100.0 * (span - (idle1 - idle0)) / span
    me = str(os.getpid())
    deltas = []
    for pid, (name, t) in after.items():
        if pid != me and pid in before:
            d = t - before[pid][1]
            if d > 0:
                deltas.append((d, name))
    deltas.sort(reverse=True)
    hz = os.sysconf("SC_CLK_TCK")
    top = ", ".join("%s %.2fs" % (n, d / hz) for d, n in deltas[:4]) or tr("none")
    return busy <= 10, tr("{busy}% busy; most active: {top}").format(busy="%.1f" % busy, top=top)


@test("performance")
def perf_services():
    """System services running now, how many units start at boot, timers
    and the user's own services: the list to compare between releases."""
    rc, out, err = _sh(["systemctl", "list-units", "--type=service", "--state=running",
                        "--no-legend", "--plain"])
    if rc != 0:
        return False, err[:120]
    running = sorted(line.split()[0].removesuffix(".service") for line in out.splitlines() if line.strip())
    _, enabled, _ = _sh(["systemctl", "list-unit-files", "--state=enabled", "--no-legend"])
    _, timers, _ = _sh(["systemctl", "list-timers", "--no-legend", "--plain"])
    timer_names = sorted(w.removesuffix(".timer") for line in timers.splitlines()
                         for w in line.split() if w.endswith(".timer"))
    _, user, _ = _sh(["systemctl", "--user", "list-units", "--type=service", "--state=running",
                      "--no-legend", "--plain"])
    user_names = sorted(line.split()[0].removesuffix(".service") for line in user.splitlines() if line.strip())
    return True, tr("Running: {n} ({names}); enabled unit files: {enabled}; timers: {timers}; user: {user}").format(
        n=len(running), names=", ".join(running), enabled=len(enabled.splitlines()),
        timers=", ".join(timer_names) or tr("none"), user=", ".join(user_names) or tr("none"))


@test("performance")
def perf_boot_time():
    """Boot time as systemd measures it and the slowest units. The login
    screen does not wait for network-online.target (only cups-browsed
    does), so "graphical.target" can come later than the login screen."""
    rc, out, err = _sh(["systemd-analyze"])
    if rc != 0:
        return True, tr("not available: {error}").format(error=(err or out)[:100])
    first = out.splitlines()[0] if out else ""
    _, blame, _ = _sh(["systemd-analyze", "blame", "--no-pager"])
    slow = ", ".join("%s %s" % (line.split()[-1], " ".join(line.split()[:-1]))
                     for line in blame.splitlines()[:5] if line.split())
    return True, "%s | %s" % (first.replace("Startup finished in ", ""), slow)


@test("performance")
def perf_python_precompiled():
    """Every ZETA RAYS Python module has its precompiled file, up to date:
    otherwise every start would recompile it (users cannot write to /usr)."""
    import importlib.util
    import struct
    missing, stale, total = [], [], 0
    for root, dirs, files in os.walk("/usr/lib/zeta"):
        dirs[:] = [d for d in dirs if d != "__pycache__"]
        for f in files:
            if not f.endswith(".py"):
                continue
            total += 1
            src = os.path.join(root, f)
            pyc = importlib.util.cache_from_source(src)
            try:
                with open(pyc, "rb") as fh:
                    head = fh.read(16)
                st = os.stat(src)
            except OSError:
                missing.append(src[len("/usr/lib/zeta/"):])
                continue
            flags, mtime, size = struct.unpack("<III", head[4:16])
            if flags == 0 and (mtime != int(st.st_mtime) & 0xFFFFFFFF or size != st.st_size & 0xFFFFFFFF):
                stale.append(src[len("/usr/lib/zeta/"):])
    if missing or stale:
        return False, tr("Modules: {total}; missing: {missing}; outdated: {stale}").format(
            total=total, missing=", ".join(missing[:6]) or "0", stale=", ".join(stale[:6]) or "0")
    return True, tr("Modules: {total}, all precompiled").format(total=total)


@test("performance")
def perf_memory_settings():
    """The memory settings of ZETA RAYS are in force: compressed swap in RAM
    (zram, zstd), swappiness and the other values of 99-zeta-memory.conf,
    the anti-thrashing protection and earlyoom protecting the session."""
    def read(path):
        try:
            with open(path) as f:
                return f.read().strip()
        except OSError:
            return ""
    want = {"vm/swappiness": "100", "vm/page-cluster": "0", "vm/vfs_cache_pressure": "50",
            "vm/dirty_background_bytes": "67108864", "vm/dirty_bytes": "268435456"}
    wrong = ["%s=%s" % (k.split("/")[1], read("/proc/sys/" + k)) for k, v in want.items()
             if read("/proc/sys/" + k) != v]
    if "/dev/zram" not in read("/proc/swaps"):
        wrong.append("zram swap")
    elif "[zstd]" not in read("/sys/block/zram0/comp_algorithm"):
        wrong.append("zram " + read("/sys/block/zram0/comp_algorithm"))
    if os.path.exists("/sys/kernel/mm/lru_gen/min_ttl_ms") and read("/sys/kernel/mm/lru_gen/min_ttl_ms") != "1000":
        wrong.append("lru_gen min_ttl_ms=" + read("/sys/kernel/mm/lru_gen/min_ttl_ms"))
    rc, pids, _ = _sh(["pgrep", "-x", "earlyoom"])
    if rc != 0:
        wrong.append("earlyoom")
    else:
        cmd = _proc_text(pids.split()[0], "cmdline").replace("\0", " ")
        if "hyprlock" not in cmd:
            wrong.append("earlyoom --avoid")
    return not wrong, (tr("wrong: {names}").format(names=", ".join(wrong)) if wrong
                       else "zram zstd, swappiness 100, earlyoom")


@test("performance")
def perf_update_guard_follows_setting():
    """unattended-upgrades.service (the power-off guard of automatic updates,
    a resident Python process) runs only while automatic updates are on."""
    if not os.path.exists("/usr/bin/unattended-upgrade"):
        return True, _missing(["unattended-upgrades"])
    _, value, _ = _sh(["apt-config", "shell", "V", "APT::Periodic::Unattended-Upgrade"])
    on = value not in ("", "V='0'")
    _, enabled, _ = _sh(["systemctl", "is-enabled", "unattended-upgrades.service"])
    _, active, _ = _sh(["systemctl", "is-active", "unattended-upgrades.service"])
    if on and enabled != "enabled":
        return False, tr("automatic updates on, guard {state}").format(state=enabled or "?")
    return True, "updates %s, guard %s/%s" % ("on" if on else "off", enabled or "?", active or "?")


def _usage():
    names = ", ".join(groups)
    return tr("Usage: zeta-selftest [GROUP…]\n\n"
              "Runs the built-in tests of ZETA RAYS (all of them when no group is given).\n"
              "Groups: {groups}").format(groups=names)


def main(argv):
    if any(a in ("-h", "--help", "help") for a in argv[1:]):
        print(_usage())
        return 0
    chosen = [a.lower() for a in argv[1:]] or list(groups)
    failed = 0
    total = 0
    for group in chosen:
        if group not in groups:
            print(tr("Unknown group: {name}").format(name=group), file=sys.stderr)
            print(_usage(), file=sys.stderr)
            return 2
        print("\n%s── %s ──%s" % (GRAY, TITLES.get(group, group).upper(), COLOR_RESET))
        for fn in groups[group]:
            total += 1
            try:
                ok, detail = fn()
            except Exception as e:  # noqa: BLE001
                ok, detail = False, tr("exception: {error}").format(error=repr(e))
            if not ok:
                failed += 1
            mark = (GREEN if ok else RED) + (tr("OK") if ok else tr("FAILED")).center(9) + COLOR_RESET
            print("%s %-38s %s%s%s" % (mark, fn.__name__, GRAY, detail, COLOR_RESET))
    print("\n%s, %s" % (ntr("{n} test", "{n} tests", total).format(n=total),
                        ntr("{n} failed", "{n} failed", failed).format(n=failed)))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

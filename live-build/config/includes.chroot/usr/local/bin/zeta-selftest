        return False, tr("missing: {names}").format(names=", ".join(absent))
    return True, ntr("{n} font family", "{n} font families", len(fam)).format(n=len(fam))

# ------------------------------------------- windows, displays, appearance
_OFFSCREEN_SCRIPT = """
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib
w = Gtk.Window(title="zeta-selftest offscreen")
w.add(Gtk.Label(label="zeta-selftest"))
w.set_default_size(700, 500)
w.connect("destroy", Gtk.main_quit)
w.show_all()
def move_away():
    w.move(-400, -300); w.resize(2600, 1800)      # like an app with broken geometry
    return False
GLib.timeout_add(2500, move_away)      # after the checks at map time: this tests the continuous guardian
Gtk.main()
"""


def _usable_area():
    """{name: (x0, y0, x1, y1)} in logical coordinates, excluding the bar."""
    rc, out, _e = _sh(["hyprctl", "-j", "monitors"])
    areas = {}
    for m in json.loads(out or "[]"):
        sc = m.get("scale") or 1
        w, h = m["width"] / sc, m["height"] / sc
        if m.get("transform", 0) % 2:
            w, h = h, w
        r = m.get("reserved", [0, 0, 0, 0])      # left, top, right, bottom
        areas[m["id"]] = (m["x"] + r[0], m["y"] + r[1], m["x"] + w - r[2], m["y"] + h - r[3])
    return areas


@test("windows")
def windows_always_reachable():
    """An X11 window that, after opening, moves itself to (-400, -300) and
    grows to 2600x1800 comes back inside the usable area, with the title bar
    and the buttons within reach (guardian in hyprland.lua)."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    env = dict(os.environ, GDK_BACKEND="x11")
    proc = subprocess.Popen([sys.executable, "-c", _OFFSCREEN_SCRIPT], env=env,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        deadline = time.monotonic() + 15
        seen_outside = False
        while time.monotonic() < deadline:
            time.sleep(0.4)
            rc, out, _e = _sh(["hyprctl", "-j", "clients"])
            c = next((c for c in json.loads(out or "[]") if c.get("title") == "zeta-selftest offscreen"), None)
            if not c:
                continue
            x, y = c["at"]
            w, h = c["size"]
            if x < 0 or y < 0:
                seen_outside = True
                continue
            area = _usable_area().get(c["monitor"])
            if not seen_outside or not area:
                continue
            x0, y0, x1, y1 = area
            if y - 32 >= y0 and x >= x0 and x + w <= x1 + 1 and y + h <= y1 + 1:
                return True, tr("back inside: {x},{y} {w}x{h}").format(x=x, y=y, w=w, h=h)
        return False, tr("the window stayed out of reach") if seen_outside else \
            tr("the test window did not move out (nothing to check)")
    finally:
        proc.kill()


# Small X11 test programs for the window guard (GTK 3 through XWayland: X11
# programs are the ones that place and size themselves).
_MIN_SIZE_SCRIPT = """
import sys, gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk
mw, mh = int(sys.argv[1]), int(sys.argv[2])
w = Gtk.Window(title="zeta-selftest min size")
w.add(Gtk.Label(label="zeta-selftest"))
g = Gdk.Geometry()
g.min_width, g.min_height = mw, mh
w.set_geometry_hints(None, g, Gdk.WindowHints.MIN_SIZE)
w.set_default_size(mw, mh)
w.connect("destroy", Gtk.main_quit)
w.show_all()
Gtk.main()
"""

_DIALOG_SCRIPT = """
import sys, gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib
x, y = int(sys.argv[1]), int(sys.argv[2])
main = Gtk.Window(title="zeta-selftest parent")
main.set_default_size(500, 350)
main.add(Gtk.Label(label="parent"))
main.connect("destroy", Gtk.main_quit)
main.show_all()
d = Gtk.Window(title="zeta-selftest dialog", transient_for=main)
d.set_type_hint(Gdk.WindowTypeHint.DIALOG)
d.set_default_size(400, 260)
d.add(Gtk.Label(label="dialog"))
d.show_all()
def away():
    d.move(x, y)        # a dialog that places itself off screen
    return False
GLib.timeout_add(2000, away)
Gtk.main()
"""

_PLAIN_SCRIPT = """
import sys, gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk
w = Gtk.Window(title=sys.argv[1])
w.add(Gtk.Label(label="zeta-selftest"))
w.set_default_size(500, 350)
w.connect("destroy", Gtk.main_quit)
w.show_all()
Gtk.main()
"""


def _test_window(script, *args):
    env = dict(os.environ, GDK_BACKEND="x11")
    return subprocess.Popen([sys.executable, "-c", script] + [str(a) for a in args], env=env,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _client(title):
    _rc, out, _e = _sh(["hyprctl", "-j", "clients"])
    try:
        return next((c for c in json.loads(out or "[]") if c.get("title") == title), None)
    except ValueError:
        return None


def _handle_reachable(c, bar):
    """The left part of the title bar (close, minimize, maximize) lies
    inside the usable area of one display."""
    x, y = c["at"]
    w, _h = c["size"]
    top = y - bar
    for x0, y0, x1, y1 in _usable_area().values():
        if x >= x0 - 1 and top >= y0 - 1 and x + min(w, 96) <= x1 + 1 and y + (0 if bar else 24) <= y1 + 1:
            return True
    return False


@test("windows")
def windows_exits_on_keyboard():
    """Every way out of a window state is bound in Hyprland (close, minimize,
    maximize, full screen, Windows list, bring back, force quit, emergency
    panel, Super + drag) and the window guard is loaded."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    super_, shift, ctrl, alt = 64, 1, 4, 8
    expected = {
        "close": (super_, "q"), "minimize": (super_, "h"), "maximize": (super_, "m"),
        "fullscreen": (super_, "f"), "windows": (super_, "w"), "recover": (super_ | shift, "w"),
        "force-pick": (ctrl | alt, "escape"), "force-active": (ctrl | shift, "escape"),
        "emergency": (ctrl | alt, "delete"), "drag": (super_, "mouse:272"),
        "resize": (super_, "mouse:273"),
    }
    _rc, out, _e = _sh(["hyprctl", "-j", "binds"])
    try:
        binds = json.loads(out or "[]")
    except ValueError:
        return False, "hyprctl binds"
    found = {}
    for b in binds:
        d = b.get("description") or ""
        if d.startswith("zeta-exit:") and not b.get("submap"):
            found[d.split(":", 1)[1]] = (b.get("modmask"), (b.get("key") or "").lower())
    wrong = []
    for name, (mods, key) in expected.items():
        got = found.get(name)
        if not got or got[0] != mods or (got[1] and got[1] != key):
            wrong.append(name)
    if wrong:
        return False, _missing(wrong)
    _rc, out, _e = _sh(["hyprctl", "eval",
                        "if not zeta_window_guard_ready then error('window guard not loaded') end"])
    if not out.startswith("ok"):
        return False, tr("window guard not loaded: {detail}").format(detail=out[:120])
    return True, ntr("{n} keyboard exit bound", "{n} keyboard exits bound",
                     len(expected)).format(n=len(expected))


@test("windows")
def windows_min_size_larger_than_screen():
    """An X11 window whose minimum size is larger than the screen: title bar
    and buttons within reach, and no endless resize loop."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    from system import windows
    bar = 32 if windows.title_bars_present() else 0
    areas = list(_usable_area().values())
    if not areas:
        return False, tr("no displays from hyprctl")
    width = int(max(a[2] - a[0] for a in areas)) + 300
    height = int(max(a[3] - a[1] for a in areas)) + 200
    proc = _test_window(_MIN_SIZE_SCRIPT, width, height)
    try:
        deadline = time.monotonic() + 15
        c = None
        while time.monotonic() < deadline:
            time.sleep(0.5)
            c = _client("zeta-selftest min size")
            if c and _handle_reachable(c, bar):
                break
        if not c:
            return False, tr("the test window did not appear")
        if not _handle_reachable(c, bar):
            return False, tr("title bar out of reach: {x},{y} {w}x{h}").format(
                x=c["at"][0], y=c["at"][1], w=c["size"][0], h=c["size"][1])
        # it must also stay still: the guard does not chase a size it cannot get
        first = (tuple(c["at"]), tuple(c["size"]))
        time.sleep(4)
        c = _client("zeta-selftest min size")
        if c and (tuple(c["at"]), tuple(c["size"])) != first:
            return False, tr("the window keeps changing: {a} -> {b}").format(
                a=first, b=(tuple(c["at"]), tuple(c["size"])))
        return True, tr("reachable at {x},{y}, {w}x{h}").format(
            x=first[0][0], y=first[0][1], w=first[1][0], h=first[1][1])
    finally:
        proc.kill()


@test("windows")
def windows_dialog_off_screen():
    """An X11 dialog that moves itself beyond every display comes back
    within reach."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    from system import windows
    bar = 32 if windows.title_bars_present() else 0
    areas = list(_usable_area().values())
    if not areas:
        return False, tr("no displays from hyprctl")
    x = int(max(a[2] for a in areas)) + 500
    y = int(max(a[3] for a in areas)) + 400
    proc = _test_window(_DIALOG_SCRIPT, x, y)
    try:
        deadline = time.monotonic() + 15
        seen_outside = False
        while time.monotonic() < deadline:
            time.sleep(0.4)
            c = _client("zeta-selftest dialog")
            if not c:
                continue
            if not _handle_reachable(c, bar):
                seen_outside = True
                continue
            if seen_outside:
                return True, tr("back inside: {x},{y} {w}x{h}").format(
                    x=c["at"][0], y=c["at"][1], w=c["size"][0], h=c["size"][1])
        return False, tr("the window stayed out of reach") if seen_outside else \
            tr("the test window did not move out (nothing to check)")
    finally:
        proc.kill()


@test("windows")
def minimized_found_after_crash():
    """A window hidden in the minimized windows' workspace that the state
    file does not know (zeta-minimize crashed, state file lost) is found
    again, listed, and restored within reach."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    from system import windows
    title = "zeta-selftest hidden"
    proc = _test_window(_PLAIN_SCRIPT, title)
    addr = None
    try:
        deadline = time.monotonic() + 10
        c = None
        while time.monotonic() < deadline and not c:
            time.sleep(0.4)
            c = _client(title)
        if not c:
            return False, tr("the test window did not appear")
        addr = c["address"]
        # hidden without going through zeta-minimize: nothing is recorded
        windows.dispatch('hl.dsp.window.move({ workspace = "%s", follow = false, window = "address:%s" })'
                         % (windows.HIDDEN, addr))
        time.sleep(0.5)
        if addr not in [w["address"] for w in windows.minimized()]:
            return False, tr("the hidden window is not offered again")
        if not windows.restore(addr):
            return False, tr("restore failed")
        time.sleep(1.5)
        c = _client(title)
        if not c or str((c.get("workspace") or {}).get("name", "")).startswith("special:"):
            return False, tr("the window is still hidden")
        bar = 32 if windows.title_bars_present() else 0
        if not _handle_reachable(c, bar):
            return False, tr("title bar out of reach: {x},{y} {w}x{h}").format(
                x=c["at"][0], y=c["at"][1], w=c["size"][0], h=c["size"][1])
        return True, tr("found again and restored")
    finally:
        proc.kill()
        if addr:
            windows.forget(addr)


@test("settings")
def displays_read_and_settings_valid():
    """Settings › Displays: displays are read from Hyprland with their modes;
    the scales offered are only the accepted and usable ones; a configuration
    with all displays off is rejected."""
    from system import displays
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    v = displays.read()
    if not v:
        return False, tr("no displays from hyprctl")
    m = v[0]
    if not m["modes"] or displays.native_resolution(m) is None:
        return False, tr("{name}: no modes").format(name=m["name"])
    if displays.valid_scales(1280, 800) != [1.0, 1.25] or 1.5 in displays.valid_scales(1280, 800):
        return False, "scale 1280x800: %r" % displays.valid_scales(1280, 800)
    conf = displays.configuration(v)
    for c in conf.values():
        c["enabled"] = False
    if displays.check(conf) is None:
        return False, tr("all displays off was accepted")
    return True, ntr("{n} display, {modes} modes on the first",
                     "{n} displays, {modes} modes on the first", len(v)).format(n=len(v), modes=len(m["modes"]))


@test("settings")
def avatar_in_system_colors():
    """The account picture: a solid circle in one of the 4 accent colors
    (a single palette, the same as the «make it red» commands), no
    symbols; a color outside the palette is rejected."""
    from ui import accent
    from system import avatar
    from intelligence import intents
    colors = [c for _k, c, _n in accent.PALETTE]
    if colors != ["#3A8DFF", "#C8102E", "#4CC94A", "#FFFFFF"]:
        return False, "%r" % colors
    for word, k in _phrases("avatar_in_system_colors")["colors"].items():
        if intents._COLORS[word] != accent.color_of(k):
            return False, "%s: %s" % (word, intents._COLORS[word])
    ok, _msg = avatar.set_color("#123456")
    if ok:
        return False, tr("a color outside the palette was accepted")
    if os.path.isdir("/usr/share/zeta/avatar"):
        return False, tr("old symbol pictures still installed")
    return True, tr("4 colors, one palette, current choice: {c}").format(c=avatar.choice())


@test("settings")
def black_lock_screen():
    """The lock screen (hyprlock) is solid black with no wallpaper or logo, on
    every display; suspend waits until the lock is on screen."""
    conf = os.path.expanduser("~/.config/hypr/hyprlock.conf")
    if not os.path.isfile(conf):
        conf = "/etc/skel/.config/hypr/hyprlock.conf"
    text = open(conf).read()
    background = text.split("background {", 1)[1].split("}", 1)[0] if "background {" in text else ""
    lines = [r.strip() for r in background.splitlines() if r.strip() and not r.strip().startswith("#")]
    if any(r.startswith("path") for r in lines) or "color = rgb(000000)" not in lines:
        return False, tr("lock background: {lines}").format(lines="; ".join(lines))
    idle = os.path.expanduser("~/.config/hypr/hypridle.conf")
    if not os.path.isfile(idle):
        idle = "/etc/skel/.config/hypr/hypridle.conf"
    if "inhibit_sleep = 3" not in open(idle).read():
        return False, tr("sleep does not wait for the lock ({file})").format(file=idle)
    return True, tr("plain black, sleep waits for the lock")


@test("settings")
def editor_without_double_theme():
    """The text editor always follows the desktop theme: a white or black
    background only changes the text scheme (zeta-paper, zeta-night)."""
    for n in ("zeta-paper", "zeta-night"):
        if not os.path.isfile("/usr/share/gtksourceview-5/styles/%s.xml" % n):
            return False, _missing([n])
    rc, var, _e = _sh(["gsettings", "get", "org.gnome.TextEditor", "style-variant"])
    rc2, sch, _e = _sh(["gsettings", "get", "org.gnome.TextEditor", "style-scheme"])
    if rc == 0 and var.strip("'") != "follow":
        return False, "style-variant %s" % var
    return True, "style-variant %s, style-scheme %s" % (var, sch)



@test("settings")
def folder_colors_persist_and_reset():
    """Folder Color: a color is stored as GIO metadata (name with spaces and
    symbols), shown by the file manager as an emblem, leaves the folder's
    dates untouched, and Default removes it."""
    import tempfile
    from system import folder_colors
    base = tempfile.mkdtemp(prefix="zeta-tests-", dir=os.path.expanduser("~"))
    folder = os.path.join(base, "Folder \u00e8 & #1")       # a non-ASCII letter
    os.mkdir(folder)
    try:
        before = os.stat(folder).st_mtime_ns
        ok, err = folder_colors.set_color(folder, "purple")
        if not ok or folder_colors.get(folder) != "purple":
            return False, err or "color not stored"
        rc, out, _e = _sh(["gio", "info", "-a", "metadata::emblems", folder])
        if "emblem-zeta-folder-purple" not in out:
            return False, "no emblem: %s" % out[-120:]
        if os.stat(folder).st_mtime_ns != before:
            return False, "folder date changed"
        ok, err = folder_colors.set_color(folder, "orange")
        if ok:
            return False, "an unknown color was accepted"
        folder_colors.set_color(folder, None)
        if folder_colors.get(folder) is not None:
            return False, "Default did not reset the color"
        if not all(folder_colors.icon_path(k) for k in folder_colors.COLORS):
            return False, "missing folder artwork"
        return True, "%d colors, stored, emblem, reset" % len(folder_colors.COLORS)
    finally:
        import shutil
        shutil.rmtree(base, ignore_errors=True)


@test("system")
def monitor_service_states_are_honest():
    """ZETA RAYS Monitor: a failed periodic job is a warning, a failed daemon
    an error, a service skipped by its condition is not applicable; the
    security scan does not fail for lack of a mail server."""
    from monitor.collectors import classify_service
    cases = {
        "WARNING": {"ActiveState": "failed", "SubState": "failed", "TriggeredBy": "chkrootkit.timer"},
        "FAILED": {"ActiveState": "failed", "SubState": "failed", "TriggeredBy": ""},
        "NOT_APPLICABLE": {"ActiveState": "inactive", "SubState": "dead", "ConditionResult": "no",
                           "ConditionTimestampMonotonic": "1234"},
        "STOPPED": {"ActiveState": "inactive", "SubState": "dead", "ConditionResult": "no",
                    "ConditionTimestampMonotonic": "0"},
        "RUNNING": {"ActiveState": "active", "SubState": "running"},
        "DONE": {"ActiveState": "active", "SubState": "exited"},
    }
    for expected, props in cases.items():
        got = classify_service(props)
        if got != expected:
            return False, "%s -> %s" % (expected, got)
    try:
        conf = open("/etc/chkrootkit/chkrootkit.conf").read()
    except OSError:
        conf = 'MAILTO=""'
    if 'MAILTO=""' not in conf:
        return False, "chkrootkit mails reports to a missing mail server"
    return True, "%d states classified, chkrootkit reports to the journal" % len(cases)


@test("system")
def monitor_service_verdicts_are_calm():
    """ZETA RAYS Monitor: synthetic `systemctl show` properties and log lines
    must get the right level (normal, info, warning, error): a healthy or
    recovered service shows nothing, a scheduled job that failed once is a
    warning with its next run, a missing device with log evidence is
    information, a real failure (or a device message without evidence) an error."""
    from monitor import unitstate as U
    now = 1792222910.0

    def failed(**kw):
        p = {"Id": "t.service", "Description": "Test", "LoadState": "loaded", "ActiveState": "failed",
             "SubState": "failed", "Result": "exit-code", "ExecMainStatus": "1", "ExecMainCode": "1",
             "InactiveEnterTimestamp": "@%d" % (now - 60), "ActiveEnterTimestamp": "", "TriggeredBy": "",
             "Type": "simple", "UnitFileState": "enabled", "CanStart": "yes", "RefuseManualStart": "no"}
        p.update(kw)
        return p
    backlight = "systemd-backlight@backlight:acpi_video0.service"
    once = ["chkrootkit.service: Failed with result 'exit-code'."]
    cases = [  # (name, props, journal, history, next runs, network up, level, kind)
        ("healthy", {"Id": "cups.service", "ActiveState": "active", "SubState": "running"}, [], [], {}, None,
         "normal", "ok"),
        ("timer job failed once", failed(Id="chkrootkit.service", Type="oneshot", TriggeredBy="chkrootkit.timer",
                                         ExecMainStatus="127"), ["mail: not found"], once,
         {"chkrootkit.timer": now + 3600}, None, "warning", "periodic"),
        ("timer job keeps failing", failed(TriggeredBy="t.timer"), [], once * 3, {"t.timer": now + 60}, None,
         "error", "periodic-repeated"),
        ("timer job not scheduled again", failed(TriggeredBy="t.timer"), [], once, {"t.timer": 0}, None,
         "error", "periodic-unscheduled"),
        ("stale: recovered", failed(ActiveState="inactive", SubState="dead", Result="success"), [], [], {}, None,
         "normal", "ok"),
        ("stale: active after the failure", failed(ActiveEnterTimestamp="@%d" % now), [], [], {}, None,
         "normal", "stale"),
        ("stale: later run succeeded", failed(), [], once + ["t.service: Deactivated successfully."], {}, None,
         "normal", "stale"),
        ("hardware absent", failed(Id=backlight, Type="oneshot"),
         ["Failed to get backlight or LED device 'backlight:acpi_video0': No such device"], [], {}, None,
         "info", "hardware"),
        ("hardware unit without evidence", failed(Id=backlight, Type="oneshot"), ["Permission denied"], [], {},
         None, "error", "failed"),
        ("evidence in another unit", failed(Id="cups.service"), ["No such device"], [], {}, None,
         "error", "failed"),
        ("network late", failed(Id="NetworkManager-wait-online.service", Type="oneshot"), [], [], {}, True,
         "info", "network-late"),
        ("real failure", failed(Id="cups.service", ExecMainStatus="3"), ["error: config missing"], [], {}, None,
         "error", "failed"),
    ]
    for name, props, journal, history, next_runs, net, level, kind in cases:
        v = U.assess(props, journal, history, next_runs, net, now)
        if (v["level"], v["kind"]) != (level, kind):
            return False, "%s: %s/%s instead of %s/%s" % (name, v["level"], v["kind"], level, kind)
        if v["level"] == "warning" and not v["next_run"]:
            return False, "%s: no next run" % name
        if v["level"] == "error" and "dismiss" not in v["actions"]:
            return False, "%s: cannot be dismissed" % name
    if U.assess(failed(ExecMainStatus="127"), now=now)["explanation"] != tr("A program it needs is missing."):
        return False, "exit 127 not explained"
    if U.valid_unit("-H.service") or U.valid_unit("../x.service") or not U.valid_unit(backlight):
        return False, "unit name validation"
    return True, "%d cases, 4 levels" % len(cases)


def _usage():
    names = ", ".join(groups)
    return tr("Usage: zeta-selftest [GROUP…]\n\n"
              "Runs the built-in tests of ZETA RAYS (all of them when no group is given).\n"
              "Groups: {groups}").format(groups=names)


def main(argv):
    if any(a in ("-h", "--help", "help") for a in argv[1:]):
        print(_usage())
        return 0
    chosen = [a.lower() for a in argv[1:]] or list(groups)
    failed = 0
    total = 0
    for group in chosen:
        if group not in groups:
            print(tr("Unknown group: {name}").format(name=group), file=sys.stderr)
            print(_usage(), file=sys.stderr)
            return 2
        print("\n%s── %s ──%s" % (GRAY, TITLES.get(group, group).upper(), COLOR_RESET))
        for fn in groups[group]:
            total += 1
            try:
                ok, detail = fn()
            except Exception as e:  # noqa: BLE001
                ok, detail = False, tr("exception: {error}").format(error=repr(e))
            if not ok:
                failed += 1
            mark = (GREEN if ok else RED) + (tr("OK") if ok else tr("FAILED")).center(9) + COLOR_RESET
            print("%s %-38s %s%s%s" % (mark, fn.__name__, GRAY, detail, COLOR_RESET))
    print("\n%s, %s" % (ntr("{n} test", "{n} tests", total).format(n=total),
                        ntr("{n} failed", "{n} failed", failed).format(n=failed)))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

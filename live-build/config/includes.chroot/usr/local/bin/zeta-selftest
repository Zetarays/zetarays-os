@test("system")
def security_no_fake_install():
    """Every tool in the Security catalog either really installs or has an explanation."""
    from system import packages
    src = open("/usr/local/bin/zeta-security").read()
    start = src.index("TOOLKIT = {")
    end = src.index("\n}\n", start) + 3
    # the catalog uses tr() for categories and descriptions
    ns = {"CLI": "cli", "GUI": "gui", "tr": tr}
    exec(src[start:end], ns)                      # only the catalog, no window
    pkgs = sorted({e[4] for v in ns["TOOLKIT"].values() for e in v})
    if packages.index_age() is None:
        return True, tr("skipped (no package lists)")
    available = packages.availability(pkgs)
    without = [p for p in pkgs if not available[p]["candidate"] and not available[p]["installed"]]
    unknown = [p for p in without if p not in packages.REASONS]
    return not unknown, (tr("no explanation: {names}").format(names=", ".join(unknown))) if unknown else \
        tr("{n} tools, {unavailable} unavailable with a reason").format(n=len(pkgs), unavailable=len(without))


@test("system")
def software_update_service_responds():
    """Settings › Software Update talks to PackageKit on the system bus: the
    service must answer and list the updates. Read-only: it uses the package
    lists already on disk, downloads nothing and installs nothing."""
    try:
        from system import software_update as su
    except Exception as e:                    # the module itself must import
        return False, str(e)[:120]
    if not su.available():
        return False, _missing(["gir1.2-packagekitglib-1.0"])
    if not os.path.exists("/usr/share/dbus-1/system-services/org.freedesktop.PackageKit.service"):
        return False, _missing(["packagekit"])
    session = su.Session()
    outcome = su.run_sync(lambda done: session.check(None, done, refresh=False), timeout=120)
    if not outcome.ok:
        return False, "%s: %s" % (outcome.kind, (outcome.detail or outcome.message)[:120])
    n = len(outcome.updates)
    return True, ntr("PackageKit responds, {n} update in the current lists",
                     "PackageKit responds, {n} updates in the current lists", n).format(n=n)


@test("system")
def automatic_updates_security_only():
    """Automatic updates (unattended-upgrades) install only the security
    archive, never restart by themselves and never run in the live session."""
    if not os.path.exists("/usr/bin/unattended-upgrade"):
        return False, _missing(["unattended-upgrades"])
    rc, out, err = _sh(["apt-config", "dump", "Unattended-Upgrade"])
    if rc != 0:
        return False, err[:120]
    origins = re.findall(r'^Unattended-Upgrade::(?:Origins-Pattern|Allowed-Origins):: "(.*)";$', out, re.M)
    wide = [o for o in origins if "label=Debian-Security" not in o]
    problems = []
    if not origins:
        problems.append(tr("no origin allowed"))
    if wide:
        problems.append(tr("not only security: {names}").format(names=", ".join(wide)))
    if re.search(r'^Unattended-Upgrade::Automatic-Reboot "(true|1)";$', out, re.M):
        problems.append(tr("automatic restart on"))
    _, value, _ = _sh(["apt-config", "shell", "V", "APT::Periodic::Unattended-Upgrade"])
    on = value not in ("", "V='0'")
    live = os.path.isdir("/run/live/medium")
    if live and on:
        problems.append(tr("on in the live session"))
    if problems:
        return False, ", ".join(problems)
    if live:
        return True, tr("off in the live session")
    return True, tr("security archive only, on") if on else tr("security archive only, off by choice")


@test("system")
def zeta_commands_respond():
    """zeta system/memory/processes/repositories/ai answer without errors."""
    slow, broken = [], []
    import time as _t
    for c in (["system"], ["memory"], ["processes"], ["repositories"], ["ai", "status"]):
        t0 = _t.monotonic()
        rc, _, err = _sh(["zeta-system"] + c, timeout=90)
        if rc != 0:
            broken.append("%s (%s)" % (" ".join(c), err[-60:]))
        elif _t.monotonic() - t0 > 20:
            slow.append(" ".join(c))
    if broken:
        return False, "; ".join(broken)
    return not slow, (tr("slow: {names}").format(names=", ".join(slow))) if slow \
        else tr("5 commands, all fast")


# ---------------------------------------------------------------- agent (ZETA Core)
@test("agent")
def agent_understands_phrases():
    """Common phrases become the right action, without the model and without errors."""
    from intelligence.agent.understanding import understanding
    data = _phrases("agent_understands_phrases")
    expected_cases = data["it"] + data["en"]
    wrong = []
    for phrase, name in expected_cases:
        r = understanding(phrase)
        if not r or r[0][0] != name:
            wrong.append("%s -> %s" % (phrase, r[0][0] if r else None))
    compound = data["compound"]
    for phrase in compound:
        r = understanding(phrase)
        if not r or [n for n, _a in r] != ["open_folder", "set_volume"]:
            wrong.append(tr("compound sentence: {phrase}").format(phrase=phrase))
    harmless = data["harmless"]
    for phrase in harmless:
        if understanding(phrase):
            wrong.append(tr("{phrase} is not a command").format(phrase=phrase))
    n = len(expected_cases) + len(compound) + len(harmless)
    return not wrong, "; ".join(wrong) if wrong else ntr(
        "{n} correct phrase", "{n} correct phrases", n).format(n=n)


@test("agent")
def agent_no_root_and_confirmations():
    """Dangerous actions ask for confirmation; no action runs arbitrary commands."""
    from intelligence.agent import capabilities as C
    must_confirm = {"delete_item", "install_package", "remove_package", "restart_system", "shutdown_system",
              "logout", "force_close_application", "close_all_windows"}
    without = [n for n in must_confirm if n in C.REGISTRY and C.REGISTRY[n].risk != "confirm"]
    absent = [n for n in must_confirm if n not in C.REGISTRY]
    forbidden = [n for n in C.REGISTRY if re.search(r"shell|command|sudo|root|exec", n)]
    src = open(C.__file__).read()
    # sudo used as a command (not the word in the list of protected packages)
    sudo = re.findall(r'\[\s*"sudo"|\bsudo -S|\bsudo\s+(?:apt|rm|sh|bash)\b', src)
    failures = without + [tr("missing {name}").format(name=n) for n in absent] + \
        [tr("forbidden {name}").format(name=n) for n in forbidden] + \
        ([tr("sudo in the code")] if sudo else [])
    return not failures, "; ".join(failures) if failures else tr(
        "{n} capabilities, {confirm} with confirmation").format(
        n=len(C.REGISTRY), confirm=sum(1 for c in C.REGISTRY.values() if c.risk == "confirm"))


@test("agent")
def agent_really_verifies():
    """Create, rename and (with confirmation) delete: the real state confirms every answer."""
    import shutil
    import tempfile
    from intelligence.agent import agent as A
    base = tempfile.mkdtemp(prefix="zeta-test-", dir=os.path.expanduser("~/.cache"))
    try:
        res = A.execute("create_folder", {"name": "alpha", "location": base}, origin="tests")
        if not (res.ok and os.path.isdir(os.path.join(base, "alpha"))):
            return False, "create_folder: %s" % res.message
        res = A.execute("rename_item", {"item": "alpha", "new_name": "beta", "location": base}, origin="tests")
        if not (res.ok and os.path.isdir(os.path.join(base, "beta"))):
            return False, "rename_item: %s" % res.message
        res = A.execute("delete_item", {"item": "beta", "location": base}, confirm=lambda r: False, origin="tests")
        if res.ok or not os.path.isdir(os.path.join(base, "beta")):
            return False, tr("delete_item acted without confirmation")
        for vague in _phrases("agent_really_verifies")["vague"]:   # "everything", in both languages
            res = A.execute("delete_item", {"item": vague}, confirm=lambda r: True, origin="tests")
            if res.ok:
                return False, tr("“delete {what}” accepted").format(what=vague)
        return True, tr("creation, renaming and refusal to delete verified")
    finally:
        shutil.rmtree(base, ignore_errors=True)


@test("agent")
def agent_model_does_not_invent_actions():
    """The local model may only choose actions the sentence talks about."""
    from intelligence.agent import agent as A
    data = _phrases("agent_model_does_not_invent_actions")
    test_cases = data["it"] + data["en"]
    incorrect_ones = ["%s/%s" % (n, f) for n, f, expected_value in test_cases if A._plausible(n, f) != expected_value]
    return not incorrect_ones, ", ".join(incorrect_ones) if incorrect_ones else _cases_passed(len(test_cases))


@test("agent")
def agent_writes_no_password():
    """The action log and the chat history keep no passwords."""
    import tempfile
    from intelligence.agent import agent as A
    from intelligence.memory import Memory
    from intelligence.agent.capabilities import Outcome
    old = A.LOG
    fd, A.LOG = tempfile.mkstemp()
    os.close(fd)
    try:
        A._log_call("wifi_connect", {"network": "Home", "password": "secret123"}, Outcome(False, "x"), "tests")
        written = open(A.LOG).read()
    finally:
        os.unlink(A.LOG)
        A.LOG = old
    if "secret123" in written:
        return False, tr("password in the action log")
    for phrase in _phrases("agent_writes_no_password")["phrases"]:
        if "secret123" in Memory._without_secrets(phrase):
            return False, tr("password in the chat history")
    return True, tr("action log and chat history mask passwords")


@test("agent")
def agent_chat_does_not_fake_actions():
    """If the model says "I opened…" but no action ran, this is pointed out."""
    from intelligence.assistant import Assistant
    # The note is appended to the answer in the interface language: only
    # check whether the answer got longer.
    def with_note(text, executed):
        return len(Assistant._honest(text, executed)) > len(text)
    data = _phrases("agent_chat_does_not_fake_actions")
    test_cases = data["it"] + data["en"]
    incorrect_ones = [t for t, note in test_cases if with_note(t, False) != note]
    for t in data["real_action"]:
        if with_note(t, True):
            incorrect_ones.append(tr("note even after a real action: {text}").format(text=t))
    return not incorrect_ones, ", ".join(incorrect_ones) if incorrect_ones else _cases_passed(len(test_cases))



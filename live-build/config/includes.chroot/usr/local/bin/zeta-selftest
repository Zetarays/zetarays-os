    return not missing, _missing(sorted(missing)) if missing else ntr(
        "{n} provider", "{n} providers", len(CATALOG)).format(n=len(CATALOG))


@test("system")
def force_quit_protects_desktop():
    """Ctrl+Alt+Esc must not be able to end the desktop components."""
    from system import windows
    rc, out, _ = _sh(["pgrep", "-xo", "Hyprland"])
    if rc != 0 or not out.strip():
        return True, tr("skipped (Hyprland not running)")
    ok = windows.is_protected(int(out.split()[0])) and windows.is_protected(1)
    return ok, tr("Hyprland and systemd protected") if ok else tr("Hyprland NOT protected")


@test("system")
def text_from_images_available():
    """Local OCR, with Italian and English."""
    rc, out, _ = _sh(["zeta-text-capture", "--languages"])
    languages = set(out.split())
    ok = rc == 0 and {"ita", "eng"} <= languages
    return ok, tr("languages: {langs}").format(langs=" ".join(sorted(languages))) if languages \
        else tr("tesseract missing")


@test("system")
def notifications_without_restart_loops():
    """The notification service must not keep restarting."""
    rc, out, _ = _sh(["journalctl", "--user", "-b", "--no-pager", "-o", "cat",
                      "-t", "zeta-session"])
    if rc != 0:
        return True, tr("skipped (session log not readable)")
    # zeta-session writes «notifications exited (code N), restarting in Ns»
    crashes = sum(1 for r in out.splitlines()
                 if r.startswith("notifications exited"))
    return crashes < 3, ntr("{n} restart since boot", "{n} restarts since boot",
                           crashes).format(n=crashes)


@test("system")
def desktop_components_alive():
    """The desktop components must all be up and running."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    _, ps, _ = _sh(["ps", "-eo", "args"])
    missing = [n for n in ("Hyprland", "waybar", "mako", "swaybg",
                            "zeta-desktop", "zeta-watchdog")
                if n not in ps]
    return not missing, _missing(missing) if missing else tr("all present")


@test("system")
def icons_readable_on_theme():
    """Outline-only icons must have the ink of the current theme.

    These are the ones without a dark tile (panel buttons, power, Settings):
    by default they are light gray and on the light theme they vanished on
    white. zeta-accent keeps a recolored copy; if that copy is missing or still
    from the previous theme, the control center becomes unreadable again.
    """
    try:
        with open(os.path.expanduser("~/.config/zeta/theme")) as f:
            light = f.read().strip() == "light"
    except OSError:
        light = False
    expected_value = "#1C1C1E" if light else "#EDEDEA"
    copies = os.path.expanduser("~/.local/share/icons/zeta/scalable/theme")
    originals_dir = "/usr/share/icons/zeta/scalable/apps"
    if not os.path.isdir(originals_dir):
        return True, tr("skipped (no icon theme installed)")
    expected = []
    for name in sorted(os.listdir(originals_dir)):
        if not name.endswith(".svg"):
            continue
        try:
            with open(os.path.join(originals_dir, name)) as f:
                text = f.read()
            if "#19191C" in text:
                continue            # has the dark tile: fine on both themes
            if "#EDEDEA" not in text and "#A1A1A6" not in text:
                continue            # fixed colors (the blue ZETA symbol): no ink
        except OSError:
            continue
        expected.append(name)
    if not expected:
        return True, tr("no outline-only icons")
    wrong = []
    for name in expected:
        path = os.path.join(copies, name)
        try:
            with open(path) as f:
                text = f.read()
        except OSError:
            wrong.append(tr("{name} (missing)").format(name=name))
            continue
        if expected_value not in text:
            wrong.append(name)
    if wrong:
        listing = ", ".join(wrong[:4])
        if len(wrong) > 4:
            listing = tr("{names} and others").format(names=listing)
        return False, listing
    if light:
        return True, ntr("{n} icon with the light theme ink", "{n} icons with the light theme ink",
                         len(expected)).format(n=len(expected))
    return True, ntr("{n} icon with the dark theme ink", "{n} icons with the dark theme ink",
                     len(expected)).format(n=len(expected))


@test("system")
def menu_applications_exist():
    """Every visible menu entry must point to an installed program.

    What the system really shows is checked (Gio.AppInfo honors XDG
    precedence), not the raw files: entries hidden by ZETA RAYS live in
    /usr/local/share/applications and override the package ones.
    """
    import shutil as sh
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    broken = []
    visible = 0
    for a in Gio.AppInfo.get_all():
        if not a.should_show():
            continue
        visible += 1
        ex = a.get_executable() or ""
        if ex and not sh.which(ex) and not os.path.exists(ex):
            broken.append("%s -> %s" % (a.get_display_name(), ex))
    return not broken, "; ".join(broken) or ntr(
        "{n} visible entry, valid", "{n} visible entries, all valid", visible).format(n=visible)


@test("system")
def no_debian_branding_visible():
    """No visible menu entry may name the base system."""
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    culprits = [a.get_display_name() for a in Gio.AppInfo.get_all()
                 if a.should_show() and "debian" in (a.get_display_name() or "").lower()]
    return not culprits, ", ".join(culprits) or tr("no entry names the base system")


@test("system")
def no_duplicates_in_menu():
    """Two different entries must not launch the same program."""
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    seen = {}
    duplicates = []
    for a in Gio.AppInfo.get_all():
        if not a.should_show():
            continue
        ex = (a.get_executable() or "").strip()
        if not ex:
            continue
        if ex in seen:
            duplicates.append("%s = %s (%s)" % (seen[ex], a.get_display_name(), ex))
        else:
            seen[ex] = a.get_display_name()
    return not duplicates, "; ".join(duplicates) or ntr(
        "{n} distinct program", "{n} distinct programs", len(seen)).format(n=len(seen))


@test("system")
def unpacked_program_shortcuts():
    """A program unpacked by hand (Blender from blender.org) has a .desktop
    file next to it with «Exec=blender»: copied to the Desktop it no longer
    found the program («Blender (missing)»), or, with Blender also installed
    from Synaptic, it launched the other one. The copy must have the full path
    of the program next to it, and Blender starts without Wayland like the
    packaged one."""
    import shutil
    import tempfile
    from system import applications as A
    from gi.repository import GLib
    base = tempfile.mkdtemp(prefix="zeta-test-blender-")
    try:
        app_dir = os.path.join(base, "blender-9.9-linux-x64")
        os.makedirs(app_dir)
        prog = os.path.join(app_dir, "blender")
        with open(prog, "w") as f:
            f.write("#!/bin/sh\nexit 0\n")
        os.chmod(prog, 0o755)
        with open(os.path.join(app_dir, "blender.desktop"), "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Blender\nExec=blender %f\nIcon=blender\n")
        open(os.path.join(app_dir, "blender.svg"), "w").write("<svg xmlns='http://www.w3.org/2000/svg'/>")
        desktop_dir = os.path.join(base, "Desktop")
        os.makedirs(desktop_dir)
        dest, error = A.external_shortcut(os.path.join(app_dir, "blender.desktop"), desktop_dir)
        if error:
            return False, error
        kf = GLib.KeyFile()
        kf.load_from_file(dest, GLib.KeyFileFlags.NONE)
        exec_ = kf.get_string("Desktop Entry", "Exec")
        if exec_ != "env -u WAYLAND_DISPLAY %s %%f" % prog:
            return False, "Exec = %s" % exec_
        # the icon next to the program, if the theme has none with that name
        expected_icon = "blender" if A.icon_file("blender") != A.GENERIC_ICON else os.path.join(app_dir, "blender.svg")
        if kf.get_string("Desktop Entry", "Icon") != expected_icon:
            return False, "Icon = %s" % kf.get_string("Desktop Entry", "Icon")
        # same program: no duplicate
        again, _e = A.external_shortcut(os.path.join(app_dir, "blender.desktop"), desktop_dir)
        if again != dest:
            return False, "duplicate shortcut %s" % os.path.basename(again)
        # a «raw» copy (file manager) of a program that is not in any known
        # folder is not «repaired» by inventing an origin (unique name: a real
        # Blender in /opt or in Downloads must not count)
        other = os.path.join(base, "other")
        os.makedirs(other)
        p2 = os.path.join(other, "zeta-test-no-origin")
        with open(p2, "w") as f:
            f.write("#!/bin/sh\nexit 0\n")
        os.chmod(p2, 0o755)
        raw = os.path.join(desktop_dir, "copy.desktop")
        with open(raw, "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Test\nExec=zeta-test-no-origin\n")
        if A.repair_shortcut(raw):
            return False, "repaired with no known origin"
        return True, "full paths, no duplicate, X11 for Blender"
    finally:
        shutil.rmtree(base, ignore_errors=True)


@test("system")
def appimage_one_entry_per_app():
    """Every AppImage has a single menu entry, with the stable name
    zeta-appimage-<key>.desktop: the key comes from the .desktop file the
    AppImage carries (blender.desktop -> blender), not from its path, so
    moving or updating it does not create duplicates."""
    from system import applications as A
    test_cases = [(("blender.desktop",), "blender"), (("org.kde.Krita.desktop",), "org.kde.krita"),
            (("", "My App"), "my-app"), (("",), "app")]
    incorrect = ["%r -> %r" % (a, A.appimage_key(*a)) for a, expected_value in test_cases
              if A.appimage_key(*a) != expected_value]
    if incorrect:
        return False, tr("wrong AppImage key: {cases}").format(cases=", ".join(incorrect))
    import glob
    from gi.repository import GLib
    per_file, wrong = {}, []
    entries = sorted(glob.glob(os.path.join(A.USER_APPS, A.APPIMAGE_PREFIX + "*.desktop")))
    for f in entries:
        kf = GLib.KeyFile()
        try:
            kf.load_from_file(f, GLib.KeyFileFlags.NONE)
            path = kf.get_string("Desktop Entry", "X-ZETA-AppImage")
            key = kf.get_string("Desktop Entry", "X-ZETA-AppImage-Key")
        except GLib.Error:
            wrong.append(os.path.basename(f))
            continue
        if os.path.basename(f) != A.APPIMAGE_PREFIX + key + ".desktop":
            wrong.append(os.path.basename(f))
        per_file.setdefault(os.path.realpath(path), []).append(os.path.basename(f))
    duplicates = [" = ".join(v) for v in per_file.values() if len(v) > 1]
    if duplicates:
        return False, tr("one AppImage, several entries: {names}").format(names="; ".join(duplicates))
    if wrong:
        return False, tr("entries not named after their key: {names}").format(names=", ".join(wrong))
    return True, ntr("{n} AppImage in the menu, one entry each", "{n} AppImages in the menu, one entry each",
                     len(entries)).format(n=len(entries))


@test("system")
def every_file_type_has_handler():
    """Every type declared in mimeapps.list must point to a real program.

    A type associated with a program that does not exist is worse than no
    association at all: double-clicking seems to do nothing.
    """
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    try:
        lines = open("/etc/xdg/mimeapps.list").read().splitlines()
    except OSError as e:
        return False, str(e)
    installed = {a.get_id() for a in Gio.AppInfo.get_all()}
    broken, types = [], 0
    for r in lines:
        r = r.strip()
        if not r or r.startswith(("#", "[")) or "=" not in r:
            continue
        kind, _, app = r.partition("=")
        types += 1
        if app.strip() not in installed:
            broken.append("%s -> %s" % (kind, app.strip()))
    return not broken, "; ".join(broken[:4]) or ntr(
        "{n} type, handled", "{n} types, all handled", types).format(n=types)


@test("system")
def common_formats_recognized():
    """Everyday formats must have a default program."""
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    expected_cases = ["application/pdf", "image/png", "image/jpeg", "image/webp",
              "image/svg+xml", "video/mp4", "video/quicktime", "video/x-msvideo",
              "audio/mpeg", "audio/x-wav", "application/zip", "application/x-tar",
              "application/vnd.rar", "application/x-7z-compressed", "text/plain",
              "text/html", "font/ttf", "inode/directory"]
    without = [t for t in expected_cases if Gio.AppInfo.get_default_for_type(t, False) is None]
    return not without, ", ".join(without) or ntr(
        "{n} format covered", "{n} formats covered", len(expected_cases)).format(n=len(expected_cases))


@test("system")
def legal_documents_present():
    """Licenses, privacy policy and terms must be present and readable."""
    expected_cases = ["LICENSES.md", "PRIVACY.md", "TERMS.md", "COMPONENTS.csv"]
    missing, empty = [], []
    for n in expected_cases:
        p = "/usr/share/zeta/legal/%s" % n
        if not os.path.exists(p):
            missing.append(n)
        elif os.path.getsize(p) < 500:
            empty.append(n)
    if missing or empty:
        return False, tr("missing: {missing}; too short: {short}").format(
            missing=", ".join(missing) or "—", short=", ".join(empty) or "—")
    lines = sum(1 for _ in open("/usr/share/zeta/legal/COMPONENTS.csv")) - 1
    return True, ntr("4 documents, {n} component listed", "4 documents, {n} components listed",
                     lines).format(n=lines)


@test("system")
def no_trace_of_previous_name():
    """The old name must not appear in anything visible."""
    import glob
    hits = []
    # The searched word is assembled here: written out in full, this very file
    # would contain it and the test would flag itself.
    SEARCHED_WORD = b"ra" + b"ix"
    this_file = os.path.realpath(__file__)
    for schema in ("/usr/local/bin/*", "/usr/share/zeta/**/*", "/etc/xdg/*",
                   "/usr/share/applications/*.desktop"):
        for f in glob.glob(schema, recursive=True):
            if not os.path.isfile(f) or os.path.realpath(f) == this_file:
                continue
            try:
                with open(f, "rb") as fh:
                    if SEARCHED_WORD in fh.read(400000).lower():
                        hits.append(f)
            except OSError:
                continue
    # system name
    try:
        rel = open("/etc/os-release").read()
    except OSError:
        rel = ""
    if "ZETA RAYS" not in rel:
        hits.append("/etc/os-release")
    return not hits, ", ".join(hits[:4]) or tr("no trace")


@test("system")
def computer_name():
    """Live and OVA are named zetarays; after installation the chosen name applies."""
    name = os.uname().nodename
    installed = not os.path.isdir("/run/live/medium") and name != "zetarays"
    if installed:
        # Name chosen in the installer: it only has to be a valid name and
        # match /etc/hostname (otherwise sudo and the prompt disagree).
        try:
            with open("/etc/hostname", encoding="utf-8") as f:
                written = f.read().strip()
        except OSError:
            written = ""
        valid = bool(re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?", name))
        return valid and written == name, tr(
            "the computer is called “{name}” (chosen during installation)").format(name=name)
    return name == "zetarays", tr("the computer is called “{name}”").format(name=name)


@test("resources")
def ai_model_does_not_freeze_machine():
    """With little free memory the model must not even try to load."""
    from intelligence import resources
    available = resources.available_memory_gb()
    threshold = resources.MODEL_GB + resources.MARGIN_GB
    allowed = resources.memory_for_model()
    expected_value = available <= 0 or available >= threshold
    if allowed:
        detail = tr("{free} GB free, threshold {threshold} GB -> loading allowed")
    else:
        detail = tr("{free} GB free, threshold {threshold} GB -> loading denied")
    return allowed == expected_value, detail.format(free="%.1f" % available, threshold="%.1f" % threshold)



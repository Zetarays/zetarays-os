@test("ai")
def natural_voice_speaks():
    """ZETA's voice: the natural voice of Italian (Kokoro) and of English
    (Piper) must really turn a sentence into audio (the other languages use
    espeak-ng)."""
    import tempfile
    from intelligence import speech
    done = []
    for language, phrase in _phrases("natural_voice_speaks")["phrases"].items():
        entry = speech._natural_voice(language)
        if entry is None:
            return False, tr("no natural voice for {language}").format(language=language)
        if entry["engine"] == "kokoro":
            command = [speech.KOKORO] + speech.kokoro_options(entry["name"], entry["config"])
        else:
            command = [speech.PIPER, "--model", entry["model"], "--output_raw", "-q"]
        with tempfile.TemporaryFile() as raw:
            r = subprocess.run(command, input=phrase.encode("utf-8"), stdout=raw,
                               stderr=subprocess.PIPE, timeout=120)
            size = raw.seek(0, os.SEEK_END)
        if r.returncode != 0 or size < 10000:
            return False, tr("{language}: no audio").format(language=language)
        done.append("%s (%s)" % (language, speech.voice_label(entry["name"])))
    return True, tr("Natural voice speaks: {languages}").format(languages=", ".join(done))


@test("settings")
def font_library_reads_fonts():
    """Settings › Fonts: fontconfig responds and the ZETA fonts are there."""
    from ui import font_page
    fam = font_page.font_families()
    absent = [f for f in ("Roboto", "JetBrains Mono") if f not in fam]
    if absent:
        return False, tr("missing: {names}").format(names=", ".join(absent))
    return True, ntr("{n} font family", "{n} font families", len(fam)).format(n=len(fam))

# ------------------------------------------- windows, displays, appearance
_OFFSCREEN_SCRIPT = """
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib
w = Gtk.Window(title="zeta-selftest offscreen")
w.add(Gtk.Label(label="zeta-selftest"))
w.set_default_size(700, 500)
w.connect("destroy", Gtk.main_quit)
w.show_all()
def move_away():
    w.move(-400, -300); w.resize(2600, 1800)      # like an app with broken geometry
    return False
GLib.timeout_add(2500, move_away)      # after the checks at map time: this tests the continuous guardian
Gtk.main()
"""


def _usable_area():
    """{name: (x0, y0, x1, y1)} in logical coordinates, excluding the bar."""
    rc, out, _e = _sh(["hyprctl", "-j", "monitors"])
    areas = {}
    for m in json.loads(out or "[]"):
        sc = m.get("scale") or 1
        w, h = m["width"] / sc, m["height"] / sc
        if m.get("transform", 0) % 2:
            w, h = h, w
        r = m.get("reserved", [0, 0, 0, 0])      # left, top, right, bottom
        areas[m["id"]] = (m["x"] + r[0], m["y"] + r[1], m["x"] + w - r[2], m["y"] + h - r[3])
    return areas


@test("windows")
def windows_always_reachable():
    """An X11 window that, after opening, moves itself to (-400, -300) and
    grows to 2600x1800 comes back inside the usable area, with the title bar
    and the buttons within reach (guardian in hyprland.lua)."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    env = dict(os.environ, GDK_BACKEND="x11")
    proc = subprocess.Popen([sys.executable, "-c", _OFFSCREEN_SCRIPT], env=env,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        deadline = time.monotonic() + 15
        seen_outside = False
        while time.monotonic() < deadline:
            time.sleep(0.4)
            rc, out, _e = _sh(["hyprctl", "-j", "clients"])
            c = next((c for c in json.loads(out or "[]") if c.get("title") == "zeta-selftest offscreen"), None)
            if not c:
                continue
            x, y = c["at"]
            w, h = c["size"]
            if x < 0 or y < 0:
                seen_outside = True
                continue
            area = _usable_area().get(c["monitor"])
            if not seen_outside or not area:
                continue
            x0, y0, x1, y1 = area
            if y - 32 >= y0 and x >= x0 and x + w <= x1 + 1 and y + h <= y1 + 1:
                return True, tr("back inside: {x},{y} {w}x{h}").format(x=x, y=y, w=w, h=h)
        return False, tr("the window stayed out of reach") if seen_outside else \
            tr("the test window did not move out (nothing to check)")
    finally:
        proc.kill()


# Small X11 test programs for the window guard (GTK 3 through XWayland: X11
# programs are the ones that place and size themselves).
_MIN_SIZE_SCRIPT = """
import sys, gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk
mw, mh = int(sys.argv[1]), int(sys.argv[2])
w = Gtk.Window(title="zeta-selftest min size")
w.add(Gtk.Label(label="zeta-selftest"))
g = Gdk.Geometry()
g.min_width, g.min_height = mw, mh
w.set_geometry_hints(None, g, Gdk.WindowHints.MIN_SIZE)
w.set_default_size(mw, mh)
w.connect("destroy", Gtk.main_quit)
w.show_all()
Gtk.main()
"""

_DIALOG_SCRIPT = """
import sys, gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib
x, y = int(sys.argv[1]), int(sys.argv[2])
main = Gtk.Window(title="zeta-selftest parent")
main.set_default_size(500, 350)
main.add(Gtk.Label(label="parent"))
main.connect("destroy", Gtk.main_quit)
main.show_all()
d = Gtk.Window(title="zeta-selftest dialog", transient_for=main)
d.set_type_hint(Gdk.WindowTypeHint.DIALOG)
d.set_default_size(400, 260)
d.add(Gtk.Label(label="dialog"))
d.show_all()
def away():
    d.move(x, y)        # a dialog that places itself off screen
    return False
GLib.timeout_add(2000, away)
Gtk.main()
"""

_PLAIN_SCRIPT = """
import sys, gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk
w = Gtk.Window(title=sys.argv[1])
w.add(Gtk.Label(label="zeta-selftest"))
w.set_default_size(500, 350)
w.connect("destroy", Gtk.main_quit)
w.show_all()
Gtk.main()
"""


def _test_window(script, *args):
    env = dict(os.environ, GDK_BACKEND="x11")
    return subprocess.Popen([sys.executable, "-c", script] + [str(a) for a in args], env=env,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _client(title):
    _rc, out, _e = _sh(["hyprctl", "-j", "clients"])
    try:
        return next((c for c in json.loads(out or "[]") if c.get("title") == title), None)
    except ValueError:
        return None


def _handle_reachable(c, bar):
    """The left part of the title bar (close, minimize, maximize) lies
    inside the usable area of one display."""
    x, y = c["at"]
    w, _h = c["size"]
    top = y - bar
    for x0, y0, x1, y1 in _usable_area().values():
        if x >= x0 - 1 and top >= y0 - 1 and x + min(w, 96) <= x1 + 1 and y + (0 if bar else 24) <= y1 + 1:
            return True
    return False


@test("windows")
def windows_exits_on_keyboard():
    """Every way out of a window state is bound in Hyprland (close, minimize,
    maximize, full screen, Windows list, bring back, force quit, emergency
    panel, Super + drag) and the window guard is loaded."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    super_, shift, ctrl, alt = 64, 1, 4, 8
    expected = {
        "close": (super_, "q"), "minimize": (super_, "h"), "maximize": (super_, "m"),
        "fullscreen": (super_, "f"), "windows": (super_, "w"), "recover": (super_ | shift, "w"),
        "force-pick": (ctrl | alt, "escape"), "force-active": (ctrl | shift, "escape"),
        "emergency": (ctrl | alt, "delete"), "drag": (super_, "mouse:272"),
        "resize": (super_, "mouse:273"),
    }
    _rc, out, _e = _sh(["hyprctl", "-j", "binds"])
    try:
        binds = json.loads(out or "[]")
    except ValueError:
        return False, "hyprctl binds"
    found = {}
    for b in binds:
        d = b.get("description") or ""
        if d.startswith("zeta-exit:") and not b.get("submap"):
            found[d.split(":", 1)[1]] = (b.get("modmask"), (b.get("key") or "").lower())
    wrong = []
    for name, (mods, key) in expected.items():
        got = found.get(name)
        if not got or got[0] != mods or (got[1] and got[1] != key):
            wrong.append(name)
    if wrong:
        return False, _missing(wrong)
    _rc, out, _e = _sh(["hyprctl", "eval",
                        "if not zeta_window_guard_ready then error('window guard not loaded') end"])
    if not out.startswith("ok"):
        return False, tr("window guard not loaded: {detail}").format(detail=out[:120])
    return True, ntr("{n} keyboard exit bound", "{n} keyboard exits bound",
                     len(expected)).format(n=len(expected))


@test("windows")
def windows_min_size_larger_than_screen():
    """An X11 window whose minimum size is larger than the screen: title bar
    and buttons within reach, and no endless resize loop."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    from system import windows
    bar = 32 if windows.title_bars_present() else 0
    areas = list(_usable_area().values())
    if not areas:
        return False, tr("no displays from hyprctl")
    width = int(max(a[2] - a[0] for a in areas)) + 300
    height = int(max(a[3] - a[1] for a in areas)) + 200
    proc = _test_window(_MIN_SIZE_SCRIPT, width, height)
    try:
        deadline = time.monotonic() + 15
        c = None
        while time.monotonic() < deadline:
            time.sleep(0.5)
            c = _client("zeta-selftest min size")
            if c and _handle_reachable(c, bar):
                break
        if not c:
            return False, tr("the test window did not appear")
        if not _handle_reachable(c, bar):
            return False, tr("title bar out of reach: {x},{y} {w}x{h}").format(
                x=c["at"][0], y=c["at"][1], w=c["size"][0], h=c["size"][1])
        # it must also stay still: the guard does not chase a size it cannot get
        first = (tuple(c["at"]), tuple(c["size"]))
        time.sleep(4)
        c = _client("zeta-selftest min size")
        if c and (tuple(c["at"]), tuple(c["size"])) != first:
            return False, tr("the window keeps changing: {a} -> {b}").format(
                a=first, b=(tuple(c["at"]), tuple(c["size"])))
        return True, tr("reachable at {x},{y}, {w}x{h}").format(
            x=first[0][0], y=first[0][1], w=first[1][0], h=first[1][1])
    finally:
        proc.kill()


@test("windows")
def windows_dialog_off_screen():
    """An X11 dialog that moves itself beyond every display comes back
    within reach."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    from system import windows
    bar = 32 if windows.title_bars_present() else 0
    areas = list(_usable_area().values())
    if not areas:
        return False, tr("no displays from hyprctl")
    x = int(max(a[2] for a in areas)) + 500
    y = int(max(a[3] for a in areas)) + 400
    proc = _test_window(_DIALOG_SCRIPT, x, y)
    try:
        deadline = time.monotonic() + 15
        seen_outside = False
        while time.monotonic() < deadline:
            time.sleep(0.4)
            c = _client("zeta-selftest dialog")
            if not c:
                continue
            if not _handle_reachable(c, bar):
                seen_outside = True
                continue
            if seen_outside:
                return True, tr("back inside: {x},{y} {w}x{h}").format(
                    x=c["at"][0], y=c["at"][1], w=c["size"][0], h=c["size"][1])
        return False, tr("the window stayed out of reach") if seen_outside else \
            tr("the test window did not move out (nothing to check)")
    finally:
        proc.kill()


@test("windows")
def minimized_found_after_crash():
    """A window hidden in the minimized windows' workspace that the state
    file does not know (zeta-minimize crashed, state file lost) is found
    again, listed, and restored within reach."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    from system import windows
    title = "zeta-selftest hidden"
    proc = _test_window(_PLAIN_SCRIPT, title)
    addr = None
    try:
        deadline = time.monotonic() + 10
        c = None
        while time.monotonic() < deadline and not c:
            time.sleep(0.4)
            c = _client(title)
        if not c:
            return False, tr("the test window did not appear")
        addr = c["address"]
        # hidden without going through zeta-minimize: nothing is recorded
        windows.dispatch('hl.dsp.window.move({ workspace = "%s", follow = false, window = "address:%s" })'
                         % (windows.HIDDEN, addr))
        time.sleep(0.5)
        if addr not in [w["address"] for w in windows.minimized()]:
            return False, tr("the hidden window is not offered again")
        if not windows.restore(addr):
            return False, tr("restore failed")
        time.sleep(1.5)
        c = _client(title)
        if not c or str((c.get("workspace") or {}).get("name", "")).startswith("special:"):
            return False, tr("the window is still hidden")
        bar = 32 if windows.title_bars_present() else 0
        if not _handle_reachable(c, bar):
            return False, tr("title bar out of reach: {x},{y} {w}x{h}").format(
                x=c["at"][0], y=c["at"][1], w=c["size"][0], h=c["size"][1])
        return True, tr("found again and restored")
    finally:
        proc.kill()
        if addr:
            windows.forget(addr)


@test("windows")
def window_memory_loaded():
    """Window memory (3.5): window_memory.lua is loaded in Hyprland, its
    places file is readable, and Settings › Windows & Multitasking exists."""
    if not os.path.isfile("/usr/lib/zeta/hypr/window_memory.lua"):
        return False, _missing(["window_memory.lua"])
    if not os.path.isfile("/usr/lib/zeta/ui/windows_page.py"):
        return False, _missing(["windows_page.py"])
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    _rc, out, _e = _sh(["hyprctl", "eval",
                        "if not zeta_window_memory_ready then error('window memory not loaded') end"])
    if not out.startswith("ok"):
        return False, tr("window memory not loaded: {detail}").format(detail=out[:120])
    return True, tr("window memory loaded")


@test("windows")
def snap_layouts_bound():
    """Snap layouts: Super + Shift + Left/Right/Up/Down and Super + Z are
    bound in Hyprland ("zeta-snap:" descriptions), window_snap.lua is loaded
    and zeta-snap knows the same 16 zone names."""
    rc, out, _e = _sh(["zeta-snap", "list"])
    names = out.split()
    if rc != 0 or len(names) != 16 or "left" not in names or "top-right" not in names:
        return False, "zeta-snap list: %r" % names[:4]
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    super_, shift = 64, 1
    expected = {"left": (super_ | shift, "left"), "right": (super_ | shift, "right"),
                "maximize": (super_ | shift, "up"), "restore": (super_ | shift, "down"),
                "menu": (super_, "z")}
    _rc, out, _e = _sh(["hyprctl", "-j", "binds"])
    try:
        binds = json.loads(out or "[]")
    except ValueError:
        return False, "hyprctl binds"
    found = {}
    for b in binds:
        d = b.get("description") or ""
        if d.startswith("zeta-snap:") and not b.get("submap"):
            found[d.split(":", 1)[1]] = (b.get("modmask"), (b.get("key") or "").lower())
    wrong = [name for name, want in expected.items() if found.get(name) != want]
    if wrong:
        return False, _missing(wrong)
    _rc, out, _e = _sh(["hyprctl", "eval", "if not zeta_snap_ready then error('snap not loaded') end"])
    if not out.startswith("ok"):
        return False, tr("snap layouts not loaded: {detail}").format(detail=out[:120])
    return True, ntr("{n} snap shortcut bound", "{n} snap shortcuts bound",
                     len(expected)).format(n=len(expected))


@test("windows")
def snap_halves_quarters_and_restore():
    """A window snapped to the left half and to the top right quarter fills
    that part of the usable area (title bar included, never under the bar),
    maximize fills the screen, and restore puts it back where it was."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    from system import windows
    bar = 32 if windows.title_bars_present() else 0
    title = "zeta-selftest snap"
    proc = _test_window(_PLAIN_SCRIPT, title)
    gap, tol = 8, 3

    def geometry():
        c = _client(title)
        return (tuple(c["at"]), tuple(c["size"]), c.get("fullscreen", 0), c) if c else None

    try:
        deadline = time.monotonic() + 10
        g = None
        while time.monotonic() < deadline and not g:
            time.sleep(0.4)
            g = geometry()
        if not g:
            return False, tr("the test window did not appear")
        time.sleep(1.6)                  # the guard's checks after opening are done
        before = geometry()
        addr = before[3]["address"]
        area = _usable_area().get(before[3]["monitor"])
        if not area:
            return False, tr("no displays from hyprctl")
        x0, y0, x1, y1 = area
        mid = (x0 + x1) / 2

        def fits(name, left, top, right, bottom):
            if _sh(["zeta-snap", name, addr])[0] != 0:
                return "%s: zeta-snap failed" % name
            time.sleep(0.7)
            (x, y), (w, h), _fs, _c = geometry()
            got = (x, y - bar, x + w, y + h)
            # the bar's reserved space can differ by its margin from the
            # layer the guard measures: the top and bottom are checked loosely
            if (abs(got[0] - left) > tol or abs(got[2] - right) > tol
                    or got[1] < y0 - 1 or abs(got[1] - top) > tol + 12
                    or got[3] > y1 + 1 or abs(got[3] - bottom) > tol + 12):
                return "%s: %d,%d %dx%d" % (name, x, y, w, h)
            return None

        problems = [p for p in (
            fits("left", x0 + gap, y0 + gap, mid - gap / 2, y1 - gap),
            fits("top-right", mid + gap / 2, y0 + gap, x1 - gap, (y0 + y1) / 2 - gap / 2),
        ) if p]
        _sh(["zeta-snap", "restore", addr])
        time.sleep(0.7)
        back = geometry()
        if abs(back[0][0] - before[0][0]) > tol or abs(back[1][0] - before[1][0]) > tol:
            problems.append("restore: %r instead of %r" % (back[:2], before[:2]))
        _sh(["zeta-snap", "maximize", addr])
        time.sleep(0.7)
        if not geometry()[2]:
            problems.append("maximize: not maximized")
        _sh(["zeta-snap", "restore", addr])
        time.sleep(0.7)
        if geometry()[2]:
            problems.append("restore: still maximized")
        if problems:
            return False, "; ".join(problems)
        return True, tr("left half, top right quarter, maximize and restore")
    finally:
        proc.kill()


def _tiny_png(path, w=40, h=30):
    import struct
    import zlib

    def chunk(kind, data):
        return (struct.pack(">I", len(data)) + kind + data
                + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF))
    rows = b"".join(b"\0" + b"\x3a\x8d\xff" * w for _ in range(h))
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
                + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b""))


def _tiny_pdf(path, pages=2):
    kids = " ".join("%d 0 R" % (3 + i) for i in range(pages))
    objs = [b"<< /Type /Catalog /Pages 2 0 R >>",
            ("<< /Type /Pages /Kids [%s] /Count %d >>" % (kids, pages)).encode()]
    objs += [b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 280] >>"] * pages
    out, offsets = b"%PDF-1.4\n", []
    for i, o in enumerate(objs, 1):
        offsets.append(len(out))
        out += b"%d 0 obj\n%s\nendobj\n" % (i, o)
    xref = len(out)
    out += b"xref\n0 %d\n0000000000 65535 f \n" % (len(objs) + 1)
    out += b"".join(b"%010d 00000 n \n" % off for off in offsets)
    out += b"trailer\n<< /Size %d /Root 1 0 R >>\nstartxref\n%d\n%%%%EOF\n" % (len(objs) + 1, xref)
    with open(path, "wb") as f:
        f.write(out)


@test("windows")
def quick_look_recognizes_files():
    """Quick Look (zeta-quicklook --info, no window): a picture, a two-page
    PDF (first page made with pdftoppm), a text file larger than 200 KB
    (cut), a folder (items and size) and an unknown binary file."""
    import shutil
    import tempfile
    d = tempfile.mkdtemp(prefix="zeta-selftest-ql-")
    try:
        _tiny_png(os.path.join(d, "picture.png"))
        _tiny_pdf(os.path.join(d, "document.pdf"))
        with open(os.path.join(d, "notes.txt"), "w") as f:
            f.write("zeta selftest\n" * 20000)
        os.makedirs(os.path.join(d, "folder", "inside"))
        with open(os.path.join(d, "folder", "inside", "a.bin"), "wb") as f:
            f.write(b"\0\1\2" * 1000)
        cases = [("picture.png", {"kind": "image", "preview": True, "width": 40}),
                 ("document.pdf", {"kind": "pdf", "preview": True, "pages": 2}),
                 ("notes.txt", {"kind": "text", "truncated": True}),
                 ("folder", {"kind": "folder", "items": 1, "files": 1, "total": 3000}),
                 ("folder/inside/a.bin", {"kind": "other"})]
        wrong = []
        for name, want in cases:
            rc, out, err = _sh(["zeta-quicklook", "--info", os.path.join(d, name)], timeout=30)
            try:
                got = json.loads(out)
            except ValueError:
                wrong.append("%s: %s" % (name, (err or out)[:80]))
                continue
            bad = {k: got.get(k) for k, v in want.items() if got.get(k) != v}
            if rc != 0 or bad:
                wrong.append("%s: %r" % (name, bad))
        if wrong:
            return False, "; ".join(wrong)
        return True, _cases_passed(len(cases))
    finally:
        shutil.rmtree(d, ignore_errors=True)


@test("windows")
def quick_look_in_files_and_desktop():
    """The file manager has the Quick Look action on Space (uca.xml and
    accels.scm of this user) and Quick Look opens a window."""
    cfg = os.path.expanduser("~/.config/Thunar")
    try:
        uca = open(os.path.join(cfg, "uca.xml"), encoding="utf-8").read()
        accels = open(os.path.join(cfg, "accels.scm"), encoding="utf-8").read()
    except OSError as e:
        return False, str(e)
    if "<unique-id>zeta-quicklook</unique-id>" not in uca:
        return False, tr("Quick Look action missing in the file manager")
    if '(gtk_accel_path "<Actions>/ThunarActions/uca-action-zeta-quicklook" "space")' not in accels:
        return False, tr("Space is not bound to Quick Look in the file manager")
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    import shutil
    import tempfile
    path = os.path.join(tempfile.mkdtemp(prefix="zeta-selftest-ql-"), "zeta-selftest.txt")
    with open(path, "w") as f:
        f.write("zeta-selftest\n")
    start = time.monotonic()
    proc = subprocess.Popen(["zeta-quicklook", path], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL)
    c = None
    try:
        while time.monotonic() - start < 10 and not c:
            time.sleep(0.1)
            c = _client("zeta-selftest.txt")
        if not c:
            return False, tr("the Quick Look window did not appear")
        ms = int((time.monotonic() - start) * 1000)
        if c.get("class") != "org.zetarays.QuickLook":
            return False, "class %s" % c.get("class")
        return True, tr("window in {ms} ms").format(ms=ms)
    finally:
        if c:
            _sh(["hyprctl", "dispatch", 'hl.dsp.window.close({ window = "address:%s" })' % c["address"]])
        try:
            proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            proc.terminate()
        shutil.rmtree(os.path.dirname(path), ignore_errors=True)


@test("settings")
def displays_read_and_settings_valid():
    """Settings › Displays: displays are read from Hyprland with their modes;
    the scales offered are only the accepted and usable ones; a configuration
    with all displays off is rejected."""
    from system import displays
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    v = displays.read()
    if not v:
        return False, tr("no displays from hyprctl")
    m = v[0]
    if not m["modes"] or displays.native_resolution(m) is None:
        return False, tr("{name}: no modes").format(name=m["name"])
    if displays.valid_scales(1280, 800) != [1.0, 1.25] or 1.5 in displays.valid_scales(1280, 800):
        return False, "scale 1280x800: %r" % displays.valid_scales(1280, 800)
    conf = displays.configuration(v)
    for c in conf.values():
        c["enabled"] = False
    if displays.check(conf) is None:
        return False, tr("all displays off was accepted")
    return True, ntr("{n} display, {modes} modes on the first",
                     "{n} displays, {modes} modes on the first", len(v)).format(n=len(v), modes=len(m["modes"]))


@test("settings")
def avatar_in_system_colors():
    """The account picture: a solid circle in one of the 5 accent colors
    (a single palette, the same as the «make it red» commands), no
    symbols; a color outside the palette is rejected."""
    from ui import accent
    from system import avatar
    from intelligence import intents
    colors = [c for _k, c, _n in accent.PALETTE]
    if colors != ["#3A8DFF", "#C8102E", "#4CC94A", "#7C3AED", "#FFFFFF"]:
        return False, "%r" % colors
    for word, k in _phrases("avatar_in_system_colors")["colors"].items():
        if intents._COLORS[word] != accent.color_of(k):
            return False, "%s: %s" % (word, intents._COLORS[word])
    ok, _msg = avatar.set_color("#123456")
    if ok:
        return False, tr("a color outside the palette was accepted")
    if os.path.isdir("/usr/share/zeta/avatar"):
        return False, tr("old symbol pictures still installed")
    return True, tr("5 colors, one palette, current choice: {c}").format(c=avatar.choice())


@test("settings")
def black_lock_screen():
    """The lock screen (hyprlock) is solid black with no wallpaper or logo, on
    every display; suspend waits until the lock is on screen."""
    conf = os.path.expanduser("~/.config/hypr/hyprlock.conf")
    if not os.path.isfile(conf):
        conf = "/etc/skel/.config/hypr/hyprlock.conf"
    text = open(conf).read()
    background = text.split("background {", 1)[1].split("}", 1)[0] if "background {" in text else ""
    lines = [r.strip() for r in background.splitlines() if r.strip() and not r.strip().startswith("#")]
    if any(r.startswith("path") for r in lines) or "color = rgb(000000)" not in lines:
        return False, tr("lock background: {lines}").format(lines="; ".join(lines))
    idle = os.path.expanduser("~/.config/hypr/hypridle.conf")
    if not os.path.isfile(idle):
        idle = "/etc/skel/.config/hypr/hypridle.conf"
    if "inhibit_sleep = 3" not in open(idle).read():
        return False, tr("sleep does not wait for the lock ({file})").format(file=idle)
    return True, tr("plain black, sleep waits for the lock")


@test("settings")
def editor_without_double_theme():
    """The text editor always follows the desktop theme: a white or black
    background only changes the text scheme (zeta-paper, zeta-night)."""
    for n in ("zeta-paper", "zeta-night"):
        if not os.path.isfile("/usr/share/gtksourceview-5/styles/%s.xml" % n):
            return False, _missing([n])
    rc, var, _e = _sh(["gsettings", "get", "org.gnome.TextEditor", "style-variant"])
    rc2, sch, _e = _sh(["gsettings", "get", "org.gnome.TextEditor", "style-scheme"])
    if rc == 0 and var.strip("'") != "follow":
        return False, "style-variant %s" % var
    return True, "style-variant %s, style-scheme %s" % (var, sch)



@test("settings")
def folder_colors_persist_and_reset():
    """Folder Color: a color is stored as GIO metadata (name with spaces and
    symbols), shown by the file manager as an emblem, leaves the folder's
    dates untouched, and Default removes it."""
    import tempfile
    from system import folder_colors
    base = tempfile.mkdtemp(prefix="zeta-tests-", dir=os.path.expanduser("~"))
    folder = os.path.join(base, "Folder \u00e8 & #1")       # a non-ASCII letter
    os.mkdir(folder)
    try:
        before = os.stat(folder).st_mtime_ns
        ok, err = folder_colors.set_color(folder, "purple")
        if not ok or folder_colors.get(folder) != "purple":
            return False, err or "color not stored"
        rc, out, _e = _sh(["gio", "info", "-a", "metadata::emblems", folder])
        if "emblem-zeta-folder-purple" not in out:
            return False, "no emblem: %s" % out[-120:]
        if os.stat(folder).st_mtime_ns != before:
            return False, "folder date changed"
        ok, err = folder_colors.set_color(folder, "orange")
        if ok:
            return False, "an unknown color was accepted"
        folder_colors.set_color(folder, None)
        if folder_colors.get(folder) is not None:
            return False, "Default did not reset the color"
        if not all(folder_colors.icon_path(k) for k in folder_colors.COLORS):
            return False, "missing folder artwork"
        return True, "%d colors, stored, emblem, reset" % len(folder_colors.COLORS)
    finally:
        import shutil
        shutil.rmtree(base, ignore_errors=True)


@test("system")
def monitor_service_states_are_honest():
    """ZETA RAYS Monitor: a failed periodic job is a warning, a failed daemon
    an error, a service skipped by its condition is not applicable; the
    security scan does not fail for lack of a mail server."""
    from monitor.collectors import classify_service
    cases = {
        "WARNING": {"ActiveState": "failed", "SubState": "failed", "TriggeredBy": "chkrootkit.timer"},
        "FAILED": {"ActiveState": "failed", "SubState": "failed", "TriggeredBy": ""},
        "NOT_APPLICABLE": {"ActiveState": "inactive", "SubState": "dead", "ConditionResult": "no",
                           "ConditionTimestampMonotonic": "1234"},
        "STOPPED": {"ActiveState": "inactive", "SubState": "dead", "ConditionResult": "no",
                    "ConditionTimestampMonotonic": "0"},
        "RUNNING": {"ActiveState": "active", "SubState": "running"},
        "DONE": {"ActiveState": "active", "SubState": "exited"},
    }
    for expected, props in cases.items():
        got = classify_service(props)
        if got != expected:
            return False, "%s -> %s" % (expected, got)
    try:
        conf = open("/etc/chkrootkit/chkrootkit.conf").read()
    except OSError:
        conf = 'MAILTO=""'
    if 'MAILTO=""' not in conf:
        return False, "chkrootkit mails reports to a missing mail server"
    return True, "%d states classified, chkrootkit reports to the journal" % len(cases)


@test("system")
def monitor_service_verdicts_are_calm():
    """ZETA RAYS Monitor: synthetic `systemctl show` properties and log lines
    must get the right level (normal, info, warning, error): a healthy or
    recovered service shows nothing, a scheduled job that failed once is a
    warning with its next run, a missing device with log evidence is
    information, a real failure (or a device message without evidence) an error."""
    from monitor import unitstate as U
    now = 1792222910.0

    def failed(**kw):
        p = {"Id": "t.service", "Description": "Test", "LoadState": "loaded", "ActiveState": "failed",
             "SubState": "failed", "Result": "exit-code", "ExecMainStatus": "1", "ExecMainCode": "1",
             "InactiveEnterTimestamp": "@%d" % (now - 60), "ActiveEnterTimestamp": "", "TriggeredBy": "",
             "Type": "simple", "UnitFileState": "enabled", "CanStart": "yes", "RefuseManualStart": "no"}
        p.update(kw)
        return p
    backlight = "systemd-backlight@backlight:acpi_video0.service"
    once = ["chkrootkit.service: Failed with result 'exit-code'."]
    cases = [  # (name, props, journal, history, next runs, network up, level, kind)
        ("healthy", {"Id": "cups.service", "ActiveState": "active", "SubState": "running"}, [], [], {}, None,
         "normal", "ok"),
        ("timer job failed once", failed(Id="chkrootkit.service", Type="oneshot", TriggeredBy="chkrootkit.timer",
                                         ExecMainStatus="127"), ["mail: not found"], once,
         {"chkrootkit.timer": now + 3600}, None, "warning", "periodic"),
        ("timer job keeps failing", failed(TriggeredBy="t.timer"), [], once * 3, {"t.timer": now + 60}, None,
         "error", "periodic-repeated"),
        ("timer job not scheduled again", failed(TriggeredBy="t.timer"), [], once, {"t.timer": 0}, None,
         "error", "periodic-unscheduled"),
        ("stale: recovered", failed(ActiveState="inactive", SubState="dead", Result="success"), [], [], {}, None,
         "normal", "ok"),
        ("stale: active after the failure", failed(ActiveEnterTimestamp="@%d" % now), [], [], {}, None,
         "normal", "stale"),
        ("stale: later run succeeded", failed(), [], once + ["t.service: Deactivated successfully."], {}, None,
         "normal", "stale"),
        ("hardware absent", failed(Id=backlight, Type="oneshot"),
         ["Failed to get backlight or LED device 'backlight:acpi_video0': No such device"], [], {}, None,
         "info", "hardware"),
        ("hardware unit without evidence", failed(Id=backlight, Type="oneshot"), ["Permission denied"], [], {},
         None, "error", "failed"),
        ("evidence in another unit", failed(Id="cups.service"), ["No such device"], [], {}, None,
         "error", "failed"),
        ("network late", failed(Id="NetworkManager-wait-online.service", Type="oneshot"), [], [], {}, True,
         "info", "network-late"),
        ("real failure", failed(Id="cups.service", ExecMainStatus="3"), ["error: config missing"], [], {}, None,
         "error", "failed"),
    ]
    for name, props, journal, history, next_runs, net, level, kind in cases:
        v = U.assess(props, journal, history, next_runs, net, now)
        if (v["level"], v["kind"]) != (level, kind):
            return False, "%s: %s/%s instead of %s/%s" % (name, v["level"], v["kind"], level, kind)
        if v["level"] == "warning" and not v["next_run"]:
            return False, "%s: no next run" % name
        if v["level"] == "error" and "dismiss" not in v["actions"]:
            return False, "%s: cannot be dismissed" % name
    if U.assess(failed(ExecMainStatus="127"), now=now)["explanation"] != tr("A program it needs is missing."):
        return False, "exit 127 not explained"
    if U.valid_unit("-H.service") or U.valid_unit("../x.service") or not U.valid_unit(backlight):
        return False, "unit name validation"
    return True, "%d cases, 4 levels" % len(cases)


# ---------------------------------------------------------------- controlcenter
def _wlsunset_temperature(argv, env, when):
    """The temperature wlsunset 0.3.0 shows at `when` (epoch) in manual mode
    (-S/-s/-d), computed as its main.c does, with its own TZ."""
    def opt(flag):
        return argv[argv.index(flag) + 1]

    def secs(hhmm):
        return int(hhmm[:2]) * 3600 + int(hhmm[3:]) * 60
    low, high, ramp = int(opt("-t")), int(opt("-T")), int(opt("-d"))
    old = os.environ.get("TZ")
    try:
        if "TZ" in env:
            os.environ["TZ"] = env["TZ"]
            time.tzset()
        offset = -time.localtime(when).tm_gmtoff
    finally:
        if old is None:
            os.environ.pop("TZ", None)
        else:
            os.environ["TZ"] = old
        time.tzset()
    day = when - ((when - offset) % 86400)
    sunrise, sunset = secs(opt("-S")) + day, secs(opt("-s")) + day
    if when < sunrise - ramp or when >= sunset + ramp:
        return low
    if sunrise <= when < sunset:
        return high
    return None                       # inside a gradual change


@test("controlcenter")
def night_light_schedule():
    """Night Light: settings are checked, the position comes from the time
    zone (never from the Internet), sunrise and sunset are plausible, and a
    custom period inside one day (00:30 to 06:00) becomes a wlsunset command
    that is warm exactly then."""
    import tempfile
    from system import night_light as nl
    saved = nl.CONFIG
    with tempfile.TemporaryDirectory() as tmp:
        nl.CONFIG = os.path.join(tmp, "night-light.json")
        try:
            conf = nl.update(enabled=True, schedule="custom", temperature=3500,
                             **{"from": "00:30", "to": "06:00"})
            for bad in ({"from": "25:00"}, {"schedule": "never"}, {"from": "06:00"}):
                try:
                    nl.update(**bad)
                    return False, "accepted %r" % (bad,)
                except ValueError:
                    pass
            if nl.update(temperature=99999)["temperature"] != nl.T_MAX:
                return False, "temperature not limited"
            conf = nl.update(temperature=3500)
            argv, env = nl.command(conf)
            base = time.mktime(time.localtime()[:3] + (0, 0, 0, 0, 0, -1))
            wrong = []
            for hour, want in ((3, 3500), (12, 6500), (23, 6500), (6.5, 6500), (0.1, 6500)):
                got = _wlsunset_temperature(argv, env, int(base + hour * 3600))
                if got != want:
                    wrong.append("%s h: %s K" % (hour, got))
            if wrong:
                return False, "custom 00:30-06:00: " + ", ".join(wrong)
            argv, env = nl.command(nl.update(**{"from": "21:00", "to": "07:00"}))
            if "TZ" in env or argv[argv.index("-S") + 1] != "07:00":
                return False, " ".join(argv)
        finally:
            nl.CONFIG = saved
    june = time.strptime("2026-06-21 12:00", "%Y-%m-%d %H:%M")
    rise, set_ = nl.sun_times(41.9, 12.48, june, utc_offset_minutes=120)
    if not (5 * 60 + 15 <= rise <= 5 * 60 + 55 and 20 * 60 + 30 <= set_ <= 21 * 60 + 5):
        return False, "Rome, June 21: %s-%s" % (nl.hhmm(rise), nl.hhmm(set_))
    zone = nl.timezone_name()
    loc = nl.location({"schedule": "sunset"})
    if zone and not zone.startswith("Etc/") and zone != "UTC" and loc is None:
        return False, tr("no position for the time zone {zone}").format(zone=zone)
    return True, "%s → %s" % (zone, ("%.1f, %.1f" % loc) if loc else "-")


@test("controlcenter")
def night_light_process():
    """One wlsunset when Night Light is on, none when it is off (no polling
    script, no duplicates)."""
    import shutil
    if not shutil.which("wlsunset"):
        return False, _missing(["wlsunset"])
    if not os.environ.get("WAYLAND_DISPLAY"):
        return True, _outside_session()
    from system import night_light as nl
    st = nl.status()
    _c, out, _e = _sh(["pgrep", "-c", "-x", "-u", str(os.getuid()), "wlsunset"])
    count = int(out or 0)
    want = 1 if st["enabled"] else 0
    return count == want, "enabled=%s, wlsunset ×%d" % (st["enabled"], count)


@test("controlcenter")
def night_light_on_off():
    """zeta-night-light on/preview/off really starts and ends wlsunset; the
    previous settings are put back."""
    if not os.environ.get("WAYLAND_DISPLAY"):
        return True, _outside_session()
    from system import night_light as nl
    try:
        before = open(nl.CONFIG).read()
    except OSError:
        before = None

    def count():
        _c, o, _e = _sh(["pgrep", "-c", "-x", "-u", str(os.getuid()), "wlsunset"])
        return int(o or 0)
    try:
        rc, out, _e = _sh(["zeta-night-light", "on"])
        time.sleep(1.0)
        on_count = count()
        try:
            st = json.loads(out or "{}")
        except ValueError:
            st = {}
        _sh(["zeta-night-light", "preview", "3000"])
        time.sleep(0.5)
        preview_count = count()
        _sh(["zeta-night-light", "off"])
        off_count = count()
    finally:
        if before is None:
            try:
                os.remove(nl.CONFIG)
            except OSError:
                pass
        else:
            with open(nl.CONFIG, "w") as f:
                f.write(before)
        _sh(["zeta-night-light", "apply"])
    detail = "on ×%d, preview ×%d, off ×%d" % (on_count, preview_count, off_count)
    if rc == 0 and st.get("enabled") and on_count == 1 == preview_count and off_count == 0:
        return True, detail
    c, virt, _e = _sh(["systemd-detect-virt"])
    if on_count == 0 and c == 0 and virt not in ("", "none"):
        # wlsunset ends at once when no display offers gamma control
        return True, tr("skipped: the virtual display has no gamma control ({virt})").format(virt=virt)
    return False, detail


@test("controlcenter")
def power_modes():
    """power-profiles-daemon answers, offers Balanced, and switching mode
    works for the user (then the previous mode is put back)."""
    from system import power
    if not os.path.exists("/usr/libexec/power-profiles-daemon"):
        return False, _missing(["power-profiles-daemon"])
    p = power.power_profiles()
    if p is None:
        return False, tr("the power mode service does not answer")
    if "balanced" not in p["available"]:
        return False, ", ".join(p["available"])
    others = [x for x in p["available"] if x != p["active"]]
    if not others:
        return True, p["active"]
    start = p["active"]
    try:
        if not power.set_power_profile(others[0]):
            return False, "set %s refused" % others[0]
        time.sleep(0.5)
        now = (power.power_profiles() or {}).get("active")
    finally:
        power.set_power_profile(start)
    return now == others[0], "%s → %s → %s (%s)" % (start, others[0], start, ", ".join(p["available"]))


@test("controlcenter")
def idle_times_and_suspend():
    """Screen off / lock / suspend times reach hypridle.conf quickly (only the
    idle file is rewritten, not the whole theme) and invalid values are refused."""
    import tempfile
    with tempfile.TemporaryDirectory() as home:
        env = {k: v for k, v in os.environ.items() if k != "HYPRLAND_INSTANCE_SIGNATURE"}
        env["HOME"] = home
        start = time.monotonic()
        codes = []
        for key, value in (("auto-suspend", "30"), ("screen-off", "0"), ("auto-lock", "5")):
            r = subprocess.run(["zeta-appearance", "set", key, value], env=env,
                               capture_output=True, text=True, timeout=30)
            codes.append(r.returncode)
        elapsed = time.monotonic() - start
        bad = subprocess.run(["zeta-appearance", "set", "auto-suspend", "999"], env=env,
                             capture_output=True, text=True, timeout=30).returncode
        try:
            conf = open(os.path.join(home, ".config/hypr/hypridle.conf")).read()
        except OSError as e:
            return False, str(e)
    wrong = []
    if codes != [0, 0, 0] or bad == 0:
        wrong.append("exit codes %s / %d" % (codes, bad))
    if "timeout = 1800" not in conf or "systemctl suspend" not in conf:
        wrong.append("no suspend listener")
    if "timeout = 300" not in conf or "dpms" in conf:
        wrong.append("lock/screen-off listeners")
    if elapsed > 6:
        wrong.append("%.1f s" % elapsed)
    return not wrong, "; ".join(wrong) or "%.1f s" % elapsed


@test("controlcenter")
def power_button_helper():
    """The power button setting goes only through the polkit helper, which
    refuses anything but its four actions."""
    from system import power
    helper = power.POWER_BUTTON_HELPER
    policy = "/usr/share/polkit-1/actions/org.zetarays.power-button.policy"
    missing = [p for p in (helper, policy) if not os.path.exists(p)]
    if missing:
        return False, _missing(missing)
    rc, _o, _e = _sh([helper, "reboot"])
    rc2, _o, _e = _sh([helper, "poweroff", "extra"])
    if rc != 2 or rc2 != 2:
        return False, "invalid arguments accepted (%d, %d)" % (rc, rc2)
    rc, _o, _e = _sh(["pkaction", "--action-id", "org.zetarays.power-button"])
    if rc != 0:
        return False, "polkit action not registered"
    return True, "HandlePowerKey=%s" % power.power_button_action()


@test("controlcenter")
def quick_toggle_sources():
    """The Control Center's quick toggles read their state from commands
    that answer in JSON; the missing ones are hidden, never broken."""
    import shutil
    icons = "/usr/share/icons/zeta/scalable/apps"
    names = ["zeta-night-light", "zeta-power-mode", "zeta-screenshot", "zeta-record",
             "zeta-clipboard"]
    missing = [n for n in names if not os.path.isfile(os.path.join(icons, n + ".svg"))]
    if missing:
        return False, _missing(missing)
    rc, out, _e = _sh(["zeta-night-light", "status"])
    try:
        st = json.loads(out)
        if not {"enabled", "active", "schedule", "temperature"} <= set(st):
            return False, out
    except ValueError:
        return False, out or "zeta-night-light status"
    seen = ["zeta-night-light"]
    for cmd, key in (("zeta-dnd", "dnd"), ("zeta-screenshot", "recording")):
        if not shutil.which(cmd):
            continue
        rc, out, _e = _sh([cmd, "status"])
        try:
            if not isinstance(json.loads(out).get(key), bool):
                return False, "%s status: %s" % (cmd, out)
        except (ValueError, AttributeError):
            return False, "%s status: %s" % (cmd, out)
        seen.append(cmd)
    return True, ", ".join(seen)


_PANELS_SCRIPT = r'''
import importlib.machinery, importlib.util, json, os, sys, time
os.environ["ZETA_LAYER_PRELOADED"] = "1"         # no re-exec with LD_PRELOAD
sys.path.insert(0, "/usr/lib/zeta")
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio
out = {}


def ms(t):
    return round((time.perf_counter() - t) * 1000)


def activate(app):
    t = time.perf_counter()
    from ui.power_page import PowerPage
    PowerPage()
    out["power_page_ms"] = ms(t)
    t = time.perf_counter()
    from ui.displays_page import DisplaysPage
    DisplaysPage()
    out["displays_page_ms"] = ms(t)
    loader = importlib.machinery.SourceFileLoader("zeta_cc", "/usr/local/bin/zeta-control-center")
    cc = importlib.util.module_from_spec(importlib.util.spec_from_loader("zeta_cc", loader))
    t = time.perf_counter()
    loader.exec_module(cc)
    out["control_import_ms"] = ms(t)
    t = time.perf_counter()
    win = cc.Control(app, "control")
    out["control_build_ms"] = ms(t)
    t = time.perf_counter()
    win._gather_quick(win._round)
    out["quick_state_ms"] = ms(t)
    win.destroy()
    print(json.dumps(out))
    app.quit()


app = Adw.Application(application_id="org.zetarays.SelftestPanels",
                      flags=Gio.ApplicationFlags.NON_UNIQUE)
app.connect("activate", activate)
app.run([])
'''


@test("controlcenter")
def panels_build():
    """Settings › Power & Battery, Settings › Displays (with Night Light) and
    the Control Center build without errors; the times are shown."""
    if not os.environ.get("WAYLAND_DISPLAY"):
        return True, _outside_session()
    try:
        r = subprocess.run([sys.executable, "-c", _PANELS_SCRIPT], capture_output=True,
                           text=True, timeout=60)
    except subprocess.TimeoutExpired:
        return False, "timeout"
    last = (r.stdout.strip().splitlines() or [""])[-1]
    try:
        data = json.loads(last)
    except ValueError:
        return False, (r.stderr.strip().splitlines() or ["exit %d" % r.returncode])[-1]
    return True, ", ".join("%s %s" % (k[:-3], v) for k, v in data.items()) + " ms"


# ------------------------------------- clipboard history, emoji, Do Not Disturb

_CLIP_STORE = "/usr/libexec/zeta-clipboard-store"
# wl-paste stand-in for the test: lists the types given in FAKE_TYPES (the
# real cliphist and the real store script run; the user's clipboard and
# history are never touched)
_FAKE_WL_PASTE = r'''#!/bin/sh
case "$1" in
    --list-types) printf '%s\n' "$FAKE_TYPES" | tr ',' '\n' ;;
    *) printf 'zeta-image' ;;
esac
'''


@test("clipboard")
def clipboard_tools_present():
    """cliphist, wl-clipboard, wtype and mako are installed; the store script,
    the panel and the emoji list are there."""
    import shutil
    missing = [c for c in ("cliphist", "wl-paste", "wl-copy", "wtype", "makoctl", "zeta-clipboard",
                           "zeta-emoji", "zeta-dnd") if not shutil.which(c)]
    if not os.access(_CLIP_STORE, os.X_OK):
        missing.append(_CLIP_STORE)
    if missing:
        return False, _missing(missing)
    from ui import emoji_view
    items = emoji_view.load_emoji()
    groups_found = {g for _e, _n, g in items}
    if len(items) < 1800 or groups_found != set(emoji_view.GROUPS):
        return False, "emoji.json: %d emoji, groups %s" % (len(items), sorted(groups_found))
    first = emoji_view.search(items, "thumbs up")
    if not first or items[first[0]][0] != "\U0001F44D":
        return False, "emoji search"
    return True, "%d emoji" % len(items)


@test("clipboard")
def clipboard_shortcuts():
    """Super+V = clipboard history, Super+period = emoji, Super+Shift+V =
    floating/tiled window (moved from Super+V)."""
    cfg = os.path.expanduser("~/.config/hypr/hyprland.lua")
    try:
        text = open(cfg).read()
    except OSError:
        return True, tr("skipped (no Hyprland configuration)")
    want = {'" + V"': "zeta-panel clipboard", '" + period"': "zeta-panel emoji",
            '" + SHIFT + V"': "float"}
    wrong = []
    for key, action in want.items():
        line = next((ln for ln in text.splitlines() if "hl.bind(" in ln and key in ln), "")
        if action not in line:
            wrong.append(key.strip('" +'))
    return not wrong, (tr("missing shortcuts: {names}").format(names=", ".join(wrong))
                       if wrong else "Super+V, Super+., Super+Shift+V")


@test("clipboard")
def clipboard_store_skips_passwords():
    """The history saves what is copied, never passwords (password manager
    hint, CLIPBOARD_STATE=sensitive), nothing while it is off, does not lose
    an entry when a password manager empties the clipboard, keeps 100 entries."""
    import shutil
    import tempfile
    if not shutil.which("cliphist") or not os.access(_CLIP_STORE, os.X_OK):
        return False, _missing(["cliphist", _CLIP_STORE])
    with tempfile.TemporaryDirectory() as tmp:
        stub = os.path.join(tmp, "wl-paste")
        with open(stub, "w") as f:
            f.write(_FAKE_WL_PASTE)
        os.chmod(stub, 0o755)
        env = dict(os.environ, HOME=tmp, XDG_CACHE_HOME=os.path.join(tmp, "cache"),
                   PATH=tmp + ":" + os.environ.get("PATH", "/usr/bin:/bin"))
        env.pop("CLIPBOARD_STATE", None)

        def put(text, types="text/plain;charset=utf-8,text/plain", state=None):
            e = dict(env, FAKE_TYPES=types)
            if state:
                e["CLIPBOARD_STATE"] = state
            subprocess.run([_CLIP_STORE], input=text.encode(), env=e, capture_output=True, timeout=10)

        def listed():
            return subprocess.run(["cliphist", "list"], env=env, capture_output=True,
                                  text=True, timeout=10).stdout

        put("zeta-plain")
        put("zeta-secret-1", "text/plain;charset=utf-8,x-kde-passwordManagerHint")
        put("zeta-secret-2", state="sensitive")
        put("", "", state="clear")
        put("zeta-picture", "text/html,image/png")
        os.makedirs(os.path.join(tmp, ".config", "zeta"))
        with open(os.path.join(tmp, ".config", "zeta", "clipboard-history"), "w") as f:
            f.write("0")
        put("zeta-while-off")
        os.remove(os.path.join(tmp, ".config", "zeta", "clipboard-history"))
        out = listed()
        if "zeta-plain" not in out:
            return False, "plain text not saved"
        if "zeta-secret" in out:
            return False, "a password was saved"
        if "zeta-while-off" in out:
            return False, "saved while off"
        if "zeta-image" not in out:
            return False, "image offer not saved as the image"
        for i in range(105):
            put("zeta-item %d" % i)
        n = len(listed().splitlines())
        if n != 100:
            return False, "%d entries instead of 100" % n
    return True, "100 entries, passwords skipped"


@test("clipboard")
def clipboard_on_off_command():
    """zeta-clipboard status/disable/enable (used by Settings), on a
    temporary home: disable also clears the history."""
    import tempfile
    with tempfile.TemporaryDirectory() as tmp:
        env = dict(os.environ, HOME=tmp, XDG_CACHE_HOME=os.path.join(tmp, "cache"))

        def status():
            r = subprocess.run(["zeta-clipboard", "status"], env=env, capture_output=True,
                               text=True, timeout=15)
            return json.loads(r.stdout or "{}")
        try:
            first = status()
            subprocess.run(["zeta-clipboard", "disable"], env=env, timeout=15)
            off = status()
            subprocess.run(["zeta-clipboard", "enable"], env=env, timeout=15)
            on = status()
        except (OSError, subprocess.SubprocessError, ValueError) as e:
            return False, str(e)
    if first.get("enabled") is not True or off.get("enabled") is not False or on.get("enabled") is not True:
        return False, "%s / %s / %s" % (first, off, on)
    return True, "on, off, on"


def _clipboard_resident():
    """The resident panel owns its D-Bus name (its process is named python3:
    it re-executes itself to load gtk4-layer-shell, so pgrep cannot find it)."""
    out = _sh(["gdbus", "call", "--session", "--timeout", "5", "--dest", "org.freedesktop.DBus",
               "--object-path", "/org/freedesktop/DBus", "--method",
               "org.freedesktop.DBus.NameHasOwner", "org.zetarays.Clipboard"])[1]
    return "true" in out


@test("clipboard")
def clipboard_watcher_running():
    """In the session: the watcher (wl-paste --watch with the store script) and
    the resident panel are running."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    rc, out, _ = _sh(["pgrep", "-x", "-u", str(os.getuid()), "wl-paste"])
    watching = False
    for pid in out.split():
        try:
            with open("/proc/%s/cmdline" % pid, "rb") as f:
                watching = watching or _CLIP_STORE.encode() in f.read()
        except OSError:
            pass
    resident = _clipboard_resident()
    missing = [n for n, ok in (("wl-paste --watch", watching), ("zeta-clipboard", resident)) if not ok]
    return not missing, _missing(missing) if missing else tr("both ready")


@test("clipboard")
def dnd_command():
    """zeta-dnd status answers {"dnd": ...}, toggle switches it and it is put
    back; mako's configuration keeps critical notifications visible and a
    history of 50."""
    rc, out, _ = _sh(["zeta-dnd", "status"])
    try:
        before = json.loads(out)["dnd"]
    except (ValueError, KeyError, TypeError):
        return False, "status: %r" % out
    if _sh(["pgrep", "-x", "-u", str(os.getuid()), "mako"])[0] == 0:
        _sh(["zeta-dnd", "toggle"])
        try:
            flipped = json.loads(_sh(["zeta-dnd", "status"])[1])["dnd"]
        except (ValueError, KeyError, TypeError):
            flipped = before
        _sh(["zeta-dnd", "on" if before else "off"])
        try:
            back = json.loads(_sh(["zeta-dnd", "status"])[1])["dnd"]
        except (ValueError, KeyError, TypeError):
            back = None
        if flipped == before or back != before:
            return False, "toggle %s -> %s -> %s" % (before, flipped, back)
    try:
        conf = open(os.path.expanduser("~/.config/mako/config")).read()
    except OSError:
        conf = ""
    if conf and ("[mode=do-not-disturb urgency=critical]" not in conf or "max-history" not in conf):
        return False, "mako config: critical notifications or history missing"
    return True, "dnd %s" % ("on" if before else "off")


_QUICK_BUILD_SCRIPT = r'''
import importlib.machinery, importlib.util, json, os, sys, time
os.environ["ZETA_LAYER_PRELOADED"] = "1"      # no re-exec: only the build is timed
sys.argv = ["zeta-clipboard"]
t = time.perf_counter()
loader = importlib.machinery.SourceFileLoader("zeta_clip", "/usr/local/bin/zeta-clipboard")
mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("zeta_clip", loader))
loader.exec_module(mod)
out = {"import_ms": round((time.perf_counter() - t) * 1000)}
from gi.repository import Gio, Gtk


def activate(app):
    t = time.perf_counter()
    win = mod.QuickWindow(app)
    out["build_ms"] = round((time.perf_counter() - t) * 1000)
    for view in ("clipboard", "emoji", "notifications"):
        t = time.perf_counter()
        win.set_view(view)
        out[view + "_ms"] = round((time.perf_counter() - t) * 1000)
    win.destroy()
    print(json.dumps(out))
    app.quit()


app = Gtk.Application(application_id="org.zetarays.SelftestClipboard",
                      flags=Gio.ApplicationFlags.NON_UNIQUE)
app.connect("activate", activate)
app.run([])
'''


@test("clipboard")
def quick_panels_build():
    """The clipboard/emoji/notifications panel builds without errors (cold
    start: import and build times, then the preparation of each view)."""
    if not os.environ.get("WAYLAND_DISPLAY"):
        return True, _outside_session()
    import glob
    env = dict(os.environ)
    libs = glob.glob("/usr/lib/*/libgtk4-layer-shell.so.0")
    if libs:                 # loaded before libwayland, as the real panel does
        env["LD_PRELOAD"] = libs[0]
    try:
        r = subprocess.run([sys.executable, "-c", _QUICK_BUILD_SCRIPT], capture_output=True,
                           text=True, timeout=60, env=env)
    except subprocess.TimeoutExpired:
        return False, "timeout"
    last = (r.stdout.strip().splitlines() or [""])[-1]
    try:
        data = json.loads(last)
    except ValueError:
        return False, (r.stderr.strip().splitlines() or ["exit %d" % r.returncode])[-1]
    return True, ", ".join("%s %s" % (k[:-3], v) for k, v in data.items()) + " ms"


def _layer_open(namespace, timeout=3.0):
    """Wait until a layer surface with this namespace is on screen: the
    time.monotonic() when it appeared, or None."""
    t0 = time.monotonic()
    while time.monotonic() - t0 < timeout:
        out = _sh(["hyprctl", "-j", "layers"], timeout=3)[1]
        if '"%s"' % namespace in out:
            return time.monotonic()
        time.sleep(0.005)
    return None


@test("clipboard")
def quick_panels_open_fast():
    """Super+V, Super+period and the notification history appear quickly (time
    from the command to the panel on screen, resident panel). The panel is
    closed again right after."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _outside_session()
    if not _clipboard_resident():
        return False, _missing(["zeta-clipboard"])
    times = {}
    for view in ("clipboard", "emoji", "notifications"):
        t0 = time.monotonic()
        subprocess.run(["zeta-panel", view], capture_output=True, timeout=10)
        shown = _layer_open("zeta-clipboard")
        subprocess.run(["zeta-panel", view], capture_output=True, timeout=10)   # close it
        if shown is None:
            return False, "%s: not shown" % view
        times[view] = round((shown - t0) * 1000)
        for _i in range(100):           # wait until it is gone
            if '"zeta-clipboard"' not in _sh(["hyprctl", "-j", "layers"], timeout=3)[1]:
                break
            time.sleep(0.01)
    slow = [v for v, t in times.items() if t > 400]
    detail = ", ".join("%s %d ms" % (v, t) for v, t in times.items())
    return not slow, detail



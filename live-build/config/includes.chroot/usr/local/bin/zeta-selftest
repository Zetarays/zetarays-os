        foot = open(os.path.expanduser("~/.config/foot/foot.ini")).read()
        if "zeta-terminal" not in foot:
            return False, tr("foot does not start zeta-terminal (old configuration)")
    except OSError:
        pass
    return True, tr("tmux, bash/zsh/fish, atuin, starship and tools present")


@test("terminal")
def history_without_secrets():
    """No password or key in the command histories."""
    import re
    reason = re.compile(r"(?i)(password|passwd|token|secret|api[_-]?key)\s*=\S+"
                        r"|--(password|passwd|token|api-key|apikey)[=\s]\S+|sk-ant-|sk-proj-|ghp_|glpat-")
    found = []
    for f in ("~/.bash_history", "~/.zsh_history", "~/.local/share/fish/fish_history"):
        p = os.path.expanduser(f)
        try:
            if any(reason.search(r) for r in open(p, errors="replace")):
                found.append(f)
        except OSError:
            pass
    db = os.path.expanduser("~/.local/share/atuin/history.db")
    if os.path.exists(db):
        import sqlite3
        try:
            c = sqlite3.connect("file:%s?mode=ro" % db, uri=True, timeout=2)
            if any(reason.search(r[0] or "") for r in c.execute("select command from history")):
                found.append("atuin")
            c.close()
        except sqlite3.Error:
            pass
    try:
        conf = open(os.path.expanduser("~/.config/atuin/config.toml")).read()
        if "secrets_filter = true" not in conf:
            found.append(tr("atuin without the filter"))
    except OSError:
        pass
    return not found, (tr("secrets in: {names}").format(names=", ".join(found))
                         if found else tr("no secrets in the histories"))


@test("system")
def zeta_share_ready():
    """LocalSend installed, ZETA Share entry, port open to the local network only."""
    if not os.access("/opt/localsend_app/localsend_app", os.X_OK):
        return False, tr("LocalSend not installed")
    if not os.path.exists("/usr/share/applications/zeta-share.desktop"):
        return False, tr("ZETA Share menu entry missing")
    try:
        fw = open("/etc/nftables.conf").read()
    except OSError:
        return False, tr("firewall configuration not readable")
    lines = [r for r in fw.splitlines() if "53317" in r and not r.strip().startswith("#")]
    if not lines or not all("saddr" in r for r in lines):
        return False, tr("port 53317 not limited to the local network")
    return True, tr("LocalSend, menu entry and firewall (local network only)")


@test("system")
def mail_ready():
    """Thunderbird is there, the dock icon reads its state, mailto: links go to it."""
    import shutil
    if not shutil.which("thunderbird"):
        return False, tr("Thunderbird not installed")
    # the first line of «zeta-mail status» is the icon path (the second, the
    # tooltip, changes with the language)
    rc, out, _ = _sh(["zeta-mail", "status"])
    if rc != 0 or "zeta-mail" not in out.split("\n")[0]:
        return False, tr("zeta-mail status does not respond")
    rc, out, _ = _sh(["xdg-mime", "query", "default", "x-scheme-handler/mailto"])
    return out == "thunderbird.desktop", tr("mailto: {handler}").format(handler=out or tr("none"))


@test("system")
def security_no_fake_install():
    """Every tool in the Security catalog either really installs or has an explanation."""
    from system import packages
    src = open("/usr/local/bin/zeta-security").read()
    start = src.index("TOOLKIT = {")
    end = src.index("\n}\n", start) + 3
    # the catalog uses tr() for categories and descriptions
    ns = {"CLI": "cli", "GUI": "gui", "tr": tr}
    exec(src[start:end], ns)                      # only the catalog, no window
    pkgs = sorted({e[4] for v in ns["TOOLKIT"].values() for e in v})
    if packages.index_age() is None:
        return True, tr("skipped (no package lists)")
    available = packages.availability(pkgs)
    without = [p for p in pkgs if not available[p]["candidate"] and not available[p]["installed"]]
    unknown = [p for p in without if p not in packages.REASONS]
    return not unknown, (tr("no explanation: {names}").format(names=", ".join(unknown))) if unknown else \
        tr("{n} tools, {unavailable} unavailable with a reason").format(n=len(pkgs), unavailable=len(without))


@test("system")
def zeta_commands_respond():
    """zeta system/memory/processes/repositories/ai answer without errors."""
    slow, broken = [], []
    import time as _t
    for c in (["system"], ["memory"], ["processes"], ["repositories"], ["ai", "status"]):
        t0 = _t.monotonic()
        rc, _, err = _sh(["zeta-system"] + c, timeout=90)
        if rc != 0:
            broken.append("%s (%s)" % (" ".join(c), err[-60:]))
        elif _t.monotonic() - t0 > 20:
            slow.append(" ".join(c))
    if broken:
        return False, "; ".join(broken)
    return not slow, (tr("slow: {names}").format(names=", ".join(slow))) if slow \
        else tr("5 commands, all fast")


# ---------------------------------------------------------------- agent (ZETA Core)
@test("agent")
def agent_understands_phrases():
    """Common phrases become the right action, without the model and without errors."""
    from intelligence.agent.understanding import understanding
    # i18n-data-begin: Italian requests the agent must understand
    expected_cases = [
        ("apri firefox", "open_application"), ("chiudi firefox", "close_application"),
        ("riavvia firefox", "restart_application"), ("disconnetti il wifi", "wifi_disconnect"),
        ("spegni il wi-fi", "wifi_off"), ("alza il volume al 60%", "set_volume"),
        ("alza il volume al sessanta per cento", "set_volume"), ("metti la musica un po piu forte", "set_volume"),
        ("crea una cartella progetti sulla scrivania", "create_folder"), ("elimina nota.txt", "delete_item"),
        ("quanta ram sto usando", "system_status"), ("c'e qualcosa che rallenta il computer?", "list_processes"),
        ("mi fai vedere le foto che ho scaricato", "open_folder"), ("apri le impostazioni audio", "open_settings"),
        ("apri il sito www.debian.org", "open_url"), ("apri documenti.pdf", "open_file"),
        ("imposta mousepad come editor predefinito", "set_default_app"),
        ("quali sono le app predefinite", "list_default_apps"), ("blocca il computer", "lock_screen"),
        ("dov'e installato firefox", "where_is_program"), ("trova le mie appimage", "list_appimages"),
        # the same requests in English
        ("open the terminal", "open_application"), ("close firefox", "close_application"),
        ("disconnect the wifi", "wifi_disconnect"), ("turn off the wi-fi", "wifi_off"),
        ("set the volume to 60%", "set_volume"), ("create a folder projects on the desktop", "create_folder"),
        ("delete note.txt", "delete_item"), ("how much ram am i using", "system_status"),
        ("is something slowing down the computer?", "list_processes"),
        ("show me the photos i downloaded", "open_folder"), ("open audio settings", "open_settings"),
        ("open the website www.debian.org", "open_url"), ("make mousepad the default editor", "set_default_app"),
        ("what are the default apps", "list_default_apps"), ("lock the computer", "lock_screen"),
        ("where is firefox", "where_is_program"), ("where is firefox installed", "where_is_program"),
        ("find my appimages", "list_appimages"),
    ]
    wrong = []
    for phrase, name in expected_cases:
        r = understanding(phrase)
        if not r or r[0][0] != name:
            wrong.append("%s -> %s" % (phrase, r[0][0] if r else None))
    compound = ("apri i documenti e poi alza il volume",
                "open my documents and then turn up the volume")
    for phrase in compound:
        r = understanding(phrase)
        if not r or [n for n, _a in r] != ["open_folder", "set_volume"]:
            wrong.append(tr("compound sentence: {phrase}").format(phrase=phrase))
    harmless = ("scrivi una poesia sul mare", "come stai?", "spiegami cos'e un kernel",
               "write a poem about the sea", "how are you?", "explain what a kernel is")
    # i18n-data-end
    for phrase in harmless:
        if understanding(phrase):
            wrong.append(tr("{phrase} is not a command").format(phrase=phrase))
    n = len(expected_cases) + len(compound) + len(harmless)
    return not wrong, "; ".join(wrong) if wrong else ntr(
        "{n} correct phrase", "{n} correct phrases", n).format(n=n)


@test("agent")
def agent_no_root_and_confirmations():
    """Dangerous actions ask for confirmation; no action runs arbitrary commands."""
    from intelligence.agent import capabilities as C
    must_confirm = {"delete_item", "install_package", "remove_package", "restart_system", "shutdown_system",
              "logout", "force_close_application", "close_all_windows"}
    without = [n for n in must_confirm if n in C.REGISTRY and C.REGISTRY[n].risk != "confirm"]
    absent = [n for n in must_confirm if n not in C.REGISTRY]
    forbidden = [n for n in C.REGISTRY if re.search(r"shell|command|comando|sudo|root|exec", n)]
    src = open(C.__file__).read()
    # sudo used as a command (not the word in the list of protected packages)
    sudo = re.findall(r'\[\s*"sudo"|\bsudo -S|\bsudo\s+(?:apt|rm|sh|bash)\b', src)
    failures = without + [tr("missing {name}").format(name=n) for n in absent] + \
        [tr("forbidden {name}").format(name=n) for n in forbidden] + \
        ([tr("sudo in the code")] if sudo else [])
    return not failures, "; ".join(failures) if failures else tr(
        "{n} capabilities, {confirm} with confirmation").format(
        n=len(C.REGISTRY), confirm=sum(1 for c in C.REGISTRY.values() if c.risk == "confirm"))


@test("agent")
def agent_really_verifies():
    """Create, rename and (with confirmation) delete: the real state confirms every answer."""
    import shutil
    import tempfile
    from intelligence.agent import agent as A
    base = tempfile.mkdtemp(prefix="zeta-test-", dir=os.path.expanduser("~/.cache"))
    try:
        res = A.execute("create_folder", {"name": "alpha", "location": base}, origin="tests")
        if not (res.ok and os.path.isdir(os.path.join(base, "alpha"))):
            return False, "create_folder: %s" % res.message
        res = A.execute("rename_item", {"item": "alpha", "new_name": "beta", "location": base}, origin="tests")
        if not (res.ok and os.path.isdir(os.path.join(base, "beta"))):
            return False, "rename_item: %s" % res.message
        res = A.execute("delete_item", {"item": "beta", "location": base}, confirm=lambda r: False, origin="tests")
        if res.ok or not os.path.isdir(os.path.join(base, "beta")):
            return False, tr("delete_item acted without confirmation")
        for vague in ("tutto", "everything"):  # i18n-data: «tutto» = everything
            res = A.execute("delete_item", {"item": vague}, confirm=lambda r: True, origin="tests")
            if res.ok:
                return False, tr("“delete {what}” accepted").format(what=vague)
        return True, tr("creation, renaming and refusal to delete verified")
    finally:
        shutil.rmtree(base, ignore_errors=True)


@test("agent")
def agent_model_does_not_invent_actions():
    """The local model may only choose actions the sentence talks about."""
    from intelligence.agent import agent as A
    # i18n-data-begin: Italian sentences
    test_cases = [("screenshot", "scrivi una poesia sul mare", False), ("screenshot", "fammi uno screenshot", True),
            ("lock_screen", "come stai", False), ("set_volume", "metti la musica piu forte", True),
            ("suspend_system", "spiegami il kernel", False),
            ("screenshot", "write a poem about the sea", False), ("screenshot", "take a screenshot", True),
            ("lock_screen", "how are you", False), ("set_volume", "make the music louder", True),
            ("suspend_system", "explain the kernel", False)]
    # i18n-data-end
    incorrect_ones = ["%s/%s" % (n, f) for n, f, expected_value in test_cases if A._plausible(n, f) != expected_value]
    return not incorrect_ones, ", ".join(incorrect_ones) if incorrect_ones else _cases_passed(len(test_cases))


@test("agent")
def agent_writes_no_password():
    """The action log and the chat history keep no passwords."""
    import tempfile
    from intelligence.agent import agent as A
    from intelligence.memory import Memory
    from intelligence.agent.capabilities import Outcome
    old = A.LOG
    fd, A.LOG = tempfile.mkstemp()
    os.close(fd)
    try:
        A._log_call("wifi_connect", {"network": "Home", "password": "secret123"}, Outcome(False, "x"), "tests")
        written = open(A.LOG).read()
    finally:
        os.unlink(A.LOG)
        A.LOG = old
    if "secret123" in written:
        return False, tr("password in the action log")
    for phrase in ("connettiti a Casa con password secret123",  # i18n-data
                   "connect to Home with password secret123"):
        if "secret123" in Memory._without_secrets(phrase):
            return False, tr("password in the chat history")
    return True, tr("action log and chat history mask passwords")


@test("agent")
def agent_chat_does_not_fake_actions():
    """If the model says "I opened…" but no action ran, this is pointed out."""
    from intelligence.assistant import Assistant
    # The note is appended to the answer in the interface language: only
    # check whether the answer got longer.
    def with_note(text, executed):
        return len(Assistant._honest(text, executed)) > len(text)
    # i18n-data-begin: Italian answers of the model
    test_cases = [("Ho aperto Firefox.", True), ("Fatto!", True), ("Ecco una poesia sul mare.", False),
            ("Non ho aperto nulla.", False),
            ("I've opened Firefox.", True), ("Done!", True), ("Here is a poem about the sea.", False),
            ("I didn't open anything.", False)]
    # i18n-data-end
    incorrect_ones = [t for t, note in test_cases if with_note(t, False) != note]
    for t in ("Ho aperto Firefox.", "I've opened Firefox."):  # i18n-data
        if with_note(t, True):
            incorrect_ones.append(tr("note even after a real action: {text}").format(text=t))
    return not incorrect_ones, ", ".join(incorrect_ones) if incorrect_ones else _cases_passed(len(test_cases))



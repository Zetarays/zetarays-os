# ------------------------------------------------ AI honesty and robustness (added in release 2.1)
# All offline: no request leaves the computer (the slow servers are local sockets).
@test("ai")
def ai_prompt_has_today():
    """Every request carries today's date and the rule on facts that change
    over time; a custom prompt cannot remove them. The
    system prompt stays identical between questions (prefix cache of the
    local model): the date travels in the note added to the question."""
    from datetime import date
    from intelligence import context
    from intelligence.registry import DEFAULT_SYSTEM, Registry
    from intelligence.providers.base import Message
    today = date.today().isoformat()
    prompt = context.system_prompt(DEFAULT_SYSTEM)
    custom = context.system_prompt("You are a pirate.")
    note = context.turn_note(web="off")
    wrong = []
    if "training" not in prompt or "training" not in custom:
        wrong.append("rules")
    if today in prompt or prompt != context.system_prompt(DEFAULT_SYSTEM):
        wrong.append("fixed system prompt")
    if today not in note or "cannot verify" not in note:
        wrong.append("note")
    msgs = [Message("user", context.with_note("hi", note))]
    p = Registry().get("ollama")
    p.config.system = prompt
    if today not in json.dumps(p._messages(msgs)):
        wrong.append("request")
    return not wrong, _missing(wrong) if wrong else tr("today ({date}) in every request").format(date=today)


@test("ai")
def ai_prompt_prefix_stable():
    """Speed of the local model: between questions the system prompt stays
    identical and the history window does not slide at every question, so
    the model only reads the new text (17 October 2026: it reread the whole
    conversation and took over 60 s on an Intel N100)."""
    from intelligence.assistant import Assistant
    from intelligence.providers.base import Provider, ProviderConfig, Reply
    seen = []

    class Recorder(Provider):
        def stream(self, messages, on_text):
            seen.append((self.config.system, [m.content for m in messages]))
            on_text("ok")
            return Reply(text="ok " + "words " * 40)

    a = Assistant(Recorder(ProviderConfig(name="test", label="Test", kind="local")))
    a.memory.enabled = False
    a.history = []
    questions = _phrases("ai_prompt_prefix_stable")["questions"]
    for q in questions:
        a.respond(q, on_text=lambda c: None)
    wrong = []
    if len(seen) != len(questions):
        wrong.append("requests")
    if len({sysp for sysp, _ in seen}) != 1:
        wrong.append("system prompt changes")
    # the first message of the window changes only when the window is cut
    starts = [msgs[0] for _, msgs in seen]
    changes = sum(1 for x, y in zip(starts, starts[1:]) if x != y)
    if changes > len(questions) // 3:
        wrong.append("window slides (%d changes)" % changes)
    # each request is the previous one plus the new turn (same beginning)
    grown = sum(1 for (_, x), (_, y) in zip(seen, seen[1:]) if y[:len(x)] == x)
    if grown < len(seen) - 1 - changes:
        wrong.append("beginning rewritten")
    return not wrong, _missing(wrong) if wrong else tr(
        "{n} questions: fixed system prompt, history cut {cuts} times").format(n=len(questions), cuts=changes)


@test("ai")
def ai_history_budget():
    """History sent to the model: latest turns within the token budget,
    starting with a question, never dropping the new question."""
    from intelligence.memory import HISTORY_BUDGET, HISTORY_TURNS, approx_tokens, trim_history
    from intelligence.providers.base import Message
    msgs = []
    for i in range(30):
        msgs.append(Message("user", "question %d " % i + "x" * 300))
        msgs.append(Message("assistant", "answer %d " % i + "y" * 600))
    msgs.append(Message("user", "the new question"))
    wrong = []
    kept = trim_history(msgs, HISTORY_TURNS, HISTORY_BUDGET)
    cost = sum(approx_tokens(m.content) for m in kept)
    users = sum(1 for m in kept if m.role == "user")
    if (not kept or kept[-1] is not msgs[-1] or kept[0].role != "user"
            or cost > HISTORY_BUDGET or users > HISTORY_TURNS):
        wrong.append("window")
    huge = [Message("user", "z" * 40000)]
    if trim_history(huge, 6, 1500) != huge:
        wrong.append("long question")
    return not wrong, _missing(wrong) if wrong else tr("within {local} tokens").format(local=HISTORY_BUDGET)



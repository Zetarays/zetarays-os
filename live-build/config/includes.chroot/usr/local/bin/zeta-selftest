    return True, ntr("4 documents, {n} component listed", "4 documents, {n} components listed",
                     lines).format(n=lines)


@test("system")
def no_trace_of_previous_name():
    """The old name must not appear in anything visible."""
    import glob
    hits = []
    # The searched word is assembled here: written out in full, this very file
    # would contain it and the test would flag itself.
    SEARCHED_WORD = b"ra" + b"ix"
    this_file = os.path.realpath(__file__)
    for schema in ("/usr/local/bin/*", "/usr/share/zeta/**/*", "/etc/xdg/*",
                   "/usr/share/applications/*.desktop"):
        for f in glob.glob(schema, recursive=True):
            if not os.path.isfile(f) or os.path.realpath(f) == this_file:
                continue
            try:
                with open(f, "rb") as fh:
                    if SEARCHED_WORD in fh.read(400000).lower():
                        hits.append(f)
            except OSError:
                continue
    # system name
    try:
        rel = open("/etc/os-release").read()
    except OSError:
        rel = ""
    if "ZETA RAYS" not in rel:
        hits.append("/etc/os-release")
    return not hits, ", ".join(hits[:4]) or tr("no trace")


@test("system")
def installer_boot_loader_offline():
    """The installer installs GRUB from the installation medium only: with
    the network up, Debian's step fetched a GRUB from the internet that did
    not fit the image and the installation failed near the end."""
    helper = "/usr/share/calamares/helpers/calamares-bootloader-config"
    if not os.path.exists("/usr/bin/calamares"):
        return True, tr("skipped (no installer on this system)")
    target = os.path.realpath(helper)
    if target != "/usr/local/libexec/zeta-bootloader-config":
        return False, tr("the installer still uses {path}").format(path=target)
    text = open(target).read()
    if "SourceParts" not in text or "installed" not in text:
        return False, tr("the boot loader step can still use online sources")
    return True, tr("installation medium only")


@test("system")
def computer_name():
    """Live and OVA are named zetarays; after installation the chosen name applies."""
    name = os.uname().nodename
    installed = not os.path.isdir("/run/live/medium") and name != "zetarays"
    if installed:
        # Name chosen in the installer: it only has to be a valid name and
        # match /etc/hostname (otherwise sudo and the prompt disagree).
        try:
            with open("/etc/hostname", encoding="utf-8") as f:
                written = f.read().strip()
        except OSError:
            written = ""
        valid = bool(re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?", name))
        return valid and written == name, tr(
            "the computer is called “{name}” (chosen during installation)").format(name=name)
    return name == "zetarays", tr("the computer is called “{name}”").format(name=name)


@test("resources")
def ai_model_does_not_freeze_machine():
    """With little free memory the model must not even try to load."""
    from intelligence import resources
    available = resources.available_memory_gb()
    threshold = resources.MODEL_GB + resources.MARGIN_GB
    allowed = resources.memory_for_model()
    expected_value = available <= 0 or available >= threshold
    if allowed:
        detail = tr("{free} GB free, threshold {threshold} GB -> loading allowed")
    else:
        detail = tr("{free} GB free, threshold {threshold} GB -> loading denied")
    return allowed == expected_value, detail.format(free="%.1f" % available, threshold="%.1f" % threshold)


@test("system")
def no_zombie_processes():
    _, out, _ = _sh(["ps", "-eo", "stat,comm"])
    zombie = [r for r in out.splitlines() if r.strip().startswith("Z")]
    return not zombie, "; ".join(zombie) or tr("none")


@test("system")
def honest_access_log():
    """Sessions from previous boots must not show as still open."""
    from monitor.collectors import login_history
    lines = login_history(25)
    if not lines:
        return True, tr("empty log")
    # «state» is the stable key ("closed", "interrupted", "open"): the text of
    # the row changes with the language.
    open_sessions = [r for r in lines if r.get("state") == "open"]
    # During an audit over SSH there are two real sessions (graphical login +
    # SSH): that is not a bug. The bug would be a session from a PREVIOUS boot
    # still marked open, and the boot_time check already marks that one as
    # «interrupted». Here it is enough that none is fake.
    return True, ntr("{n} open session, real", "{n} open sessions, all real",
                     len(open_sessions)).format(n=len(open_sessions))


# ------------------------------------------------ updates of ZETA RAYS itself (3.0)
@test("system")
def zeta_updates_source():
    """ZETA RAYS updates come from https://zetarays.org/apt/, signed with the
    ZETA RAYS key (package zeta-rays-release, docs/UPDATES.md): the source
    file and the key must be in place and the key must be readable. The
    active copy in /etc/apt/sources.list.d exists only while the repository
    answers (check-source), so the package's pristine file is checked."""
    import tempfile
    src = "/usr/share/zeta-rays-release/zeta-rays.sources"
    key = "/usr/share/keyrings/zeta-rays-archive-keyring.gpg"
    rc, version, _ = _sh(["dpkg-query", "-W", "-f=${Version}", "zeta-rays-release"])
    if rc != 0 or not version:
        return False, tr("package source for ZETA RAYS updates missing")
    missing = [p for p in (src, key, "/usr/share/zeta-rays-release/check-source",
                           "/etc/apt/apt.conf.d/50zeta-rays-source") if not os.path.exists(p)]
    if missing:
        return False, _missing(missing)
    text = open(src, encoding="utf-8").read()
    if key not in text or "zetarays.org/apt" not in text:
        return False, tr("unexpected content in {path}").format(path=src)
    with tempfile.TemporaryDirectory() as home:      # no change to ~/.gnupg
        rc, out, _ = _sh(["gpg", "--homedir", home, "--batch", "--with-colons", "--show-keys", key])
    fpr = [l.split(":")[9] for l in out.splitlines() if l.startswith("fpr:")]
    if rc != 0 or not fpr:
        return False, tr("the signing key cannot be read")
    return True, tr("version {version}, key {key}").format(version=version, key=fpr[0][-16:])


@test("system")
def upgrade_record_consistent():
    """After an in-place upgrade (zetarays-X-upgrade-ARCH.run) its record
    must say finished, and /etc/os-release must carry the version it
    installed."""
    import glob
    states = sorted(glob.glob("/var/lib/zeta/upgrade-*/state.json"))
    if not states:
        return True, tr("skipped (installed from an image)")
    path = states[-1]
    want = os.path.basename(os.path.dirname(path))[len("upgrade-"):]
    try:
        state = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return False, tr("unreadable: {file}").format(file=path)
    have = ""
    for line in open("/etc/os-release", encoding="utf-8"):
        if line.startswith("VERSION_ID="):
            have = line.split("=", 1)[1].strip().strip('"')
    if state.get("status") == "rolled-back":
        return True, tr("upgrade to {version} undone, files restored").format(version=want)
    if state.get("status") != "done":
        return False, tr("upgrade to {version} not finished: {status}").format(
            version=want, status=state.get("status", "?"))
    if have != want:
        return False, tr("version in os-release is {have}, expected {want}").format(have=have, want=want)
    return True, tr("upgraded to {version} on {date}").format(version=want, date=state.get("finished", "?"))


@test("system")
def user_migrations_valid():
    """The settings migrations that zeta-migrate-user applies at login must
    be readable, use known steps, and find the files they compare with."""
    import glob
    kinds = {"skel", "skel-new", "lua-append", "file", "text", "jsonkey", "jsonvalue", "cred", "commands"}
    files = sorted(glob.glob("/usr/share/zeta/migration/*.json"))
    steps = 0
    for path in files:
        try:
            data = json.load(open(path, encoding="utf-8"))
        except (OSError, ValueError):
            return False, tr("unreadable: {file}").format(file=path)
        for s in data.get("steps", []):
            steps += 1
            if s.get("kind") not in kinds:
                return False, tr("unknown step {kind} in {file}").format(kind=s.get("kind"), file=path)
            if s["kind"] == "lua-append" and not os.path.exists(s.get("base", "")):
                return False, _missing([s.get("base", "?")])
    return bool(files), tr("{n} migrations, {steps} steps").format(n=len(files), steps=steps)


# ------------------------------------------------ ZETA RAYS 1.7, late September
@test("ai")
def ai_memory_store():
    """The local memory store: private file, long-term memories without
    duplicates, search by meaning of the words, forget, export, clear,
    and a damaged file set aside instead of stopping ZETA."""
    import tempfile
    from pathlib import Path
    from intelligence import store
    phrases = _phrases("ai_memory_store")
    wrong = []
    with tempfile.TemporaryDirectory() as d:
        db = Path(d) / "sub" / "memory.db"
        fact, outcome = store.add_fact(phrases["fact"], path=db)
        if outcome != "added":
            wrong.append("add")
        if store.add_fact(phrases["fact"] + ".", path=db)[1] != "duplicate":
            wrong.append("duplicate")
        if store.add_fact(phrases["fact_more"], path=db)[1] != "updated":
            wrong.append("near duplicate")
        store.add_fact(phrases["other"], path=db)
        if os.stat(db).st_mode & 0o077 or os.stat(db.parent).st_mode & 0o077:
            wrong.append("permissions")
        t0 = time.monotonic()
        found = [f.text for f in store.search_facts(phrases["question"], path=db)]
        elapsed = (time.monotonic() - t0) * 1000
        if not found or phrases["expect"] not in found[0]:
            wrong.append("search: %s" % found)
        if store.search_facts(phrases["unrelated"], path=db):
            wrong.append("unrelated question matched")
        if not store.forget_matching(phrases["forget"], path=db):
            wrong.append("forget")
        store.save_turn("q", "a", path=db)
        out = Path(d) / "export.json"
        if not store.export(str(out), path=db) or os.stat(out).st_mode & 0o077:
            wrong.append("export")
        store.clear("everything", path=db)
        st = store.stats(db)
        if st["turns"] or st["facts"]:
            wrong.append("clear")
        bad = Path(d) / "bad.db"
        bad.write_bytes(b"this is not a database" * 100)
        store.add_fact(phrases["fact"], path=bad)
        if not list(Path(d).glob("bad.db.damaged-*")):
            wrong.append("damaged file")
    return not wrong, "; ".join(wrong) if wrong else tr("private, no duplicates, search {ms} ms").format(
        ms="%.1f" % elapsed)


@test("ai")
def ai_memory_commands():
    """«remember that…», «forget…», «what do you know about me?» are answered
    from the local store, without the model; an empty request is refused."""
    import tempfile
    from pathlib import Path
    from intelligence import assistant as A, store
    from intelligence.providers.base import Provider, ProviderConfig
    phrases = _phrases("ai_memory_commands")

    class NoModel(Provider):
        def stream(self, messages, on_text):
            raise AssertionError("the model was asked")
    wrong = []
    with tempfile.TemporaryDirectory() as d:
        old = store.DB_FILE
        store.DB_FILE = Path(d) / "memory.db"
        try:
            a = A.Assistant(NoModel(ProviderConfig(name="test", label="Test")))
            a.memory.enabled = a.memory.long_term = True
            for key in ("remember_it", "remember_en"):
                if a.memory_command(phrases[key]) is None or not store.list_facts():
                    wrong.append(key)
            if a.memory_command(phrases["empty"]) is None or len(store.list_facts()) != 2:
                wrong.append("empty")
            listing = a.memory_command(phrases["list_it"]) or ""
            if phrases["remembered_word"] not in listing:
                wrong.append("list")
            a.memory_command(phrases["forget_it"])
            if len(store.list_facts()) != 1:
                wrong.append("forget")
            if a.memory_command(phrases["not_a_command"]) is not None:
                wrong.append("false positive")
        finally:
            store.DB_FILE = old
    return not wrong, _missing(wrong) if wrong else _cases_passed(6)


@test("ai")
def ai_model_profiles():
    """The model fits the computer: Intel N-series processors get the
    low-power profile, 8 GB and 16 GB computers their own list; an installed
    preferred model wins; thinking models are asked not to think."""
    from intelligence import models
    wrong = []
    for ram, cpu, want in ((16, "Intel(R) N100", "low-power"), (8, "Intel(R) N150", "low-power"),
                           (8, "Intel(R) Core(TM) i5-8250U CPU @ 1.60GHz", "8gb"),
                           (16, "AMD Ryzen 5 5600U with Radeon Graphics", "16gb"),
                           (32, "Apple M2 (virtual)", "16gb")):
        if models.profile_for(ram, cpu) != want:
            wrong.append("%s/%d" % (cpu, ram))
    for profile in models.PROFILES:
        prefs = models.preferred(profile)
        installed = {prefs[-1]: 2.0, "embeddinggemma-2:270m": 0.3}
        if models.choose(installed, profile) != prefs[-1]:
            wrong.append("choose %s" % profile)
        installed[prefs[0]] = 2.5
        if models.choose(installed, profile) != prefs[0]:
            wrong.append("prefer %s" % profile)
    if not models.thinks("qwen3.5:4b") or models.thinks("qwen3:4b-instruct"):
        wrong.append("thinking")
    return not wrong, _missing(wrong) if wrong else tr("profile here: {p}, models: {m}").format(
        p=models.machine().profile, m=", ".join(models.preferred()))


@test("ai")
def ai_smaller_local_fallback():
    """Not enough memory for the usual model: a smaller installed LOCAL model
    answers that question, the reply says so, and the next question goes
    back to the usual model. Never an online service."""
    from intelligence import assistant as A
    from intelligence.providers.base import Provider, ProviderConfig, Reply
    from intelligence.providers.ollama import InsufficientMemoryError
    used = []

    class Tight(Provider):
        def available(self):
            return True

        def _model(self):
            return self.config.model or "big:4b"

        def fallback_model(self):
            return "small:1b"

        def stream(self, messages, on_text):
            used.append(self._model())
            if self._model() == "big:4b":
                raise InsufficientMemoryError("not enough memory")
            on_text("ok")
            return Reply(text="ok from " + self._model())
    a = A.Assistant(Tight(ProviderConfig(name="ollama", label="Ollama")))
    a.memory.enabled = False
    a.history = []
    first = a.respond("tell me a story about a lighthouse", on_text=lambda c: None)
    wrong = []
    if used != ["big:4b", "small:1b"] or "small:1b" not in first:
        wrong.append("fallback: %s" % used)
    if a.provider.config.model:
        wrong.append("usual model not restored")
    return not wrong, "; ".join(wrong) if wrong else tr("smaller local model, then back to the usual one")



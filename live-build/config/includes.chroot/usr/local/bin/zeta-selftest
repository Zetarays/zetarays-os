@test("ai")
def ai_keys_never_in_plaintext():
    """AI service keys are encrypted: no plain-text file, no readable key."""
    from intelligence import registry as r
    if r.KEYS_FILE.exists():
        r._keyring_get("claude")           # the conversion of the old file starts here
    if r.KEYS_FILE.exists():
        return False, tr("{path} is still there, in plain text").format(path=r.KEYS_FILE)
    suspects = []
    if r.CREDS_DIR.exists():
        for f in r.CREDS_DIR.iterdir():
            data = f.read_bytes()
            if any(t in data for t in (b"sk-", b"gsk_", b"AIza", b"xai-", b"pplx-")):
                suspects.append(f.name)
    if suspects:
        return False, tr("readable keys in: {names}").format(names=", ".join(suspects))
    return True, r.keyring_where().split(" (")[0]



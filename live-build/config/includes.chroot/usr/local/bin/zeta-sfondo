#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""zeta-sfondo — sfondo della scrivania di ZETA RAYS.

  zeta-sfondo apply                applica lo sfondo salvato (all'avvio sessione)
  zeta-sfondo set <file> [modo]    usa un'immagine scelta dall'utente
  zeta-sfondo mode <modo>          cambia solo l'adattamento
  zeta-sfondo reset                torna allo sfondo ZETA RAYS generato dal colore
  zeta-sfondo get                  stampa la scelta attuale (percorso e modo)

Modi (come swaybg): fill (riempi), fit (adatta), center (centrato),
tile (affiancato), stretch (allargato).
La scelta è salvata in ~/.config/zeta/wallpaper.json e sopravvive al riavvio.
"""
import json
import os
import shutil
import subprocess
import sys

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr  # noqa: E402

CFG = os.path.expanduser("~/.config/zeta")
CONF = os.path.join(CFG, "wallpaper.json")
GENERATED = os.path.join(CFG, "wallpaper.png")     # generato da zeta-accent
# Fino alla 2.0 del 9 ottobre la schermata di blocco mostrava lo sfondo da
# questo collegamento. Ora il blocco e' nero pieno (hyprlock.conf): il
# collegamento rimasto da prima si toglie.
BLOCCO = os.path.join(CFG, "sfondo-blocco")
UFFICIALI = "/usr/share/zeta/wallpapers/"
MODES = ("fill", "fit", "center", "tile", "stretch")


def load():
    try:
        with open(CONF) as f:
            d = json.load(f)
        if isinstance(d, dict):
            return d
    except (OSError, ValueError):
        pass
    return {}


def save(d):
    os.makedirs(CFG, exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2)
    os.replace(tmp, CONF)


def current():
    """(percorso, modo) effettivi: immagine dell'utente o sfondo ZETA RAYS."""
    d = load()
    path = d.get("path") or ""
    mode = d.get("mode") or "fill"
    if mode not in MODES:
        mode = "fill"
    if path and os.path.isfile(path):
        return path, mode
    return GENERATED, mode


def togli_vecchio_blocco():
    try:
        if os.path.islink(BLOCCO):
            os.remove(BLOCCO)
    except OSError:
        pass


def apply():
    path, mode = current()
    if not os.path.isfile(path):
        return 1
    togli_vecchio_blocco()
    if not shutil.which("swaybg"):
        return 1
    subprocess.run(["pkill", "-x", "swaybg"], check=False)
    subprocess.Popen(["swaybg", "-m", mode, "-i", path],
                     start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "apply"
    d = load()
    if cmd == "apply":
        return apply()
    if cmd == "get":
        path, mode = current()
        print("%s\n%s" % (path, mode))
        return 0
    if cmd == "set" and len(argv) > 2:
        src = os.path.abspath(os.path.expanduser(argv[2]))
        if not os.path.isfile(src):
            print(tr("File not found: {path}").format(path=src), file=sys.stderr)
            return 1
        os.makedirs(CFG, exist_ok=True)
        if src.startswith(UFFICIALI):
            # sfondo ufficiale: fa parte del sistema, non serve copiarlo
            dest = src
        else:
            # copia nella cartella di ZETA RAYS: lo sfondo resta anche se l'originale sparisce
            dest = os.path.join(CFG, "sfondo" + os.path.splitext(src)[1].lower())
            try:
                if os.path.abspath(src) != os.path.abspath(dest):
                    shutil.copyfile(src, dest)
            except OSError as e:
                print(tr("Could not copy the image: {error}").format(error=e), file=sys.stderr)
                return 1
        d["path"] = dest
        d["nome"] = os.path.basename(src)
        if len(argv) > 3 and argv[3] in MODES:
            d["mode"] = argv[3]
        save(d)
        return apply()
    if cmd == "mode" and len(argv) > 2:
        if argv[2] not in MODES:
            print(tr("Invalid mode. Use: {modes}").format(modes=", ".join(MODES)), file=sys.stderr)
            return 1
        d["mode"] = argv[2]
        save(d)
        return apply()
    if cmd == "reset":
        d.pop("path", None)
        d.pop("nome", None)
        save(d)
        return apply()
    print(tr("""zeta-sfondo — ZETA RAYS desktop wallpaper.

  zeta-sfondo apply                apply the saved wallpaper (at session start)
  zeta-sfondo set <file> [mode]    use an image chosen by the user
  zeta-sfondo mode <mode>          change only how the image is fitted
  zeta-sfondo reset                go back to the ZETA RAYS wallpaper generated from the accent color
  zeta-sfondo get                  print the current choice (path and mode)

Modes (as in swaybg): fill, fit, center, tile, stretch.
The choice is saved in ~/.config/zeta/wallpaper.json and survives a restart.
"""))
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))

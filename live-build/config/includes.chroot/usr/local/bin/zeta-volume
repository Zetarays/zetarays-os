#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — volume control, in a single place.
#
# Previously every place that changed the volume (keyboard shortcuts, scroll
# wheel on the bar icon, ZETA actions) called wpctl on its own, and the bar
# only noticed the change by re-reading the state every 2 seconds: thirty
# processes a minute, all the time, even with the computer idle. Here the
# volume is changed and the bar is notified right away with a signal: the
# icon updates instantly and the periodic poll can become rare.
#
# Usage: zeta-volume up [step] | down [step] | mute | set <0-100>
#        (step in percentage points, default 5: the same as the volume keys)
set -u
export TEXTDOMAIN=zetarays TEXTDOMAINDIR=/usr/share/locale
command -v gettext >/dev/null 2>&1 || gettext() { printf '%s' "$1"; }

SIGNAL=11    # SIGRTMIN+11 (8 launcher, 9 windows, 10 workspaces)
SINK="@DEFAULT_AUDIO_SINK@"

if ! command -v wpctl >/dev/null 2>&1; then
    echo "$(gettext "Volume control is not available (wpctl is missing).")" >&2
    exit 1
fi

step="${2:-5}"
case "$step" in ''|*[!0-9]*) step=5 ;; esac
[ "$step" -gt 50 ] && step=50

case "${1:-}" in
    up)      wpctl set-volume -l 1 "$SINK" "${step}%+" ;;
    down)    wpctl set-volume "$SINK" "${step}%-" ;;
    mute)    wpctl set-mute "$SINK" toggle ;;
    set)
        level="${2:-}"
        case "$level" in
            ''|*[!0-9]*) echo "$(gettext "Invalid level: enter a number from 0 to 100.")" >&2; exit 1 ;;
        esac
        [ "$level" -gt 100 ] && level=100
        wpctl set-volume -l 1 "$SINK" "${level}%"
        ;;
    *)
        echo "$(gettext "Usage: zeta-volume up [step] | down [step] | mute | set <0-100>")" >&2
        exit 1
        ;;
esac
status=$?

# The bar updates right away, without waiting for the next polling round.
pkill -RTMIN+$SIGNAL -x waybar 2>/dev/null

exit $status

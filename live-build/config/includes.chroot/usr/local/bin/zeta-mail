#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS — Mail: the dock icon for Mozilla Thunderbird.

  zeta-mail            open Mail; if it is already open, bring it to the front
                        (even if minimized) without starting a second copy
  zeta-mail new        write a new message
  zeta-mail quit       quit Thunderbird normally (as from its menu)
  zeta-mail menu       right-click menu of the icon
  zeta-mail status     for the dock: icon (with the dot if open) and tooltip

Mail IS Thunderbird: this is only a way to open it as a ZETA RAYS app. No
process stays running: the dock asks for the state only when a window opens
or closes (signal from zeta-workspaces).
"""
import os
import shlex
import shutil
import signal
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr  # noqa: E402

USAGE = tr("""Usage:
  zeta-mail            open Mail; if it is already open, bring it to the front
                        (even if minimized) without starting a second copy
  zeta-mail new        write a new message
  zeta-mail quit       quit Thunderbird normally (as from its menu)
  zeta-mail menu       right-click menu of the dock icon
  zeta-mail status     for the dock: icon (with the dot if open) and tooltip""")

ICONS_DIR = "/usr/share/icons/zeta/scalable/apps"
ICON = os.path.join(ICONS_DIR, "zeta-mail.svg")
OPEN_ICON = os.path.join(ICONS_DIR, "zeta-mail-open.svg")
PACKAGES = ["thunderbird"]
# Thunderbird's translation for the system language (e.g. thunderbird-l10n-it,
# thunderbird-l10n-pt-br): those apt does not know are discarded automatically
_LANG = (os.environ.get("LANG") or "").split(".")[0].split("@")[0].lower()
if _LANG and _LANG not in ("c", "posix", "en_us", "en"):
    for _name in dict.fromkeys([_LANG.replace("_", "-"), _LANG.split("_")[0]]):
        PACKAGES.append("thunderbird-l10n-" + _name)


def _exe():
    return shutil.which("thunderbird")


def _processes():
    """PIDs of this user's main Thunderbird processes."""
    try:
        r = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "thunderbird"],
                           capture_output=True, text=True, timeout=3)
        return [int(p) for p in r.stdout.split()]
    except (OSError, subprocess.SubprocessError, ValueError):
        return []


def _windows():
    """Thunderbird windows, most recently used first."""
    from system import windows
    ff = [c for c in windows.clients()
          if "thunderbird" in (c.get("class") or c.get("initialClass") or "").lower()]
    ff.sort(key=lambda c: c.get("focusHistoryID", 1 << 30))
    return ff


def _notify(title, text, operation=None):
    cmd = ["notify-send", "-a", "ZETA RAYS", "-i", "zeta-mail", title, text]
    if operation:
        cmd[1:1] = ["-A", "install=%s" % operation, "-w"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120 if operation else 5)
        return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def _install():
    """Thunderbird is missing: explain why and, if apt knows it, offer to
    install it (in the terminal, with the password asked by pkexec)."""
    from system import packages
    available = packages.availability(PACKAGES)
    installable = [p for p in PACKAGES if available[p]["candidate"]]
    if "thunderbird" not in installable:
        _notify(tr("Mail: Thunderbird is not installed"),
                  packages.why_missing("thunderbird"))
        return 1
    if _notify(tr("Mail: Thunderbird is not installed"),
                 tr("ZETA RAYS Mail uses Mozilla Thunderbird. Do you want to install it now?"),
                 operation=tr("Install")) != "install":
        return 1
    script = ('printf "\\033[1;34m%%s\\033[0m\\n\\n" %s; '
              'pkexec apt-get install -y %s && zeta-mail; '
              'printf "\\n\\033[2m%%s\\033[0m" %s; read _') % (
        shlex.quote(tr("ZETA RAYS — installing Mail (Thunderbird)")),
        " ".join(installable),
        shlex.quote(tr("Press Enter to close.")))
    subprocess.Popen(["foot", "-e", "sh", "-c", script], start_new_session=True)
    return 0


def _spawn(*arg):
    subprocess.Popen([_exe()] + list(arg), start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     stdin=subprocess.DEVNULL, cwd=os.path.expanduser("~"))


def open_at():
    if not _exe():
        return _install()
    ff = _windows()
    if ff:
        from system import windows
        f = ff[0]
        if str((f.get("workspace") or {}).get("name", "")).startswith("special:"):
            windows.restore(f["address"])
        else:
            windows.focus(f["address"])
        return 0
    # No window: start it. If Thunderbird is still starting up, the second
    # call is received by the copy already running (Mozilla keeps only one
    # per profile): no duplicates.
    _spawn()
    return 0


def new():
    if not _exe():
        return _install()
    _spawn("-compose")
    return 0


def quit_mail():
    """Like "Quit" from Thunderbird's menu: close the windows (it may ask to
    save a draft). If it has not exited after 10 seconds, SIGTERM: for
    Thunderbird that is still an orderly shutdown. Never SIGKILL from here."""
    from system import windows
    for f in _windows():
        windows.close(f["address"])
    for _ in range(40):
        if not _processes():
            return 0
        time.sleep(0.25)
    for pid in _processes():
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    return 0


def state():
    is_open = bool(_processes())
    print(OPEN_ICON if is_open and os.path.exists(OPEN_ICON) else ICON)
    print(tr("Mail (open)") if is_open else tr("Mail"))
    return 0


def menu():
    from ui import popup
    popup.preload_layer_shell()
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio, Gtk

    at_top = False
    try:
        at_top = open(os.path.expanduser("~/.config/zeta/dock-position")).read().strip() == "top"
    except OSError:
        pass
    is_open = bool(_processes())
    entries = [(tr("Open Mail"), open_at), (tr("New Message"), new)]
    if is_open:
        entries.append((tr("Quit Thunderbird"), quit_mail))

    class Menu(Gtk.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title=tr("Mail"), decorated=False)
            popup.make_overlay(self, "zeta-menu-dock")
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                           css_classes=["zeta-card"], halign=Gtk.Align.START,
                           valign=Gtk.Align.START if at_top else Gtk.Align.END)
            # under the cursor, on its monitor, always inside the screen
            popup.menu_at_cursor(self, card, 220)
            if at_top:
                card.set_margin_top(84)
            else:
                card.set_margin_bottom(84)
            for i, (text, fn) in enumerate(entries):
                b = Gtk.Button(css_classes=["zeta-row"])
                b.set_child(Gtk.Label(label=text, xalign=0))
                b.connect("clicked", lambda _b, f=fn: self.run_action(f))
                card.append(b)
            card.set_size_request(220, -1)
            card.set_margin_end(8)
            self.set_child(card)
            popup.close_on_outside(self, card, self.close_window)

        def run_action(self, fn):
            self.set_visible(False)
            fn()
            self.close_window()

        def close_window(self):
            self.get_application().quit()
            return False

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="org.zetarays.MailMenu",
                             flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

        def do_startup(self):
            Gtk.Application.do_startup(self)
            popup.clean_env()
            popup.load_css(".zeta-card { padding: 6px; }")

        def do_activate(self):
            if self.props.active_window:
                self.quit()
                return
            Menu(self).present()

    return App().run([sys.argv[0]])


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "open"
    actions = {"open": open_at, "new": new, "quit": quit_mail, "status": state, "menu": menu}
    if cmd not in actions:
        print(USAGE)
        return 1
    return actions[cmd]() or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""zeta-dock — generates and reloads the ZETA RAYS dock from ~/.config/zeta/dock.json.

  zeta-dock apply     regenerate the bar from the saved dock and reload it
  zeta-dock generate  regenerate only, without reloading the bar
  zeta-dock reset     restore the default dock
  zeta-dock menu N    right-click menu for dock icon N
  zeta-dock remove N  remove icon N from the dock
"""
import subprocess
import sys

sys.path.insert(0, "/usr/lib/zeta")
from system import dock  # noqa: E402
from i18n import tr  # noqa: E402

# "App Settings": the command that really opens that app's preferences.
# For the others the app is opened and the user is told where to find them:
# better than a menu entry that does nothing.
SETTINGS_APPS = {
    "thunar": ["thunar-settings"],
    "firefox-esr": ["firefox-esr", "about:preferences"],
    "foot": ["zeta-settings", "appearance"],
    "zeta-settings": ["zeta-settings"],
    "zeta-security": ["zeta-security"],
    "zeta-mail": ["zeta-settings", "default-apps"],
}


def _spawn(argv):
    subprocess.Popen(argv, start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _notify(text):
    try:
        _spawn(["notify-send", "-a", "Dock", "-i", "zeta-dock", tr("Dock"), text])
    except OSError:
        pass


def _app_of_entry(entry):
    """The installed app behind a dock icon (to know whether it is open)."""
    from intelligence.agent import state
    for app_name in (entry.get("cmd", "").split()[0] if entry.get("cmd") else "", entry.get("name", "")):
        a = state.find_app(app_name) if app_name else None
        if a:
            return a
    return None


def remove(i):
    entries = dock.load_dock()
    if not 0 <= i < len(entries):
        return 1
    if len(entries) == 1:
        _notify(tr("The dock must contain at least one app."))
        return 1
    app_name = entries[i].get("name", "")
    del entries[i]
    dock.save_dock(entries)
    dock.apply(entries)
    _notify(tr("Removed from the dock: {name}. Add it back in Settings › Dock.").format(name=app_name))
    return 0


def menu(i):
    entries = dock.load_dock()
    if not 0 <= i < len(entries):
        return 1
    entry = entries[i]
    app_name = entry.get("name") or entry.get("cmd", "").split()[0]
    from ui import popup
    popup.preload_layer_shell()
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio, Gtk

    at_top = dock.position() == "top"
    app = _app_of_entry(entry)
    from intelligence.agent import state
    is_open = bool(app and state.windows_of(app))

    def open_at():
        _spawn(["sh", "-c", entry["cmd"]])

    def close_window():
        from intelligence.agent import agent
        es = agent.execute("close_application", {"app": app.id}, origin="dock")
        if not es.ok:
            _notify(es.message)

    def options():
        _spawn(["zeta-settings", "dock"])

    def app_settings():
        prog = entry.get("cmd", "").split()[0]
        cmd = SETTINGS_APPS.get(prog)
        if cmd:
            _spawn(cmd)
        else:
            open_at()
            _notify(tr("{name} settings are in its own menu.").format(name=app_name))

    lines = [(tr("Open"), open_at)]
    for text, command in entry.get("actions", []):          # the app's own entries
        lines.append((text, lambda c=command: _spawn(["sh", "-c", c])))
    if is_open:
        lines.append((tr("Close"), close_window))
    lines += [None, (tr("Remove from Dock"), lambda: remove(i)), (tr("Options"), options),
              (tr("App Settings"), app_settings)]

    class Menu(Gtk.ApplicationWindow):
        def __init__(self, gapp):
            super().__init__(application=gapp, title=app_name, decorated=False)
            popup.make_overlay(self, "zeta-menu-dock")
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                           css_classes=["zeta-card"], halign=Gtk.Align.START,
                           valign=Gtk.Align.START if at_top else Gtk.Align.END)
            # under the cursor, on its monitor, always inside the screen
            popup.menu_at_cursor(self, card, 220)
            if at_top:
                card.set_margin_top(84)
            else:
                card.set_margin_bottom(84)
            title = Gtk.Label(label=app_name, xalign=0, css_classes=["zeta-caption"])
            title.set_margin_start(10)
            title.set_margin_top(4)
            card.append(title)
            for r in lines:
                if r is None:
                    card.append(Gtk.Separator(margin_top=3, margin_bottom=3))
                    continue
                text, fn = r
                b = Gtk.Button(css_classes=["zeta-row"])
                b.set_child(Gtk.Label(label=text, xalign=0))
                b.connect("clicked", lambda _b, f=fn: self.run_action(f))
                card.append(b)
            card.set_size_request(220, -1)
            card.set_margin_end(8)
            self.set_child(card)
            popup.close_on_outside(self, card, self.close_window)

        def run_action(self, fn):
            self.set_visible(False)
            try:
                fn()
            finally:
                self.close_window()

        def close_window(self):
            self.get_application().quit()
            return False

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="org.zetarays.MenuDock",
                             flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

        def do_startup(self):
            Gtk.Application.do_startup(self)
            popup.clean_env()
            popup.load_css(".zeta-card { padding: 6px; }")

        def do_activate(self):
            if self.props.active_window:
                self.quit()
                return
            Menu(self).present()

    return App().run([sys.argv[0]])


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "apply"
    if cmd == "reset":
        dock.save_dock(dock.DEFAULT)
        dock.apply(dock.DEFAULT)
        return 0
    if cmd == "apply":
        return 0 if dock.apply() else 1
    if cmd == "generate":
        return 0 if dock.apply(reload=False) else 1
    if cmd in ("menu", "remove") and len(argv) > 2 and argv[2].isdigit():
        return (menu if cmd == "menu" else remove)(int(argv[2]))
    print(tr("""zeta-dock — generates and reloads the ZETA RAYS dock from ~/.config/zeta/dock.json.

  zeta-dock apply     regenerate the bar from the saved dock and reload it
  zeta-dock generate  regenerate only, without reloading the bar
  zeta-dock reset     restore the default dock
  zeta-dock menu N    right-click menu for dock icon N
  zeta-dock remove N  remove icon N from the dock"""))
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))

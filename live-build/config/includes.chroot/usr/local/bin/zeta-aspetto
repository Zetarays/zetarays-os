#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""zeta-aspetto — testo, icone, cursore, scala e tema della scrivania.

  zeta-aspetto get                 stampa i valori attuali (chiave=valore)
  zeta-aspetto set <chiave> <val>  cambia un valore e lo applica subito
  zeta-aspetto apply               riapplica tutto (all'avvio della sessione)
  zeta-aspetto cambia-tema         passa da scuro a chiaro e viceversa
                                   (scorciatoia da tastiera: SUPER + T)

Chiavi:
  tema          scuro | chiaro
  editor-tema   sistema | chiaro | scuro   (sfondo dell'editor di testo:
                «chiaro» = sfondo bianco e testo nero, «scuro» = sfondo nero
                e testo bianco, «sistema» = come il tema della scrivania)
  font-size     dimensione del testo dell'interfaccia (8–16)
  icon-size     dimensione delle icone del dock (28–64)
  cursor-size   dimensione del puntatore (16–48)
  scala         auto | 1 | 1.25 | 1.5 | 2   (ingrandimento dell'interfaccia)
  scrivania     1 | 0   (mostra o nasconde le icone sulla scrivania)
  animazioni    1 | 0   (animazioni di finestre e interfaccia)
  trasparenza   1 | 0   (sfocatura e trasparenza di pannelli e terminale)
  angoli        0–24    (arrotondamento degli angoli delle finestre)
  spaziatura    0–48    (spazio fra le icone della scrivania)
  schermo-spegni  minuti di inattività prima di spegnere lo schermo (0 = mai)
  blocco-auto     minuti di inattività prima del blocco (0 = mai)
  notifiche-posizione  angolo in cui compaiono le notifiche
  notifiche-durata     secondi di permanenza di una notifica
  non-disturbare  1 | 0 (silenzia le notifiche)
  dock-posizione  bottom | top
  ai-precarica    auto | 1 | 0  (tiene il modello AI in memoria per risposte
                  immediate: «auto» lo fa solo se il computer ha RAM in
                  abbondanza, perché occupa circa 1,8 GB)

Ogni valore è un file in ~/.config/zeta/: semplice da leggere anche dagli
script di avvio. Le modifiche di tema e colore passano da zeta-accent, che
rigenera i colori di tutte le app.
"""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr  # noqa: E402

CFG = os.path.expanduser("~/.config/zeta")
HYPRCFG = os.path.expanduser("~/.config/hypr")

KEYS = {
    "tema":        ("scuro", lambda v: v in ("scuro", "chiaro")),
    "font-size":   ("10", lambda v: v.isdigit() and 8 <= int(v) <= 16),
    "icon-size":   ("42", lambda v: v.isdigit() and 28 <= int(v) <= 64),
    "cursor-size": ("24", lambda v: v.isdigit() and 16 <= int(v) <= 48),
    "scala":       ("auto", lambda v: v == "auto" or _is_scale(v)),
    "scrivania":   ("1", lambda v: v in ("0", "1")),
    "animazioni":  ("1", lambda v: v in ("0", "1")),
    "trasparenza": ("1", lambda v: v in ("0", "1")),
    "angoli":      ("14", lambda v: v.isdigit() and 0 <= int(v) <= 24),
    "spaziatura":  ("14", lambda v: v.isdigit() and 0 <= int(v) <= 48),
    "schermo-spegni": ("10", lambda v: v.isdigit() and 0 <= int(v) <= 120),
    "blocco-auto": ("10", lambda v: v.isdigit() and 0 <= int(v) <= 120),
    "notifiche-posizione": ("top-right", lambda v: v in (
        "top-right", "top-center", "top-left", "bottom-right", "bottom-left")),
    "notifiche-durata": ("5", lambda v: v.isdigit() and 1 <= int(v) <= 60),
    "non-disturbare": ("0", lambda v: v in ("0", "1")),
    "dock-posizione": ("bottom", lambda v: v in ("bottom", "top")),
    "ai-precarica": ("auto", lambda v: v in ("auto", "0", "1")),
    "editor-tema": ("sistema", lambda v: v in ("sistema", "chiaro", "scuro")),
}


def _is_scale(v):
    try:
        return 0.5 <= float(v) <= 3.0
    except ValueError:
        return False


def get(key):
    default = KEYS[key][0]
    try:
        with open(os.path.join(CFG, key)) as f:
            v = f.read().strip()
    except OSError:
        return default
    return v if KEYS[key][1](v) else default


def put(key, value):
    os.makedirs(CFG, exist_ok=True)
    with open(os.path.join(CFG, key), "w") as f:
        f.write(value)


def _gsettings(schema, key, value):
    subprocess.run(["gsettings", "set", schema, key, value],
                   capture_output=True, check=False)


def _run(cmd, env=None):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=40,
                              env=env)
    except (OSError, subprocess.SubprocessError):
        return None


def _run_env(cmd, extra):
    return _run(cmd, env=dict(os.environ, **extra))


def in_session():
    return bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"))


def apply_fonts():
    n = get("font-size")
    iface = "org.gnome.desktop.interface"
    _gsettings(iface, "font-name", "Roboto %s" % n)
    _gsettings(iface, "document-font-name", "Roboto %s" % n)
    _gsettings(iface, "monospace-font-name", "JetBrains Mono %s" % n)


def apply_editor():
    """Sfondo chiaro o scuro dell'editor di testo (GNOME Text Editor).

    Si cambia solo lo schema dei colori del testo, mai il modo chiaro/scuro
    dell'app: «style-variant» resta sempre «follow». Prima «light» e «dark»
    forzavano tutta l'app in un modo diverso da quello della scrivania: GTK
    e libadwaita dovevano tenere due modi insieme (la barra e i dialoghi
    restavano dell'altro colore) e a ogni passaggio, anche chiudendo la
    finestra, l'app si ridisegnava nell'altro modo: lo sfarfallio.
    zeta-carta e zeta-notte (usr/share/gtksourceview-5/styles) sono uno
    schema chiaro e uno scuro che l'editor non scambia mai.
    """
    schema = {"sistema": "Adwaita", "chiaro": "zeta-carta", "scuro": "zeta-notte"}[get("editor-tema")]
    _gsettings("org.gnome.TextEditor", "style-variant", "follow")
    _gsettings("org.gnome.TextEditor", "style-scheme", schema)


def apply_cursor():
    size = get("cursor-size")
    _gsettings("org.gnome.desktop.interface", "cursor-size", size)
    if in_session():
        _run(["hyprctl", "setcursor", "Adwaita", size])


def apply_scale():
    """Scrive la scala per Hyprland (auto = calcolata dai DPI dello schermo).

    Restituisce la scala se è cambiata, None se era già quella.
    """
    scala = get("scala")
    if scala == "auto":
        r = _run(["zeta-display-scale"])
        scala = (r.stdout.strip() if r and r.returncode == 0 else "") or "1"
    os.makedirs(HYPRCFG, exist_ok=True)
    path = os.path.join(HYPRCFG, "zeta_monitor.lua")
    want = "return { scale = %s }\n" % scala
    try:
        if open(path).read() == want:
            return None
    except OSError:
        pass
    with open(path, "w") as f:
        f.write(want)
    return scala


def apply_hypr_env():
    """Valori letti da hyprland.lua: cursore, tema, effetti."""
    os.makedirs(HYPRCFG, exist_ok=True)
    with open(os.path.join(HYPRCFG, "zeta_aspetto.lua"), "w") as f:
        f.write('return { cursor = %s, font = %s, tema = "%s",\n'
                '         animazioni = %s, trasparenza = %s, angoli = %s }\n'
                % (get("cursor-size"), get("font-size"), get("tema"),
                   "true" if get("animazioni") == "1" else "false",
                   "true" if get("trasparenza") == "1" else "false",
                   get("angoli")))


def apply_inattivita():
    """Spegnimento schermo e blocco automatico (hypridle)."""
    spegni = int(get("schermo-spegni"))
    blocco = int(get("blocco-auto"))
    righe = ["# ZETA RAYS — generated by zeta-aspetto (Settings › Display & Lock).",
             "general {",
             "    lock_cmd = pidof hyprlock || hyprlock",
             "    before_sleep_cmd = loginctl lock-session",
             # la sospensione aspetta che il blocco sia davvero a schermo:
             # al risveglio non si vede mai la scrivania, nemmeno un attimo
             "    inhibit_sleep = 3",
             "    after_sleep_cmd = sleep 3; zeta-barra controlla",
             "}",
             ""]
    if blocco:
        righe += ["listener {", "    timeout = %d" % (blocco * 60),
                  "    on-timeout = loginctl lock-session", "}", ""]
    if spegni:
        righe += ["listener {", "    timeout = %d" % (spegni * 60),
                  "    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = \"off\" })'",
                  # dopo la riaccensione dello schermo Waybar a volte duplica
                  # la barra: si controlla che sia rimasta una (zeta-barra)
                  "    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = \"on\" })'; sleep 3; zeta-barra controlla",
                  "}", ""]
    os.makedirs(HYPRCFG, exist_ok=True)
    with open(os.path.join(HYPRCFG, "hypridle.conf"), "w") as f:
        f.write("\n".join(righe))
    if in_session():
        # hypridle rilegge la configurazione solo riavviandosi
        subprocess.run(["pkill", "-x", "hypridle"], capture_output=True)
        if spegni or blocco:
            subprocess.Popen(["hypridle"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def apply_notifiche():
    """Aspetto e comportamento delle notifiche (mako)."""
    conf = os.path.expanduser("~/.config/mako")
    os.makedirs(conf, exist_ok=True)
    accent = "#3A8DFF"
    try:
        with open(os.path.join(CFG, "accent")) as f:
            accent = f.read().strip() or accent
    except OSError:
        pass
    chiaro = get("tema") == "chiaro"
    sfondo = "#FFFFFFEE" if chiaro else "#141416EE"
    testo = "#1C1C1E" if chiaro else "#EDEDEA"
    testo_conf = """# ZETA RAYS — notifications (generated by zeta-aspetto).
font=Roboto %s
background-color=%s
text-color=%s
border-color=%s
border-size=1
border-radius=14
width=360
padding=14
margin=12
outer-margin=12
anchor=%s
default-timeout=%d
icon-path=/usr/share/icons/zeta

# Do Not Disturb (from the Control Center or Settings)
[mode=do-not-disturb]
invisible=1
""" % (get("font-size"), sfondo, testo, accent, get("notifiche-posizione"),
       int(get("notifiche-durata")) * 1000)
    with open(os.path.join(conf, "config"), "w") as f:
        f.write(testo_conf)
    if in_session():
        _run(["makoctl", "reload"])
        _run(["makoctl", "mode", "-s",
              "do-not-disturb" if get("non-disturbare") == "1" else "default"])


def apply_terminale_trasparenza():
    """La trasparenza del terminale segue la preferenza generale."""
    ini = os.path.expanduser("~/.config/foot/foot.ini")
    try:
        with open(ini) as f:
            righe = f.read().split("\n")
    except OSError:
        return
    alpha = "0.96" if get("trasparenza") == "1" else "1.0"
    for i, r in enumerate(righe):
        if r.startswith("alpha="):
            righe[i] = "alpha=" + alpha
    try:
        with open(ini, "w") as f:
            f.write("\n".join(righe))
    except OSError:
        pass


def apply_scrivania(riavvia=False):
    """Avvia o chiude le icone della scrivania secondo la preferenza.

    Con riavvia=True le riapre anche se erano già attive: colori e dimensione
    delle icone vengono letti all'avvio, quindi al cambio di tema o di
    dimensione vanno rilette."""
    if not in_session():
        return
    attive = get("scrivania") == "1"
    viva = subprocess.run(["pgrep", "-f", "/usr/local/bin/zeta-scrivania"],
                          capture_output=True).returncode == 0
    if viva and (not attive or riavvia):
        subprocess.run(["pkill", "-f", "/usr/local/bin/zeta-scrivania"],
                       capture_output=True)
        viva = False
    if attive and not viva:
        subprocess.Popen(["zeta-scrivania"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def apply(reload_hypr=True, riavvia_scrivania=False):
    apply_fonts()
    apply_hypr_env()
    scala_nuova = apply_scale()
    apply_cursor()
    apply_editor()
    # Prima i colori: zeta-accent rigenera la tavolozza, il tema GTK, il
    # terminale, lo sfondo e le icone della barra, e ricarica Hyprland. Non
    # ricarica la barra: lo fa il dock subito dopo, una volta sola (due
    # ricariche ravvicinate fanno cadere Waybar).
    _run_env(["zeta-accent"], {"ZETA_NO_BAR_RELOAD": "1"})
    # Poi il dock, che rilegge le icone appena ricolorate e ricarica la barra.
    _run(["zeta-dock", "apply"])
    apply_inattivita()
    apply_notifiche()
    apply_terminale_trasparenza()
    apply_scrivania(riavvia_scrivania)
    if reload_hypr and scala_nuova and in_session():
        # Si riconfigura solo lo schermo. Un «hyprctl reload» completo
        # toglierebbe la barra del titolo a tutte le finestre già aperte,
        # lasciando l'utente senza i pulsanti finché non le riapre.
        _run(["hyprctl", "eval",
              'hl.monitor({ output = "", mode = "preferred", '
              'position = "auto", scale = %s })' % scala_nuova])
    return 0


def _usage():
    return tr("""zeta-aspetto — desktop text, icons, pointer, scale and theme.

  zeta-aspetto get                 print the current values (key=value)
  zeta-aspetto set <key> <value>   change a value and apply it right away
  zeta-aspetto apply               apply everything again (at session start)
  zeta-aspetto cambia-tema         switch between dark and light
                                   (keyboard shortcut: SUPER + T)

Keys:
  tema          scuro | chiaro   (dark | light)
  editor-tema   sistema | chiaro | scuro   (text editor background:
                «chiaro» = white background and black text, «scuro» = black
                background and white text, «sistema» = follow the desktop theme)
  font-size     interface text size (8–16)
  icon-size     dock icon size (28–64)
  cursor-size   pointer size (16–48)
  scala         auto | 1 | 1.25 | 1.5 | 2   (interface scale)
  scrivania     1 | 0   (show or hide the desktop icons)
  animazioni    1 | 0   (window and interface animations)
  trasparenza   1 | 0   (blur and transparency of panels and terminal)
  angoli        0–24    (window corner rounding)
  spaziatura    0–48    (spacing between desktop icons)
  schermo-spegni  idle minutes before the screen turns off (0 = never)
  blocco-auto     idle minutes before the screen locks (0 = never)
  notifiche-posizione  corner where notifications appear
  notifiche-durata     seconds a notification stays on screen
  non-disturbare  1 | 0 (silence notifications)
  dock-posizione  bottom | top
  ai-precarica    auto | 1 | 0  (keep the AI model in memory for instant
                  replies: «auto» does so only if the computer has plenty
                  of RAM, since it takes about 1.8 GB)

Each value is a file in ~/.config/zeta/, easy to read from startup scripts
too. Theme and color changes go through zeta-accent, which regenerates the
colors of every app.""")


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "apply"
    if cmd == "apply":
        return apply()
    if cmd == "cambia-tema":
        nuovo = "chiaro" if get("tema") == "scuro" else "scuro"
        put("tema", nuovo)
        # riavvia_scrivania: le icone leggono i colori all'avvio, senza questo
        # resterebbero del tema precedente finché non si riapre la sessione.
        rc = apply(riavvia_scrivania=True)
        if nuovo == "chiaro":
            titolo = tr("Light theme")
            testo = tr("Press SUPER + T again to switch back to the dark theme.")
        else:
            titolo = tr("Dark theme")
            testo = tr("Press SUPER + T again to switch back to the light theme.")
        _run(["notify-send", "-a", "ZETA RAYS", "-i", "zeta-impostazioni",
              titolo, testo])
        return rc
    if cmd == "get":
        for k in KEYS:
            print("%s=%s" % (k, get(k)))
        return 0
    if cmd == "set" and len(argv) > 3:
        key, value = argv[2], argv[3]
        if key not in KEYS:
            print(tr("Unknown key: {key}").format(key=key), file=sys.stderr)
            return 1
        if not KEYS[key][1](value):
            print(tr("Invalid value for {key}: {value}").format(key=key, value=value),
                  file=sys.stderr)
            return 1
        put(key, value)
        if key == "editor-tema":
            # Solo l'editor. Prima qui si rifaceva tutto (colori, tema GTK,
            # barra ricaricata, scrivania, terminale): cambiare lo sfondo
            # bianco/nero dell'editor ridisegnava l'intero desktop.
            apply_editor()
            return 0
        # tema e dimensione icone si leggono all'avvio della scrivania
        return apply(riavvia_scrivania=key in ("tema", "icon-size", "spaziatura"))
    print(_usage())
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))

#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS — «Incolla qui come amministratore» e «Apri come amministratore».

Il gestore file non puo' scrivere in /opt, /usr/local e nelle altre cartelle
di sistema: prima l'unica strada era il terminale. Qui:

  zeta-incolla-amministratore incolla CARTELLA   incolla i file copiati (Ctrl+C,
                                                 dalla scrivania o dal gestore
                                                 file) chiedendo la password
  zeta-incolla-amministratore apri CARTELLA      apre la cartella nel gestore
                                                 file con i permessi di
                                                 amministratore (admin://)

La copia vera la fa /usr/libexec/zeta-copia-amministratore tramite pkexec:
la password la chiede il sistema, questo programma non la vede mai.
"""
import json
import os
import subprocess
import sys
from urllib.parse import unquote, urlparse

AIUTANTE = "/usr/libexec/zeta-copia-amministratore"


def avvisa(titolo, testo="", errore=False):
    cmd = ["notify-send", "-a", "Gestore file", "-i",
           "dialog-error" if errore else "system-file-manager", titolo]
    if testo:
        cmd.append(testo)
    try:
        subprocess.run(cmd, timeout=5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def appunti():
    """(azione, [percorsi]) dagli appunti: «copy» o «cut» come i gestori file."""
    for tipo in ("x-special/gnome-copied-files", "text/uri-list"):
        try:
            r = subprocess.run(["wl-paste", "--no-newline", "-t", tipo],
                               capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.SubprocessError):
            continue
        if r.returncode != 0 or not r.stdout.strip():
            continue
        righe = [x.strip() for x in r.stdout.replace("\r", "").split("\n") if x.strip()]
        azione = "copia"
        if tipo == "x-special/gnome-copied-files" and righe and righe[0] in ("copy", "cut"):
            azione = "sposta" if righe[0] == "cut" else "copia"
            righe = righe[1:]
        percorsi = []
        for u in righe:
            if u.startswith("#"):
                continue
            p = urlparse(u)
            if p.scheme == "file":
                percorsi.append(unquote(p.path))
        if percorsi:
            return azione, percorsi
    return None, []


def chiedi_conflitto(dest, nomi):
    """Sostituisci / Mantieni entrambi / Annulla, con una finestra semplice."""
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gio
    scelta = {"r": None}
    app = Adw.Application(application_id="org.zetarays.IncollaAmministratore",
                          flags=Gio.ApplicationFlags.NON_UNIQUE)

    def attiva(a):
        elenco = ", ".join("«%s»" % n for n in nomi[:4]) + (" e altri" if len(nomi) > 4 else "")
        d = Adw.AlertDialog(
            heading="Esiste già in %s" % dest,
            body="%s %s già in questa cartella. Cosa vuoi fare?"
                 % (elenco, "c'è" if len(nomi) == 1 else "ci sono"))
        d.add_response("annulla", "Annulla")
        d.add_response("entrambi", "Mantieni entrambi")
        d.add_response("sostituisci", "Sostituisci")
        d.set_response_appearance("sostituisci", Adw.ResponseAppearance.DESTRUCTIVE)
        d.set_default_response("entrambi")
        d.set_close_response("annulla")

        def risposta(_d, r):
            scelta["r"] = r
            a.quit()
        d.connect("response", risposta)
        a.hold()
        d.present(None)
    app.connect("activate", attiva)
    app.run([])
    return scelta["r"] or "annulla"


def incolla(dest):
    dest = os.path.realpath(dest)
    if not os.path.isdir(dest):
        avvisa("Cartella non trovata", dest, errore=True)
        return 1
    azione, sorgenti = appunti()
    if not sorgenti:
        avvisa("Niente da incollare",
               "Prima copia i file (tasto destro › Copia, oppure Ctrl+C), poi riprova.")
        return 1
    sorgenti = [s for s in sorgenti if os.path.lexists(s)]
    if not sorgenti:
        avvisa("I file copiati non esistono più", errore=True)
        return 1
    doppi = [os.path.basename(s.rstrip("/")) for s in sorgenti
             if os.path.lexists(os.path.join(dest, os.path.basename(s.rstrip("/"))))
             and os.path.dirname(os.path.realpath(s)) != dest]
    conflitto = "entrambi"
    if doppi:
        conflitto = chiedi_conflitto(dest, doppi)
        if conflitto == "annulla":
            return 1
    try:
        r = subprocess.run(["pkexec", AIUTANTE, azione, conflitto, dest, "--"] + sorgenti,
                           capture_output=True, text=True)
    except OSError as e:
        avvisa("Copia non riuscita", str(e), errore=True)
        return 1
    if r.returncode == 126 and not r.stdout.strip():
        avvisa("Copia annullata", "Senza la password i file non sono stati copiati.")
        return 1
    if r.returncode == 127 and not r.stdout.strip():
        avvisa("Non è stato possibile chiedere la password",
               (r.stderr or "pkexec non ha risposto").strip()[:300], errore=True)
        return 1
    try:
        esito = json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        avvisa("Copia non riuscita", (r.stderr or "errore sconosciuto").strip()[:200], errore=True)
        return 1
    fatti, errori = esito.get("fatti", []), esito.get("errori", [])
    if fatti:
        verbo = "Spostati" if azione == "sposta" else "Copiati"
        if len(fatti) == 1:
            verbo = verbo[:-1] + "o"
        avvisa("%s in %s" % (verbo, dest), ", ".join(fatti[:6]) + (" …" if len(fatti) > 6 else ""))
    if errori:
        avvisa("Alcuni file non sono stati copiati", "\n".join(errori[:5]), errore=True)
    if azione == "sposta" and fatti:
        # gli appunti puntano a file che non ci sono piu'
        subprocess.run(["wl-copy", "--clear"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0 if not errori else 1


def apri(dest):
    dest = os.path.realpath(dest)
    try:
        subprocess.Popen(["thunar", "admin://" + dest], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as e:
        avvisa("Non si apre", str(e), errore=True)
        return 1
    return 0


def main(argv):
    if len(argv) != 2 or argv[0] not in ("incolla", "apri"):
        print(__doc__)
        return 2
    cartella = argv[1]
    if cartella.startswith("file://"):
        cartella = unquote(urlparse(cartella).path)
    return incolla(cartella) if argv[0] == "incolla" else apri(cartella)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

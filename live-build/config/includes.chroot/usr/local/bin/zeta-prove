@prova("intelligenza")
def voce_naturale_parla():
    """La voce di ZETA: Piper deve trasformare davvero una frase in audio, in
    italiano e in inglese (le altre lingue usano espeak-ng)."""
    import tempfile
    from intelligence import speech
    fatte = []
    for lingua, frase in (("it", "Ciao, sono ZETA."), ("en", "Hello, I am ZETA.")):
        voce = speech._voce_naturale(lingua)
        if voce is None:
            return False, tr("no natural voice for {language}").format(language=lingua)
        with tempfile.NamedTemporaryFile(suffix=".wav") as wav:
            r = subprocess.run([speech.PIPER, "--model", voce[0], "--output_file", wav.name],
                               input=frase, capture_output=True, text=True, timeout=60)
            if r.returncode != 0 or os.path.getsize(wav.name) < 10000:
                return False, tr("{language}: no audio").format(language=lingua)
        fatte.append(lingua)
    return True, tr("Piper speaks: {languages}").format(languages=", ".join(fatte))


@prova("impostazioni")
def libreria_font_legge_i_caratteri():
    """Impostazioni › Fonts: fontconfig risponde e i caratteri di ZETA ci sono."""
    from ui import pagina_font
    fam = pagina_font.famiglie()
    mancano = [f for f in ("Roboto", "JetBrains Mono") if f not in fam]
    if mancano:
        return False, tr("missing: {names}").format(names=", ".join(mancano))
    return True, ntr("{n} font family", "{n} font families", len(fam)).format(n=len(fam))

# ------------------------------------------- finestre, schermi, aspetto
_FUORI_SCHERMO = """
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib
w = Gtk.Window(title="zeta-prove fuori schermo")
w.add(Gtk.Label(label="zeta-prove"))
w.set_default_size(700, 500)
w.connect("destroy", Gtk.main_quit)
w.show_all()
def via():
    w.move(-400, -300); w.resize(2600, 1800)      # come un'app con una geometria rovinata
    return False
GLib.timeout_add(2500, via)      # dopo i controlli all apertura: si prova il guardiano continuo
Gtk.main()
"""


def _area_utile():
    """{nome: (x0, y0, x1, y1)} in coordinate logiche, senza la barra."""
    rc, out, _e = _sh(["hyprctl", "-j", "monitors"])
    aree = {}
    for m in json.loads(out or "[]"):
        sc = m.get("scale") or 1
        w, h = m["width"] / sc, m["height"] / sc
        if m.get("transform", 0) % 2:
            w, h = h, w
        r = m.get("reserved", [0, 0, 0, 0])      # sinistra, alto, destra, basso
        aree[m["id"]] = (m["x"] + r[0], m["y"] + r[1], m["x"] + w - r[2], m["y"] + h - r[3])
    return aree


@prova("finestre")
def finestre_sempre_raggiungibili():
    """Una finestra X11 che dopo l'apertura si sposta da sola a (-400, -300) e
    diventa 2600x1800 torna dentro l'area utile, con la barra del titolo e i
    pulsanti raggiungibili (guardiano in hyprland.lua)."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _fuori_sessione()
    env = dict(os.environ, GDK_BACKEND="x11")
    proc = subprocess.Popen([sys.executable, "-c", _FUORI_SCHERMO], env=env,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        fine = time.monotonic() + 15
        visto_fuori = False
        while time.monotonic() < fine:
            time.sleep(0.4)
            rc, out, _e = _sh(["hyprctl", "-j", "clients"])
            c = next((c for c in json.loads(out or "[]") if c.get("title") == "zeta-prove fuori schermo"), None)
            if not c:
                continue
            x, y = c["at"]
            w, h = c["size"]
            if x < 0 or y < 0:
                visto_fuori = True
                continue
            area = _area_utile().get(c["monitor"])
            if not visto_fuori or not area:
                continue
            x0, y0, x1, y1 = area
            if y - 32 >= y0 and x >= x0 and x + w <= x1 + 1 and y + h <= y1 + 1:
                return True, tr("back inside: {x},{y} {w}x{h}").format(x=x, y=y, w=w, h=h)
        return False, tr("the window stayed out of reach") if visto_fuori else \
            tr("the test window did not move out (nothing to check)")
    finally:
        proc.kill()


@prova("impostazioni")
def schermi_letti_e_impostazioni_valide():
    """Impostazioni › Schermi: gli schermi si leggono da Hyprland con le loro
    modalita'; le scale proposte sono solo quelle accettate e usabili; una
    configurazione con tutti gli schermi spenti e' rifiutata."""
    from system import schermi
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _fuori_sessione()
    v = schermi.leggi()
    if not v:
        return False, tr("no displays from hyprctl")
    m = v[0]
    if not m["modi"] or schermi.nativa(m) is None:
        return False, tr("{name}: no modes").format(name=m["nome"])
    if schermi.scale_valide(1280, 800) != [1.0, 1.25] or 1.5 in schermi.scale_valide(1280, 800):
        return False, "scale 1280x800: %r" % schermi.scale_valide(1280, 800)
    conf = schermi.configurazione(v)
    for c in conf.values():
        c["acceso"] = False
    if schermi.controlla(conf) is None:
        return False, tr("all displays off was accepted")
    return True, ntr("{n} display, {modes} modes on the first",
                     "{n} displays, {modes} modes on the first", len(v)).format(n=len(v), modes=len(m["modi"]))


@prova("impostazioni")
def avatar_nei_colori_del_sistema():
    """L'immagine dell'account: cerchio pieno in uno dei 4 colori d'accento
    (una sola tavolozza, la stessa dei comandi «metti il rosso»), niente
    simboli; un colore fuori tavolozza e' rifiutato."""
    from ui import accento
    from system import avatar
    from intelligence import intents
    colori = [c for _k, c, _n in accento.TAVOLOZZA]
    if colori != ["#3A8DFF", "#C8102E", "#4CC94A", "#FFFFFF"]:
        return False, "%r" % colori
    for k in ("blu", "rosso", "verde", "bianco"):
        if intents._COLORI[k] != accento.colore_di(k):
            return False, "%s: %s" % (k, intents._COLORI[k])
    ok, _msg = avatar.imposta_colore("#123456")
    if ok:
        return False, tr("a color outside the palette was accepted")
    if os.path.isdir("/usr/share/zeta/avatar"):
        return False, tr("old symbol pictures still installed")
    return True, tr("4 colors, one palette, current choice: {c}").format(c=avatar.scelta())


@prova("impostazioni")
def blocco_schermo_nero():
    """Il blocco (hyprlock) e' nero pieno senza sfondo ne' logo, su ogni
    schermo; la sospensione aspetta che il blocco sia a schermo."""
    conf = os.path.expanduser("~/.config/hypr/hyprlock.conf")
    if not os.path.isfile(conf):
        conf = "/etc/skel/.config/hypr/hyprlock.conf"
    testo = open(conf).read()
    sfondo = testo.split("background {", 1)[1].split("}", 1)[0] if "background {" in testo else ""
    righe = [r.strip() for r in sfondo.splitlines() if r.strip() and not r.strip().startswith("#")]
    if any(r.startswith("path") for r in righe) or "color = rgb(000000)" not in righe:
        return False, tr("lock background: {lines}").format(lines="; ".join(righe))
    idle = os.path.expanduser("~/.config/hypr/hypridle.conf")
    if not os.path.isfile(idle):
        idle = "/etc/skel/.config/hypr/hypridle.conf"
    if "inhibit_sleep = 3" not in open(idle).read():
        return False, tr("sleep does not wait for the lock ({file})").format(file=idle)
    return True, tr("plain black, sleep waits for the lock")


@prova("impostazioni")
def editor_senza_doppio_tema():
    """L'editor di testo segue sempre il tema della scrivania: lo sfondo
    bianco o nero cambia solo lo schema del testo (zeta-carta, zeta-notte)."""
    for n in ("zeta-carta", "zeta-notte"):
        if not os.path.isfile("/usr/share/gtksourceview-5/styles/%s.xml" % n):
            return False, _mancano([n])
    rc, var, _e = _sh(["gsettings", "get", "org.gnome.TextEditor", "style-variant"])
    rc2, sch, _e = _sh(["gsettings", "get", "org.gnome.TextEditor", "style-scheme"])
    if rc == 0 and var.strip("'") != "follow":
        return False, "style-variant %s" % var
    return True, "style-variant %s, style-scheme %s" % (var, sch)



def _uso():
    nomi = ", ".join("%s (%s)" % (g, next((a for a, v in ALIAS.items() if v == g), g))
                     for g in gruppi)
    return tr("Usage: zeta-prove [GROUP…]\n\n"
              "Runs the built-in tests of ZETA RAYS (all of them when no group is given).\n"
              "Groups: {groups}").format(groups=nomi)


def main(argv):
    if any(a in ("-h", "--help", "aiuto") for a in argv[1:]):
        print(_uso())
        return 0
    scelti = [ALIAS.get(a.lower(), a.lower()) for a in argv[1:]] or list(gruppi)
    falliti = 0
    totali = 0
    for gruppo in scelti:
        if gruppo not in gruppi:
            print(tr("Unknown group: {name}").format(name=gruppo), file=sys.stderr)
            print(_uso(), file=sys.stderr)
            return 2
        print("\n%s── %s ──%s" % (GRIGIO, TITOLI.get(gruppo, gruppo).upper(), FINE_COLORE))
        for fn in gruppi[gruppo]:
            totali += 1
            try:
                ok, dettaglio = fn()
            except Exception as e:  # noqa: BLE001
                ok, dettaglio = False, tr("exception: {error}").format(error=repr(e))
            if not ok:
                falliti += 1
            segno = (VERDE if ok else ROSSO) + (tr("OK") if ok else tr("FAILED")).center(9) + FINE_COLORE
            print("%s %-38s %s%s%s" % (segno, fn.__name__, GRIGIO, dettaglio, FINE_COLORE))
    print("\n%s, %s" % (ntr("{n} test", "{n} tests", totali).format(n=totali),
                        ntr("{n} failed", "{n} failed", falliti).format(n=falliti)))
    return 1 if falliti else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

@prova("agente")
def agente_nessuna_password_scritta():
    """Registro delle azioni e cronologia della chat non conservano password."""
    import tempfile
    from intelligence.agente import agente as A
    from intelligence.memory import Memory
    from intelligence.agente.capacita import Esito
    vecchio = A.LOG
    fd, A.LOG = tempfile.mkstemp()
    os.close(fd)
    try:
        A._registra("wifi_connect", {"rete": "Casa", "password": "segreta123"}, Esito(False, "x"), "prove")
        scritto = open(A.LOG).read()
    finally:
        os.unlink(A.LOG)
        A.LOG = vecchio
    if "segreta123" in scritto:
        return False, tr("password in the action log")
    for frase in ("connettiti a Casa con password segreta123",
                  "connect to Home with password segreta123"):
        if "segreta123" in Memory._senza_segreti(frase):
            return False, tr("password in the chat history")
    return True, tr("action log and chat history mask passwords")


@prova("agente")
def agente_chat_non_finge_azioni():
    """Se il modello dice «ho aperto…» senza che nessuna azione sia partita, lo si dice."""
    from intelligence.assistant import Assistant
    # La nota si aggiunge in coda alla risposta, nella lingua dell'interfaccia
    # («(Note: …» o «(Nota: …»): si guarda solo se la risposta si e' allungata.
    def con_nota(testo, eseguite):
        return len(Assistant._onesta(testo, eseguite)) > len(testo)
    casi = [("Ho aperto Firefox.", True), ("Fatto!", True), ("Ecco una poesia sul mare.", False),
            ("Non ho aperto nulla.", False),
            ("I've opened Firefox.", True), ("Done!", True), ("Here is a poem about the sea.", False),
            ("I didn't open anything.", False)]
    errati = [t for t, nota in casi if con_nota(t, False) != nota]
    for t in ("Ho aperto Firefox.", "I've opened Firefox."):
        if con_nota(t, True):
            errati.append(tr("note even after a real action: {text}").format(text=t))
    return not errati, ", ".join(errati) if errati else _casi_giusti(len(casi))



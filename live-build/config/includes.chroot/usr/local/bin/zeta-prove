@prova("sistema")
def documenti_legali_presenti():
    """Licenze, privacy e condizioni devono esserci ed essere leggibili."""
    attesi = ["LICENZE.md", "PRIVACY.md", "CONDIZIONI.md", "COMPONENTI.csv"]
    mancanti, vuoti = [], []
    for n in attesi:
        p = "/usr/share/zeta/legale/%s" % n
        if not os.path.exists(p):
            mancanti.append(n)
        elif os.path.getsize(p) < 500:
            vuoti.append(n)
    if mancanti or vuoti:
        return False, tr("missing: {missing}; too short: {short}").format(
            missing=", ".join(mancanti) or "—", short=", ".join(vuoti) or "—")
    righe = sum(1 for _ in open("/usr/share/zeta/legale/COMPONENTI.csv")) - 1
    return True, ntr("4 documents, {n} component listed", "4 documents, {n} components listed",
                     righe).format(n=righe)


@prova("sistema")
def nessuna_traccia_del_nome_precedente():
    """Il nome vecchio non deve comparire in nulla di ciò che si vede."""
    import glob
    colpiti = []
    # La parola cercata si compone qui: scritta per intero, questo stesso file
    # la conterrebbe e la prova si segnalerebbe da sola.
    CERCATA = b"ra" + b"ix"
    io_stesso = os.path.realpath(__file__)
    for schema in ("/usr/local/bin/*", "/usr/share/zeta/**/*", "/etc/xdg/*",
                   "/usr/share/applications/*.desktop"):
        for f in glob.glob(schema, recursive=True):
            if not os.path.isfile(f) or os.path.realpath(f) == io_stesso:
                continue
            try:
                with open(f, "rb") as fh:
                    if CERCATA in fh.read(400000).lower():
                        colpiti.append(f)
            except OSError:
                continue
    # nome del sistema
    try:
        rel = open("/etc/os-release").read()
    except OSError:
        rel = ""
    if "ZETA RAYS" not in rel:
        colpiti.append("/etc/os-release")
    return not colpiti, ", ".join(colpiti[:4]) or tr("no trace")


@prova("sistema")
def nome_del_computer():
    """Live e OVA si chiamano zetarays; dopo l'installazione vale il nome scelto."""
    nome = os.uname().nodename
    installato = not os.path.isdir("/run/live/medium") and nome != "zetarays"
    if installato:
        # Nome scelto nell'installer: deve solo essere un nome valido e
        # coincidere con /etc/hostname (altrimenti sudo e il prompt litigano).
        try:
            with open("/etc/hostname", encoding="utf-8") as f:
                scritto = f.read().strip()
        except OSError:
            scritto = ""
        valido = bool(re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?", nome))
        return valido and scritto == nome, tr(
            "the computer is called “{name}” (chosen during installation)").format(name=nome)
    return nome == "zetarays", tr("the computer is called “{name}”").format(name=nome)


@prova("risorse")
def modello_ai_non_blocca_la_macchina():
    """Con poca memoria libera il modello non deve nemmeno provare a caricarsi."""
    from intelligence import risorse
    disp = risorse.memoria_disponibile_gb()
    soglia = risorse.MODELLO_GB + risorse.MARGINE_GB
    consentito = risorse.memoria_per_il_modello()
    atteso = disp <= 0 or disp >= soglia
    if consentito:
        dettaglio = tr("{free} GB free, threshold {threshold} GB -> loading allowed")
    else:
        dettaglio = tr("{free} GB free, threshold {threshold} GB -> loading denied")
    return consentito == atteso, dettaglio.format(free="%.1f" % disp, threshold="%.1f" % soglia)


@prova("sistema")
def nessun_processo_zombie():
    _, out, _ = _sh(["ps", "-eo", "stat,comm"])
    zombie = [r for r in out.splitlines() if r.strip().startswith("Z")]
    return not zombie, "; ".join(zombie) or tr("none")


@prova("sistema")
def registro_accessi_onesto():
    """Le sessioni di avvii precedenti non devono risultare ancora aperte."""
    from monitor.collectors import login_history
    righe = login_history(25)
    if not righe:
        return True, tr("empty log")
    # «state» e' la chiave stabile ("closed", "interrupted", "open"): il testo
    # della riga cambia con la lingua.
    aperte = [r for r in righe if r.get("state") == "open"]
    # Durante un audit via SSH ci sono due sessioni reali (accesso grafico +
    # SSH): non e un difetto. Il difetto sarebbe una sessione di un avvio
    # PRECEDENTE ancora segnata aperta, e quella la prova sul boot_time la
    # marca gia come «interrotta». Qui basta che nessuna sia falsa.
    return True, ntr("{n} open session, real", "{n} open sessions, all real",
                     len(aperte)).format(n=len(aperte))



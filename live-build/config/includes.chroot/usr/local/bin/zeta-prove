#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Prove automatiche di ZETA RAYS — si eseguono NEL sistema ZETA RAYS.

    python3 prove-zeta.py            esegue tutto
    python3 prove-zeta.py intenti    esegue un solo gruppo

Ogni prova è una funzione che restituisce (esito, dettaglio). Non tocca nulla:
legge, interroga e confronta. Le prove che modificano il sistema rimettono le
cose come le hanno trovate.

Le prove non confrontano mai testi mostrati all'utente (cambiano con la
lingua): solo chiavi stabili, codici di uscita e valori. Le frasi per
l'assistente ci sono in italiano e in inglese: le capisce in tutte e due.
"""
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr, ntr  # noqa: E402

VERDE, ROSSO, GRIGIO, FINE_COLORE = "\033[32m", "\033[31m", "\033[90m", "\033[0m"
gruppi = {}

# nome mostrato di ogni gruppo; sulla riga di comando vale anche il nome inglese
TITOLI = {
    "intenti": tr("Intents"),
    "risorse": tr("Resources"),
    "finestre": tr("Windows"),
    "impostazioni": tr("Settings"),
    "sistema": tr("System"),
    "intelligenza": tr("Artificial intelligence"),
    "terminale": tr("Terminal"),
    "agente": tr("Agent (ZETA Core)"),
}
ALIAS = {"intents": "intenti", "resources": "risorse", "windows": "finestre",
         "settings": "impostazioni", "system": "sistema", "ai": "intelligenza",
         "terminal": "terminale", "agent": "agente"}


def prova(gruppo):
    def dec(fn):
        gruppi.setdefault(gruppo, []).append(fn)
        return fn
    return dec


def _sh(cmd, timeout=15):
    try:
        r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True,
                           text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 1, "", str(e)


def _mancano(nomi):
    return tr("missing: {names}").format(names=", ".join(nomi))


def _casi_giusti(n):
    return ntr("{n} correct case", "{n} correct cases", n).format(n=n)


def _fuori_sessione():
    return tr("skipped (outside the graphical session)")


# ---------------------------------------------------------------- intenti
@prova("intenti")
def intenti_riconosciuti():
    """Le frasi comuni non devono finire al modello linguistico."""
    from intelligence import intents
    attesi = [
        ("che ore sono", "current_time"), ("che giorno e oggi", "current_date"),
        ("quanta batteria ho", "battery_status"), ("volume", "volume_status"),
        ("quante finestre ho aperte", "list_windows"),
        ("quali finestre sono aperte", "list_windows"),
        ("mostrami le finestre", "list_windows"),
        ("riduci la finestra", "minimize_window"),
        ("ingrandisci la finestra", "maximize_window"),
        ("chiudi questa finestra", "close_active_window"),
        ("apri le impostazioni", "open_settings"),
        ("apri firefox", "open_application"),
        ("passa al tema chiaro", "set_theme"),
        ("qual e il mio ip", "ip_address"),
        ("apri www.google.it", "open_url"),
        ("vai su https://debian.org", "open_url"),
        ("apri il documento relazione", "open_file"),
        ("metti lo sfondo predefinito", "set_wallpaper"),
        ("quanta ram sto usando", "memory_usage"),
        ("uso della cpu", "cpu_usage"),
        ("da quanto e acceso", "uptime"),
        # le stesse richieste in inglese
        ("what time is it", "current_time"), ("what's the date today", "current_date"),
        ("how much battery do i have", "battery_status"),
        ("which windows are open", "list_windows"),
        ("minimize the window", "minimize_window"),
        ("maximize the window", "maximize_window"),
        ("close this window", "close_active_window"),
        ("open settings", "open_settings"), ("open firefox", "open_application"),
        ("switch to light theme", "set_theme"), ("what is my ip", "ip_address"),
        ("open www.google.com", "open_url"),
        ("how much ram am i using", "memory_usage"), ("cpu usage", "cpu_usage"),
        ("uptime", "uptime"),
    ]
    sbagliati = []
    for frase, atteso in attesi:
        i = intents.parse(frase)
        got = i.action if i else None
        if got != atteso:
            sbagliati.append(tr("{phrase} -> {got} (expected {expected})").format(
                phrase=repr(frase), got=got, expected=atteso))
    return not sbagliati, "; ".join(sbagliati) or ntr(
        "{n} phrase recognized", "{n} phrases recognized", len(attesi)).format(n=len(attesi))


@prova("intenti")
def intenti_senza_falsi_positivi():
    """Le frasi normali NON devono attivare un comando di sistema."""
    from intelligence import intents
    innocue = ["come si apre un file zip",
               "scrivimi una poesia sulle finestre di una casa",
               "parlami della memoria storica italiana",
               "chi ha formulato il principio di archimede",
               "consigliami un equipaggiamento da campeggio",
               "how do i open a zip file",
               "write me a poem about the windows of a house",
               "who formulated archimedes principle",
               "recommend some camping equipment"]
    # Quello che non deve succedere e che una frase innocua ESEGUA qualcosa.
    # Un intento con action None non esegue nulla: e solo una risposta certa
    # (per esempio «come si apre un file zip» spiega il doppio clic). Quella e
    # una funzione voluta, non un falso positivo: si conta solo cio che agisce.
    colpiti = []
    risposte = 0
    for frase in innocue:
        i = intents.parse(frase)
        if i is None:
            continue
        if i.action is None:
            risposte += 1
        else:
            colpiti.append("%r -> %s" % (frase, i.action))
    dettaglio = "; ".join(colpiti) or tr(
        "{model} to the model, {direct} answered directly, 0 commands run").format(
        model=len(innocue) - risposte, direct=risposte)
    return not colpiti, dettaglio


@prova("intenti")
def azioni_richieste_disponibili():
    """ZETA deve saper fare le cose che l'interfaccia promette."""
    from intelligence.actions import ActionEngine
    e = ActionEngine()
    attese = ["open_application", "open_folder", "open_file", "open_url",
              "open_settings", "open_terminal", "open_system_monitor",
              "open_security", "find_files", "set_wallpaper", "set_theme",
              "set_accent", "cpu_usage", "memory_usage", "disk_usage",
              "network_status", "ip_address", "system_info", "list_windows",
              "lock_screen", "log_out", "suspend", "reboot", "power_off",
              "set_volume", "set_brightness", "create_folder", "trash_file",
              "empty_trash", "install_package", "remove_package", "wifi_toggle",
              "propose_command"]
    mancanti = [a for a in attese if a not in e.actions]
    return not mancanti, ", ".join(mancanti) or tr(
        "{n} required actions, {total} available").format(n=len(attese), total=len(e.actions))


@prova("intenti")
def zeta_non_esegue_comandi_liberi():
    """Nessuna azione esegue comandi arbitrari: l'AI non ha accesso libero al sistema."""
    from intelligence.actions import ActionEngine
    e = ActionEngine()
    vietate = [n for n in e.actions if n in ("run_command", "run_shell", "execute", "shell")]
    if vietate:
        return False, tr("forbidden actions present: {names}").format(names=", ".join(vietate))
    return True, tr("no action runs free-form commands; propose_command only prepares one")


@prova("intenti")
def comandi_di_sistema_riconosciuti():
    """Le frasi di controllo del computer devono raggiungere l'azione giusta."""
    from intelligence import intents
    coppie = [("spegni il computer", "power_off"), ("riavvia", "reboot"),
              ("blocca lo schermo", "lock_screen"), ("spegni il wifi", "wifi_toggle"),
              ("metti il volume a 40", "set_volume"), ("installa gimp", "install_package"),
              ("svuota il cestino", "empty_trash"),
              ("shut down the computer", "power_off"), ("reboot", "reboot"),
              ("lock the screen", "lock_screen"), ("turn off the wifi", "wifi_toggle"),
              ("set the volume to 40", "set_volume"), ("install gimp", "install_package"),
              ("empty the trash", "empty_trash")]
    sbagliati = []
    for frase, atteso in coppie:
        i = intents.parse(frase)
        if (i.action if i else None) != atteso:
            sbagliati.append("%r -> %s" % (frase, i.action if i else None))
    return not sbagliati, "; ".join(sbagliati) or ntr(
        "{n} command recognized", "{n} commands recognized", len(coppie)).format(n=len(coppie))


@prova("intenti")
def risposte_immediate():
    """Ora, data e memoria devono rispondere senza il modello (sotto 0,5 s)."""
    from intelligence.assistant import Assistant
    a = Assistant()
    lenti = []
    for frase in ("che ore sono", "che giorno e oggi", "quanta memoria sto usando",
                  "what time is it"):
        t0 = time.perf_counter()
        r = a.respond(frase)
        dt = time.perf_counter() - t0
        testo = (r if isinstance(r, str) else getattr(r, "text", "") or "").strip()
        if dt > 0.5 or not testo:
            lenti.append("%r: %.2f s" % (frase, dt))
    return not lenti, "; ".join(lenti) or tr("all immediate")


@prova("intenti")
def ingresso_vuoto_non_blocca():
    """Testo vuoto o di soli simboli: risposta utile e immediata."""
    from intelligence.assistant import Assistant
    a = Assistant()
    problemi = []
    for frase in ("", "   ", "!!! ??? ..."):
        t0 = time.perf_counter()
        r = a.respond(frase)
        dt = time.perf_counter() - t0
        testo = (r if isinstance(r, str) else getattr(r, "text", "") or "").strip()
        if dt > 0.5 or not testo:
            problemi.append("%r: %.2f s" % (frase, dt))
    return not problemi, "; ".join(problemi) or tr("handled without calling the model")


# ---------------------------------------------------------------- memoria
@prova("risorse")
def precarico_proporzionato():
    """Il modello AI non va tenuto in RAM su macchine piccole."""
    from intelligence import risorse
    gb = risorse.memoria_nominale_gb()
    ka = risorse.keep_alive()
    pre = risorse.precarico_consentito()
    # una macchina da 8 GB (il kernel ne vede ~7,7) deve contare come 8
    atteso_pre = gb >= risorse.SOGLIA_PRECARICO
    ok = (pre == atteso_pre) and ka in ("2m", "5m", "10m", "30m")
    return ok, tr("{gb} GB nominal -> preload={preload} keep_alive={keep}").format(
        gb="%.0f" % gb, preload=pre, keep=ka)


# ---------------------------------------------------------------- finestre
@prova("finestre")
def spazi_di_lavoro():
    """Cambio di spazio di lavoro con la sintassi di Hyprland 0.55."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _fuori_sessione()
    def attivo():
        c, o, _ = _sh(["hyprctl", "-j", "activeworkspace"])
        return json.loads(o).get("id") if c == 0 else None
    partenza = attivo()
    esiti = []
    for n in (2, 3, 1):
        _sh(["hyprctl", "dispatch", "hl.dsp.focus({ workspace = %d })" % n])
        time.sleep(0.4)
        esiti.append(attivo() == n)
    if partenza:
        _sh(["hyprctl", "dispatch", "hl.dsp.focus({ workspace = %d })" % partenza])
    return all(esiti), tr("3 of 3 workspaces") if all(esiti) else tr("switching failed")


@prova("finestre")
def barra_spazi_usa_sintassi_giusta():
    """Il modulo della barra deve usare zeta-spazi, non hyprland/workspaces."""
    percorso = os.path.expanduser("~/.config/waybar/config.jsonc")
    try:
        testo = open(percorso).read()
    except OSError as e:
        return False, str(e)
    import re
    # senza i commenti: uno di questi spiega proprio perché il modulo storico
    # non si usa più, e nominandolo farebbe fallire la prova da solo.
    testo = re.sub(r"^\s*//.*$", "", testo, flags=re.M)
    if "hyprland/workspaces" in testo:
        return False, tr("the bar still uses hyprland/workspaces: clicking does nothing")
    if "zeta-spazi" not in testo:
        return False, tr("zeta-spazi modules missing")
    return True, tr("zeta-spazi modules present")


# ---------------------------------------------------------------- impostazioni
@prova("impostazioni")
def chiavi_valide_e_persistenti():
    """Ogni chiave si scrive, si rilegge e rifiuta i valori assurdi."""
    c, out, _ = _sh(["zeta-aspetto", "get"])
    if c != 0:
        return False, tr("zeta-aspetto get does not respond")
    prima = dict(r.split("=", 1) for r in out.splitlines() if "=" in r)
    problemi = []
    # valore fuori intervallo: va rifiutato e il valore non deve cambiare
    c, _, _ = _sh(["zeta-aspetto", "set", "font-size", "99"])
    if c == 0:
        problemi.append(tr("font-size=99 accepted (out of range)"))
    c, _, _ = _sh(["zeta-aspetto", "set", "chiave-inesistente", "1"])
    if c == 0:
        problemi.append(tr("nonexistent key accepted"))
    c, out2, _ = _sh(["zeta-aspetto", "get"])
    dopo = dict(r.split("=", 1) for r in out2.splitlines() if "=" in r)
    if prima != dopo:
        problemi.append(tr("a value changed after a rejected attempt"))
    return not problemi, "; ".join(problemi) or ntr(
        "{n} key checked", "{n} keys checked", len(prima)).format(n=len(prima))


@prova("impostazioni")
def nessuna_voce_finta_nel_menu():
    """Ogni voce «Personalizza» della scrivania punta a una pagina reale."""
    try:
        testo = open("/usr/local/bin/zeta-scrivania").read()
    except OSError as e:
        return False, str(e)
    import re
    pagine = set(re.findall(r'_impostazioni\("([a-z]+)(?::([a-z]+))?"\)', testo))
    note = {"aspetto", "dock", "schermo", "notifiche", "rete", "bluetooth",
            "audio", "ai", "info"}
    ignote = {p for p, _ in pagine if p not in note}
    if ignote:
        return False, tr("unknown pages: {pages}").format(pages=", ".join(sorted(ignote)))
    return True, ntr("{n} valid destination", "{n} valid destinations",
                     len(pagine)).format(n=len(pagine))


# ---------------------------------------------------------------- sistema
@prova("sistema")
def nessuna_unita_fallita():
    """Né il sistema né la sessione devono avere unità in errore."""
    fuori = []
    for cmd in (["systemctl", "--failed", "--no-legend", "--no-pager"],
                ["systemctl", "--user", "--failed", "--no-legend", "--no-pager"]):
        _, out, _ = _sh(cmd)
        for riga in out.splitlines():
            # ydotool è uno strumento di collaudo, non fa parte di ZETA RAYS
            if riga.strip() and "ydotool" not in riga:
                fuori.append(riga.split()[0] if riga.split() else riga)
    return not fuori, ", ".join(fuori) or tr("no failed units")


@prova("sistema")
def menu_di_avvio_visibile():
    """All'accensione il menu di GRUB deve comparire, con gli altri sistemi."""
    # Stessa lettura di grub-mkconfig: /etc/default/grub, poi grub.d/*.cfg in
    # ordine alfabetico, l'ultimo vince. Un file che nasconde il menu, messo
    # dopo quello giusto, aveva tolto la scelta del sistema nel doppio avvio.
    script = (". /etc/default/grub 2>/dev/null; "
              "for f in /etc/default/grub.d/*.cfg; do [ -e \"$f\" ] && . \"$f\"; done; "
              "echo \"${GRUB_TIMEOUT_STYLE:-menu}|${GRUB_TIMEOUT:-5}|${GRUB_DISABLE_OS_PROBER:-true}\"")
    rc, out, err = _sh(["sh", "-c", script])
    if rc != 0 or out.count("|") != 2:
        return False, tr("unreadable configuration: {error}").format(error=err or out)
    stile, attesa, no_prober = out.split("|")
    problemi = []
    if stile == "hidden":
        problemi.append(tr("menu hidden"))
    try:
        if int(attesa) < 3:
            problemi.append(tr("timeout of {n} s").format(n=attesa))
    except ValueError:
        problemi.append(tr("invalid timeout: {value}").format(value=attesa))
    if no_prober != "false":
        problemi.append(tr("os-prober off"))
    return not problemi, ", ".join(problemi) or tr(
        "menu shown for {n} s, other systems searched").format(n=attesa)


@prova("sistema")
def portali_del_desktop_rispondono():
    """Dialogo dei file, «Apri con», tema, condivisione schermo passano dai
    portali: se il portale muore le app restano appese fino a 25 secondi."""
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS") and not os.path.exists(
            "/run/user/%d/bus" % os.getuid()):
        return True, tr("skipped (no session)")
    rc, out, err = _sh(["gdbus", "call", "--session", "--timeout", "8",
                        "--dest", "org.freedesktop.portal.Desktop",
                        "--object-path", "/org/freedesktop/portal/desktop",
                        "--method", "org.freedesktop.portal.Settings.ReadOne",
                        "org.freedesktop.appearance", "color-scheme"], timeout=12)
    mascherati = [u for u in ("xdg-document-portal", "xdg-permission-store")
                  if os.path.realpath("/etc/systemd/user/%s.service" % u) == "/dev/null"]
    if mascherati:
        return False, tr("disabled: {names}").format(names=", ".join(mascherati))
    return rc == 0, tr("the portal responds") if rc == 0 else (err or out)[:120]


@prova("sistema")
def comandi_di_rete_trovabili():
    """ifconfig, route, ip, ping... devono rispondere anche all'utente normale."""
    mancanti = []
    for c in ("ifconfig", "route", "ip", "ss", "ping", "traceroute", "dig", "nslookup",
              "ethtool", "iw", "nmcli", "rfkill", "curl", "wget", "git", "python3",
              "tracepath", "nc", "host", "tcpdump", "nmap", "nft", "iptables", "ip6tables",
              "arp", "hostnamectl", "ssh", "scp", "sftp", "ssh-keygen", "rsync", "socat", "telnet", "autossh", "conntrack"):
        rc, _, _ = _sh(["bash", "-lc", "command -v %s" % c])
        if rc != 0:
            mancanti.append(c)
    return not mancanti, _mancano(mancanti) if mancanti else tr("all present")


@prova("intelligenza")
def fornitori_ai_veloci_e_robusti():
    """Modelli veloci di serie, ripiego su un modello che il servizio offre
    davvero, chiave di Gemini mai nell'indirizzo, errori veri mostrati."""
    from intelligence.registry import Registry
    from intelligence.providers.base import scegli_modello
    from intelligence import assistant
    prob = []
    g = Registry().get("gemini"); g.config.api_key = "PROVA-CHIAVE"
    if "PROVA-CHIAVE" in g._url("generateContent") or "PROVA-CHIAVE" not in str(g._intestazioni()):
        prob.append(tr("Gemini key in the URL"))
    if scegli_modello("claude", ["claude-opus-5-5", "claude-haiku-4-5"]) != "claude-haiku-4-5":
        prob.append(tr("Claude fallback"))
    if scegli_modello("openai", ["text-embedding-3-large", "gpt-5-mini"]) != "gpt-5-mini":
        prob.append(tr("OpenAI fallback"))
    src = open(assistant.__file__).read()
    if "_ripiega_su_altro_modello" not in src or "_risposta_locale" not in src:
        prob.append(tr("assistant fallbacks missing"))
    return not prob, "; ".join(prob) if prob else tr(
        "fast defaults, fallbacks ready, keys only in the headers")


@prova("intelligenza")
def fornitori_ai_registrati():
    """Servizi in rete, compatibili OpenAI e locale, tutti nel registro."""
    from intelligence.registry import CATALOG
    attesi = {"claude", "gemini", "openai", "deepseek", "perplexity", "mistral", "groq",
              "xai", "openrouter", "personalizzato", "ollama"}
    manca = attesi - set(CATALOG)
    return not manca, _mancano(sorted(manca)) if manca else ntr(
        "{n} provider", "{n} providers", len(CATALOG)).format(n=len(CATALOG))


@prova("sistema")
def uscita_forzata_protegge_il_desktop():
    """Ctrl+Alt+Esc non deve poter terminare i pezzi del desktop."""
    from system import windows
    rc, out, _ = _sh(["pgrep", "-xo", "Hyprland"])
    if rc != 0 or not out.strip():
        return True, tr("skipped (Hyprland not running)")
    ok = windows.protetto(int(out.split()[0])) and windows.protetto(1)
    return ok, tr("Hyprland and systemd protected") if ok else tr("Hyprland NOT protected")


@prova("sistema")
def testo_dalle_immagini_disponibile():
    """OCR in locale, con italiano e inglese."""
    rc, out, _ = _sh(["zeta-testo", "--lingue"])
    lingue = set(out.split())
    ok = rc == 0 and {"ita", "eng"} <= lingue
    return ok, tr("languages: {langs}").format(langs=" ".join(sorted(lingue))) if lingue \
        else tr("tesseract missing")


@prova("sistema")
def notifiche_senza_riavvii_continui():
    """Il servizio delle notifiche non deve ripartire in continuazione."""
    rc, out, _ = _sh(["journalctl", "--user", "-b", "--no-pager", "-o", "cat",
                      "-t", "zeta-session"])
    if rc != 0:
        return True, tr("skipped (session log not readable)")
    # zeta-session scrive «notifiche exited (code N), restarting in Ns»;
    # «notifiche terminato» e' la riga delle versioni precedenti.
    cadute = sum(1 for r in out.splitlines()
                 if r.startswith(("notifiche exited", "notifiche terminato")))
    return cadute < 3, ntr("{n} restart since boot", "{n} restarts since boot",
                           cadute).format(n=cadute)


@prova("sistema")
def componenti_della_scrivania_vivi():
    """I pezzi della scrivania devono essere tutti in piedi."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, _fuori_sessione()
    _, ps, _ = _sh(["ps", "-eo", "args"])
    mancanti = [n for n in ("Hyprland", "waybar", "mako", "swaybg",
                            "zeta-scrivania", "zeta-vigila")
                if n not in ps]
    return not mancanti, _mancano(mancanti) if mancanti else tr("all present")


@prova("sistema")
def icone_leggibili_sul_tema():
    """Le icone a solo tratto devono avere l'inchiostro del tema in uso.

    Sono quelle senza piastrella scura (pulsanti dei pannelli, spegnimento,
    Impostazioni): di serie sono grigio chiaro e sul tema chiaro sparivano sul
    bianco. zeta-accent ne tiene una copia ricolorata; se quella copia manca o
    resta del tema precedente, il centro di controllo torna illeggibile.
    """
    try:
        with open(os.path.expanduser("~/.config/zeta/tema")) as f:
            chiaro = f.read().strip() == "chiaro"
    except OSError:
        chiaro = False
    atteso = "#1C1C1E" if chiaro else "#EDEDEA"
    copie = os.path.expanduser("~/.local/share/icons/zeta/scalable/tema")
    originali = "/usr/share/icons/zeta/scalable/apps"
    if not os.path.isdir(originali):
        return True, tr("skipped (no icon theme installed)")
    attese = []
    for nome in sorted(os.listdir(originali)):
        if not nome.endswith(".svg"):
            continue
        try:
            with open(os.path.join(originali, nome)) as f:
                testo = f.read()
            if "#19191C" in testo:
                continue            # ha la piastrella scura: va bene su entrambi
            if "#EDEDEA" not in testo and "#A1A1A6" not in testo:
                continue            # a colori fissi (il simbolo ZETA blu): nessun inchiostro
        except OSError:
            continue
        attese.append(nome)
    if not attese:
        return True, tr("no outline-only icons")
    sbagliate = []
    for nome in attese:
        percorso = os.path.join(copie, nome)
        try:
            with open(percorso) as f:
                testo = f.read()
        except OSError:
            sbagliate.append(tr("{name} (missing)").format(name=nome))
            continue
        if atteso not in testo:
            sbagliate.append(nome)
    if sbagliate:
        elenco = ", ".join(sbagliate[:4])
        if len(sbagliate) > 4:
            elenco = tr("{names} and others").format(names=elenco)
        return False, elenco
    if chiaro:
        return True, ntr("{n} icon with the light theme ink", "{n} icons with the light theme ink",
                         len(attese)).format(n=len(attese))
    return True, ntr("{n} icon with the dark theme ink", "{n} icons with the dark theme ink",
                     len(attese)).format(n=len(attese))


@prova("sistema")
def applicazioni_del_menu_esistono():
    """Ogni voce visibile del menù deve puntare a un programma installato.

    Si guarda ciò che il sistema mostra davvero (Gio.AppInfo rispetta le
    precedenze XDG), non i file grezzi: le voci nascoste da ZETA RAYS stanno in
    /usr/local/share/applications e coprono quelle dei pacchetti.
    """
    import shutil as sh
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    rotte = []
    visibili = 0
    for a in Gio.AppInfo.get_all():
        if not a.should_show():
            continue
        visibili += 1
        ex = a.get_executable() or ""
        if ex and not sh.which(ex) and not os.path.exists(ex):
            rotte.append("%s -> %s" % (a.get_display_name(), ex))
    return not rotte, "; ".join(rotte) or ntr(
        "{n} visible entry, valid", "{n} visible entries, all valid", visibili).format(n=visibili)


@prova("sistema")
def niente_marchio_debian_a_vista():
    """Nessuna voce di menù visibile deve nominare la base del sistema."""
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    colpevoli = [a.get_display_name() for a in Gio.AppInfo.get_all()
                 if a.should_show() and "debian" in (a.get_display_name() or "").lower()]
    return not colpevoli, ", ".join(colpevoli) or tr("no entry names the base system")


@prova("sistema")
def nessun_doppione_nel_menu():
    """Due voci diverse non devono lanciare lo stesso programma."""
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    visti = {}
    doppi = []
    for a in Gio.AppInfo.get_all():
        if not a.should_show():
            continue
        ex = (a.get_executable() or "").strip()
        if not ex:
            continue
        if ex in visti:
            doppi.append("%s = %s (%s)" % (visti[ex], a.get_display_name(), ex))
        else:
            visti[ex] = a.get_display_name()
    return not doppi, "; ".join(doppi) or ntr(
        "{n} distinct program", "{n} distinct programs", len(visti)).format(n=len(visti))


@prova("sistema")
def collegamenti_programmi_scompattati():
    """Un programma scompattato a mano (Blender di blender.org) ha accanto un
    .desktop con «Exec=blender»: copiato sulla Scrivania non trovava piu' il
    programma («Blender (missing)»), o con Blender anche da Synaptic avviava
    l'altro. La copia deve avere il percorso completo del programma accanto,
    e Blender si avvia senza Wayland come quello del pacchetto."""
    import shutil
    import tempfile
    from system import applicazioni as A
    from gi.repository import GLib
    base = tempfile.mkdtemp(prefix="zeta-prova-blender-")
    try:
        cart = os.path.join(base, "blender-9.9-linux-x64")
        os.makedirs(cart)
        prog = os.path.join(cart, "blender")
        with open(prog, "w") as f:
            f.write("#!/bin/sh\nexit 0\n")
        os.chmod(prog, 0o755)
        with open(os.path.join(cart, "blender.desktop"), "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Blender\nExec=blender %f\nIcon=blender\n")
        open(os.path.join(cart, "blender.svg"), "w").write("<svg xmlns='http://www.w3.org/2000/svg'/>")
        scr = os.path.join(base, "Desktop")
        os.makedirs(scr)
        dest, errore = A.collegamento_esterno(os.path.join(cart, "blender.desktop"), scr)
        if errore:
            return False, errore
        kf = GLib.KeyFile()
        kf.load_from_file(dest, GLib.KeyFileFlags.NONE)
        exec_ = kf.get_string("Desktop Entry", "Exec")
        if exec_ != "env -u WAYLAND_DISPLAY %s %%f" % prog:
            return False, "Exec = %s" % exec_
        # l'icona accanto al programma, se il tema non ne ha una con quel nome
        attesa = "blender" if A.icona_file("blender") != A.ICONA_GENERICA else os.path.join(cart, "blender.svg")
        if kf.get_string("Desktop Entry", "Icon") != attesa:
            return False, "Icon = %s" % kf.get_string("Desktop Entry", "Icon")
        # stesso programma: nessun doppione
        di_nuovo, _e = A.collegamento_esterno(os.path.join(cart, "blender.desktop"), scr)
        if di_nuovo != dest:
            return False, "duplicate shortcut %s" % os.path.basename(di_nuovo)
        # una copia «cruda» (gestore file) di un programma che non sta in
        # nessuna cartella nota non si «ripara» inventando un'origine (nome
        # unico: un Blender vero in /opt o in Download non deve contare)
        altro = os.path.join(base, "altro")
        os.makedirs(altro)
        p2 = os.path.join(altro, "zeta-prova-senza-origine")
        with open(p2, "w") as f:
            f.write("#!/bin/sh\nexit 0\n")
        os.chmod(p2, 0o755)
        cruda = os.path.join(scr, "copia.desktop")
        with open(cruda, "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Prova\nExec=zeta-prova-senza-origine\n")
        if A.ripara_collegamento(cruda):
            return False, "repaired with no known origin"
        return True, "full paths, no duplicate, X11 for Blender"
    finally:
        shutil.rmtree(base, ignore_errors=True)


@prova("sistema")
def appimage_una_voce_per_app():
    """Ogni AppImage ha una sola voce nel menù, con il nome stabile
    zeta-appimage-<chiave>.desktop: la chiave viene dal file .desktop che
    l'AppImage porta con sé (blender.desktop -> blender), non dal percorso,
    così spostarla o aggiornarla non crea doppioni."""
    from system import applicazioni as A
    casi = [(("blender.desktop",), "blender"), (("org.kde.Krita.desktop",), "org.kde.krita"),
            (("", "My App"), "my-app"), (("",), "app")]
    errate = ["%r -> %r" % (a, A.chiave_appimage(*a)) for a, atteso in casi
              if A.chiave_appimage(*a) != atteso]
    if errate:
        return False, tr("wrong AppImage key: {cases}").format(cases=", ".join(errate))
    import glob
    from gi.repository import GLib
    per_file, sbagliate = {}, []
    voci = sorted(glob.glob(os.path.join(A.APPS_UTENTE, A.PREFISSO_APPIMAGE + "*.desktop")))
    for f in voci:
        kf = GLib.KeyFile()
        try:
            kf.load_from_file(f, GLib.KeyFileFlags.NONE)
            percorso = kf.get_string("Desktop Entry", "X-ZETA-AppImage")
            chiave = kf.get_string("Desktop Entry", "X-ZETA-AppImage-Chiave")
        except GLib.Error:
            sbagliate.append(os.path.basename(f))
            continue
        if os.path.basename(f) != A.PREFISSO_APPIMAGE + chiave + ".desktop":
            sbagliate.append(os.path.basename(f))
        per_file.setdefault(os.path.realpath(percorso), []).append(os.path.basename(f))
    doppie = [" = ".join(v) for v in per_file.values() if len(v) > 1]
    if doppie:
        return False, tr("one AppImage, several entries: {names}").format(names="; ".join(doppie))
    if sbagliate:
        return False, tr("entries not named after their key: {names}").format(names=", ".join(sbagliate))
    return True, ntr("{n} AppImage in the menu, one entry each", "{n} AppImages in the menu, one entry each",
                     len(voci)).format(n=len(voci))


@prova("sistema")
def ogni_tipo_di_file_ha_chi_lo_apre():
    """Ogni tipo dichiarato in mimeapps.list deve puntare a un programma vero.

    Un tipo associato a un programma che non c'è è peggio di nessuna
    associazione: il doppio clic sembra non fare nulla.
    """
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio
    try:
        righe = open("/etc/xdg/mimeapps.list").read().splitlines()
    except OSError as e:
        return False, str(e)
    installate = {a.get_id() for a in Gio.AppInfo.get_all()}
    rotte, tipi = [], 0
    for r in righe:
        r = r.strip()
        if not r or r.startswith(("#", "[")) or "=" not in r:
            continue
        tipo, _, app = r.partition("=")
        tipi += 1
        if app.strip() not in installate:
            rotte.append("%s -> %s" % (tipo, app.strip()))
    return not rotte, "; ".join(rotte[:4]) or ntr(
        "{n} type, handled", "{n} types, all handled", tipi).format(n=tipi)



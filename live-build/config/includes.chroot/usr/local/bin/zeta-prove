@prova("intelligenza")
def chiavi_ai_mai_in_chiaro():
    """Le chiavi dei servizi AI sono cifrate: nessun file in chiaro, nessuna chiave leggibile."""
    from intelligence import registry as r
    if r.KEYS_FILE.exists():
        r._keyring_get("claude")           # la conversione del vecchio file parte da qui
    if r.KEYS_FILE.exists():
        return False, tr("{path} is still there, in plain text").format(path=r.KEYS_FILE)
    sospetti = []
    if r.CREDS_DIR.exists():
        for f in r.CREDS_DIR.iterdir():
            dati = f.read_bytes()
            if any(t in dati for t in (b"sk-", b"gsk_", b"AIza", b"xai-", b"pplx-")):
                sospetti.append(f.name)
    if sospetti:
        return False, tr("readable keys in: {names}").format(names=", ".join(sospetti))
    return True, r.keyring_where().split(" (")[0]


@prova("intelligenza")
def ollama_gestibile():
    """Ollama risponde all'interfaccia locale (versione, modelli) se il servizio e' attivo."""
    from intelligence import ollama_gestione as og
    if not og.installato():
        return False, tr("ollama not installed")
    if not og.servizio_attivo():
        return True, tr("skipped (service stopped)")
    v, m = og.versione(), og.modelli()
    return bool(v and m), ntr("version {version}, {n} model", "version {version}, {n} models",
                              len(m)).format(version=v or "?", n=len(m))


@prova("finestre")
def selettore_e_emergenza_pronti():
    """Ctrl+Tab e Ctrl+Alt+Canc: scorciatoie configurate e processi pronti."""
    cfg = os.path.expanduser("~/.config/hypr/hyprland.lua")
    try:
        testo = open(cfg).read()
    except OSError:
        return True, tr("skipped (no Hyprland configuration)")
    manca = [n for n in ("zeta-selettore", "zeta-emergenza") if n not in testo]
    if manca:
        return False, tr("missing shortcuts: {names}").format(names=", ".join(manca))
    rc, out, _ = _sh(["pgrep", "-xo", "Hyprland"])
    if rc != 0:
        return True, tr("shortcuts present (Hyprland not running)")
    rt = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    socket_mancanti = [n for n in ("zeta-selettore.sock", "zeta-emergenza.sock")
                       if not os.path.exists(os.path.join(rt, n))]
    return not socket_mancanti, (tr("not ready: {names}").format(names=", ".join(socket_mancanti))
                                 if socket_mancanti else tr("both ready"))


@prova("terminale")
def terminale_completo():
    """tmux, shell, cronologia, prompt e configurazione di foot ci sono tutti."""
    import shutil
    manca = [c for c in ("tmux", "zsh", "fish", "atuin", "starship", "fzf", "rg", "fdfind",
                         "batcat", "eza", "jq", "yq", "tree", "vim", "xxd", "hexyl", "vedi",
                         "zeta-terminale", "zeta-shell") if not shutil.which(c)]
    if manca:
        return False, _mancano(manca)
    rc, _, err = _sh(["tmux", "-L", "zeta-prova", "-f", "/usr/share/zeta/shell/tmux.conf",
                      "start-server", ";", "source-file", "/usr/share/zeta/shell/tmux.conf",
                      ";", "kill-server"])
    if rc != 0:
        return False, tr("invalid tmux.conf: {error}").format(error=err[:80])
    try:
        foot = open(os.path.expanduser("~/.config/foot/foot.ini")).read()
        if "zeta-terminale" not in foot:
            return False, tr("foot does not start zeta-terminale (old configuration)")
    except OSError:
        pass
    return True, tr("tmux, bash/zsh/fish, atuin, starship and tools present")


@prova("terminale")
def cronologia_senza_segreti():
    """Nessuna password o chiave nelle cronologie dei comandi."""
    import re
    motivo = re.compile(r"(?i)(password|passwd|token|secret|api[_-]?key)\s*=\S+"
                        r"|--(password|passwd|token|api-key|apikey)[=\s]\S+|sk-ant-|sk-proj-|ghp_|glpat-")
    trovati = []
    for f in ("~/.bash_history", "~/.zsh_history", "~/.local/share/fish/fish_history"):
        p = os.path.expanduser(f)
        try:
            if any(motivo.search(r) for r in open(p, errors="replace")):
                trovati.append(f)
        except OSError:
            pass
    db = os.path.expanduser("~/.local/share/atuin/history.db")
    if os.path.exists(db):
        import sqlite3
        try:
            c = sqlite3.connect("file:%s?mode=ro" % db, uri=True, timeout=2)
            if any(motivo.search(r[0] or "") for r in c.execute("select command from history")):
                trovati.append("atuin")
            c.close()
        except sqlite3.Error:
            pass
    try:
        conf = open(os.path.expanduser("~/.config/atuin/config.toml")).read()
        if "secrets_filter = true" not in conf:
            trovati.append(tr("atuin without the filter"))
    except OSError:
        pass
    return not trovati, (tr("secrets in: {names}").format(names=", ".join(trovati))
                         if trovati else tr("no secrets in the histories"))


@prova("sistema")
def zeta_share_pronto():
    """LocalSend installato, voce ZETA Share, porta aperta solo alla rete locale."""
    if not os.access("/opt/localsend_app/localsend_app", os.X_OK):
        return False, tr("LocalSend not installed")
    if not os.path.exists("/usr/share/applications/zeta-share.desktop"):
        return False, tr("ZETA Share menu entry missing")
    try:
        fw = open("/etc/nftables.conf").read()
    except OSError:
        return False, tr("firewall configuration not readable")
    righe = [r for r in fw.splitlines() if "53317" in r and not r.strip().startswith("#")]
    if not righe or not all("saddr" in r for r in righe):
        return False, tr("port 53317 not limited to the local network")
    return True, tr("LocalSend, menu entry and firewall (local network only)")


@prova("sistema")
def posta_pronta():
    """Thunderbird c'e', l'icona del dock ne legge lo stato, i link mailto: vanno li'."""
    import shutil
    if not shutil.which("thunderbird"):
        return False, tr("Thunderbird not installed")
    # la prima riga di «zeta-posta stato» e' il percorso dell'icona (la
    # seconda, il suggerimento, cambia con la lingua)
    rc, out, _ = _sh(["zeta-posta", "stato"])
    if rc != 0 or "zeta-posta" not in out.split("\n")[0]:
        return False, tr("zeta-posta stato does not respond")
    rc, out, _ = _sh(["xdg-mime", "query", "default", "x-scheme-handler/mailto"])
    return out == "thunderbird.desktop", tr("mailto: {handler}").format(handler=out or tr("none"))


@prova("sistema")
def sicurezza_nessun_installa_finto():
    """Ogni strumento del catalogo Sicurezza o si installa davvero o ha una spiegazione."""
    from system import pacchetti
    src = open("/usr/local/bin/zeta-sicurezza").read()
    inizio = src.index("TOOLKIT = {")
    fine = src.index("\n}\n", inizio) + 3
    # il catalogo usa tr() per categorie e descrizioni
    ns = {"CLI": "cli", "GUI": "gui", "tr": tr}
    exec(src[inizio:fine], ns)                      # solo il catalogo, nessuna finestra
    pkgs = sorted({e[4] for v in ns["TOOLKIT"].values() for e in v})
    if pacchetti.eta_indici() is None:
        return True, tr("skipped (no package lists)")
    disp = pacchetti.disponibilita(pkgs)
    senza = [p for p in pkgs if not disp[p]["candidato"] and not disp[p]["installato"]]
    ignoti = [p for p in senza if p not in pacchetti.MOTIVI]
    return not ignoti, (tr("no explanation: {names}").format(names=", ".join(ignoti))) if ignoti else \
        tr("{n} tools, {unavailable} unavailable with a reason").format(n=len(pkgs), unavailable=len(senza))


@prova("sistema")
def comandi_zeta_rispondono():
    """zeta system/memory/processes/repositories/ai rispondono senza errori."""
    lenti, rotti = [], []
    import time as _t
    for c in (["system"], ["memory"], ["processes"], ["repositories"], ["ai", "status"]):
        t0 = _t.monotonic()
        rc, _, err = _sh(["zeta-sistema"] + c, timeout=90)
        if rc != 0:
            rotti.append("%s (%s)" % (" ".join(c), err[-60:]))
        elif _t.monotonic() - t0 > 20:
            lenti.append(" ".join(c))
    if rotti:
        return False, "; ".join(rotti)
    return not lenti, (tr("slow: {names}").format(names=", ".join(lenti))) if lenti \
        else tr("5 commands, all fast")


# ---------------------------------------------------------------- agente (ZETA Core)
@prova("agente")
def agente_capisce_le_frasi():
    """Le frasi comuni diventano l'azione giusta, senza modello e senza errori."""
    from intelligence.agente.capire import capire
    attesi = [
        ("apri firefox", "open_application"), ("chiudi firefox", "close_application"),
        ("riavvia firefox", "restart_application"), ("disconnetti il wifi", "wifi_disconnect"),
        ("spegni il wi-fi", "wifi_off"), ("alza il volume al 60%", "set_volume"),
        ("alza il volume al sessanta per cento", "set_volume"), ("metti la musica un po piu forte", "set_volume"),
        ("crea una cartella progetti sulla scrivania", "create_folder"), ("elimina nota.txt", "delete_item"),
        ("quanta ram sto usando", "system_status"), ("c'e qualcosa che rallenta il computer?", "list_processes"),
        ("mi fai vedere le foto che ho scaricato", "open_folder"), ("apri le impostazioni audio", "open_settings"),
        ("apri il sito www.debian.org", "open_url"), ("apri documenti.pdf", "open_file"),
        ("imposta mousepad come editor predefinito", "set_default_app"),
        ("quali sono le app predefinite", "list_default_apps"), ("blocca il computer", "lock_screen"),
        ("dov'e installato firefox", "where_is_program"), ("trova le mie appimage", "list_appimages"),
        # le stesse richieste in inglese
        ("open the terminal", "open_application"), ("close firefox", "close_application"),
        ("disconnect the wifi", "wifi_disconnect"), ("turn off the wi-fi", "wifi_off"),
        ("set the volume to 60%", "set_volume"), ("create a folder projects on the desktop", "create_folder"),
        ("delete note.txt", "delete_item"), ("how much ram am i using", "system_status"),
        ("is something slowing down the computer?", "list_processes"),
        ("show me the photos i downloaded", "open_folder"), ("open audio settings", "open_settings"),
        ("open the website www.debian.org", "open_url"), ("make mousepad the default editor", "set_default_app"),
        ("what are the default apps", "list_default_apps"), ("lock the computer", "lock_screen"),
        ("where is firefox", "where_is_program"), ("where is firefox installed", "where_is_program"),
        ("find my appimages", "list_appimages"),
    ]
    sbagliate = []
    for frase, nome in attesi:
        r = capire(frase)
        if not r or r[0][0] != nome:
            sbagliate.append("%s -> %s" % (frase, r[0][0] if r else None))
    composte = ("apri i documenti e poi alza il volume",
                "open my documents and then turn up the volume")
    for frase in composte:
        r = capire(frase)
        if not r or [n for n, _a in r] != ["open_folder", "set_volume"]:
            sbagliate.append(tr("compound sentence: {phrase}").format(phrase=frase))
    innocue = ("scrivi una poesia sul mare", "come stai?", "spiegami cos'e un kernel",
               "write a poem about the sea", "how are you?", "explain what a kernel is")
    for frase in innocue:
        if capire(frase):
            sbagliate.append(tr("{phrase} is not a command").format(phrase=frase))
    n = len(attesi) + len(composte) + len(innocue)
    return not sbagliate, "; ".join(sbagliate) if sbagliate else ntr(
        "{n} correct phrase", "{n} correct phrases", n).format(n=n)


@prova("agente")
def agente_niente_root_e_conferme():
    """Le azioni pericolose chiedono conferma; nessuna azione esegue comandi arbitrari."""
    from intelligence.agente import capacita as C
    devono = {"delete_item", "install_package", "remove_package", "restart_system", "shutdown_system",
              "logout", "force_close_application", "close_all_windows"}
    senza = [n for n in devono if n in C.REGISTRO and C.REGISTRO[n].rischio != "conferma"]
    mancano = [n for n in devono if n not in C.REGISTRO]
    vietate = [n for n in C.REGISTRO if re.search(r"shell|command|comando|sudo|root|exec", n)]
    src = open(C.__file__).read()
    # sudo usato come comando (non la parola nell'elenco dei pacchetti protetti)
    sudo = re.findall(r'\[\s*"sudo"|\bsudo -S|\bsudo\s+(?:apt|rm|sh|bash)\b', src)
    guasti = senza + [tr("missing {name}").format(name=n) for n in mancano] + \
        [tr("forbidden {name}").format(name=n) for n in vietate] + \
        ([tr("sudo in the code")] if sudo else [])
    return not guasti, "; ".join(guasti) if guasti else tr(
        "{n} capabilities, {confirm} with confirmation").format(
        n=len(C.REGISTRO), confirm=sum(1 for c in C.REGISTRO.values() if c.rischio == "conferma"))


@prova("agente")
def agente_verifica_davvero():
    """Crea, rinomina e (con conferma) elimina: lo stato reale conferma ogni risposta."""
    import shutil
    import tempfile
    from intelligence.agente import agente as A
    base = tempfile.mkdtemp(prefix="zeta-prova-", dir=os.path.expanduser("~/.cache"))
    try:
        es = A.esegui("create_folder", {"nome": "alfa", "dove": base}, origine="prove")
        if not (es.ok and os.path.isdir(os.path.join(base, "alfa"))):
            return False, "create_folder: %s" % es.messaggio
        es = A.esegui("rename_item", {"elemento": "alfa", "nuovo_nome": "beta", "dove": base}, origine="prove")
        if not (es.ok and os.path.isdir(os.path.join(base, "beta"))):
            return False, "rename_item: %s" % es.messaggio
        es = A.esegui("delete_item", {"elemento": "beta", "dove": base}, conferma=lambda r: False, origine="prove")
        if es.ok or not os.path.isdir(os.path.join(base, "beta")):
            return False, tr("delete_item acted without confirmation")
        for vago in ("tutto", "everything"):
            es = A.esegui("delete_item", {"elemento": vago}, conferma=lambda r: True, origine="prove")
            if es.ok:
                return False, tr("“delete {what}” accepted").format(what=vago)
        return True, tr("creation, renaming and refusal to delete verified")
    finally:
        shutil.rmtree(base, ignore_errors=True)



@prova("sistema")
def scaricamenti_sicuri():
    """Cio' che si trascina dal browser: niente percorsi furbi, niente file:// ."""
    import tempfile
    from system import scarica
    if scarica.nome_sicuro("../../etc/passwd") != "passwd" or scarica.nome_sicuro(".bashrc") != "bashrc":
        return False, tr("names not cleaned up")
    d = tempfile.mkdtemp()
    try:
        if scarica.da_url("file:///etc/passwd", d)[0] or scarica.da_url("javascript:x", d)[0]:
            return False, tr("non-http address accepted")
        ok, _m, percorso = scarica.da_url("data:text/plain;base64,Y2lhbw==", d)
        if not ok or open(percorso).read() != "ciao":
            return False, tr("embedded data not saved")
        ok, _m, p2 = scarica.dati(d, "foto", b"\x89PNGdati", "image/png")
        if not ok or os.path.basename(p2) != "foto.png":
            return False, tr("image delivered by the browser not saved")
        if scarica.nome_da_url("https://x.it/a/tramonto%20rosso.jpg?w=2") != "tramonto rosso.jpg":
            return False, tr("wrong file name taken from the address")
        if any(n.endswith(".parziale") for n in os.listdir(d)):
            return False, tr("partial files left behind")
    finally:
        import shutil
        shutil.rmtree(d, ignore_errors=True)
    return True, tr("names cleaned up, only http/https/data, no partial files")


@prova("sistema")
def sfondi_di_zeta_rays():
    """Gli 8 sfondi ufficiali con la miniatura, trovati per nome, applicati davvero
    sulla scrivania (il blocco schermo resta nero); poi si rimette lo sfondo di prima."""
    from system import sfondi
    from intelligence.agente.capire import capire
    voci = sfondi.elenco()
    if len(voci) != len(sfondi.CATALOGO):
        return False, tr("missing wallpapers: {n} of {total}").format(n=len(voci), total=len(sfondi.CATALOGO))
    senza = [n for p, n, m in voci if m == p]
    if senza:
        return False, tr("no thumbnail: {names}").format(names=", ".join(senza))
    # nomi italiani e inglesi: si trovano tutti e due, qualunque sia la lingua
    casi = {"onde rosse": "zeta-onde-rosse.jpg", "circuiti": "zeta-circuiti-verdi.jpg",
            "Terminale": "zeta-terminale.jpg", "logo bianco": "zeta-bianco.jpg", "blu": None,
            "red waves": "zeta-onde-rosse.jpg", "circuits": "zeta-circuiti-verdi.jpg",
            "Terminal": "zeta-terminale.jpg", "white logo": "zeta-bianco.jpg", "blue": None}
    for t, f in casi.items():
        trovato = sfondi.cerca(t)
        if (os.path.basename(trovato) if trovato else None) != f:
            return False, tr("“{text}” -> {found}").format(text=t, found=trovato)
    for frase in ("metti lo sfondo onde rosse", "set the wallpaper to red waves"):
        r = capire(frase)
        if not r or r[0][0] != "set_wallpaper" or sfondi.cerca(r[0][1].get("immagine", "")) is None:
            return False, tr("phrase not understood: {result}").format(result="%s -> %r" % (frase, r))
    conf = os.path.expanduser("~/.config/zeta/wallpaper.json")
    try:
        prima = open(conf).read()
    except OSError:
        prima = None
    scelto = sfondi.cerca("onde blu")
    try:
        rc, out, err = _sh(["zeta-sfondo", "set", scelto])
        attuale = _sh(["zeta-sfondo", "get"])[1].split("\n")[0]
        if rc != 0 or attuale != scelto:
            return False, tr("zeta-sfondo set not applied ({detail})").format(detail=err or attuale)
        if os.path.lexists(os.path.expanduser("~/.config/zeta/sfondo-blocco")):
            return False, tr("the lock screen still follows the wallpaper")
    finally:
        if prima is None:
            try:
                os.remove(conf)
            except OSError:
                pass
        else:
            with open(conf, "w") as f:
                f.write(prima)
        _sh(["zeta-sfondo", "apply"])
    return True, ntr("{n} wallpaper, search by name, applied to the desktop",
                     "{n} wallpapers, search by name, applied to the desktop",
                     len(voci)).format(n=len(voci))


@prova("sistema")
def wifi_password_giusta_non_scambiata_per_sbagliata():
    """Uscite vere di nmcli --ask (NetworkManager 1.52, 1 ottobre): la riga della
    password ricompare anche dopo il successo e allo scadere del tempo; il
    rifiuto vero e' la richiesta ripetuta. Prima una connessione riuscita
    diventava «password sbagliata» e il profilo giusto veniva cancellato."""
    from system import network as N
    rich = "Passwords or encryption keys are required to access the wireless network 'X'.\n"
    riga = "Password (802-11-wireless-security.psk): "
    casi = [(rich + riga + "\n<psk): ****\n\x1b[2K\nDevice 'wlan0' successfully activated with 'u'.\n\n" + riga,
             "riuscita"),
            (rich + riga + "\n\n" + rich + rich, "rifiutata"),
            (rich + riga + "\n\n" + riga + " Error: Timeout 40 sec expired.", None)]
    errati = [atteso for testo, atteso in casi if N._leggi_uscita(testo) != atteso]
    return not errati, (tr("misread: {cases}").format(cases=errati)) if errati else tr(
        "success, rejection and timeout told apart")


@prova("sistema")
def regione_radio_dal_fuso_orario():
    """Il paese del Wi-Fi si ricava dal fuso (Europe/Rome -> IT) e c'e' la regola udev."""
    rc, out, _e = _sh(["awk", "-v", "z=Europe/Rome", "$3 == z {print $1}", "/usr/share/zoneinfo/zone.tab"])
    regola = os.path.isfile("/etc/udev/rules.d/60-zeta-regione-radio.rules")
    ok = out.strip() == "IT" and regola and os.access("/usr/local/libexec/zeta-regione-radio", os.X_OK)
    if regola:
        dettaglio = tr("Europe/Rome -> {country}, udev rule present")
    else:
        dettaglio = tr("Europe/Rome -> {country}, udev rule MISSING")
    return ok, dettaglio.format(country=out.strip() or "?")


@prova("sistema")
def un_solo_firewall_e_una_sola_rete():
    """Un gestore per cosa: nftables (tabella inet zeta) per il firewall, iptables
    sul motore nftables, niente firewalld, ufw installato ma spento (o, se
    acceso, con le regole di SSH e ZETA Share); NetworkManager per rete e DNS."""
    prob = []
    rc, out, _e = _sh(["bash", "-lc", "iptables -V"])
    if rc != 0 or "nf_tables" not in out:
        prob.append(tr("iptables does not use nftables ({version})").format(version=out.strip()))
    if _sh(["bash", "-lc", "command -v firewalld"])[0] == 0:
        prob.append(tr("firewalld installed"))
    ufw = tr("ufw not installed")
    try:
        acceso = "ENABLED=yes" in open("/etc/ufw/ufw.conf").read()
        ufw = tr("ufw on") if acceso else tr("ufw installed and off")
        if os.access("/etc/ufw/user.rules", os.R_OK):
            regole = open("/etc/ufw/user.rules").read()
            if "--dport 53317" not in regole:
                prob.append(tr("ufw without the ZETA Share rules"))
            if acceso and os.path.exists("/etc/nftables.d/zeta-ssh.nft") and "--dport 22 " not in regole:
                prob.append(tr("ufw on without the SSH rule"))
    except OSError:
        pass
    if _sh(["systemctl", "is-active", "--quiet", "NetworkManager"])[0] != 0:
        prob.append(tr("NetworkManager not active"))
    for altro in ("systemd-networkd", "systemd-resolved"):
        if _sh(["systemctl", "is-active", "--quiet", altro])[0] == 0:
            prob.append(tr("{name} active alongside NetworkManager").format(name=altro))
    try:
        righe = [l.split("#")[0].strip() for l in open("/etc/network/interfaces")]
        extra = [l for l in righe if l.startswith(("auto ", "iface ")) and " lo" not in l]
        if extra:
            prob.append(tr("ifupdown manages interfaces: {names}").format(names=", ".join(extra)))
    except OSError:
        pass
    if _sh(["systemctl", "is-enabled", "--quiet", "nftables"])[0] != 0:
        prob.append(tr("nftables not enabled at boot"))
    return not prob, "; ".join(prob) if prob else tr(
        "nftables firewall (inet zeta), iptables-nft, {ufw}, network and DNS from NetworkManager").format(ufw=ufw)


@prova("sistema")
def accesso_remoto_ssh_coerente():
    """SSH e netcat ci sono; il server e' spento finche' non lo si accende, e se e'
    acceso la porta 22 e' aperta solo alla rete locale; root non entra."""
    mancanti = [c for c in ("ssh", "scp", "sftp", "ssh-keygen", "ssh-copy-id", "nc", "sshfs")
                if _sh(["bash", "-lc", "command -v %s" % c])[0] != 0]
    if not os.path.exists("/usr/sbin/sshd"):
        mancanti.append("sshd")
    if mancanti:
        return False, _mancano(mancanti)
    try:
        conf = open("/etc/ssh/sshd_config.d/zeta.conf").read()
        fw = open("/etc/nftables.conf").read()
    except OSError as e:
        return False, str(e)
    if ("PermitRootLogin no" not in conf or "@accesso_lan" not in fw or "@accesso_remoto" not in fw
            or 'include "/etc/nftables.d/*.nft"' not in fw):
        return False, tr("sshd or firewall configuration incomplete")
    if "ct state established,related accept" not in fw or "ct state invalid drop" not in fw:
        return False, tr("the firewall does not track connections (conntrack)")
    # «zeta-ssh config» stampa chiavi fisse (SSH_REMOTE_ACCESS=...); di «zeta-ssh
    # stato» conta solo il codice di uscita: 0 acceso, 1 spento, 2 a meta'.
    remoto = "SSH_REMOTE_ACCESS=true" in _sh(["zeta-ssh", "config"])[1]
    rc, out, _e = _sh(["zeta-ssh", "stato"])
    ascolta = bool(_sh(["ss", "-Htln", "sport = :22"])[1])
    if rc == 1 and ascolta:
        return False, tr("zeta-ssh says off but port 22 is listening")
    if rc == 0 and not ascolta:
        return False, tr("zeta-ssh says on but nothing listens on port 22")
    if rc not in (0, 1):
        return False, out[:120]
    if rc != 0:
        return True, tr("client, server, netcat and sshfs present; SSH off")
    if remoto:
        return True, tr("client, server, netcat and sshfs present; SSH on (also from the internet)")
    return True, tr("client, server, netcat and sshfs present; SSH on (local network only)")



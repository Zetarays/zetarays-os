@prova("agente")
def agente_nessuna_password_scritta():
    """Registro delle azioni e cronologia della chat non conservano password."""
    import tempfile
    from intelligence.agente import agente as A
    from intelligence.memory import Memory
    from intelligence.agente.capacita import Esito
    vecchio = A.LOG
    fd, A.LOG = tempfile.mkstemp()
    os.close(fd)
    try:
        A._registra("wifi_connect", {"rete": "Casa", "password": "segreta123"}, Esito(False, "x"), "prove")
        scritto = open(A.LOG).read()
    finally:
        os.unlink(A.LOG)
        A.LOG = vecchio
    if "segreta123" in scritto:
        return False, "password nel registro delle azioni"
    if "segreta123" in Memory._senza_segreti("connettiti a Casa con password segreta123"):
        return False, "password nella cronologia"
    return True, "registro e cronologia mascherano le password"



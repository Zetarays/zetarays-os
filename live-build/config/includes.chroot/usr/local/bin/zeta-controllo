"""ZETA RAYS — i pannelli della barra: Centro di controllo, Rete, Suono.

Un solo processo residente con tre viste, ognuna con le sole cose sue:

  controllo  (orologio, batteria, Super+A)  Wi-Fi, Bluetooth, Non disturbare,
             VPN, tema, luminosità e batteria, Impostazioni, spegnimento
  rete       (icona della rete)    stato, Internet, Wi-Fi e reti disponibili,
             VPN, Impostazioni di rete
  audio      (icona del volume)    volume e uscite, microfono e ingressi,
             Impostazioni audio

Fino alla 2.0 le icone di rete e volume aprivano lo stesso pannello, con
suono e rete mescolati ai riquadri rapidi. Stesso comando = apri/chiudi;
un'altra vista mentre il pannello è aperto passa a quella.
"""
import sys
import threading

sys.path.insert(0, "/usr/lib/zeta")
from ui import popup, tema  # noqa: E402

popup.preload_layer_shell()

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gio, GLib, Gtk, Pango  # noqa: E402

from system import audio, bluetooth, network, power, run, spawn  # noqa: E402
from i18n import tr, trc  # noqa: E402

VISTE = ("controllo", "rete", "audio")

CSS = """
.cc-percent { font-size: 12px; color: @ink_2; min-width: 34px; }
.cc-tile-title { font-size: 12px; font-weight: 500; }
.cc-tile-sub { font-size: 11px; color: @ink_dim; }
button.zeta-tile.on .cc-tile-sub { color: @ink_2; }
.cc-title { font-size: 14px; font-weight: 600; }
"""


def icon(name, size=16):
    return Gtk.Image(icon_name=name, pixel_size=size)


def dnd_active():
    return "do-not-disturb" in (run(["makoctl", "mode"]) or "")


def set_dnd(on):
    run(["makoctl", "mode", "-a" if on else "-r", "do-not-disturb"])


def caption(text):
    return Gtk.Label(label=text, xalign=0, css_classes=["zeta-caption"])


def section():
    """Riquadro di sezione: (contenitore esterno, contenitore interno)."""
    out = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["zeta-section"])
    inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                    margin_top=10, margin_bottom=10, margin_start=12, margin_end=12)
    out.append(inner)
    return out, inner


class Tile(Gtk.Button):
    def __init__(self, icon_name, title, on_click):
        super().__init__(css_classes=["zeta-tile"], hexpand=True)
        box = Gtk.Box(spacing=10)
        ic = Gtk.CenterBox(css_classes=["tile-icon"], valign=Gtk.Align.CENTER,
                           halign=Gtk.Align.START, hexpand=False)
        ic.set_size_request(30, 30)
        self.image = icon(icon_name)
        ic.set_center_widget(self.image)
        box.append(ic)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, hexpand=True)
        self.title = Gtk.Label(label=title, xalign=0, css_classes=["cc-tile-title"])
        text.append(self.title)
        self.sub = Gtk.Label(label="", xalign=0, css_classes=["cc-tile-sub"],
                             ellipsize=Pango.EllipsizeMode.END, max_width_chars=14)
        text.append(self.sub)
        box.append(text)
        self.set_child(box)
        self.connect("clicked", lambda *_: on_click())

    def set_state(self, on, subtitle, sensitive=True, title=None, icon_name=None):
        if title:
            self.title.set_text(title)
        if icon_name:
            self.image.set_from_icon_name(icon_name)
        (self.add_css_class if on else self.remove_css_class)("on")
        self.sub.set_text(subtitle)
        self.set_sensitive(sensitive)


class Control(Gtk.ApplicationWindow):
    def __init__(self, app, vista="controllo"):
        super().__init__(application=app, title=tr("Control Center"), decorated=False)
        popup.make_overlay(self, "zeta-control")
        self.busy = False
        self._updating = False
        self.vista = vista
        self._giro = 0                  # scarta i dati letti per una vista precedente

        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                            css_classes=["zeta-card"], halign=Gtk.Align.END, valign=Gtk.Align.END,
                            margin_end=12, margin_bottom=84)
        self.card.set_size_request(360, -1)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                        margin_top=14, margin_bottom=14, margin_start=14, margin_end=14)
        self.card.append(inner)

        # --- intestazione (Rete e Suono): titolo e, per il Wi-Fi, l'interruttore ---
        self.head = Gtk.Box(spacing=8, margin_start=4, margin_end=2)
        self.head_title = Gtk.Label(label="", xalign=0, hexpand=True, css_classes=["cc-title"])
        self.head.append(self.head_title)
        self.wifi_sw = Gtk.Switch(valign=Gtk.Align.CENTER, visible=False)
        self.wifi_sw.connect("notify::active", self.on_wifi_switch)
        self.head.append(self.wifi_sw)
        inner.append(self.head)

        # --- centro di controllo: riquadri rapidi ---
        self.tiles = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True)
        self.t_net = Tile("zeta-wifi", "Wi-Fi", self.toggle_wifi)
        self.t_bt = Tile("zeta-bluetooth", "Bluetooth", self.toggle_bt)
        self.t_dnd = Tile("zeta-bell-off", tr("Do Not Disturb"), self.toggle_dnd)
        self.t_vpn = Tile("zeta-vpn", "VPN", self.toggle_vpn)
        self.t_tema = Tile("zeta-moon", tr("Theme"), self.toggle_tema)
        self.tiles.attach(self.t_net, 0, 0, 1, 1)
        self.tiles.attach(self.t_bt, 1, 0, 1, 1)
        self.tiles.attach(self.t_dnd, 0, 1, 1, 1)
        self.tiles.attach(self.t_vpn, 1, 1, 1, 1)
        # larga due colonne: le altre quattro accendono e spengono qualcosa,
        # questa alterna fra due stati e la riga intera lo rende evidente.
        self.tiles.attach(self.t_tema, 0, 2, 2, 1)
        inner.append(self.tiles)

        # --- suono: uscita e ingresso ---
        self.sound = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.out_sec, s_out = section()
        s_out.append(caption(tr("Output")))
        self.out_mute, self.out_scale, self.out_pct = self._volume_row(s_out, "zeta-volume",
                                                                       audio.DEFAULT_SINK)
        self.out_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        s_out.append(self.out_list)
        self.sound.append(self.out_sec)
        self.in_sec, s_in = section()
        s_in.append(caption(tr("Microphone")))
        self.in_mute, self.in_scale, self.in_pct = self._volume_row(s_in, "zeta-mic",
                                                                    audio.DEFAULT_SOURCE)
        self.in_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        s_in.append(self.in_list)
        self.sound.append(self.in_sec)
        self.no_audio = Gtk.Label(label=tr("No sound card detected"), xalign=0, margin_start=4,
                                  css_classes=["zeta-dim", "zeta-small"], visible=False)
        self.sound.append(self.no_audio)
        inner.append(self.sound)

        # --- rete: stato, reti Wi-Fi, VPN ---
        self.netsec = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        stato_sec, st_in = section()
        st = Gtk.Box(spacing=10)
        self.net_icon = icon("zeta-ethernet")
        st.append(self.net_icon)
        st_txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
        self.net_label = Gtk.Label(label="", xalign=0, css_classes=["zeta-small"],
                                   ellipsize=Pango.EllipsizeMode.END)
        st_txt.append(self.net_label)
        self.net_internet = Gtk.Label(label="", xalign=0, css_classes=["zeta-dim", "zeta-small"],
                                      ellipsize=Pango.EllipsizeMode.END)
        st_txt.append(self.net_internet)
        st.append(st_txt)
        st_in.append(st)
        self.netsec.append(stato_sec)

        self.wifi_sec, w_in = section()
        w_in.append(caption(tr("Available Networks")))
        self.wifi_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        w_in.append(self.wifi_list)
        self.wifi_vuoto = Gtk.Label(label="", xalign=0, css_classes=["zeta-dim", "zeta-small"],
                                    visible=False)
        w_in.append(self.wifi_vuoto)
        self.pw_rev = Gtk.Revealer(visible=False)   # nascosto: niente spazio vuoto sotto le reti
        pwb = Gtk.Box(spacing=6, margin_top=4)
        self.pw_entry = Gtk.PasswordEntry(show_peek_icon=True, hexpand=True, css_classes=["zeta-entry"])
        self.pw_entry.set_property("placeholder-text", tr("Network password"))
        self.pw_entry.connect("activate", lambda *_: self.connect_pending())
        pwb.append(self.pw_entry)
        cb = Gtk.Button(label=tr("Connect"), css_classes=["zeta-primary"])
        cb.connect("clicked", lambda *_: self.connect_pending())
        pwb.append(cb)
        self.pw_rev.set_child(pwb)
        w_in.append(self.pw_rev)
        # a capo entro la larghezza del pannello: un messaggio lungo non lo allarga
        self.net_msg = Gtk.Label(label="", xalign=0, css_classes=["zeta-dim", "zeta-small"],
                                 wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR,
                                 max_width_chars=36, width_chars=36, visible=False)
        w_in.append(self.net_msg)
        self.netsec.append(self.wifi_sec)

        self.vpn_sec, v_in = section()
        v_in.append(caption("VPN"))
        self.vpn_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        v_in.append(self.vpn_list)
        self.netsec.append(self.vpn_sec)
        inner.append(self.netsec)

        # --- luminosità e batteria (centro di controllo) ---
        self.extra, e_in = section()
        self.extra.set_visible(False)
        self.bright_row = Gtk.Box(spacing=8, visible=False)
        self.bright_row.append(icon("zeta-sun"))
        self.bright = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 100, 1)
        self.bright.set_draw_value(False)
        self.bright.set_hexpand(True)
        self.bright.connect("value-changed", lambda s: None if self._updating
                            else power.set_backlight(s.get_value()))
        self.bright_row.append(self.bright)
        e_in.append(self.bright_row)
        self.bat_row = Gtk.Box(spacing=8, visible=False)
        self.bat_icon = icon("zeta-battery")
        self.bat_row.append(self.bat_icon)
        self.bat_label = Gtk.Label(label="", xalign=0, css_classes=["zeta-small"])
        self.bat_row.append(self.bat_label)
        e_in.append(self.bat_row)
        inner.append(self.extra)

        # --- piede ---
        foot = Gtk.Box(spacing=8)
        sb = Gtk.Button(css_classes=["zeta-flat"])
        sbb = Gtk.Box(spacing=8)
        sbb.append(icon("zeta-settings"))
        self.settings_label = Gtk.Label(label=tr("Settings"), css_classes=["zeta-small"])
        sbb.append(self.settings_label)
        sb.set_child(sbb)
        sb.connect("clicked", lambda *_: self.open_settings(
            {"rete": "rete", "audio": "audio"}.get(self.vista)))
        foot.append(sb)
        foot.append(Gtk.Box(hexpand=True))
        self.power_b = Gtk.Button(css_classes=["zeta-round"], tooltip_text=tr("Shut down, restart, log out…"))
        self.power_b.set_child(icon("zeta-power"))
        self.power_b.connect("clicked", lambda *_: (spawn(["zeta-pannello", "energia"]), self.close_app()))
        foot.append(self.power_b)
        inner.append(foot)

        self.set_child(self.card)
        popup.close_on_outside(self, self.card, self.close_app)
        self.pending_ssid = None
        self.imposta_vista(vista)
        GLib.timeout_add_seconds(3, self._periodic)

    # ---------- costruzione ----------
    def _volume_row(self, parent, icon_name, target):
        row = Gtk.Box(spacing=8)
        mute = Gtk.Button(css_classes=["zeta-round"], valign=Gtk.Align.CENTER)
        mute.set_child(icon(icon_name))
        mute.target = target
        mute.connect("clicked", self.on_mute)
        row.append(mute)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        scale.set_draw_value(False)
        scale.set_hexpand(True)
        scale.target = target
        scale.connect("value-changed", self.on_scale)
        row.append(scale)
        pct = Gtk.Label(label="", css_classes=["cc-percent"], xalign=1)
        row.append(pct)
        parent.append(row)
        return mute, scale, pct

    def imposta_vista(self, vista):
        """Mostra solo le parti della vista; i dati si rileggono subito."""
        self.vista = vista if vista in VISTE else "controllo"
        v = self.vista
        self._giro += 1
        self.head.set_visible(v != "controllo")
        self.head_title.set_text({"rete": tr("Wi-Fi & Network"), "audio": tr("Sound")}.get(v, ""))
        self.wifi_sw.set_visible(False)            # lo accende _apply se c'è il Wi-Fi
        self.tiles.set_visible(v == "controllo")
        self.sound.set_visible(v == "audio")
        self.netsec.set_visible(v == "rete")
        if v != "controllo":
            self.extra.set_visible(False)
        self.power_b.set_visible(v == "controllo")
        self.settings_label.set_text({"rete": tr("Network Settings…"),
                                      "audio": tr("Sound Settings…")}.get(v, tr("Settings")))
        self.set_title({"rete": tr("Wi-Fi & Network"), "audio": tr("Sound")}.get(v, tr("Control Center")))
        if v != "rete":
            self._chiedi_password(False)
            self._message("")
        self.refresh_all()
        if v == "rete":
            # prima l'elenco già noto (subito), poi una nuova ricerca delle reti
            self.refresh_all(rescan=True)

    # ---------- dati ----------
    def refresh_all(self, rescan=False):
        threading.Thread(target=self._gather, args=(self.vista, self._giro, rescan),
                         daemon=True).start()

    def _gather(self, vista, giro, rescan=False):
        data = {"vista": vista, "giro": giro}
        if vista == "audio":
            data.update(
                out=audio.volume(audio.DEFAULT_SINK), inp=audio.volume(audio.DEFAULT_SOURCE),
                sinks=[x for x in audio.devices(audio.SINK) if x["name"] != "auto_null"],
                sources=[x for x in audio.devices(audio.SOURCE)
                         if not x["name"].endswith(".monitor")])
        else:
            data.update(net=network.status(), has_wifi=network.has_wifi(),
                        wifi_on=network.wifi_enabled(), vpns=network.vpns())
            data["wifi"] = (network.wifi_networks(rescan)
                            if data["has_wifi"] and data["wifi_on"] else [])
            if vista == "rete":
                data["internet"] = network.connectivity()
            else:
                data.update(bt=bluetooth.adapter(), dnd=dnd_active(),
                            bright=power.backlight()[0], bat=power.battery(),
                            chiaro=tema.is_light())
        GLib.idle_add(self._apply, data)

    def _periodic(self):
        # nascosto (residente) non si legge nulla: niente lavoro in sottofondo
        if not self.busy and self.get_visible():
            self.refresh_all()
        return True

    def _apply(self, d):
        # compare subito (vedi App.alterna) e qui si aggiorna mentre e' aperto
        if d["giro"] != self._giro:
            return False                 # letti per la vista di prima
        self._updating = True
        try:
            if d["vista"] == "audio":
                self._apply_audio(d)
            elif d["vista"] == "rete":
                self._apply_rete(d)
            else:
                self._apply_controllo(d)
        finally:
            self._updating = False
        return False

    def _apply_audio(self, d):
        out_v, out_m = d["out"]
        has_audio = out_v is not None and bool(d["sinks"])
        self.out_sec.set_visible(has_audio)
        self.no_audio.set_visible(not has_audio)
        if has_audio:
            self.out_scale.set_value(round(out_v * 100))
            self.out_pct.set_text("%d%%" % round(out_v * 100))
            self._set_mute_icon(self.out_mute, out_m, out_v)
            self._fill(self.out_list, [self._choice_row(s["label"], s["default"],
                                                        lambda s=s: self.pick_device(s["id"]))
                                       for s in d["sinks"]])
        in_v, in_m = d["inp"]
        has_mic = in_v is not None and bool(d["sources"])
        self.in_sec.set_visible(has_mic)
        if has_mic:
            self.in_scale.set_value(round(in_v * 100))
            self.in_pct.set_text("%d%%" % round(in_v * 100))
            self.in_mute.get_child().set_from_icon_name("zeta-mic-off" if in_m else "zeta-mic")
            self._fill(self.in_list, [self._choice_row(s["label"], s["default"],
                                                       lambda s=s: self.pick_device(s["id"]))
                                      for s in d["sources"]])

    def _apply_rete(self, d):
        n = d["net"]
        if n["connected"]:
            name = (n["label"] or n["name"]) if n["kind"] == "wifi" else "Ethernet"
            self.net_label.set_text("%s · %s" % (name, n["ip"]) if n["ip"] else name)
            self.net_icon.set_from_icon_name("zeta-wifi" if n["kind"] == "wifi" else "zeta-ethernet")
        else:
            self.net_label.set_text(tr("Not connected"))
            self.net_icon.set_from_icon_name("zeta-offline")
        self.net_internet.set_text({
            "full": tr("Connected to the Internet"),
            "limited": tr("Limited connection: no Internet access"),
            "portal": tr("Sign-in required: open the browser"),
            "none": tr("No Internet access"),
        }.get(d["internet"], "") if n["connected"] else tr("No Internet access"))
        self.wifi_sw.set_visible(d["has_wifi"])
        self.wifi_sw.set_active(d["wifi_on"])
        self.head_title.set_text("Wi-Fi" if d["has_wifi"] else tr("Network"))
        self.wifi_sec.set_visible(d["has_wifi"])
        if d["has_wifi"] and not self.busy:
            self._fill(self.wifi_list, [self._wifi_row(w) for w in d["wifi"][:8]])
            vuoto = (tr("Wi-Fi is off") if not d["wifi_on"]
                     else tr("No networks found") if not d["wifi"] else "")
            self.wifi_vuoto.set_text(vuoto)
            self.wifi_vuoto.set_visible(bool(vuoto))
        self.vpn_sec.set_visible(bool(d["vpns"]))
        self._fill(self.vpn_list, [self._vpn_row(v) for v in d["vpns"]])

    def _apply_controllo(self, d):
        n = d["net"]
        if d["has_wifi"]:
            # la rete Wi-Fi attiva, anche quando la connessione principale e'
            # il cavo (prima il riquadro diceva «Non connesso»)
            attiva = next((w["ssid"] for w in d["wifi"] if w["active"]), None)
            sub = attiva or (tr("Not connected") if d["wifi_on"] else tr("Off"))
            self.t_net.set_state(d["wifi_on"], sub, title="Wi-Fi", icon_name="zeta-wifi")
        else:
            self.t_net.set_state(n["connected"], "Ethernet" if n["connected"] else tr("Not connected"),
                                 title=tr("Network"), icon_name="zeta-ethernet")
        vp = d["vpns"]
        act = next((v for v in vp if v["active"]), None)
        self.t_vpn.set_state(bool(act), act["name"] if act else (trc("vpn", "Disconnected") if vp else tr("Not set up")))
        bt = d["bt"]
        self.t_bt.set_state(bool(bt and bt["powered"]),
                            (tr("On") if bt["powered"] else tr("Off")) if bt else tr("Unavailable"),
                            sensitive=bool(bt))
        self.t_dnd.set_state(d["dnd"], tr("Active") if d["dnd"] else tr("Off"))
        self.t_tema.set_state(d["chiaro"], "SUPER + T",
                              title=tr("Light theme") if d["chiaro"] else tr("Dark theme"),
                              icon_name="zeta-sun" if d["chiaro"] else "zeta-moon")
        self.bright_row.set_visible(d["bright"] is not None)
        if d["bright"] is not None:
            self.bright.set_value(d["bright"])
        b = d["bat"]
        self.bat_row.set_visible(b is not None)
        if b:
            testo = tr("Battery {percent}%").format(
                percent=b["percent"] if b["percent"] is not None else "—")
            self.bat_label.set_text(testo + ((" · " + b["state"]) if b["state"] else ""))
        self.extra.set_visible(d["bright"] is not None or b is not None)

    def _set_mute_icon(self, button, muted, vol):
        name = ("zeta-volume-mute" if muted or vol == 0
                else "zeta-volume-low" if vol < 0.5 else "zeta-volume")
        button.get_child().set_from_icon_name(name)

    @staticmethod
    def _fill(box, rows):
        child = box.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            box.remove(child)
            child = nxt
        for r in rows:
            box.append(r)

    def _choice_row(self, label, selected, action):
        b = Gtk.Button(css_classes=["zeta-row"])
        row = Gtk.Box(spacing=8)
        row.append(Gtk.Label(label=label, xalign=0, hexpand=True, css_classes=["zeta-small"],
                             ellipsize=Pango.EllipsizeMode.END))
        ck = icon("zeta-check", 14)
        ck.add_css_class("zeta-check")
        ck.set_opacity(1 if selected else 0)
        row.append(ck)
        b.set_child(row)
        b.connect("clicked", lambda *_: action())
        return b

    def _wifi_row(self, w):
        b = Gtk.Button(css_classes=["zeta-row"])
        row = Gtk.Box(spacing=8)
        lvl = 3 if w["signal"] > 66 else 2 if w["signal"] > 33 else 1
        row.append(icon("zeta-wifi-%d" % lvl))
        row.append(Gtk.Label(label=w["ssid"], xalign=0, hexpand=True, css_classes=["zeta-small"],
                             ellipsize=Pango.EllipsizeMode.END))
        if w["secure"]:
            row.append(icon("zeta-lock", 12))
        if w["active"]:
            ck = icon("zeta-check", 14)
            ck.add_css_class("zeta-check")
            row.append(ck)
        b.set_child(row)
        b.connect("clicked", lambda *_: self.pick_wifi(w))
        return b

    def _vpn_row(self, v):
        row = Gtk.Box(spacing=8, css_classes=["zeta-row"])
        row.append(icon("zeta-vpn"))
        row.append(Gtk.Label(label="%s  " % v["name"], xalign=0, hexpand=True, css_classes=["zeta-small"],
                             ellipsize=Pango.EllipsizeMode.END))
        sw = Gtk.Switch(active=v["active"], valign=Gtk.Align.CENTER)
        sw.connect("state-set", lambda _s, on, v=v: self.set_vpn(v, on))
        row.append(sw)
        return row

    # ---------- azioni ----------
    def on_scale(self, scale):
        if self._updating:
            return
        v = scale.get_value() / 100
        audio.set_volume(v, scale.target)
        pct = self.out_pct if scale is self.out_scale else self.in_pct
        pct.set_text("%d%%" % round(v * 100))
        if scale is self.out_scale:
            self._set_mute_icon(self.out_mute, False, v)
            audio.set_mute(False, scale.target)
            spawn(["pkill", "-RTMIN+11", "-x", "waybar"])     # icona del volume nella barra

    def on_mute(self, button):
        _v, muted = audio.volume(button.target)
        audio.set_mute(not muted, button.target)
        if button is self.out_mute:
            spawn(["pkill", "-RTMIN+11", "-x", "waybar"])
        self.refresh_all()

    def pick_device(self, node_id):
        audio.set_default(node_id)
        self.refresh_all()

    def on_wifi_switch(self, sw, _param):
        if self._updating:
            return
        network.set_wifi(sw.get_active())
        GLib.timeout_add(800, lambda: (self.refresh_all(rescan=sw.get_active()), False)[1])

    def toggle_wifi(self):
        if not network.has_wifi():
            self.open_settings("rete")
            return
        network.set_wifi(not network.wifi_enabled())
        GLib.timeout_add(800, lambda: (self.refresh_all(), False)[1])

    def toggle_bt(self):
        a = bluetooth.adapter()
        if a:
            threading.Thread(target=lambda: (bluetooth.set_power(not a["powered"]),
                                             GLib.idle_add(self.refresh_all)), daemon=True).start()

    def toggle_tema(self):
        """Passa da scuro a chiaro e viceversa.

        Il tema lo decide e lo applica zeta-aspetto: qui non si riscrive nulla,
        si chiama quello. Dura qualche secondo (colori, barra, terminale,
        sfondo), quindi va in un thread o la finestra si blocca.
        """
        self.t_tema.set_sensitive(False)
        threading.Thread(
            target=lambda: (run(["zeta-aspetto", "cambia-tema"], timeout=90),
                            GLib.idle_add(popup.ricarica),
                            GLib.idle_add(self.refresh_all)),
            daemon=True).start()

    def toggle_dnd(self):
        set_dnd(not dnd_active())
        self.refresh_all()

    def toggle_vpn(self):
        vp = network.vpns()
        if not vp:
            self.open_settings("rete")
            return
        act = next((v for v in vp if v["active"]), None)
        self.set_vpn(act or vp[0], act is None)

    def set_vpn(self, v, on):
        self._message(tr("Turning on {name}…").format(name=v["name"]) if on
                      else tr("Turning off {name}…").format(name=v["name"]))

        def work():
            ok = network.set_vpn(v["uuid"], on)
            if ok:
                errore = ""
            elif on:
                errore = tr("Couldn't turn on the VPN {name}").format(name=v["name"])
            else:
                errore = tr("Couldn't turn off the VPN {name}").format(name=v["name"])
            GLib.idle_add(self._message, errore)
            GLib.idle_add(self.refresh_all)
        threading.Thread(target=work, daemon=True).start()
        return False

    def pick_wifi(self, w):
        if w["active"]:
            return
        if w["secure"] and not network.known_connection(w["ssid"]):
            self.pending_ssid = w["ssid"]
            self.pw_entry.set_text("")
            self._chiedi_password(True)
            self.pw_entry.grab_focus()
            self._message(tr("Password for “{network}”").format(network=w["ssid"]))
            return
        self.pending_ssid = w["ssid"]
        self.connect_pending(ask=False)

    def connect_pending(self, ask=True):
        ssid = self.pending_ssid
        if not ssid:
            return
        pw = self.pw_entry.get_text() if ask else None
        if ask and not pw:
            self._message(tr("Enter the password for “{network}”").format(network=ssid))
            self.pw_entry.grab_focus()
            return
        if self.busy:
            return                          # un tentativo alla volta
        self.busy = True
        self._chiedi_password(False)
        self._message(tr("Connecting to “{network}”…").format(network=ssid))

        def work():
            ok, msg, motivo = network.connect_wifi_esito(ssid, pw or None)
            self.busy = False
            GLib.idle_add(self._message, msg)
            if motivo == "password":
                # password sbagliata: si richiede subito, con il motivo scritto
                GLib.idle_add(self._richiedi_password, ssid)
            GLib.idle_add(self.refresh_all)
        threading.Thread(target=work, daemon=True).start()

    def _richiedi_password(self, ssid):
        self.pending_ssid = ssid
        self.pw_entry.set_text("")
        self._chiedi_password(True)
        self.pw_entry.grab_focus()
        return False

    def _chiedi_password(self, si):
        self.pw_rev.set_visible(si)
        self.pw_rev.set_reveal_child(si)

    def _message(self, text):
        self.net_msg.set_text(text)
        self.net_msg.set_visible(bool(text))
        return False

    def open_settings(self, page=None):
        spawn(["zeta-impostazioni"] + ([page] if page else []))
        self.close_app()

    def close_app(self):
        # resta in memoria, nascosto: la prossima apertura e' immediata
        self.set_visible(False)


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Controllo",
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None
        self.nascosto = False

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.nascosto = popup.avvio_nascosto()
        popup.clean_env()
        popup.load_css(CSS)
        # zeta-pannello controllo|rete|audio manda l'azione della vista
        popup.azione_mostra(self, lambda: self.alterna("controllo"))
        for vista in ("rete", "audio"):
            a = Gio.SimpleAction.new(vista, None)
            a.connect("activate", lambda *_a, v=vista: self.alterna(v))
            self.add_action(a)
        self.hold()                    # resta vivo anche a pannello nascosto

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        vista = args[0] if args and args[0] in VISTE else "controllo"
        if self.nascosto:              # avviato dalla sessione: dati letti, non visibile
            self.nascosto = False
            self.win = Control(self, vista)
            return 0
        self.alterna(vista)
        return 0

    def alterna(self, vista="controllo"):
        """Clic su un'icona: apre subito la sua vista, la chiude, o passa a quella."""
        if self.win is not None and self.win.get_visible() and self.win.vista == vista:
            self.win.close_app()
            return
        if self.win is None:
            self.win = Control(self, vista)
        else:
            self.win.imposta_vista(vista)
        self.win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))

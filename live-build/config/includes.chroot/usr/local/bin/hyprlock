#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — lock screen.
#
# In virtual machines Hyprland rejects GPU buffers from clients, so hyprlock
# draws with software rendering there. Outside VMs nothing changes.
#
# This wrapper also records the fact that the screen IS locked: if hyprlock
# dies because of a bug, Hyprland shows an emergency screen and the user is
# locked out of the session. The signal file lets zeta-watchdog notice this and
# put the lock back immediately.
[ "$ZETA_VM" = 1 ] && export LIBGL_ALWAYS_SOFTWARE=1

LOCK_FLAG="${XDG_RUNTIME_DIR:-/tmp}/zeta-screen-locked"
: > "$LOCK_FLAG"
/usr/bin/hyprlock "$@"
STATUS=$?
# exit 0 = the user unlocked: there is nothing left to watch.
# any other exit = it died: the signal file stays and zeta-watchdog relocks.
[ "$STATUS" -eq 0 ] && rm -f "$LOCK_FLAG"
exit "$STATUS"

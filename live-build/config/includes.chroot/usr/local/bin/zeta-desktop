#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""zeta-desktop — the ZETA RAYS desktop: files, folders and icons on the wallpaper.

It behaves like the desktop of any ordinary operating system: double-click to
open, single or multiple selection, drag to move, copy/cut/paste, trash, and a
right-click menu with everything needed.

  zeta-desktop            start (launched by zeta-session)
  zeta-desktop --status   print the state in readable form (for tests)

The folder shown is the system one (xdg-user-dir DESKTOP), usually
~/Desktop or its name in the user's language. The «Home» and «Trash» icons are always present and can be moved
like the others.

Keyboard note: this is a full-screen compositor surface. If it requested
keyboard focus, no window could receive keystrokes any more and the desktop
would look frozen. So it never requests it, and every action is reachable
with the mouse and from the right-click menu.
"""
import json
import os
import threading
import re
import shutil
import subprocess
import sys
import urllib.parse

sys.path.insert(0, "/usr/lib/zeta")
from ui import popup  # noqa: E402
from system import download  # noqa: E402
from system import folder_colors  # noqa: E402
from i18n import ntr, tr  # noqa: E402


# drag-and-drop formats the desktop can use, besides files
MIME_URI = ("text/uri-list", "text/x-moz-url")
MIME_TEXT = ("text/plain;charset=utf-8", "text/plain", "UTF8_STRING")
IMAGE_MIME_TYPES = ("image/png", "image/jpeg", "image/webp", "image/gif", "image/bmp",
                 "image/avif", "image/svg+xml")


_CHILDREN = set()


def _spawn(cmd, **kw):
    """Starts a program and reaps it when it exits: fired and forgotten,
    «gio open» lingered as a zombie process (observed)."""
    p = subprocess.Popen(cmd, **kw)
    from gi.repository import GLib as _G
    _CHILDREN.add(p)                  # so Python does not reap it a second time

    def finished(_pid, state, proc=p):
        proc.returncode = state
        _CHILDREN.discard(proc)
    _G.child_watch_add(_G.PRIORITY_DEFAULT_IDLE, p.pid, finished)
    return p

popup.preload_layer_shell()

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")

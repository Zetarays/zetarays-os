                           Pango)

CFG = os.path.expanduser("~/.config/zeta")
STATE = os.path.join(CFG, "desktop.json")
MARGIN = 18          # distance from the screen edges
CLIP_MIME = "x-special/gnome-copied-files"   # format shared with file managers


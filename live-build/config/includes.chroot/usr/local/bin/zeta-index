#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""zeta-index — updates the content index used by ZETA RAYS search.

  zeta-index            incremental update (only the files that changed)
  zeta-index --full     rebuilds the index from scratch
  zeta-index --search Q searches the index (for diagnostics)

Meant to run at low priority (nice/ionice) from a user timer.
"""
import sys

sys.path.insert(0, "/usr/lib/zeta")
from search import indexer  # noqa: E402
from i18n import tr  # noqa: E402


def main(argv):
    if len(argv) > 1 and argv[1] in ("--search", "-s"):
        for r in indexer.search(" ".join(argv[2:])):
            print("%-9s %s\n          %s" % (r["kind"], r["path"], r["snippet"]))
        return 0
    full = "--full" in argv[1:]
    stats = indexer.reindex(full=full)
    print(tr("Index updated: {added} new, {updated} updated, {removed} removed.").format(
        added=stats["added"], updated=stats["updated"], removed=stats["removed"]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

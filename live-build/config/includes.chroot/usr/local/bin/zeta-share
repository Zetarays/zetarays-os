#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA Share — send files instantly to nearby devices.
#
#   zeta-share                  opens ZETA Share
#   zeta-share FILE|FOLDER…     opens ZETA Share with these files ready to send
#
# Underneath is LocalSend (localsend.org), the open standard for exchanging
# files on the local network between Linux, Windows, macOS, Android and
# iPhone/iPad. Files go directly from one device to the other (HTTPS,
# encrypted), without passing through the internet or an external service.
# LocalSend is not modified: this only chooses what to hand it. If it is
# already open, it receives the files in the existing window.
export TEXTDOMAIN=zetarays TEXTDOMAINDIR=/usr/share/locale
command -v gettext >/dev/null 2>&1 || gettext() { printf '%s' "$1"; }
APP=/opt/localsend_app/localsend_app
[ -x "$APP" ] || APP=$(command -v localsend_app || command -v localsend || true)
if [ -z "$APP" ]; then
    notify-send -a "ZETA RAYS" -i zeta-share "$(gettext "ZETA Share is not installed")" \
        "$(gettext "LocalSend, the app that sends the files, is missing. Reinstall it from the official package at localsend.org (localsend_*.deb).")" \
        2>/dev/null
    exit 1
fi

files=()
for a in "$@"; do
    case "$a" in
        file://*)                              # from file managers that pass URIs
            a=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(urllib.parse.urlparse(sys.argv[1]).path))' "$a") ;;
    esac
    # only files and folders that exist, with the full path: a name starting
    # with "-" cannot be mistaken for an option
    if [ -e "$a" ]; then
        files+=("$(realpath -- "$a")")
    fi
done

# In virtual machines Hyprland rejects client GPU buffers (dmabuf): LocalSend
# (Flutter, renders with GL) quits on Wayland with "Error 22". It is run on
# Xwayland instead, just as mpv uses wlshm (see zeta-desktop-session).
# On a real computer it stays on Wayland.
if [ "${ZETA_VM:-0}" = 1 ]; then
    export GDK_BACKEND=x11
fi

# Initial choices, written only if the user has not made any yet (if they
# change them in ZETA Share's settings, theirs are kept):
#  - animations off: with the device-search animation, LocalSend open and idle
#    used 16% of the CPU, without it 0.5% (measured);
#  - dark theme with the "OLED" color: black background, dark gray panels,
#    white text, and the ZETA RAYS system color as the only accent (blue, or
#    the chosen one; with a white accent everything is gray). By default
#    LocalSend is teal. The values are the ones LocalSend itself writes: a
#    wrong value makes it quit at startup (tested).
PREF="${XDG_DATA_HOME:-$HOME/.local/share}/org.localsend.localsend_app/shared_preferences.json"
python3 - "$PREF" <<'PREFERENCES' 2>/dev/null
import json, os, sys
p = sys.argv[1]
try:
    d = json.load(open(p))
except (OSError, ValueError):
    d = None if os.path.exists(p) else {}
DEFAULTS = {"flutter.ls_enable_animations": False,
               "flutter.ls_theme": "dark",
               "flutter.ls_color": "oled"}
missing = {k: v for k, v in DEFAULTS.items() if isinstance(d, dict) and k not in d}
if missing:
    d.update(missing)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    tmp = p + ".zeta"
    with open(tmp, "w") as f:
        json.dump(d, f)
    os.replace(tmp, p)
PREFERENCES

cd "$HOME" || exit 1
setsid "$APP" "${files[@]}" >/dev/null 2>&1 < /dev/null &
exit 0

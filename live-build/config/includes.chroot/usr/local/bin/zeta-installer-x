#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Fallback session without 3D acceleration (Xorg, software rendering).
#  - On the live system: opens the ZETA RAYS installer (Calamares), so
#    installation works anyway.
#  - On the installed system: explains how to enable 3D (zeta-no3d).
# matchbox keeps the window full screen and gives it keyboard focus.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export LIBGL_ALWAYS_SOFTWARE=1
mkdir -p "$HOME/.local/share/zeta"

CLIENT="$(mktemp)"
if [ -d /run/live/medium ]; then
    cat > "$CLIENT" <<'CL'
#!/bin/sh
xset s off -dpms 2>/dev/null
xhost +si:localuser:root >/dev/null 2>&1
matchbox-window-manager -use_titlebar no -use_cursor yes -theme ZETA RAYS &
sleep 1   # the window manager must be running before the first window
# Once the installer closes, a screen lets the user reopen it, shut down or reboot.
while :; do
    sudo -E /usr/libexec/zeta-installer
    zeta-no3d --live
    [ $? -eq 10 ] || break
done
CL
else
    cat > "$CLIENT" <<'CL'
#!/bin/sh
xset s off -dpms 2>/dev/null
matchbox-window-manager -use_titlebar no -use_cursor yes -theme ZETA RAYS &
sleep 1   # the window manager must be running before the first window
zeta-no3d
CL
fi
chmod +x "$CLIENT"

# X11 session already started by SDDM (computer without a DRM driver: SDDM only
# shows X11 sessions): use that display server instead of starting a second one.
if [ -n "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; then
    exec sh "$CLIENT" > "$HOME/.local/share/zeta/xinstaller.log" 2>&1
fi

# First free display: after a manual login, :0 still belongs to the login screen.
n=0
while [ -e "/tmp/.X$n-lock" ] || [ -e "/tmp/.X11-unix/X$n" ]; do n=$((n + 1)); done

exec xinit "$CLIENT" -- ":$n" "vt${XDG_VTNR:-2}" -nolisten tcp > "$HOME/.local/share/zeta/xinstaller.log" 2>&1

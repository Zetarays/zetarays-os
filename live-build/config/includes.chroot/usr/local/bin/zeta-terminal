#!/bin/bash
# shellcheck disable=SC2059,SC1111  # printf formats from translations; typographic quotes intended
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — terminal: shell inside tmux, tabs, splits, multiple shells.
#
#   zeta-terminal                 new session with the default shell (started by foot)
#   zeta-terminal menu            «New tab with…» menu (bash, zsh, fish, …)
#   zeta-terminal shell NAME      new tab with that shell
#   zeta-terminal cleanup SESS    (tmux, when the window closes) see below
#   zeta-terminal shells          the installed shells
#
# Why tmux: if the terminal window is closed or crashes, the commands that
# were running keep going and the session can be resumed with
# «zeta shell sessions». When instead a window that only had the prompt is
# closed, the session closes with it: no process is left lying around.
set -u
export TEXTDOMAIN=zetarays TEXTDOMAINDIR=/usr/share/locale
command -v gettext >/dev/null 2>&1 || gettext() { printf '%s' "$1"; }
CONF=/usr/share/zeta/shell/tmux.conf
PREF="$HOME/.config/zeta/shell"

# tmux texts (right-click menu, prompts) in the user's language.
# tmux.conf is a fixed file in English: its translation is written here to
# ~/.cache/zeta/tmux-texts.conf, which tmux.conf loads last. It is rewritten
# only when the language or the installed translation changes.
tq() {                      # text safe inside "..." in tmux.conf
    local t                 # (with -f, tmux #{...} formats are kept)
    if [ "$1" = -f ]; then t=$(gettext "$2"); else t=$(gettext "$1"); fi
    t=${t//\\/\\\\}; t=${t//\"/\\\"}
    [ "$1" = -f ] || t=${t//#/##}
    printf '%s' "$t"
}
tmux_texts() {
    local T="$HOME/.cache/zeta/tmux-texts.conf" L question key mo
    L="${LANGUAGE:-}|${LC_ALL:-}|${LC_MESSAGES:-}|${LANG:-}"
    mo=$(ls -t /usr/share/locale/*/LC_MESSAGES/zetarays.mo 2>/dev/null | head -1)
    if [ -f "$T" ] && [ "$(head -1 "$T")" = "# $L" ] && [ "$T" -nt "$0" ] \
       && { [ -z "$mo" ] || [ "$T" -nt "$mo" ]; }; then
        return 0
    fi
    mkdir -p "${T%/*}"
    question=$(tq -f "#{pane_current_command} is running in this pane: close it? (y/n)")
    # the confirmation key is the letter after the last «(» of the translated question
    key=${question##*(}; key=${key:0:1}
    case "$key" in [[:alpha:]]) ;; *) key=y ;; esac
    {
        echo "# $L"
        echo "# generated by zeta-terminal: do not edit"
        printf '%s\n' "bind -n User1 if -F \"#{m/r:^-?(bash|zsh|fish|sh|dash|ksh|mksh|tcsh)\$,#{pane_current_command}}\" \"kill-pane\" \"confirm-before -p \\\"$question\\\" -c $key kill-pane\""
        printf '%s\n' "bind -n User5 command-prompt -I \"#W\" -p \"$(tq "Tab name:")\" \"rename-window -- \\\"%%\\\"\""
        printf '%s\n' "bind -n User6 copy-mode \; command-prompt -p \"$(tq "Search:")\" \"send -X search-backward \\\"%%\\\"\""
        printf '%s\n' "bind -n MouseDown3Pane display-menu -O -T \"#[align=centre] $(tq "Terminal") \" -x M -y M \\"
        printf '%s\n' "  \"$(tq "Paste")\" v \"run-shell \\\"wl-paste -n | tmux load-buffer -b zeta-clip - && tmux paste-buffer -p -d -b zeta-clip\\\"\" \\"
        printf '%s\n' "  \"$(tq "Select and Copy")\" c \"copy-mode\" \\"
        printf '%s\n' "  \"\" \\"
        printf '%s\n' "  \"$(tq "New Tab")\" t \"new-window -c \\\"#{pane_current_path}\\\"\" \\"
        printf '%s\n' "  \"$(tq "New Tab With…")\" n \"run-shell \\\"zeta-terminal menu\\\"\" \\"
        printf '%s\n' "  \"$(tq "Split Side by Side")\" d \"split-window -h -c \\\"#{pane_current_path}\\\"\" \\"
        printf '%s\n' "  \"$(tq "Split Top and Bottom")\" e \"split-window -v -c \\\"#{pane_current_path}\\\"\" \\"
        printf '%s\n' "  \"$(tq "Rename Tab")\" r \"command-prompt -I \\\"#W\\\" -p \\\"$(tq "Tab name:")\\\" \\\"rename-window -- \\\\\\\"%%\\\\\\\"\\\"\" \\"
        printf '%s\n' "  \"\" \\"
        printf '%s\n' "  \"$(tq "Close Pane")\" w \"kill-pane\""
        printf '%s\n' "set -g status-right \"#[fg=#8A8A8E]#{?client_prefix,$(tq "PREFIX") ,}#S \""
    } > "$T.new" && mv -f "$T.new" "$T"
}

# The installed shells, by name (each only once), from the known login shells.
shells() {
    local seen=" " s n r
    while read -r s; do
        case "$s" in ''|\#*) continue ;; esac
        n=$(basename "$s")
        # tmux and screen register as shells but are not; rbash is restricted bash
        case "$n" in rbash|tmux|screen) continue ;; esac
        [ -x "$s" ] || continue
        # the same program under two names (sh -> dash): a single entry
        r=$(readlink -f "$s")
        case "$seen" in *" $n "*|*" $r "*) continue ;; esac
        seen="$seen$n $r "
        echo "$n $s"
    done < /etc/shells
}

shell_path() {               # name -> executable path, empty if missing
    shells | awk -v n="$1" '$1 == n {print $2; exit}'
}

default_shell() {
    local n p
    n=$(cat "$PREF" 2>/dev/null)
    p=$([ -n "$n" ] && shell_path "$n")
    [ -n "$p" ] || p=$(shell_path bash)
    echo "${p:-/bin/sh}"
}

# A session whose only program in every pane is the shell (no command
# running) can be closed without losing anything.
only_prompt() {
    local cmd
    while read -r cmd; do
        case "$cmd" in bash|zsh|fish|sh|dash|ksh|mksh|tcsh|csh|-*) ;; *) return 1 ;; esac
    done < <(tmux list-panes -s -t "$1" -F '#{pane_current_command}' 2>/dev/null)
    return 0
}

case "${1:-}" in
    shells)
        shells ;;
    cleanup)
        # called by tmux when a terminal window detaches
        s="${2:-}"
        [ -n "$s" ] || exit 0
        [ "$(tmux display -p -t "$s" '#{session_attached}' 2>/dev/null)" = 0 ] || exit 0
        if only_prompt "$s"; then
            tmux kill-session -t "$s" 2>/dev/null
        else
            tmux display -t "$s" "$(gettext "Session on hold: resume it with “zeta shell sessions”")" 2>/dev/null
        fi ;;
    shell)
        p=$(shell_path "${2:-}")
        if [ -z "$p" ]; then
            tmux display "$(printf "$(gettext 'Shell not installed: %s')" "${2:-}")"; exit 1
        fi
        tmux new-window -n "${2}" "$p" ;;
    menu)
        # «New tab with…»: the installed shells, plus the missing ones with an
        # install entry (apt, password asked by pkexec).
        entries=()
        while read -r n p; do
            entries+=("$n" "" "new-window -n $n $p")
        done < <(shells)
        for n in zsh fish; do
            if [ -z "$(shell_path "$n")" ]; then
                entries+=("$(printf "$(gettext 'Install %s…')" "$n")" "" "new-window -n install 'pkexec apt-get install -y $n; echo; read -rp \"$(gettext "Press Enter to close")\" _'")
            fi
        done
        tmux display-menu -T "#[align=centre] $(gettext "New tab with") " -x C -y C "${entries[@]}" ;;
    '')
        # new terminal window = new tmux session
        # prompt and tmux colors: regenerated if missing or if the system
        # accent changed (just a date comparison: no slowdown)
        G="$HOME/.cache/zeta/starship.toml"
        if [ ! -f "$G" ] || [ "$HOME/.config/zeta/accent" -nt "$G" ] || [ "$HOME/.config/zeta/accent-rendered" -nt "$G" ]; then
            zeta-shell apply >/dev/null 2>&1
        fi
        # zsh without ~/.zshrc opens its setup wizard: use the ZETA RAYS one instead
        [ -e "$HOME/.zshrc" ] || cp /etc/skel/.zshrc "$HOME/.zshrc" 2>/dev/null
        SH=$(default_shell)
        if ! command -v tmux >/dev/null || [ ! -r "$CONF" ]; then
            exec "$SH" -l
        fi
        tmux_texts 2>/dev/null
        n=1
        while tmux has-session -t "=zeta-$n" 2>/dev/null; do n=$((n + 1)); done
        # new tabs (Ctrl+Shift+T) use the same default shell
        exec tmux -f "$CONF" new-session -s "zeta-$n" "$SH" \; set-option -g default-command "$SH"
        ;;
    *)
        gettext "Usage:
  zeta-terminal                 new session with the default shell (started by foot)
  zeta-terminal menu            “New tab with…” menu (bash, zsh, fish, …)
  zeta-terminal shell NAME      new tab with that shell
  zeta-terminal cleanup SESS    (tmux, when the window closes) clean up the session
  zeta-terminal shells          the installed shells"; echo; exit 1 ;;
esac

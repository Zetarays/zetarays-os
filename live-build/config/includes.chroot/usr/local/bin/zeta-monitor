                                     ("IP pubblico", tr("Public IP")), ("Gateway", "Gateway"), ("DNS", "DNS")])
        p.inner.append(grid)
        g.attach(p, 1, 0, 1, 1)
        box.append(g)
        p = panel(tr("Ping (latency)"), expand=True)

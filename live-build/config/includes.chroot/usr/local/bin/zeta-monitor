                                                ("disattivato" if not self.geo_enabled else "—"))
            self.net_kv["Gateway"].set_text(d["gd"]["gateway"])
            self.net_kv["DNS"].set_text(", ".join(d["gd"]["dns"]))
            self._update_ping_table()
        self.pages["network"] = (collect, apply)
        return scrolled(box)

    # --- VPN e proxy ---
    def _page_vpn(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        g = self._grid()
        p = panel("VPN")
        self.vpn_state = Gtk.Label(label="—", xalign=0, css_classes=["metric-sm"], wrap=True)
        p.inner.append(self.vpn_state)
        self.vpn_table = Table([("NOME", 220), ("TIPO", 90), ("STATO", 90)])
        self.vpn_table.set_size_request(-1, 140)
        p.inner.append(self.vpn_table)
        g.attach(p, 0, 0, 1, 1)
        p = panel("Uscita su Internet")
        grid, self.vpn_kv = kv_grid(["IP pubblico", "Paese", "Fornitore", "Tunnel attivi", "DNS"])
        p.inner.append(grid)
        g.attach(p, 1, 0, 1, 1)
        box.append(g)
        p = panel("Proxy")
        grid, self.px_kv = kv_grid(["Modalità", "Server", "File PAC", "Variabili d'ambiente"])
        p.inner.append(grid)
        cfg = Gtk.Button(label="Configura VPN e proxy…", css_classes=["rbtn"], halign=Gtk.Align.START)
        cfg.connect("clicked", lambda *_: subprocess.Popen(["zeta-impostazioni", "rete"]))
        p.inner.append(cfg)
        box.append(p)

        def collect():
            return {"vpns": network.vpns(), "tun": C.vpn_tunnels(), "px": network.proxy(),
                    "gd": self.col.gateway_dns(), "env": self._proxy_env()}

        def apply(d):
            act = [v for v in d["vpns"] if v["active"]]
            if act or d["tun"]:
                name = act[0]["name"] if act else d["tun"][0]["name"]
                self.vpn_state.set_text("● VPN attiva: %s" % name)
                self.vpn_state.set_css_classes(["metric-sm", "ok"])
            else:
                self.vpn_state.set_text("● Nessuna VPN attiva")
                self.vpn_state.set_css_classes(["metric-sm", "dim"])
            self.vpn_table.update([(v["uuid"], [v["name"], v["type"], "attiva" if v["active"] else "spenta"],
                                    [None, None, "ok" if v["active"] else "dim"]) for v in d["vpns"]]
                                  or [("x", ["Nessuna VPN configurata", "", ""], ["dim", None, None])])
            m = self.me or {}
            self.vpn_kv["IP pubblico"].set_text(m.get("ip") or ("disattivato" if not self.geo_enabled else "—"))
            self.vpn_kv["Paese"].set_text(country_it(m) or "—")
            self.vpn_kv["Fornitore"].set_text(m.get("isp") or "—")
            self.vpn_kv["Tunnel attivi"].set_text(", ".join("%s (%s)" % (t["name"], t["ip"]) for t in d["tun"]) or "nessuno")
            self.vpn_kv["DNS"].set_text(", ".join(d["gd"]["dns"]))
            px = d["px"]
            self.px_kv["Modalità"].set_text({"none": "Nessun proxy", "manual": "Manuale",
                                            "auto": "Automatico (PAC)"}.get(px["mode"], px["mode"]))
            self.px_kv["Server"].set_text("%s:%s" % (px["host"], px["port"]) if px["mode"] == "manual" and px["host"] else "—")
            self.px_kv["File PAC"].set_text(px["url"] if px["mode"] == "auto" and px["url"] else "—")
            self.px_kv["Variabili d'ambiente"].set_text(d["env"] or "nessuna")
        self.pages["vpn"] = (collect, apply)
        return scrolled(box)

    @staticmethod
    def _proxy_env():
        path = os.path.expanduser("~/.config/environment.d/zeta-proxy.conf")
        try:
            with open(path) as f:
                vals = [l.strip() for l in f if l.startswith("http_proxy")]
            return vals[0] if vals else ""
        except OSError:
            return ""

    # --- Firewall ---
    def _page_firewall(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        g = self._grid()
        p = panel("Stato del firewall")
        self.fw_state = Gtk.Label(label="—", xalign=0, css_classes=["metric-sm"], wrap=True)
        p.inner.append(self.fw_state)
        grid, self.fw_kv = kv_grid(["Motore", "In entrata", "In uscita", "Regole", "All'avvio"])
        p.inner.append(grid)
        self.fw_btn = Gtk.Button(label="…", css_classes=["rbtn"], halign=Gtk.Align.START)
        self.fw_btn.connect("clicked", lambda *_: self._toggle_fw())
        p.inner.append(self.fw_btn)
        g.attach(p, 0, 0, 1, 1)
        p = panel("Servizi in ascolto")
        self.fw_ports = Table([("PROTO", 60), ("PORTA", 60), ("INDIRIZZO", 130), ("PROCESSO", 110)])
        self.fw_ports.set_size_request(-1, 170)
        p.inner.append(self.fw_ports)
        self.fw_ports_note = Gtk.Label(label="", xalign=0, wrap=True, css_classes=["dim"])
        p.inner.append(self.fw_ports_note)
        g.attach(p, 1, 0, 1, 1)
        box.append(g)
        p = panel("Regole (sola lettura)", expand=True)
        self.fw_text = Gtk.TextView(editable=False, monospace=True, cursor_visible=False,
                                    wrap_mode=Gtk.WrapMode.WORD_CHAR)
        fw_scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.AUTOMATIC)
        fw_scroll.set_child(self.fw_text)
        p.inner.append(fw_scroll)
        box.append(p)

        def collect():
            return {"fw": C.firewall_info(), "socks": C.sockets_all()}

        def apply(d):
            fw = d["fw"]
            if fw["active"]:
                self.fw_state.set_text("● Attivo — le connessioni in entrata non richieste sono bloccate")
                self.fw_state.set_css_classes(["metric-sm", "ok"])
                self.fw_btn.set_label("Disattiva il firewall")
            else:
                self.fw_state.set_text("● Spento — il computer accetta connessioni in entrata")
                self.fw_state.set_css_classes(["metric-sm", "alert"])
                self.fw_btn.set_label("Attiva il firewall")
            self.fw_btn.set_sensitive(not self.fw_busy)
            pol = {"drop": "bloccato (tranne risposte)", "accept": "consentito", NA: "—", "": "—"}
            self.fw_kv["Motore"].set_text("nftables" if fw["known"] or fw["active"] else "—")
            self.fw_kv["In entrata"].set_text(pol.get(fw["policy_in"], fw["policy_in"]) if fw["active"] else "consentito")
            self.fw_kv["In uscita"].set_text(pol.get(fw["policy_out"], fw["policy_out"]) if fw["active"] else "consentito")
            self.fw_kv["Regole"].set_text(str(fw["rules"]) if fw["known"] else "permesso richiesto")
            self.fw_kv["All'avvio"].set_text("sì" if fw["enabled"] else "no")
            self.fw_text.get_buffer().set_text(fw["text"] or "Regole non leggibili senza permessi di amministratore.")
            socks = d["socks"]
            if socks is None:
                self.fw_ports.update([("x", ["", "", "permesso richiesto", ""], [None, None, "warn", None])])
            else:
                rows = [s for s in socks if s["state"] in ("LISTEN", "UNCONN")]
                self.fw_ports.update([(i, [s["proto"], s["lport"], s["lhost"], s["process"]],
                                       [None, None, "dim" if s["lhost"] in ("127.0.0.1", "::1", "127.0.0.53", "127.0.0.54")
                                        else ("ok" if fw["active"] else "warn"), None])
                                      for i, s in enumerate(rows[:60])] or [("x", ["", "", "nessuno", ""])])
                self.fw_ports_note.set_text("Verde: raggiungibile solo se consentito dal firewall. "
                                            "Grigio: solo da questo computer.")
        self.pages["firewall"] = (collect, apply)
        return scrolled(box)

    def _toggle_fw(self):
        active = getattr(self, "status", {}).get("fw", {}).get("active", False)
        self.fw_busy = True
        self.fw_btn.set_sensitive(False)

        def work():
            r = subprocess.run(["pkexec", "/usr/libexec/zeta-monitor-helper",
                                "firewall-off" if active else "firewall-on"])
            st = self._collect_status()
            GLib.idle_add(self._apply_status, st)
            self.fw_busy = False
            GLib.idle_add(self.toast, ("Firewall %s" % ("disattivato" if active else "attivato"))
                          if r.returncode == 0 else "Operazione annullata")
        threading.Thread(target=work, daemon=True).start()

    # --- Connessioni ---
    def _page_connections(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        top = Gtk.Box(spacing=8)
        self.conn_search = Gtk.SearchEntry(placeholder_text="filtra per indirizzo, porta o programma", hexpand=True)
        top.append(self.conn_search)
        self.conn_all = Gtk.CheckButton(label="Mostra anche quelle in ascolto")
        top.append(self.conn_all)
        box.append(top)
        p = panel("Connessioni", expand=True)
        self.conn_table = Table([("PROTO", 56), ("STATO", 110), ("LOCALE", 170), ("REMOTO", 200),
                                 ("PAESE", 110), ("PROGRAMMA", 120)])
        p.inner.append(self.conn_table)
        box.append(p)

        def collect():
            return C.sockets_all()

        def apply(rows):
            if rows is None:
                self.conn_table.update([("x", ["", "", "permesso richiesto", "", "", ""], [None, None, "warn"] + [None] * 3)])
                return
            if not self.conn_all.get_active():
                rows = [r for r in rows if r["state"] not in ("LISTEN", "UNCONN")]
            q = self.conn_search.get_text().strip().lower()
            if q:
                rows = [r for r in rows if q in ("%s %s %s %s %s" % (r["lhost"], r["lport"], r["rhost"], r["rport"],
                                                                     r["process"])).lower()]
            out = []
            for i, r in enumerate(rows[:200]):
                g = geo.cached(r["rhost"]) if self.geo_enabled else None
                country = country_it(g) if g else ("locale" if not geo.is_public(r["rhost"]) else "—")
                out.append((i, [r["proto"], C.STATE_IT.get(r["state"], r["state"]),
                                "%s:%s" % (r["lhost"], r["lport"]), "%s:%s" % (r["rhost"], r["rport"]),
                                country, r["process"]],
                            [None, "ok" if r["state"] == "ESTAB" else "dim", None, None, None, None]))
            self.conn_table.update(out or [("x", ["", "", "nessuna connessione", "", "", ""])])
        self.pages["connections"] = (collect, apply)
        return box

    # --- Utenti ---
    def _page_users(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        p = panel("Account")
        self.us_acc = Table([("UTENTE", 100), ("NOME", 130), ("RUOLO", 120), ("SHELL", 70), ("ULTIMO ACCESSO", 200)])
        self.us_acc.set_size_request(-1, 150)
        p.inner.append(self.us_acc)
        box.append(p)
        g = self._grid()
        p = panel("Sessioni attive")
        self.us_sess = Table([("UTENTE", 90), ("TIPO", 110), ("DOVE", 90), ("STATO", 100)])
        self.us_sess.set_size_request(-1, 170)
        p.inner.append(self.us_sess)
        g.attach(p, 0, 0, 1, 1)
        p = panel("Ultimi accessi")
        self.us_hist = Table([("UTENTE", 80), ("TERMINALE", 90), ("QUANDO", 220)])
        self.us_hist.set_size_request(-1, 170)
        p.inner.append(self.us_hist)
        g.attach(p, 1, 0, 1, 1)
        box.append(g)

        def collect():
            return {"acc": C.accounts(), "sess": C.logind_sessions(), "hist": C.login_history()}

        def apply(d):
            self.us_acc.update([(a["user"], [a["user"], a["name"] or "—", a["role"], a["shell"], a["last"]],
                                 [None, None, "accent" if a["role"] == "Amministratore" else None, "dim", "dim"])
                                for a in d["acc"]])
            self.us_sess.update([(s["id"], [s["user"], s["kind"], s["where"], s["state"]],
                                  [None, "warn" if "SSH" in s["kind"] else None, None, "ok" if s["state"] == "attiva" else "dim"])
                                 for s in d["sess"]] or [("x", ["—", "", "", ""])])
            self.us_hist.update([(i, [h["user"], h["tty"], h["text"]]) for i, h in enumerate(d["hist"][:40])]
                                or [("x", ["—", "", "nessun dato"])])
        self.pages["users"] = (collect, apply)
        return scrolled(box)

    # --- Sicurezza ---
    def _page_security(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        p = panel("Eventi di accesso e sicurezza (ultime 24 ore)", expand=True)
        self.sec_table = Table([("QUANDO", 100), ("EVENTO", 260), ("DETTAGLIO", 200)])
        p.inner.append(self.sec_table)
        box.append(p)
        p = panel("Servizi in errore")
        self.sec_failed = Gtk.Label(label="—", xalign=0, css_classes=["mono"])
        p.inner.append(self.sec_failed)
        box.append(p)

        def collect():
            raw = C.helper("auth")
            return {"auth": parse_auth(raw), "ok": bool(raw.strip())}

        def apply(d):
            ev = d["auth"]
            self._auth, self._auth_t = ev, time.time()
            if not d["ok"]:
                self.sec_table.update([("x", ["", "Registro non leggibile", "servono i permessi di amministratore"],
                                        [None, "warn", "dim"])])
            else:
                self.sec_table.update([(i, [e[0], e[1], e[2]], [None, e[3], None]) for i, e in enumerate(ev[:150])]
                                      or [("x", ["", "Nessun evento", ""], [None, "dim", None])])
            st = getattr(self, "status", None)
            if st:
                self.sec_failed.set_text(", ".join(st["failed"]) if st["failed"] else "Nessuno")
                self.sec_failed.set_css_classes(["mono", "warn" if st["failed"] else "ok"])
        self.pages["security"] = (collect, apply)
        return box

    # --- Processi ---
    def _page_processes(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        tools = Gtk.Box(spacing=8, margin_bottom=4)
        self.proc_search = Gtk.SearchEntry(placeholder_text="filtra processi", hexpand=True)
        tools.append(self.proc_search)
        tools.append(Gtk.Label(label="Ordina:", css_classes=["dim"]))
        self.proc_sort = "CPU"
        for lab in ("CPU", "RAM", "PID", "NOME"):
            b = Gtk.Button(label=lab, css_classes=["rbtn"])
            b.connect("clicked", lambda _b, s=lab: setattr(self, "proc_sort", s))
            tools.append(b)
        box.append(tools)
        split = Gtk.Box(spacing=12, vexpand=True)
        p = panel("Processi", expand=True)
        self.proc_table = Table([("PID", 56), ("NOME", 136), ("UTENTE", 72), ("CPU%", 48), ("RAM%", 48),
                                 ("RAM", 72), ("STATO", 104), ("AVVIO", 72)], on_select=self._on_proc_select)
        p.inner.append(self.proc_table)
        split.append(p)
        det = panel("Dettagli", expand=True)
        det.set_hexpand(False)
        det.set_size_request(260, -1)
        self.proc_detail = Gtk.Label(label="Seleziona un processo", xalign=0, yalign=0,
                                     css_classes=["mono", "dim"], wrap=True, vexpand=True)
        det.inner.append(self.proc_detail)
        btns = Gtk.Box(spacing=8)
        tb = Gtk.Button(label="Termina", css_classes=["rbtn"])
        tb.connect("clicked", lambda *_: self._kill(False))
        fb = Gtk.Button(label="Forza chiusura", css_classes=["rbtn"])
        fb.connect("clicked", lambda *_: self._kill(True))
        btns.append(tb)
        btns.append(fb)
        det.inner.append(btns)
        # il programma intero (con i sottoprocessi), riavvio, cartella
        btns2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for testo, fn in (("Chiudi con i sottoprocessi", lambda *_: self._azione("albero")),
                          ("Riavvia", lambda *_: self._azione("riavvia")),
                          ("Apri la cartella", lambda *_: self._apri_cartella())):
            b = Gtk.Button(label=testo, css_classes=["rbtn"])
            b.connect("clicked", fn)
            btns2.append(b)
        det.inner.append(btns2)
        split.append(det)
        box.append(split)
        self.sel_pid = None
        states = {"running": "in esecuzione", "sleeping": "in attesa", "idle": "inattivo", "zombie": "zombie",
                  "stopped": "fermo", "disk-sleep": "attesa disco"}

        def collect():
            return self.col.processes(limit=300)

        def apply(rows):
            q = self.proc_search.get_text().strip().lower()
            if q:
                rows = [r for r in rows if q in r["name"].lower() or q == str(r["pid"])]
            key = {"CPU": "cpu", "RAM": "mem_pct", "PID": "pid", "NOME": "name"}[self.proc_sort]
            rows = sorted(rows, key=lambda r: r[key], reverse=(self.proc_sort in ("CPU", "RAM")))
            self.proc_table.update([(r["pid"], [r["pid"], r["name"], r["user"], "%.1f" % r["cpu"],
                                                "%.1f" % r["mem_pct"], _fmt_bytes(r["rss"]),
                                                states.get(r["status"], r["status"]), r["start"]])
                                    for r in rows[:100]])
        self.pages["processes"] = (collect, apply)
        return box

    def _on_proc_select(self, pid):
        self.sel_pid = pid
        d = self.col.process_detail(pid) if pid else None
        if not d:
            self.proc_detail.set_text("—")
            return
        ch = ", ".join("%s (%s)" % (n, p) for p, n in d["children"][:6]) or "nessuno"
        if d.get("albero", 0) > len(d["children"]):
            ch += " · %d sottoprocessi in tutto" % d["albero"]
        io = ("letti %s, scritti %s" % (_fmt_bytes(d["io"][0]), _fmt_bytes(d["io"][1]))
              if d.get("io") else "permesso richiesto")
        self.proc_detail.set_text(
            "PID: %s\nNome: %s\nUtente: %s\nStato: %s\nPadre: %s\n\nEseguibile:\n%s\n\nComando:\n%s\n\n"
            "File aperti: %s\nConnessioni di rete: %s\nDisco: %s\nFigli: %s"
            % (d["pid"], d["name"], d["user"], d["status"], d["ppid"], d["exe"], d["cmdline"],
               str(d["open_files"]).replace("PERMESSO RICHIESTO", "permesso richiesto"),
               str(d["connections"]).replace("PERMESSO RICHIESTO", "permesso richiesto"), io, ch))

    def _kill(self, force):
        if not self.sel_pid:
            return
        d = self.col.process_detail(self.sel_pid)
        name = d["name"] if d else str(self.sel_pid)
        pid = self.sel_pid
        dlg = Adw.AlertDialog(heading="Chiudere %s?" % name,
                              body="%s il processo %s (PID %s). I dati non salvati andranno persi."
                              % ("Forzare la chiusura del" if force else "Terminare", name, pid))
        dlg.add_response("no", "Annulla")
        dlg.add_response("yes", "Forza chiusura" if force else "Termina")
        dlg.set_response_appearance("yes", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.connect("response", lambda _d, r: self._chiudi(pid, force) if r == "yes" else None)
        dlg.present(self)

    def _azione(self, quale):
        if not self.sel_pid:
            return
        pid = self.sel_pid
        d = self.col.process_detail(pid)
        nome = d["name"] if d else str(pid)
        testo = {"albero": ("Chiudere %s e i suoi sottoprocessi?" % nome, "Chiudi tutto",
                            "Prima gli si chiede di chiudersi; chi non risponde entro 3 secondi "
                            "viene chiuso d'autorità. I dati non salvati andranno persi."),
                 "riavvia": ("Riavviare %s?" % nome, "Riavvia",
                             "Viene chiuso (con i sottoprocessi) e riaperto con lo stesso comando. "
                             "I dati non salvati andranno persi.")}[quale]
        dlg = Adw.AlertDialog(heading=testo[0], body=testo[2])
        dlg.add_response("no", "Annulla")
        dlg.add_response("yes", testo[1])
        dlg.set_response_appearance("yes", Adw.ResponseAppearance.DESTRUCTIVE)

        def lavoro():
            ok, msg = (self.col.chiudi_albero(pid) if quale == "albero" else self.col.riavvia(pid))
            GLib.idle_add(self.toast, msg)
        dlg.connect("response", lambda _d, r: threading.Thread(target=lavoro, daemon=True).start()
                    if r == "yes" else None)
        dlg.present(self)

    def _apri_cartella(self):
        if not self.sel_pid:
            return
        d = self.col.process_detail(self.sel_pid)
        exe = d.get("exe") if d else None
        if not exe or not os.path.isabs(str(exe)):
            self.toast("Eseguibile non leggibile (processo di sistema o di un altro utente)")
            return
        subprocess.Popen(["thunar", os.path.dirname(exe)],
                         start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _chiudi(self, pid, force):
        # la verifica aspetta fino a 3 secondi: fuori dal thread della
        # finestra, che altrimenti resterebbe bloccata nel frattempo
        def lavoro():
            _ok, messaggio = self.col.terminate(pid, force)
            GLib.idle_add(self.toast, messaggio)
        threading.Thread(target=lavoro, daemon=True).start()

    # --- Servizi ---
    def _page_services(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.svc_search = Gtk.SearchEntry(placeholder_text="filtra servizi")
        box.append(self.svc_search)
        split = Gtk.Box(spacing=12, vexpand=True)
        p = panel("Servizi", expand=True)
        self.svc_table = Table([("SERVIZIO", 240), ("STATO", 90), ("DETTAGLIO", 110)], on_select=self._on_svc_select)
        p.inner.append(self.svc_table)
        split.append(p)
        act = panel("Azioni", expand=True)
        act.set_hexpand(False)
        act.set_size_request(240, -1)
        self.svc_sel = Gtk.Label(label="Seleziona un servizio", xalign=0, yalign=0, css_classes=["mono", "dim"],
                                 vexpand=True, wrap=True)
        act.inner.append(self.svc_sel)
        for lab, a in (("Avvia", "start"), ("Ferma", "stop"), ("Riavvia", "restart")):
            b = Gtk.Button(label=lab, css_classes=["rbtn"])
            b.connect("clicked", lambda _b, a=a: self._svc_action(a))
            act.inner.append(b)
        split.append(act)
        box.append(split)
        self.sel_svc = None
        st_it = {"RUNNING": "attivo", "FAILED": "errore", "STOPPED": "fermo"}
        sub_it = {"running": "in esecuzione", "exited": "completato", "dead": "non avviato", "failed": "fallito",
                  "waiting": "in attesa", "auto-restart": "riavvio", "start": "avvio"}

        def collect():
            return self.col.services(limit=250)

        def apply(rows):
            q = self.svc_search.get_text().strip().lower()
            if q:
                rows = [r for r in rows if q in r["name"].lower()]
            self.svc_table.update([(r["name"], [r["name"], st_it.get(r["state"], r["state"]),
                                                sub_it.get(r["sub"], r["sub"])],
                                    [None, {"RUNNING": "ok", "FAILED": "alert"}.get(r["state"], "dim"), None])
                                   for r in rows[:150]])
        self.pages["services"] = (collect, apply)
        return box

    def _on_svc_select(self, name):
        self.sel_svc = name
        self.svc_sel.set_text("Servizio:\n%s" % name if name else "—")

    def _svc_action(self, action):
        if not self.sel_svc:
            return
        name = self.sel_svc
        verb = {"start": "Avviare", "stop": "Fermare", "restart": "Riavviare"}[action]
        dlg = Adw.AlertDialog(heading="%s il servizio %s?" % (verb, name))
        dlg.add_response("no", "Annulla")
        dlg.add_response("yes", verb)
        dlg.set_response_appearance("yes", Adw.ResponseAppearance.SUGGESTED)

        def do(_d, r):
            if r == "yes":
                def work():
                    ok, _err = self.col.service_action(name, action)
                    GLib.idle_add(self.toast, "Fatto" if ok else "Operazione non riuscita o annullata")
                threading.Thread(target=work, daemon=True).start()
        dlg.connect("response", do)
        dlg.present(self)

    # --- Sistema ---
    def _page_system(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        top = self._grid()
        p = panel("Sistema")
        grid, self.sys_kv = kv_grid(["Computer", "Sistema", "Kernel", "Architettura", "Attivo da",
                                     "Carico", "Temperatura CPU"])
        p.inner.append(grid)
        top.attach(p, 0, 0, 1, 1)
        p = panel("CPU per core")
        self.core_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        p.inner.append(self.core_box)
        self.core_bars = []
        top.attach(p, 1, 0, 1, 1)
        box.append(top)
        bottom = self._grid()
        p = panel("Memoria")
        self.mem_info = Gtk.Label(label="—", xalign=0, css_classes=["mono"], wrap=True)
        self.mem_bar = Bar(ACC)
        p.inner.append(self.mem_info)
        p.inner.append(self.mem_bar)
        bottom.attach(p, 0, 0, 1, 1)
        p = panel("Dischi")
        self.store_table = Table([("DISPOSITIVO", 140), ("MONTATO SU", 120), ("USO", 60), ("LIBERO", 90)])
        self.store_table.set_size_request(-1, 120)
        p.inner.append(self.store_table)
        bottom.attach(p, 1, 0, 1, 1)
        box.append(bottom)

        def collect():
            return {"s": self.col.system(), "cpu": self.col.cpu(), "m": self.col.memory(), "st": self.col.storage()}

        def apply(d):
            s = d["s"]
            for k, v in (("Computer", s["host"]), ("Sistema", s["os"]), ("Kernel", s["kernel"]),
                         ("Architettura", s["arch"]), ("Attivo da", s["uptime"]), ("Carico", s["load"]),
                         ("Temperatura CPU", s["cpu_temp"])):
                self.sys_kv[k].set_text(str(v).replace(NA, "—"))
            cores = d["cpu"]["per_core"]
            if len(self.core_bars) != len(cores):
                child = self.core_box.get_first_child()
                while child:
                    self.core_box.remove(child)
                    child = self.core_box.get_first_child()
                self.core_bars = []
                for i in range(len(cores)):
                    r = Gtk.Box(spacing=8)
                    r.append(Gtk.Label(label="%d" % (i + 1), css_classes=["mono", "dim"], width_chars=3))
                    bar = Bar(ACC)
                    self.core_bars.append(bar)
                    r.append(bar)
                    self.core_box.append(r)
            for bar, v in zip(self.core_bars, cores):
                bar.set_value(v)
            m = d["m"]
            self.mem_info.set_text("Totale: %s   Usata: %s   Disponibile: %s\nSwap: %s / %s"
                                   % (_fmt_bytes(m.get("total", 0)), _fmt_bytes(m.get("used", 0)),
                                      _fmt_bytes(m.get("available", 0)), _fmt_bytes(m.get("swap_used", 0)),
                                      _fmt_bytes(m.get("swap_total", 0))))
            self.mem_bar.set_value(m.get("percent", 0))
            self.store_table.update([(pp["mount"], [pp["device"], pp["mount"], "%.0f%%" % pp["percent"],
                                                    _fmt_bytes(pp["free"])]) for pp in d["st"]["parts"]])
        self.pages["system"] = (collect, apply)
        return scrolled(box)

    # ---------------- ping ----------------
    def _start_ping(self, host):
        with self.ping_lock:
            if host in self.ping_targets:
                return
            self.ping_targets[host] = {"cur": None, "min": None, "max": None, "avg": None,
                                       "loss": 0.0, "sent": 0, "lost": 0, "hist": []}
        threading.Thread(target=self._ping_worker, args=(host,), daemon=True).start()

    def _add_ping(self):
        host = self.ping_entry.get_text().strip()
        if host:
            self._start_ping(host)
            self.ping_entry.set_text("")

    def _ping_worker(self, host):
        while True:
            r = ping(host)
            with self.ping_lock:
                t = self.ping_targets.get(host)
                if t is None:
                    return
                t["sent"] += 1
                if r is None:
                    t["lost"] += 1
                    t["cur"] = None
                else:
                    t["cur"] = r
                    t["hist"] = (t["hist"] + [r])[-60:]
                    t["min"], t["max"] = min(t["hist"]), max(t["hist"])
                    t["avg"] = sum(t["hist"]) / len(t["hist"])
                t["loss"] = 100.0 * t["lost"] / max(1, t["sent"])
            time.sleep(2)

    def _update_ping_table(self):
        with self.ping_lock:
            items = list(self.ping_targets.items())
        rows = []
        for host, t in items:
            online = t["cur"] is not None
            f = lambda v: "%.0f" % v if v is not None else "—"  # noqa: E731
            rows.append((host, [host, ("%.0f ms" % t["cur"]) if online else "—", f(t["min"]), f(t["max"]),
                                f(t["avg"]), "%.0f%%" % t["loss"], "raggiungibile" if online else "nessuna risposta"],
                         [None] * 6 + ["ok" if online else "alert"]))
        self.ping_table.update(rows)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Monitor", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        tema.apply(CSS)
        win = self.props.active_window or Monitor(self)
        # la sezione per chiave («processes») o per nome («Processi»)
        if len(sys.argv) > 1:
            voluta = sys.argv[1].strip().lower()
            for chiave, nome in SECTIONS:
                if voluta in (chiave, nome.lower()):
                    win._go(chiave)
                    break
        win.present()


if __name__ == "__main__":
    sys.exit(App().run([sys.argv[0]]))

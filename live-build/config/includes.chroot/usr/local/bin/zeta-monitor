            st = d["st"]
            kind = {"wifi": "Wi-Fi", "ethernet": "Ethernet"}.get(st["kind"], "—")
            self.net_kv["Connessione"].set_text("%s · %s" % (kind, st.get("label") or st["name"]) if st["connected"]
                                                else tr("Not connected"))
            self.net_kv["IP locale"].set_text(st["ip"] or "—")
            self.net_kv["IP pubblico"].set_text((self.me or {}).get("ip") or
                                                (tr("disabled") if not self.geo_enabled else "—"))
            self.net_kv["Gateway"].set_text(d["gd"]["gateway"])
            self.net_kv["DNS"].set_text(", ".join(d["gd"]["dns"]))
            self._update_ping_table()
        self.pages["network"] = (collect, apply)
        return scrolled(box)

    # --- VPN e proxy ---
    def _page_vpn(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        g = self._grid()
        p = panel("VPN")
        self.vpn_state = Gtk.Label(label="—", xalign=0, css_classes=["metric-sm"], wrap=True)
        p.inner.append(self.vpn_state)
        self.vpn_table = Table([(tr("NAME"), 220), (tr("TYPE"), 90), (tr("STATUS"), 90)])
        self.vpn_table.set_size_request(-1, 140)
        p.inner.append(self.vpn_table)
        g.attach(p, 0, 0, 1, 1)
        p = panel(tr("Exit to the Internet"))
        grid, self.vpn_kv = kv_grid([("IP pubblico", tr("Public IP")), ("Paese", tr("Country")),
                                     ("Fornitore", tr("Provider")), ("Tunnel attivi", tr("Active tunnels")),
                                     ("DNS", "DNS")])
        p.inner.append(grid)
        g.attach(p, 1, 0, 1, 1)
        box.append(g)
        p = panel("Proxy")
        grid, self.px_kv = kv_grid([("Modalità", tr("Mode")), ("Server", "Server"), ("File PAC", tr("PAC file")),
                                    ("Variabili d'ambiente", tr("Environment variables"))])
        p.inner.append(grid)
        cfg = Gtk.Button(label=tr("Configure VPN and proxy…"), css_classes=["rbtn"], halign=Gtk.Align.START)
        cfg.connect("clicked", lambda *_: subprocess.Popen(["zeta-impostazioni", "rete"]))
        p.inner.append(cfg)
        box.append(p)

        def collect():
            return {"vpns": network.vpns(), "tun": C.vpn_tunnels(), "px": network.proxy(),
                    "gd": self.col.gateway_dns(), "env": self._proxy_env()}

        def apply(d):
            act = [v for v in d["vpns"] if v["active"]]
            if act or d["tun"]:
                name = act[0]["name"] if act else d["tun"][0]["name"]
                self.vpn_state.set_text(tr("● VPN active: {name}").format(name=name))
                self.vpn_state.set_css_classes(["metric-sm", "ok"])
            else:
                self.vpn_state.set_text(tr("● No active VPN"))
                self.vpn_state.set_css_classes(["metric-sm", "dim"])
            self.vpn_table.update([(v["uuid"], [v["name"], v["type"], tr("connected") if v["active"] else tr("disconnected")],
                                    [None, None, "ok" if v["active"] else "dim"]) for v in d["vpns"]]
                                  or [("x", [tr("No VPN configured"), "", ""], ["dim", None, None])])
            m = self.me or {}
            self.vpn_kv["IP pubblico"].set_text(m.get("ip") or (tr("disabled") if not self.geo_enabled else "—"))
            self.vpn_kv["Paese"].set_text(country_it(m) or "—")
            self.vpn_kv["Fornitore"].set_text(m.get("isp") or "—")
            self.vpn_kv["Tunnel attivi"].set_text(", ".join("%s (%s)" % (t["name"], t["ip"]) for t in d["tun"]) or tr("none"))
            self.vpn_kv["DNS"].set_text(", ".join(d["gd"]["dns"]))
            px = d["px"]
            self.px_kv["Modalità"].set_text({"none": tr("No proxy"), "manual": tr("Manual"),
                                            "auto": tr("Automatic (PAC)")}.get(px["mode"], px["mode"]))
            self.px_kv["Server"].set_text("%s:%s" % (px["host"], px["port"]) if px["mode"] == "manual" and px["host"] else "—")
            self.px_kv["File PAC"].set_text(px["url"] if px["mode"] == "auto" and px["url"] else "—")
            self.px_kv["Variabili d'ambiente"].set_text(d["env"] or tr("no variables"))
        self.pages["vpn"] = (collect, apply)
        return scrolled(box)

    @staticmethod
    def _proxy_env():
        path = os.path.expanduser("~/.config/environment.d/zeta-proxy.conf")
        try:
            with open(path) as f:
                vals = [l.strip() for l in f if l.startswith("http_proxy")]
            return vals[0] if vals else ""
        except OSError:
            return ""

    # --- Firewall ---
    def _page_firewall(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        g = self._grid()
        p = panel(tr("Firewall status"))
        self.fw_state = Gtk.Label(label="—", xalign=0, css_classes=["metric-sm"], wrap=True)
        p.inner.append(self.fw_state)
        grid, self.fw_kv = kv_grid([("Motore", tr("Engine")), ("In entrata", tr("Incoming")),
                                    ("In uscita", tr("Outgoing")), ("Regole", tr("Rules")),
                                    ("All'avvio", tr("At startup"))])
        p.inner.append(grid)
        self.fw_btn = Gtk.Button(label="…", css_classes=["rbtn"], halign=Gtk.Align.START)
        self.fw_btn.connect("clicked", lambda *_: self._toggle_fw())
        p.inner.append(self.fw_btn)
        g.attach(p, 0, 0, 1, 1)
        p = panel(tr("Listening services"))
        self.fw_ports = Table([("PROTO", 60), (tr("PORT"), 60), (tr("ADDRESS"), 130), (tr("PROCESS"), 110)])
        self.fw_ports.set_size_request(-1, 170)
        p.inner.append(self.fw_ports)
        self.fw_ports_note = Gtk.Label(label="", xalign=0, wrap=True, css_classes=["dim"])
        p.inner.append(self.fw_ports_note)
        g.attach(p, 1, 0, 1, 1)
        box.append(g)
        p = panel(tr("Rules (read-only)"), expand=True)
        self.fw_text = Gtk.TextView(editable=False, monospace=True, cursor_visible=False,
                                    wrap_mode=Gtk.WrapMode.WORD_CHAR)
        fw_scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.AUTOMATIC)
        fw_scroll.set_child(self.fw_text)
        p.inner.append(fw_scroll)
        box.append(p)

        def collect():
            return {"fw": C.firewall_info(), "socks": C.sockets_all()}

        def apply(d):
            fw = d["fw"]
            if fw["active"]:
                self.fw_state.set_text(tr("● On — unsolicited incoming connections are blocked"))
                self.fw_state.set_css_classes(["metric-sm", "ok"])
                self.fw_btn.set_label(tr("Turn Off Firewall"))
            else:
                self.fw_state.set_text(tr("● Off — this computer accepts incoming connections"))
                self.fw_state.set_css_classes(["metric-sm", "alert"])
                self.fw_btn.set_label(tr("Turn On Firewall"))
            self.fw_btn.set_sensitive(not self.fw_busy)
            pol = {"drop": tr("blocked (except replies)"), "accept": tr("allowed"), NA: "—", "": "—"}
            self.fw_kv["Motore"].set_text("nftables" if fw["known"] or fw["active"] else "—")
            self.fw_kv["In entrata"].set_text(pol.get(fw["policy_in"], fw["policy_in"]) if fw["active"] else tr("allowed"))
            self.fw_kv["In uscita"].set_text(pol.get(fw["policy_out"], fw["policy_out"]) if fw["active"] else tr("allowed"))
            self.fw_kv["Regole"].set_text(str(fw["rules"]) if fw["known"] else tr("permission required"))
            self.fw_kv["All'avvio"].set_text(tr("yes") if fw["enabled"] else tr("no"))
            self.fw_text.get_buffer().set_text(fw["text"] or tr("Rules can't be read without administrator permissions."))
            socks = d["socks"]
            if socks is None:
                self.fw_ports.update([("x", ["", "", tr("permission required"), ""], [None, None, "warn", None])])
            else:
                rows = [s for s in socks if s["state"] in ("LISTEN", "UNCONN")]
                self.fw_ports.update([(i, [s["proto"], s["lport"], s["lhost"], s["process"]],
                                       [None, None, "dim" if s["lhost"] in ("127.0.0.1", "::1", "127.0.0.53", "127.0.0.54")
                                        else ("ok" if fw["active"] else "warn"), None])
                                      for i, s in enumerate(rows[:60])] or [("x", ["", "", tr("none"), ""])])
                self.fw_ports_note.set_text(tr("Green: reachable only if the firewall allows it. "
                                               "Gray: only from this computer."))
        self.pages["firewall"] = (collect, apply)
        return scrolled(box)

    def _toggle_fw(self):
        active = getattr(self, "status", {}).get("fw", {}).get("active", False)
        self.fw_busy = True
        self.fw_btn.set_sensitive(False)

        def work():
            r = subprocess.run(["pkexec", "/usr/libexec/zeta-monitor-helper",
                                "firewall-off" if active else "firewall-on"])
            st = self._collect_status()
            GLib.idle_add(self._apply_status, st)
            self.fw_busy = False
            GLib.idle_add(self.toast, (tr("Firewall turned off") if active else tr("Firewall turned on"))
                          if r.returncode == 0 else tr("Operation canceled"))
        threading.Thread(target=work, daemon=True).start()

    # --- Connessioni ---
    def _page_connections(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        top = Gtk.Box(spacing=8)
        self.conn_search = Gtk.SearchEntry(placeholder_text=tr("filter by address, port or program"), hexpand=True)
        top.append(self.conn_search)
        self.conn_all = Gtk.CheckButton(label=tr("Also show listening ones"))
        top.append(self.conn_all)
        box.append(top)
        p = panel(tr("Connections"), expand=True)
        self.conn_table = Table([("PROTO", 56), (tr("STATE"), 110), (tr("LOCAL"), 170), (tr("REMOTE"), 200),
                                 (tr("COUNTRY"), 110), (tr("PROGRAM"), 120)])
        p.inner.append(self.conn_table)
        box.append(p)

        def collect():
            return C.sockets_all()

        def apply(rows):
            if rows is None:
                self.conn_table.update([("x", ["", "", tr("permission required"), "", "", ""],
                                         [None, None, "warn"] + [None] * 3)])
                return
            if not self.conn_all.get_active():
                rows = [r for r in rows if r["state"] not in ("LISTEN", "UNCONN")]
            q = self.conn_search.get_text().strip().lower()
            if q:
                rows = [r for r in rows if q in ("%s %s %s %s %s" % (r["lhost"], r["lport"], r["rhost"], r["rport"],
                                                                     r["process"])).lower()]
            out = []
            for i, r in enumerate(rows[:200]):
                g = geo.cached(r["rhost"]) if self.geo_enabled else None
                country = country_it(g) if g else (tr("local") if not geo.is_public(r["rhost"]) else "—")
                out.append((i, [r["proto"], C.STATE_IT.get(r["state"], r["state"]),
                                "%s:%s" % (r["lhost"], r["lport"]), "%s:%s" % (r["rhost"], r["rport"]),
                                country, r["process"]],
                            [None, "ok" if r["state"] == "ESTAB" else "dim", None, None, None, None]))
            self.conn_table.update(out or [("x", ["", "", tr("no connections"), "", "", ""])])
        self.pages["connections"] = (collect, apply)
        return box

    # --- Utenti ---
    def _page_users(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        p = panel(tr("Accounts"))
        self.us_acc = Table([(tr("USER"), 100), (tr("NAME"), 130), (tr("ROLE"), 120), ("SHELL", 70),
                             (tr("LAST LOGIN"), 200)])
        self.us_acc.set_size_request(-1, 150)
        p.inner.append(self.us_acc)
        box.append(p)
        g = self._grid()
        p = panel(tr("Active sessions"))
        self.us_sess = Table([(tr("USER"), 90), (tr("TYPE"), 110), (tr("WHERE"), 90), (tr("STATE"), 100)])
        self.us_sess.set_size_request(-1, 170)
        p.inner.append(self.us_sess)
        g.attach(p, 0, 0, 1, 1)
        p = panel(tr("Recent logins"))
        self.us_hist = Table([(tr("USER"), 80), (tr("TERMINAL"), 90), (tr("WHEN"), 220)])
        self.us_hist.set_size_request(-1, 170)
        p.inner.append(self.us_hist)
        g.attach(p, 1, 0, 1, 1)
        box.append(g)

        def collect():
            return {"acc": C.accounts(), "sess": C.logind_sessions(), "hist": C.login_history()}

        def apply(d):
            self.us_acc.update([(a["user"], [a["user"], a["name"] or "—", a["role"], a["shell"], a["last"]],
                                 [None, None, "accent" if a.get("admin") else None, "dim", "dim"])
                                for a in d["acc"]])
            self.us_sess.update([(s["id"], [s["user"], s["kind"], s["where"], s["state"]],
                                  [None, "warn" if s.get("remote") else None, None, "ok" if s.get("active") else "dim"])
                                 for s in d["sess"]] or [("x", ["—", "", "", ""])])
            self.us_hist.update([(i, [h["user"], h["tty"], h["text"]]) for i, h in enumerate(d["hist"][:40])]
                                or [("x", ["—", "", tr("no data")])])
        self.pages["users"] = (collect, apply)
        return scrolled(box)

    # --- Sicurezza ---
    def _page_security(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        p = panel(tr("Login and security events (last 24 hours)"), expand=True)
        self.sec_table = Table([(tr("WHEN"), 100), (tr("EVENT"), 260), (tr("DETAILS"), 200)])
        p.inner.append(self.sec_table)
        box.append(p)
        p = panel(tr("Failed services"))
        self.sec_failed = Gtk.Label(label="—", xalign=0, css_classes=["mono"])
        p.inner.append(self.sec_failed)
        box.append(p)

        def collect():
            raw = C.helper("auth")
            return {"auth": parse_auth(raw), "ok": bool(raw.strip())}

        def apply(d):
            ev = d["auth"]
            self._auth, self._auth_t = ev, time.time()
            if not d["ok"]:
                self.sec_table.update([("x", ["", tr("Log not readable"), tr("administrator permissions required")],
                                        [None, "warn", "dim"])])
            else:
                self.sec_table.update([(i, [e[0], e[1], e[2]], [None, e[3], None]) for i, e in enumerate(ev[:150])]
                                      or [("x", ["", tr("No events"), ""], [None, "dim", None])])
            st = getattr(self, "status", None)
            if st:
                self.sec_failed.set_text(", ".join(st["failed"]) if st["failed"] else tr("None"))
                self.sec_failed.set_css_classes(["mono", "warn" if st["failed"] else "ok"])
        self.pages["security"] = (collect, apply)
        return box

    # --- Processi ---
    def _page_processes(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        tools = Gtk.Box(spacing=8, margin_bottom=4)
        self.proc_search = Gtk.SearchEntry(placeholder_text=tr("filter processes"), hexpand=True)
        tools.append(self.proc_search)
        tools.append(Gtk.Label(label=tr("Sort:"), css_classes=["dim"]))
        self.proc_sort = "CPU"
        for chiave, lab in (("CPU", "CPU"), ("RAM", "RAM"), ("PID", "PID"), ("NOME", tr("NAME"))):
            b = Gtk.Button(label=lab, css_classes=["rbtn"])
            b.connect("clicked", lambda _b, s=chiave: setattr(self, "proc_sort", s))
            tools.append(b)
        box.append(tools)
        split = Gtk.Box(spacing=12, vexpand=True)
        p = panel(tr("Processes"), expand=True)
        self.proc_table = Table([("PID", 56), (tr("NAME"), 136), (tr("USER"), 72), ("CPU%", 48), ("RAM%", 48),
                                 ("RAM", 72), (tr("STATUS"), 104), (tr("STARTED"), 72)],
                                on_select=self._on_proc_select)
        p.inner.append(self.proc_table)
        split.append(p)
        det = panel(tr("Details"), expand=True)
        det.set_hexpand(False)
        det.set_size_request(260, -1)
        self.proc_detail = Gtk.Label(label=tr("Select a process"), xalign=0, yalign=0,
                                     css_classes=["mono", "dim"], wrap=True, vexpand=True)
        det.inner.append(self.proc_detail)
        btns = Gtk.Box(spacing=8)
        tb = Gtk.Button(label=tr("Quit"), css_classes=["rbtn"])
        tb.connect("clicked", lambda *_: self._kill(False))
        fb = Gtk.Button(label=tr("Force Quit"), css_classes=["rbtn"])
        fb.connect("clicked", lambda *_: self._kill(True))
        btns.append(tb)
        btns.append(fb)
        det.inner.append(btns)
        # il programma intero (con i sottoprocessi), riavvio, cartella
        btns2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for testo, fn in ((tr("Close with Subprocesses"), lambda *_: self._azione("albero")),
                          (tr("Restart"), lambda *_: self._azione("riavvia")),
                          (tr("Open Folder"), lambda *_: self._apri_cartella())):
            b = Gtk.Button(label=testo, css_classes=["rbtn"])
            b.connect("clicked", fn)
            btns2.append(b)
        det.inner.append(btns2)
        split.append(det)
        box.append(split)
        self.sel_pid = None
        states = {"running": tr("running"), "sleeping": tr("sleeping"), "idle": tr("idle"), "zombie": "zombie",
                  "stopped": tr("stopped"), "disk-sleep": tr("disk wait")}

        def collect():
            return self.col.processes(limit=300)

        def apply(rows):
            q = self.proc_search.get_text().strip().lower()
            if q:
                rows = [r for r in rows if q in r["name"].lower() or q == str(r["pid"])]
            key = {"CPU": "cpu", "RAM": "mem_pct", "PID": "pid", "NOME": "name"}[self.proc_sort]
            rows = sorted(rows, key=lambda r: r[key], reverse=(self.proc_sort in ("CPU", "RAM")))
            self.proc_table.update([(r["pid"], [r["pid"], r["name"], r["user"], "%.1f" % r["cpu"],
                                                "%.1f" % r["mem_pct"], _fmt_bytes(r["rss"]),
                                                states.get(r["status"], r["status"]), r["start"]])
                                    for r in rows[:100]])
        self.pages["processes"] = (collect, apply)
        return box

    def _on_proc_select(self, pid):
        self.sel_pid = pid
        d = self.col.process_detail(pid) if pid else None
        if not d:
            self.proc_detail.set_text("—")
            return
        ch = ", ".join("%s (%s)" % (n, p) for p, n in d["children"][:6]) or tr("none")
        if d.get("albero", 0) > len(d["children"]):
            ch += " · " + ntr("{n} subprocess in all", "{n} subprocesses in all", d["albero"]).format(n=d["albero"])
        io = (tr("read {read}, written {written}").format(read=_fmt_bytes(d["io"][0]), written=_fmt_bytes(d["io"][1]))
              if d.get("io") else tr("permission required"))
        self.proc_detail.set_text(
            tr("PID: {pid}\nName: {name}\nUser: {user}\nStatus: {status}\nParent: {ppid}\n\nExecutable:\n{exe}\n\n"
               "Command:\n{command}\n\nOpen files: {files}\nNetwork connections: {connections}\nDisk: {disk}\n"
               "Children: {children}").format(
                pid=d["pid"], name=d["name"], user=d["user"], status=d["status"], ppid=d["ppid"], exe=d["exe"],
                command=d["cmdline"], files=d["open_files"], connections=d["connections"], disk=io, children=ch))

    def _kill(self, force):
        if not self.sel_pid:
            return
        d = self.col.process_detail(self.sel_pid)
        name = d["name"] if d else str(self.sel_pid)
        pid = self.sel_pid
        corpo = (tr("Force quit the process {name} (PID {pid}). Unsaved data will be lost.") if force
                 else tr("Quit the process {name} (PID {pid}). Unsaved data will be lost."))
        dlg = Adw.AlertDialog(heading=tr("Close {name}?").format(name=name),
                              body=corpo.format(name=name, pid=pid))
        dlg.add_response("no", tr("Cancel"))
        dlg.add_response("yes", tr("Force Quit") if force else tr("Quit"))
        dlg.set_response_appearance("yes", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.connect("response", lambda _d, r: self._chiudi(pid, force) if r == "yes" else None)
        dlg.present(self)

    def _azione(self, quale):
        if not self.sel_pid:
            return
        pid = self.sel_pid
        d = self.col.process_detail(pid)
        nome = d["name"] if d else str(pid)
        testo = {"albero": (tr("Close {name} and its subprocesses?").format(name=nome), tr("Close All"),
                            tr("First they are asked to close; whatever doesn't respond within 3 seconds "
                               "is closed by force. Unsaved data will be lost.")),
                 "riavvia": (tr("Restart {name}?").format(name=nome), tr("Restart"),
                             tr("It will be closed (with its subprocesses) and reopened with the same command. "
                                "Unsaved data will be lost."))}[quale]
        dlg = Adw.AlertDialog(heading=testo[0], body=testo[2])
        dlg.add_response("no", tr("Cancel"))
        dlg.add_response("yes", testo[1])
        dlg.set_response_appearance("yes", Adw.ResponseAppearance.DESTRUCTIVE)

        def lavoro():
            ok, msg = (self.col.chiudi_albero(pid) if quale == "albero" else self.col.riavvia(pid))
            GLib.idle_add(self.toast, msg)
        dlg.connect("response", lambda _d, r: threading.Thread(target=lavoro, daemon=True).start()
                    if r == "yes" else None)
        dlg.present(self)

    def _apri_cartella(self):
        if not self.sel_pid:
            return
        d = self.col.process_detail(self.sel_pid)
        exe = d.get("exe") if d else None
        if not exe or not os.path.isabs(str(exe)):
            self.toast(tr("Executable not readable (system process or another user's)"))
            return
        subprocess.Popen(["thunar", os.path.dirname(exe)],
                         start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _chiudi(self, pid, force):
        # la verifica aspetta fino a 3 secondi: fuori dal thread della
        # finestra, che altrimenti resterebbe bloccata nel frattempo
        def lavoro():
            _ok, messaggio = self.col.terminate(pid, force)
            GLib.idle_add(self.toast, messaggio)
        threading.Thread(target=lavoro, daemon=True).start()

    # --- Servizi ---
    def _page_services(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.svc_search = Gtk.SearchEntry(placeholder_text=tr("filter services"))
        box.append(self.svc_search)
        split = Gtk.Box(spacing=12, vexpand=True)
        p = panel(tr("Services"), expand=True)
        self.svc_table = Table([(tr("SERVICE"), 240), (tr("STATE"), 90), (tr("DETAILS"), 110)],
                               on_select=self._on_svc_select)
        p.inner.append(self.svc_table)
        split.append(p)
        act = panel(tr("Actions"), expand=True)
        act.set_hexpand(False)
        act.set_size_request(240, -1)
        self.svc_sel = Gtk.Label(label=tr("Select a service"), xalign=0, yalign=0, css_classes=["mono", "dim"],
                                 vexpand=True, wrap=True)
        act.inner.append(self.svc_sel)
        for lab, a in ((tr("Start"), "start"), (tr("Stop"), "stop"), (tr("Restart"), "restart")):
            b = Gtk.Button(label=lab, css_classes=["rbtn"])
            b.connect("clicked", lambda _b, a=a: self._svc_action(a))
            act.inner.append(b)
        split.append(act)
        box.append(split)
        self.sel_svc = None
        st_it = {"RUNNING": tr("active"), "FAILED": tr("error"), "STOPPED": tr("stopped")}
        sub_it = {"running": tr("running"), "exited": tr("completed"), "dead": tr("not started"),
                  "failed": tr("failed"), "waiting": tr("waiting"), "auto-restart": tr("restarting"),
                  "start": tr("starting")}

        def collect():
            return self.col.services(limit=250)

        def apply(rows):
            q = self.svc_search.get_text().strip().lower()
            if q:
                rows = [r for r in rows if q in r["name"].lower()]
            self.svc_table.update([(r["name"], [r["name"], st_it.get(r["state"], r["state"]),
                                                sub_it.get(r["sub"], r["sub"])],
                                    [None, {"RUNNING": "ok", "FAILED": "alert"}.get(r["state"], "dim"), None])
                                   for r in rows[:150]])
        self.pages["services"] = (collect, apply)
        return box

    def _on_svc_select(self, name):
        self.sel_svc = name
        self.svc_sel.set_text(tr("Service:\n{name}").format(name=name) if name else "—")

    def _svc_action(self, action):
        if not self.sel_svc:
            return
        name = self.sel_svc
        domanda, verb = {"start": (tr("Start the {name} service?"), tr("Start")),
                         "stop": (tr("Stop the {name} service?"), tr("Stop")),
                         "restart": (tr("Restart the {name} service?"), tr("Restart"))}[action]
        dlg = Adw.AlertDialog(heading=domanda.format(name=name))
        dlg.add_response("no", tr("Cancel"))
        dlg.add_response("yes", verb)
        dlg.set_response_appearance("yes", Adw.ResponseAppearance.SUGGESTED)

        def do(_d, r):
            if r == "yes":
                def work():
                    ok, _err = self.col.service_action(name, action)
                    GLib.idle_add(self.toast, tr("Done") if ok else tr("Operation failed or canceled"))
                threading.Thread(target=work, daemon=True).start()
        dlg.connect("response", do)
        dlg.present(self)

    # --- Sistema ---
    def _page_system(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        top = self._grid()
        p = panel(tr("System"))
        grid, self.sys_kv = kv_grid([("Computer", tr("Computer")), ("Sistema", tr("System")), ("Kernel", "Kernel"),
                                     ("Architettura", tr("Architecture")), ("Attivo da", tr("Uptime")),
                                     ("Carico", tr("Load")), ("Temperatura CPU", tr("CPU temperature"))])
        p.inner.append(grid)
        top.attach(p, 0, 0, 1, 1)
        p = panel("CPU per core")
        self.core_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        p.inner.append(self.core_box)
        self.core_bars = []
        top.attach(p, 1, 0, 1, 1)
        box.append(top)
        bottom = self._grid()
        p = panel(tr("Memory"))
        self.mem_info = Gtk.Label(label="—", xalign=0, css_classes=["mono"], wrap=True)
        self.mem_bar = Bar(ACC)
        p.inner.append(self.mem_info)
        p.inner.append(self.mem_bar)
        bottom.attach(p, 0, 0, 1, 1)
        p = panel(tr("Disks"))
        self.store_table = Table([(tr("DEVICE"), 140), (tr("MOUNTED ON"), 120), (tr("USE"), 60), (tr("FREE"), 90)])
        self.store_table.set_size_request(-1, 120)
        p.inner.append(self.store_table)
        bottom.attach(p, 1, 0, 1, 1)
        box.append(bottom)

        def collect():
            return {"s": self.col.system(), "cpu": self.col.cpu(), "m": self.col.memory(), "st": self.col.storage()}

        def apply(d):
            s = d["s"]
            for k, v in (("Computer", s["host"]), ("Sistema", s["os"]), ("Kernel", s["kernel"]),
                         ("Architettura", s["arch"]), ("Attivo da", s["uptime"]), ("Carico", s["load"]),
                         ("Temperatura CPU", s["cpu_temp"])):
                self.sys_kv[k].set_text(str(v).replace(NA, "—"))
            cores = d["cpu"]["per_core"]
            if len(self.core_bars) != len(cores):
                child = self.core_box.get_first_child()
                while child:
                    self.core_box.remove(child)
                    child = self.core_box.get_first_child()
                self.core_bars = []
                for i in range(len(cores)):
                    r = Gtk.Box(spacing=8)
                    r.append(Gtk.Label(label="%d" % (i + 1), css_classes=["mono", "dim"], width_chars=3))
                    bar = Bar(ACC)
                    self.core_bars.append(bar)
                    r.append(bar)
                    self.core_box.append(r)
            for bar, v in zip(self.core_bars, cores):
                bar.set_value(v)
            m = d["m"]
            self.mem_info.set_text(tr("Total: {total}   Used: {used}   Available: {available}\n"
                                      "Swap: {swap_used} / {swap_total}").format(
                total=_fmt_bytes(m.get("total", 0)), used=_fmt_bytes(m.get("used", 0)),
                available=_fmt_bytes(m.get("available", 0)), swap_used=_fmt_bytes(m.get("swap_used", 0)),
                swap_total=_fmt_bytes(m.get("swap_total", 0))))
            self.mem_bar.set_value(m.get("percent", 0))
            self.store_table.update([(pp["mount"], [pp["device"], pp["mount"], "%.0f%%" % pp["percent"],
                                                    _fmt_bytes(pp["free"])]) for pp in d["st"]["parts"]])
        self.pages["system"] = (collect, apply)
        return scrolled(box)

    # ---------------- ping ----------------
    def _start_ping(self, host):
        with self.ping_lock:
            if host in self.ping_targets:
                return
            self.ping_targets[host] = {"cur": None, "min": None, "max": None, "avg": None,
                                       "loss": 0.0, "sent": 0, "lost": 0, "hist": []}
        threading.Thread(target=self._ping_worker, args=(host,), daemon=True).start()

    def _add_ping(self):
        host = self.ping_entry.get_text().strip()
        if host:
            self._start_ping(host)
            self.ping_entry.set_text("")

    def _ping_worker(self, host):
        while True:
            r = ping(host)
            with self.ping_lock:
                t = self.ping_targets.get(host)
                if t is None:
                    return
                t["sent"] += 1
                if r is None:
                    t["lost"] += 1
                    t["cur"] = None
                else:
                    t["cur"] = r
                    t["hist"] = (t["hist"] + [r])[-60:]
                    t["min"], t["max"] = min(t["hist"]), max(t["hist"])
                    t["avg"] = sum(t["hist"]) / len(t["hist"])
                t["loss"] = 100.0 * t["lost"] / max(1, t["sent"])
            time.sleep(2)

    def _update_ping_table(self):
        with self.ping_lock:
            items = list(self.ping_targets.items())
        rows = []
        for host, t in items:
            online = t["cur"] is not None
            f = lambda v: "%.0f" % v if v is not None else "—"  # noqa: E731
            rows.append((host, [host, ("%.0f ms" % t["cur"]) if online else "—", f(t["min"]), f(t["max"]),
                                f(t["avg"]), "%.0f%%" % t["loss"], tr("reachable") if online else tr("no response")],
                         [None] * 6 + ["ok" if online else "alert"]))
        self.ping_table.update(rows)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Monitor", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        tema.apply(CSS)
        win = self.props.active_window or Monitor(self)
        # la sezione per chiave («processes») o per nome («Processi»)
        if len(sys.argv) > 1:
            voluta = sys.argv[1].strip().lower()
            voluta = SECTION_ALIASES.get(voluta, voluta)
            for chiave, nome in SECTIONS:
                if voluta in (chiave, nome.lower()):
                    win._go(chiave)
                    break
        win.present()


if __name__ == "__main__":
    sys.exit(App().run([sys.argv[0]]))

SECTIONS = [
    ("overview", tr("Overview")), ("traffic", tr("Traffic")), ("map", tr("Map")), ("network", tr("Network")),
    ("vpn", tr("VPN and Proxy")), ("firewall", tr("Firewall")), ("connections", tr("Connections")),

SECTIONS = [
    ("overview", "Panoramica"), ("traffic", "Traffico"), ("map", "Mappa"), ("network", "Rete"),
    ("vpn", "VPN e proxy"), ("firewall", "Firewall"), ("connections", "Connessioni"),
    ("users", "Utenti"), ("security", "Sicurezza"), ("processes", "Processi"),
    ("services", "Servizi"), ("system", "Sistema"),
]


def panel(title, expand=False):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, css_classes=["panel"],
                  vexpand=expand, hexpand=True)
    inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, vexpand=expand,
                    margin_top=14, margin_bottom=14, margin_start=16, margin_end=16)
    if title:
        head = Gtk.Box(spacing=8)
        head.append(Gtk.Label(label=title.upper(), xalign=0, hexpand=True, css_classes=["panel-title"]))
        inner.append(head)
        box.head = head
    box.append(inner)
    box.inner = inner
    return box


def metric(value, unit="", cls="metric"):
    b = Gtk.Box(spacing=6, valign=Gtk.Align.END)
    v = Gtk.Label(label=value, xalign=0, css_classes=[cls, "mono"])
    b.append(v)
    b.unit = None
    if unit is not None:
        u = Gtk.Label(label=unit, xalign=0, css_classes=["unit"], valign=Gtk.Align.END, margin_bottom=6)
        b.append(u)
        b.unit = u
    b.value_label = v
    return b


def kv_grid(keys):
    """Griglia chiave/valore; restituisce (widget, {chiave: label_valore})."""
    g = Gtk.Grid(column_spacing=16, row_spacing=6)
    vals = {}
    for i, k in enumerate(keys):
        g.attach(Gtk.Label(label=k, xalign=0, css_classes=["kv-key"]), 0, i, 1, 1)
        v = Gtk.Label(label="—", xalign=0, hexpand=True, css_classes=["kv-val", "mono"], selectable=True,
                      wrap=True)
        g.attach(v, 1, i, 1, 1)
        vals[k] = v
    return g, vals


def _country_names():
    import json
    try:
        with open("/usr/share/zeta/monitor/world.json") as f:
            return {c["iso"]: c["name"] for c in json.load(f)["countries"] if c.get("iso")}
    except (OSError, ValueError, KeyError):
        return {}


COUNTRY_IT = _country_names()


def country_it(g):
    return COUNTRY_IT.get((g or {}).get("iso", ""), (g or {}).get("country", "")) if g else ""


def chip(text, style=None):
    lb = Gtk.Label(label=text, css_classes=["chip"] + ([style] if style else []))
    return lb


def set_chip(lb, text, style):
    lb.set_text(text)
    for s in ("ok", "warn", "alert"):
        lb.remove_css_class(s)
    if style:
        lb.add_css_class(style)


def scrolled(child, vertical=True):
    """Contenitore della pagina: la finestra non supera mai lo schermo, al limite
    la pagina scorre (anche in orizzontale sugli schermi piccoli)."""
    s = Gtk.ScrolledWindow(vexpand=True, hexpand=True, hscrollbar_policy=Gtk.PolicyType.AUTOMATIC,
                           vscrollbar_policy=Gtk.PolicyType.AUTOMATIC if vertical else Gtk.PolicyType.NEVER)
    s.set_child(child)
    return s


AUTH_TEXT = {
    ("ssh", "ok"): "Accesso SSH riuscito", ("ssh", "fail"): "Accesso SSH fallito",
    ("sudo", "ok"): "Comando da amministratore", ("sudo", "fail"): "Password di amministratore errata",
    ("login", "ok"): "Accesso al desktop", ("login", "fail"): "Accesso al desktop fallito",
    ("lock", "fail"): "Sblocco schermo fallito", ("polkit", "ok"): "Autorizzazione concessa",
    ("polkit", "fail"): "Autorizzazione negata",
}


def parse_auth(raw):
    """Eventi di accesso dal journal (JSON per riga) -> [(ora, testo, dettaglio, livello)]."""
    import json
    import re
    out = []
    for line in raw.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        msg = e.get("MESSAGE") or ""
        if isinstance(msg, list):
            continue
        comm = e.get("_COMM", "")
        ts = int(e.get("__REALTIME_TIMESTAMP", "0")) / 1e6
        t = time.strftime("%d/%m %H:%M", time.localtime(ts))
        low = msg.lower()
        ip = (re.search(r"from (\S+) port", msg) or [None, ""])[1]
        user = (re.search(r"for user ([^\s(]+)", msg) or re.search(r"for (?:invalid user )?([^\s(]+)", msg)
                or re.search(r"user[= ]([^\s(]+)", msg) or [None, ""])[1]
        kind = status = None
        if comm == "sshd":
            if low.startswith("accepted"):
                kind, status = "ssh", "ok"
            elif "failed password" in low or "invalid user" in low:
                kind, status = "ssh", "fail"
        elif comm == "sudo":
            if "zeta-monitor-helper" in low:
                continue
            if "command=" in low:
                kind, status = "sudo", "ok"
                user = (re.search(r"^\s*(\S+) :", msg) or [None, user])[1]
            elif "incorrect password" in low or "authentication failure" in low:
                kind, status = "sudo", "fail"
        elif comm in ("sddm-helper", "login"):
            if user == "sddm":
                continue            # la schermata di accesso stessa
            if "session opened" in low:
                kind, status = "login", "ok"
            elif "authentication failure" in low:
                kind, status = "login", "fail"
        elif comm == "hyprlock" and "fail" in low:
            kind, status = "lock", "fail"
        elif comm in ("polkitd", "pkexec"):
            if "authentication failure" in low or "not authorized" in low:
                kind, status = "polkit", "fail"
        if not kind:
            continue
        detail = user or ""
        if ip:
            detail += " da " + ip
        out.append((t, AUTH_TEXT.get((kind, status), kind), detail.strip(),
                    "alert" if status == "fail" else ("accent" if kind == "sudo" else "ok")))
    return out[::-1]


class Monitor(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="ZETA RAYS Monitor", default_width=1180, default_height=760)
        self.col = Collectors()
        self.pages = {}             # chiave -> (raccolta, applicazione)
        self.section = "overview"
        self.geo_enabled = True
        self.me = None              # posizione dell'IP pubblico
        self.dest = []              # destinazioni geolocalizzate
        self.ping_targets = {}
        self.ping_lock = threading.Lock()
        self.data_lock = threading.Lock()
        self.last = {}              # ultimi dati raccolti
        self.fw_busy = False

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.append(self._topbar())
        body = Gtk.Box(vexpand=True)
        body.append(self._nav())
        self.stack = Gtk.Stack(vexpand=True, hexpand=True, transition_type=Gtk.StackTransitionType.CROSSFADE,
                               hhomogeneous=False)
        for key, _l in SECTIONS:
            page = getattr(self, "_page_" + key)()
            if not isinstance(page, Gtk.ScrolledWindow):
                page = scrolled(page, vertical=False)   # le tabelle scorrono da sole
            self.stack.add_named(page, key)
        self.stack.set_margin_start(12)
        self.stack.set_margin_end(12)
        self.stack.set_margin_top(6)
        self.stack.set_margin_bottom(12)
        body.append(self.stack)
        root.append(body)
        self.toasts = Adw.ToastOverlay(child=root)
        self.set_content(self.toasts)

        # Quando la finestra non si vede (ridotta a icona, coperta, su un altro
        # spazio di lavoro) non ha senso continuare a raccogliere dati: sono
        # calcoli e letture da /proc per un pannello che nessuno sta guardando.
        # Il segnale più onesto è il disegno: se Hyprland non chiede più
        # fotogrammi, la finestra non è visibile.
        self._ultimo_disegno = time.monotonic()
        self.connect("map", lambda *_: self._segui_disegno())
        self._segui_disegno()

        threading.Thread(target=self._geo_me_worker, daemon=True).start()
        threading.Thread(target=self._dest_worker, daemon=True).start()
        threading.Thread(target=self._collector, daemon=True).start()
        GLib.timeout_add(1000, self._tick_net)
        self._gw_started = False

    def _segui_disegno(self):
        orologio = self.get_frame_clock()
        if orologio is None or getattr(self, "_orologio_agganciato", False):
            return
        self._orologio_agganciato = True
        orologio.connect("after-paint", self._disegnata)

    def _disegnata(self, _clock):
        self._ultimo_disegno = time.monotonic()

    def visibile(self):
        """Vero se la finestra è stata disegnata di recente."""
        return (time.monotonic() - self._ultimo_disegno) < 3.0

    # ---------------- struttura ----------------
    def _topbar(self):
        bar = Gtk.Box(spacing=18, margin_top=12, margin_bottom=10, margin_start=16, margin_end=16)
        title = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        title.append(Gtk.Label(label="ZETA RAYS MONITOR", xalign=0, css_classes=["big-label"]))
        title.append(Gtk.Label(label="MONITORAGGIO IN TEMPO REALE", xalign=0, css_classes=["panel-title"]))
        bar.append(title)
        self.top_status = Gtk.Label(label="● AVVIO…", xalign=0, css_classes=["dim", "status-dot", "mono"])
        bar.append(self.top_status)
        self.top_info = Gtk.Label(label="", xalign=1, hexpand=True, css_classes=["mono", "dim"])
        bar.append(self.top_info)
        return bar

    def _nav(self):
        rail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_start=12, margin_top=6,
                       margin_bottom=12)
        rail.set_size_request(168, -1)
        self.nav_buttons = {}
        for key, label in SECTIONS:
            btn = Gtk.Button(label=label.upper(), css_classes=["navbtn"], halign=Gtk.Align.FILL)
            btn.get_child().set_xalign(0)
            btn.connect("clicked", lambda _b, k=key: self._go(k))
            rail.append(btn)
            self.nav_buttons[key] = btn
        self.nav_buttons["overview"].add_css_class("active")
        return rail

    def _go(self, key):
        for b in self.nav_buttons.values():
            b.remove_css_class("active")
        self.nav_buttons[key].add_css_class("active")
        self.section = key
        self.stack.set_visible_child_name(key)
        with self.data_lock:
            data = self.last.get(key)
        if data is not None:
            self._apply(key, data)

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=4))

    # ---------------- raccolta in background ----------------
    def _collector(self):
        """Ogni secondo raccoglie i dati della pagina visibile (+ riepilogo) fuori dalla UI."""
        tick = 0
        while True:
            key = self.section
            if not self.visibile():
                # Finestra non visibile: si controlla ogni secondo se torna,
                # ma non si raccoglie nulla.
                time.sleep(1.0)
                continue
            try:
                fn = self.pages.get(key, (None, None))[0]
                if fn:
                    data = fn()
                    with self.data_lock:
                        self.last[key] = data
                    GLib.idle_add(self._apply, key, data)
                if tick % 5 == 0:
                    st = self._collect_status()
                    GLib.idle_add(self._apply_status, st)
            except Exception as e:  # noqa: BLE001
                print("monitor: errore raccogliendo %s: %s" % (key, e), file=sys.stderr)
            tick += 1
            time.sleep(1.0 if key not in ("services", "users", "firewall", "security") else 3.0)

    def _apply(self, key, data):
        fn = self.pages.get(key, (None, None))[1]
        if fn and key == self.section:
            try:
                fn(data)
            except Exception as e:  # noqa: BLE001
                print("monitor: errore mostrando %s: %s" % (key, e), file=sys.stderr)
        return False

    def _collect_status(self):
        fw = C.firewall_info()
        failed = subprocess.run(["systemctl", "--failed", "--no-legend", "--plain"], capture_output=True,
                                text=True).stdout.strip()
        return {"fw": fw, "failed": [l.split()[0] for l in failed.splitlines() if l.strip()],
                "sys": self.col.system()}

    def _apply_status(self, st):
        self.status = st
        fw_ok = st["fw"]["active"]
        if st["failed"]:
            text, style = "● %d SERVIZI IN ERRORE" % len(st["failed"]), "warn"
        elif not fw_ok:
            text, style = "● FIREWALL SPENTO", "warn"
        else:
            text, style = "● SISTEMA PROTETTO", "ok"
        self.top_status.set_text(text)
        self.top_status.set_css_classes(["status-dot", "mono", style])
        return False

    def _tick_net(self):
        """Traffico ogni secondo per i grafici, anche fuori dalla loro pagina."""
        net = self.col.net_io()
        if net["in_rate"] is not None:
            for chart in (self.ov_chart, self.tr_chart):
                chart.push(net["in_rate"], net["out_rate"])
            self.net_now = net
        s = getattr(self, "status", None)
        up = s["sys"]["uptime"] if s else "—"
        self.top_info.set_text("HOST: %s  ·  ATTIVO DA: %s  ·  %s"
                               % (os.uname().nodename.upper(), up, time.strftime("%H:%M:%S")))
        if not self._gw_started:
            gd = self.col.gateway_dns()
            if gd["gateway"] != NA:
                self._start_ping(gd["gateway"])
            self._start_ping("1.1.1.1")
            self._gw_started = True
        return True

    # =============================== PAGINE ===============================
    def _grid(self):
        return Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True)

    # --- Panoramica ---
    def _page_overview(self):
        g = self._grid()
        p = panel("Salute del sistema")
        row = Gtk.Box(spacing=24)
        self.ov = {}
        for k, lab in (("cpu", "CPU"), ("ram", "RAM"), ("gpu", "GPU"), ("disk", "DISCO")):
            b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            b.append(Gtk.Label(label=lab, xalign=0, css_classes=["panel-title"]))
            m = metric("—", "%")
            self.ov[k] = m.value_label
            b.append(m)
            row.append(b)
        p.inner.append(row)
        self.ov_cpu = Sparkline(ACC, height=46)
        p.inner.append(self.ov_cpu)
        # dettagli in una riga ciascuno: per core, memoria di scambio, carico,
        # temperatura, disco e scheda grafica
        self.ov_det = {}
        for k in ("core", "mem", "sys", "gpu"):
            lb = Gtk.Label(label="", xalign=0, wrap=True, css_classes=["dim", "mono"])
            self.ov_det[k] = lb
            p.inner.append(lb)
        g.attach(p, 0, 0, 1, 1)

        p = panel("Traffico di rete")
        leg = Gtk.Box(spacing=18)
        self.ov_down = Gtk.Label(label="↓ —", css_classes=["legend-down", "mono"])
        self.ov_up = Gtk.Label(label="↑ —", css_classes=["legend-up", "mono"])
        leg.append(self.ov_down)
        leg.append(self.ov_up)
        p.inner.append(leg)
        self.ov_chart = TrafficChart(ACC, GREEN, seconds=60, height=110)
        p.inner.append(self.ov_chart)
        g.attach(p, 1, 0, 1, 1)

        p = panel("Protezione")
        chips = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, column_spacing=8, row_spacing=8,
                            max_children_per_line=3)
        self.ov_fw = chip("Firewall …")
        self.ov_vpn = chip("VPN …")
        self.ov_px = chip("Proxy …")
        self.ov_fail = chip("Accessi falliti …")
        self.ov_sess = chip("Sessioni …")
        self.ov_ports = chip("Porte aperte …")
        for c in (self.ov_fw, self.ov_vpn, self.ov_px, self.ov_fail, self.ov_sess, self.ov_ports):
            chips.append(c)
        p.inner.append(chips)
        g.attach(p, 0, 1, 1, 1)

        p = panel("Posizione di rete")
        self.ov_map = WorldMap(ACC, height=150, animate=True)
        p.inner.append(self.ov_map)
        self.ov_loc = Gtk.Label(label="Richiesta in corso…", xalign=0, css_classes=["dim", "mono"])
        p.inner.append(self.ov_loc)
        g.attach(p, 1, 1, 1, 1)

        p = panel("Processi (CPU)", expand=True)
        self.ov_proc = Table([("PID", 56), ("NOME", 170), ("CPU%", 56), ("RAM%", 56)])
        p.inner.append(self.ov_proc)
        g.attach(p, 0, 2, 1, 1)
        p = panel("Eventi recenti", expand=True)
        self.ov_ev = Table([("QUANDO", 96), ("EVENTO", 220), ("DETTAGLIO", 140)])
        p.inner.append(self.ov_ev)
        g.attach(p, 1, 2, 1, 1)

        def collect():
            cpu = self.col.cpu()
            mem = self.col.memory()
            st = self.col.storage()
            procs = self.col.processes(limit=8)
            vpn = [v for v in network.vpns() if v["active"]] + [{"name": t["name"]} for t in C.vpn_tunnels()]
            px = network.proxy()
            socks = C.sockets_all()
            listen = [s for s in (socks or []) if s["state"] in ("LISTEN", "UNCONN")
                      and s["lhost"] not in ("127.0.0.1", "::1", "127.0.0.53", "127.0.0.54")]
            auth = parse_auth(C.helper("auth")) if time.time() - getattr(self, "_auth_t", 0) > 20 else None
            return {"cpu": cpu, "mem": mem, "disk": max((pp["percent"] for pp in st["parts"]), default=0),
                    "st": st, "gpu": self.col.gpu(), "sys": self.col.system(),
                    "procs": procs, "vpn": vpn, "proxy": px, "listen": len(listen),
                    "sessions": len(C.logind_sessions()), "auth": auth}

        def apply(d):
            self.ov["cpu"].set_text("%.0f" % (d["cpu"]["total"] or 0))
            self.ov_cpu.push(d["cpu"]["total"] or 0)
            self.ov["ram"].set_text("%.0f" % (d["mem"].get("percent") or 0))
            self.ov["disk"].set_text("%.0f" % d["disk"])
            gp = d["gpu"]
            self.ov["gpu"].set_text("%.0f" % gp["busy"] if gp["busy"] is not None else "—")
            core = d["cpu"].get("per_core") or []
            self.ov_det["core"].set_text(
                "Core: " + "  ".join("%d%%" % c for c in core) +
                ("  ·  %s" % d["cpu"]["freq"] if d["cpu"].get("freq") not in (None, NA) else ""))
            m = d["mem"]
            if m:
                self.ov_det["mem"].set_text(
                    "RAM libera %s su %s  ·  Scambio %s su %s (%.0f%%)" % (
                        _fmt_bytes(m["available"]), _fmt_bytes(m["total"]),
                        _fmt_bytes(m["swap_used"]), _fmt_bytes(m["swap_total"]), m["swap_percent"]))
            sy, st = d["sys"], d["st"]
            self.ov_det["sys"].set_text(
                "Carico %s  ·  %s  ·  Disco ↓ %s ↑ %s  ·  Acceso da %s" % (
                    sy["load"],
                    ("CPU %s" % sy["cpu_temp"]) if sy["cpu_temp"] not in (None, NA)
                    else "temperatura CPU non disponibile",
                    *(fmt_rate(v) if isinstance(v, (int, float)) else NA
                      for v in (st.get("read_rate"), st.get("write_rate"))),
                    sy["uptime"]))
            dettagli = [gp["name"]]
            if gp["driver"] not in (None, NA):
                dettagli.append("driver %s" % gp["driver"])
            if gp["freq"]:
                dettagli.append("%d MHz" % gp["freq"])
            if gp["vram_total"]:
                dettagli.append("memoria video %s su %s" % (_fmt_bytes(gp["vram_used"]),
                                                            _fmt_bytes(gp["vram_total"])))
            if gp["busy"] is None:
                dettagli.append("uso non misurabile con questo driver")
            self.ov_det["gpu"].set_text("GPU: " + "  ·  ".join(dettagli))
            n = getattr(self, "net_now", None)
            if n:
                self.ov_down.set_text("↓ " + fmt_rate(n["in_rate"]))
                self.ov_up.set_text("↑ " + fmt_rate(n["out_rate"]))
            st = getattr(self, "status", None)
            if st:
                set_chip(self.ov_fw, "Firewall attivo" if st["fw"]["active"] else "Firewall spento",
                         "ok" if st["fw"]["active"] else "alert")
            set_chip(self.ov_vpn, ("VPN: " + d["vpn"][0]["name"]) if d["vpn"] else "Nessuna VPN",
                     "ok" if d["vpn"] else None)
            pm = d["proxy"]["mode"]
            set_chip(self.ov_px, {"none": "Nessun proxy", "manual": "Proxy manuale",
                                  "auto": "Proxy automatico"}.get(pm, pm), None if pm == "none" else "warn")
            set_chip(self.ov_sess, "Sessioni: %d" % d["sessions"], None)
            set_chip(self.ov_ports, "Servizi in ascolto: %d" % d["listen"], "warn" if d["listen"] else "ok")
            if d["auth"] is not None:
                self._auth_t = time.time()
                self._auth = d["auth"]
            ev = getattr(self, "_auth", [])
            fails = sum(1 for e in ev if e[3] == "alert")
            set_chip(self.ov_fail, "Accessi falliti (24h): %d" % fails, "alert" if fails else "ok")
            self.ov_ev.update([(i, [e[0], e[1], e[2]], [None, e[3], None]) for i, e in enumerate(ev[:12])]
                              or [("x", ["—", "Nessun evento nelle ultime 24 ore", ""], [None, "dim", None])])
            self.ov_proc.update([(p["pid"], [p["pid"], p["name"], "%.1f" % p["cpu"], "%.1f" % p["mem_pct"]])
                                 for p in d["procs"][:8]])
            self.ov_loc.set_text(self._geo_line() if self.me else
                                 ("Geolocalizzazione disattivata" if not self.geo_enabled else "Richiesta in corso…"))
        self.pages["overview"] = (collect, apply)
        return scrolled(g)

    # --- Traffico ---
    def _page_traffic(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        p = panel("Traffico di rete (ultimi 2 minuti)")
        stats = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, column_spacing=28, row_spacing=8,
                            max_children_per_line=6, homogeneous=False)
        self.tr = {}
        for k, lab, cls in (("down", "DOWNLOAD", "legend-down"), ("up", "UPLOAD", "legend-up"),
                            ("pdown", "PICCO ↓", None), ("pup", "PICCO ↑", None),
                            ("tin", "RICEVUTI", None), ("tout", "INVIATI", None)):
            b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            b.append(Gtk.Label(label=lab, xalign=0, css_classes=["panel-title"]))
            v = Gtk.Label(label="—", xalign=0, css_classes=["metric-sm", "mono"] + ([cls] if cls else []))
            b.append(v)
            self.tr[k] = v
            stats.append(b)
        p.inner.append(stats)
        self.tr_chart = TrafficChart(ACC, GREEN, seconds=120, height=260)
        p.inner.append(self.tr_chart)
        box.append(p)
        g = self._grid()
        p = panel("Interfacce", expand=True)
        self.tr_if = Table([("INTERFACCIA", 88), ("↓ ORA", 88), ("↑ ORA", 88), ("RICEVUTI", 80), ("INVIATI", 80)])
        p.inner.append(self.tr_if)
        g.attach(p, 0, 0, 1, 1)
        p = panel("Connessioni per stato", expand=True)
        self.tr_states = Table([("STATO", 160), ("NUMERO", 80)])
        p.inner.append(self.tr_states)
        g.attach(p, 1, 0, 1, 1)
        box.append(g)
        self._if_prev = None

        def collect():
            import psutil
            now = time.time()
            cur = psutil.net_io_counters(pernic=True)
            rates = {}
            if self._if_prev:
                prev, pt = self._if_prev
                dt = max(1e-3, now - pt)
                for n, c in cur.items():
                    if n in prev:
                        rates[n] = ((c.bytes_recv - prev[n].bytes_recv) / dt, (c.bytes_sent - prev[n].bytes_sent) / dt)
            self._if_prev = (cur, now)
            socks = C.sockets_all() or []
            counts = {}
            for s in socks:
                counts[C.STATE_IT.get(s["state"], s["state"])] = counts.get(C.STATE_IT.get(s["state"], s["state"]), 0) + 1
            tot = psutil.net_io_counters()
            return {"cur": cur, "rates": rates, "counts": counts, "tin": tot.bytes_recv, "tout": tot.bytes_sent}

        def apply(d):
            n = getattr(self, "net_now", None)
            if n:
                self.tr["down"].set_text(fmt_rate(n["in_rate"]))
                self.tr["up"].set_text(fmt_rate(n["out_rate"]))
            pd, pu = self.tr_chart.peaks()
            self.tr["pdown"].set_text(fmt_rate(pd))
            self.tr["pup"].set_text(fmt_rate(pu))
            self.tr["tin"].set_text(_fmt_bytes(d["tin"]))
            self.tr["tout"].set_text(_fmt_bytes(d["tout"]))
            self.tr_if.update([(name, [name, fmt_rate(d["rates"].get(name, (0, 0))[0]),
                                       fmt_rate(d["rates"].get(name, (0, 0))[1]),
                                       _fmt_bytes(c.bytes_recv), _fmt_bytes(c.bytes_sent)])
                               for name, c in sorted(d["cur"].items()) if name != "lo"])
            self.tr_states.update([(k, [k, v]) for k, v in sorted(d["counts"].items(), key=lambda x: -x[1])]
                                  or [("x", ["Nessuna connessione", ""])])
        self.pages["traffic"] = (collect, apply)
        return scrolled(box)

    # --- Mappa ---
    def _page_map(self):
        box = Gtk.Box(spacing=12)
        p = panel("Mappa delle connessioni", expand=True)
        row = Gtk.Box(spacing=8)
        row.append(Gtk.Label(label="Geolocalizzazione degli IP (richiesta esterna a ipwho.is)",
                             xalign=0, hexpand=True, css_classes=["dim"]))
        self.geo_switch = Gtk.Switch(active=True, valign=Gtk.Align.CENTER)
        self.geo_switch.connect("state-set", self._on_geo_toggle)
        row.append(self.geo_switch)
        p.head.append(row)
        self.map = WorldMap(ACC, height=420)
        p.inner.append(self.map)
        leg = Gtk.Box(spacing=18)
        leg.append(Gtk.Label(label="● Tu (IP pubblico)", css_classes=["legend-down"]))
        leg.append(Gtk.Label(label="● Destinazioni delle connessioni attive", css_classes=["legend-up"]))
        p.inner.append(leg)
        box.append(p)
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        side.set_size_request(330, -1)
        p = panel("La tua posizione")
        grid, self.map_me = kv_grid(["IP pubblico", "Città", "Paese", "Fornitore", "ASN"])
        p.inner.append(grid)
        side.append(p)
        p = panel("Destinazioni", expand=True)
        self.map_dest = Table([("PAESE", 120), ("CITTÀ", 100), ("PROCESSO", 90)])
        p.inner.append(self.map_dest)
        side.append(p)
        box.append(side)

        def collect():
            return None

        def apply(_d):
            if self.me:
                m = self.me
                for k, v in (("IP pubblico", m.get("ip")), ("Città", m.get("city")),
                             ("Paese", country_it(m)), ("Fornitore", m.get("isp")), ("ASN", m.get("asn"))):
                    self.map_me[k].set_text(str(v or "—"))
            self.map_dest.update([(i, [d["country"], d["city"], d["process"]])
                                  for i, d in enumerate(self.dest[:40])]
                                 or [("x", ["—", "nessuna", ""])])
        self.pages["map"] = (collect, apply)
        return box

    def _geo_me_worker(self):
        while True:
            if self.geo_enabled:
                m = geo.me()
                if m:
                    self.me = m
                    GLib.idle_add(self._geo_apply)
            time.sleep(300)

    def _geo_apply(self):
        m = self.me
        label = ", ".join(x for x in (m.get("city"), country_it(m)) if x) if m else ""
        for mp in (self.map, self.ov_map):
            if m and self.geo_enabled:
                mp.set_me(m.get("lat"), m.get("lon"), label)
            else:
                mp.set_me(None, None, "")
        return False

    def _geo_line(self):
        m = self.me
        return "%s · %s, %s · %s" % (m.get("ip"), m.get("city"), country_it(m), m.get("isp"))

    def _dest_worker(self):
        """Geolocalizza le destinazioni delle connessioni stabilite (con cache)."""
        while True:
            if self.geo_enabled:
                socks = C.sockets_all() or []
                seen = {}
                for s in socks:
                    if s["state"] == "ESTAB" and geo.is_public(s["rhost"]) and s["rhost"] not in seen:
                        seen[s["rhost"]] = s["process"]
                dest = []
                for ip, proc in list(seen.items())[:30]:
                    g = geo.lookup(ip)
                    if g and g.get("lat") is not None:
                        dest.append({"ip": ip, "lat": g["lat"], "lon": g["lon"], "iso": g.get("iso", ""),
                                     "country": country_it(g), "city": g.get("city", ""),
                                     "process": proc, "label": g.get("city", "")})
                self.dest = dest
                GLib.idle_add(self._dest_apply)
            time.sleep(10)

    def _dest_apply(self):
        pts = self.dest if self.geo_enabled else []
        isos = {d["iso"] for d in pts}
        for mp in (self.map, self.ov_map):
            mp.set_points(pts, isos)
        if self.section == "map":
            self._apply("map", None)
        return False

    def _on_geo_toggle(self, _sw, state):
        self.geo_enabled = state
        self._geo_apply()
        self._dest_apply()
        if state and not self.me:
            threading.Thread(target=lambda: (setattr(self, "me", geo.me()), GLib.idle_add(self._geo_apply)),
                             daemon=True).start()
        return False

    # --- Rete ---
    def _page_network(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        g = self._grid()

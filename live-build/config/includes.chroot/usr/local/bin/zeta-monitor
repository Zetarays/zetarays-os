"""ZETA RAYS Monitor — monitoraggio del sistema in tempo reale.

Panoramica · Traffico · Mappa · Rete · VPN e proxy · Firewall · Connessioni ·
Utenti · Sicurezza · Processi · Servizi · Sistema

Local-first: le sole richieste esterne sono la geolocalizzazione degli IP
(IP pubblico e destinazioni delle connessioni), esplicite e disattivabili.
I dati si raccolgono in un thread separato: l'interfaccia non si blocca mai.
I dati che richiedono privilegi (regole del firewall, connessioni di tutti i
processi, registro degli accessi) arrivano da /usr/libexec/zeta-monitor-helper
(sola lettura, vedi /etc/sudoers.d/zeta-monitor).
"""
import os
import subprocess
import sys
import threading
import time

sys.path.insert(0, "/usr/lib/zeta")
from ui import tema  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, GLib, Gio, Gtk  # noqa: E402

from monitor import collectors as C  # noqa: E402
from monitor import geo  # noqa: E402
from monitor.collectors import Collectors, fmt_rate, ping, _fmt_bytes, NA  # noqa: E402
from monitor.widgets import Bar, Sparkline, Table, TrafficChart  # noqa: E402
from monitor.worldmap import WorldMap  # noqa: E402
from system import network  # noqa: E402

ACCENT_FILE = os.path.expanduser("~/.config/zeta/accent")


def accent_rgb():
    try:
        with open(ACCENT_FILE) as f:
            h = f.read().strip().lstrip("#")
        return (int(h[0:2], 16) / 255, int(h[2:4], 16) / 255, int(h[4:6], 16) / 255)
    except (OSError, ValueError):
        return (0.23, 0.55, 1.0)


ACC = accent_rgb()
ACC_HEX = "#%02X%02X%02X" % tuple(int(v * 255) for v in ACC)
GREEN = (0.24, 0.86, 0.59)


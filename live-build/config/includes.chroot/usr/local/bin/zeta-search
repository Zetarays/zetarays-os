# ZETA RAYS — universal search (Spotlight style). Opens apps, settings, actions,
# files (by name, via plocate) and documents (by content, via the FTS index with
# PDF text and image OCR). All from the keyboard: type, arrows to choose,
# Enter to open, Esc to close.
import glob
import os
import subprocess
import sys
import threading

# gtk4-layer-shell must be loaded before libwayland: re-exec with LD_PRELOAD
if "ZETA_SEARCH_PRELOADED" not in os.environ:
    libs = glob.glob("/usr/lib/*/libgtk4-layer-shell.so.0")
    if libs:
        env = dict(os.environ, ZETA_SEARCH_PRELOADED="1",
                   LD_PRELOAD=(libs[0] + " " + os.environ.get("LD_PRELOAD", "")).strip())
        os.execve(sys.executable, [sys.executable] + sys.argv, env)

sys.path.insert(0, "/usr/lib/zeta")
import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
try:
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gtk4LayerShell as LayerShell
except (ValueError, ImportError):
    LayerShell = None

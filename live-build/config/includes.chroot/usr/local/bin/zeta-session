#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Startup of the ZETA RAYS graphical session (launched by Hyprland).
# Scaling and VM detection have already been written by zeta-desktop-session.

gsettings set org.gnome.desktop.interface icon-theme 'zeta' 2>/dev/null

# --- Language of this login for everything started later -------------------
# Apps started through D-Bus or by the user's systemd manager (which can
# outlive a quick log out and back in) would otherwise keep the language and
# input method of the previous login.
# A variable this login does not have is set EMPTY, not left out: the user's
# service manager can outlive a quick log out and back in, and its old value
# (e.g. LANGUAGE=it_IT:it) cannot be unset; empty means "not set" to gettext.
env_lang=()
for v in LANG LANGUAGE LC_ALL LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE LC_MONETARY LC_MESSAGES \
         LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE LC_MEASUREMENT LC_IDENTIFICATION \
         XMODIFIERS QT_IM_MODULE SDL_IM_MODULE; do
    env_lang+=("$v=${!v:-}")
done
dbus-update-activation-environment --systemd "${env_lang[@]}" 2>/dev/null
# Portals started before a session exported its environment (for example
# called from an SSH session, or after a quick log out and back in): having
# failed with "cannot open display", they would stay down and apps would wait
# for nothing. Their state is reset and they are restarted with this
# session's environment.
systemctl --user reset-failed 'xdg-desktop-portal*' >/dev/null 2>&1
systemctl --user try-restart xdg-desktop-portal.service xdg-desktop-portal-hyprland.service >/dev/null 2>&1 &

# --- Desktop components get back up by themselves --------------------------
# If one of them crashes, the user must not be left without a bar, wallpaper
# or icons: a loop restarts it. A growing delay keeps a broken program from
# burning CPU by restarting forever.
MY_HYPRLAND=$(pgrep -nx -u "$(id -u)" Hyprland)
supervise() {
    local name="$1"; shift
    (
        delay=2
        while true; do
            # Hyprland is gone: this session's watchdog ends here, the new
            # session's watchdog replaces it (see zeta-recovery).
            if [ -n "$MY_HYPRLAND" ] && ! kill -0 "$MY_HYPRLAND" 2>/dev/null; then
                exit 0
            fi
            started=$SECONDS
            "$@" >/dev/null 2>&1
            code=$?
            # Only quick, repeated crashes lengthen the delay (a broken program
            # must not burn CPU by restarting continuously). If instead it had
            # been running for more than a minute it restarts right away:
            # previously the delay grew on every crash, even hours apart, and
            # after a few crashes the bar took half a minute to come back.
            if [ $(( SECONDS - started )) -ge 60 ]; then
                delay=2
            fi
            logger -t zeta-session "$name exited (code $code), restarting in ${delay}s" 2>/dev/null || true
            sleep "$delay"
            delay=$(( delay < 30 ? delay * 2 : 30 ))
        done
    ) &
}

# Localized personal folders (e.g. the Italian names of Desktop, Documents, Downloads):
# created at first login, before the desktop icons need them.
xdg-user-dirs-update 2>/dev/null
# User picture: when none has been chosen, the ZETA RAYS symbol in the accent
# color (account menu, lock and login screens). It does not touch a choice
# already made.
( /usr/bin/python3 -c 'import sys; sys.path.insert(0, "/usr/lib/zeta"); from system import avatar; avatar.ensure()' >/dev/null 2>&1 ) &

# Thunar's custom actions translate the item names (xml:lang) but not the
# name of a submenu: the "Folder Color" submenu is named here in the user's
# language.
UCA="$HOME/.config/Thunar/uca.xml"
if [ -f "$UCA" ]; then
    # i18n-data-begin: the Italian submenu name
    case "${LANG:-}" in it*) SUB="Colore della cartella" ;; *) SUB="Folder Color" ;; esac
    grep -q "<submenu>$SUB</submenu>" "$UCA" || \
        sed -i -E "s#<submenu>(Folder Color|Colore della cartella)</submenu>#<submenu>$SUB</submenu>#" "$UCA"
    # i18n-data-end
fi
# Folder for AppImages: those placed here (or in Downloads, or in /opt) join
# the menu by themselves (zeta-appimage.path). At first login the ones already
# present are integrated, in the background and without hurry.
# AppImages: ~/Applications is the standard place (the old Italian folder of
# earlier installs keeps working: applications.py scans both)
mkdir -p "$HOME/Applications"
# input method for Chinese, Japanese and Korean, when turned on in Settings
if [ -s "$HOME/.config/zeta/input-method" ] && command -v fcitx5 >/dev/null; then
    fcitx5 -d --replace >/dev/null 2>&1
fi
( sleep 20; nice -n 10 zeta-app appimage >/dev/null 2>&1 ) &

# Colors, theme, text, icons, cursor and desktop icons (zeta-appearance calls
# zeta-accent, which generates the colors of every app, the wallpaper and the
# launcher symbol).
zeta-appearance apply

# Administrative apps (Packages, installer) run as root via pkexec/sudo:
# without this they could not open windows on Xwayland.
xhost +si:localuser:root >/dev/null 2>&1 &

# Wallpaper chosen by the user (or the ZETA RAYS one generated from the accent color)
pgrep -x swaybg >/dev/null || zeta-wallpaper apply &
# Title bars: the hyprbars plugin is loaded after the configuration is read,
# so the buttons (close/minimize/maximize) are only registered on the next
# reload. A single reload at startup, if the plugin is there.
if [ -f /usr/lib/zeta/hypr/hyprbars.so ]; then
    ( sleep 2; hyprctl plugin list 2>/dev/null | grep -qi hyprbars && hyprctl reload >/dev/null 2>&1 ) &
fi

supervise bar waybar
# Notifications: if mako has already started on its own (D-Bus starts it on
# the first notification), a second one is not launched, since it would exit
# immediately with an error and be relaunched every 30 seconds forever: we
# wait for the existing one to end, and only then start our own.
notifications() {
    local pid
    pid=$(pgrep -xo -u "$(id -u)" mako)
    if [ -n "$pid" ]; then
        tail --pid="$pid" -f /dev/null
    else
        mako
    fi
}
supervise notifications notifications
# A single process listens to Hyprland events: it updates the workspace
# numbers in the bar without the modules having to poll continuously.
supervise workspaces zeta-workspaces listen
# App switcher (Ctrl+Tab): stays ready and hidden, so it appears instantly.
# When idle it uses no CPU (it waits for commands on a socket).
supervise switcher zeta-switcher --daemon
# Ctrl+Alt+Del: the emergency panel stays ready (it appears instantly even
# when the computer is struggling; earlyoom does not kill it)
supervise emergency zeta-emergency --daemon
# Minimize with a preview in the bar and an animation: ready, hidden, no CPU
# while idle (it waits for commands on a socket)
supervise minimize zeta-minimize --daemon
# The light/dark buttons inside the text editor become its page color, so
# the editor never runs in a mode different from the desktop's (flicker).
supervise editor-mode zeta-appearance follow-editor
# Automatic lock (not on the live system: there everybody knows the password)
[ -d /run/live/medium ] || pgrep -x hypridle >/dev/null || hypridle &
/usr/libexec/polkit-mate-authentication-agent-1 &

# Watchdog for the wallpaper and desktop icons: if they crash, they come back.
zeta-watchdog &

# Bar panels kept ready in memory, hidden (launcher, control center, power,
# search): a click shows them instantly (zeta-panel) instead of restarting
# Python and GTK every time. A few seconds after login, so as not to slow it
# down; if one crashes, the next click restarts it by itself.
( sleep 6
  for p in zeta-launcher zeta-control-center zeta-power-menu zeta-search; do
      ZETA_PANEL_HIDDEN=1 "$p" >/dev/null 2>&1 &
      sleep 1
  done ) &

# Local AI model: loaded into memory 40 seconds after login, at low
# priority. This way the first question to ZETA is answered right away
# instead of waiting for the model to load (tens of seconds).
( sleep 40; nice -n 15 zeta-ai-preload ) >/dev/null 2>&1 &

# Install mode: the "Install ZETA RAYS OS" boot menu entry adds "zeta-install"
# to the kernel command line. In that case we open the installer right away;
# if the user closes it, they still stay on the live desktop.
if grep -qw zeta-install /proc/cmdline 2>/dev/null; then
    ( sleep 3; zeta-install-system ) &
elif [ -d /run/live/medium ]; then
    # Live system: welcome screen with "Try" / "Install". It does not depend
    # on the boot menu, which in some virtual machines gets no keyboard input.
    ( sleep 3; zeta-welcome ) &
elif [ -e /etc/zeta/first-boot-language ] && [ ! -e "$HOME/.config/zeta/language-choice" ]; then
    # Ready-made system (OVA): no installer asked for the language, so the
    # first login opens Settings > Language & Region, once
    mkdir -p "$HOME/.config/zeta" && : > "$HOME/.config/zeta/language-choice"
    ( sleep 4; zeta-settings language ) &
fi

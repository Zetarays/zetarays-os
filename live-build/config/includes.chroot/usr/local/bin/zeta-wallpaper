#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""zeta-wallpaper — ZETA RAYS desktop wallpaper.

  zeta-wallpaper apply                apply the saved wallpaper (at session start)
  zeta-wallpaper set <file> [mode]    use an image chosen by the user
  zeta-wallpaper mode <mode>          change only how the image is fitted
  zeta-wallpaper reset                go back to the ZETA RAYS wallpaper generated
                                   from the accent color
  zeta-wallpaper get                  print the current choice (path and mode)

Modes (as in swaybg): fill, fit, center, tile, stretch.
The choice is saved in ~/.config/zeta/wallpaper.json and survives a reboot.
"""
import json
import os
import shutil
import subprocess
import sys

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr  # noqa: E402

CFG = os.path.expanduser("~/.config/zeta")
CONF = os.path.join(CFG, "wallpaper.json")
GENERATED = os.path.join(CFG, "wallpaper.png")     # generated by zeta-accent
# Up to the October 9 build of 2.0, the lock screen showed the wallpaper
# through this symlink. Now the lock screen is solid black (hyprlock.conf):
# the leftover symlink is removed.
LOCK_WALLPAPER = os.path.join(CFG, "lock-wallpaper")
OFFICIAL_WALLPAPERS = "/usr/share/zeta/wallpapers/"
MODES = ("fill", "fit", "center", "tile", "stretch")


def load():
    try:
        with open(CONF) as f:
            d = json.load(f)
        if isinstance(d, dict):
            return d
    except (OSError, ValueError):
        pass
    return {}


def save(d):
    os.makedirs(CFG, exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2)
    os.replace(tmp, CONF)


def current():
    """Effective (path, mode): the user's image or the ZETA RAYS wallpaper."""
    d = load()
    path = d.get("path") or ""
    mode = d.get("mode") or "fill"
    if mode not in MODES:
        mode = "fill"
    if path and os.path.isfile(path):
        return path, mode
    return GENERATED, mode


def remove_old_lock():
    try:
        if os.path.islink(LOCK_WALLPAPER):
            os.remove(LOCK_WALLPAPER)
    except OSError:
        pass


# Official wallpapers whose edges are pure black (measured on 17 October
# 2026: Goddess and the four logos). "fill" would cut their sides on a screen
# that is not 16:9; shown whole on black they look the same, uncut, on any
# screen. The full-bleed ones (waves, circuits, terminal) keep "fill".
BLACK_EDGES = {"zeta-goddess.jpg", "zeta-blue.jpg", "zeta-green.jpg", "zeta-red.jpg",
               "zeta-white.jpg"}


def swaybg_options(path, mode):
    """swaybg arguments for an image and a mode, black around the image."""
    if mode == "fill" and os.path.basename(path) in BLACK_EDGES:
        mode = "fit"
    return ["-m", mode, "-c", "000000", "-i", path]


def apply():
    path, mode = current()
    if not os.path.isfile(path):
        return 1
    remove_old_lock()
    if not shutil.which("swaybg"):
        return 1
    subprocess.run(["pkill", "-x", "swaybg"], check=False)
    subprocess.Popen(["swaybg"] + swaybg_options(path, mode),
                     start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "apply"
    d = load()
    if cmd == "apply":
        return apply()
    if cmd == "get":
        path, mode = current()
        print("%s\n%s" % (path, mode))
        return 0
    if cmd == "set" and len(argv) > 2:
        src = os.path.abspath(os.path.expanduser(argv[2]))
        if not os.path.isfile(src):
            print(tr("File not found: {path}").format(path=src), file=sys.stderr)
            return 1
        os.makedirs(CFG, exist_ok=True)
        if src.startswith(OFFICIAL_WALLPAPERS):
            # official wallpaper: part of the system, no need to copy it
            dest = src
        else:
            # copy into the ZETA RAYS folder: the wallpaper stays even if the original disappears
            dest = os.path.join(CFG, "wallpaper-choice" + os.path.splitext(src)[1].lower())
            try:
                if os.path.abspath(src) != os.path.abspath(dest):
                    shutil.copyfile(src, dest)
            except OSError as e:
                print(tr("Could not copy the image: {error}").format(error=e), file=sys.stderr)
                return 1
        d["path"] = dest
        d["name"] = os.path.basename(src)
        if len(argv) > 3 and argv[3] in MODES:
            d["mode"] = argv[3]
        save(d)
        return apply()
    if cmd == "mode" and len(argv) > 2:
        if argv[2] not in MODES:
            print(tr("Invalid mode. Use: {modes}").format(modes=", ".join(MODES)), file=sys.stderr)
            return 1
        d["mode"] = argv[2]
        save(d)
        return apply()
    if cmd == "reset":
        d.pop("path", None)
        d.pop("name", None)
        save(d)
        return apply()
    print(tr("""zeta-wallpaper — ZETA RAYS desktop wallpaper.

  zeta-wallpaper apply                apply the saved wallpaper (at session start)
  zeta-wallpaper set <file> [mode]    use an image chosen by the user
  zeta-wallpaper mode <mode>          change only how the image is fitted
  zeta-wallpaper reset                go back to the ZETA RAYS wallpaper generated from the accent color
  zeta-wallpaper get                  print the current choice (path and mode)

Modes (as in swaybg): fill, fit, center, tile, stretch.
The choice is saved in ~/.config/zeta/wallpaper.json and survives a restart.
"""))
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))

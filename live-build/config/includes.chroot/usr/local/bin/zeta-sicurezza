        ("ffuf", "ffuf", tr("Fuzzing of web paths and parameters"), CLI, "ffuf", None),
        ("gobuster", "gobuster", tr("Directory and DNS brute forcing"), CLI, "gobuster", None),
        ("whatweb", "WhatWeb", tr("Identifies the technologies behind a website"), CLI, "whatweb", None),
        ("wfuzz", "wfuzz", tr("Web application fuzzer"), CLI, "wfuzz", None),
    ],
    tr("Passwords and authentication"): [
        ("john", "John the Ripper", tr("Password recovery (offline)"), CLI, "john", None),
        ("hashcat", "hashcat", tr("Hash cracking on GPU/CPU"), CLI, "hashcat", None),
        ("hydra", "Hydra", tr("Credential testing against network services"), CLI, "hydra", None),
        ("medusa", "Medusa", tr("Parallel login brute forcing"), CLI, "medusa", None),
    ],
    tr("Wireless"): [
        ("aircrack-ng", "Aircrack-ng", tr("Wi-Fi network analysis and testing"), CLI, "aircrack-ng", None),
        ("reaver", "Reaver", tr("WPS testing on routers"), CLI, "reaver", None),
    ],
    tr("Sniffing and spoofing"): [
        ("bettercap", "bettercap", tr("Network attacks and analysis (MITM)"), CLI, "bettercap", None),
        ("ettercap", "Ettercap", tr("Sniffing and MITM (graphical)"), GUI, "ettercap-graphical", "ettercap -G"),

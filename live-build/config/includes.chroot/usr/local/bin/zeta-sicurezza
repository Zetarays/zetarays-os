    "Password e autenticazione": [
        ("john", "John the Ripper", "Recupero di password (offline)", CLI, "john", None),
        ("hashcat", "hashcat", "Cracking di hash su GPU/CPU", CLI, "hashcat", None),
        ("hydra", "Hydra", "Test di credenziali sui servizi di rete", CLI, "hydra", None),

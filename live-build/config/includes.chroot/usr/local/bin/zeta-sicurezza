"""ZETA RAYS Security — centro di sicurezza e strumenti (GTK4 + libadwaita).

Mostra lo stato reale del sistema (firewall, cifratura, aggiornamenti, ecc.) e
un catalogo di strumenti di sicurezza organizzati per categoria. Gli strumenti
NON sono un elenco decorativo: ognuno si può avviare davvero.

  • strumenti grafici  → si aprono nella loro finestra
  • strumenti a riga di comando → si aprono nel terminale, con l'aiuto in vista
  • strumenti non installati → si installano con un clic (apt, con autenticazione),
    ma solo se apt li conosce davvero: altrimenti si spiega perche' mancano

Nulla viene mai eseguito su bersagli senza che sia l'utente a chiederlo: ZETA RAYS
apre lo strumento, l'uso resta responsabilità di chi lo lancia.
"""
import shlex
import shutil
import subprocess
import sys
import threading

sys.path.insert(0, "/usr/lib/zeta")
from ui import tema  # noqa: E402

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

from security import audit  # noqa: E402
from system import pacchetti  # noqa: E402

STATE_STYLE = {
    audit.ACTIVE:         ("#3DDC97", "success"),
    audit.CONFIGURED:     ("#3A8DFF", "accent"),
    audit.NOT_CONFIGURED: ("#8A8A8E", "dim"),
    audit.WARNING:        ("#FFB547", "warning"),
}

GUI, CLI = "gui", "cli"


# Catalogo strumenti. Ogni voce:
#   (comando_da_verificare, "Nome", "descrizione", tipo, pacchetto_apt, comando_di_avvio)
# comando_di_avvio None = usa il comando_da_verificare.
TOOLKIT = {
    "Ricognizione": [
        ("nmap", "Nmap", "Scansione di rete e delle porte", CLI, "nmap", None),

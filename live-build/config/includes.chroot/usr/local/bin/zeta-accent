#!/bin/bash
# shellcheck disable=SC2059  # the printf formats come from the translations (gettext)
# SPDX-License-Identifier: GPL-3.0-or-later
# zeta-accent [#RRGGBB]
# Sets the ZETA RAYS accent color and applies it to the whole interface:
# window borders, bar, launcher, notifications, terminal, GTK apps and wallpaper.
# The launcher (zeta-launcher) reads ~/.config/zeta/colors.css every time it opens.
set -e
export TEXTDOMAIN=zetarays TEXTDOMAINDIR=/usr/share/locale
command -v gettext >/dev/null 2>&1 || gettext() { printf '%s' "$1"; }

CFG="$HOME/.config/zeta"
SHARE=/usr/share/zeta
mkdir -p "$CFG"

if [ -n "$1" ]; then
  if [[ ! "$1" =~ ^#?[0-9A-Fa-f]{6}$ ]]; then
    printf "$(gettext 'Invalid color: %s (use the #RRGGBB format)')\n" "$1" >&2
    exit 1
  fi
  hex="${1#\#}"
  echo "#${hex^^}" > "$CFG/accent"
fi

# An account picture that follows the accent (the default circle) changes
# color with it; a photo or a deliberately chosen color stays (avatar.py).
if [ -n "$1" ]; then
  ( /usr/bin/python3 -c 'import sys; sys.path.insert(0, "/usr/lib/zeta"); from system import avatar; avatar.follow_accent()' >/dev/null 2>&1 & )
fi

CHOSEN=$(cat "$CFG/accent" 2>/dev/null || echo "#3A8DFF")

# --- Light or dark theme (chosen in Settings > Appearance) ---
THEME=$(cat "$CFG/theme" 2>/dev/null || echo dark)

# --- The chosen color, made visible on the theme background ---
# The color the user picks is used everywhere: window border, workspace pill,
# bar symbol, wallpaper, notification border, terminal. Taken literally,
# though, white disappears on a light theme — and so does a very dark color
# on the dark theme. Here the chosen hue is kept and only the luminance is
# shifted until it is visible: the user's choice stays as it is (in the
# «accent» file), only the way it is drawn changes.
scale_luminance() {
    local hex="${1#\#}" limit="$2" direction="$3"
    local r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
    local L=$(( (299 * r + 587 * g + 114 * b) / 1000 ))
    [ "$L" -eq 0 ] && L=1
    if { [ "$direction" = up ] && [ "$L" -ge "$limit" ]; } ||
       { [ "$direction" = down ] && [ "$L" -le "$limit" ]; }; then
        printf "#%s" "${hex^^}"; return
    fi
    # same hue, luminance moved to the limit (grays stay gray)
    local k=$(( limit * 1000 / L ))
    local nr=$(( r * k / 1000 )) ng=$(( g * k / 1000 )) nb=$(( b * k / 1000 ))
    [ $nr -gt 255 ] && nr=255; [ $ng -gt 255 ] && ng=255; [ $nb -gt 255 ] && nb=255
    printf "#%02X%02X%02X" "$nr" "$ng" "$nb"
}

if [ "$THEME" = "light" ]; then
    # above this luminance the color gets lost on the light background
    ACCENT=$(scale_luminance "$CHOSEN" 120 down)
else
    # below this luminance the color gets lost on black
    ACCENT=$(scale_luminance "$CHOSEN" 70 up)
fi

H="${ACCENT#\#}"
r=$((16#${H:0:2})); g=$((16#${H:2:2})); b=$((16#${H:4:2}))
# The color as it is actually drawn: read by the shell and by anything else
# that needs to paint something without redoing the contrast calculation.
# «accent» stays the user's choice, which must never be rewritten.
echo "$ACCENT" > "$CFG/accent-rendered"
if [ $(( (299 * r + 587 * g + 114 * b) / 1000 )) -gt 140 ]; then INK="#000000"; else INK="#FFFFFF"; fi
if [ "$THEME" = "light" ]; then
  SURFACE="rgba(255,255,255,0.96)"; SURFACE2="rgba(0,0,0,0.045)"
  INKC="#1C1C1E";  INK2="#48484C"; INKDIM="#6E6E73"; LINE="rgba(0,0,0,0.12)"
  HOVER="rgba(0,0,0,0.06)"; HOVER2="rgba(0,0,0,0.11)"
  GLASS="rgba(250,250,252,0.82)"; SCRIM="rgba(255,255,255,0.45)"
  SCRIM2="rgba(246,246,248,0.80)"
  GTK_WINDOW="#F6F6F8"; GTK_VIEW="#FFFFFF"; GTK_CARD="#FFFFFF"; GTK_SIDEBAR="#EFEFF2"
  PREFER_DARK=0; SCHEME="prefer-light"; WALL_BG="#F2F2F5"; BAR_INK="#5A5A5F"
else
  SURFACE="rgba(18,18,20,0.94)"; SURFACE2="rgba(255,255,255,0.04)"
  INKC="#EDEDEA";  INK2="#C8C8CC"; INKDIM="#8A8A8E"; LINE="rgba(255,255,255,0.08)"
  HOVER="rgba(255,255,255,0.07)"; HOVER2="rgba(255,255,255,0.14)"
  GLASS="rgba(18,18,20,0.78)"; SCRIM="rgba(0,0,0,0.45)"
  SCRIM2="rgba(0,0,0,0.74)"
  GTK_WINDOW="#111113"; GTK_VIEW="#0C0C0E"; GTK_CARD="#161618"; GTK_SIDEBAR="#0E0E10"
  PREFER_DARK=1; SCHEME="prefer-dark"; WALL_BG="#000000"; BAR_INK="#A1A1A6"
fi

# --- Shared colors (GTK CSS) ---
COLORS="/* Generated by zeta-accent */
@define-color accent $ACCENT;
@define-color accent_ink $INK;
@define-color accent_soft rgba($r,$g,$b,0.14);
@define-color accent_line rgba($r,$g,$b,0.35);
@define-color surface $SURFACE;
@define-color surface_2 $SURFACE2;
@define-color ink $INKC;
@define-color ink_2 $INK2;
@define-color ink_dim $INKDIM;
@define-color line $LINE;
@define-color hover $HOVER;
@define-color hover_2 $HOVER2;
@define-color glass $GLASS;
@define-color scrim $SCRIM;
@define-color scrim_strong $SCRIM2;"
mkdir -p ~/.config/waybar ~/.config/gtk-3.0 ~/.config/gtk-4.0 ~/.config/hypr
for d in "$CFG" ~/.config/waybar; do
  printf '%s\n' "$COLORS" > "$d/colors.css"
done

# --- GTK4 / libadwaita apps ---
# Every background redefined here MUST have the text color next to it.
# When only the backgrounds were redefined and libadwaita stayed in light
# mode, the text remained black on a dark background: the calculator and the
# other GTK4 apps became unreadable. Background and text always go in pairs.
# A single palette, the desktop theme's: GTK 4.18 does not apply
# «@media (prefers-color-scheme)» in the user's gtk.css (tested), so no app
# must force a different mode (the text editor only changes its text color
# scheme, see zeta-appearance apply_editor).
cat > ~/.config/gtk-4.0/gtk.css <<EOF
/* Generated by zeta-accent */
@define-color accent_color $ACCENT;
@define-color accent_bg_color $ACCENT;
@define-color accent_fg_color $INK;
@define-color window_bg_color $GTK_WINDOW;
@define-color window_fg_color $INKC;
@define-color view_bg_color $GTK_VIEW;
@define-color view_fg_color $INKC;
@define-color headerbar_bg_color $GTK_WINDOW;
@define-color headerbar_fg_color $INKC;
@define-color headerbar_backdrop_color $GTK_WINDOW;
@define-color sidebar_bg_color $GTK_SIDEBAR;
@define-color sidebar_fg_color $INKC;
@define-color sidebar_backdrop_color $GTK_SIDEBAR;
@define-color card_bg_color $GTK_CARD;
@define-color card_fg_color $INKC;
@define-color popover_bg_color $GTK_CARD;
@define-color popover_fg_color $INKC;
@define-color dialog_bg_color $GTK_WINDOW;
@define-color dialog_fg_color $INKC;
/* secondary and disabled text, consistent with the theme */
@define-color dimmed_fg_color $INKDIM;
@define-color disabled_fg_color $INKDIM;
EOF

# --- GTK3 apps ---
# As with GTK4: every background must come with its text color, otherwise
# the text stays the light theme's on dark backgrounds.
cat > ~/.config/gtk-3.0/gtk.css <<EOF
/* Generated by zeta-accent */
@define-color theme_selected_bg_color $ACCENT;
@define-color theme_selected_fg_color $INK;
@define-color theme_bg_color $GTK_WINDOW;
@define-color theme_fg_color $INKC;
@define-color theme_base_color $GTK_VIEW;
@define-color theme_text_color $INKC;
@define-color insensitive_fg_color $INKDIM;
@define-color accent_bg_color $ACCENT;
/* File manager (Thunar) icon view: a little more room between icons, so
   names on two or three lines stay readable (defaults: 6 and 6 pixels).
   These are GTK3 style properties of ThunarAbstractIconView; a selector by
   its type name does not match (tested), its CSS node is "scrolledwindow".
   Other widgets do not have these properties and ignore them. */
scrolledwindow { -ThunarAbstractIconView-column-spacing: 12; -ThunarAbstractIconView-row-spacing: 16; }
EOF

# --- System GTK theme (non-ZETA RAYS apps: file manager, editor, Packages...) ---
# The theme name is ALWAYS "Adwaita": "Adwaita-dark" only exists for GTK4; it
# does not exist in GTK3 and the library would fall back to the light theme
# (that is why the file manager stayed white). Dark mode is chosen with
# gtk-application-prefer-dark-theme, which GTK3 reads from settings.ini.
for d in "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"; do
  mkdir -p "$d"
  # gtk-application-prefer-dark-theme only applies to GTK3: in GTK4 apps with
  # libadwaita it is ignored and triggers a warning, so it is not written there.
  DARK_PREF=""
  [ "$d" = "$HOME/.config/gtk-3.0" ] && DARK_PREF="gtk-application-prefer-dark-theme=$PREFER_DARK"
  cat > "$d/settings.ini" <<EOF
[Settings]
$DARK_PREF
gtk-theme-name=Adwaita
gtk-icon-theme-name=zeta
gtk-font-name=Roboto $(cat "$CFG/font-size" 2>/dev/null || echo 10)
gtk-cursor-theme-name=Adwaita
gtk-cursor-theme-size=$(cat "$CFG/cursor-size" 2>/dev/null || echo 24)
gtk-decoration-layout=:
gtk-enable-animations=$(cat "$CFG/animations" 2>/dev/null || echo 1)
EOF
done

if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface color-scheme "$SCHEME" 2>/dev/null || true
  gsettings set org.gnome.desktop.interface gtk-theme "Adwaita" 2>/dev/null || true
  gsettings set org.gnome.desktop.interface cursor-theme "Adwaita" 2>/dev/null || true
  gsettings set org.gnome.desktop.interface enable-animations \
      "$([ "$(cat "$CFG/animations" 2>/dev/null || echo 1)" = 0 ] && echo false || echo true)" 2>/dev/null || true
fi
# --- Hyprland ---
echo "return { accent = \"rgb($H)\" }" > ~/.config/hypr/zeta_colors.lua

# --- Bar icons recolored for the theme ---
# They are SVG files: Waybar does not recolor them, so we keep a copy with the
# right color. Without this, in the light theme they would vanish on the light
# background. They are regenerated only if something changes (colors, theme or
# system icons after an update): previously they were all rewritten at every
# login, more than 170 processes before the bar appeared.
USER_ICONS="$HOME/.local/share/icons/zeta"
RECOLORED="$USER_ICONS/scalable/theme"
STAMP="$BAR_INK $INKC $INKDIM $(stat -c %Y "$SHARE/status" /usr/share/icons/zeta/scalable/apps 2>/dev/null | tr '\n' ' ')"
ICONS_READY=0
if [ "$(cat "$CFG/.icons-stamp" 2>/dev/null)" = "$STAMP" ] && [ -f "$USER_ICONS/index.theme" ] \
   && ls "$CFG/bar/"*.svg >/dev/null 2>&1; then
  ICONS_READY=1
fi
mkdir -p "$CFG/bar"
[ "$ICONS_READY" = 1 ] || for f in "$SHARE"/status/*.svg; do
  [ -f "$f" ] || continue
  sed -e "s/#A1A1A6/$BAR_INK/g" -e "s/#EDEDEA/$BAR_INK/g" "$f" > "$CFG/bar/$(basename "$f")"
done

# --- Panel icons recolored for the theme ---
# Application icons have their own dark tile and are readable on any
# background. Outline-only icons (the buttons inside the control center, the
# power menu, Settings) are not: they are a fixed light gray and on the light
# theme they vanished on white. A recolored copy is kept in
# ~/.local/share/icons, which GTK checks before /usr/share.
# The copies live in their own folder, «scalable/theme», listed BEFORE
# «scalable/apps»: with the same folder name GTK still preferred the system
# copy and the recoloring did not show.
if [ "$ICONS_READY" != 1 ]; then
mkdir -p "$RECOLORED"
rm -f "$RECOLORED"/*.svg
cat > "$USER_ICONS/index.theme" <<'EOF'
[Icon Theme]
Name=ZETA RAYS
Comment=ZETA RAYS icons (generated by zeta-accent: do not edit by hand)
Inherits=Adwaita,hicolor
Directories=scalable/theme,scalable/apps,scalable/emblems

[scalable/theme]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/emblems]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Emblems
EOF
for f in /usr/share/icons/zeta/scalable/apps/*.svg; do
  [ -f "$f" ] || continue
  grep -q "#19191C" "$f" && continue      # already has the dark tile: fine as is
  # fixed colors (the ZETA symbol of Synaptic): no ink to change
  grep -q -e "#EDEDEA" -e "#A1A1A6" "$f" || continue
  sed -e "s/#EDEDEA/$INKC/g" -e "s/#A1A1A6/$INKDIM/g" "$f" > "$RECOLORED/$(basename "$f")"
done
echo "$STAMP" > "$CFG/.icons-stamp"
fi

# --- Launcher symbol and wallpaper ---
sed "s/ACCENT/$ACCENT/g" "$SHARE/brand/zeta-symbol.svg.in" > "$CFG/launcher.svg" 2>/dev/null || true
if [ "$(cat "$CFG/.wallpaper-accent" 2>/dev/null)" != "$ACCENT-$THEME" ] || [ ! -f "$CFG/wallpaper.png" ]; then
  sed -e "s/ACCENT/$ACCENT/g" -e "s/BGCOLOR/$WALL_BG/g" "$SHARE/brand/zeta-wallpaper.svg.in" > "$CFG/wallpaper.svg"
  # non-fatal: without the generated wallpaper the rest of the theme must still apply
  if rsvg-convert -o "$CFG/wallpaper.png" "$CFG/wallpaper.svg" 2>/dev/null; then
    echo "$ACCENT-$THEME" > "$CFG/.wallpaper-accent"
  fi
fi

# --- Notifications and terminal ---
[ -f ~/.config/mako/config ] && sed -i "s/^border-color=.*/border-color=$ACCENT/" ~/.config/mako/config
# the terminal config is regenerated from the chosen theme's template (generated
# file: do not edit it by hand, changes would be lost on a color/theme change)
FOOT_TPL="$SHARE/terminal/$([ "$THEME" = light ] && echo light || echo dark).ini.in"
MONO_SIZE=$(cat "$CFG/font-size" 2>/dev/null || echo 10)
case "$MONO_SIZE" in ''|*[!0-9]*) MONO_SIZE=10 ;; esac
if [ -f "$FOOT_TPL" ]; then
  mkdir -p ~/.config/foot
  sed -e "s/ACCENT/$H/g" -e "s/FONTSIZE/$MONO_SIZE/g" "$FOOT_TPL" > ~/.config/foot/foot.ini.new &&
    mv ~/.config/foot/foot.ini.new ~/.config/foot/foot.ini
fi
# prompt, tmux tabs and the chosen terminal theme follow the new accent
command -v zeta-shell >/dev/null && zeta-shell apply >/dev/null 2>&1

# --- fastfetch logo ---
# The ZETA RAYS symbol in the terminal is printed in white: it is the logo, and
# on the ZETA RAYS black that is how it must look. On the light theme white
# would vanish, so the dark ink is used there. The drawing never changes: only
# the color fastfetch prints it with does.
if [ "$THEME" = light ]; then
  LOGOCOLOR="38;2;28;28;30"
else
  LOGOCOLOR="38;2;255;255;255"
fi
# Labels and title, instead, follow the accent color, like everything else.
ACCENTCOLOR="38;2;$r;$g;$b"
mkdir -p ~/.config/fastfetch
# Labels in the user's language, aligned to the longest one (the templates
# have @K_...@ placeholders; /etc/fastfetch stays in English).
FF_KEYS=(OS KERNEL UPTIME PACKAGES SHELL TERMINAL WM CPU GPU MEMORY DISK IP LOCALE)
FF_LABELS=("$(gettext "System")" "Kernel" "$(gettext "Uptime")" "$(gettext "Packages")" "Shell"
          "$(gettext "Terminal")" "$(gettext "Environment")" "CPU" "GPU" "$(gettext "Memory")"
          "$(gettext "Disk")" "IP" "$(gettext "Language")")
FF_WIDTH=9
for t in "${FF_LABELS[@]}"; do if [ "${#t}" -gt "$FF_WIDTH" ]; then FF_WIDTH=${#t}; fi; done
FF_SED=()
for i in "${!FF_KEYS[@]}"; do
  t=${FF_LABELS[$i]}
  while [ "${#t}" -lt "$FF_WIDTH" ]; do t="$t "; done
  t=${t//\\/\\\\}; t=${t//\"/\\\"}           # JSON
  t=${t//\\/\\\\}; t=${t//&/\\&}; t=${t//|/\\|}    # sed
  FF_SED+=(-e "s|@K_${FF_KEYS[$i]}@|$t|")
done
for n in config compact tiny; do
  TPL="$SHARE/fastfetch/$n.jsonc.in"
  [ -f "$TPL" ] || continue
  sed -e "s/LOGOCOLOR/$LOGOCOLOR/" -e "s/ACCENTCOLOR/$ACCENTCOLOR/g" "${FF_SED[@]}" "$TPL" \
      > ~/.config/fastfetch/$n.jsonc.new &&
    mv ~/.config/fastfetch/$n.jsonc.new ~/.config/fastfetch/$n.jsonc
done

# --- Apply immediately if the session is running ---
if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
  # ONLY the values that depend on color and theme are updated, one by one.
  # A full «hyprctl reload» would re-read the whole configuration and, in
  # doing so, remove the title bar from every window already open: the user
  # would be left without the close/minimize/maximize buttons until every
  # program was reopened. With «eval» the windows stay intact.
  if [ "$THEME" = light ]; then
    INACTIVE_BORDER="rgba(00000018)"; TITLEBAR="rgba(F2F2F4F2)"; TITLEBAR_TEXT="rgb(1C1C1E)"
  else
    INACTIVE_BORDER="rgba(ffffff14)"; TITLEBAR="rgba(1C1C1EF2)"; TITLEBAR_TEXT="rgb(EDEDEA)"
  fi
  CORNERS=$(cat "$CFG/corners" 2>/dev/null || echo 14)
  case "$CORNERS" in ''|*[!0-9]*) CORNERS=14 ;; esac
  [ "$(cat "$CFG/animations" 2>/dev/null || echo 1)" = "0" ] && ANIM=false || ANIM=true
  [ "$(cat "$CFG/transparency" 2>/dev/null || echo 1)" = "0" ] && BLUR=false || BLUR=true

  hyprctl eval "hl.config({
      general = { col = { active_border = \"rgb($H)\", inactive_border = \"$INACTIVE_BORDER\" } },
      decoration = { rounding = $CORNERS,
                     blur = { enabled = $BLUR }, shadow = { enabled = $BLUR } },
      animations = { enabled = $ANIM },
  })" >/dev/null 2>&1 || true
  hyprctl eval "if hl.plugin.hyprbars then hl.config({ plugin = { hyprbars = {
      bar_color = \"$TITLEBAR\", col = { text = \"$TITLEBAR_TEXT\" } } } }) end" >/dev/null 2>&1 || true
  # respect the wallpaper chosen by the user, if any
  zeta-wallpaper apply >/dev/null 2>&1 || {
    pkill -x swaybg 2>/dev/null || true
    setsid swaybg -m fill -i "$CFG/wallpaper.png" >/dev/null 2>&1 &
  }
  # A single bar reload, and only after Hyprland is done: Waybar
  # reinitializes the workspaces module when Hyprland reloads, and a second
  # reload at that moment makes it crash.
  # With ZETA_NO_BAR_RELOAD=1 the caller (zeta-appearance) does the reload.
  # At login the bar is not there yet: no waiting (one second less before
  # the desktop appears).
  if [ -z "${ZETA_NO_BAR_RELOAD:-}" ] || pgrep -x -u "$(id -u)" waybar >/dev/null 2>&1; then
    sleep 1
  fi
  # the bar is reloaded only through zeta-bar: one at a time, then it checks
# that only one is left (reloads close together used to duplicate it)
[ -n "${ZETA_NO_BAR_RELOAD:-}" ] || { setsid zeta-bar reload >/dev/null 2>&1 </dev/null & } 
  # Only if notifications are already running: otherwise makoctl would start
  # mako via D-Bus, outside zeta-session's supervision, and the supervised one
  # would find the slot taken and retry forever.
  if pgrep -x -u "$(id -u)" mako >/dev/null 2>&1; then
    makoctl reload 2>/dev/null || true
  fi
fi

#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS — schermi.

  zeta-schermi              apre Impostazioni › Schermi
  zeta-schermi identifica   mostra per tre secondi, su ogni schermo, il suo
                            numero e il suo nome (come nelle Impostazioni)
  zeta-schermi elenco       stato degli schermi (anche quelli spenti)
  zeta-schermi recupera     tutte le finestre dentro gli schermi accesi

La logica sta in /usr/lib/zeta/system/schermi.py.
"""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr  # noqa: E402
from system import schermi  # noqa: E402


def elenco():
    for i, m in enumerate(schermi.leggi(), 1):
        stato = tr("on") if m["acceso"] else tr("off")
        if m["specchio"]:
            stato = tr("mirror of {name}").format(name=m["specchio"])
        print("%d  %-10s %-34s %dx%d@%.2f  %s  %s %g  (%d, %d)" % (
            i, m["nome"], m["identita"][:34], m["larghezza"], m["altezza"], m["frequenza"],
            stato, tr("scale"), m["scala"], m["x"], m["y"]))
    return 0


def identifica():
    from ui import popup
    popup.preload_layer_shell()
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, GLib, Gtk
    try:
        gi.require_version("Gtk4LayerShell", "1.0")
        from gi.repository import Gtk4LayerShell as LS
    except (ValueError, ImportError):
        LS = None

    numeri = {m["nome"]: (i, m) for i, m in enumerate(schermi.leggi(), 1)}

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="org.zetarays.IdentificaSchermi")

        def do_startup(self):
            Gtk.Application.do_startup(self)
            popup.clean_env()
            popup.load_css("""
.id-schermo { background: rgba(12, 12, 14, 0.92); border-radius: 22px; padding: 26px 40px;
              border: 1px solid rgba(255, 255, 255, 0.10); }
.id-numero { font-size: 96px; font-weight: 300; color: @accent; }
.id-nome { font-size: 15px; color: #EDEDEA; }
.id-dett { font-size: 12px; color: #8A8A8E; }
""")

        def do_activate(self):
            if self.get_windows():
                return
            elenco_gdk = Gdk.Display.get_default().get_monitors()
            for k in range(elenco_gdk.get_n_items()):
                gm = elenco_gdk.get_item(k)
                nome = gm.get_connector() or ""
                i, m = numeri.get(nome, (k + 1, None))
                w = Gtk.Window(application=self, decorated=False)
                if LS and LS.is_supported():
                    LS.init_for_window(w)
                    LS.set_namespace(w, "zeta-identifica")
                    LS.set_layer(w, LS.Layer.OVERLAY)
                    LS.set_keyboard_mode(w, LS.KeyboardMode.NONE)
                    LS.set_monitor(w, gm)
                w.add_css_class("zeta-overlay")
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                              css_classes=["id-schermo"])
                box.append(Gtk.Label(label=str(i), css_classes=["id-numero"]))
                titolo = (m and m["identita"]) or nome
                box.append(Gtk.Label(label=titolo, css_classes=["id-nome"]))
                if m:
                    box.append(Gtk.Label(label="%s · %d × %d" % (nome, m["larghezza"], m["altezza"]),
                                         css_classes=["id-dett"]))
                w.set_child(box)
                w.present()
            GLib.timeout_add(3000, lambda: (self.quit(), False)[1])

    return App().run([sys.argv[0]])


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd in ("identifica", "identify"):
        return identifica()
    if cmd in ("elenco", "list"):
        return elenco()
    if cmd in ("recupera", "recover"):
        return subprocess.call(["hyprctl", "eval", "zeta_recupera()"], stdout=subprocess.DEVNULL)
    if cmd == "":
        os.execvp("zeta-impostazioni", ["zeta-impostazioni", "schermi"])
    print(__doc__.strip())
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))

#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""zeta — ZETA, the intelligence of ZETA RAYS OS (command line).

Usage:
  zeta                      start an interactive conversation
  zeta <question>           a single question
  zeta --status             the local model and its state
  zeta --memories           what you asked ZETA to remember
  zeta --remember TEXT      add a long-term memory
  zeta --forget             clear the conversation memory
  zeta --forget-all         clear the conversation and the long-term memories
  zeta --learn FILE         give ZETA a text file as reference (local)
  zeta summarize FILE       a summary of a text, PDF, Word or LibreOffice file
  zeta -- <question>        a question that starts like a command below

System commands (read only):
  zeta system · memory · processes · repositories · diagnose
  zeta ai status · ai test · shell status

ZETA answers only with the model on this computer. It performs system
actions through a closed list of capabilities; actions that modify the
system ask for confirmation.
"""
import sys

sys.path.insert(0, "/usr/lib/zeta")

from i18n import speaking, tr  # noqa: E402
from i18n_data import load  # noqa: E402
from intelligence.actions import ActionResult  # noqa: E402
from intelligence.assistant import Assistant  # noqa: E402
from intelligence.memory import Memory  # noqa: E402
from intelligence.registry import Registry  # noqa: E402

ACCENT = "\033[38;2;58;141;255m"
DIM = "\033[38;2;140;140;145m"
BOLD = "\033[1m"
R = "\033[0m"

# The answers accepted in Italian and English ("yes", "always", "exit"):
# language data in zeta.json (see /usr/lib/zeta/i18n_data.py)
ANSWERS = load("zeta")


def _confirm(res: ActionResult) -> bool:
    print("\n%s╭─ %s%s" % (ACCENT, tr("ACTION REQUESTED"), R))
    print("%s│%s %s" % (ACCENT, R, tr("Command:  {command}").format(command=res.preview)))
    print("%s│%s %s" % (ACCENT, R, tr("Impact:   {impact}").format(impact=res.impact)))
    print("%s╰─%s" % (ACCENT, R))
    try:
        ans = input("  " + tr("Allow? [y/N] ")).strip().lower()
    except (EOFError, KeyboardInterrupt):
        return False
    return ans in ANSWERS["yes"]


def _consent(services: list) -> str | None:
    """«Search the web?» (asked once): "yes", "always", "no"; None when
    nobody can answer (not a terminal)."""
    if not sys.stdin.isatty():
        return None
    print("%s%s%s" % (DIM, tr("Search the web? This sends your question to {services}.").format(
        services=", ".join(services)), R))
    try:
        ans = input("  " + tr("[y]es, [a]lways, [n]o: ")).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    if ans in ANSWERS["always"]:
        return "always"
    if ans in ANSWERS["yes"]:
        return "yes"
    return "no" if ans in ("n", "no") else None


def _ask(assistant: Assistant, text: str) -> str:
    """One question; Ctrl+C stops it (the connection is closed) and leaves
    no half turn in the conversation."""
    kept = len(assistant.history)
    try:
        answer = assistant.respond(text, confirm=_confirm, consent=_consent)
    except KeyboardInterrupt:
        assistant.cancel()
        del assistant.history[kept:]
        return tr("Request canceled.")
    turn = assistant.last_turn
    with speaking(turn.get("language")):
        return _with_notes(answer, turn)


def _with_notes(answer: str, turn: dict) -> str:
    """The answer followed by its sources (web, or the local reference)."""
    extra = []
    if turn.get("sources"):
        extra.append(tr("Sources (retrieved {date}):").format(date=turn["sources"][0].retrieved))
        extra += ["  [%d] %s  %s" % (i, s.title, s.url) for i, s in enumerate(turn["sources"], 1)]
    if turn.get("reference"):
        ref = turn["reference"]
        extra.append(tr("Local reference (verified {date}):").format(date=ref[0].retrieved))
        extra += ["  %s  %s" % (e.title.split(" | ")[0], e.url) for e in ref]
    if extra:
        answer += "\n%s%s%s" % (DIM, "\n".join(extra), R)
    return answer


def cmd_status() -> int:
    print("%s%s%s\n" % (BOLD, tr("ZETA RAYS Intelligence: the local model"), R))
    for row in Registry().status():
        mark = "%s●%s" % (ACCENT, R) if row["ready"] else "%s○%s" % (DIM, R)
        state = tr("ready") if row["ready"] else tr("not ready")
        print("  %s %s %s%s%s  %s" % (mark, row["label"], DIM, state, R,
                                     tr("model: {model}").format(model=row["model"])))
        if row.get("local_models"):
            print("    %s" % tr("installed: {models}").format(models=", ".join(row["local_models"])))
        print("    %s" % tr("profile: {profile} · address: {address}").format(
            profile=row["profile"], address=row["endpoint"]))
    print("\n%s%s%s" % (DIM, tr("Nothing is sent to online AI services. For details: zeta ai status · zeta ai test"), R))
    return 0


def cmd_memories() -> int:
    facts = Memory().facts()
    if not facts:
        print(tr("No long-term memories. Add one with: zeta --remember TEXT"))
        return 0
    for f in facts:
        print("  • %s" % f.text)
    return 0


def cmd_learn(path: str) -> int:
    """A text file the user chose, indexed in the local store as reference."""
    import os
    from intelligence import store
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read(4 * 1024 * 1024)
    except OSError as e:
        print(tr("Can't read {path}: {error}").format(path=path, error=e.strerror or e))
        return 1
    n = store.import_document(os.path.basename(path), text, os.path.abspath(path))
    print(tr("Learned {path}: {n} passages, kept on this computer.").format(path=path, n=n))
    return 0


def interactive(assistant: Assistant) -> int:
    ai_ready = assistant.provider.available()
    tag = assistant.provider_label() if ai_ready else tr("local commands")
    print("%s%sZETA RAYS%s %s— %s%s" % (BOLD, ACCENT, R, DIM, tag, R))
    if ai_ready:
        print("%s%s%s\n" % (DIM, tr("Type your request. 'exit' to quit."), R))
    else:
        print("%s%s%s" % (DIM, tr("System commands available (e.g. “open documents”, “how much RAM”)."), R))
        print("%s%s%s\n" % (DIM, tr("For open questions, set up a model in Settings › AI. 'exit' to quit."), R))
    while True:
        try:
            text = input("%s› %s" % (ACCENT, R)).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not text:
            continue
        if text.lower() in ANSWERS["exit"]:
            break
        print("%s\n" % _ask(assistant, text))
    return 0


SYSTEM_WORDS = {"system", "status", "memory", "processes", "ps", "repositories",
                "repository", "repo", "ai", "shell", "diagnose"}


def summarize_request(path: str) -> str:
    """The request for a file summary (intelligence/reading.py understands
    it in English and in Italian)."""
    return tr("Summarize the file “{path}”").format(path=path)


def cmd_help() -> int:
    print(tr("""Usage:
  zeta                      start a conversation
  zeta QUESTION             ask one question
  zeta --status             the local model and its state
  zeta --memories           what you asked ZETA to remember
  zeta --remember TEXT      add a long-term memory
  zeta --forget             clear the conversation memory
  zeta --forget-all         also clear the long-term memories
  zeta --learn FILE         give ZETA a text file as reference
  zeta summarize FILE       summarize a text, PDF, Word or LibreOffice file
  zeta -- QUESTION          a question that starts like a command below

System commands (read only):
  zeta system | memory | processes | repositories | diagnose
  zeta ai status | ai test | shell status

ZETA answers only with the model on this computer. It performs system
actions through a closed list of capabilities; actions that change the
system ask for confirmation first."""))
    return 0


def main(argv: list[str]) -> int:
    args = argv[1:]
    if args and args[0] in ("-h", "--help"):
        return cmd_help()
    if args and args[0] == "--":
        args = args[1:]                  # everything else is a question
    elif args and args[0] in SYSTEM_WORDS:
        import os
        os.execvp("zeta-system", ["zeta-system"] + args)
    if args and args[0] == "--status":
        return cmd_status()
    if args and args[0] == "--forget":
        Memory().clear("conversation")
        print(tr("Conversation memory cleared."))
        return 0
    if args and args[0] == "--forget-all":
        Memory().clear("everything")
        print(tr("Conversation and long-term memories cleared."))
        return 0
    if args and args[0] == "--memories":
        return cmd_memories()
    if args and args[0] == "--remember" and len(args) >= 2:
        outcome, text = Memory().remember(" ".join(args[1:]))
        print(tr("I'll remember it: {text}").format(text=text) if outcome in ("added", "updated")
              else tr("I already remember it: {text}").format(text=text) if outcome == "duplicate"
              else tr("Not saved."))
        return 0
    if args and args[0] == "--learn" and len(args) == 2:
        return cmd_learn(args[1])
    if args and args[0] == "summarize" and len(args) >= 2:
        import os
        path = os.path.abspath(os.path.expanduser(" ".join(args[1:])))
        if os.path.isfile(path):
            # the same request as the file manager's «Ask ZETA to Summarize»
            args = [summarize_request(path)]

    assistant = Assistant()
    if args:
        print(_ask(assistant, " ".join(args)))
        return 0
    return interactive(assistant)


if __name__ == "__main__":
    sys.exit(main(sys.argv))

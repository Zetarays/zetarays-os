#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""zeta — ZETA, the intelligence of ZETA RAYS OS (command line).

Usage:
  zeta                      start an interactive conversation
  zeta <question>           a single question
  zeta --provider claude    force a provider for this session
  zeta --status             show the configured providers
  zeta --forget             clear the conversation memory
  zeta -- <question>        a question that starts like a command below

System commands (read only):
  zeta system · memory · processes · repositories · diagnose
  zeta ai status · ai test [service] · shell status

ZETA can perform system actions through a closed list of tools; actions
that modify the system ask for confirmation.
"""
import sys

sys.path.insert(0, "/usr/lib/zeta")

from i18n import speaking, tr  # noqa: E402
from i18n_data import load  # noqa: E402
from intelligence.actions import ActionResult  # noqa: E402
from intelligence.assistant import Assistant  # noqa: E402
from intelligence.memory import Memory  # noqa: E402
from intelligence.registry import CATALOG, Registry  # noqa: E402

ACCENT = "\033[38;2;58;141;255m"
DIM = "\033[38;2;140;140;145m"
BOLD = "\033[1m"
R = "\033[0m"

# The answers accepted in Italian and English ("yes", "always", "exit"):
# language data in zeta.json (see /usr/lib/zeta/i18n_data.py)
ANSWERS = load("zeta")


def _confirm(res: ActionResult) -> bool:
    print("\n%s╭─ %s%s" % (ACCENT, tr("ACTION REQUESTED"), R))
    print("%s│%s %s" % (ACCENT, R, tr("Command:  {command}").format(command=res.preview)))
    print("%s│%s %s" % (ACCENT, R, tr("Impact:   {impact}").format(impact=res.impact)))
    print("%s╰─%s" % (ACCENT, R))
    try:
        ans = input("  " + tr("Allow? [y/N] ")).strip().lower()
    except (EOFError, KeyboardInterrupt):
        return False
    return ans in ANSWERS["yes"]


def _consent(services: list) -> str | None:
    """«Search the web?» (asked once): "yes", "always", "no"; None when
    nobody can answer (not a terminal)."""
    if not sys.stdin.isatty():
        return None
    print("%s%s%s" % (DIM, tr("Search the web? This sends your question to {services}.").format(
        services=", ".join(services)), R))
    try:
        ans = input("  " + tr("[y]es, [a]lways, [n]o: ")).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    if ans in ANSWERS["always"]:
        return "always"
    if ans in ANSWERS["yes"]:
        return "yes"
    return "no" if ans in ("n", "no") else None


def _ask(assistant: Assistant, text: str) -> str:
    """One question; Ctrl+C stops it (the connection is closed) and leaves
    no half turn in the conversation."""
    kept = len(assistant.history)
    try:
        answer = assistant.respond(text, confirm=_confirm, consent=_consent)
    except KeyboardInterrupt:
        assistant.cancel()
        del assistant.history[kept:]
        return tr("Request canceled.")
    turn = assistant.last_turn
    with speaking(turn.get("language")):
        return _with_notes(answer, turn)


def _with_notes(answer: str, turn: dict) -> str:
    """The answer followed by its sources and the offer of another service."""
    extra = []
    if turn.get("sources"):
        extra.append(tr("Sources (retrieved {date}):").format(date=turn["sources"][0].retrieved))
        extra += ["  [%d] %s  %s" % (i, s.title, s.url) for i, s in enumerate(turn["sources"], 1)]
    if turn.get("offer"):
        extra.append(tr("To ask {name} this question: zeta --provider {id} QUESTION").format(
            name=CATALOG.get(turn["offer"], ("", turn["offer"]))[1], id=turn["offer"]))
    if extra:
        answer += "\n%s%s%s" % (DIM, "\n".join(extra), R)
    return answer


def cmd_status() -> int:
    reg = Registry()
    print("%s%s%s\n" % (BOLD, tr("ZETA RAYS Intelligence AI providers"), R))
    lines = reg.status()
    wide = max((len(r["label"]) for r in lines), default=9)
    for row in lines:
        mark = "%s●%s" % (ACCENT, R) if row["ready"] else "%s○%s" % (DIM, R)
        extra = ""
        if row["id"] == "ollama" and row.get("local_models"):
            extra = "  " + tr("models: {models}").format(models=", ".join(row["local_models"]))
        state = tr("ready") if row["ready"] else tr("not set up")
        print("  %s %s %s%s%s%s" % (mark, row["label"].ljust(wide), DIM, state, R, extra))
    print("\n%s%s%s" % (DIM, tr("Enter keys in Settings › AI (they are encrypted)."), R))
    print("%s%s%s" % (DIM, tr("For details: zeta ai status · zeta ai test"), R))
    return 0


def not_configured() -> int:
    """No model available: explain what to do instead of showing errors."""
    from intelligence.assistant import NOT_CONFIGURED
    print("%s%sZETA%s %s— ZETA RAYS OS%s\n" % (BOLD, ACCENT, R, DIM, R))
    import shutil
    import textwrap
    width = max(40, min(90, shutil.get_terminal_size((80, 24)).columns - 2))
    for par in NOT_CONFIGURED.split("\n"):
        print(textwrap.fill(par, width))
    print()
    try:
        ans = input("%s%s%s" % (DIM, tr("Press Enter to open Settings › AI, or type 'exit': "), R))
    except (EOFError, KeyboardInterrupt):
        return 0
    if ans.strip().lower() not in ANSWERS["exit"] + ["q"]:
        import subprocess
        subprocess.Popen(["zeta-settings", "ai"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


def interactive(assistant: Assistant) -> int:
    ai_ready = assistant.provider.available()
    tag = assistant.provider_label() if ai_ready else tr("local commands")
    print("%s%sZETA RAYS%s %s— %s%s" % (BOLD, ACCENT, R, DIM, tag, R))
    if ai_ready:
        print("%s%s%s\n" % (DIM, tr("Type your request. 'exit' to quit."), R))
    else:
        print("%s%s%s" % (DIM, tr("System commands available (e.g. “open documents”, “how much RAM”)."), R))
        print("%s%s%s\n" % (DIM, tr("For open questions, set up a model in Settings › AI. 'exit' to quit."), R))
    while True:
        try:
            text = input("%s› %s" % (ACCENT, R)).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not text:
            continue
        if text.lower() in ANSWERS["exit"]:
            break
        print("%s\n" % _ask(assistant, text))
    return 0


SYSTEM_WORDS = {"system", "status", "memory", "processes", "ps", "repositories",
                "repository", "repo", "ai", "shell", "diagnose"}


def cmd_help() -> int:
    print(tr("""Usage:
  zeta                      start a conversation
  zeta QUESTION             ask one question
  zeta --provider NAME      use one AI service for this session
                            (claude, gemini, openai, ollama...)
  zeta --status             the AI services and their state
  zeta --forget             clear the conversation memory
  zeta -- QUESTION          a question that starts like a command below

System commands (read only):
  zeta system | memory | processes | repositories | diagnose
  zeta ai status | ai test [service] | shell status

ZETA performs system actions through a closed list of tools; actions that
change the system ask for confirmation first."""))
    return 0


def main(argv: list[str]) -> int:
    args = argv[1:]
    if args and args[0] in ("-h", "--help"):
        return cmd_help()
    if args and args[0] == "--":
        args = args[1:]                  # everything else is a question
    elif args and args[0] in SYSTEM_WORDS:
        import os
        os.execvp("zeta-system", ["zeta-system"] + args)
    if args and args[0] == "--status":
        return cmd_status()
    if args and args[0] == "--forget":
        Memory().clear()
        print(tr("Conversation memory cleared."))
        return 0

    provider = None
    if args and args[0] in ("--provider", "-p") and len(args) >= 2:
        pid = args[1]
        if pid not in CATALOG:
            print(tr("Unknown provider: {name}").format(name=pid))
            return 1
        provider = Registry().get(pid)
        args = args[2:]

    assistant = Assistant(provider)
    if args:
        print(_ask(assistant, " ".join(args)))
        return 0
    return interactive(assistant)


if __name__ == "__main__":
    sys.exit(main(sys.argv))

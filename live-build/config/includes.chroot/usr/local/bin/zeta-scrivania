# formati del trascinamento che la scrivania sa usare, oltre ai file
MIME_URI = ("text/uri-list", "text/x-moz-url")
MIME_TESTO = ("text/plain;charset=utf-8", "text/plain", "UTF8_STRING")
MIME_IMMAGINI = ("image/png", "image/jpeg", "image/webp", "image/gif", "image/bmp",
                 "image/avif", "image/svg+xml")


_FIGLI = set()


def _avvia(cmd, **kw):
    """Avvia un programma e ne raccoglie l'uscita quando finisce: lanciato e
    dimenticato, «gio open» restava come processo zombie (visto)."""
    p = subprocess.Popen(cmd, **kw)
    from gi.repository import GLib as _G
    _FIGLI.add(p)                  # Python non lo raccoglie una seconda volta

    def finito(_pid, stato, proc=p):
        proc.returncode = stato
        _FIGLI.discard(proc)
    _G.child_watch_add(_G.PRIORITY_DEFAULT_IDLE, p.pid, finito)
    return p

popup.preload_layer_shell()


# --------------------------------------------------------------- preferenze
def pref(name, default):
    try:
        with open(os.path.join(CFG, name)) as f:
            return f.read().strip() or default
    except OSError:
        return default


def icone_attive():
    return pref("scrivania", "1") != "0"


def spaziatura():
    """Spazio fra le icone (Impostazioni › Aspetto)."""
    try:
        v = int(pref("spaziatura", "14"))
    except ValueError:
        return 14
    return v if 0 <= v <= 48 else 14


def icon_size():
    try:
        v = int(pref("icon-size", "42"))
    except ValueError:
        return 42
    return v if 28 <= v <= 64 else 42


def desktop_dir():
    # La cartella della scrivania nella lingua dell'utente (XDG_DESKTOP_DIR
    # in ~/.config/user-dirs.dirs: ~/Desktop, ~/Scrivania...), mai un nome
    # scritto qui. Se non e' configurata, quella standard: ~/Desktop.
    casa = os.path.expanduser("~")
    out = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DESKTOP) or ""
    if not out or os.path.abspath(out) == os.path.abspath(casa):
        out = os.path.join(casa, "Desktop")
    try:
        os.makedirs(out, exist_ok=True)
    except OSError:
        pass
    return out


def load_state():
    try:
        with open(STATE) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(d):
    try:
        os.makedirs(CFG, exist_ok=True)
        tmp = STATE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d, f, indent=2, ensure_ascii=False)
        os.replace(tmp, STATE)
    except OSError:
        pass


# ------------------------------------------------------------------ cestino
def trash_dir():
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(base, "Trash")


# Sopra i 40 MB non si genera l'anteprima: il tempo e la memoria non valgono
# il risultato, e resta l'icona del tipo di file.
ANTEPRIMA_MAX_BYTE = 40 * 1024 * 1024

ICONE_DIR = os.path.expanduser("~/.local/share/zeta/icone")
ICONE_MAX = 256       # lato massimo: un'icona più grande di così non si vede
# Riga con cui si ricorda l'icona originale di un collegamento, per poterla
# rimettere. Le chiavi X- sono l'unico posto consentito dalla specifica
# freedesktop per i valori propri di un programma.
CHIAVE_ORIGINALE = "X-ZETA-Icona-Originale"


def _icona_personale(sorgente, nome_base):
    """Copia l'immagine scelta in ~/.local/share/zeta/icone e ne dà il percorso.

    Si copia invece di puntare al file originale perché quello può essere in
    Scaricati, su una chiavetta o nel Cestino: spostarlo lascerebbe il
    collegamento senza icona. Le immagini grandi (una foto da 4000 pixel) vengono
    rimpicciolite: a 42 pixel non si vede la differenza, ma tenerle intere
    costa memoria a ogni disegno della scrivania. Gli SVG si copiano tali e
    quali, perché scalano da soli senza perdere nulla.
    """
    os.makedirs(ICONE_DIR, exist_ok=True)
    ext = os.path.splitext(sorgente)[1].lower()
    if nome_base.endswith(".desktop"):
        nome_base = nome_base[:-len(".desktop")]
    pulito = re.sub(r"[^A-Za-z0-9._-]", "_", nome_base) or "icona"
    if ext in (".svg", ".svgz"):
        dest = os.path.join(ICONE_DIR, pulito + ext)
        shutil.copyfile(sorgente, dest)
        return dest
    pix = GdkPixbuf.Pixbuf.new_from_file(sorgente)
    lato = max(pix.get_width(), pix.get_height())
    if lato > ICONE_MAX:
        k = ICONE_MAX / lato
        pix = pix.scale_simple(max(1, int(pix.get_width() * k)),
                               max(1, int(pix.get_height() * k)),
                               GdkPixbuf.InterpType.BILINEAR)
    dest = os.path.join(ICONE_DIR, pulito + ".png")
    pix.savev(dest, "png", [], [])
    return dest


def _desktop_scrivi_icona(percorso, icona):
    """Cambia Icon= in un file .desktop conservando tutto il resto.

    Si riscrive riga per riga invece di usare GKeyFile perché quello riordina
    e riscrive il file intero: un collegamento fatto a mano perderebbe commenti
    e righe che non conosce. Con icona=None si rimette quella originale.
    """
    with open(percorso, encoding="utf-8") as f:
        righe = f.read().split("\n")
    originale = None
    for r in righe:
        if r.startswith(CHIAVE_ORIGINALE + "="):
            originale = r.split("=", 1)[1]
    if icona is None:
        if originale is None:
            return False
        icona, originale = originale, None
    else:
        if originale is None:
            attuale = next((r.split("=", 1)[1] for r in righe
                            if r.startswith("Icon=")), "")
            originale = attuale
    nuove, visto_icona = [], False
    for r in righe:
        if r.startswith("Icon="):
            nuove.append("Icon=" + icona)
            visto_icona = True
        elif r.startswith(CHIAVE_ORIGINALE + "="):
            continue
        else:
            nuove.append(r)
    if not visto_icona:
        # nessuna riga Icon=: si mette subito dopo l'intestazione
        i = next((k for k, r in enumerate(nuove)
                  if r.strip() == "[Desktop Entry]"), -1)
        nuove.insert(i + 1, "Icon=" + icona)
    if originale is not None:
        i = next((k for k, r in enumerate(nuove)
                  if r.strip() == "[Desktop Entry]"), -1)
        nuove.insert(i + 1, "%s=%s" % (CHIAVE_ORIGINALE, originale))
    tmp = percorso + ".zeta-tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(nuove))
    shutil.copymode(percorso, tmp)
    os.replace(tmp, percorso)
    return True


def _ha_icona_personale(percorso):
    """Vero se questo elemento ha un'icona scelta dall'utente."""
    if _desktop_proprio(percorso):
        try:
            with open(percorso, encoding="utf-8") as f:
                return CHIAVE_ORIGINALE + "=" in f.read()
        except OSError:
            return False
    try:
        info = Gio.File.new_for_path(percorso).query_info(
            "metadata::custom-icon", Gio.FileQueryInfoFlags.NONE, None)
        return bool(info.get_attribute_string("metadata::custom-icon"))
    except GLib.Error:
        return False


def _app_del_collegamento(percorso):
    """L'applicazione descritta da un file .desktop, o None se illeggibile."""
    try:
        return Gio.DesktopAppInfo.new_from_filename(percorso)
    except (GLib.Error, TypeError):
        return None


# ---------------------------------------- collegamenti a programmi
# «Invia a › Scrivania» del gestore file crea un collegamento simbolico. Per un
# programma scaricato e messo in /opt (Blender, per esempio) il collegamento
# puo' puntare al programma stesso o al suo file .desktop, che spesso dice
# solo «Exec=blender»: un nome che vale soltanto nella sua cartella, non nel
# PATH del sistema. Prima nessuno dei due partiva dalla scrivania.

def _e_programma(percorso):
    """Vero se il file (seguendo il collegamento) e' un programma da avviare:
    eseguibile e binario ELF o script con «#!». Un'immagine con il permesso
    di esecuzione (succede con i dischi di Windows) resta un'immagine."""
    reale = os.path.realpath(percorso)
    if not (os.path.isfile(reale) and os.access(reale, os.X_OK)):
        return False
    try:
        with open(reale, "rb") as f:
            testa = f.read(4)
    except OSError:
        return False
    return testa == b"\x7fELF" or testa[:2] == b"#!"


def _comando_del_collegamento(percorso):
    """(argv, cartella) per un .desktop, cercando il programma anche accanto
    al file .desktop vero quando nel PATH non c'e'. None se non si avvia."""
    reale = os.path.realpath(percorso)
    kf = GLib.KeyFile()
    try:
        kf.load_from_file(reale, GLib.KeyFileFlags.NONE)
        exec_ = kf.get_string("Desktop Entry", "Exec")
    except GLib.Error:
        return None
    try:
        cartella = kf.get_string("Desktop Entry", "Path") or None
    except GLib.Error:
        cartella = None
    try:
        ok, argv = GLib.shell_parse_argv(_registro()._senza_codici(exec_).strip())
    except GLib.Error:
        return None
    if not ok or not argv:
        return None
    risolto = _comando_trovato(argv, reale, cartella)
    if risolto is None:
        return None
    argv, cartella = risolto
    # Blender from blender.org: started like the packaged one (see
    # applicazioni.SENZA_WAYLAND), also from a «Send to Desktop» link
    prog = argv[0] if os.path.isabs(argv[0]) else (GLib.find_program_in_path(argv[0]) or "")
    if os.path.basename(prog) in _registro().SENZA_WAYLAND and not prog.startswith("/usr/"):
        argv = ["env", "-u", "WAYLAND_DISPLAY"] + argv
    return argv, cartella


def _comando_trovato(argv, reale, cartella):
    prog = argv[0]
    if os.path.isabs(prog):
        return (argv, cartella) if os.access(prog, os.X_OK) else None
    # the program next to the real .desktop first (Blender 5.2 in /opt with
    # «Exec=blender», while /usr/bin/blender is the packaged one)
    vicino = os.path.join(os.path.dirname(reale), prog)
    if os.path.isfile(vicino) and os.access(vicino, os.X_OK):
        return [vicino] + argv[1:], cartella or os.path.dirname(reale)
    if GLib.find_program_in_path(prog):
        return argv, cartella
    return None


def _voce_collegamento(percorso):
    """(nome, icona) letti direttamente dal .desktop. Serve quando GIO non lo
    accetta: DesktopAppInfo rifiuta un .desktop se il programma di Exec non
    e' nel PATH, cioe' proprio il caso dei programmi messi in /opt."""
    kf = GLib.KeyFile()
    try:
        kf.load_from_file(os.path.realpath(percorso), GLib.KeyFileFlags.NONE)
    except GLib.Error:
        return None, None
    voci = []
    for chiave in ("Name", "Icon"):
        try:
            voci.append(kf.get_locale_string("Desktop Entry", chiave, None) or None)
        except GLib.Error:
            voci.append(None)
    return voci[0], voci[1]


def _icona_vicina(percorso, nome_icona):
    """Un file icona accanto al programma o al .desktop vero (blender.svg
    vicino a blender), per le icone che il tema di sistema non conosce."""
    cartella = os.path.dirname(os.path.realpath(percorso))
    nomi = [nome_icona] if nome_icona else []
    nomi.append(os.path.splitext(os.path.basename(os.path.realpath(percorso)))[0])
    for n in nomi:
        if os.path.isabs(n) and os.path.isfile(n):
            return n
        for est in ("svg", "png", "xpm"):
            f = os.path.join(cartella, "%s.%s" % (n, est))
            if os.path.isfile(f):
                return f
    return None


_RIPARATI = {}


def _ripara_una_volta(percorso):
    """A launcher that can't find its program (copied by the file manager
    with «Exec=blender», or made before 2.0): rewritten with full paths if
    its program is found next to its original entry. Tried once per file
    version, not at every redraw."""
    try:
        chiave = (percorso, os.lstat(percorso).st_mtime_ns)
    except OSError:
        return False
    if chiave in _RIPARATI:
        return False
    _RIPARATI[chiave] = True
    try:
        return _registro().ripara_collegamento(percorso)
    except (OSError, GLib.Error) as e:
        print("zeta-scrivania: repair %s: %s" % (percorso, e), file=sys.stderr, flush=True)
        return False


def _e_elf(percorso):
    try:
        with open(os.path.realpath(percorso), "rb") as f:
            return f.read(4) == b"\x7fELF"
    except OSError:
        return False


def _nome_e_icona_collegamento(percorso, display, gicon):
    """Nome e icona dell'applicazione di un .desktop (anche se e' un
    collegamento simbolico a un .desktop in /opt). Un'icona che il tema non
    conosce (Icon=blender) si cerca accanto al .desktop vero."""
    app = _app_del_collegamento(percorso)
    if app is not None:
        display = app.get_display_name() or display
        gicon = app.get_icon() or gicon
    elif _comando_del_collegamento(percorso):
        nome_kf, icona_kf = _voce_collegamento(percorso)
        display = nome_kf or display
        if icona_kf and os.path.isabs(icona_kf):
            gicon = Gio.FileIcon.new(Gio.File.new_for_path(icona_kf))
        elif icona_kf:
            gicon = Gio.ThemedIcon.new(icona_kf)
    elif _ripara_una_volta(percorso):
        return _nome_e_icona_collegamento(percorso, display, gicon)
    else:
        # broken link (the program is gone): say so with the app's own name,
        # never with the technical file name
        nome_kf, _icona = _voce_collegamento(percorso)
        if nome_kf:
            display = tr("{name} (missing)").format(name=nome_kf)
        return display, Gio.ThemedIcon.new("application-x-executable")
    nome_ic = gicon.get_names()[0] if isinstance(gicon, Gio.ThemedIcon) else None
    tema = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
    if nome_ic and not tema.has_icon(nome_ic):
        vicino = _icona_vicina(percorso, nome_ic)
        if vicino:
            gicon = Gio.FileIcon.new(Gio.File.new_for_path(vicino))
    return display, gicon


def _nome_e_icona_appimage(percorso, display):
    """An AppImage on the Desktop shows its app (name and icon), the one the
    menu shows, not a generic program icon."""
    reale = os.path.realpath(percorso)
    for app in _registro().tutte():
        if app.appimage and os.path.realpath(app.appimage) == reale:
            if os.path.isabs(app.icona) and os.path.isfile(app.icona):
                return app.nome, Gio.FileIcon.new(Gio.File.new_for_path(app.icona))
            return app.nome, Gio.ThemedIcon.new(app.icona or "application-x-executable")
    return display, _icona_programma(percorso)


def _icona_programma(percorso):
    vicino = _icona_vicina(percorso, None)
    return (Gio.FileIcon.new(Gio.File.new_for_path(vicino)) if vicino
            else Gio.ThemedIcon.new("application-x-executable"))


def _desktop_proprio(percorso):
    """Vero per un .desktop che sta davvero sulla scrivania: l'icona scelta
    si scrive dentro. Un collegamento simbolico a un .desktop di /opt no:
    il file vero e' del sistema (non scrivibile) e sostituirlo con una copia
    romperebbe un Exec relativo. Per quello l'icona va nei metadati, come
    per i file normali."""
    return percorso.endswith(".desktop") and not os.path.islink(percorso)


def _registro_ocr():
    if "/usr/lib/zeta" not in sys.path:
        sys.path.insert(0, "/usr/lib/zeta")
    from system import ocr
    return ocr


def _registro():
    if "/usr/lib/zeta" not in sys.path:
        sys.path.insert(0, "/usr/lib/zeta")
    from system import applicazioni
    return applicazioni


def trash_count():
    try:
        return len(os.listdir(os.path.join(trash_dir(), "files")))
    except OSError:
        return 0


def _human(n):
    for unit in ("B", "kB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return "%d %s" % (n, unit) if unit == "B" else "%.1f %s" % (n, unit)
        n /= 1024.0
    return "%d B" % n


# -------------------------------------------------------------------- voci
class Item:
    """Una icona sulla scrivania: un file, una cartella, oppure Home/Cestino."""
    __slots__ = ("name", "path", "is_dir", "widget", "col", "row", "x", "y", "gicon", "mime",
                 "custom", "display", "kind", "size", "mtime")

    def __init__(self, name, path, is_dir, gicon, display, kind="file",
                 size=0, mtime=0, mime="", custom=False):
        self.name = name
        self.path = path
        self.is_dir = is_dir
        self.gicon = gicon
        self.display = display
        self.kind = kind          # file | home | trash
        self.size = size
        self.mtime = mtime
        self.mime = mime          # serve a sapere se se ne puo' fare un'anteprima
        self.custom = custom      # icona scelta a mano: batte qualunque anteprima
        self.widget = None
        self.col = self.row = 0
        self.x = self.y = 0       # where it is drawn (a grid cell, or anywhere)

    @property
    def speciale(self):
        return self.kind != "file"


class Scrivania(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=tr("Desktop"), decorated=False)
        self.dir = desktop_dir()
        self.state = load_state()
        self.items = []
        self.selection = []          # elenco di Item selezionati
        self.tagliati = set()        # percorsi in attesa di «incolla» dopo un taglio
        self.isize = self._dimensione_icone()
        self.gap = spaziatura()
        # Anteprime gia' calcolate, per percorso e data di modifica: cambiando
        # cartella o rinfrescando non si rilegge due volte la stessa immagine.
        self._anteprime = {}
        self.cell_w = self.isize + 54
        self.cell_h = self.isize + 46
        self.banda = None
        self._ref_timer = 0
        self._dragging = []
        self._spostando = None
        self._presa, self._presa_nome = (0, 0), None

        self._make_background()
        self.fixed = Gtk.Fixed(hexpand=True, vexpand=True)
        self.set_child(self.fixed)
        self.add_css_class("zeta-scrivania")

        self._add_desktop_gestures()
        self.monitor = None
        self.trash_monitor = None
        self._watch()
        self.refresh()

    # ---------------------------------------- finestra sullo sfondo
    def _make_background(self):
        try:
            gi.require_version("Gtk4LayerShell", "1.0")
            from gi.repository import Gtk4LayerShell as LS
        except (ValueError, ImportError):
            LS = None
        if LS and LS.is_supported():
            LS.init_for_window(self)
            LS.set_namespace(self, "zeta-scrivania")
            # BOTTOM (non BACKGROUND): lo sfondo (swaybg) viene creato dopo e
            # coprirebbe le icone. BOTTOM sta sopra lo sfondo, sotto le finestre.
            LS.set_layer(self, LS.Layer.BOTTOM)
            LS.set_keyboard_mode(self, LS.KeyboardMode.NONE)
            # 0 (non -1): la superficie si restringe per lasciare fuori la barra
            LS.set_exclusive_zone(self, 0)
            for edge in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
                LS.set_anchor(self, edge, True)
        else:
            self.fullscreen()

    # ---------------------------------------- sorveglianza della cartella
    def _watch(self):
        # the user's app entries too: when an AppImage moves, an app gets a new
        # icon or is removed, its Desktop icon must follow without waiting
        # for the next change in the Desktop folder
        apps = os.path.join(GLib.get_user_data_dir(), "applications")
        for path, attr in ((self.dir, "monitor"),
                           (os.path.join(trash_dir(), "files"), "trash_monitor"),
                           (apps, "apps_monitor")):
            try:
                os.makedirs(path, exist_ok=True)
                m = Gio.File.new_for_path(path).monitor_directory(
                    Gio.FileMonitorFlags.WATCH_MOVES, None)
                m.connect("changed", lambda *_: self._debounced_refresh())
                setattr(self, attr, m)
            except (GLib.Error, OSError):
                setattr(self, attr, None)

    def _debounced_refresh(self):
        if self._ref_timer:
            GLib.source_remove(self._ref_timer)
        self._ref_timer = GLib.timeout_add(250, self._do_refresh)

    def _do_refresh(self):
        self._ref_timer = 0
        self.refresh()
        return False

    # ---------------------------------------- lettura della cartella
    def read_dir(self):
        """Home, Cestino e poi il contenuto della cartella Scrivania."""
        theme_home = "user-home"
        out = [Item("::home", os.path.expanduser("~"), True,
                    Gio.ThemedIcon.new(theme_home), tr("Home"), kind="home"),
               Item("::trash", "trash:///", True,
                    Gio.ThemedIcon.new("user-trash-full" if trash_count()
                                       else "user-trash"),
                    tr("Trash"), kind="trash")]

        gdir = Gio.File.new_for_path(self.dir)
        attrs = ("standard::name,standard::display-name,standard::type,"
                 "standard::icon,standard::is-hidden,standard::size,time::modified,"
                 "standard::content-type,thumbnail::path,thumbnail::is-valid,"
                 "metadata::custom-icon")
        try:
            en = gdir.enumerate_children(attrs, Gio.FileQueryInfoFlags.NONE, None)
        except GLib.Error:
            return out
        while True:
            try:
                info = en.next_file(None)
            except GLib.Error:
                break
            if info is None:
                break
            if info.get_is_hidden():
                continue
            name = info.get_name()
            percorso = os.path.join(self.dir, name)
            gicon = info.get_icon() or Gio.ThemedIcon.new("text-x-generic")
            display = info.get_display_name() or name
            # Un collegamento mostra il nome e l'icona dell'applicazione, non
            # il nome del file: è quello che l'utente si aspetta di vedere.
            if name.endswith(".desktop") or os.path.realpath(percorso).endswith(".desktop"):
                display, gicon = _nome_e_icona_collegamento(percorso, display, gicon)
            elif name.lower().endswith(".appimage"):
                display, gicon = _nome_e_icona_appimage(percorso, display)
            elif _e_programma(percorso):
                gicon = _icona_programma(percorso)
            # Icona scelta dall'utente (Cambia icona…). Per i collegamenti sta
            # già in Icon= e arriva da get_icon(); per file e cartelle si usa
            # metadata::custom-icon, l'attributo standard di GIO che anche i
            # gestori file rispettano.
            custom = info.get_attribute_string("metadata::custom-icon")
            if custom:
                f_icona = Gio.File.new_for_uri(custom)
                if f_icona.query_exists(None):
                    gicon = Gio.FileIcon.new(f_icona)
            # Anteprima gia' pronta nella cache di sistema (la genera tumbler
            # quando il gestore file visita la cartella): se c'e', si usa quella
            # e non si rilegge l'immagine.
            if not custom:
                anteprima = info.get_attribute_byte_string("thumbnail::path")
                if anteprima and info.get_attribute_boolean("thumbnail::is-valid"):
                    gicon = Gio.FileIcon.new(Gio.File.new_for_path(anteprima))
            out.append(Item(
                name, percorso,
                info.get_file_type() == Gio.FileType.DIRECTORY,
                gicon, display,
                size=info.get_size() or 0,
                mtime=info.get_attribute_uint64("time::modified"),
                mime=info.get_content_type() or "",
                custom=bool(custom)))
        return out

    def _anteprima(self, it, img):
        """Mette l'immagine ridotta al posto dell'icona, senza far attendere nessuno."""
        chiave = (it.path, it.mtime)
        if chiave in self._anteprime:
            tex = self._anteprime[chiave]
            if tex is not None:
                img.set_from_paintable(tex)
                img.set_pixel_size(self.isize)
            return
        lato = self.isize * 2          # il doppio: nitida anche su schermi fitti

        def fine(tex):
            self._anteprime[chiave] = tex
            if tex is not None and img.get_parent() is not None:
                img.set_from_paintable(tex)
                img.set_pixel_size(self.isize)
            return False

        def lavora():
            tex = None
            try:
                # Oltre questa dimensione non si tenta: un file enorme o
                # malformato terrebbe occupata memoria e tempo per niente, e
                # l'icona del tipo va benissimo.
                if os.path.getsize(it.path) <= ANTEPRIMA_MAX_BYTE:
                    pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                        it.path, lato, lato, True)
                    tex = Gdk.Texture.new_for_pixbuf(pix)
            except (GLib.Error, OSError, MemoryError):
                tex = None              # non e' un'immagine leggibile: pazienza
            GLib.idle_add(fine, tex)

        threading.Thread(target=lavora, daemon=True).start()

    def _ordina(self, items):
        modo = self.state.get("ordine", "nome")
        normali = [i for i in items if not i.speciale]
        if modo == "tipo":
            normali.sort(key=lambda i: (not i.is_dir,
                                        os.path.splitext(i.name)[1].lower(),
                                        i.display.lower()))
        elif modo == "data":
            normali.sort(key=lambda i: -i.mtime)
        elif modo == "dimensione":
            normali.sort(key=lambda i: (not i.is_dir, -i.size))
        else:
            normali.sort(key=lambda i: (not i.is_dir, i.display.lower()))
        return [i for i in items if i.speciale] + normali

    # ---------------------------------------- griglia
    def _grid_size(self):
        w = self.get_width() or 1280
        h = self.get_height() or 800
        cols = max(1, (w - 2 * MARGIN) // (self.cell_w + self.gap))
        rows = max(1, (h - 2 * MARGIN) // (self.cell_h + self.gap))
        return cols, rows

    def _scarto(self):
        """Arranged from the right, the grid touches the right edge (the space
        left over by the last column goes on the left)."""
        if self.state.get("lato") != "destra":
            return 0
        cols, _rows = self._grid_size()
        w = self.get_width() or 1280
        return max(0, (w - 2 * MARGIN) - (cols * (self.cell_w + self.gap) - self.gap))

    def _slot_xy(self, col, row):
        return (MARGIN + self._scarto() + col * (self.cell_w + self.gap),
                MARGIN + row * (self.cell_h + self.gap))

    def _xy_slot(self, x, y):
        cols, rows = self._grid_size()
        col = int(round((x - MARGIN - self._scarto()) / (self.cell_w + self.gap)))
        row = int(round((y - MARGIN) / (self.cell_h + self.gap)))
        return max(0, min(cols - 1, col)), max(0, min(rows - 1, row))

    # Layout, as on Windows and macOS: icons sit on a grid ("Align to Grid")
    # or exactly where they are dropped; new icons fill the free cells from
    # the left (Windows) or from the right (macOS). Cells are kept in
    # "posizioni", free positions in pixels in "libere".
    def _griglia(self):
        return self.state.get("griglia", True) is not False

    def _celle_libere(self, cols, rows):
        colonne = range(cols - 1, -1, -1) if self.state.get("lato") == "destra" else range(cols)
        return ((c, r) for c in colonne for r in range(rows))

    def _dentro(self, x, y):
        # never glued to the edge of the screen, never off it
        bordo = 6
        w = (self.get_width() or 1280) - self.cell_w - bordo
        h = (self.get_height() or 800) - self.cell_h - bordo
        return (max(bordo, min(int(x), max(bordo, w))),
                max(bordo, min(int(y), max(bordo, h))))

    def _assign_slots(self, items, prima=()):
        cols, rows = self._grid_size()
        pos = self.state.setdefault("posizioni", {})
        libere = self.state.setdefault("libere", {})
        griglia = self._griglia()
        # the icons just moved by hand win the cell they were dropped on
        ordinati = ([i for i in items if i.name in prima]
                    + [i for i in items if i.name not in prima])
        taken, pending = set(), []
        for it in ordinati:
            q = libere.get(it.name)
            if (not griglia and isinstance(q, list) and len(q) == 2
                    and all(isinstance(v, (int, float)) for v in q)):
                it.x, it.y = self._dentro(*q)
                it.col, it.row = self._xy_slot(it.x, it.y)
                taken.add((it.col, it.row))
                continue
            p = pos.get(it.name)
            if (isinstance(p, list) and len(p) == 2 and 0 <= p[0] < cols
                    and 0 <= p[1] < rows and tuple(p) not in taken):
                it.col, it.row = int(p[0]), int(p[1])
                taken.add((it.col, it.row))
                it.x, it.y = self._slot_xy(it.col, it.row)
                if not griglia:
                    libere[it.name] = [it.x, it.y]
            else:
                pending.append(it)
        celle = self._celle_libere(cols, rows)
        for it in pending:
            for slot in celle:
                if slot not in taken:
                    it.col, it.row = slot
                    taken.add(slot)
                    pos[it.name] = list(slot)
                    break
            else:
                it.col, it.row = 0, 0
            it.x, it.y = self._slot_xy(it.col, it.row)
            if not griglia:
                libere[it.name] = [it.x, it.y]

    def _metti(self, nomi_xy):
        """Icons dropped at (x, y) by hand: in a cell, or right there."""
        pos = self.state.setdefault("posizioni", {})
        libere = self.state.setdefault("libere", {})
        for nome, (x, y) in nomi_xy:
            if self._griglia():
                pos[nome] = list(self._xy_slot(x, y))
            else:
                libere[nome] = list(self._dentro(x, y))
        save_state(self.state)
        self.refresh(prima={n for n, _xy in nomi_xy})

    # ---------------------------------------- disegno
    def refresh(self, prima=()):
        _registro().icone_gtk()          # icone delle app Flatpak appena installate
        selezionati = {i.name for i in self.selection}
        for it in self.items:
            if it.widget is not None:
                self.fixed.remove(it.widget)
        self.items = self._ordina(self.read_dir())
        self._assign_slots(self.items, prima)
        self.selection = []
        for it in self.items:
            it.widget = self._make_item(it)
            self.fixed.put(it.widget, it.x, it.y)
            if it.name in selezionati:
                self.selection.append(it)
                it.widget.add_css_class("selected")
            if it.path in self.tagliati:
                it.widget.add_css_class("tagliato")
        nomi = {i.name for i in self.items}
        for chiave in ("posizioni", "libere"):
            pos = self.state.get(chiave, {})
            for sparito in [n for n in pos if n not in nomi]:
                pos.pop(sparito)
        save_state(self.state)

    def _make_item(self, it):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                      css_classes=["sc-item"], width_request=self.cell_w)
        img = Gtk.Image.new_from_gicon(it.gicon)
        img.set_pixel_size(self.isize)
        box.append(img)
        # Immagini: si mostra il contenuto, non l'icona del tipo. Se il gestore
        # file e' gia' passato di qui l'anteprima sta nella cache ed e' gia'
        # stata messa in read_dir; altrimenti la si legge qui, in un thread,
        # perche' aprire un JPEG da dodici megapixel sul filo dell'interfaccia
        # bloccherebbe la scrivania per il tempo che ci vuole.
        if (not it.is_dir and not it.custom and not it.speciale
                and it.mime.startswith("image/")
                and not isinstance(it.gicon, Gio.FileIcon)):
            self._anteprima(it, img)
        box.append(Gtk.Label(label=it.display, css_classes=["sc-name"], wrap=True,
                             max_width_chars=13, lines=2,
                             ellipsize=Pango.EllipsizeMode.END,
                             justify=Gtk.Justification.CENTER))

        click = Gtk.GestureClick(button=1)
        click.connect("pressed", self._on_click, it)
        box.add_controller(click)

        right = Gtk.GestureClick(button=3)
        right.connect("pressed", self._on_right_click, it)
        box.add_controller(right)

        if not it.speciale:
            drag = Gtk.DragSource(actions=Gdk.DragAction.MOVE | Gdk.DragAction.COPY)
            drag.connect("prepare", self._drag_prepare, it)
            drag.connect("drag-begin", self._drag_begin, it)
            drag.connect("drag-end", self._drag_end, it)
            box.add_controller(drag)

        if it.kind == "trash":
            # si possono lasciar cadere file sul cestino per buttarli
            drop = Gtk.DropTarget.new(Gio.File, Gdk.DragAction.MOVE)
            drop.set_gtypes([Gio.File, Gdk.FileList])
            drop.connect("drop", self._drop_on_trash)
            box.add_controller(drop)
        return box

    # ---------------------------------------- selezione
    def _set_selection(self, items):
        for it in self.items:
            if it.widget is not None:
                it.widget.remove_css_class("selected")
        self.selection = [i for i in items if i is not None]
        for it in self.selection:
            if it.widget is not None:
                it.widget.add_css_class("selected")

    def _toggle(self, it):
        if it in self.selection:
            self.selection.remove(it)
            it.widget.remove_css_class("selected")
        else:
            self.selection.append(it)
            it.widget.add_css_class("selected")

    def _range_to(self, it):
        if not self.selection:
            self._set_selection([it])
            return
        i0 = self.items.index(self.selection[-1])
        i1 = self.items.index(it)
        lo, hi = min(i0, i1), max(i0, i1)
        self._set_selection(self.items[lo:hi + 1])

    def _on_click(self, gesture, n_press, _x, _y, it):
        mod = gesture.get_current_event_state()
        if mod & Gdk.ModifierType.CONTROL_MASK:
            self._toggle(it)
            return
        if mod & Gdk.ModifierType.SHIFT_MASK:
            self._range_to(it)
            return
        if it not in self.selection:
            self._set_selection([it])
        if n_press >= 2:
            for sel in list(self.selection):
                self.open(sel)

    def _on_right_click(self, gesture, _n, x, y, it):
        if it not in self.selection:
            self._set_selection([it])
        self._menu_for_item(it, gesture.get_widget(), x, y)

    # ---------------------------------------- apertura
    def open(self, it):
        """Apre con l'applicazione predefinita (o il gestore file se cartella)."""
        target = it.path
        if it.kind == "trash":
            target = "trash:///"
        # I collegamenti si avviano: passarli a «gio open» li farebbe aprire
        # in un editor di testo, perché GIO non si fida di un .desktop
        # qualsiasi. Qui si legge il file e si lancia l'applicazione.
        elif it.name.endswith(".desktop") or os.path.realpath(it.path).endswith(".desktop"):
            comando = _comando_del_collegamento(it.path)
            app = _app_del_collegamento(it.path)
            # GIO only when it would start the same program: with «Exec=blender»
            # next to Blender 5.2 in /opt it would start /usr/bin/blender
            if comando is not None and app is not None and \
                    GLib.find_program_in_path(app.get_executable() or "") and \
                    GLib.find_program_in_path(comando[0][0]) == \
                    GLib.find_program_in_path(app.get_executable() or ""):
                try:
                    app.launch([], None)   # programma installato nel sistema
                    return
                except GLib.Error:
                    pass
            if comando is not None:
                argv, cartella = comando
                try:
                    _avvia(argv, cwd=cartella, start_new_session=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    return
                except OSError as e:
                    self._error(tr("Couldn't start “{name}”: {error}").format(
                        name=it.display, error=e.strerror))
                    return
            self._error(tr("“{name}” is not a valid shortcut: the program it points "
                           "to can't be found.").format(name=it.display))
            return
        elif _e_programma(it.path):
            # un programma (o un collegamento a un programma): si avvia dalla
            # sua cartella, come facendo doppio clic nel gestore file
            reale = os.path.realpath(it.path)
            try:
                _avvia([reale], cwd=os.path.dirname(reale), start_new_session=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError as e:
                self._error(tr("Couldn't start “{name}”: {error}").format(
                    name=it.display, error=e.strerror))
            return
        for cmd in (["gio", "open", target], ["xdg-open", target],
                    ["thunar", target]):
            try:
                _avvia(cmd, start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return
            except OSError:
                continue
        self._error(tr("No app available to open “{name}”.").format(name=it.display))

    # ---------------------------------------- trascinamento
    def _drag_prepare(self, _source, x, y, it):
        if it not in self.selection:
            self._set_selection([it])
        # where the icon was grabbed: it lands with that point under the pointer
        self._presa, self._presa_nome = (x, y), it.path
        # The paths on the Desktop as plain text/uri-list. A Gio.File value
        # went through the file-transfer portal, which hands over the real
        # file behind a symbolic link: moving a «Send to Desktop» link of
        # Blender arrived as /opt/blender/blender.desktop, was taken for a
        # file from outside and copied («Blender (missing)»), and dropping
        # it on the Trash or in a folder acted on the program's own file.
        percorsi = [i.path for i in self.selection if not i.speciale] or [it.path]
        uri = "".join(Gio.File.new_for_path(q).get_uri() + "\r\n" for q in percorsi)
        return Gdk.ContentProvider.new_for_bytes("text/uri-list", GLib.Bytes.new(uri.encode()))

    def _drag_begin(self, _source, _drag, it):
        self._dragging = [i.path for i in self.selection] or [it.path]

    def _drag_end(self, _source, _drag, _del, _it):
        self._dragging = []

    def _drop_on_trash(self, _target, value, _x, _y):
        for gfile in self._files_from(value):
            self._trash_path(gfile.get_path())
        self.refresh()
        return True

    def _files_from(self, value):
        if isinstance(value, list):
            return [f for f in value if isinstance(f, Gio.File)]
        if isinstance(value, Gdk.FileList):
            return list(value.get_files())
        if isinstance(value, Gio.File):
            return [value]
        return []

    def _add_desktop_gestures(self):
        right = Gtk.GestureClick(button=3)
        right.connect("pressed", self._on_desktop_right)
        self.fixed.add_controller(right)

        left = Gtk.GestureClick(button=1)
        left.connect("pressed", self._clic_vuoto)
        self.fixed.add_controller(left)

        # selezione a banda: si trascina sul vuoto per prendere più icone
        banda = Gtk.GestureDrag()
        banda.connect("drag-begin", self._banda_inizio)
        banda.connect("drag-update", self._banda_aggiorna)
        banda.connect("drag-end", self._banda_fine)
        self.fixed.add_controller(banda)

        # Rilascio sulla scrivania: si guarda che cosa offre chi trascina e si
        # sceglie il meglio (vedi _dnd_rilascio). Prima si accettava un tipo
        # fisso: un'immagine di una pagina senza indirizzo scaricabile (blob:,
        # generata dalla pagina) non arrivava.
        formati = Gdk.ContentFormats.new(list(MIME_URI + MIME_TESTO + MIME_IMMAGINI))
        for gt in (Gdk.FileList, Gio.File, GObject.TYPE_STRING):
            formati = formati.union(Gdk.ContentFormats.new_for_gtype(gt))
        drop = Gtk.DropTargetAsync.new(formati, Gdk.DragAction.MOVE | Gdk.DragAction.COPY)
        drop.connect("drag-enter", self._dnd_azione)
        drop.connect("drag-motion", self._dnd_azione)
        drop.connect("drop", self._dnd_rilascio)
        self.fixed.add_controller(drop)

    def _clic_vuoto(self, _g, _n, x, y):
        if not self._punto_su_icona(x, y):
            self._set_selection([])

    # ---------------------------------------- banda di selezione
    def _punto_su_icona(self, x, y):
        return self._icona_in(x, y) is not None

    def _icona_in(self, x, y):
        w = self.fixed.pick(x, y, Gtk.PickFlags.DEFAULT)
        while w is not None and w is not self.fixed:
            if w.has_css_class("sc-item"):
                return next((i for i in self.items if i.widget is w), None)
            w = w.get_parent()
        return None

    def _banda_inizio(self, gesture, x, y):
        self._spostando = None
        it = self._icona_in(x, y)
        if it is not None and it.speciale:
            # Home and Trash are not files: they move on the desktop only and
            # are never handed to other apps (dropping Home on the file
            # manager would copy the whole home folder)
            self.banda = None
            self._spostando = {"it": it, "origine": (it.x, it.y),
                               "mosso": False, "ultimo": None}
            return
        # La banda vale solo sul vuoto: partendo da un'icona si sta
        # trascinando quella, e le due cose si darebbero fastidio.
        if it is not None:
            gesture.set_state(Gtk.EventSequenceState.DENIED)
            self.banda = None
            return
        self._banda0 = (x, y)
        self.banda = Gtk.Box(css_classes=["sc-banda"])
        self.fixed.put(self.banda, x, y)

    def _banda_aggiorna(self, _gesture, dx, dy):
        if self._spostando is not None:
            self._sposta_icona(dx, dy)
            return
        if self.banda is None:
            return
        x0, y0 = self._banda0
        x, y = min(x0, x0 + dx), min(y0, y0 + dy)
        w, h = max(1, abs(dx)), max(1, abs(dy))
        self.fixed.move(self.banda, x, y)
        self.banda.set_size_request(int(w), int(h))
        dentro = []
        for it in self.items:
            ix, iy = it.x, it.y
            if (ix + self.cell_w > x and ix < x + w
                    and iy + self.cell_h > y and iy < y + h):
                dentro.append(it)
        self._set_selection(dentro)

    def _sposta_icona(self, dx, dy):
        st = self._spostando
        if not st["mosso"]:
            if abs(dx) < 6 and abs(dy) < 6:
                return
            st["mosso"] = True
            st["it"].widget.add_css_class("in-movimento")
        ox, oy = st["origine"]
        st["ultimo"] = (max(0, ox + dx), max(0, oy + dy))
        self.fixed.move(st["it"].widget, *st["ultimo"])

    def _sposta_fine(self):
        """Home or Trash dropped: into the nearest cell (swapping places with
        the icon that was there), or right there without the grid."""
        st, self._spostando = self._spostando, None
        if not st["mosso"] or st["ultimo"] is None:
            return
        it = st["it"]
        if self._griglia():
            col, row = self._xy_slot(*st["ultimo"])
            altro = next((i for i in self.items
                          if i is not it and (i.col, i.row) == (col, row)), None)
            if altro is not None:
                # swap places with the icon that was there
                self.state.setdefault("posizioni", {})[altro.name] = [it.col, it.row]
        self._metti([(it.name, st["ultimo"])])

    def _banda_fine(self, *_a):
        if self._spostando is not None:
            self._sposta_fine()
            return
        if self.banda is not None:
            self.fixed.remove(self.banda)
            self.banda = None

    # ---------------------------------------- rilascio sulla scrivania
    # ---- rilascio: scelta del formato migliore fra quelli offerti
    @staticmethod
    def _dnd_azione(_t, drop, _x, _y):
        # dalla scrivania stessa si sposta, da fuori si copia
        return Gdk.DragAction.MOVE if drop.get_drag() is not None else Gdk.DragAction.COPY

    def _dnd_rilascio(self, _t, drop, x, y):
        if drop.get_drag() is not None and self._dragging:
            # icons of this Desktop: they only move, whatever the data says
            self._sposta_interni(list(self._dragging), x, y)
            drop.finish(Gdk.DragAction.MOVE)
            return True
        fmt = drop.get_formats()
        debug = bool(os.environ.get("ZETA_DEBUG_DND"))
        if debug:
            print("drop, formats:", fmt.to_string(), file=sys.stderr, flush=True)
        azione = Gdk.DragAction.MOVE if drop.get_drag() is not None else Gdk.DragAction.COPY
        immagine = next((m for m in MIME_IMMAGINI if fmt.contain_mime_type(m)), None)
        nome_file = None
        if not immagine:
            # Chromium consegna il file stesso, con il suo nome:
            # application/octet-stream;name="foto.png" (anche per le immagini blob:)
            for m in fmt.get_mime_types() or []:
                if m.startswith("application/octet-stream;name="):
                    immagine = m
                    nome_file = m.split("name=", 1)[1].strip().strip('"')
                    break
        stato = {"x": x, "y": y, "immagine": immagine, "nome": nome_file,
                 "dati": None, "valore": None, "chiuso": False}

        def chiudi():
            # una volta sola: alla fine delle letture o allo scadere del tempo
            if stato["chiuso"]:
                return False
            stato["chiuso"] = True
            try:
                ok = self._dnd_applica(stato)
            except Exception as e:  # noqa: BLE001 - un rilascio non deve far cadere la scrivania
                print("zeta-scrivania: drop: %s" % e, file=sys.stderr, flush=True)
                ok = False
            if debug:
                print("drop applied:", ok, type(stato["valore"]).__name__,
                      len(stato["dati"] or b""), file=sys.stderr, flush=True)
            drop.finish(azione if ok else 0)
            return False
        # Le letture si fanno una dopo l'altra: due insieme dallo stesso
        # rilascio restavano appese con Firefox (provato). E comunque dopo 5
        # secondi si va avanti con quello che si ha.
        GLib.timeout_add(5000, chiudi)

        def leggi_immagine():
            if not immagine:
                return chiudi()

            def letta(d, res):
                try:
                    flusso, _m = d.read_finish(res)
                except GLib.Error:
                    return chiudi()
                uscita = Gio.MemoryOutputStream.new_resizable()

                def copiata(u, r):
                    try:
                        u.splice_finish(r)
                        stato["dati"] = u.steal_as_bytes().get_data()
                    except GLib.Error:
                        stato["dati"] = None
                    chiudi()
                uscita.splice_async(flusso, Gio.OutputStreamSpliceFlags.CLOSE_SOURCE |
                                    Gio.OutputStreamSpliceFlags.CLOSE_TARGET,
                                    GLib.PRIORITY_DEFAULT, None, copiata)
            drop.read_async([immagine], GLib.PRIORITY_DEFAULT, None, letta)

        def letto_valore(d, res):
            try:
                v = d.read_value_finish(res)
            except GLib.Error:
                v = None
            # Gli oggetti letti valgono solo dentro questa funzione: la lista
            # dei file, usata dopo (finita la lettura dell'immagine), faceva
            # cadere la scrivania (visto). Si copiano subito gli indirizzi.
            if isinstance(v, (Gdk.FileList, Gio.File)):
                v = [Gio.File.new_for_uri(f.get_uri()) for f in self._files_from(v) if f.get_uri()]
            elif v is not None and not isinstance(v, str):
                v = None
            stato["valore"] = v
            if debug:
                print("read:", type(stato["valore"]).__name__, file=sys.stderr, flush=True)
            leggi_immagine()

        for gt in (Gdk.FileList, Gio.File, GObject.TYPE_STRING):
            if fmt.contain_gtype(gt):
                drop.read_value_async(gt, GLib.PRIORITY_DEFAULT, None, letto_valore)
                break
        else:
            leggi_immagine()
        return True

    def _dnd_applica(self, st):
        """Con quello che si e' letto: file veri, indirizzi o i byte dell'immagine."""
        valore, dati, tipo = st["valore"], st["dati"], st["immagine"]
        nome_dato = st.get("nome")
        if tipo and tipo.startswith("application/octet-stream"):
            tipo = ""                    # il nome dice gia' che file e'
        col, row = self._xy_slot(st["x"], st["y"])
        uri = []
        if isinstance(valore, list):
            uri = [f.get_uri() or "" for f in valore]
        elif isinstance(valore, str):
            uri = [r.strip() for r in valore.replace("\r", "").split("\n") if r.strip()]
        scaricabili = [u for u in uri if u.startswith(("http://", "https://", "data:"))]
        locali = [u for u in uri if u.startswith("file:")]
        # 1) file veri (da un gestore file, o gia' scaricati): si copiano
        if locali or isinstance(valore, list) and valore and not scaricabili and not dati:
            return self._on_drop(None, valore, st["x"], st["y"])
        # 2) indirizzi: si scarica il file originale (nome e formato veri); se
        #    non riesce (pagina con accesso, sito spento) e il browser ha dato
        #    anche l'immagine, si salva quella
        if scaricabili:
            for u in scaricabili[:1] if dati else scaricabili:
                riserva = (dati, nome_dato or scarica.nome_da_url(u, tipo), tipo) if dati else None
                self._scarica(u, col, row, riserva=riserva)
            return True
        # 3) solo l'immagine (blob:, generata dalla pagina): si salvano i byte
        if dati:
            nome = nome_dato or tr("Dropped image")
            self._fatto_in_sottofondo(lambda: scarica.dati(self.dir, nome, dati, tipo), col, row)
            return True
        # 4) un indirizzo che vale solo dentro il browser (blob:, immagini
        #    create dalla pagina): se il browser non ha dato anche l'immagine,
        #    nessuno puo' recuperarla. Lo si dice, invece di salvare un file
        #    di testo con quell'indirizzo (visto con Firefox).
        interni = [u for u in uri if u.startswith(("blob:", "about:", "javascript:", "moz-extension:",
                                                  "chrome:", "chrome-extension:"))]
        if interni and len(interni) >= len([u for u in uri if "://" in u or u.startswith("blob:")]):
            self._error(tr("This image exists only inside the web page, and the browser doesn't hand it "
                           "over when you drag it. To save it, right-click the image › “Save Image As…”."))
            return False
        # 5) testo
        if isinstance(valore, str):
            return self._rilascio_testo(valore, col, row)
        return False

    def _on_drop(self, _target, value, x, y):
        col, row = self._xy_slot(x, y)
        if isinstance(value, str):
            return self._rilascio_testo(value, col, row)
        files = self._files_from(value)
        if not files:
            return False
        interno = False
        remoti = []
        arrivati = []          # icons that came from outside: where they were dropped
        for gfile in files:
            path = gfile.get_path()
            if not path:
                # un indirizzo web (immagine o link da Firefox): si scarica
                uri = gfile.get_uri() or ""
                if uri.startswith(("http://", "https://", "data:")):
                    remoti.append(uri)
                continue
            name = os.path.basename(path)
            if os.path.dirname(os.path.abspath(path)) == os.path.abspath(self.dir):
                interno = True
                continue
            if self._dragging and any(os.path.realpath(d) == os.path.realpath(path)
                                      for d in self._dragging):
                interno = True       # a link of the Desktop, given as its target
                continue
            # A program dropped on the Desktop becomes a shortcut, as on
            # Windows: an AppImage (often a gigabyte or more) is never
            # copied, and a menu entry becomes the app's Desktop icon
            nuovo = self._collegamento_app(path)
            if nuovo is None:
                nuovo = self._copy_here(gfile, name)
            if nuovo:
                arrivati.append(nuovo)
        if interno:
            self._sposta_interni(self._dragging or [f.get_path() for f in files], x, y)
        if arrivati:
            cx, cy = x - self.cell_w / 2, y - self.isize / 2
            passo = self.cell_h + self.gap
            self._metti([(n, (cx, cy + i * passo)) for i, n in enumerate(arrivati)])
        for uri in remoti:
            self._scarica(uri, col, row)
        return True

    def _sposta_interni(self, spostati, x, y):
        """Icons of this Desktop dropped on it: they keep their arrangement,
        each moving by the same amount as the one grabbed (which lands under
        the pointer)."""
        col, row = self._xy_slot(x, y)
        cols, _rows = self._grid_size()
        per_nome = {i.name: i for i in self.items}
        presa = per_nome.get(os.path.basename(self._presa_nome or ""))
        px, py = self._presa
        if presa is not None:
            dx, dy = x - px - presa.x, y - py - presa.y
        else:
            dx = dy = None
        mosse = []
        for i, path in enumerate(spostati):
            nome = os.path.basename(path)
            it = per_nome.get(nome)
            if it is not None and dx is not None:
                mosse.append((nome, (it.x + dx, it.y + dy)))
            else:
                c = (col + i) % cols
                r = row + (col + i) // cols
                mosse.append((nome, self._slot_xy(c, r)))
        self._metti(mosse)

    def _collegamento_app(self, path):
        """The Desktop icon of the app in this file (an AppImage, a menu
        entry, the desktop entry or the program file of an app unpacked by
        hand): its name, or None when the file is not an app (then it is
        copied like any other file, web links included)."""
        reg = _registro()
        app = None
        reale = os.path.realpath(path)
        if reale.endswith(".desktop") and "/applications/" in reale:
            app = reg.trova(reale)
        elif reale.endswith(".desktop") and reg.voce_risolta(reale) is not None:
            # a program unpacked by hand (Blender in /opt or in Downloads):
            # its menu entry if it has one, otherwise a shortcut with full
            # paths. A plain copy kept «Exec=blender», valid only next to
            # the program, and showed «Blender (missing)».
            app = next((a for a in reg.tutte() if a.desktop and a.id.startswith(reg.PREFISSO_OPT)
                        and self._origine_opt(a) == reale), None)
            if app is None:
                nuovo, errore = reg.collegamento_esterno(path, self.dir)
                if errore:
                    self._error(errore)
                return os.path.basename(nuovo)
        elif os.path.isfile(reale) and reg.e_appimage(reale):
            def cerca():
                return next((a for a in reg.tutte() if a.appimage
                             and os.path.realpath(a.appimage) == reale), None)
            app = cerca()
            if app is None:
                reg.integra_appimage()       # just downloaded: not seen yet
                app = cerca()
        elif _e_programma(reale) and (_e_elf(reale) or reg.voce_accanto(reale)):
            # a program file (blender, or a script with its own desktop entry
            # next to it): a shortcut to it, never a copy (Blender needs its
            # libraries next to it)
            nuovo, errore = reg.collegamento_programma(path, self.dir)
            if errore:
                self._error(errore)
            return os.path.basename(nuovo)
        if app is None:
            return None
        ok, msg = reg.aggiungi_scrivania(app)
        if not ok:
            gia = reg.sulla_scrivania(app) or reg.appimage_sulla_scrivania(app)
            if gia:
                return os.path.basename(gia)     # already there: it moves here
            self._error(msg)
            return ""
        return app.id

    @staticmethod
    def _origine_opt(app):
        kf = GLib.KeyFile()
        try:
            kf.load_from_file(app.desktop, GLib.KeyFileFlags.NONE)
            return kf.get_string("Desktop Entry", "X-ZETA-Opt")
        except GLib.Error:
            return ""

    def _rilascio_testo(self, testo, col, row):
        """Testo trascinato: indirizzi da scaricare, oppure un file di testo."""
        righe = [r.strip() for r in testo.replace("\r", "").split("\n") if r.strip()]
        indirizzi = [r for r in righe if r.startswith(("http://", "https://", "data:"))]
        if indirizzi and len(indirizzi) == len(righe) or (len(righe) == 2 and indirizzi == righe[:1]):
            # text/x-moz-url: indirizzo e titolo su due righe
            titolo = righe[1] if len(righe) == 2 and indirizzi == righe[:1] else None
            for u in (indirizzi[:1] if titolo else indirizzi):
                self._scarica(u, col, row, titolo)
            return True
        self._fatto_in_sottofondo(lambda: scarica.testo(self.dir, testo), col, row)
        return True

    def _scarica(self, url, col, row, titolo=None, riserva=None):
        breve = url if len(url) < 60 else url[:57] + "…"
        if not url.startswith("data:"):
            self._avviso(tr("Saving to the Desktop: {url}").format(url=breve))

        def lavoro():
            esito = scarica.da_url(url, self.dir, titolo)
            if not esito[0] and riserva:
                # l'indirizzo non si scarica, ma l'immagine il browser ce l'ha data
                return scarica.dati(self.dir, riserva[1], riserva[0], riserva[2])
            return esito
        self._fatto_in_sottofondo(lavoro, col, row)

    def _fatto_in_sottofondo(self, lavoro, col, row):
        """Il download non ferma la Scrivania; alla fine l'icona compare
        dove e' stata lasciata, oppure si dice perche' non e' andata."""
        def filo():
            try:
                ok, msg, percorso = lavoro()
            except Exception as e:  # noqa: BLE001 - un rilascio non deve far cadere la scrivania
                ok, msg, percorso = False, tr("Operation failed: {error}").format(error=e), None
            GLib.idle_add(self._scaricato, ok, msg, percorso, col, row)
        threading.Thread(target=filo, daemon=True).start()

    def _scaricato(self, ok, msg, percorso, col, row):
        if ok and percorso:
            self._metti([(os.path.basename(percorso), self._slot_xy(col, row))])
            self._avviso(msg)
        else:
            self._error(msg)
        return False

    def _avviso(self, testo):
        try:
            _avvia(["notify-send", "-a", tr("Desktop"), "-i", "user-desktop", tr("Desktop"), testo],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            pass

    def _copy_here(self, gfile, name):
        """Copy onto the Desktop; the new file's name, or "" on error."""
        dest_path = self._nome_libero(name)
        try:
            gfile.copy(Gio.File.new_for_path(dest_path), Gio.FileCopyFlags.NONE,
                       None, None, None)
        except GLib.Error as e:
            self._error(tr("Couldn't copy “{name}”: {error}").format(name=name, error=e.message))
            return ""
        return os.path.basename(dest_path)

    def _nome_libero(self, name):
        dest = os.path.join(self.dir, name)
        base, ext = os.path.splitext(name)
        base = re.sub(r" \(\d+\)$", "", base)      # «blender (3)», not «blender (2) (2)»
        n = 2
        while os.path.exists(dest):
            dest = os.path.join(self.dir, "%s (%d)%s" % (base, n, ext))
            n += 1
        return dest

    # ---------------------------------------- appunti
    def _clipboard(self):
        return self.get_clipboard()

    def copia(self, taglia=False):
        percorsi = [i.path for i in self.selection if not i.speciale]
        if not percorsi:
            return
        testo = ("cut" if taglia else "copy") + "\n" + "\n".join(
            "file://" + urllib.parse.quote(p) for p in percorsi)
        # formato condiviso con i gestori file (Thunar, Nautilus...)
        provider = Gdk.ContentProvider.new_union([
            Gdk.ContentProvider.new_for_bytes(CLIP_MIME,
                                              GLib.Bytes.new(testo.encode())),
            Gdk.ContentProvider.new_for_value(
                GObject.Value(str, "\n".join(percorsi))),
        ])
        self._clipboard().set_content(provider)
        self.tagliati = set(percorsi) if taglia else set()
        self.refresh()

    def incolla(self):
        self._clipboard().read_async(
            [CLIP_MIME, "text/uri-list", "text/plain"], GLib.PRIORITY_DEFAULT,
            None, self._incolla_pronto)

    def _incolla_pronto(self, clipboard, result):
        try:
            stream, mime = clipboard.read_finish(result)
        except GLib.Error:
            return
        # La lettura va fatta in modo asincrono: leggere il flusso a mano
        # blocca il thread dell'interfaccia finché l'altro programma non
        # chiude il canale, e la scrivania si pianta.
        out = Gio.MemoryOutputStream.new_resizable()
        out.splice_async(stream,
                         Gio.OutputStreamSpliceFlags.CLOSE_SOURCE
                         | Gio.OutputStreamSpliceFlags.CLOSE_TARGET,
                         GLib.PRIORITY_DEFAULT, None,
                         self._incolla_letto, mime)

    def _incolla_letto(self, out, result, mime):
        try:
            out.splice_finish(result)
            dati = out.steal_as_bytes().get_data() or b""
        except GLib.Error:
            return
        testo = dati.decode("utf-8", "replace").strip()
        if not testo:
            return
        righe = [r for r in testo.split("\n") if r.strip()]
        taglia = mime == CLIP_MIME and righe and righe[0].strip() == "cut"
        if mime == CLIP_MIME:
            righe = righe[1:]
        errori = []
        for riga in righe:
            riga = riga.strip()
            if riga.startswith("file://"):
                riga = urllib.parse.unquote(riga[7:])
            if not riga or not os.path.exists(riga):
                continue
            if taglia and os.path.dirname(os.path.abspath(riga)) == os.path.abspath(self.dir):
                continue      # tagliato e reincollato dov'era già: nulla da fare
            riga_dest = self._nome_libero(os.path.basename(riga))
            try:
                if not taglia and os.path.realpath(riga).endswith(".desktop") \
                        and _registro().voce_risolta(riga) is not None:
                    # a copy of a launcher: full paths, so it starts from here too
                    _nuovo, errore = _registro().collegamento_esterno(riga, self.dir, unico=False)
                    if errore:
                        errori.append("%s: %s" % (os.path.basename(riga), errore))
                    continue
                if taglia and os.path.islink(riga) and not os.path.isabs(os.readlink(riga)):
                    # a relative link would point elsewhere from here
                    os.symlink(os.path.realpath(riga), riga_dest)
                    os.unlink(riga)
                elif taglia:
                    shutil.move(riga, riga_dest)
                elif os.path.isdir(riga):
                    shutil.copytree(riga, riga_dest)
                else:
                    shutil.copy2(riga, riga_dest)
            except (OSError, shutil.Error) as e:
                errori.append("%s: %s" % (os.path.basename(riga), e))
        self.tagliati = set()
        if errori:
            self._error("\n".join(errori[:5]))
        self.refresh()

    # ---------------------------------------- menù
    def _popover(self, parent, x, y, voci):
        """voci: elenco di (etichetta, funzione) — None crea un separatore,
        ('sub', etichetta, [voci]) crea un sottomenù, ('check', etichetta,
        attiva, funzione) una scelta con il segno di spunta."""
        menu = Gio.Menu()
        actions = Gio.SimpleActionGroup()
        contatore = [0]

        def riempi(target, elenco):
            sezione = Gio.Menu()
            for voce in elenco:
                if voce is None:
                    target.append_section(None, sezione)
                    sezione = Gio.Menu()
                    continue
                if isinstance(voce, tuple) and len(voce) == 4 and voce[0] == "check":
                    # a choice that is on or off: the menu shows a check mark
                    _t, etichetta, attiva, fn = voce
                    nome = "v%d" % contatore[0]
                    contatore[0] += 1
                    act = Gio.SimpleAction.new_stateful(nome, None, GLib.Variant("b", bool(attiva)))
                    act.connect("activate", lambda _a, _p, f=fn: f())
                    actions.add_action(act)
                    sezione.append(etichetta, "sc.%s" % nome)
                    continue
                if isinstance(voce, tuple) and len(voce) == 3 and voce[0] == "sub":
                    sub = Gio.Menu()
                    riempi(sub, voce[2])
                    sezione.append_submenu(voce[1], sub)
                    continue
                etichetta, fn = voce
                nome = "v%d" % contatore[0]
                contatore[0] += 1
                act = Gio.SimpleAction.new(nome, None)
                act.connect("activate", lambda _a, _p, f=fn: f())
                actions.add_action(act)
                sezione.append(etichetta, "sc.%s" % nome)
            target.append_section(None, sezione)

        riempi(menu, voci)
        pop = Gtk.PopoverMenu.new_from_model(menu)
        pop.insert_action_group("sc", actions)
        pop.set_parent(parent)
        # Gdk.Rectangle è una struttura C: i campi vanno assegnati, passarli
        # al costruttore li lascia a zero e il menù finisce nell'angolo.
        r = Gdk.Rectangle()
        r.x, r.y, r.width, r.height = int(x), int(y), 1, 1
        pop.set_pointing_to(r)
        pop.set_has_arrow(False)
        pop.popup()
        return pop

    def _menu_for_item(self, it, widget, x, y):
        n = len(self.selection)
        molti = n > 1
        if it.kind == "home":
            voci = [(tr("Open Home Folder"), lambda: self.open(it)),
                    (tr("Open in Terminal"), lambda: self._launch("zeta-predefinita", "terminale",
                                                                cwd=os.path.expanduser("~")))]
        elif it.kind == "trash":
            voci = [(tr("Open Trash"), lambda: self.open(it)),
                    None,
                    (tr("Empty Trash…"), self.svuota_cestino)]
        else:
            voci = [
                (tr("Open") if not molti
                 else ntr("Open {n} Item", "Open {n} Items", n).format(n=n),
                 lambda: [self.open(i) for i in list(self.selection)]),
                None,
                (tr("Copy"), lambda: self.copia(False)),
                (tr("Cut"), lambda: self.copia(True)),
                None,
            ]
            if not molti:
                voci.append((tr("Rename…"), lambda: self.rename(it)))
            voci += [
                (tr("Move to Trash"), self.trash_selection),
                (tr("Delete Permanently…"), self.delete_selection),
                None,
            ]
            if not molti:
                if it.mime.startswith("image/"):
                    voci += [(tr("Copy Text from Image…"), lambda: self.ocr(it))]
                voci += [(tr("Change Icon…"), lambda: self.cambia_icona(it))]
                if _ha_icona_personale(it.path):
                    voci.append((tr("Restore Default Icon"),
                                 lambda: self.ripristina_icona(it)))
                voci += [(tr("Copy Path"), lambda: self.copy_path(it)),
                         (tr("Properties"), lambda: self.properties(it))]
        self._popover(widget, x, y, voci)

    def _on_desktop_right(self, gesture, _n, x, y):
        self._set_selection([])
        attuale = self.state.get("ordine", "nome")
        ordine = [("check", etichetta, modo == attuale, lambda m=modo: self.set_ordine(m))
                  for modo, etichetta in SORT_MODES]
        destra = self.state.get("lato") == "destra"
        misura = self.state.get("dimensione")
        vista = [
            ("check", tr("Align to Grid"), self._griglia(),
             lambda: self.set_griglia(not self._griglia())),
            None,
            ("check", tr("Arrange from Left"), not destra, lambda: self.set_lato("sinistra")),
            ("check", tr("Arrange from Right"), destra, lambda: self.set_lato("destra")),
            None,
        ] + [("check", etichetta, misura == valore, lambda v=valore: self.set_dimensione(v))
             for valore, etichetta in ICON_SIZES]
        # Ogni voce porta sulla sezione che promette: aprivano tutte la stessa
        # pagina in cima, e tre etichette diverse per lo stesso risultato
        # sembrano — giustamente — tre comandi rotti.
        # short, like the desktop menus of macOS and Windows: a long menu
        # opened in the middle of the screen does not fit above or below
        personalizza = [
            (tr("Theme and Colors…"), lambda: self._impostazioni("aspetto:accento")),
            (tr("Icons and Text…"), lambda: self._impostazioni("aspetto:tema")),
            (tr("Animations and Transparency…"), lambda: self._impostazioni("aspetto:effetti")),
            (tr("Bar and Dock…"), lambda: self._impostazioni("dock")),
            (tr("Lock Screen…"), lambda: self._impostazioni("schermo")),
            None,
            (tr("Display Settings…"), lambda: self._impostazioni("schermo")),
            (tr("System Settings…"), lambda: self._impostazioni(None)),
        ]
        nuovo = [
            (tr("Text Document…"), self.new_file),
            (tr("App Shortcut…"), self.new_launcher),
        ]
        voci = [
            (tr("New Folder…"), self.new_folder),
            ("sub", tr("New"), nuovo),
            (tr("Paste"), self.incolla),
            None,
            ("sub", tr("View"), vista),
            ("sub", tr("Sort By"), ordine),
            (tr("Clean Up Icons"), self.tidy),
            None,
            (tr("Change Wallpaper…"), lambda: self._impostazioni("aspetto:sfondo")),
            ("sub", tr("Customize"), personalizza),
            None,
            (tr("Open in Terminal"), lambda: self._launch("zeta-predefinita", "terminale", cwd=self.dir)),
            (tr("Show in File Manager"), self.open_folder),
        ]
        self._popover(self.fixed, x, y, voci)

    def set_ordine(self, modo):
        """Sort By: every icon is placed again, in that order."""
        self.state["ordine"] = modo
        self.state["posizioni"] = {}
        self.state["libere"] = {}
        save_state(self.state)
        self.refresh()

    def set_griglia(self, griglia):
        self.state["griglia"] = bool(griglia)
        if griglia:
            self.tidy()            # every icon into the nearest free cell
            return
        # without the grid every icon stays where it is, and can then be
        # dropped anywhere
        self.state["libere"] = {it.name: [it.x, it.y] for it in self.items}
        save_state(self.state)
        self.refresh()

    def set_lato(self, lato):
        """New icons, and Sort By, fill the desktop from this side."""
        if (self.state.get("lato") == "destra") == (lato == "destra"):
            return
        self.state["lato"] = lato
        self.set_ordine(self.state.get("ordine", "nome"))

    def _dimensione_icone(self):
        v = self.state.get("dimensione")
        return v if isinstance(v, int) and 28 <= v <= 72 else icon_size()

    def set_dimensione(self, valore):
        """Icon size of the desktop only (the Dock keeps its own); None
        follows the size chosen in Settings."""
        self.state["dimensione"] = valore
        self.isize = self._dimensione_icone()
        self.cell_w = self.isize + 54
        self.cell_h = self.isize + 46
        self._anteprime = {}
        save_state(self.state)
        self.tidy()

    def _impostazioni(self, pagina):
        self._launch("zeta-impostazioni", *( [pagina] if pagina else [] ))

    def _launch(self, *cmd, cwd=None):
        try:
            _avvia(list(cmd), start_new_session=True, cwd=cwd,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            self._error(tr("Couldn't start {name}: {error}").format(name=cmd[0], error=e))

    def open_folder(self):
        # il gestore file scelto in Impostazioni › App predefinite
        self._launch("zeta-predefinita", "file", self.dir)

    def copy_path(self, it):
        self._clipboard().set(it.path)

    # ------------------------------------------- testo dentro le immagini
    def ocr(self, it):
        """Legge il testo scritto dentro un'immagine e lo rende copiabile.

        Il riconoscimento puo' durare qualche secondo su una foto grande,
        quindi va in un thread: la scrivania non deve fermarsi per questo.
        Si prova prima in italiano e inglese insieme, che e' il caso normale
        di un documento fotografato.
        """
        if not shutil.which("tesseract"):
            self._error(tr("Text recognition is not available."))
            return
        d, box = self._dialog(tr("Text in Image"))
        box.append(Gtk.Label(label=it.display, xalign=0, css_classes=["title-4"]))
        attesa = Gtk.Label(label=tr("Reading the image…"), xalign=0,
                           css_classes=["dim-label"])
        box.append(attesa)
        vista = Gtk.TextView(editable=False, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                             cursor_visible=True)
        vista.set_size_request(-1, 240)
        scorri = Gtk.ScrolledWindow(child=vista, vexpand=True)
        scorri.set_visible(False)
        box.append(scorri)

        righe = Gtk.Box(spacing=8)
        copia = Gtk.Button(label=tr("Copy All"), sensitive=False)
        salva = Gtk.Button(label=tr("Save as Text File…"), sensitive=False)
        chiudi = Gtk.Button(label=tr("Close"), css_classes=["zeta-primary"],
                            halign=Gtk.Align.END, hexpand=True)
        chiudi.connect("clicked", lambda *_: d.destroy())
        righe.append(copia)
        righe.append(salva)
        righe.append(chiudi)
        box.append(righe)
        d.present()

        def fine(testo, errore):
            if errore:
                attesa.set_text(errore)
                return False
            if not testo.strip():
                attesa.set_text(tr("No readable text found in this image."))
                return False
            attesa.set_text(tr("Select what you need, or copy it all."))
            vista.get_buffer().set_text(testo)
            scorri.set_visible(True)
            copia.set_sensitive(True)
            salva.set_sensitive(True)
            copia.connect("clicked", lambda *_: (self._clipboard().set(testo),
                                                 copia.set_label(tr("Copied ✓"))))
            salva.connect("clicked", lambda *_: self._salva_testo(it, testo))
            return False

        def lavora():
            try:
                r = subprocess.run(["tesseract", it.path, "stdout", "-l", _registro_ocr().lingue()],
                                   capture_output=True, text=True, timeout=120)
                if r.returncode != 0:
                    GLib.idle_add(fine, "", tr("Couldn't read the image."))
                    return
                GLib.idle_add(fine, r.stdout, "")
            except subprocess.TimeoutExpired:
                GLib.idle_add(fine, "", tr("The image is too large: reading stopped."))
            except (OSError, subprocess.SubprocessError) as e:
                GLib.idle_add(fine, "", tr("Failed: {error}").format(error=e))

        threading.Thread(target=lavora, daemon=True).start()

    def _salva_testo(self, it, testo):
        """Scrive il testo riconosciuto accanto all'immagine, come .txt."""
        base = os.path.splitext(it.path)[0] + ".txt"
        dest = self._nome_libero(os.path.basename(base))
        try:
            with open(dest, "w", encoding="utf-8") as f:
                f.write(testo)
        except OSError as e:
            self._error(tr("Couldn't save: {error}").format(error=e))
            return
        self.refresh()
        self._info(tr("Saved"), tr("The text is in “{name}”, next to the image.").format(
            name=os.path.basename(dest)))

    # ------------------------------------------- icona scelta dall'utente
    def cambia_icona(self, it, poi=None):
        """Sceglie un'immagine e la usa come icona di questo elemento.

        «poi» viene chiamato con il percorso dell'icona: serve alla finestra
        delle Proprietà per aggiornare l'anteprima senza richiudersi.
        """
        dialog = Gtk.FileDialog(title=tr("Choose an image for the icon of {name}").format(
            name=it.display))
        filt = Gtk.FileFilter()
        filt.set_name(tr("Images"))
        for m in ("image/png", "image/svg+xml", "image/jpeg", "image/webp",
                  "image/bmp", "image/x-icon", "image/tiff"):
            filt.add_mime_type(m)
        filtri = Gio.ListStore.new(Gtk.FileFilter)
        filtri.append(filt)
        dialog.set_filters(filtri)
        # Senza finestra «genitore»: la scrivania e' uno strato (layer-shell),
        # non una finestra normale. Chiedere il selettore di file per suo conto
        # fa esportare a GTK una superficie che non lo permette, Hyprland
        # chiude la connessione e la scrivania cade: il selettore non compariva
        # mai («Cambia icona» sembrava non fare nulla, anche da Proprieta').
        dialog.open(None, None, lambda d, r: self._icona_scelta(d, r, it, poi))

    def _icona_scelta(self, dialog, result, it, poi=None):
        try:
            gfile = dialog.open_finish(result)
        except GLib.Error:
            return                      # l'utente ha annullato
        sorgente = gfile.get_path()
        if not sorgente:
            self._error(tr("That image is not a file on this computer."))
            return
        try:
            icona = _icona_personale(sorgente, it.name)
        except (OSError, GLib.Error, shutil.Error) as e:
            self._error(tr("Couldn't use that image: {error}").format(error=e))
            return
        if _desktop_proprio(it.path):
            try:
                _desktop_scrivi_icona(it.path, icona)
            except OSError as e:
                self._error(tr("Couldn't write the shortcut: {error}").format(error=e))
                return
        else:
            try:
                Gio.File.new_for_path(it.path).set_attribute_string(
                    "metadata::custom-icon",
                    Gio.File.new_for_path(icona).get_uri(),
                    Gio.FileQueryInfoFlags.NONE, None)
            except GLib.Error as e:
                self._error(tr("Couldn't save the icon choice: {error}").format(error=e.message))
                return
        self.refresh()
        if poi is not None:
            poi(icona)

    def ripristina_icona(self, it, poi=None):
        """Rimette l'icona che l'elemento aveva prima."""
        try:
            if _desktop_proprio(it.path):
                if not _desktop_scrivi_icona(it.path, None):
                    self._error(tr("This shortcut has no icon to restore."))
                    return
            else:
                Gio.File.new_for_path(it.path).set_attribute_string(
                    "metadata::custom-icon", "",
                    Gio.FileQueryInfoFlags.NONE, None)
        except (OSError, GLib.Error) as e:
            self._error(tr("Couldn't restore the icon: {error}").format(error=e))
            return
        self.refresh()
        if poi is not None:
            poi(None)

    def _gicon_di(self, it):
        """Ricalcola l'icona di un elemento: dopo un cambio quella in Item è vecchia."""
        try:
            info = Gio.File.new_for_path(it.path).query_info(
                "standard::icon,metadata::custom-icon",
                Gio.FileQueryInfoFlags.NONE, None)
        except GLib.Error:
            return Gio.ThemedIcon.new("text-x-generic")
        gicon = info.get_icon() or Gio.ThemedIcon.new("text-x-generic")
        if it.name.endswith(".desktop") or os.path.realpath(it.path).endswith(".desktop"):
            _, gicon = _nome_e_icona_collegamento(it.path, it.display, gicon)
        elif _e_programma(it.path):
            gicon = _icona_programma(it.path)
        custom = info.get_attribute_string("metadata::custom-icon")
        if custom:
            f = Gio.File.new_for_uri(custom)
            if f.query_exists(None):
                gicon = Gio.FileIcon.new(f)
        return gicon

    def properties(self, it):
        """Proprietà dell'elemento, con l'icona e il pulsante per cambiarla.

        Non si usa _info() perché qui non c'è solo del testo: l'icona si vede e
        si cambia da qui, che è il posto dove la si cerca.
        """
        try:
            st = os.stat(it.path)
        except OSError as e:
            self._error(str(e))
            return
        kind = tr("Folder") if it.is_dir else (
            tr("Program shortcut")
            if os.path.realpath(it.path).endswith(".desktop") or _e_programma(it.path)
            else tr("File"))
        size = "—" if it.is_dir else _human(st.st_size)
        d, box = self._dialog(tr("Properties"))

        testa = Gtk.Box(spacing=14)
        img = Gtk.Image.new_from_gicon(it.gicon)
        img.set_pixel_size(64)
        testa.append(img)
        dettagli = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                           valign=Gtk.Align.CENTER)
        nome = Gtk.Label(label=it.display, xalign=0, wrap=True,
                         css_classes=["title-4"])
        dettagli.append(nome)
        dettagli.append(Gtk.Label(label="%s · %s" % (kind, size), xalign=0,
                                  css_classes=["dim-label"]))
        testa.append(dettagli)
        box.append(testa)

        percorso = Gtk.Label(label=it.path, xalign=0, wrap=True, selectable=True,
                             focusable=False, css_classes=["dim-label"])
        box.append(percorso)

        ripristina = Gtk.Button(label=tr("Restore Default Icon"))
        ripristina.set_visible(_ha_icona_personale(it.path))

        def aggiornata(_icona=None):
            it.gicon = self._gicon_di(it)
            img.set_from_gicon(it.gicon)
            img.set_pixel_size(64)
            ripristina.set_visible(_ha_icona_personale(it.path))

        cambia = Gtk.Button(label=tr("Change Icon…"))
        cambia.connect("clicked", lambda *_: self.cambia_icona(it, aggiornata))
        ripristina.connect("clicked", lambda *_: self.ripristina_icona(it, aggiornata))

        righe = Gtk.Box(spacing=8)
        righe.append(cambia)
        righe.append(ripristina)
        chiudi = Gtk.Button(label=tr("Close"), css_classes=["zeta-primary"],
                            halign=Gtk.Align.END, hexpand=True)
        chiudi.connect("clicked", lambda *_: d.destroy())
        righe.append(chiudi)
        box.append(righe)
        d.present()
        chiudi.grab_focus()

    # ---------------------------------------- operazioni sui file
    def new_folder(self):
        self._ask(tr("New Folder"), tr("Folder name:"), tr("New Folder"),
                  lambda name: self._create(name, folder=True))

    def new_file(self):
        self._ask(tr("New Document"), tr("Document name:"), tr("New Document.txt"),
                  lambda name: self._create(name, folder=False))

    def new_launcher(self):
        """Crea sulla scrivania un collegamento a un'applicazione installata."""
        apps = _registro().menu()      # le stesse app (nomi, icone) del menu
        if not apps:
            self._error(tr("No installed apps to link."))
            return
        self._scegli_app(apps)

    def _scegli_app(self, apps):
        win = Gtk.Window(title=tr("New Shortcut"), modal=True, default_width=420,
                         default_height=520, css_classes=["zeta-dialog"])
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=14,
                      margin_bottom=14, margin_start=14, margin_end=14)
        filtro = Gtk.SearchEntry(placeholder_text=tr("Search for an app…"))
        lista = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE,
                            css_classes=["boxed-list"])
        scroll = Gtk.ScrolledWindow(vexpand=True, child=lista)

        def riempi(testo=""):
            c = lista.get_first_child()
            while c:
                lista.remove(c)
                c = lista.get_first_child()
            t = testo.casefold()
            for a in apps:
                nome = a.nome
                if t and t not in nome.casefold():
                    continue
                riga = Gtk.Box(spacing=10, margin_top=6, margin_bottom=6,
                               margin_start=8, margin_end=8)
                img = Gtk.Image(pixel_size=24)
                try:
                    img.set_from_gicon(Gio.Icon.new_for_string(a.icona or "application-x-executable"))
                except GLib.Error:
                    img.set_from_icon_name("application-x-executable")
                riga.append(img)
                riga.append(Gtk.Label(label=nome, xalign=0, hexpand=True))
                r = Gtk.ListBoxRow(child=riga)
                r.app = a
                lista.append(r)

        riempi()
        filtro.connect("search-changed", lambda e: riempi(e.get_text()))

        def crea(*_a):
            riga = lista.get_selected_row()
            if riga is None:
                return
            self._crea_collegamento(riga.app)
            win.close()

        lista.connect("row-activated", crea)
        pulsanti = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        annulla = Gtk.Button(label=tr("Cancel"))
        annulla.connect("clicked", lambda *_: win.close())
        ok = Gtk.Button(label=tr("Create"), css_classes=["suggested-action"])
        ok.connect("clicked", crea)
        pulsanti.append(annulla)
        pulsanti.append(ok)
        box.append(filtro)
        box.append(scroll)
        box.append(pulsanti)
        win.set_child(box)
        win.present()

    def _crea_collegamento(self, app):
        # Lo stesso collegamento del menu delle app (tasto destro › Aggiungi
        # alla Scrivania): copia della voce, comando completo per i programmi
        # in /opt, segnato come fidato, mai due volte la stessa app.
        ok, msg = _registro().aggiungi_scrivania(app)
        if not ok:
            self._error(msg)
        self.refresh()

    def _create(self, name, folder):
        name = (name or "").strip().strip("/")
        if not name:
            return
        path = os.path.join(self.dir, name)
        if os.path.exists(path):
            self._error(tr("“{name}” already exists.").format(name=name))
            return
        try:
            if folder:
                os.mkdir(path)
            else:
                open(path, "x").close()
        except OSError as e:
            self._error(tr("Couldn't create “{name}”: {error}").format(name=name, error=e.strerror))
            return
        self.refresh()

    def rename(self, it):
        self._ask(tr("Rename"), tr("New name for “{name}”:").format(name=it.display), it.name,
                  lambda name: self._do_rename(it, name))

    def _do_rename(self, it, name):
        name = (name or "").strip().strip("/")
        if not name or name == it.name:
            return
        dest = os.path.join(self.dir, name)
        if os.path.exists(dest):
            self._error(tr("“{name}” already exists.").format(name=name))
            return
        try:
            os.rename(it.path, dest)
        except OSError as e:
            self._error(tr("Couldn't rename: {error}").format(error=e.strerror))
            return
        for chiave in ("posizioni", "libere"):
            pos = self.state.setdefault(chiave, {})
            if it.name in pos:
                pos[name] = pos.pop(it.name)
        save_state(self.state)
        self.refresh()

    def _trash_path(self, path):
        if not path:
            return False
        try:
            Gio.File.new_for_path(path).trash(None)
            return True
        except GLib.Error as e:
            self._error(tr("Couldn't move “{name}” to the Trash: {error}").format(
                name=os.path.basename(path), error=e.message))
            return False

    def trash_selection(self):
        for it in [i for i in self.selection if not i.speciale]:
            self._trash_path(it.path)
        self._set_selection([])
        self.refresh()

    def delete_selection(self):
        elementi = [i for i in self.selection if not i.speciale]
        if not elementi:
            return
        quali = (elementi[0].display if len(elementi) == 1
                 else ntr("{n} item", "{n} items", len(elementi)).format(n=len(elementi)))
        self._confirm(tr("Permanently delete {what}?").format(what=quali),
                      tr("They won't go to the Trash and can't be recovered."),
                      lambda: self._do_delete(elementi))

    def _do_delete(self, elementi):
        for it in elementi:
            try:
                if it.is_dir:
                    shutil.rmtree(it.path)
                else:
                    os.remove(it.path)
            except OSError as e:
                self._error(tr("Couldn't delete “{name}”: {error}").format(
                    name=it.display, error=e.strerror))
        self._set_selection([])
        self.refresh()

    def svuota_cestino(self):
        n = trash_count()
        if not n:
            self._info(tr("Trash"), tr("The Trash is already empty."))
            return
        self._confirm(tr("Empty the Trash?"),
                      ntr("{n} item will be permanently deleted.",
                          "{n} items will be permanently deleted.", n).format(n=n),
                      self._do_svuota)

    def _do_svuota(self):
        base = trash_dir()
        for sub in ("files", "info"):
            d = os.path.join(base, sub)
            try:
                for name in os.listdir(d):
                    p = os.path.join(d, name)
                    if os.path.isdir(p) and not os.path.islink(p):
                        shutil.rmtree(p, ignore_errors=True)
                    else:
                        os.remove(p)
            except OSError:
                pass
        self.refresh()

    def tidy(self):
        """Clean Up Icons: each icon into the nearest free cell, keeping the
        arrangement (macOS "Clean Up"); Sort By puts them in order instead."""
        cols, rows = self._grid_size()
        passo_x, passo_y = self.cell_w + self.gap, self.cell_h + self.gap
        pos, taken = {}, set()
        for it in sorted(self.items, key=lambda i: (i.y, i.x)):
            migliore = None
            for c in range(cols):
                for r in range(rows):
                    if (c, r) in taken:
                        continue
                    x, y = self._slot_xy(c, r)
                    d = ((x - it.x) / passo_x) ** 2 + ((y - it.y) / passo_y) ** 2
                    if migliore is None or d < migliore[0]:
                        migliore = (d, c, r)
            if migliore is None:
                break
            taken.add(migliore[1:])
            pos[it.name] = list(migliore[1:])
        self.state["posizioni"] = pos
        self.state["libere"] = {n: list(self._slot_xy(*cr)) for n, cr in pos.items()}
        save_state(self.state)
        self.refresh()

    # ---------------------------------------- finestrelle
    def _dialog(self, title):
        d = Gtk.Window(transient_for=self, modal=True, title=title,
                       default_width=380, resizable=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18,
                      margin_bottom=18, margin_start=18, margin_end=18)
        d.set_child(box)
        return d, box

    def _ask(self, title, prompt, preset, on_ok):
        d, box = self._dialog(title)
        box.append(Gtk.Label(label=prompt, xalign=0, wrap=True))
        entry = Gtk.Entry(text=preset, css_classes=["zeta-entry"], activates_default=True)
        box.append(entry)
        row = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        annulla = Gtk.Button(label=tr("Cancel"))
        ok = Gtk.Button(label=tr("Confirm"), css_classes=["zeta-primary"])
        annulla.connect("clicked", lambda *_: d.destroy())
        ok.connect("clicked", lambda *_: (on_ok(entry.get_text()), d.destroy()))
        entry.connect("activate", lambda *_: (on_ok(entry.get_text()), d.destroy()))
        row.append(annulla)
        row.append(ok)
        box.append(row)
        d.present()
        entry.grab_focus()

    def _confirm(self, title, testo, on_ok):
        d, box = self._dialog(title)
        box.append(Gtk.Label(label=title, xalign=0, wrap=True, css_classes=["zeta-title"]))
        box.append(Gtk.Label(label=testo, xalign=0, wrap=True, css_classes=["zeta-dim"]))
        row = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        annulla = Gtk.Button(label=tr("Cancel"))
        ok = Gtk.Button(label=tr("Delete"), css_classes=["destructive-action"])
        annulla.connect("clicked", lambda *_: d.destroy())
        ok.connect("clicked", lambda *_: (on_ok(), d.destroy()))
        row.append(annulla)
        row.append(ok)
        box.append(row)
        d.present()

    def _info(self, title, testo):
        d, box = self._dialog(title)
        box.append(Gtk.Label(label=testo, xalign=0, wrap=True, max_width_chars=60))
        ok = Gtk.Button(label=tr("Close"), halign=Gtk.Align.END, css_classes=["zeta-primary"])
        ok.connect("clicked", lambda *_: d.destroy())
        box.append(ok)
        d.set_default_widget(ok)
        d.present()
        ok.grab_focus()           # non il testo: appariva tutto selezionato

    def _error(self, testo):
        self._info(tr("Operation failed"), testo)


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Scrivania",
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_startup(self):
        Gtk.Application.do_startup(self)
        popup.clean_env()
        popup.load_css(CSS)

    def do_activate(self):
        (self.props.active_window or Scrivania(self)).present()


if __name__ == "__main__":
    if "--stato" in sys.argv:
        print("folder: %s" % desktop_dir())
        print("icons enabled: %s" % icone_attive())
        print("trash: %d item(s)" % trash_count())
        print("state: %s" % json.dumps(load_state(), ensure_ascii=False))
        sys.exit(0)
    if not icone_attive():
        sys.exit(0)
    sys.exit(App().run([sys.argv[0]]))

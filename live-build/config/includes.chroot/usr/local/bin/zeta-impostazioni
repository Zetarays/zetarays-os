        prova = Adw.ActionRow(title="Prova una notifica",
                              subtitle="Per vedere posizione e durata")
        b = Gtk.Button(label="Prova", valign=Gtk.Align.CENTER)
        b.connect("clicked", lambda *_: launch(
            "notify-send", "ZETA RAYS", "Le notifiche funzionano."))
        prova.add_suffix(b)
        g.add(prova)
        page.add(g)
        return page

    def _switch(self, titolo, sotto, key):
        row = Adw.SwitchRow(title=titolo, subtitle=sotto)
        row.set_active(self._asp(key) == "1")
        row.connect("notify::active",
                    lambda r, _p, k=key: self.set_aspetto(k, "1" if r.get_active() else "0"))
        return row

    # --- Tema e dimensioni (zeta-aspetto) ---
    def _asp(self, key):
        """Valore attuale di una preferenza.

        I valori li tiene zeta-aspetto, che è l'unico posto dove vivono: qui non
        se ne conserva una seconda copia, che finirebbe per divergere. Si legge
        tutto in una volta sola e si tiene in cache: una pagina ne consulta una
        dozzina, e lanciare un sottoprocesso per ciascuna rendeva lenta
        l'apertura delle Impostazioni.
        """
        valori = getattr(self, "_asp_cache", None)
        if valori is None:
            valori = self._asp_cache = self._leggi_aspetto()
        return valori.get(key, "")

    @staticmethod
    def _leggi_aspetto():
        try:
            out = subprocess.run(["zeta-aspetto", "get"], capture_output=True,
                                 text=True, timeout=10).stdout
        except (OSError, subprocess.SubprocessError) as e:
            print("impostazioni: zeta-aspetto non risponde: %s" % e, file=sys.stderr)
            return {}
        valori = {}
        for line in out.splitlines():
            k, _, v = line.partition("=")
            if k:
                valori[k.strip()] = v.strip()
        return valori

    def _spin(self, titolo, sotto, key, lo, hi):
        adj = Gtk.Adjustment(lower=lo, upper=hi, step_increment=1, page_increment=2)
        row = Adw.SpinRow(title=titolo, subtitle=sotto, adjustment=adj)
        try:
            row.set_value(int(self._asp(key)))
        except ValueError:
            row.set_value(lo)
        row.connect("notify::value",
                    lambda r, _p, k=key: self.set_aspetto(k, str(int(r.get_value())),
                                                          ritardo=600))
        return row

    def set_aspetto(self, key, value, ritardo=0):
        """Applica un valore. Con «ritardo» si attende la fine della regolazione:
        girando la rotellina non si rigenera il tema a ogni scatto."""
        if not ritardo:
            self._apply_aspetto(key, value)
            return
        timers = getattr(self, "_asp_timers", None)
        if timers is None:
            timers = self._asp_timers = {}
        if key in timers:
            GLib.source_remove(timers[key])
        timers[key] = GLib.timeout_add(ritardo, self._apply_later, key, value)

    def _apply_later(self, key, value):
        self._asp_timers.pop(key, None)
        self._apply_aspetto(key, value)
        return False

    def _comando_lento(self, cmd, ok_msg, ko_msg, poi=None):
        """Esegue un comando che può durare secondi, senza bloccare la finestra.

        zeta-sfondo e zeta-accent rigenerano immagini, colori e configurazioni
        di tutte le app e ricaricano la barra: sul filo dell'interfaccia
        significherebbe una finestra sorda ai clic per tutto quel tempo.
        """
        def lavora():
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
                esito = (r.returncode == 0, (r.stderr or "").strip())
            except subprocess.TimeoutExpired:
                esito = (False, "il comando non è terminato in tempo")
            except OSError as e:
                esito = (False, str(e))
            GLib.idle_add(finito, esito)

        def finito(esito):
            ok, motivo = esito
            if ok:
                self.toast(ok_msg)
            else:
                print("impostazioni: %s (%s)" % (ko_msg, motivo or "senza dettagli"),
                      file=sys.stderr)
                self.toast(ko_msg)
            if poi:
                poi(ok)
            return False

        threading.Thread(target=lavora, daemon=True).start()

    def _apply_aspetto(self, key, value):
        """Scrive e applica una preferenza, senza bloccare la finestra.

        «zeta-aspetto set» non si limita a salvare: rigenera i colori di tutte
        le app, ricarica la barra e, per alcune chiavi, riavvia le icone della
        scrivania. Sono secondi interi. Eseguirlo qui, sul filo dell'interfaccia,
        significava una finestra che non risponde più ai clic finché non
        finisce: per questo va in un thread a parte.
        """
        # La cache va invalidata subito: se l'utente riapre la pagina prima che
        # il comando finisca, deve comunque vedere il valore che ha scelto.
        cache = getattr(self, "_asp_cache", None)
        if cache is not None:
            cache[key] = value

        def lavora():
            try:
                r = subprocess.run(["zeta-aspetto", "set", key, value],
                                   capture_output=True, text=True, timeout=60)
                esito = (r.returncode == 0, (r.stderr or "").strip())
            except subprocess.TimeoutExpired:
                esito = (False, "l'applicazione della modifica non è terminata in tempo")
            except OSError as e:
                esito = (False, str(e))
            GLib.idle_add(self._aspetto_finito, key, esito)

        threading.Thread(target=lavora, daemon=True).start()

    def _aspetto_finito(self, key, esito):
        ok, motivo = esito
        if ok:
            self.toast("Aspetto aggiornato")
        else:
            print("impostazioni: «%s» non applicata: %s" % (key, motivo), file=sys.stderr)
            self.toast("Non è stato possibile applicare «%s»" % key)
        if key == "tema":
            # Senza questa, cambiando il tema da qui tutta la scrivania cambiava
            # tranne questa finestra, che restava dei colori di prima.
            tema.ricarica()
        # Il comando può aver corretto un valore fuori intervallo: si rilegge.
        self._asp_cache = self._leggi_aspetto()
        return False

    def on_scala(self, combo, _param):
        idx = combo.get_selected()
        if 0 <= idx < len(self._scale_ids):
            self.set_aspetto("scala", self._scale_ids[idx])

    # --- Sfondo ---
    def _wallpaper_state(self):
        try:
            out = subprocess.run(["zeta-sfondo", "get"], capture_output=True,
                                 text=True, timeout=5).stdout.split("\n")
            return out[0].strip(), (out[1].strip() if len(out) > 1 else "fill")
        except (OSError, subprocess.SubprocessError, IndexError):
            return "", "fill"

    def _wallpaper_label(self):
        path, _ = self._wallpaper_state()
        if not path:
            return "Sfondo di ZETA RAYS"
        if path.endswith("wallpaper.png"):
            return "Sfondo di ZETA RAYS (generato dal colore)"
        ufficiale = sfondi.nome_di(path)
        if ufficiale:
            return "%s (sfondo di ZETA RAYS)" % ufficiale
        # immagine dell'utente: dentro ~/.config/zeta si chiama «sfondo.jpg»,
        # si mostra il nome che aveva quando è stata scelta
        try:
            with open(os.path.expanduser("~/.config/zeta/wallpaper.json")) as f:
                nome = json.load(f).get("nome")
        except (OSError, ValueError, AttributeError):
            nome = None
        return nome or os.path.basename(path)

    def _segna_sfondo(self):
        path, _ = self._wallpaper_state()
        for b in getattr(self, "sfondi_bottoni", []):
            if b.percorso == path:
                b.add_css_class("selected")
            else:
                b.remove_css_class("selected")

    def _dopo_sfondo(self, _ok=True):
        self.sfondo_row.set_subtitle(self._wallpaper_label())
        self._segna_sfondo()

    def on_sfondo_ufficiale(self, percorso):
        self._comando_lento(["zeta-sfondo", "set", percorso, self._wallpaper_mode()],
                            "Sfondo aggiornato",
                            "Non è stato possibile impostare lo sfondo",
                            poi=self._dopo_sfondo)

    def _wallpaper_mode(self):
        return self._wallpaper_state()[1]

    def on_pick_wallpaper(self):
        dialog = Gtk.FileDialog(title="Scegli un'immagine per lo sfondo")
        filt = Gtk.FileFilter()
        filt.set_name("Immagini")
        for m in ("image/png", "image/jpeg", "image/webp", "image/bmp"):
            filt.add_mime_type(m)
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(filt)
        dialog.set_filters(filters)
        dialog.open(self, None, self._wallpaper_chosen)

    def _wallpaper_chosen(self, dialog, result):
        try:
            gfile = dialog.open_finish(result)
        except GLib.Error:
            return
        path = gfile.get_path()
        if not path:
            return
        self._comando_lento(["zeta-sfondo", "set", path, self._wallpaper_mode()],
                            "Sfondo aggiornato",
                            "Non è stato possibile impostare lo sfondo",
                            poi=self._dopo_sfondo)

    def on_reset_wallpaper(self):
        self._comando_lento(["zeta-sfondo", "reset"],
                            "Sfondo di ZETA RAYS ripristinato",
                            "Non è stato possibile ripristinare lo sfondo",
                            poi=self._dopo_sfondo)

    def on_wallpaper_mode(self, combo, _param):
        idx = combo.get_selected()
        if 0 <= idx < len(self._mode_ids):
            self._comando_lento(["zeta-sfondo", "mode", self._mode_ids[idx]],
                                "Adattamento dello sfondo aggiornato",
                                "Non è stato possibile cambiare l'adattamento")

    def on_custom(self, _button):
        dialog = Gtk.ColorDialog(title="Colore d'accento", with_alpha=False)
        initial = Gdk.RGBA()
        initial.parse(read_accent())
        dialog.choose_rgba(self, initial, None, self.on_custom_chosen)

    def on_custom_chosen(self, dialog, result):
        try:
            c = dialog.choose_rgba_finish(result)
        except GLib.Error:
            return
        self.set_accent("#%02X%02X%02X" % (round(c.red * 255), round(c.green * 255), round(c.blue * 255)))

    def set_accent(self, color):
        if color.upper() == read_accent():
            return
        # Il colore selezionato si segna subito: l'utente deve vedere la scelta
        # recepita mentre i colori di tutte le app vengono rigenerati.
        self.mark_selected(color.upper())
        self._comando_lento(["zeta-accent", color],
                            "Colore d'accento aggiornato",
                            "Non è stato possibile applicare il colore",
                            poi=lambda ok: None if ok else self.mark_selected(read_accent()))

    def mark_selected(self, color):
        known = False
        for b in self.swatch_buttons:
            if b.color == color:
                b.add_css_class("selected")
                known = True
            else:
                b.remove_css_class("selected")
        if known:
            self.custom_button.remove_css_class("selected")
        else:
            self.custom_button.add_css_class("selected")

    # --- Dock ---
    def _render_dock(self):
        # svuota la pagina
        for g in getattr(self, "_dock_groups", []):
            self.dock_page.remove(g)
        self._dock_groups = []

        group = Adw.PreferencesGroup(
            title="Applicazioni nel dock",
            description="Trascina un'app per cambiarne il posto. Col tasto destro su un'icona "
                        "del dock: Apri, Rimuovi dal Dock, Opzioni, Impostazioni dell'app.")
        n = len(self.dock_entries)
        for i, entry in enumerate(self.dock_entries):
            row = Adw.ActionRow(title=entry.get("name") or entry.get("cmd", ""),
                                subtitle=entry.get("cmd", ""))
            icon = dockmod.resolve_icon(entry.get("icon", ""))
            img = Gtk.Image.new_from_file(icon) if os.path.exists(icon) else Gtk.Image.new_from_icon_name("application-x-executable")
            img.set_pixel_size(28)
            row.add_prefix(img)
            # add_prefix mette davanti: la maniglia, aggiunta dopo, sta a sinistra
            maniglia = Gtk.Image.new_from_icon_name("list-drag-handle-symbolic")
            maniglia.add_css_class("dim-label")
            maniglia.set_tooltip_text("Trascina per spostare")
            row.add_prefix(maniglia)
            # trascina e rilascia: la riga porta con se' la sua posizione
            src = Gtk.DragSource(actions=Gdk.DragAction.MOVE)
            src.connect("prepare", lambda _s, _x, _y, i=i: Gdk.ContentProvider.new_for_value(
                GObject.Value(GObject.TYPE_STRING, str(i))))
            src.connect("drag-begin", lambda s, _d, r=row: s.set_icon(Gtk.WidgetPaintable.new(r), 24, 24))
            row.add_controller(src)
            dst = Gtk.DropTarget.new(GObject.TYPE_STRING, Gdk.DragAction.MOVE)
            dst.connect("drop", lambda _t, val, _x, _y, j=i: self._dock_sposta(val, j))
            row.add_controller(dst)
            rem = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER,
                             tooltip_text="Rimuovi dal Dock", css_classes=["flat"])
            rem.set_sensitive(n > 1)
            rem.connect("clicked", lambda _b, i=i: self._dock_remove(i))
            row.add_suffix(rem)
            group.add(row)
        self.dock_page.add(group)
        self._dock_groups.append(group)

        posizione = Adw.PreferencesGroup(title="Barra")
        self._dock_pos_ids = ["bottom", "top"]
        riga = Adw.ComboRow(title="Posizione della barra",
                            model=Gtk.StringList.new(["In basso", "In alto"]))
        corrente = self._asp("dock-posizione")
        riga.set_selected(self._dock_pos_ids.index(corrente)
                          if corrente in self._dock_pos_ids else 0)
        riga.connect("notify::selected",
                     lambda c, _p: self.set_aspetto(
                         "dock-posizione", self._dock_pos_ids[c.get_selected()]))
        posizione.add(riga)
        posizione.add(self._spin("Dimensione delle icone", "Icone del dock",
                                 "icon-size", 28, 64))
        self.dock_page.add(posizione)
        self._dock_groups.append(posizione)

        actions = Adw.PreferencesGroup()
        add = Adw.ActionRow(title="Aggiungi un'applicazione", activatable=True)
        add.add_prefix(Gtk.Image.new_from_icon_name("list-add-symbolic"))
        add.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        add.connect("activated", lambda *_: self._dock_add_dialog())
        actions.add(add)
        reset = Adw.ActionRow(title="Ripristina il dock predefinito", activatable=True)
        reset.add_prefix(Gtk.Image.new_from_icon_name("view-refresh-symbolic"))
        reset.connect("activated", lambda *_: self._dock_reset())
        actions.add(reset)
        self.dock_page.add(actions)
        self._dock_groups.append(actions)

    def _dock_save(self):
        dockmod.save_dock(self.dock_entries)
        dockmod.apply(self.dock_entries)
        self._render_dock()

    def _dock_sposta(self, da, a):
        """Rilascio di una riga trascinata: l'app va al posto di quella sotto."""
        try:
            da = int(da)
        except (TypeError, ValueError):
            return False
        if da == a or not (0 <= da < len(self.dock_entries)) or not (0 <= a < len(self.dock_entries)):
            return False
        voce = self.dock_entries.pop(da)
        self.dock_entries.insert(a, voce)
        # dopo il rilascio: ricostruire la pagina durante il trascinamento
        # toglierebbe da sotto il puntatore la riga ancora in uso
        GLib.idle_add(lambda: (self._dock_save(), False)[1])
        return True

    def _dock_remove(self, i):
        if len(self.dock_entries) > 1:
            del self.dock_entries[i]
            self._dock_save()
            self.toast("App rimossa dal dock")

    def _dock_reset(self):
        self.dock_entries = list(dockmod.DEFAULT)
        self._dock_save()
        self.toast("Dock ripristinato")

    def _dock_add_dialog(self):
        dlg = Adw.Window(transient_for=self, modal=True, title="Aggiungi al dock",
                         default_width=420, default_height=560)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        search = Gtk.SearchEntry(placeholder_text="Cerca…", margin_start=10, margin_end=10, margin_top=8)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(search)
        listbox = Gtk.ListBox(css_classes=["boxed-list"], margin_start=10, margin_end=10,
                              margin_top=8, margin_bottom=10, selection_mode=Gtk.SelectionMode.NONE)
        apps = dockmod.installed_apps()
        present = dockmod.presenti() | {e.get("app") for e in self.dock_entries if e.get("app")}

        def build(query=""):
            child = listbox.get_first_child()
            while child:
                listbox.remove(child)
                child = listbox.get_first_child()
            for app in apps:
                if app["id"] in present:
                    continue
                if query and query.lower() not in app["name"].lower():
                    continue
                row = Adw.ActionRow(title=app["name"], subtitle=app["exec"], activatable=True)
                icon = dockmod.resolve_icon(app.get("icon", ""))
                img = Gtk.Image.new_from_file(icon) if os.path.exists(icon) else Gtk.Image.new_from_icon_name("application-x-executable")
                img.set_pixel_size(24)
                row.add_prefix(img)
                row.connect("activated", lambda _r, a=app: self._dock_add(a, dlg))
                listbox.append(row)
        build()
        search.connect("search-changed", lambda e: build(e.get_text()))
        scroller = Gtk.ScrolledWindow(vexpand=True)
        scroller.set_child(listbox)
        box.append(scroller)
        view.set_content(box)
        dlg.set_content(view)
        dlg.present()

    def _dock_add(self, app, dlg):
        self.dock_entries.append(dockmod.entry_from_desktop(app))
        self._dock_save()
        self.toast("%s aggiunta al dock" % app["name"])
        dlg.close()

    # --- AI (ZETA RAYS Intelligence) ---
    def page_ai(self):
        sys.path.insert(0, "/usr/lib/zeta")
        try:
            from ui import pagina_ai
            page, pg = pagina_ai.costruisci(self)
        except Exception as e:  # noqa: BLE001 - la pagina non deve far cadere le Impostazioni
            print("impostazioni: pagina AI: %s" % e, file=sys.stderr)
            page = Adw.PreferencesPage()
            g = Adw.PreferencesGroup(title="AI")
            g.add(Adw.ActionRow(title="ZETA RAYS Intelligence non disponibile", subtitle=str(e)))
            page.add(g)
            return page

        # Il modello locale occupa circa 1,8 GB. Tenerlo pronto rende immediata
        # la prima risposta, ma su un computer con poca RAM è proprio ciò che
        # rallenta tutto il resto: per questo «automatico» decide dalla memoria.
        self._precarico = ["auto", "1", "0"]
        # La decisione e quella di intelligence/risorse.py: qui la si mostra
        # soltanto, senza ripetere la soglia (prima era copiata a mano).
        from intelligence import risorse
        gb = risorse.memoria_nominale_gb()
        auto_fa = ("tiene il modello pronto" if risorse.precarico_consentito()
                   else "lo carica quando apri ZETA")
        riga_pre = Adw.ComboRow(
            title="Modello AI sempre pronto",
            subtitle="Automatico su questo computer (%.0f GB): %s" % (gb, auto_fa),
            model=Gtk.StringList.new(["Automatico", "Sempre pronto (~1,8 GB occupati)",
                                      "Solo quando serve"]))
        try:
            riga_pre.set_selected(self._precarico.index(self._asp("ai-precarica")))
        except ValueError:
            riga_pre.set_selected(0)
        riga_pre.connect("notify::selected",
                         lambda c, _p: self.set_aspetto("ai-precarica",
                                                        self._precarico[c.get_selected()]))
        pg.add(riga_pre)
        return page

    # --- Informazioni ---
    def page_info(self):
        page = Adw.PreferencesPage()
        head = Adw.PreferencesGroup()
        logo = Gtk.Picture.new_for_filename("/usr/share/zeta/brand/zeta-logo-bianco.svg")
        logo.set_size_request(-1, 150)
        logo.set_margin_top(12)
        logo.set_margin_bottom(12)
        head.add(logo)
        page.add(head)

        info = os_release()
        group = Adw.PreferencesGroup()
        rows = [
            ("Sistema", info.get("PRETTY_NAME", "ZETA RAYS OS")),
            ("Versione", info.get("VERSION_ID", "1.7")),
            ("Architettura", platform.machine()),
            ("Kernel", "Linux %s" % platform.release().split("+")[0].split("-")[0]),
            ("Ambiente", "ZETA RAYS Shell"),
            ("Intelligenza", "ZETA RAYS Intelligence · Built with Llama"),
            ("Sicurezza", "ZETA RAYS Security"),
            ("Licenza", "Software libero · GPL-3.0"),
            ("Processore", cpu_name()),
            ("Memoria", mem_total()),
        ]
        for title, value in rows:
            row = Adw.ActionRow(title=title)
            row.add_suffix(Gtk.Label(label=value, css_classes=["dim-label"], selectable=True))
            group.add(row)
        page.add(group)

        # Documenti legali. Esistono nell'immagine: senza una voce qui nessuno
        # li troverebbe, ed è proprio quello che non deve succedere a un
        # documento che dice che cosa esce dal computer.
        legale = Adw.PreferencesGroup(
            title="Licenze e condizioni",
            description="Che cosa c'è dentro il sistema, con quali licenze, e che cosa esce dal computer.")
        for titolo, sotto, file in (
                ("Software di terze parti e licenze",
                 "I componenti inclusi, con licenza e provenienza", "LICENZE.md"),
                ("Privacy", "Quali dati lasciano il computer, verso chi, e come fermarli",
                 "PRIVACY.md"),
                ("Condizioni d'uso", "Licenze, garanzia, marchi", "CONDIZIONI.md"),
                ("Elenco completo dei componenti",
                 "Tutti i pacchetti con versione e licenza (foglio di calcolo)",
                 "COMPONENTI.csv"),
                ("Modello AI: Llama 3.2",
                 "Built with Llama — licenza Llama 3.2 Community License di Meta",
                 "llama-3.2/LICENSE.txt")):
            r = Adw.ActionRow(title=titolo, subtitle=sotto, activatable=True)
            r.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
            r.connect("activated", lambda _r, f=file: self._apri_legale(f))
            legale.add(r)
        page.add(legale)
        return page

    @staticmethod
    def _apri_legale(nome):
        percorso = "/usr/share/zeta/legale/%s" % nome
        if not os.path.exists(percorso):
            print("impostazioni: documento mancante: %s" % percorso, file=sys.stderr)
            return
        try:
            subprocess.Popen(["gio", "open", percorso], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            print("impostazioni: non riesco ad aprire %s: %s" % (percorso, e),
                  file=sys.stderr)


def _trova_scorrevole(widget):
    """Il Gtk.ScrolledWindow dentro una Adw.PreferencesPage (ricerca in ampiezza)."""
    coda = [widget]
    while coda:
        w = coda.pop(0)
        if isinstance(w, Gtk.ScrolledWindow):
            return w
        c = w.get_first_child()
        while c:
            coda.append(c)
            c = c.get_next_sibling()
    return None


def read_first(path):
    try:
        with open(path) as f:
            return f.readline().strip()
    except OSError:
        return "—"


def os_release():
    data = {}
    try:
        with open("/etc/os-release") as f:
            for line in f:
                if "=" in line:
                    k, v = line.strip().split("=", 1)
                    data[k] = v.strip('"')
    except OSError:
        pass
    return data


def cpu_name():
    try:
        with open("/proc/cpuinfo") as f:
            for line in f:
                if line.startswith("model name"):
                    return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return platform.machine()


def mem_total():
    try:
        with open("/proc/meminfo") as f:
            kb = int(f.readline().split()[1])
        return "%.1f GB" % (kb / 1024 / 1024)
    except (OSError, ValueError, IndexError):
        return "—"


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Impostazioni", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        tema.apply(CSS)
        win = self.props.active_window or Window(self)
        # "aspetto" apre la pagina; "aspetto:sfondo" la apre già sulla sezione
        # dello sfondo (lo usa il menù di tasto destro della scrivania).
        args = [a for a in sys.argv[1:] if a not in ("--page", "-p")]
        start, _, ancora = (args[0] if args else "").partition(":")
        if start in win.pages:
            win.show(start, TITLES.get(start, start), ancora or None)
        win.present()


if __name__ == "__main__":
    App().run([sys.argv[0]])  # gli argomenti li leggiamo da sys.argv in do_activate

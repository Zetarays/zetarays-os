          "notifiche": tr("Notifications"), "rete": tr("Wi-Fi & Network"), "bluetooth": "Bluetooth",
          "audio": tr("Sound"), "stampanti": tr("Printers"), "ai": "AI", "info": tr("About"),
          "predefinite": tr("Default Apps"), "lingua": tr("Language & Region"),
          "font": tr("Fonts")}

# la tavolozza del sistema (ui/accento.py), la stessa dell'immagine dell'account
SWATCHES = [(colore, accento.nome(k)) for k, colore, _n in accento.TAVOLOZZA]

CSS = """
.swatch { min-width: 32px; min-height: 32px; padding: 0; border-radius: 999px; }
.swatch.selected { outline: 2px solid @accent_bg_color; outline-offset: 3px; }
.swatch-custom { background: rgba(255, 255, 255, 0.06); border: 1px dashed rgba(255, 255, 255, 0.25); }
.swatch-chiaro { box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.22); }
.sfondo-mini { padding: 4px; border-radius: 10px; background: transparent; }
.sfondo-mini picture { border-radius: 7px; }
.sfondo-mini.selected { outline: 2px solid @accent_bg_color; outline-offset: 1px; }
.zeta-title { font-size: 24px; font-weight: 500; }
""" + "".join(".swatch-%d { background: %s; }\n" % (i, c) for i, (c, _) in enumerate(SWATCHES))


def read_accent():
    return accento.scelto_hex()


def cartella_appimage():
    """~/Applications (created if missing), or the Italian folder of earlier
    installs when that is the one in use."""
    nuova = os.path.expanduser("~/Applications")
    vecchia = os.path.expanduser("~/Applicazioni")
    if os.path.isdir(vecchia) and not os.path.isdir(nuova):
        return vecchia
    os.makedirs(nuova, exist_ok=True)
    return nuova


def launch(*cmd):
    try:
        subprocess.Popen(list(cmd))
    except FileNotFoundError:
        pass


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=tr("Settings"), default_width=980, default_height=680)
        self.swatch_buttons = []

        split = Adw.NavigationSplitView()
        self.content = Adw.NavigationPage(title=TITLES["aspetto"])
        self.dock_page = Adw.PreferencesPage()
        self.pages = {"account": AccountPage(),
                      "aspetto": self.page_aspetto(), "dock": self.dock_page,
                      "schermi": SchermiPage(),
                      "schermo": self.page_schermo(), "notifiche": self.page_notifiche(),
                      "rete": NetworkPage(),
                      "bluetooth": BluetoothPage(), "audio": AudioPage(),
                      "stampanti": PrintersPage(),
                      "ai": self.page_ai(), "predefinite": self.page_predefinite(),
                      "lingua": LanguagePage(),
                      "font": FontsPage(),
                      "info": self.page_info()}
        self.dock_entries = dockmod.load_dock()
        self._render_dock()

        # --- Barra laterale ---
        listbox = Gtk.ListBox(css_classes=["navigation-sidebar"])
        # Ogni voce porta con sé la chiave della sua pagina (None per quelle
        # che aprono un'altra app). La corrispondenza riga -> pagina si ricava
        # da qui: una lista tenuta a mano a parte si sfasava appena si
        # aggiungeva una voce, e la barra evidenziava la riga sbagliata.
        items = [
            ("zeta-account", TITLES["account"], lambda: self.show("account", TITLES["account"]), "account"),
            ("zeta-palette", TITLES["aspetto"], lambda: self.show("aspetto", TITLES["aspetto"]), "aspetto"),
            ("zeta-dock", TITLES["dock"], lambda: self.show("dock", TITLES["dock"]), "dock"),
            ("zeta-schermi", TITLES["schermi"], lambda: self.show("schermi", TITLES["schermi"]), "schermi"),
            ("zeta-lock", TITLES["schermo"], lambda: self.show("schermo", TITLES["schermo"]), "schermo"),
            ("zeta-bell-off", TITLES["notifiche"], lambda: self.show("notifiche", TITLES["notifiche"]), "notifiche"),
            ("zeta-wifi", TITLES["rete"], lambda: self.show("rete", TITLES["rete"]), "rete"),
            ("zeta-bluetooth", TITLES["bluetooth"], lambda: self.show("bluetooth", TITLES["bluetooth"]), "bluetooth"),
            ("zeta-volume", TITLES["audio"], lambda: self.show("audio", TITLES["audio"]), "audio"),
            ("zeta-printer", TITLES["stampanti"], lambda: self.show("stampanti", TITLES["stampanti"]), "stampanti"),
            ("zeta-ai", TITLES["ai"], lambda: self.show("ai", TITLES["ai"]), "ai"),
            ("zeta-app", TITLES["predefinite"], lambda: self.show("predefinite", TITLES["predefinite"]), "predefinite"),
            ("zeta-lingua", TITLES["lingua"], lambda: self.show("lingua", TITLES["lingua"]), "lingua"),
            ("zeta-font", TITLES["font"], lambda: self.show("font", TITLES["font"]), "font"),
            ("zeta-shield", tr("Security"), lambda: launch("zeta-sicurezza"), None),
            ("zeta-packages", tr("Packages"), lambda: launch("synaptic-pkexec"), None),
            ("zeta-info", TITLES["info"], lambda: self.show("info", TITLES["info"]), "info"),
        ]
        for icon, label, action, _key in items:
            row = Gtk.Box(spacing=12, margin_top=8, margin_bottom=8, margin_start=6)
            row.append(Gtk.Image(icon_name=icon))
            row.append(Gtk.Label(label=label, xalign=0))
            lrow = Gtk.ListBoxRow(child=row)
            lrow.action = action
            listbox.append(lrow)
        listbox.connect("row-activated", lambda _lb, r: r.action())
        # la pagina che si apre di serie e' Aspetto (non la prima riga, Account)
        listbox.select_row(listbox.get_row_at_index([k for *_r, k in items].index("aspetto")))
        self.listbox = listbox
        self.row_keys = [chiave for *_resto, chiave in items]

        side_view = Adw.ToolbarView()
        side_view.add_top_bar(Adw.HeaderBar())
        # la lista scorre: senza, le sue voci imponevano alla finestra
        # un'altezza minima (704 px) che non entra in uno schermo basso
        # (1366x768, 1280x800 con la barra) e la barra del titolo finiva fuori
        side_view.set_content(Gtk.ScrolledWindow(child=listbox,
                                                 hscrollbar_policy=Gtk.PolicyType.NEVER))
        split.set_sidebar(Adw.NavigationPage(title=tr("Settings"), child=side_view))

        self.content_view = Adw.ToolbarView()
        self.content_view.add_top_bar(Adw.HeaderBar())
        self.content.set_child(self.content_view)
        split.set_content(self.content)
        self.show("aspetto", TITLES["aspetto"])
        self.toasts = Adw.ToastOverlay(child=split)
        self.set_content(self.toasts)

    def toast(self, text):
        # testo semplice: nomi di stampanti o reti con «&» non devono sparire
        self.toasts.add_toast(Adw.Toast(title=text, timeout=4, use_markup=False))

    # --- App predefinite ---
    def page_predefinite(self):
        from system import predefinite as P
        page = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(
            title=tr("Default Apps"),
            description=tr("The apps that open links, mail, folders and files, and those launched by the "
                           "shortcuts Super+Enter (terminal), Super+E (files) and Super+B (browser). "
                           "Only installed apps are listed."))
        for cat in P.ORDINE:
            cand = P.candidate(cat)
            attuale = P.attuale(cat)
            if attuale and attuale not in [c[0] for c in cand]:
                info = Gio.DesktopAppInfo.new(attuale)
                if info is not None:
                    cand.insert(0, (attuale, info.get_display_name(), ""))
            row = Adw.ComboRow(title=P.CATEGORIE[cat][0])
            if not cand:
                row.set_subtitle(tr("No app installed for this"))
                row.set_model(Gtk.StringList.new(["—"]))
                row.set_sensitive(False)
                g.add(row)
                continue
            row.set_model(Gtk.StringList.new([n for _i, n, _ic in cand]))
            ids = [i for i, _n, _ic in cand]
            row.set_selected(ids.index(attuale) if attuale in ids else Gtk.INVALID_LIST_POSITION)
            row._precedente = row.get_selected()
            row.connect("notify::selected", self._cambia_predefinita, cat, ids)
            g.add(row)
        page.add(g)

        # Gestione delle app: le tolte dal menu si rimettono da qui; AppImage
        # e Flatpak entrano nel menu da sole (registro unico, zeta-app)
        ga = Adw.PreferencesGroup(
            title=tr("Applications"),
            description=tr("Right-click an app in the menu or in search to open it, see where it is "
                           "installed, put it on the Desktop or in the Dock, hide it or uninstall it."))
        nascoste = Adw.ActionRow(title=tr("Apps hidden from the menu"),
                                 subtitle=tr("They stay installed: put them back in the menu whenever you like"),
                                 activatable=True)
        nascoste.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        nascoste.connect("activated", lambda *_: launch("zeta-app", "nascoste"))
        ga.add(nascoste)
        appimage = Adw.ActionRow(
            title="AppImage",
            subtitle=tr("Put them in the Applications folder (or leave them in Downloads): they appear "
                        "in the menu on their own, with name and icon."), activatable=True)
        appimage.add_suffix(Gtk.Image(icon_name="folder-open-symbolic"))
        appimage.connect("activated", lambda *_: launch("thunar", cartella_appimage()))
        ga.add(appimage)
        ga.add(Adw.ActionRow(
            title="Flatpak",
            subtitle=tr("Flathub is ready to use: on flathub.org the “Install” button starts "
                        "the installation, and the app appears in the menu.")))
        page.add(ga)
        return page

    def _cambia_predefinita(self, row, _p, cat, ids):
        from system import predefinite as P
        i = row.get_selected()
        if i == getattr(row, "_precedente", None) or not (0 <= i < len(ids)):
            return
        ok, msg = P.imposta(cat, ids[i])
        self.toast(msg)
        if ok:
            row._precedente = i
        else:
            # la scelta non e' stata presa dal sistema: si torna a quella vera
            GLib.idle_add(lambda: (row.set_selected(row._precedente), False)[1])

    def show(self, key, title, ancora=None):
        self.content.set_title(title)
        self.content_view.set_content(self.pages[key])
        if key in getattr(self, "row_keys", []):
            self.listbox.select_row(self.listbox.get_row_at_index(self.row_keys.index(key)))
        if ancora:
            # La voce che ha aperto le Impostazioni chiedeva una sezione
            # precisa (lo sfondo, il tema, le icone): ci si porta sopra invece
            # di lasciare l'utente a cercarla. Si aspetta che la pagina sia
            # disposta, altrimenti le coordinate non esistono ancora.
            GLib.idle_add(self._vai_a, key, ancora, priority=GLib.PRIORITY_LOW)

    def _vai_a(self, key, ancora):
        gruppo = self.ancore.get((key, ancora))
        pagina = self.pages.get(key)
        if gruppo is None or pagina is None:
            return False
        scorrevole = _trova_scorrevole(pagina)
        if scorrevole is None:
            return False
        punto = gruppo.translate_coordinates(scorrevole.get_child(), 0, 0)
        if punto is None:
            return False
        adj = scorrevole.get_vadjustment()
        adj.set_value(min(punto[1], max(0, adj.get_upper() - adj.get_page_size())))
        return False

    # --- Aspetto ---
    def _ancora(self, key, nome, gruppo):
        """Registra un gruppo come destinazione raggiungibile da fuori."""
        if not hasattr(self, "ancore"):
            self.ancore = {}
        self.ancore[(key, nome)] = gruppo
        return gruppo

    def page_aspetto(self):
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(
            title=tr("Accent color"),
            description=tr("Changes borders, bar, launcher, notifications and wallpaper."))

        box = Gtk.Box(spacing=16, margin_top=8, margin_bottom=8)
        current = read_accent()
        for i, (color, name) in enumerate(SWATCHES):
            b = Gtk.Button(css_classes=["swatch", "swatch-%d" % i], tooltip_text=name)
            if color == "#FFFFFF":
                b.add_css_class("swatch-chiaro")       # il bianco si vede anche sul chiaro
            b.color = color
            b.connect("clicked", lambda btn: self.set_accent(btn.color))
            self.swatch_buttons.append(b)
            box.append(b)

        custom = Gtk.Button(icon_name="list-add-symbolic", tooltip_text=tr("Custom color"),
                            css_classes=["swatch", "swatch-custom"], valign=Gtk.Align.CENTER)
        custom.connect("clicked", self.on_custom)
        self.custom_button = custom
        box.append(custom)

        group.add(box)
        page.add(self._ancora("aspetto", "accento", group))

        # --- Sfondo della scrivania ---
        sfondo = Adw.PreferencesGroup(
            title=tr("Wallpaper"), description=tr("One of the ZETA RAYS wallpapers, an image of your own, "
                                                  "or the one that follows the accent color (Reset)."))
        self.sfondo_row = Adw.ActionRow(title=tr("Image"), subtitle=self._wallpaper_label())
        scegli = Gtk.Button(label=tr("Choose…"), valign=Gtk.Align.CENTER)
        scegli.connect("clicked", lambda *_: self.on_pick_wallpaper())
        ripristina = Gtk.Button(label=tr("Reset"), valign=Gtk.Align.CENTER)
        ripristina.connect("clicked", lambda *_: self.on_reset_wallpaper())
        self.sfondo_row.add_suffix(scegli)
        self.sfondo_row.add_suffix(ripristina)
        sfondo.add(self.sfondo_row)

        # galleria degli sfondi ufficiali: un clic e si applica. Le miniature
        # sono file piccoli già pronti (non si caricano le immagini grandi).
        self.sfondi_bottoni = []
        # quattro per riga, colonne uguali: la griglia divide la larghezza che c'è
        galleria = Gtk.Grid(column_homogeneous=True, column_spacing=6, row_spacing=6,
                            margin_top=10, margin_bottom=4)
        for i, (percorso, nome, mini) in enumerate(sfondi.elenco()):
            quadro = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            foto = Gtk.Picture.new_for_filename(mini)
            foto.set_content_fit(Gtk.ContentFit.COVER)
            foto.set_can_shrink(True)
            # 72 px di altezza sulle colonne della pagina (~128 px) = circa 16:9
            foto.set_size_request(-1, 72)
            quadro.append(foto)
            quadro.append(Gtk.Label(label=nome, css_classes=["caption"], ellipsize=3))
            b = Gtk.Button(child=quadro, css_classes=["sfondo-mini"], tooltip_text=nome)
            b.percorso = percorso
            b.connect("clicked", lambda btn: self.on_sfondo_ufficiale(btn.percorso))
            self.sfondi_bottoni.append(b)
            galleria.attach(b, i % 4, i // 4, 1, 1)
        if self.sfondi_bottoni:
            sfondo.add(galleria)
            self._segna_sfondo()

        modes = [("fill", tr("Fill")), ("fit", tr("Fit")), ("center", tr("Center")),
                 ("tile", tr("Tile")), ("stretch", tr("Stretch"))]
        self._mode_ids = [m for m, _ in modes]
        combo = Adw.ComboRow(title=tr("Placement"),
                             model=Gtk.StringList.new([lbl for _, lbl in modes]))
        combo.set_selected(self._mode_ids.index(self._wallpaper_mode())
                           if self._wallpaper_mode() in self._mode_ids else 0)
        combo.connect("notify::selected", self.on_wallpaper_mode)
        sfondo.add(combo)
        page.add(self._ancora("aspetto", "sfondo", sfondo))

        # --- Tema, testo, icone, puntatore, scala ---
        tema = Adw.PreferencesGroup(
            title=tr("Theme and sizes"),
            description=tr("They apply to the whole system: bar, panels, apps and terminal."))

        self._temi = ["scuro", "chiaro"]
        riga_tema = Adw.ComboRow(title=tr("Theme"),
                                 subtitle=tr("Dark like ZETA RAYS, or light. "
                                             "SUPER + T also switches it."),
                                 model=Gtk.StringList.new([tr("Dark"), tr("Light")]))
        riga_tema.set_selected(self._temi.index(self._asp("tema")))
        riga_tema.connect("notify::selected",
                          lambda c, _p: self.set_aspetto("tema", self._temi[c.get_selected()]))
        tema.add(riga_tema)

        # L'editor di testo non è un'app di ZETA RAYS: non legge colors.css e ha
        # una sua preferenza. Qui si può tenerlo chiaro su scrivania scura (o il
        # contrario), che è il motivo per cui la scelta è separata dal tema.
        self._editor_temi = ["sistema", "chiaro", "scuro"]
        riga_editor = Adw.ComboRow(
            title=tr("Text Editor"),
            subtitle=tr("White background with black text, or black with white text"),
            model=Gtk.StringList.new([tr("Same as the system"),
                                      tr("Light (white background, black text)"),
                                      tr("Dark (black background, white text)")]))
        riga_editor.set_selected(self._editor_temi.index(self._asp("editor-tema")))
        riga_editor.connect("notify::selected",
                            lambda c, _p: self.set_aspetto(
                                "editor-tema", self._editor_temi[c.get_selected()]))
        tema.add(riga_editor)

        tema.add(self._spin(tr("Text size"), tr("Text of menus, panels and apps"),
                            "font-size", 8, 16))
        tema.add(self._spin(tr("Icon size"), tr("Icons of the dock at the bottom"),
                            "icon-size", 28, 64))
        tema.add(self._spin(tr("Pointer size"), tr("Mouse arrow"),
                            "cursor-size", 16, 48))

        self._scale_ids = ["auto", "1", "1.25", "1.5", "2"]
        riga_scala = Adw.ComboRow(
            title=tr("Interface scaling"),
            subtitle=tr("Automatic from the screen DPI, or fixed"),
            model=Gtk.StringList.new([tr("Automatic"), "100%", "125%", "150%", "200%"]))
        corrente = self._asp("scala")
        riga_scala.set_selected(self._scale_ids.index(corrente)
                                if corrente in self._scale_ids else 0)
        riga_scala.connect("notify::selected", self.on_scala)
        tema.add(riga_scala)

        icone = Adw.SwitchRow(
            title=tr("Desktop icons"),
            subtitle=tr("Show the files and folders of the Desktop on the wallpaper"))
        icone.set_active(self._asp("scrivania") == "1")
        icone.connect("notify::active",
                      lambda r, _p: self.set_aspetto("scrivania",
                                                     "1" if r.get_active() else "0"))
        tema.add(icone)
        page.add(self._ancora("aspetto", "tema", tema))

        # --- Effetti ---
        effetti = Adw.PreferencesGroup(
            title=tr("Effects"),
            description=tr("Turning them off makes the desktop snappier on slow computers."))
        effetti.add(self._switch(tr("Animations"), tr("Movement of windows and panels"),
                                 "animazioni"))
        effetti.add(self._switch(tr("Transparency and blur"),
                                 tr("Panels, terminal and shadows"), "trasparenza"))
        effetti.add(self._spin(tr("Rounded corners"), tr("Radius of window corners"),
                               "angoli", 0, 24))
        effetti.add(self._spin(tr("Icon spacing"), tr("Distance between icons on the desktop"),
                               "spaziatura", 0, 48))
        page.add(self._ancora("aspetto", "effetti", effetti))

        self.mark_selected(current)
        return page

    # --- Schermo e blocco ---
    def page_schermo(self):
        page = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(
            title=tr("Inactivity"),
            description=tr("What happens when you don't use the computer for a while."))
        g.add(self._spin(tr("Turn off the screen after"), tr("minutes — 0 to never turn it off"),
                         "schermo-spegni", 0, 120))
        g.add(self._spin(tr("Lock the screen after"), tr("minutes — 0 to never lock it"),
                         "blocco-auto", 0, 120))
        page.add(g)

        b = Adw.PreferencesGroup(title=tr("Screen lock"))
        riga = Adw.ActionRow(title=tr("Lock now"),
                             subtitle=tr("Your password is needed to get back in"))
        bott = Gtk.Button(label=tr("Lock"), valign=Gtk.Align.CENTER)
        bott.connect("clicked", lambda *_: launch("hyprlock"))
        riga.add_suffix(bott)
        b.add(riga)
        riga2 = Adw.ActionRow(
            title=tr("Lock screen"),
            subtitle=tr("Always plain black, on every display, also when waking from sleep"))
        b.add(riga2)
        page.add(b)

        d = Adw.PreferencesGroup(title=tr("Displays"))
        vai = Adw.ActionRow(title=tr("Resolution, Scale and Arrangement"),
                            subtitle=tr("Each display has its own settings"), activatable=True)
        vai.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        vai.connect("activated", lambda *_: self.show("schermi", TITLES["schermi"]))
        d.add(vai)
        page.add(d)
        return page

    # --- Notifiche ---
    def page_notifiche(self):
        page = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(title=tr("Notifications"))
        g.add(self._switch(tr("Do Not Disturb"), tr("Silence all notifications"),
                           "non-disturbare"))
        self._pos_ids = ["top-right", "top-center", "top-left",
                         "bottom-right", "bottom-left"]
        riga = Adw.ComboRow(title=tr("Position"),
                            model=Gtk.StringList.new(
                                [tr("Top right"), tr("Top center"),
                                 tr("Top left"), tr("Bottom right"),
                                 tr("Bottom left")]))
        corrente = self._asp("notifiche-posizione")
        riga.set_selected(self._pos_ids.index(corrente)
                          if corrente in self._pos_ids else 0)
        riga.connect("notify::selected",
                     lambda c, _p: self.set_aspetto("notifiche-posizione",
                                                    self._pos_ids[c.get_selected()]))
        g.add(riga)
        g.add(self._spin(tr("Duration"), tr("seconds before the notification disappears"),
                         "notifiche-durata", 1, 60))
        prova = Adw.ActionRow(title=tr("Try a notification"),
                              subtitle=tr("To see position and duration"))
        b = Gtk.Button(label=tr("Try"), valign=Gtk.Align.CENTER)
        b.connect("clicked", lambda *_: launch(
            "notify-send", "ZETA RAYS", tr("Notifications are working.")))
        prova.add_suffix(b)
        g.add(prova)
        page.add(g)
        return page

    def _switch(self, titolo, sotto, key):
        row = Adw.SwitchRow(title=titolo, subtitle=sotto)
        row.set_active(self._asp(key) == "1")
        row.connect("notify::active",
                    lambda r, _p, k=key: self.set_aspetto(k, "1" if r.get_active() else "0"))
        return row

    # --- Tema e dimensioni (zeta-aspetto) ---
    def _asp(self, key):
        """Valore attuale di una preferenza.

        I valori li tiene zeta-aspetto, che è l'unico posto dove vivono: qui non
        se ne conserva una seconda copia, che finirebbe per divergere. Si legge
        tutto in una volta sola e si tiene in cache: una pagina ne consulta una
        dozzina, e lanciare un sottoprocesso per ciascuna rendeva lenta
        l'apertura delle Impostazioni.
        """
        valori = getattr(self, "_asp_cache", None)
        if valori is None:
            valori = self._asp_cache = self._leggi_aspetto()
        return valori.get(key, "")

    @staticmethod
    def _leggi_aspetto():
        try:
            out = subprocess.run(["zeta-aspetto", "get"], capture_output=True,
                                 text=True, timeout=10).stdout
        except (OSError, subprocess.SubprocessError) as e:
            print("impostazioni: zeta-aspetto is not responding: %s" % e, file=sys.stderr)
            return {}
        valori = {}
        for line in out.splitlines():
            k, _, v = line.partition("=")
            if k:
                valori[k.strip()] = v.strip()
        return valori

    def _spin(self, titolo, sotto, key, lo, hi):
        adj = Gtk.Adjustment(lower=lo, upper=hi, step_increment=1, page_increment=2)
        row = Adw.SpinRow(title=titolo, subtitle=sotto, adjustment=adj)
        try:
            row.set_value(int(self._asp(key)))
        except ValueError:
            row.set_value(lo)
        row.connect("notify::value",
                    lambda r, _p, k=key: self.set_aspetto(k, str(int(r.get_value())),
                                                          ritardo=600))
        return row

    def set_aspetto(self, key, value, ritardo=0):
        """Applica un valore. Con «ritardo» si attende la fine della regolazione:
        girando la rotellina non si rigenera il tema a ogni scatto."""
        if not ritardo:
            self._apply_aspetto(key, value)
            return
        timers = getattr(self, "_asp_timers", None)
        if timers is None:
            timers = self._asp_timers = {}
        if key in timers:
            GLib.source_remove(timers[key])
        timers[key] = GLib.timeout_add(ritardo, self._apply_later, key, value)

    def _apply_later(self, key, value):
        self._asp_timers.pop(key, None)
        self._apply_aspetto(key, value)
        return False

    def _comando_lento(self, cmd, ok_msg, ko_msg, poi=None):
        """Esegue un comando che può durare secondi, senza bloccare la finestra.

        zeta-sfondo e zeta-accent rigenerano immagini, colori e configurazioni
        di tutte le app e ricaricano la barra: sul filo dell'interfaccia
        significherebbe una finestra sorda ai clic per tutto quel tempo.
        """
        def lavora():
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
                esito = (r.returncode == 0, (r.stderr or "").strip())
            except subprocess.TimeoutExpired:
                esito = (False, "the command did not finish in time")
            except OSError as e:
                esito = (False, str(e))
            GLib.idle_add(finito, esito)

        def finito(esito):
            ok, motivo = esito
            if ok:
                self.toast(ok_msg)
            else:
                print("impostazioni: %s (%s)" % (ko_msg, motivo or "no details"),
                      file=sys.stderr)
                self.toast(ko_msg)
            if poi:
                poi(ok)
            return False

        threading.Thread(target=lavora, daemon=True).start()

    def _apply_aspetto(self, key, value):
        """Scrive e applica una preferenza, senza bloccare la finestra.

        «zeta-aspetto set» non si limita a salvare: rigenera i colori di tutte
        le app, ricarica la barra e, per alcune chiavi, riavvia le icone della
        scrivania. Sono secondi interi. Eseguirlo qui, sul filo dell'interfaccia,
        significava una finestra che non risponde più ai clic finché non
        finisce: per questo va in un thread a parte.
        """
        # La cache va invalidata subito: se l'utente riapre la pagina prima che
        # il comando finisca, deve comunque vedere il valore che ha scelto.
        cache = getattr(self, "_asp_cache", None)
        if cache is not None:
            cache[key] = value

        def lavora():
            try:
                r = subprocess.run(["zeta-aspetto", "set", key, value],
                                   capture_output=True, text=True, timeout=60)
                esito = (r.returncode == 0, (r.stderr or "").strip())
            except subprocess.TimeoutExpired:
                esito = (False, "applying the change did not finish in time")
            except OSError as e:
                esito = (False, str(e))
            GLib.idle_add(self._aspetto_finito, key, esito)

        threading.Thread(target=lavora, daemon=True).start()

    def _aspetto_finito(self, key, esito):
        ok, motivo = esito
        if ok:
            self.toast(tr("Appearance updated"))
        else:
            print("impostazioni: '%s' not applied: %s" % (key, motivo), file=sys.stderr)
            self.toast(tr("Could not apply “{setting}”").format(setting=key))
        if key == "tema":
            # Senza questa, cambiando il tema da qui tutta la scrivania cambiava
            # tranne questa finestra, che restava dei colori di prima.
            tema.ricarica()
        # Il comando può aver corretto un valore fuori intervallo: si rilegge.
        self._asp_cache = self._leggi_aspetto()
        return False

    def on_scala(self, combo, _param):
        idx = combo.get_selected()
        if 0 <= idx < len(self._scale_ids):
            self.set_aspetto("scala", self._scale_ids[idx])

    # --- Sfondo ---
    def _wallpaper_state(self):
        try:
            out = subprocess.run(["zeta-sfondo", "get"], capture_output=True,
                                 text=True, timeout=5).stdout.split("\n")
            return out[0].strip(), (out[1].strip() if len(out) > 1 else "fill")
        except (OSError, subprocess.SubprocessError, IndexError):
            return "", "fill"

    def _wallpaper_label(self):
        path, _ = self._wallpaper_state()
        if not path:
            return tr("ZETA RAYS wallpaper")
        if path.endswith("wallpaper.png"):
            return tr("ZETA RAYS wallpaper (generated from the color)")
        ufficiale = sfondi.nome_di(path)
        if ufficiale:
            return tr("{name} (ZETA RAYS wallpaper)").format(name=ufficiale)
        # immagine dell'utente: dentro ~/.config/zeta si chiama «sfondo.jpg»,
        # si mostra il nome che aveva quando è stata scelta
        try:
            with open(os.path.expanduser("~/.config/zeta/wallpaper.json")) as f:
                nome = json.load(f).get("nome")
        except (OSError, ValueError, AttributeError):
            nome = None
        return nome or os.path.basename(path)

    def _segna_sfondo(self):
        path, _ = self._wallpaper_state()
        for b in getattr(self, "sfondi_bottoni", []):
            if b.percorso == path:
                b.add_css_class("selected")
            else:
                b.remove_css_class("selected")

    def _dopo_sfondo(self, _ok=True):
        self.sfondo_row.set_subtitle(self._wallpaper_label())
        self._segna_sfondo()

    def on_sfondo_ufficiale(self, percorso):
        self._comando_lento(["zeta-sfondo", "set", percorso, self._wallpaper_mode()],
                            tr("Wallpaper updated"),
                            tr("Could not set the wallpaper"),
                            poi=self._dopo_sfondo)

    def _wallpaper_mode(self):
        return self._wallpaper_state()[1]

    def on_pick_wallpaper(self):
        dialog = Gtk.FileDialog(title=tr("Choose a wallpaper image"))
        filt = Gtk.FileFilter()
        filt.set_name(tr("Images"))
        for m in ("image/png", "image/jpeg", "image/webp", "image/bmp"):
            filt.add_mime_type(m)
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(filt)
        dialog.set_filters(filters)
        dialog.open(self, None, self._wallpaper_chosen)

    def _wallpaper_chosen(self, dialog, result):
        try:
            gfile = dialog.open_finish(result)
        except GLib.Error:
            return
        path = gfile.get_path()
        if not path:
            return
        self._comando_lento(["zeta-sfondo", "set", path, self._wallpaper_mode()],
                            tr("Wallpaper updated"),
                            tr("Could not set the wallpaper"),
                            poi=self._dopo_sfondo)

    def on_reset_wallpaper(self):
        self._comando_lento(["zeta-sfondo", "reset"],
                            tr("ZETA RAYS wallpaper restored"),
                            tr("Could not reset the wallpaper"),
                            poi=self._dopo_sfondo)

    def on_wallpaper_mode(self, combo, _param):
        idx = combo.get_selected()
        if 0 <= idx < len(self._mode_ids):
            self._comando_lento(["zeta-sfondo", "mode", self._mode_ids[idx]],
                                tr("Wallpaper fit updated"),
                                tr("Could not change the fit"))

    def on_custom(self, _button):
        dialog = Gtk.ColorDialog(title=tr("Accent color"), with_alpha=False)
        initial = Gdk.RGBA()
        initial.parse(read_accent())
        dialog.choose_rgba(self, initial, None, self.on_custom_chosen)

    def on_custom_chosen(self, dialog, result):
        try:
            c = dialog.choose_rgba_finish(result)
        except GLib.Error:
            return
        self.set_accent("#%02X%02X%02X" % (round(c.red * 255), round(c.green * 255), round(c.blue * 255)))

    def set_accent(self, color):
        if color.upper() == read_accent():
            return
        # Il colore selezionato si segna subito: l'utente deve vedere la scelta
        # recepita mentre i colori di tutte le app vengono rigenerati.
        self.mark_selected(color.upper())
        self._comando_lento(["zeta-accent", color],
                            tr("Accent color updated"),
                            tr("Could not apply the color"),
                            poi=lambda ok: None if ok else self.mark_selected(read_accent()))

    def mark_selected(self, color):
        known = False
        for b in self.swatch_buttons:
            if b.color == color:
                b.add_css_class("selected")
                known = True
            else:
                b.remove_css_class("selected")
        if known:
            self.custom_button.remove_css_class("selected")
        else:
            self.custom_button.add_css_class("selected")

    # --- Dock ---
    def _render_dock(self):
        # svuota la pagina
        for g in getattr(self, "_dock_groups", []):
            self.dock_page.remove(g)
        self._dock_groups = []

        group = Adw.PreferencesGroup(
            title=tr("Apps in the dock"),
            description=tr("Drag an app to move it. Right-click a dock icon for: "
                           "Open, Remove from Dock, Options, App Settings."))
        n = len(self.dock_entries)
        for i, entry in enumerate(self.dock_entries):
            row = Adw.ActionRow(title=entry.get("name") or entry.get("cmd", ""),
                                subtitle=entry.get("cmd", ""))
            icon = dockmod.resolve_icon(entry.get("icon", ""))
            img = Gtk.Image.new_from_file(icon) if os.path.exists(icon) else Gtk.Image.new_from_icon_name("application-x-executable")
            img.set_pixel_size(28)
            row.add_prefix(img)
            # add_prefix mette davanti: la maniglia, aggiunta dopo, sta a sinistra
            maniglia = Gtk.Image.new_from_icon_name("list-drag-handle-symbolic")
            maniglia.add_css_class("dim-label")
            maniglia.set_tooltip_text(tr("Drag to move"))
            row.add_prefix(maniglia)
            # trascina e rilascia: la riga porta con se' la sua posizione
            src = Gtk.DragSource(actions=Gdk.DragAction.MOVE)
            src.connect("prepare", lambda _s, _x, _y, i=i: Gdk.ContentProvider.new_for_value(
                GObject.Value(GObject.TYPE_STRING, str(i))))
            src.connect("drag-begin", lambda s, _d, r=row: s.set_icon(Gtk.WidgetPaintable.new(r), 24, 24))
            row.add_controller(src)
            dst = Gtk.DropTarget.new(GObject.TYPE_STRING, Gdk.DragAction.MOVE)
            dst.connect("drop", lambda _t, val, _x, _y, j=i: self._dock_sposta(val, j))
            row.add_controller(dst)
            rem = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER,
                             tooltip_text=tr("Remove from Dock"), css_classes=["flat"])
            rem.set_sensitive(n > 1)
            rem.connect("clicked", lambda _b, i=i: self._dock_remove(i))
            row.add_suffix(rem)
            group.add(row)
        self.dock_page.add(group)
        self._dock_groups.append(group)

        posizione = Adw.PreferencesGroup(title=tr("Bar"))
        self._dock_pos_ids = ["bottom", "top"]
        riga = Adw.ComboRow(title=tr("Bar position"),
                            model=Gtk.StringList.new([tr("Bottom"), tr("Top")]))
        corrente = self._asp("dock-posizione")
        riga.set_selected(self._dock_pos_ids.index(corrente)
                          if corrente in self._dock_pos_ids else 0)
        riga.connect("notify::selected",
                     lambda c, _p: self.set_aspetto(
                         "dock-posizione", self._dock_pos_ids[c.get_selected()]))
        posizione.add(riga)
        posizione.add(self._spin(tr("Icon size"), tr("Dock icons"),
                                 "icon-size", 28, 64))
        self.dock_page.add(posizione)
        self._dock_groups.append(posizione)

        actions = Adw.PreferencesGroup()
        add = Adw.ActionRow(title=tr("Add an app"), activatable=True)
        add.add_prefix(Gtk.Image.new_from_icon_name("list-add-symbolic"))
        add.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        add.connect("activated", lambda *_: self._dock_add_dialog())
        actions.add(add)
        reset = Adw.ActionRow(title=tr("Restore the default dock"), activatable=True)
        reset.add_prefix(Gtk.Image.new_from_icon_name("view-refresh-symbolic"))
        reset.connect("activated", lambda *_: self._dock_reset())
        actions.add(reset)
        self.dock_page.add(actions)
        self._dock_groups.append(actions)

    def _dock_save(self):
        dockmod.save_dock(self.dock_entries)
        dockmod.apply(self.dock_entries)
        self._render_dock()

    def _dock_sposta(self, da, a):
        """Rilascio di una riga trascinata: l'app va al posto di quella sotto."""
        try:
            da = int(da)
        except (TypeError, ValueError):
            return False
        if da == a or not (0 <= da < len(self.dock_entries)) or not (0 <= a < len(self.dock_entries)):
            return False
        voce = self.dock_entries.pop(da)
        self.dock_entries.insert(a, voce)
        # dopo il rilascio: ricostruire la pagina durante il trascinamento
        # toglierebbe da sotto il puntatore la riga ancora in uso
        GLib.idle_add(lambda: (self._dock_save(), False)[1])
        return True

    def _dock_remove(self, i):
        if len(self.dock_entries) > 1:
            del self.dock_entries[i]
            self._dock_save()
            self.toast(tr("App removed from the dock"))

    def _dock_reset(self):
        self.dock_entries = list(dockmod.DEFAULT)
        self._dock_save()
        self.toast(tr("Dock restored"))

    def _dock_add_dialog(self):
        dlg = Adw.Window(transient_for=self, modal=True, title=tr("Add to Dock"),
                         default_width=420, default_height=560)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        search = Gtk.SearchEntry(placeholder_text=tr("Search…"), margin_start=10, margin_end=10, margin_top=8)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(search)
        listbox = Gtk.ListBox(css_classes=["boxed-list"], margin_start=10, margin_end=10,
                              margin_top=8, margin_bottom=10, selection_mode=Gtk.SelectionMode.NONE)
        apps = dockmod.installed_apps()
        present = dockmod.presenti() | {e.get("app") for e in self.dock_entries if e.get("app")}

        def build(query=""):
            child = listbox.get_first_child()
            while child:
                listbox.remove(child)
                child = listbox.get_first_child()
            for app in apps:
                if app["id"] in present:
                    continue
                if query and query.lower() not in app["name"].lower():
                    continue
                row = Adw.ActionRow(title=app["name"], subtitle=app["exec"], activatable=True)
                icon = dockmod.resolve_icon(app.get("icon", ""))
                img = Gtk.Image.new_from_file(icon) if os.path.exists(icon) else Gtk.Image.new_from_icon_name("application-x-executable")
                img.set_pixel_size(24)
                row.add_prefix(img)
                row.connect("activated", lambda _r, a=app: self._dock_add(a, dlg))
                listbox.append(row)
        build()
        search.connect("search-changed", lambda e: build(e.get_text()))
        scroller = Gtk.ScrolledWindow(vexpand=True)
        scroller.set_child(listbox)
        box.append(scroller)
        view.set_content(box)
        dlg.set_content(view)
        dlg.present()

    def _dock_add(self, app, dlg):
        self.dock_entries.append(dockmod.entry_from_desktop(app))
        self._dock_save()
        self.toast(tr("{name} added to the dock").format(name=app["name"]))
        dlg.close()

    # --- AI (ZETA RAYS Intelligence) ---
    def page_ai(self):
        sys.path.insert(0, "/usr/lib/zeta")
        try:
            from ui import pagina_ai
            page, pg = pagina_ai.costruisci(self)
        except Exception as e:  # noqa: BLE001 - la pagina non deve far cadere le Impostazioni
            print("impostazioni: AI page: %s" % e, file=sys.stderr)
            page = Adw.PreferencesPage()
            g = Adw.PreferencesGroup(title="AI")
            g.add(Adw.ActionRow(title=tr("ZETA RAYS Intelligence is not available"), subtitle=str(e)))
            page.add(g)
            return page

        # Il modello locale occupa circa 1,8 GB. Tenerlo pronto rende immediata
        # la prima risposta, ma su un computer con poca RAM è proprio ciò che
        # rallenta tutto il resto: per questo «automatico» decide dalla memoria.
        self._precarico = ["auto", "1", "0"]
        # La decisione e quella di intelligence/risorse.py: qui la si mostra
        # soltanto, senza ripetere la soglia (prima era copiata a mano).
        from intelligence import risorse
        gb = risorse.memoria_nominale_gb()
        if risorse.precarico_consentito():
            sotto = tr("Automatic on this computer ({gb} GB): keeps the model ready")
        else:
            sotto = tr("Automatic on this computer ({gb} GB): loads it when you open ZETA")
        riga_pre = Adw.ComboRow(
            title=tr("AI model always ready"),
            subtitle=sotto.format(gb="%.0f" % gb),
            model=Gtk.StringList.new([tr("Automatic"), tr("Always ready (~1.8 GB in use)"),
                                      tr("Only when needed")]))
        try:
            riga_pre.set_selected(self._precarico.index(self._asp("ai-precarica")))
        except ValueError:
            riga_pre.set_selected(0)
        riga_pre.connect("notify::selected",
                         lambda c, _p: self.set_aspetto("ai-precarica",
                                                        self._precarico[c.get_selected()]))
        pg.add(riga_pre)
        return page

    # --- Informazioni ---
    def page_info(self):
        page = Adw.PreferencesPage()
        head = Adw.PreferencesGroup()
        logo = Gtk.Picture.new_for_filename("/usr/share/zeta/brand/zeta-logo-bianco.svg")
        logo.set_size_request(-1, 150)
        logo.set_margin_top(12)
        logo.set_margin_bottom(12)
        head.add(logo)
        page.add(head)

        info = os_release()
        group = Adw.PreferencesGroup()
        rows = [
            (tr("System"), info.get("PRETTY_NAME", "ZETA RAYS OS")),
            (tr("Version"), info.get("VERSION_ID", "2.0")),
            (tr("Architecture"), platform.machine()),
            ("Kernel", "Linux %s" % platform.release().split("+")[0].split("-")[0]),
            (tr("Environment"), "ZETA RAYS Shell"),
            (tr("Intelligence"), "ZETA RAYS Intelligence · Built with Llama"),
            (tr("Security"), "ZETA RAYS Security"),
            (tr("License"), tr("Free software · GPL-3.0")),
            (tr("Processor"), cpu_name()),
            (tr("Memory"), mem_total()),
        ]
        for title, value in rows:
            row = Adw.ActionRow(title=title)
            row.add_suffix(Gtk.Label(label=value, css_classes=["dim-label"], selectable=True))
            group.add(row)
        page.add(group)

        # Documenti legali. Esistono nell'immagine: senza una voce qui nessuno
        # li troverebbe, ed è proprio quello che non deve succedere a un
        # documento che dice che cosa esce dal computer.
        legale = Adw.PreferencesGroup(
            title=tr("Licenses and terms"),
            description=tr("What is inside the system, under which licenses, and what leaves the computer."))
        for titolo, sotto, file in (
                (tr("Third-party software and licenses"),
                 tr("The included components, with license and origin"), "LICENZE.md"),
                (tr("Privacy"), tr("Which data leaves the computer, to whom, and how to stop it"),
                 "PRIVACY.md"),
                (tr("Terms of use"), tr("Licenses, warranty, trademarks"), "CONDIZIONI.md"),
                (tr("Full list of components"),
                 tr("All packages with version and license (spreadsheet)"),
                 "COMPONENTI.csv"),
                (tr("AI model: Llama 3.2"),
                 tr("Built with Llama — Meta's Llama 3.2 Community License"),
                 "llama-3.2/LICENSE.txt")):
            r = Adw.ActionRow(title=titolo, subtitle=sotto, activatable=True)
            r.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
            r.connect("activated", lambda _r, f=file: self._apri_legale(f))
            legale.add(r)
        page.add(legale)
        return page

    @staticmethod
    def _apri_legale(nome):
        percorso = "/usr/share/zeta/legale/%s" % nome
        # the translated document when there is one (PRIVACY.it.md)
        tradotto = "%s.%s%s" % (os.path.splitext(percorso)[0], language(), os.path.splitext(percorso)[1])
        if language() != "en" and os.path.exists(tradotto):
            percorso = tradotto
        if not os.path.exists(percorso):
            print("impostazioni: missing document: %s" % percorso, file=sys.stderr)
            return
        try:
            subprocess.Popen(["gio", "open", percorso], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            print("impostazioni: cannot open %s: %s" % (percorso, e),
                  file=sys.stderr)


def _trova_scorrevole(widget):
    """Il Gtk.ScrolledWindow dentro una Adw.PreferencesPage (ricerca in ampiezza)."""
    coda = [widget]
    while coda:
        w = coda.pop(0)
        if isinstance(w, Gtk.ScrolledWindow):
            return w
        c = w.get_first_child()
        while c:
            coda.append(c)
            c = c.get_next_sibling()
    return None


def read_first(path):
    try:
        with open(path) as f:
            return f.readline().strip()
    except OSError:
        return "—"


def os_release():
    data = {}
    try:
        with open("/etc/os-release") as f:
            for line in f:
                if "=" in line:
                    k, v = line.strip().split("=", 1)
                    data[k] = v.strip('"')
    except OSError:
        pass
    return data


def cpu_name():
    try:
        with open("/proc/cpuinfo") as f:
            for line in f:
                if line.startswith("model name"):
                    return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return platform.machine()


def mem_total():
    try:
        with open("/proc/meminfo") as f:
            kb = int(f.readline().split()[1])
        return "%.1f GB" % (kb / 1024 / 1024)
    except (OSError, ValueError, IndexError):
        return "—"


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Impostazioni", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        tema.apply(CSS)
        win = self.props.active_window or Window(self)
        # "aspetto" apre la pagina; "aspetto:sfondo" la apre già sulla sezione
        # dello sfondo (lo usa il menù di tasto destro della scrivania).
        args = [a for a in sys.argv[1:] if a not in ("--page", "-p")]
        start, _, ancora = (args[0] if args else "").partition(":")
        if start in win.pages:
            win.show(start, TITLES.get(start, start), ancora or None)
        win.present()


if __name__ == "__main__":
    App().run([sys.argv[0]])  # gli argomenti li leggiamo da sys.argv in do_activate

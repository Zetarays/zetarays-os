#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# mpv for ZETA RAYS. In virtual machines Hyprland rejects GPU buffers (dmabuf)
# from clients, so there mpv uses the shared-memory video output (wlshm).
# On real hardware it behaves exactly like /usr/bin/mpv.
if [ "${ZETA_VM:-0}" = 1 ]; then
    exec /usr/bin/mpv --vo=wlshm --hwdec=no "$@"
fi
exec /usr/bin/mpv "$@"

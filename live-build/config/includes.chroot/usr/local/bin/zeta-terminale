#!/bin/bash
# shellcheck disable=SC2059,SC1111  # formati di printf dalle traduzioni; virgolette tipografiche volute
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — terminale: shell dentro tmux, schede, divisioni, piu' shell.
#
#   zeta-terminale                 nuova sessione con la shell predefinita (lo lancia foot)
#   zeta-terminale menu            menu «Nuova scheda con…» (bash, zsh, fish, …)
#   zeta-terminale shell NOME      nuova scheda con quella shell
#   zeta-terminale pulisci SESS    (tmux, alla chiusura della finestra) vedi sotto
#   zeta-terminale shells          le shell installate
#
# Perche' tmux: se la finestra del terminale si chiude o va in crash, i comandi
# che stavano lavorando continuano e la sessione si riprende con
# «zeta shell sessioni». Quando invece si chiude una finestra in cui c'era solo
# il prompt, la sessione si chiude con lei: nessun processo resta in giro.
set -u
export TEXTDOMAIN=zetarays TEXTDOMAINDIR=/usr/share/locale
command -v gettext >/dev/null 2>&1 || gettext() { printf '%s' "$1"; }
CONF=/usr/share/zeta/shell/tmux.conf
PREF="$HOME/.config/zeta/shell"

# Testi di tmux (menu del tasto destro, richieste) nella lingua dell'utente.
# tmux.conf e' un file fisso in inglese: qui se ne scrive la traduzione in
# ~/.cache/zeta/tmux-testi.conf, che tmux.conf carica per ultimo. Si riscrive
# solo se cambia la lingua o la traduzione installata.
tq() {                      # testo sicuro dentro "..." di tmux.conf
    local t                 # (con -f restano i formati #{...} di tmux)
    if [ "$1" = -f ]; then t=$(gettext "$2"); else t=$(gettext "$1"); fi
    t=${t//\\/\\\\}; t=${t//\"/\\\"}
    [ "$1" = -f ] || t=${t//#/##}
    printf '%s' "$t"
}
testi_tmux() {
    local T="$HOME/.cache/zeta/tmux-testi.conf" L chiedi tasto mo
    L="${LANGUAGE:-}|${LC_ALL:-}|${LC_MESSAGES:-}|${LANG:-}"
    mo=$(ls -t /usr/share/locale/*/LC_MESSAGES/zetarays.mo 2>/dev/null | head -1)
    if [ -f "$T" ] && [ "$(head -1 "$T")" = "# $L" ] && [ "$T" -nt "$0" ] \
       && { [ -z "$mo" ] || [ "$T" -nt "$mo" ]; }; then
        return 0
    fi
    mkdir -p "${T%/*}"
    chiedi=$(tq -f "#{pane_current_command} is running in this pane: close it? (y/n)")
    # il tasto di conferma e' la lettera dopo l'ultima «(» della domanda tradotta
    tasto=${chiedi##*(}; tasto=${tasto:0:1}
    case "$tasto" in [[:alpha:]]) ;; *) tasto=y ;; esac
    {
        echo "# $L"
        echo "# generated by zeta-terminale: do not edit"
        printf '%s\n' "bind -n User1 if -F \"#{m/r:^-?(bash|zsh|fish|sh|dash|ksh|mksh|tcsh)\$,#{pane_current_command}}\" \"kill-pane\" \"confirm-before -p \\\"$chiedi\\\" -c $tasto kill-pane\""
        printf '%s\n' "bind -n User5 command-prompt -I \"#W\" -p \"$(tq "Tab name:")\" \"rename-window -- \\\"%%\\\"\""
        printf '%s\n' "bind -n User6 copy-mode \; command-prompt -p \"$(tq "Search:")\" \"send -X search-backward \\\"%%\\\"\""
        printf '%s\n' "bind -n MouseDown3Pane display-menu -O -T \"#[align=centre] $(tq "Terminal") \" -x M -y M \\"
        printf '%s\n' "  \"$(tq "Paste")\" v \"run-shell \\\"wl-paste -n | tmux load-buffer -b zeta-clip - && tmux paste-buffer -p -d -b zeta-clip\\\"\" \\"
        printf '%s\n' "  \"$(tq "Select and Copy")\" c \"copy-mode\" \\"
        printf '%s\n' "  \"\" \\"
        printf '%s\n' "  \"$(tq "New Tab")\" t \"new-window -c \\\"#{pane_current_path}\\\"\" \\"
        printf '%s\n' "  \"$(tq "New Tab With…")\" n \"run-shell \\\"zeta-terminale menu\\\"\" \\"
        printf '%s\n' "  \"$(tq "Split Side by Side")\" d \"split-window -h -c \\\"#{pane_current_path}\\\"\" \\"
        printf '%s\n' "  \"$(tq "Split Top and Bottom")\" e \"split-window -v -c \\\"#{pane_current_path}\\\"\" \\"
        printf '%s\n' "  \"$(tq "Rename Tab")\" r \"command-prompt -I \\\"#W\\\" -p \\\"$(tq "Tab name:")\\\" \\\"rename-window -- \\\\\\\"%%\\\\\\\"\\\"\" \\"
        printf '%s\n' "  \"\" \\"
        printf '%s\n' "  \"$(tq "Close Pane")\" w \"kill-pane\""
        printf '%s\n' "set -g status-right \"#[fg=#8A8A8E]#{?client_prefix,$(tq "PREFIX") ,}#S \""
    } > "$T.nuovo" && mv -f "$T.nuovo" "$T"
}

# Le shell installate, per nome (una volta sola), dalle shell di login note.
shells() {
    local visti=" " s n r
    while read -r s; do
        case "$s" in ''|\#*) continue ;; esac
        n=$(basename "$s")
        # tmux e screen si registrano come shell ma non lo sono; rbash e' bash ristretta
        case "$n" in rbash|tmux|screen) continue ;; esac
        [ -x "$s" ] || continue
        # lo stesso programma con due nomi (sh -> dash): una voce sola
        r=$(readlink -f "$s")
        case "$visti" in *" $n "*|*" $r "*) continue ;; esac
        visti="$visti$n $r "
        echo "$n $s"
    done < /etc/shells
}

percorso() {                 # nome -> percorso eseguibile, vuoto se non c'e'
    shells | awk -v n="$1" '$1 == n {print $2; exit}'
}

predefinita() {
    local n p
    n=$(cat "$PREF" 2>/dev/null)
    p=$([ -n "$n" ] && percorso "$n")
    [ -n "$p" ] || p=$(percorso bash)
    echo "${p:-/bin/sh}"
}

# Una sessione il cui unico programma in ogni riquadro e' la shell (nessun
# comando in corso) si puo' chiudere senza perdere nulla.
solo_prompt() {
    local cmd
    while read -r cmd; do
        case "$cmd" in bash|zsh|fish|sh|dash|ksh|mksh|tcsh|csh|-*) ;; *) return 1 ;; esac
    done < <(tmux list-panes -s -t "$1" -F '#{pane_current_command}' 2>/dev/null)
    return 0
}

case "${1:-}" in
    shells)
        shells ;;
    pulisci)
        # chiamato da tmux quando una finestra del terminale si stacca
        s="${2:-}"
        [ -n "$s" ] || exit 0
        [ "$(tmux display -p -t "$s" '#{session_attached}' 2>/dev/null)" = 0 ] || exit 0
        if solo_prompt "$s"; then
            tmux kill-session -t "$s" 2>/dev/null
        else
            tmux display -t "$s" "$(gettext "Session on hold: resume it with “zeta shell sessioni”")" 2>/dev/null
        fi ;;
    shell)
        p=$(percorso "${2:-}")
        if [ -z "$p" ]; then
            tmux display "$(printf "$(gettext 'Shell not installed: %s')" "${2:-}")"; exit 1
        fi
        tmux new-window -n "${2}" "$p" ;;
    menu)
        # «Nuova scheda con…»: le shell installate, e quelle che mancano con
        # l'installazione (apt, password chiesta da pkexec).
        voci=()
        while read -r n p; do
            voci+=("$n" "" "new-window -n $n $p")
        done < <(shells)
        for n in zsh fish; do
            if [ -z "$(percorso "$n")" ]; then
                voci+=("$(printf "$(gettext 'Install %s…')" "$n")" "" "new-window -n installa 'pkexec apt-get install -y $n; echo; read -rp \"$(gettext "Press Enter to close")\" _'")
            fi
        done
        tmux display-menu -T "#[align=centre] $(gettext "New tab with") " -x C -y C "${voci[@]}" ;;
    '')
        # nuova finestra del terminale = nuova sessione tmux
        # colori del prompt e di tmux: rigenerati se mancano o se l'accento
        # di sistema e' cambiato (un confronto di date: non rallenta)
        G="$HOME/.cache/zeta/starship.toml"
        if [ ! -f "$G" ] || [ "$HOME/.config/zeta/accent" -nt "$G" ] || [ "$HOME/.config/zeta/accent-reso" -nt "$G" ]; then
            zeta-shell applica >/dev/null 2>&1
        fi
        # zsh senza ~/.zshrc apre la sua procedura guidata: si usa quella di ZETA RAYS
        [ -e "$HOME/.zshrc" ] || cp /etc/skel/.zshrc "$HOME/.zshrc" 2>/dev/null
        SH=$(predefinita)
        if ! command -v tmux >/dev/null || [ ! -r "$CONF" ]; then
            exec "$SH" -l
        fi
        testi_tmux 2>/dev/null
        n=1
        while tmux has-session -t "=zeta-$n" 2>/dev/null; do n=$((n + 1)); done
        # le schede nuove (Ctrl+Maiusc+T) usano la stessa shell predefinita
        exec tmux -f "$CONF" new-session -s "zeta-$n" "$SH" \; set-option -g default-command "$SH"
        ;;
    *)
        gettext "Usage:
  zeta-terminale                 new session with the default shell (started by foot)
  zeta-terminale menu            “New tab with…” menu (bash, zsh, fish, …)
  zeta-terminale shell NAME      new tab with that shell
  zeta-terminale pulisci SESS    (tmux, when the window closes) clean up the session
  zeta-terminale shells          the installed shells"; echo; exit 1 ;;
esac

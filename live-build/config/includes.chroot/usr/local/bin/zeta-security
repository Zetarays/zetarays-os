        ("dig", "DNS (dig)", tr("DNS record lookup"), CLI, "bind9-dnsutils", None),
        ("dnsrecon", "DNSRecon", tr("DNS enumeration"), CLI, "dnsrecon", None),
    ],
    tr("Network analysis"): [
        ("wireshark", "Wireshark", tr("Packet analyzer (graphical)"), GUI, "wireshark", None),

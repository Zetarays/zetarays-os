"""ZETA RAYS Security — security center and toolkit (GTK4 + libadwaita).

Shows the real state of the system (firewall, encryption, updates, etc.) and
a catalog of security tools organized by category. The tools are NOT a
decorative list: each one can actually be launched.

  • graphical tools  → open in their own window
  • command-line tools → open in the terminal, with their help shown
  • tools not installed → installed with one click (apt, with authentication),
    but only if apt really knows them: otherwise the reason they are missing
    is explained

Nothing is ever run against targets unless the user asks for it: ZETA RAYS
opens the tool, and using it remains the responsibility of whoever runs it.
"""
import shlex
import shutil
import subprocess
import sys
import threading

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr  # noqa: E402
from ui import theme  # noqa: E402

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

from security import audit  # noqa: E402
from system import packages  # noqa: E402

STATE_STYLE = {
    audit.ACTIVE:         ("#3DDC97", "success"),
    audit.CONFIGURED:     ("#3A8DFF", "accent"),
    audit.NOT_CONFIGURED: ("#8A8A8E", "dim"),
    audit.WARNING:        ("#FFB547", "warning"),
}

GUI, CLI = "gui", "cli"


# Tool catalog. Each entry:
#   (command_to_check, "Name", "description", kind, apt_package, launch_command)
# launch_command None = use command_to_check.
TOOLKIT = {
    tr("Reconnaissance"): [
        ("nmap", "Nmap", tr("Network and port scanning"), CLI, "nmap", None),
        ("masscan", "Masscan", tr("Very high-speed port scanner"), CLI, "masscan", None),

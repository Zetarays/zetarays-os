#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — launcher delle app a tutto schermo (GTK4 + gtk4-layer-shell)
# Si apre e si chiude con lo stesso comando (tasto Super o simbolo nella barra).
import glob
import os
import sys

# gtk4-layer-shell va caricato prima di libwayland: rilancia con LD_PRELOAD
if "ZETA_LAUNCHER_PRELOADED" not in os.environ:
    libs = glob.glob("/usr/lib/*/libgtk4-layer-shell.so.0")
    if libs:
        env = dict(os.environ, ZETA_LAUNCHER_PRELOADED="1",
                   LD_PRELOAD=(libs[0] + " " + os.environ.get("LD_PRELOAD", "")).strip())
        os.execve(sys.executable, [sys.executable] + sys.argv, env)

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
try:
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gtk4LayerShell as LayerShell
except (ValueError, ImportError):
    LayerShell = None
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

CATEGORIES = [
    ("Tutte", None),
    ("Sistema", {"System", "Settings", "Monitor", "PackageManager", "TerminalEmulator", "FileManager"}),
    ("Internet", {"Network", "WebBrowser", "Email", "Chat"}),
    ("Ufficio", {"Office", "TextEditor", "Viewer", "Calculator", "Utility", "Archiving", "Development"}),
    ("Multimedia", {"AudioVideo", "Audio", "Video", "Graphics", "Player", "Photography"}),
]

# Nomi italiani semplici per le app principali (id del file .desktop -> nome)
# Nomi italiani delle app principali: condivisi con il selettore (Ctrl+Tab)
sys.path.insert(0, "/usr/lib/zeta")
try:
    from ui.nomi_app import NOMI as NAMES  # noqa: E402
except ImportError:
    NAMES = {}

# Voci di servizio da non mostrare (sono raggiungibili da Impostazioni)
HIDDEN = {
    "footclient.desktop", "foot-server.desktop", "thunar-settings.desktop", "thunar-bulk-rename.desktop",
    "thunar-volman-settings.desktop", "nm-connection-editor.desktop", "blueman-manager.desktop",
    "blueman-adapters.desktop", "pavucontrol.desktop", "org.pulseaudio.pavucontrol.desktop", "lxpolkit.desktop", "debian-xterm.desktop",
    "debian-uxterm.desktop", "display-im6.q16.desktop", "org.gnome.Evince-previewer.desktop",
    "calamares-install-debian.desktop", "calamares.desktop",
    "vim.desktop", "nvim.desktop", "htop.desktop", "nm-applet.desktop", "org.freedesktop.IBus.Setup.desktop",
    # doppione: ZETA RAYS Monitor copre già processi, risorse e rete
    "org.gnome.SystemMonitor.desktop", "gnome-system-monitor.desktop",
}

# L'installer ha senso solo nel sistema live, non dopo l'installazione.
if not os.path.exists("/run/live/medium"):
    HIDDEN.add("zeta-installa.desktop")

CSS = """
window.zeta-launcher { background: @scrim_strong; }
.zeta-launcher * { font-family: "Roboto", sans-serif; color: @ink; }
.zeta-search {
  min-height: 46px; min-width: 520px; padding: 0 16px; font-size: 14px;
  border-radius: 16px; background: @hover;
  border: 1px solid @accent_line; box-shadow: 0 0 0 4px @accent_soft; outline: none;
}
.zeta-search image { color: @ink_dim; }
.zeta-chip {
  min-height: 32px; padding: 0 14px; border-radius: 16px; font-size: 13px;
  background: @hover; border: 1px solid @line;
  box-shadow: none; color: @ink_2;
}
.zeta-chip:hover { background: @hover_2; }
.zeta-chip.active { background: @accent; border-color: @accent; }
.zeta-chip.active label { color: @accent_ink; font-weight: 500; }
.zeta-app { padding: 14px 6px 12px; border-radius: 20px; background: none; border: none; box-shadow: none; }
.zeta-app:hover, .zeta-app:focus-visible, flowboxchild:selected .zeta-app { background: @hover; }
flowboxchild, flowboxchild:selected { background: none; padding: 0; outline: none; }
.zeta-app-icon { -gtk-icon-shadow: 0 10px 30px rgba(0, 0, 0, 0.35); }
.zeta-app-label { font-size: 12px; color: @ink; }
.zeta-empty { color: @ink_dim; font-size: 14px; }
scrolledwindow, viewport { background: none; }
"""

DEFAULT_COLORS = """
@define-color accent #3A8DFF;
@define-color accent_ink #FFFFFF;
@define-color accent_soft rgba(58,141,255,0.14);
@define-color accent_line rgba(58,141,255,0.35);
@define-color surface rgba(18,18,20,0.94);
@define-color surface_2 rgba(255,255,255,0.04);
@define-color ink #EDEDEA;
@define-color ink_2 #C8C8CC;
@define-color ink_dim #8A8A8E;
@define-color line rgba(255,255,255,0.08);
@define-color hover rgba(255,255,255,0.07);
@define-color hover_2 rgba(255,255,255,0.14);
@define-color glass rgba(18,18,20,0.78);
@define-color scrim rgba(0,0,0,0.45);
@define-color scrim_strong rgba(0,0,0,0.74);
"""


class Launcher(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Launcher", decorated=False)
        self.add_css_class("zeta-launcher")
        self.category = None

        if LayerShell and LayerShell.is_supported():
            LayerShell.init_for_window(self)
            LayerShell.set_namespace(self, "zeta-launcher")
            LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
            LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.EXCLUSIVE)
            LayerShell.set_exclusive_zone(self, -1)
            for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
                LayerShell.set_anchor(self, edge, True)
        else:
            self.fullscreen()

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=28, margin_top=96, margin_bottom=110)

        # Ricerca
        self.search = Gtk.SearchEntry(placeholder_text="Cerca app", halign=Gtk.Align.CENTER)
        self.search.add_css_class("zeta-search")
        self.search.connect("search-changed", lambda *_: self.refilter())
        self.search.connect("activate", lambda *_: self.launch_first())
        self.search.connect("stop-search", lambda *_: self.nascondi())
        root.append(self.search)

        # Categorie
        chips = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        self.chip_buttons = []
        for name, cats in CATEGORIES:
            b = Gtk.Button(label=name)
            b.add_css_class("zeta-chip")
            b.cats = cats
            b.connect("clicked", self.on_chip)
            chips.append(b)
            self.chip_buttons.append(b)
        self.chip_buttons[0].add_css_class("active")
        root.append(chips)

        # Griglia delle app
        self.flow = Gtk.FlowBox(max_children_per_line=6, min_children_per_line=6, homogeneous=True,
                                column_spacing=16, row_spacing=20, selection_mode=Gtk.SelectionMode.NONE,
                                halign=Gtk.Align.CENTER, valign=Gtk.Align.START)
        self.flow.set_size_request(820, -1)
        self.flow.set_filter_func(self.filter_app)
        self.flow.set_sort_func(self._ordine)
        self._riempi()
        # app installate o tolte mentre il launcher e' in memoria: l'elenco si
        # rifa' alla prossima apertura (non a ogni apertura: e' la parte lenta)
        self._da_rifare = False
        self._monitor = Gio.AppInfoMonitor.get()
        self._monitor.connect("changed", lambda *_: setattr(self, "_da_rifare", True))

        scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.scroller = scroller
        scroller.set_child(self.flow)
        root.append(scroller)

        self.empty = Gtk.Label(label="Nessuna app trovata", visible=False)
        self.empty.add_css_class("zeta-empty")
        root.append(self.empty)

        self.set_child(root)

        # Esc chiude, un clic fuori dalle app chiude
        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        click = Gtk.GestureClick()
        click.connect("released", self.on_background_click)
        self.add_controller(click)

        self.search.grab_focus()

    def _riempi(self):
        child = self.flow.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.flow.remove(child)
            child = nxt
        for info in Gio.AppInfo.get_all():
            if info.should_show() and info.get_id() not in HIDDEN:
                self.flow.append(self.make_tile(info))

    def prepara(self):
        """Ogni volta che compare: ricerca vuota, tutte le app, in cima."""
        if self._da_rifare:
            self._da_rifare = False
            self._riempi()
        self.search.set_text("")
        for b in self.chip_buttons:
            b.remove_css_class("active")
        self.chip_buttons[0].add_css_class("active")
        self.category = self.chip_buttons[0].cats
        self.refilter()
        self.scroller.get_vadjustment().set_value(0)
        self.search.grab_focus()

    def nascondi(self):
        # resta in memoria, nascosto: la prossima apertura e' immediata
        self.set_visible(False)

    def make_tile(self, info):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        icon = Gtk.Image(pixel_size=56)
        icon.add_css_class("zeta-app-icon")
        if info.get_icon():
            icon.set_from_gicon(info.get_icon())
        else:
            icon.set_from_icon_name("application-x-executable")
        name = NAMES.get(info.get_id(), info.get_display_name())
        label = Gtk.Label(label=name, ellipsize=Pango.EllipsizeMode.END,
                          max_width_chars=14, justify=Gtk.Justification.CENTER)
        label.add_css_class("zeta-app-label")
        box.append(icon)
        box.append(label)

        button = Gtk.Button(child=box, tooltip_text=info.get_description() or info.get_display_name())
        button.add_css_class("zeta-app")
        button.connect("clicked", lambda *_: self.launch(info))

        child = Gtk.FlowBoxChild(child=button)
        child.info = info
        child.sort_key = GLib.utf8_collate_key(name.casefold(), -1)
        child.nome = name.casefold()
        cats = info.get_categories() if isinstance(info, Gio.DesktopAppInfo) else None
        child.cats = set((cats or "").split(";"))
        keywords = info.get_keywords() if isinstance(info, Gio.DesktopAppInfo) else []
        child.haystack = " ".join([name, info.get_display_name(), info.get_name(), info.get_executable() or ""]
                                  + list(keywords or [])).casefold()
        return child

    def _pertinenza(self, child):
        """Quanto un'app corrisponde a cio' che si sta scrivendo (0 = meglio).

        Senza, i risultati restavano in ordine alfabetico: cercando «zeta»
        l'assistente ZETA finiva ultimo e Invio apriva le Impostazioni, perche'
        tutte le app di sistema hanno «zeta» tra le parole chiave.
        """
        testo = self.search.get_text().strip().casefold()
        if not testo:
            return 0
        n = child.nome
        if n == testo:
            return 0
        if n.startswith(testo):
            return 1
        if any(p.startswith(testo) for p in n.split()):
            return 2
        if testo in n:
            return 3
        return 4

    def _ordine(self, a, b):
        pa, pb = self._pertinenza(a), self._pertinenza(b)
        if pa != pb:
            return pa - pb
        return (a.sort_key > b.sort_key) - (a.sort_key < b.sort_key)

    def filter_app(self, child):
        if self.category and not (child.cats & self.category):
            return False
        text = self.search.get_text().strip().casefold()
        return not text or all(word in child.haystack for word in text.split())

    def visible_children(self):
        """Le app visibili, nell'ordine in cui compaiono (per pertinenza)."""
        figli = []
        child = self.flow.get_first_child()
        while child:
            if child.get_child_visible() and self.filter_app(child):
                figli.append(child)
            child = child.get_next_sibling()
        yield from sorted(figli, key=lambda c: (self._pertinenza(c), c.sort_key))

    def refilter(self):
        self.flow.invalidate_filter()
        self.flow.invalidate_sort()
        self.empty.set_visible(next(self.visible_children(), None) is None)

    def on_chip(self, button):
        for b in self.chip_buttons:
            b.remove_css_class("active")
        button.add_css_class("active")
        self.category = button.cats
        self.refilter()

    def launch_first(self):
        first = next(self.visible_children(), None)
        if first:
            self.launch(first.info)

    def launch(self, info):
        ctx = Gdk.Display.get_default().get_app_launch_context()
        ctx.unsetenv("LD_PRELOAD")
        try:
            info.launch([], ctx)
        except GLib.Error as e:
            print("Impossibile avviare %s: %s" % (info.get_display_name(), e.message), file=sys.stderr)
        self.nascondi()

    def on_key(self, _ctrl, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.nascondi()
            return True
        if not self.search.get_focus_child() and Gdk.keyval_to_unicode(keyval):
            self.search.grab_focus()
        return False

    def on_background_click(self, gesture, _n, x, y):
        picked = self.pick(x, y, Gtk.PickFlags.DEFAULT)
        widget = picked
        while widget is not None and widget is not self:
            if isinstance(widget, (Gtk.Button, Gtk.Entry, Gtk.SearchEntry, Gtk.Text)):
                return
            widget = widget.get_parent()
        self.nascondi()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Launcher", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.win = None
        self.nascosto = False

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.nascosto = os.environ.pop("ZETA_PANNELLO_NASCOSTO", None) == "1"
        azione = Gio.SimpleAction.new("mostra", None)
        azione.connect("activate", lambda *_: self.alterna())
        self.add_action(azione)
        self.hold()                    # resta vivo anche a launcher nascosto
        # LD_PRELOAD serviva solo a questo processo: le app avviate non devono
        # ereditarla (le app GTK3 caricherebbero GTK4 e si chiuderebbero subito).
        pre = " ".join(p for p in os.environ.get("LD_PRELOAD", "").split() if "gtk4-layer-shell" not in p)
        if pre:
            os.environ["LD_PRELOAD"] = pre
        else:
            os.environ.pop("LD_PRELOAD", None)
        os.environ.pop("ZETA_LAUNCHER_PRELOADED", None)
        settings = Gtk.Settings.get_default()
        # il tema (chiaro o scuro) è quello scelto in Impostazioni > Aspetto
        chiaro = False
        try:
            chiaro = open(os.path.expanduser("~/.config/zeta/tema")).read().strip() == "chiaro"
        except OSError:
            pass
        settings.set_property("gtk-application-prefer-dark-theme", not chiaro)
        settings.set_property("gtk-icon-theme-name", "zeta")
        settings.set_property("gtk-font-name", "Roboto 10")
        colors = Gtk.CssProvider()
        path = os.path.expanduser("~/.config/zeta/colors.css")
        if os.path.exists(path):
            colors.load_from_path(path)
        else:
            colors.load_from_string(DEFAULT_COLORS)
        style = Gtk.CssProvider()
        style.load_from_string(CSS)
        display = Gdk.Display.get_default()
        Gtk.StyleContext.add_provider_for_display(display, colors, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.StyleContext.add_provider_for_display(display, style, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

    def do_activate(self):
        if self.nascosto:              # avviato dalla sessione: icone pronte, non visibile
            self.nascosto = False
            self.win = Launcher(self)
            return
        self.alterna()

    def alterna(self):
        # seconda chiamata mentre e' aperto: chiude (comportamento a interruttore)
        if self.win is not None and self.win.get_visible():
            self.win.nascondi()
            return
        if self.win is None:
            self.win = Launcher(self)
        self.win.prepara()
        self.win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))

#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — full-screen app launcher (GTK4 + gtk4-layer-shell)
# It opens and closes with the same command (Super key or the symbol in the bar).
import glob
import os
import sys

# gtk4-layer-shell must be loaded before libwayland: re-exec with LD_PRELOAD
if "ZETA_LAUNCHER_PRELOADED" not in os.environ:
    libs = glob.glob("/usr/lib/*/libgtk4-layer-shell.so.0")
    if libs:
        env = dict(os.environ, ZETA_LAUNCHER_PRELOADED="1",
                   LD_PRELOAD=(libs[0] + " " + os.environ.get("LD_PRELOAD", "")).strip())
        os.execve(sys.executable, [sys.executable] + sys.argv, env)

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
try:
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gtk4LayerShell as LayerShell
except (ValueError, ImportError):
    LayerShell = None
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr  # noqa: E402

CATEGORIES = [
    (tr("All"), None),
    (tr("System"), {"System", "Settings", "Monitor", "PackageManager", "TerminalEmulator", "FileManager"}),
    (tr("Internet"), {"Network", "WebBrowser", "Email", "Chat"}),
    (tr("Office"), {"Office", "TextEditor", "Viewer", "Calculator", "Utility", "Archiving", "Development"}),
    (tr("Multimedia"), {"AudioVideo", "Audio", "Video", "Graphics", "Player", "Photography"}),
]

# The apps come from the single registry (system/applications): the same
# names, icons and rules (service entries, apps removed from the menu) as the
# Dock, search and the Desktop.
from system import applications as reg  # noqa: E402
from ui import app_menu, popup  # noqa: E402

CSS = """
window.zeta-launcher { background: @scrim_strong; }
.zeta-launcher * { font-family: "Roboto", sans-serif; color: @ink; }
.zeta-search {
  min-height: 46px; min-width: 520px; padding: 0 16px; font-size: 14px;
  border-radius: 16px; background: @hover;
  border: 1px solid @accent_line; box-shadow: 0 0 0 4px @accent_soft; outline: none;
}
.zeta-search image { color: @ink_dim; }
.zeta-chip {
  min-height: 32px; padding: 0 14px; border-radius: 16px; font-size: 13px;
  background: @hover; border: 1px solid @line;
  box-shadow: none; color: @ink_2;
}
.zeta-chip:hover { background: @hover_2; }
.zeta-more { min-width: 40px; min-height: 28px; padding: 0; border-radius: 14px;
  background: @hover; border: 1px solid @line; box-shadow: none; }
.zeta-more:hover { background: @hover_2; }
.zeta-more image { color: @ink_2; -gtk-icon-size: 18px; }
.zeta-chip.active { background: @accent; border-color: @accent; }
.zeta-chip.active label { color: @accent_ink; font-weight: 500; }
.zeta-app { padding: 14px 6px 12px; border-radius: 20px; background: none; border: none; box-shadow: none; }
.zeta-app:hover, .zeta-app:focus-visible, flowboxchild:selected .zeta-app { background: @hover; }
flowboxchild, flowboxchild:selected { background: none; padding: 0; outline: none; }
.zeta-app-icon { -gtk-icon-shadow: 0 10px 30px rgba(0, 0, 0, 0.35); }
.zeta-app-label { font-size: 12px; color: @ink; }
.zeta-empty { color: @ink_dim; font-size: 14px; }
scrolledwindow, viewport { background: none; }
"""

DEFAULT_COLORS = """
@define-color accent #3A8DFF;
@define-color accent_ink #FFFFFF;
@define-color accent_soft rgba(58,141,255,0.14);
@define-color accent_line rgba(58,141,255,0.35);
@define-color surface rgba(18,18,20,0.94);
@define-color surface_2 rgba(255,255,255,0.04);
@define-color ink #EDEDEA;
@define-color ink_2 #C8C8CC;
@define-color ink_dim #8A8A8E;
@define-color line rgba(255,255,255,0.08);
@define-color hover rgba(255,255,255,0.07);
@define-color hover_2 rgba(255,255,255,0.14);
@define-color glass rgba(18,18,20,0.78);
@define-color scrim rgba(0,0,0,0.45);
@define-color scrim_strong rgba(0,0,0,0.74);
"""


class Launcher(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Launcher", decorated=False)
        self.add_css_class("zeta-launcher")
        self.category = None

        if LayerShell and LayerShell.is_supported():
            LayerShell.init_for_window(self)
            LayerShell.set_namespace(self, "zeta-launcher")
            LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
            LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.EXCLUSIVE)
            LayerShell.set_exclusive_zone(self, -1)
            for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
                LayerShell.set_anchor(self, edge, True)
        else:
            self.fullscreen()

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24, margin_top=80, margin_bottom=104)

        # Search
        self.search = Gtk.SearchEntry(placeholder_text=tr("Search apps"), halign=Gtk.Align.CENTER)
        self.search.add_css_class("zeta-search")
        self.search.connect("search-changed", lambda *_: self.refilter())
        self.search.connect("activate", lambda *_: self.launch_first())
        self.search.connect("stop-search", lambda *_: self.hide_away())
        root.append(self.search)

        # Categories
        chips = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        self.chip_buttons = []
        for name, cats in CATEGORIES:
            b = Gtk.Button(label=name)
            b.add_css_class("zeta-chip")
            b.cats = cats
            b.connect("clicked", self.on_chip)
            chips.append(b)
            self.chip_buttons.append(b)
        self.chip_buttons[0].add_css_class("active")
        root.append(chips)

        # App grid
        self.flow = Gtk.FlowBox(max_children_per_line=6, min_children_per_line=6, homogeneous=True,
                                column_spacing=16, row_spacing=20, selection_mode=Gtk.SelectionMode.NONE,
                                halign=Gtk.Align.CENTER, valign=Gtk.Align.START)
        self.flow.set_size_request(820, -1)
        self.flow.set_filter_func(self.filter_app)
        self.flow.set_sort_func(self._sort_order)
        self._fill()
        # apps installed or removed while the launcher is in memory: the list
        # is rebuilt on the next opening (not on every opening: it is the slow
        # part). New apps are announced with a notification, only once.
        self._needs_rebuild = False
        self._known_ids = {a.id for a in reg.all_apps()}
        self._new_apps_timer = 0
        self._recheck_timer = 0
        self._monitor = Gio.AppInfoMonitor.get()
        self._monitor.connect("changed", lambda *_: self._changed())

        scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.scroller = scroller
        scroller.set_child(self.flow)
        root.append(scroller)
        self._root = root
        # whole rows only: the last visible row came out cut in half (icons
        # without names) when the screen height was not an exact multiple of
        # the row height; the remaining rows are reached by scrolling
        self.connect("map", lambda *_: GLib.idle_add(self._whole_rows))

        self.empty = Gtk.Label(label=tr("No apps found"), visible=False)
        self.empty.add_css_class("zeta-empty")
        root.append(self.empty)

        # the right-click menu on the apps is drawn over the grid
        overlay = Gtk.Overlay(child=root)
        # more apps below the visible ones: a discreet arrow in the empty
        # space at the bottom (one click scrolls by one page)
        self.more_btn = Gtk.Button(icon_name="zeta-chevron-down", halign=Gtk.Align.CENTER,
                                valign=Gtk.Align.END, margin_bottom=62, visible=False,
                                tooltip_text=tr("More apps"))
        self.more_btn.add_css_class("zeta-more")
        self.more_btn.connect("clicked", lambda *_: self._page_down())
        overlay.add_overlay(self.more_btn)
        adj = scroller.get_vadjustment()
        for signal in ("changed", "value-changed"):
            adj.connect(signal, lambda *_: self._update_more_indicator())
        self.menu = app_menu.OverlayMenu(overlay)
        self.set_child(overlay)

        # Esc closes, a click outside the apps closes
        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        click = Gtk.GestureClick()
        click.connect("released", self.on_background_click)
        self.add_controller(click)

        self.search.grab_focus()

    def _fill(self):
        child = self.flow.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.flow.remove(child)
            child = nxt
        reg.gtk_icons()
        for app in reg.menu():
            self.flow.append(self.make_tile(app))

    def _changed(self):
        self._needs_rebuild = True
        # installation writes several files in a row: wait for it to finish
        if self._new_apps_timer:
            GLib.source_remove(self._new_apps_timer)
        self._new_apps_timer = GLib.timeout_add_seconds(3, self._announce_new)

    def _announce_new(self):
        self._new_apps_timer = 0
        # apps removed from outside too (Synaptic, terminal): drop the ZETA
        # shortcuts left without an app; keep the Dock icons in sync
        for name in reg.maintenance():
            app_menu.notice(tr("“{name}” is no longer installed").format(name=name),
                            tr("Its shortcuts were removed from the Dock and the Desktop."))
        # a missing app is removed only if it is still missing after a while
        # (apt may remove it and put it back): we recheck on our own
        if reg.orphans_pending() and not self._recheck_timer:
            self._recheck_timer = GLib.timeout_add_seconds(reg.ORPHAN_WAIT + 5, self._recheck)
        now = reg.all_apps(reread=True)
        for a in now:
            if a.id in self._known_ids or not a.in_menu and a.launchable:
                continue
            if a.service or a.is_hidden:
                continue
            if a.launchable:
                app_menu.notice(tr("“{name}” is now in the app menu").format(name=a.name),
                                "%s · %s" % (reg.SOURCES.get(a.source, a.source), a.executable))
            else:
                app_menu.notice(tr("“{name}” was installed but cannot start").format(name=a.name),
                                tr("The program it points to does not exist: {command}").format(
                                    command=a.command or "?"))
        self._known_ids = {a.id for a in now}
        return False

    def _recheck(self):
        self._recheck_timer = 0
        self._announce_new()
        return False

    def prepare(self):
        """Every time it appears: empty search, all apps, scrolled to the top."""
        if self._needs_rebuild:
            self._needs_rebuild = False
            self._fill()
        self.search.set_text("")
        for b in self.chip_buttons:
            b.remove_css_class("active")
        self.chip_buttons[0].add_css_class("active")
        self.category = self.chip_buttons[0].cats
        self.refilter()
        self.scroller.get_vadjustment().set_value(0)
        self.search.grab_focus()

    def _update_more_indicator(self):
        adj = self.scroller.get_vadjustment()
        self.more_btn.set_visible(adj.get_value() + adj.get_page_size() < adj.get_upper() - 2)

    def _page_down(self):
        adj = self.scroller.get_vadjustment()
        adj.set_value(min(adj.get_value() + adj.get_page_size() + self.flow.get_row_spacing(),
                          adj.get_upper() - adj.get_page_size()))

    def _whole_rows(self):
        first = self.flow.get_child_at_index(0)
        h = self.get_height()
        if first is None or first.get_height() <= 0 or h <= 0:
            return False
        spacing = self.flow.get_row_spacing()
        row_step = first.get_height() + spacing
        above = (self._root.get_margin_top() + self._root.get_margin_bottom()
                 + self.search.get_height() + self.chip_buttons[0].get_parent().get_height()
                 + 2 * self._root.get_spacing())
        lines = max(1, (h - above + spacing) // row_step)
        height = lines * row_step - spacing
        if self.scroller.get_min_content_height() != height:
            self.scroller.set_vexpand(False)
            self.scroller.set_min_content_height(height)
        return False

    def hide_away(self):
        # stays in memory, hidden: the next opening is instant
        self.menu.close_window()
        self.set_visible(False)

    def make_tile(self, app):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        icon = Gtk.Image(pixel_size=56)
        icon.add_css_class("zeta-app-icon")
        try:
            icon.set_from_gicon(Gio.Icon.new_for_string(app.icon or "application-x-executable"))
        except GLib.Error:
            icon.set_from_icon_name("application-x-executable")
        label = Gtk.Label(label=app.name, ellipsize=Pango.EllipsizeMode.END,
                          max_width_chars=14, justify=Gtk.Justification.CENTER)
        label.add_css_class("zeta-app-label")
        box.append(icon)
        box.append(label)

        button = Gtk.Button(child=box, tooltip_text=app.description or app.name)
        button.add_css_class("zeta-app")
        button.connect("clicked", lambda *_: self.launch(app))
        # right click: Open, location, Desktop, Dock, Info, remove, uninstall
        # (the same menu as in search)
        right_click = Gtk.GestureClick(button=Gdk.BUTTON_SECONDARY)
        right_click.connect("pressed", lambda g, _n, x, y: self._open_menu(g.get_widget(), x, y, app))
        button.add_controller(right_click)

        child = Gtk.FlowBoxChild(child=button)
        child.app = app
        child.sort_key = GLib.utf8_collate_key(app.name.casefold(), -1)
        child.folded_name = app.name.casefold()
        child.cats = set(app.categories)
        child.haystack = " ".join([app.name, app.id, os.path.basename(app.executable),
                                   app.description] + app.keywords).casefold()
        return child

    def _open_menu(self, widget, x, y, app):
        self.menu.open_at(widget, x, y, app_menu.app_entries(app, self.launch, self._after_menu))

    def _after_menu(self):
        # close right away; the list (app removed from the menu, new icon) is
        # rebuilt on the next opening
        self.hide_away()
        self._needs_rebuild = True

    def _relevance(self, child):
        """How well an app matches what is being typed (0 = best).

        Without this, results stayed in alphabetical order: searching for
        «zeta» put the ZETA assistant last and Enter opened Settings, because
        every system app has «zeta» among its keywords.
        """
        text = self.search.get_text().strip().casefold()
        if not text:
            return 0
        n = child.folded_name
        if n == text:
            return 0
        if n.startswith(text):
            return 1
        if any(p.startswith(text) for p in n.split()):
            return 2
        if text in n:
            return 3
        return 4

    def _sort_order(self, a, b):
        pa, pb = self._relevance(a), self._relevance(b)
        if pa != pb:
            return pa - pb
        return (a.sort_key > b.sort_key) - (a.sort_key < b.sort_key)

    def filter_app(self, child):
        if self.category and not (child.cats & self.category):
            return False
        text = self.search.get_text().strip().casefold()
        return not text or all(word in child.haystack for word in text.split())

    def visible_children(self):
        """The visible apps, in the order they appear (by relevance)."""
        children = []
        child = self.flow.get_first_child()
        while child:
            if child.get_child_visible() and self.filter_app(child):
                children.append(child)
            child = child.get_next_sibling()
        yield from sorted(children, key=lambda c: (self._relevance(c), c.sort_key))

    def refilter(self):
        self.flow.invalidate_filter()
        self.flow.invalidate_sort()
        self.empty.set_visible(next(self.visible_children(), None) is None)

    def on_chip(self, button):
        for b in self.chip_buttons:
            b.remove_css_class("active")
        button.add_css_class("active")
        self.category = button.cats
        self.refilter()

    def launch_first(self):
        first = next(self.visible_children(), None)
        if first:
            self.launch(first.app)

    def launch(self, app):
        ctx = Gdk.Display.get_default().get_app_launch_context()
        if not reg.launch(app, ctx):
            print("Cannot launch %s" % app.name, file=sys.stderr)
        self.hide_away()

    def on_key(self, _ctrl, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            if self.menu.opened():
                self.menu.close_window()
            else:
                self.hide_away()
            return True
        if not self.search.get_focus_child() and Gdk.keyval_to_unicode(keyval):
            self.search.grab_focus()
        return False

    def on_background_click(self, gesture, _n, x, y):
        # right-click menu open: a click outside only closes the menu
        if self.menu.opened():
            if not self.menu.contains(self.pick(x, y, Gtk.PickFlags.DEFAULT)):
                self.menu.close_window()
            return
        picked = self.pick(x, y, Gtk.PickFlags.DEFAULT)
        widget = picked
        while widget is not None and widget is not self:
            if isinstance(widget, (Gtk.Button, Gtk.Entry, Gtk.SearchEntry, Gtk.Text)):
                return
            widget = widget.get_parent()
        self.hide_away()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Launcher", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.win = None
        self.hidden = False
        self.colors = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.hidden = os.environ.pop("ZETA_PANEL_HIDDEN", None) == "1"
        operation = Gio.SimpleAction.new("show", None)
        operation.connect("activate", lambda *_: (popup.follow_theme(self.colors, DEFAULT_COLORS), self.toggle()))
        self.add_action(operation)
        self.hold()                    # stays alive even while the launcher is hidden
        # LD_PRELOAD was only needed by this process: launched apps must not
        # inherit it (GTK3 apps would load GTK4 and quit immediately).
        pre = " ".join(p for p in os.environ.get("LD_PRELOAD", "").split() if "gtk4-layer-shell" not in p)
        if pre:
            os.environ["LD_PRELOAD"] = pre
        else:
            os.environ.pop("LD_PRELOAD", None)
        os.environ.pop("ZETA_LAUNCHER_PRELOADED", None)
        settings = Gtk.Settings.get_default()
        # the theme (light or dark) is the one chosen in Settings > Appearance
        light = False
        try:
            light = open(os.path.expanduser("~/.config/zeta/theme")).read().strip() == "light"
        except OSError:
            pass
        settings.set_property("gtk-application-prefer-dark-theme", not light)
        settings.set_property("gtk-icon-theme-name", "zeta")
        settings.set_property("gtk-font-name", "Roboto 10")
        colors = self.colors = Gtk.CssProvider()
        popup.follow_theme(colors, DEFAULT_COLORS)
        style = Gtk.CssProvider()
        style.load_from_string(CSS)
        display = Gdk.Display.get_default()
        Gtk.StyleContext.add_provider_for_display(display, colors, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.StyleContext.add_provider_for_display(display, style, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

    def do_activate(self):
        if self.hidden:              # started by the session: icons ready, not visible
            self.hidden = False
            self.win = Launcher(self)
            return
        self.toggle()

    def toggle(self):
        # second call while it is open: close it (toggle behavior)
        if self.win is not None and self.win.get_visible():
            self.win.hide_away()
            return
        if self.win is None:
            self.win = Launcher(self)
        self.win.prepare()
        self.win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))

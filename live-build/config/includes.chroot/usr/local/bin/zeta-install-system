#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts the ZETA RAYS installer (Calamares) from the desktop.
# Calamares runs as root on Xwayland: root must be allowed to open windows.
xhost +si:localuser:root >/dev/null 2>&1
if [ -e /run/live/medium ] && sudo -n true 2>/dev/null; then
    exec sudo -E /usr/libexec/zeta-installer        # live: no password
fi
exec pkexec /usr/libexec/zeta-installer             # a single password prompt

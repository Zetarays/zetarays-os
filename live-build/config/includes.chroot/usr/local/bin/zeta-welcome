#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA RAYS — live system welcome: try or install.

Appears when the live system starts. It is also needed when the boot menu
cannot be used (in some virtual machines GRUB does not receive the USB
keyboard): from here the installer is always one click away.
"""
import subprocess
import sys

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, Gtk  # noqa: E402

sys.path.insert(0, "/usr/lib/zeta")
from i18n import tr  # noqa: E402
from ui import theme  # noqa: E402

LOGO = "/usr/share/zeta/brand/zeta-logo-white.svg"

CSS = """
.welcome-title { font-size: 22px; font-weight: 500; }
.welcome-text { font-size: 13px; color: @ink_2; }
.welcome-hint { font-size: 12px; color: @ink_dim; }
button.welcome-btn { min-height: 38px; padding: 0 22px; border-radius: 10px; font-size: 13px; }
"""


class Welcome(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=tr("Welcome to ZETA RAYS OS"), default_width=560,
                         default_height=380, resizable=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, valign=Gtk.Align.CENTER,
                      margin_top=36, margin_bottom=32, margin_start=40, margin_end=40)
        logo = Gtk.Image.new_from_file(LOGO)
        logo.set_pixel_size(72)
        box.append(logo)
        box.append(Gtk.Label(label=tr("Welcome to ZETA RAYS OS"), css_classes=["welcome-title"], margin_top=10))
        # in the session language (English on the USB stick, like the boot
        # menu): the system language is chosen in the installer
        box.append(Gtk.Label(label=tr("You can try ZETA RAYS as it is, without changing anything on "
                                      "this computer, or install it on the disk."),
                             wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=48,
                             css_classes=["welcome-text"]))
        row = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER, margin_top=18)
        test = Gtk.Button(label=tr("Keep trying"), css_classes=["welcome-btn"])
        test.connect("clicked", lambda *_: self.close())
        inst = Gtk.Button(label=tr("Install ZETA RAYS OS"), css_classes=["welcome-btn", "suggested-action"])
        inst.connect("clicked", lambda *_: self.install())
        row.append(test)
        row.append(inst)
        box.append(row)
        box.append(Gtk.Label(label=tr("You can install it later at any time from the app menu: "
                                      "“Install ZETA RAYS”. The installer lets you choose your language."),
                             wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=52,
                             css_classes=["welcome-hint"], margin_top=10))
        # language and keyboard of this session, before trying or installing
        language_button = Gtk.Button(label=tr("Language & Keyboard…"), css_classes=["flat"],
                            halign=Gtk.Align.CENTER)
        language_button.connect("clicked", lambda *_: subprocess.Popen(
            ["zeta-settings", "language"], start_new_session=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        box.append(language_button)
        # title bar (draggable, with the X to close)
        view = Adw.ToolbarView()
        header = Adw.HeaderBar(show_title=False)
        header.add_css_class("flat")
        view.add_top_bar(header)
        view.set_content(box)
        self.set_content(view)
        self.set_default_widget(inst)
        inst.grab_focus()

        # Esc closes: it is the shortcut everyone expects from a welcome
        # window, so nobody is left hunting for the right button.
        key_controller = Gtk.EventControllerKey()
        key_controller.connect("key-pressed",
                      lambda _c, kv, _k, _m: (self.close(), True)[1]
                      if kv == Gdk.KEY_Escape else False)
        self.add_controller(key_controller)

    def install(self):
        subprocess.Popen(["zeta-install-system"], start_new_session=True)
        self.close()


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Welcome", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        theme.apply(CSS)
        (self.props.active_window or Welcome(self)).present()


if __name__ == "__main__":
    sys.exit(App().run([sys.argv[0]]))

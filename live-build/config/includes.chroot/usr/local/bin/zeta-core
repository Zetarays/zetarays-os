#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ZETA — the intelligence of ZETA RAYS OS (GTK4 window).

It is no longer just an animation: it understands natural-language commands
(typed or, if the speech engine is installed, spoken) and actually EXECUTES
them — it opens folders, apps, settings, the system monitor, closes windows,
reads the CPU/RAM/network status. Common commands are recognized locally,
without Internet and without an AI model; open-ended questions go to the
language model only if one has been configured in Settings › AI. Actions
that change the system ask for confirmation.

The orb at the top shows the state: idle · listening · processing · replying.
"""
import os
import re
import sys
import threading

sys.path.insert(0, "/usr/lib/zeta")

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk, Pango  # noqa: E402

from core.orb import Orb  # noqa: E402
from ui import accent  # noqa: E402
from ui import theme  # noqa: E402
from intelligence import speech  # noqa: E402
from i18n import tr  # noqa: E402

HYPRBARS = "/usr/lib/zeta/hypr/hyprbars.so"

CSS = """
window.zeta-core { background: @surface; }
.zeta-head { background: @surface_2; border-bottom: 1px solid @line;
             min-height: 38px; box-shadow: none; }
.head-title { font-size: 13px; color: @ink_2; }
.transcript { padding: 6px 4px; }
.bubble { border-radius: 12px; padding: 9px 13px; margin: 3px 2px; }
.bubble.user { background: @accent_soft; color: @ink; }
.bubble.zeta { background: @surface_2; color: @ink; }
.bubble.info { font-family: "JetBrains Mono", monospace; font-size: 12px; }
.bubble.pending { color: @ink_dim; font-style: italic; }
.who { font-size: 10px; letter-spacing: 0.06em; color: @ink_dim; margin: 6px 4px 0 4px; }
.prompt { background: @hover; border: 1px solid @line;
          border-radius: 12px; padding: 8px 12px; color: @ink; caret-color: @accent; }
.prompt:focus { border-color: @accent; }
.circle { min-width: 40px; min-height: 40px; border-radius: 20px;
          background: @hover; }
.circle:hover { background: @hover_2; }
.send { background: @accent; border-radius: 20px; min-width: 40px; min-height: 40px; }
.hint { font-size: 11px; color: @ink_dim; }
.engine { font-size: 11px; color: @ink_dim; letter-spacing: 0.02em; margin-bottom: 4px; }
.mic-on { background: #E5484D; }
"""


def _md(text):
    """The Markdown the models write (**bold**, *italic*, `code`, headings
    with #) becomes real formatting, instead of visible asterisks.
    The text is escaped first: a reply cannot inject markup."""
    t = GLib.markup_escape_text(text or "")
    t = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", t)
    t = re.sub(r"(?<![*\w])\*(?![\s*])(.+?)(?<![\s*])\*(?![*\w])", r"<i>\1</i>", t)
    t = re.sub(r"`([^`\n]+)`", r"<tt>\1</tt>", t)
    return re.sub(r"(?m)^#{1,6}\s+", "", t)


def _strip_markdown(text):
    """For speech: no asterisks or hash signs read aloud."""
    return re.sub(r"[*`#]+", "", text or "")


def _is_report(text):
    """System report (table, list or «Label: 12 …»): monospace font.
    It does not depend on the language of the replies."""
    text = text or ""
    return "\n" in text or bool(re.match(r"[^\n:]{1,30}:\s*\d", text))


def read_color():
    """The orb color is the system accent color.

    There is no copy of it here: if there were, changing the accent from
    Settings would leave the orb behind and the interface would say two
    different things at the same time.
    """
    return accent.color_rgb()


class Window(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="ZETA")
        self.set_default_size(600, 800)
        self.add_css_class("zeta-core")
        self.color = read_color()
        # The orb follows the accent while the user changes it: there is no
        # need to reopen ZETA to see it in the right color.
        self._watchers = accent.follow(self._change_color)
        self.state = "idle"
        self.t = 0.0
        self.orb = Orb()
        self.assistant = None            # created on first use (in a thread)
        self._busy = False
        self._pending = None
        self._pending_timer = 0
        self._request = 0          # to discard replies to canceled requests

        # Title bar: ZETA RAYS draws it (hyprbars) for every window. Only if
        # the plugin is missing do we add our own, otherwise the title would
        # appear twice.
        if not os.path.exists(HYPRBARS):
            header = Gtk.HeaderBar(show_title_buttons=True, css_classes=["zeta-head"])
            header.set_title_widget(Gtk.Label(label="ZETA",
                                              css_classes=["head-title"]))
            self.set_titlebar(header)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        # --- orb ---
        self.area = Gtk.DrawingArea(content_height=330, hexpand=True)
        self.area.set_draw_func(self.on_draw)
        root.append(self.area)
        # which intelligence actually answers (provider, model, where it runs):
        # if the chosen one is not ready the system uses another, shown here
        self.engine = Gtk.Label(label="", css_classes=["engine"], ellipsize=3,
                                tooltip_text=tr("Change it in Settings › AI"))
        root.append(self.engine)
        threading.Thread(target=self._read_engine, daemon=True).start()

        # --- transcript ---
        self.log = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0,
                           css_classes=["transcript"], valign=Gtk.Align.START)
        self.scroller = Gtk.ScrolledWindow(vexpand=True,
                                           hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.scroller.set_child(self.log)
        root.append(self.scroller)
        # The conversation always stays scrolled to the bottom: a long reply
        # arrives after the pane has been drawn, so we scroll when the content
        # height changes, not right away.
        self.scroller.get_vadjustment().connect("changed", self._keep_at_end)

        # --- input row ---
        row = Gtk.Box(spacing=8, margin_start=12, margin_end=12, margin_top=6, margin_bottom=14)
        self.entry = Gtk.Entry(hexpand=True, css_classes=["prompt"],
                               placeholder_text=tr("Type a command…  “open documents”"))
        self.entry.connect("activate", lambda *_: self.submit(self.entry.get_text()))
        self.mic = Gtk.Button(css_classes=["circle"], tooltip_text=tr("Speak"))
        self.mic.set_child(Gtk.Image.new_from_icon_name("audio-input-microphone-symbolic"))
        self.mic.connect("clicked", lambda *_: self.on_mic())
        self.send = send = Gtk.Button(css_classes=["send"], tooltip_text=tr("Send"))
        self.send_icon = Gtk.Image.new_from_icon_name("go-up-symbolic")
        send.set_child(self.send_icon)
        send.connect("clicked", self.on_send)
        # Read aloud: the button exists only if speech synthesis is actually
        # installed (no buttons that do nothing).
        self.voice_button = None
        if speech.available():
            self.voice_button = Gtk.ToggleButton(css_classes=["circle"],
                                         tooltip_text=tr("Read replies aloud"))
            self.voice_button.set_child(Gtk.Image.new_from_icon_name("audio-speakers-symbolic"))
            self.voice_button.set_active(speech.enabled())
            self.voice_button.connect("toggled", self.on_voice_toggled)
        row.append(self.entry)
        row.append(self.mic)
        if self.voice_button is not None:
            row.append(self.voice_button)
        row.append(send)
        root.append(row)
        self.set_child(root)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        self._last_tick = GLib.get_monotonic_time()
        self._tick_id = 0
        self._schedule_tick()
        self._say_zeta(tr("Hi, I'm ZETA. Tell me what to do: “open settings”, "
                          "“how much RAM am I using”, “open the terminal”."))
        GLib.idle_add(lambda: (self.entry.grab_focus(), False)[1])
        self._prepare_voice()
        self._prepare_model()

    # ---------- orb ----------
    def on_draw(self, _a, ctx, w, h):
        self.orb.draw(ctx, w, h, self.t, self.color, self.state)

    # How many frames per second for the orb. It used to be always 60, even
    # with the window idle or behind others: almost half a core busy for nothing.
    def _fps(self):
        if not self.get_mapped() or not self.area.get_mapped():
            return 0                      # hidden or minimized: nothing
        # With software rendering (virtual machines without acceleration,
        # GSK_RENDERER=cairo) every frame recomputes the window on the CPU:
        # halve it.
        k = 2 if os.environ.get("GSK_RENDERER") == "cairo" else 1
        if self.state != "idle":
            return 30 // k                # listening, thinking, replying
        return (15 if self.is_active() else 5) // k or 2

    def _schedule_tick(self):
        fps = self._fps()
        self._tick_id = GLib.timeout_add(1000 // fps if fps else 500, self._tick)

    def _tick(self):
        now = GLib.get_monotonic_time()
        # the animation time follows the clock, not the frame count: the orb
        # spins at the same speed at 8 or 30 fps
        self.t += min(0.25, (now - self._last_tick) / 1e6)
        self._last_tick = now
        if self._fps():
            self.area.queue_draw()
        self._schedule_tick()
        return False

    def set_state(self, state, revert_after=0):
        self.state = state
        if revert_after:
            GLib.timeout_add(revert_after, lambda: (setattr(self, "state", "idle"), False)[1])

    # ---------- transcript ----------
    def _bubble(self, who, text, info=False):
        lbl_who = Gtk.Label(label=who, xalign=0 if who == "ZETA RAYS" else 1, css_classes=["who"])
        bubble = Gtk.Label(label=text, xalign=0, wrap=True, selectable=True,
                           wrap_mode=Pango.WrapMode.WORD_CHAR,
                           max_width_chars=52, halign=Gtk.Align.START if who == "ZETA RAYS" else Gtk.Align.END)
        cls = ["bubble", "zeta" if who == "ZETA RAYS" else "user"]
        if info:
            cls.append("info")
        for c in cls:
            bubble.add_css_class(c)
        self.log.append(lbl_who)
        self.log.append(bubble)
        GLib.idle_add(self._scroll_end)

    def _scroll_end(self):
        self._keep_at_end(self.scroller.get_vadjustment())
        return False

    def _keep_at_end(self, adj):
        adj.set_value(max(0.0, adj.get_upper() - adj.get_page_size()))

    def _say_user(self, text):
        self._bubble(tr("You"), text)

    def _say_zeta(self, text):
        self._bubble("ZETA RAYS", text, info=_is_report(text))

    # ---------- command execution ----------
    def on_send(self, _b=None):
        if self._busy:
            self.cancel()
        else:
            self.submit(self.entry.get_text())

    def cancel(self):
        """Stops waiting for the reply and gives control back.

        The request in progress cannot be interrupted halfway (it is a network
        call), but its result will be discarded and the interface becomes
        usable again immediately: you are never stuck waiting."""
        self._request += 1
        self._busy = False
        self._send_mode(False)
        self._remove_pending()
        self.set_state("idle")
        self._say_zeta(tr("Request canceled."))

    def _send_mode(self, busy):
        """The send button becomes «stop» while processing."""
        self.send_icon.set_from_icon_name(
            "process-stop-symbolic" if busy else "go-up-symbolic")
        self.send.set_tooltip_text(tr("Stop") if busy else tr("Send"))

    def submit(self, text):
        text = (text or "").strip()
        if not text or self._busy:
            return
        self.entry.set_text("")
        self._say_user(text)
        self._busy = True
        self._streamed = ""
        self._request += 1
        self._send_mode(True)
        self.set_state("processing")
        # immediate feedback: a "working on it" bubble that later becomes the reply
        self._pending = self._pending_bubble()
        self._elapsed = 0
        self._pending_timer = GLib.timeout_add_seconds(1, self._tick_pending)
        threading.Thread(target=self._work, args=(text, self._request),
                         daemon=True).start()

    @staticmethod
    def _describe(prov):
        c = prov.config
        where = tr("local") if c.kind == "local" else tr("online")
        model = c.model
        if not model and hasattr(prov, "_model"):
            try:
                model = prov._model()              # Ollama: the one it will actually use
            except Exception:  # noqa: BLE001
                model = ""
        return " · ".join(x for x in (c.label, model, where) if x)

    def _read_engine(self):
        try:
            from intelligence.registry import Registry
            prov = Registry().resolve_default()
            text = self._describe(prov) + ("" if prov.available() else " · " + tr("not ready"))
        except Exception as e:  # noqa: BLE001
            text = tr("AI unavailable ({error})").format(error=e)
        GLib.idle_add(self.engine.set_text, text)

    def _phase(self, text, request):
        """What is really happening (loading, contacting the service)."""
        if request == self._request and self._pending is not None and not self._streamed:
            self._phase_text = text
            self._pending.set_text(text)
        return False

    def _pending_bubble(self, text=None):
        self.log.append(Gtk.Label(label="ZETA RAYS", xalign=0, css_classes=["who"]))
        lbl = Gtk.Label(label=text or tr("Working on it…"), xalign=0, wrap=True,
                        halign=Gtk.Align.START, css_classes=["bubble", "zeta", "pending"])
        self.log.append(lbl)
        GLib.idle_add(self._scroll_end)
        return lbl

    def _tick_pending(self):
        """Shows that it is working, with the real phase (see _phase) and the
        seconds: it used to say «loading the local model» after 4 s even with
        an online service or with the model already in memory."""
        if not self._busy or self._pending is None or self._streamed:
            return bool(self._busy and self._pending is not None)
        self._elapsed += 1
        phase = getattr(self, "_phase_text", "") or tr("Working on it…")
        if self._elapsed >= 4:
            self._pending.set_text(tr("{status} ({seconds}s)").format(status=phase, seconds=self._elapsed))
        return True

    def _work(self, text, request):
        try:
            from intelligence.registry import Registry
            prov = Registry().resolve_default()
            if self.assistant is None:
                from intelligence.assistant import Assistant
                self.assistant = Assistant(prov)
            else:
                # a provider changed in Settings applies from the next question,
                # without closing ZETA (the conversation is kept)
                old = self.assistant.provider.config
                new = prov.config
                if (old.name, old.model, old.endpoint) != (new.name, new.model, new.endpoint):
                    self.assistant.provider = prov
            prov = self.assistant.provider
            GLib.idle_add(self.engine.set_text, self._describe(prov))
            self._phase_text = ""
            from intelligence.providers.ollama import OllamaProvider
            from intelligence.agent.understanding import understanding
            if understanding(text):
                phase = tr("Running…")                     # a command: no model needed
            elif isinstance(prov, OllamaProvider):
                phase = (tr("Working on it…") if prov._already_loaded() else
                        tr("Loading the {model} model into memory, the first reply is slower…").format(
                            model=prov.config.model))
            else:
                phase = tr("Contacting {service}…").format(service=prov.config.label)
            GLib.idle_add(self._phase, phase, request)
            self._streamed = ""
            answer = self.assistant.respond(
                text, confirm=self._confirm,
                on_text=lambda c: GLib.idle_add(self._chunk, c, request))
        except Exception as e:  # noqa: BLE001
            answer = tr("An error occurred: {error}").format(error=e)
        GLib.idle_add(self._done, answer, request)

    def _chunk(self, chunk, request):
        """A chunk of the reply arriving: the bubble fills up while the model
        writes, instead of staying on «Working on it…» until the end."""
        if request != self._request or self._pending is None:
            return False                  # request canceled in the meantime
        if not self._streamed and getattr(self, "_pending_timer", 0):
            GLib.source_remove(self._pending_timer)
            self._pending_timer = 0
            self._pending.remove_css_class("pending")
        self._streamed += chunk
        self._pending.set_markup(_md(self._streamed))
        self._scroll_end()
        return False

    def _done(self, answer, request=None):
        if request is not None and request != self._request:
            return False              # reply to a canceled request
        self._send_mode(False)
        if getattr(self, "_pending_timer", 0):
            GLib.source_remove(self._pending_timer)
            self._pending_timer = 0
        if self._pending is not None:
            # the waiting bubble becomes the real reply (model text: with its
            # formatting; system reports: plain text)
            if self._streamed:
                self._pending.set_markup(_md(answer))
            else:
                self._pending.set_text(answer)
            self._pending.remove_css_class("pending")
            # Monospace font only for system command reports (tables, lists):
            # a multi-line reply from the model, like a poem, stays in the
            # normal font.
            if not self._streamed and _is_report(answer):
                self._pending.add_css_class("info")
            self._pending = None
            GLib.idle_add(self._scroll_end)
        else:
            self._say_zeta(answer)
        self.set_state("replying", revert_after=1400)
        self._busy = False
        self._speak(_strip_markdown(answer))
        return False

    def _speak(self, text):
        """Reads the reply aloud if the user has turned speech on."""
        if self.voice_button is None or not self.voice_button.get_active():
            return
        if speech.say(text, on_done=lambda: GLib.idle_add(self._spoken)):
            self.set_state("replying")

    def _spoken(self):
        if self.state == "replying":
            self.set_state("idle")
        return False

    def on_voice_toggled(self, btn):
        speech.set_enabled(btn.get_active())
        if not btn.get_active():
            speech.stop()
            self._spoken()

    def _confirm(self, res):
        """Asks for confirmation (worker thread) by showing a dialog on the UI thread."""
        ev = threading.Event()
        out = {"ok": False}

        def show():
            dlg = Gtk.Window(transient_for=self, modal=True, title=tr("Confirm action"),
                             default_width=420)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                          margin_top=18, margin_bottom=18, margin_start=18, margin_end=18)
            box.append(Gtk.Label(label=tr("ZETA RAYS wants to perform a system action:"),
                                 xalign=0, wrap=True))
            box.append(Gtk.Label(label=res.preview, xalign=0, selectable=True,
                                 css_classes=["bubble", "info"]))
            box.append(Gtk.Label(label=res.impact, xalign=0, wrap=True, css_classes=["hint"]))
            btns = Gtk.Box(spacing=8, halign=Gtk.Align.END)
            cancel = Gtk.Button(label=tr("Cancel"))
            ok = Gtk.Button(label=tr("Allow"), css_classes=["suggested-action"])
            cancel.connect("clicked", lambda *_: (dlg.destroy(), ev.set()))
            ok.connect("clicked", lambda *_: (out.__setitem__("ok", True), dlg.destroy(), ev.set()))
            btns.append(cancel)
            btns.append(ok)
            box.append(btns)
            dlg.set_child(box)
            dlg.connect("close-request", lambda *_: (ev.set(), False)[1])
            dlg.present()
            # focus on «Cancel»: an accidental Enter authorizes nothing
            # (and the action text does not appear fully selected)
            cancel.grab_focus()
            return False

        GLib.idle_add(show)
        ev.wait(timeout=120)
        return out["ok"]

    # ---------- model ----------
    def _prepare_model(self):
        """With the local model, start loading it as soon as ZETA opens: it
        takes 1-2 seconds, and meanwhile the question is being typed. It does
        not do this if the user chose «Only when needed» (Settings › AI)."""
        def job():
            try:
                with open(os.path.expanduser("~/.config/zeta/ai-preload")) as f:
                    if f.read().strip() == "0":
                        return
            except OSError:
                pass
            try:
                from intelligence.registry import Registry
                from intelligence.providers.ollama import OllamaProvider
                prov = Registry().resolve_default()
                if isinstance(prov, OllamaProvider) and prov.available():
                    prov.preload()
            except Exception:  # noqa: BLE001 - the first question will load it anyway
                pass
        threading.Thread(target=job, daemon=True).start()

    # ---------- voice ----------
    def _prepare_voice(self):
        """Loads the speech engine in the background: on the first voice
        command the wait would be a few seconds, and it would look frozen."""
        def job():
            try:
                from intelligence import voice
                if voice.available():
                    voice.preload()
            except Exception:  # noqa: BLE001
                pass
        threading.Thread(target=job, daemon=True).start()

    def on_mic(self):
        if self._busy:
            return
        from intelligence import voice
        if not voice.available():
            self._say_zeta(voice.why_unavailable())
            return
        self._busy = True
        self.mic.add_css_class("mic-on")
        self.set_state("listening")
        self._pending = self._pending_bubble(tr("Go ahead, I'm listening…"))
        self._elapsed = 0
        threading.Thread(target=self._listen, daemon=True).start()

    def _listen(self):
        from intelligence import voice
        error = None
        text = ""
        confidence = 0.0
        try:
            rec = voice.Recognizer()
            text = rec.listen(on_state=lambda st: GLib.idle_add(self._voice_state, st))
            confidence = getattr(rec, "last_confidence", 0.0)
        except voice.MicrophoneError as e:
            error = str(e)
        except Exception as e:  # noqa: BLE001
            error = tr("Microphone error: {error}").format(error=e)
        GLib.idle_add(self._heard, text, confidence, error)

    def _voice_state(self, state):
        """Visual feedback while speaking."""
        texts = {"idle": tr("Go ahead, I'm listening…"), "listening": tr("Listening…"),
                 "processing": tr("Understanding…")}
        if self._pending is not None and state in texts:
            self._pending.set_text(texts[state])
        self.set_state("listening" if state != "processing" else "processing")
        return False

    def _heard(self, text, confidence, error):
        self.mic.remove_css_class("mic-on")
        self.set_state("idle")
        self._busy = False
        self._remove_pending()
        if error:
            self._say_zeta(error)
        elif not text:
            self._say_zeta(tr("I didn't hear anything. Press the microphone and speak, "
                              "or type the command."))
        elif confidence and confidence < 0.55:
            # better to say what was understood than to execute the wrong thing
            self._say_zeta(tr("I'm not sure I understood: “{text}”. "
                              "Please repeat it, or type it.").format(text=text))
        else:
            self.submit(text)
        return False

    def _remove_pending(self):
        if getattr(self, "_pending_timer", 0):
            GLib.source_remove(self._pending_timer)
            self._pending_timer = 0
        if self._pending is not None:
            parent = self._pending.get_parent()
            if parent is not None:
                # also removes the "ZETA RAYS" label above the bubble
                prev = self._pending.get_prev_sibling()
                parent.remove(self._pending)
                if prev is not None and prev.has_css_class("who"):
                    parent.remove(prev)
            self._pending = None

    # ---------- keys / color ----------
    def on_key(self, _c, keyval, _kc, _mod):
        if keyval == Gdk.KEY_Escape:
            speech.stop()
            self.close()
            return True
        return False

    def _change_color(self, rgb):
        self.color = rgb
        if hasattr(self, "area"):
            self.area.queue_draw()
        # The send button and the field border also use @accent, which lives
        # in the CSS: reloading it makes them follow the new color without
        # reopening ZETA, as the orb already does. zeta-accent has just
        # rewritten colors.css.
        try:
            theme.apply(CSS)
        except Exception:  # noqa: BLE001 — a cosmetic tweak must not bring ZETA down
            pass


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Core")

    def do_activate(self):
        theme.apply(CSS)
        (self.props.active_window or Window(self)).present()


def main(argv):
    return App().run(None)


if __name__ == "__main__":
    sys.exit(main(sys.argv))

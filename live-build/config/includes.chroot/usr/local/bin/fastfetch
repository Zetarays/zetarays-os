#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — fastfetch with the official logo.
#
# The drawing is 119 columns wide and 67 rows tall. It does not fit in a
# smaller window: instead of letting it get cut in half, the rendering is
# chosen here automatically. The drawing is NEVER modified, only the
# resolution it is printed at changes (see tools/gen-logo-ascii.py):
#
#   >= 70 rows and 168 columns -> full drawing
#   >= 36 rows and 168 columns -> half blocks, same drawing
#   >= 18 rows and 104 columns -> symbol only, at half resolution
#   smaller                    -> information only
#
# To force a rendering:  ZETA_LOGO=full|compact|tiny|none fastfetch
export TEXTDOMAIN=zetarays TEXTDOMAINDIR=/usr/share/locale
command -v gettext >/dev/null 2>&1 || gettext() { printf '%s' "$1"; }
REAL=/usr/bin/fastfetch
[ -x "$REAL" ] || { echo "$(gettext "fastfetch is not installed")" >&2; exit 127; }

# The logo color follows the theme (light on ZETA RAYS black, dark on a light
# theme): zeta-accent writes the configurations into the user's directory. If
# they do not exist yet (first boot, or root) the system-wide ones apply.
USER_DIR="$HOME/.config/fastfetch"
pick() {
    if [ -f "$USER_DIR/$1.jsonc" ]; then
        echo "--config $USER_DIR/$1.jsonc"
    else
        echo "--config /etc/fastfetch/$1.jsonc"
    fi
}
FULL=$(pick config)
COMPACT=$(pick compact)
TINY=$(pick tiny)

LINES_N=0; COLUMNS_N=0
if [ -t 1 ]; then
    LINES_N=$(tput lines 2>/dev/null) || LINES_N=0
    COLUMNS_N=$(tput cols 2>/dev/null) || COLUMNS_N=0
fi
case "$LINES_N"   in ''|*[!0-9]*) LINES_N=0 ;; esac
case "$COLUMNS_N" in ''|*[!0-9]*) COLUMNS_N=0 ;; esac

case "${ZETA_LOGO:-}" in
    full)    exec "$REAL" $FULL "$@" ;;
    compact) exec "$REAL" $COMPACT "$@" ;;
    tiny)    exec "$REAL" $TINY "$@" ;;
    none)    exec "$REAL" $TINY --logo none "$@" ;;
esac

if   [ "$LINES_N" -ge 70 ] && [ "$COLUMNS_N" -ge 168 ]; then exec "$REAL" $FULL "$@"
elif [ "$LINES_N" -ge 36 ] && [ "$COLUMNS_N" -ge 168 ]; then exec "$REAL" $COMPACT "$@"
elif [ "$LINES_N" -ge 18 ] && [ "$COLUMNS_N" -ge 104 ]; then exec "$REAL" $TINY "$@"
fi
exec "$REAL" $TINY --logo none "$@"

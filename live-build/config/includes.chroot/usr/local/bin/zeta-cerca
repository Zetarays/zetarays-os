# ZETA RAYS — ricerca universale (stile Spotlight). Apre app, impostazioni, azioni,
# file (per nome, via plocate) e documenti (per contenuto, via l'indice FTS con
# testo dei PDF e OCR delle immagini). Tutto da tastiera: scrivi, frecce per
# scegliere, Invio per aprire, Esc per chiudere.
import glob
import os
import subprocess
import sys
import threading

# gtk4-layer-shell va caricato prima di libwayland: rilancia con LD_PRELOAD
if "ZETA_CERCA_PRELOADED" not in os.environ:
    libs = glob.glob("/usr/lib/*/libgtk4-layer-shell.so.0")
    if libs:
        env = dict(os.environ, ZETA_CERCA_PRELOADED="1",
                   LD_PRELOAD=(libs[0] + " " + os.environ.get("LD_PRELOAD", "")).strip())
        os.execve(sys.executable, [sys.executable] + sys.argv, env)

sys.path.insert(0, "/usr/lib/zeta")
import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
try:
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gtk4LayerShell as LayerShell
except (ValueError, ImportError):
    LayerShell = None
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

from search import indexer  # noqa: E402

HOME = os.path.expanduser("~")

# Azioni e impostazioni raggiungibili dalla ricerca: (titolo, sottotitolo, icona, parole, comando)
ACTIONS = [
    ("Impostazioni", "Preferenze di sistema", "zeta-impostazioni", "impostazioni settings preferenze", ["zeta-impostazioni"]),
    ("Aspetto", "Colore, tema, sfondo", "zeta-palette", "aspetto tema colore sfondo wallpaper", ["zeta-impostazioni", "aspetto"]),
    ("Dock", "Personalizza la barra", "zeta-dock", "dock barra taskbar", ["zeta-impostazioni", "dock"]),
    ("Wi-Fi e rete", "Connessioni di rete", "zeta-wifi", "rete wifi network internet", ["zeta-impostazioni", "rete"]),
    ("Audio", "Volume e dispositivi", "zeta-volume", "audio suono volume", ["zeta-impostazioni", "audio"]),
    ("AI", "ZETA e provider", "zeta-ai", "ai intelligenza assistente", ["zeta-impostazioni", "ai"]),
    ("Monitor di sistema", "CPU, rete, processi", "zeta-monitor", "monitor sistema cpu processi rete", ["zeta-monitor"]),
    ("Sicurezza", "Firewall e strumenti", "zeta-sicurezza", "sicurezza firewall security", ["zeta-sicurezza"]),
    ("Terminale", "Riga di comando", "foot", "terminale terminal console shell", ["foot"]),
    ("ZETA", "Parla con ZETA", "zeta-core", "core assistente intelligenza voce zeta", ["zeta-core"]),
    ("Blocca schermo", "Blocca la sessione", "zeta-lock", "blocca lock schermo", ["hyprlock"]),
    ("Energia", "Spegni, riavvia, sospendi", "zeta-power", "energia spegni riavvia sospendi standby esci", ["zeta-pannello", "energia"]),
    ("Finestre", "Aperte e ridotte a icona", "zeta-dock", "finestre window ridotte minimizzate aperte", ["zeta-finestre"]),
    ("Scrivania", "Apri la cartella Scrivania", "system-file-manager", "scrivania desktop cartella", ["zeta-scrivania-apri"]),
]

CSS = """
window.zeta-cerca { background: @scrim_strong; }
.zeta-cerca * { font-family: "Roboto", sans-serif; color: @ink; }
.sp-search { min-height: 54px; min-width: 620px; padding: 0 20px; font-size: 18px;
  border-radius: 18px; background: @hover;
  border: 1px solid @accent_line; box-shadow: 0 0 0 4px @accent_soft; outline: none; }
.sp-search image { color: @ink_dim; -gtk-icon-size: 22px; }
.sp-list { background: transparent; }
.sp-list row { padding: 0; border-radius: 12px; }
.sp-list row:selected { background: @accent_soft; }
.sp-row { padding: 9px 14px; }
.sp-title { font-size: 14px; color: @ink; }
.sp-sub { font-size: 11.5px; color: @ink_dim; }
.sp-cat { font-size: 10px; letter-spacing: 0.06em; color: @ink_dim; }
.sp-empty { color: @ink_dim; font-size: 14px; margin-top: 20px; }
scrolledwindow, viewport { background: none; }
"""
DEFAULT_COLORS = """
@define-color accent #3A8DFF;
@define-color accent_ink #FFFFFF;
@define-color accent_soft rgba(58,141,255,0.14);
@define-color accent_line rgba(58,141,255,0.35);
@define-color surface rgba(18,18,20,0.94);
@define-color surface_2 rgba(255,255,255,0.04);
@define-color ink #EDEDEA;
@define-color ink_2 #C8C8CC;
@define-color ink_dim #8A8A8E;
@define-color line rgba(255,255,255,0.08);
@define-color hover rgba(255,255,255,0.07);
@define-color hover_2 rgba(255,255,255,0.14);
@define-color glass rgba(18,18,20,0.78);
@define-color scrim rgba(0,0,0,0.45);
@define-color scrim_strong rgba(0,0,0,0.74);
"""


def clean_env_ctx():
    ctx = Gdk.Display.get_default().get_app_launch_context()
    ctx.unsetenv("LD_PRELOAD")
    return ctx


def spawn(cmd):
    env = dict(os.environ)
    env["LD_PRELOAD"] = " ".join(p for p in env.get("LD_PRELOAD", "").split()
                                 if "gtk4-layer-shell" not in p)
    if not env["LD_PRELOAD"]:
        env.pop("LD_PRELOAD", None)
    env.pop("ZETA_CERCA_PRELOADED", None)
    subprocess.Popen(cmd, start_new_session=True, env=env)


def file_results(query, limit=8):
    """File per nome: plocate (indice di sistema) o, se assente, find nella home."""
    out = []
    seen = set()
    try:
        p = subprocess.run(["plocate", "-i", "-l", str(limit * 3), "--", query],
                           capture_output=True, text=True, timeout=4)
        lines = [l for l in p.stdout.splitlines() if l]
    except (FileNotFoundError, subprocess.SubprocessError):
        lines = []
    if not lines:
        try:
            p = subprocess.run(["find", HOME, "-maxdepth", "4", "-iname", "*%s*" % query,
                                "-not", "-path", "*/.*"],
                               capture_output=True, text=True, timeout=4)
            lines = p.stdout.splitlines()
        except (OSError, subprocess.SubprocessError):
            lines = []
    # priorità: prima i file dell'utente (home), poi il resto; si saltano i
    # percorsi di sistema più rumorosi (header, cache, doc).
    NOISE = ("/usr/include/", "/usr/lib/", "/usr/share/doc/", "/var/lib/",
             "/usr/src/", "/proc/", "/sys/")
    home_hits, other_hits = [], []
    for path in lines:
        if path in seen or not os.path.exists(path):
            continue
        seen.add(path)
        if path.startswith(HOME):
            home_hits.append(path)
        elif not any(n in path for n in NOISE):
            other_hits.append(path)
    for path in home_hits + other_hits:
        out.append(path)
        if len(out) >= limit:
            break
    return out


class Cerca(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Ricerca", decorated=False)
        self.add_css_class("zeta-cerca")
        self._timer = 0

        if LayerShell and LayerShell.is_supported():
            LayerShell.init_for_window(self)
            LayerShell.set_namespace(self, "zeta-cerca")
            LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
            LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.EXCLUSIVE)
            LayerShell.set_exclusive_zone(self, -1)
            for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
                LayerShell.set_anchor(self, edge, True)
        else:
            self.fullscreen()

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16,
                       margin_top=110, margin_bottom=110, halign=Gtk.Align.CENTER)
        self.search = Gtk.SearchEntry(placeholder_text="Cerca app, file, impostazioni…")
        self.search.add_css_class("sp-search")
        self.search.connect("search-changed", lambda *_: self._schedule())
        self.search.connect("activate", lambda *_: self._activate_selected())
        root.append(self.search)

        self.listbox = Gtk.ListBox(css_classes=["sp-list"], selection_mode=Gtk.SelectionMode.SINGLE)
        self.listbox.set_size_request(660, -1)
        self.listbox.connect("row-activated", lambda _lb, row: self._open(row))
        scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER,
                                      max_content_height=520, propagate_natural_height=True)
        scroller.set_child(self.listbox)
        root.append(scroller)

        self.empty = Gtk.Label(label="Scrivi per cercare in app, file, documenti e impostazioni.",
                               css_classes=["sp-empty"])
        root.append(self.empty)
        self.set_child(root)

        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.search.grab_focus()
        # resta in memoria: chiudere (Esc, un risultato aperto) vuol dire
        # nascondere, cosi' la prossima apertura e' immediata
        self.connect("close-request", lambda *_: (self.set_visible(False), True)[1])

    def prepara(self):
        """Ogni volta che compare: ricerca vuota, nessun risultato vecchio."""
        self.search.set_text("")
        self._clear()

    # -------- ricerca --------
    def _schedule(self):
        if self._timer:
            GLib.source_remove(self._timer)
        self._timer = GLib.timeout_add(130, self._run_query)

    def _app_infos(self):
        """Elenco delle applicazioni, letto una volta sola.

        Gio.AppInfo.get_all() rilegge tutti i file .desktop del sistema: farlo
        a ogni tasto premuto significa toccare il disco decine di volte mentre
        l'utente scrive.
        """
        infos = getattr(self, "_apps_cache", None)
        if infos is None:
            infos = self._apps_cache = [i for i in Gio.AppInfo.get_all() if i.should_show()]
        return infos

    def _run_query(self):
        self._timer = 0
        query = self.search.get_text().strip()
        self._clear()
        # Ogni ricerca ha un numero: i risultati lenti che arrivano dopo che
        # l'utente ha continuato a scrivere appartengono a una ricerca vecchia
        # e vanno buttati, non mostrati sopra quelli nuovi.
        self._gen = getattr(self, "_gen", 0) + 1
        gen = self._gen
        if not query:
            self.empty.set_visible(True)
            return False
        rows = []
        low = query.casefold()

        # 1) applicazioni
        for info in self._app_infos():
            name = info.get_display_name() or ""
            hay = (name + " " + (info.get_executable() or "")).casefold()
            if all(w in hay for w in low.split()):
                rows.append(("App", name, info.get_description() or "Applicazione",
                             info.get_icon(), lambda i=info: self._launch_app(i)))
        # 2) azioni e impostazioni
        for title, sub, icon, words, cmd in ACTIONS:
            if all(any(w in field for field in (title.casefold(), words)) for w in low.split()):
                rows.append(("Azione", title, sub, icon, lambda c=cmd: (spawn(c), self.close())))

        # App e azioni sono immediate: si mostrano subito.
        self._mostra(rows)

        # File e contenuti no: l'indice e plocate possono metterci secondi, e
        # aspettarli qui congelerebbe la finestra a ogni lettera digitata.
        threading.Thread(target=self._cerca_file, args=(query, gen),
                         daemon=True).start()
        return False

    def _cerca_file(self, query, gen):
        """Parte lenta della ricerca, fuori dal filo dell'interfaccia."""
        try:
            contenuti = indexer.search(query, limit=6)
            percorsi = file_results(query, limit=8)
        except Exception as e:  # noqa: BLE001
            print("cerca: ricerca file non riuscita: %s" % e, file=sys.stderr)
            return
        GLib.idle_add(self._file_pronti, gen, contenuti, percorsi)

    def _file_pronti(self, gen, contenuti, percorsi):
        if gen != getattr(self, "_gen", 0):
            return False                      # ricerca superata da una più recente
        rows = []
        visti = set()
        for r in contenuti:
            visti.add(r["path"])
            sub = r["snippet"] or r["path"].replace(HOME, "~")
            rows.append(("Contenuto", r["name"], sub, self._file_icon(r["kind"]),
                         lambda p=r["path"]: self._open_path(p)))
        for path in percorsi:
            if path in visti:
                continue
            sub = os.path.dirname(path).replace(HOME, "~")
            rows.append(("File", os.path.basename(path), sub,
                         self._file_icon("cartella" if os.path.isdir(path) else "file"),
                         lambda p=path: self._open_path(p)))
        self._mostra(rows, aggiungi=True)
        return False

    def _mostra(self, rows, aggiungi=False):
        gia = 0
        if aggiungi:
            c = self.listbox.get_first_child()
            while c:
                gia += 1
                c = c.get_next_sibling()
        for cat, title, sub, icon, action in rows[:max(0, 24 - gia)]:
            self.listbox.append(self._make_row(cat, title, sub, icon, action))
        if aggiungi:
            # Solo ora si sa davvero se non c'è nulla: prima mancavano i file.
            self.empty.set_visible(gia == 0 and not rows)
        elif rows:
            self.empty.set_visible(False)
        if not self.listbox.get_selected_row():
            first = self.listbox.get_row_at_index(0)
            if first:
                self.listbox.select_row(first)

    def _make_row(self, cat, title, sub, icon, action):
        box = Gtk.Box(spacing=12, css_classes=["sp-row"])
        img = Gtk.Image(pixel_size=30)
        if isinstance(icon, Gio.Icon):
            img.set_from_gicon(icon)
        elif icon and os.path.isabs(icon):
            img.set_from_file(icon)
        elif icon:
            img.set_from_icon_name(icon)
        else:
            img.set_from_icon_name("application-x-executable")
        box.append(img)
        txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
        t = Gtk.Label(label=title, xalign=0, css_classes=["sp-title"],
                      ellipsize=Pango.EllipsizeMode.END, max_width_chars=48)
        s = Gtk.Label(label=sub, xalign=0, css_classes=["sp-sub"],
                      ellipsize=Pango.EllipsizeMode.END, max_width_chars=64)
        txt.append(t)
        txt.append(s)
        box.append(txt)
        box.append(Gtk.Label(label=cat, css_classes=["sp-cat"], valign=Gtk.Align.CENTER))
        row = Gtk.ListBoxRow(child=box)
        row.action = action
        return row

    def _file_icon(self, kind):
        return {"pdf": "org.gnome.Evince", "immagine": "eog", "cartella": "org.xfce.thunar",
                "testo": "org.gnome.TextEditor"}.get(kind, "text-x-generic")

    # -------- apertura --------
    def _open(self, row):
        if row and getattr(row, "action", None):
            row.action()

    def _activate_selected(self):
        row = self.listbox.get_selected_row() or self.listbox.get_row_at_index(0)
        self._open(row)

    def _launch_app(self, info):
        try:
            info.launch([], clean_env_ctx())
        except GLib.Error:
            pass
        self.close()

    def _open_path(self, path):
        spawn(["xdg-open", path])
        self.close()

    # -------- tastiera --------
    def _clear(self):
        child = self.listbox.get_first_child()
        while child:
            self.listbox.remove(child)
            child = self.listbox.get_first_child()

    def _move(self, delta):
        rows = []
        c = self.listbox.get_first_child()
        while c:
            rows.append(c)
            c = c.get_next_sibling()
        if not rows:
            return
        cur = self.listbox.get_selected_row()
        i = rows.index(cur) if cur in rows else -1
        i = max(0, min(len(rows) - 1, i + delta))
        self.listbox.select_row(rows[i])
        rows[i].grab_focus()
        self.search.grab_focus_without_selecting()

    def on_key(self, _c, keyval, _kc, _mod):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        if keyval in (Gdk.KEY_Down, Gdk.KEY_Tab):
            self._move(1)
            return True
        if keyval in (Gdk.KEY_Up, Gdk.KEY_ISO_Left_Tab):
            self._move(-1)
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self._activate_selected()
            return True
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Cerca", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.win = None
        self.nascosto = False

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.nascosto = os.environ.pop("ZETA_PANNELLO_NASCOSTO", None) == "1"
        azione = Gio.SimpleAction.new("mostra", None)
        azione.connect("activate", lambda *_: self.alterna())
        self.add_action(azione)
        self.hold()                    # resta viva anche a ricerca nascosta
        pre = " ".join(p for p in os.environ.get("LD_PRELOAD", "").split() if "gtk4-layer-shell" not in p)
        if pre:
            os.environ["LD_PRELOAD"] = pre
        else:
            os.environ.pop("LD_PRELOAD", None)
        os.environ.pop("ZETA_CERCA_PRELOADED", None)
        settings = Gtk.Settings.get_default()
        # il tema (chiaro o scuro) è quello scelto in Impostazioni > Aspetto
        chiaro = False
        try:
            chiaro = open(os.path.expanduser("~/.config/zeta/tema")).read().strip() == "chiaro"
        except OSError:
            pass
        settings.set_property("gtk-application-prefer-dark-theme", not chiaro)
        settings.set_property("gtk-icon-theme-name", "zeta")
        settings.set_property("gtk-font-name", "Roboto 10")
        colors = Gtk.CssProvider()
        path = os.path.expanduser("~/.config/zeta/colors.css")
        if os.path.exists(path):
            colors.load_from_path(path)
        else:
            colors.load_from_string(DEFAULT_COLORS)
        style = Gtk.CssProvider()
        style.load_from_string(CSS)
        display = Gdk.Display.get_default()
        Gtk.StyleContext.add_provider_for_display(display, colors, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.StyleContext.add_provider_for_display(display, style, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

    def do_activate(self):
        if self.nascosto:              # avviata dalla sessione: pronta, non visibile
            self.nascosto = False
            self.win = Cerca(self)
            return
        self.alterna()

    def alterna(self):
        if self.win is not None and self.win.get_visible():
            self.win.set_visible(False)
            return
        if self.win is None:
            self.win = Cerca(self)
        self.win.prepara()
        self.win.present()
        self.win.search.grab_focus()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))

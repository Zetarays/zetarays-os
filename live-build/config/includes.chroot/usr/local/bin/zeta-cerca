def clean_env_ctx():
    ctx = Gdk.Display.get_default().get_app_launch_context()
    ctx.unsetenv("LD_PRELOAD")
    return ctx


def spawn(cmd):
    env = dict(os.environ)
    env["LD_PRELOAD"] = " ".join(p for p in env.get("LD_PRELOAD", "").split()
                                 if "gtk4-layer-shell" not in p)
    if not env["LD_PRELOAD"]:
        env.pop("LD_PRELOAD", None)
    env.pop("ZETA_CERCA_PRELOADED", None)
    # la ricerca resta accesa: l'uscita va raccolta, o resta un processo zombie
    reg.lancia(cmd if isinstance(cmd, list) else ["sh", "-c", cmd], env=env,
               stdout=None, stderr=None)


# fuori dalla home si mostrano solo i dischi esterni, i programmi in /opt e la
# configurazione; mai i file interni del sistema (/usr, /var, /proc...)
ALTRI_POSTI = ("/media/", "/mnt/", "/run/media/", "/opt/", "/srv/", "/etc/")
# i dischi esterni non sono nell'indice di plocate (Debian esclude /media):
# si guardano direttamente, come la home
DISCHI = ("/media/" + os.environ.get("USER", ""), "/run/media/" + os.environ.get("USER", ""))

_IN_CORSO = set()                 # find/plocate della ricerca attuale
_IN_CORSO_LOCK = threading.Lock()


def ferma_ricerche():
    """Una lettera in piu' rende vecchia la ricerca in corso: i suoi find e
    plocate si fermano subito invece di lavorare per niente."""
    with _IN_CORSO_LOCK:
        for proc in list(_IN_CORSO):
            try:
                proc.kill()
            except OSError:
                pass


def _righe(argv, timeout):
    """Righe complete stampate dal comando entro il tempo dato (le ultime,
    tagliate a meta' dal tempo scaduto, si scartano). Nomi di file non UTF-8
    non fermano la ricerca."""
    try:
        proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return []
    with _IN_CORSO_LOCK:
        _IN_CORSO.add(proc)
    try:
        out, _err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        out, _err = proc.communicate()
    finally:
        with _IN_CORSO_LOCK:
            _IN_CORSO.discard(proc)
    testo = out.decode("utf-8", errors="replace")
    righe = testo.split("\n")
    return righe[:-1]             # l'ultima e' vuota, o incompleta


def _glob_letterale(testo):
    """Il testo cercato dentro un modello (find, plocate): * ? [ ] valgono se stessi."""
    return "".join("\\" + c if c in "*?[]\\" else c for c in testo)


def file_results(query, limit=8):
    """File per nome, come Spotlight: prima quelli dell'utente (anche appena
    creati: la home si guarda direttamente), poi dischi esterni, /opt, /etc.
    Ritorna coppie (percorso, e_cartella)."""
    query = query.strip()
    if not query:
        return []
    q = query.casefold()
    modello = "*%s*" % _glob_letterale(query)
    casa_reale = os.path.realpath(HOME)
    case = {HOME, casa_reale}

    def cerca_in(cartella, profondita, timeout):
        # -H: la home puo' essere un collegamento (/home/u -> /dati/u)
        return _righe(["find", "-H", cartella, "-maxdepth", str(profondita), "-name", ".*", "-prune",
                       "-o", "-iname", modello, "-print"], timeout)

    casa = cerca_in(HOME, 6, 2)
    dischi = []
    for d in DISCHI:
        if os.path.isdir(d):
            dischi += cerca_in(d, 5, 2)
    altrove = []
    # plocate per posto: un solo elenco con un limite si riempirebbe di /etc
    # (che viene prima nell'indice) per le parole corte
    for base in (casa_reale,) + tuple(a.rstrip("/") for a in ALTRI_POSTI if a not in ("/media/", "/run/media/")):
        for path in _righe(["plocate", "-i", "-l", "400", "--", base + "/" + modello], 3):
            if q not in os.path.basename(path).casefold():
                continue                    # il testo era in una cartella, non nel nome
            if base == casa_reale:
                if "/." not in path[len(casa_reale):]:
                    casa.append(path)       # piu' in profondita' di dove guarda find
            else:
                altrove.append(path)

    def ordine(path):
        nome = os.path.basename(path).casefold()
        return (0 if nome.startswith(q) else 1, path.count("/"), nome)

    def posto(path):
        return next((i for i, a in enumerate(ALTRI_POSTI) if path.startswith(a)), len(ALTRI_POSTI))

    out, visti = [], set()
    for gruppo in (sorted(set(casa), key=ordine),
                   sorted(set(dischi) | set(altrove), key=lambda x: (posto(x), ordine(x)))):
        for path in gruppo:
            if path in visti or path in case or not os.path.lexists(path):
                continue
            visti.add(path)
            # qui, fuori dall'interfaccia: un disco di rete bloccato fa
            # aspettare questa ricerca, non congela la finestra
            out.append((path, os.path.isdir(path)))
            if len(out) >= limit:
                return out
    return out


class Cerca(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Ricerca", decorated=False)
        self.add_css_class("zeta-cerca")
        self._timer = 0

        if LayerShell and LayerShell.is_supported():
            LayerShell.init_for_window(self)
            LayerShell.set_namespace(self, "zeta-cerca")
            LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
            LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.EXCLUSIVE)
            LayerShell.set_exclusive_zone(self, -1)
            for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
                LayerShell.set_anchor(self, edge, True)
        else:
            self.fullscreen()

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16,
                       margin_top=110, margin_bottom=110, halign=Gtk.Align.CENTER)
        self.search = Gtk.SearchEntry(placeholder_text="Cerca app, file, impostazioni…")
        self.search.add_css_class("sp-search")
        self.search.connect("search-changed", lambda *_: self._schedule())
        self.search.connect("activate", lambda *_: self._activate_selected())
        root.append(self.search)

        self.listbox = Gtk.ListBox(css_classes=["sp-list"], selection_mode=Gtk.SelectionMode.SINGLE)
        self.listbox.set_size_request(660, -1)
        self.listbox.connect("row-activated", lambda _lb, row: self._open(row))
        scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER,
                                      max_content_height=520, propagate_natural_height=True)
        scroller.set_child(self.listbox)
        root.append(scroller)

        self.empty = Gtk.Label(label="Scrivi per cercare in app, file, documenti e impostazioni.",
                               css_classes=["sp-empty"])
        root.append(self.empty)
        # menu del tasto destro sulle app: sopra i risultati, dentro la finestra
        overlay = Gtk.Overlay(child=root)
        self.menu = menu_app.MenuInterno(overlay)
        self.set_child(overlay)
        fuori = Gtk.GestureClick()
        fuori.connect("pressed", self._clic_fuori_menu)
        self.add_controller(fuori)

        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.search.grab_focus()
        # resta in memoria: chiudere (Esc, un risultato aperto) vuol dire
        # nascondere, cosi' la prossima apertura e' immediata
        self.connect("close-request", lambda *_: (self.set_visible(False), True)[1])

    def prepara(self):
        """Ogni volta che compare: ricerca vuota, nessun risultato vecchio."""
        self.menu.chiudi()
        self.search.set_text("")
        self._clear()

    # -------- ricerca --------
    def _schedule(self):
        if self._timer:
            GLib.source_remove(self._timer)
        self._timer = GLib.timeout_add(130, self._run_query)

    def _app_infos(self):
        """Le app del registro unico: stesse del menu (anche quelle installate
        dopo l'apertura: il registro si rilegge solo se le cartelle cambiano)."""
        reg.icone_gtk()
        return reg.menu()

    def _run_query(self):
        self._timer = 0
        query = self.search.get_text().strip()
        self._clear()
        # Ogni ricerca ha un numero: i risultati lenti che arrivano dopo che
        # l'utente ha continuato a scrivere appartengono a una ricerca vecchia
        # e vanno buttati, non mostrati sopra quelli nuovi.
        self._gen = getattr(self, "_gen", 0) + 1
        gen = self._gen
        ferma_ricerche()
        if not query:
            self.empty.set_visible(True)
            return False
        rows = []
        low = query.casefold()

        # 1) applicazioni: nome, provenienza e percorso; le piu' pertinenti prima
        trovate = []
        for app in self._app_infos():
            nome = app.nome.casefold()
            hay = " ".join([nome, app.id, os.path.basename(app.eseguibile),
                            app.descrizione] + app.parole).casefold()
            if all(w in hay for w in low.split()):
                peso = 0 if nome.startswith(low) else 1 if any(p.startswith(low) for p in nome.split()) else 2
                trovate.append((peso, nome, app))
        for _p, _n, app in sorted(trovate, key=lambda t: (t[0], t[1]))[:8]:
            dove = app.flatpak_id if app.fonte == "flatpak" else (app.appimage or app.eseguibile or app.desktop)
            sub = "%s · %s" % (reg.FONTI.get(app.fonte, app.fonte), (dove or "").replace(HOME, "~"))
            rows.append(("App", app.nome, sub, app.icona, lambda a=app: self._launch_app(a), app))
        # 2) azioni e impostazioni
        for title, sub, icon, words, cmd in ACTIONS:
            if all(any(w in field for field in (title.casefold(), words)) for w in low.split()):
                rows.append(("Azione", title, sub, icon, lambda c=cmd: (spawn(c), self.close()), None))

        # App e azioni sono immediate: si mostrano subito.
        self._mostra(rows)

        # File e contenuti no: l'indice e plocate possono metterci secondi, e
        # aspettarli qui congelerebbe la finestra a ogni lettera digitata.
        threading.Thread(target=self._cerca_file, args=(query, gen),
                         daemon=True).start()
        return False

    def _cerca_file(self, query, gen):
        """Parte lenta della ricerca, fuori dal filo dell'interfaccia. Un
        problema in una delle due ricerche non cancella i risultati dell'altra."""
        contenuti, percorsi = [], []
        try:
            # l'indice si aggiorna ogni mezz'ora: un file appena cancellato non si mostra
            contenuti = [r for r in indexer.search(query, limit=6) if os.path.exists(r["path"])]
        except Exception as e:  # noqa: BLE001
            print("cerca: ricerca nei contenuti non riuscita: %s" % e, file=sys.stderr)
        try:
            percorsi = file_results(query, limit=8)
        except Exception as e:  # noqa: BLE001
            print("cerca: ricerca dei file non riuscita: %s" % e, file=sys.stderr)
        GLib.idle_add(self._file_pronti, gen, query, contenuti, percorsi)

    def _file_pronti(self, gen, query, contenuti, percorsi):
        if gen != getattr(self, "_gen", 0):
            return False                      # ricerca superata da una più recente
        # prima i file trovati per nome (dalla ricerca o dall'indice, una
        # volta sola), poi quelli che contengono la parola nel testo; tutti
        # con l'icona del loro tipo e la cartella sotto il nome
        q = query.strip().casefold()
        per_nome, nel_testo, visti = [], [], set()
        for path, cartella in percorsi:
            visti.add(path)
            per_nome.append((path, cartella, ""))
        for r in contenuti:
            if r["path"] in visti:
                continue
            visti.add(r["path"])
            if q in r["name"].casefold():
                per_nome.append((r["path"], False, ""))
            else:
                nel_testo.append((r["path"], False, r["snippet"]))
        rows = []
        for categoria, elenco in (("File", per_nome), ("Contenuto", nel_testo)):
            for path, cartella, estratto in elenco:
                sub = estratto or os.path.dirname(path).replace(HOME, "~")
                rows.append((categoria, os.path.basename(path), sub, self._icona_percorso(path, cartella),
                             lambda p=path: self._open_path(p), None))
        self._mostra(rows, aggiungi=True)
        return False

    def _mostra(self, rows, aggiungi=False):
        gia = 0
        if aggiungi:
            c = self.listbox.get_first_child()
            while c:
                gia += 1
                c = c.get_next_sibling()
        for cat, title, sub, icon, action, app in rows[:max(0, 24 - gia)]:
            self.listbox.append(self._make_row(cat, title, sub, icon, action, app))
        if aggiungi:
            # Solo ora si sa davvero se non c'è nulla: prima mancavano i file.
            self.empty.set_visible(gia == 0 and not rows)
        elif rows:
            self.empty.set_visible(False)
        if not self.listbox.get_selected_row():
            first = self.listbox.get_row_at_index(0)
            if first:
                self.listbox.select_row(first)

    def _make_row(self, cat, title, sub, icon, action, app=None):
        box = Gtk.Box(spacing=12, css_classes=["sp-row"])
        img = Gtk.Image(pixel_size=30)
        if isinstance(icon, Gio.Icon):
            img.set_from_gicon(icon)
        elif app is not None and icon:
            try:
                img.set_from_gicon(Gio.Icon.new_for_string(icon))
            except GLib.Error:
                img.set_from_icon_name("application-x-executable")
        elif icon and os.path.isabs(icon):
            img.set_from_file(icon)
        elif icon:
            img.set_from_icon_name(icon)
        else:
            img.set_from_icon_name("application-x-executable")
        box.append(img)
        txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
        t = Gtk.Label(label=title, xalign=0, css_classes=["sp-title"],
                      ellipsize=Pango.EllipsizeMode.END, max_width_chars=48)
        s = Gtk.Label(label=sub, xalign=0, css_classes=["sp-sub"],
                      ellipsize=Pango.EllipsizeMode.END, max_width_chars=64)
        txt.append(t)
        txt.append(s)
        box.append(txt)
        box.append(Gtk.Label(label=cat, css_classes=["sp-cat"], valign=Gtk.Align.CENTER))
        row = Gtk.ListBoxRow(child=box)
        row.action = action
        if app is not None:
            # stesso menu del menu delle app: posizione, Scrivania, Dock,
            # Informazioni, disinstalla. Tasto destro o pulsante «⋯».
            def menu(widget, x, y, a=app):
                self.menu.apri(widget, x, y, menu_app.voci_app(a, self._launch_app, self.close))
            altro = Gtk.Button(icon_name="view-more-symbolic", valign=Gtk.Align.CENTER,
                               css_classes=["flat"], tooltip_text="Altre azioni")
            altro.connect("clicked", lambda b: menu(b, b.get_width() / 2, b.get_height()))
            box.append(altro)
            destro = Gtk.GestureClick(button=Gdk.BUTTON_SECONDARY)
            destro.connect("pressed", lambda g, _n, x, y: menu(g.get_widget(), x, y))
            row.add_controller(destro)
            # la versione la chiede a dpkg/flatpak: arriva dopo, senza far aspettare
            def versione(a=app, lab=s, base=sub):
                v = reg.versione(a)
                if v:
                    GLib.idle_add(lab.set_label, "%s · %s" % (base, v))
            threading.Thread(target=versione, daemon=True).start()
        return row

    def _icona_percorso(self, path, cartella):
        """Icona del tipo di file (foglio di calcolo, PDF, immagine...), come
        nel gestore file; se il tema non ce l'ha, quella generica. Il tipo si
        ricava dal nome: qui il file non si apre."""
        if cartella:
            return "folder"
        tipo, _incerto = Gio.content_type_guess(path, None)
        tema = Gtk.IconTheme.get_for_display(self.get_display())
        for nome in Gio.content_type_get_icon(tipo).get_names():
            if tema.has_icon(nome):
                return nome
        return "text-x-generic"

    # -------- apertura --------
    def _open(self, row):
        if row and getattr(row, "action", None):
            row.action()

    def _activate_selected(self):
        row = self.listbox.get_selected_row() or self.listbox.get_row_at_index(0)
        self._open(row)

    def _clic_fuori_menu(self, gesture, _n, x, y):
        if self.menu.aperto() and not self.menu.contiene(self.pick(x, y, Gtk.PickFlags.DEFAULT)):
            self.menu.chiudi()

    def _launch_app(self, app):
        reg.avvia(app, clean_env_ctx())
        self.close()

    def _open_path(self, path):
        spawn(["xdg-open", path])
        self.close()

    # -------- tastiera --------
    def _clear(self):
        child = self.listbox.get_first_child()
        while child:
            self.listbox.remove(child)
            child = self.listbox.get_first_child()

    def _move(self, delta):
        rows = []
        c = self.listbox.get_first_child()
        while c:
            rows.append(c)
            c = c.get_next_sibling()
        if not rows:
            return
        cur = self.listbox.get_selected_row()
        i = rows.index(cur) if cur in rows else -1
        i = max(0, min(len(rows) - 1, i + delta))
        self.listbox.select_row(rows[i])
        rows[i].grab_focus()
        self.search.grab_focus_without_selecting()

    def on_key(self, _c, keyval, _kc, _mod):
        if self.menu.aperto():
            # menu del tasto destro aperto: Esc lo chiude, frecce e Invio
            # muovono e scelgono le sue voci (non i risultati sotto)
            if keyval == Gdk.KEY_Escape:
                self.menu.chiudi()
                return True
            return False
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        if keyval in (Gdk.KEY_Down, Gdk.KEY_Tab):
            self._move(1)
            return True
        if keyval in (Gdk.KEY_Up, Gdk.KEY_ISO_Left_Tab):
            self._move(-1)
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self._activate_selected()
            return True
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.zetarays.Cerca", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.win = None
        self.nascosto = False

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.nascosto = os.environ.pop("ZETA_PANNELLO_NASCOSTO", None) == "1"
        azione = Gio.SimpleAction.new("mostra", None)
        azione.connect("activate", lambda *_: self.alterna())
        self.add_action(azione)
        self.hold()                    # resta viva anche a ricerca nascosta
        pre = " ".join(p for p in os.environ.get("LD_PRELOAD", "").split() if "gtk4-layer-shell" not in p)
        if pre:
            os.environ["LD_PRELOAD"] = pre
        else:
            os.environ.pop("LD_PRELOAD", None)
        os.environ.pop("ZETA_CERCA_PRELOADED", None)
        settings = Gtk.Settings.get_default()
        # il tema (chiaro o scuro) è quello scelto in Impostazioni > Aspetto
        chiaro = False
        try:
            chiaro = open(os.path.expanduser("~/.config/zeta/tema")).read().strip() == "chiaro"
        except OSError:
            pass
        settings.set_property("gtk-application-prefer-dark-theme", not chiaro)
        settings.set_property("gtk-icon-theme-name", "zeta")
        settings.set_property("gtk-font-name", "Roboto 10")
        colors = Gtk.CssProvider()
        path = os.path.expanduser("~/.config/zeta/colors.css")
        if os.path.exists(path):
            colors.load_from_path(path)
        else:
            colors.load_from_string(DEFAULT_COLORS)
        style = Gtk.CssProvider()
        style.load_from_string(CSS)
        display = Gdk.Display.get_default()
        Gtk.StyleContext.add_provider_for_display(display, colors, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.StyleContext.add_provider_for_display(display, style, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

    def do_activate(self):
        if self.nascosto:              # avviata dalla sessione: pronta, non visibile
            self.nascosto = False
            self.win = Cerca(self)
            return
        self.alterna()

    def alterna(self):
        if self.win is not None and self.win.get_visible():
            self.win.set_visible(False)
            return
        if self.win is None:
            self.win = Cerca(self)
        self.win.prepara()
        self.win.present()
        self.win.search.grab_focus()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))

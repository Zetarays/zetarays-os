[Desktop Entry]
# ZETA RAYS: LocalSend is used as «ZETA Share» (zeta-share.desktop). This
# copy in /usr/local hides the original entry from the launcher without
# touching the package, so a LocalSend update does not bring back a duplicate.
Type=Application
Name=LocalSend
Exec=zeta-share %F
Icon=zeta-share
NoDisplay=true

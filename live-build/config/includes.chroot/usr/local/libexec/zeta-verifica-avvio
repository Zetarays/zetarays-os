#!/bin/bash
# shellcheck disable=SC2059  # i formati di printf vengono dalle traduzioni (gettext)
# SPDX-License-Identifier: GPL-3.0-or-later
# zeta-verifica-avvio — controlla che il programma di avvio sia DAVVERO finito
# sul disco, e fa fallire l'installazione se non c'e'.
#
# Perche' esiste
# --------------
# Calamares puo' saltare il passo del programma di avvio e arrivare comunque
# in fondo dicendo «All done». E' successo davvero: configurazione incompleta,
# oppure partizionamento manuale senza assegnare /boot/efi alla partizione di
# avvio. In entrambi i casi l'utente riavvia e trova
#
#     error: file '/boot/grub/x86_64-efi/normal.mod' not found
#     grub rescue>
#
# senza che niente, durante l'installazione, glielo avesse detto.
#
# Questo script gira DENTRO il sistema appena installato, come ultimo passo.
# Se il programma di avvio non c'e', esce con errore: Calamares mostra che
# l'installazione NON e' riuscita, e l'utente lo sa subito, davanti allo
# schermo, invece di scoprirlo al riavvio.
set -u
export TEXTDOMAIN=zetarays TEXTDOMAINDIR=/usr/share/locale
command -v gettext >/dev/null 2>&1 || gettext() { printf '%s' "$1"; }

errore() {
    printf "$(gettext 'ERROR: %s')\n\n" "$*" >&2
    gettext "The system was copied to the disk, but the boot loader was NOT
installed: the computer would not start after a restart.

If you chose manual partitioning, the most common cause is not
assigning the /boot/efi mount point to the EFI boot partition
(the small FAT32 one with the boot flag). Go back, assign it
WITHOUT formatting it, and try again.

Alternatively, from the ZETA RAYS USB stick:  sudo zeta-ripara-avvio" >&2
    echo >&2
    exit 1
}

echo "$(gettext "ZETA RAYS: checking the boot loader…")"

# I moduli di GRUB devono stare nella radice appena installata. E' il file che
# manca nell'errore «normal.mod not found».
MODULI=""
for P in /boot/grub/x86_64-efi /boot/grub/arm64-efi /boot/grub/i386-pc; do
    [ -f "$P/normal.mod" ] && MODULI="$MODULI $P"
done
[ -n "$MODULI" ] || errore "$(gettext "there are no GRUB modules in /boot/grub (normal.mod is missing).")"
printf "  $(gettext 'GRUB modules:%s')\n" "$MODULI"

if [ -d /sys/firmware/efi ]; then
    # Avvio UEFI: serve un programma di avvio dentro la partizione EFI.
    mountpoint -q /boot/efi || errore "$(gettext "/boot/efi is not mounted.")"
    TROVATI=$(find /boot/efi/EFI -maxdepth 2 -iname "*.efi" 2>/dev/null | wc -l)
    [ "$TROVATI" -gt 0 ] || errore "$(gettext "there is no boot loader in the EFI partition.")"
    printf "  $(gettext 'boot loaders in the EFI partition: %s')\n" "$TROVATI"

    NOSTRI=$(find /boot/efi/EFI/zetarays -iname "*.efi" 2>/dev/null | wc -l)
    if [ "$NOSTRI" -gt 0 ]; then
        printf "  $(gettext 'ZETA RAYS folder: /boot/efi/EFI/zetarays (%s files)')\n" "$NOSTRI"
    else
        # Non e' fatale: su alcuni firmware conta solo il percorso di ripiego.
        echo "  $(gettext "WARNING: /boot/efi/EFI/zetarays is missing, relying on the fallback path")" >&2
        find /boot/efi/EFI/BOOT -iname "boot*.efi" 2>/dev/null | head -1 | grep -q . \
            || errore "$(gettext "the EFI/BOOT fallback path is missing too.")"
    fi
else
    echo "  $(gettext "booting in BIOS mode")"
    [ -f /boot/grub/i386-pc/normal.mod ] \
        || errore "$(gettext "the GRUB BIOS modules are missing (/boot/grub/i386-pc).")"
fi

# Il menu deve avere almeno una voce, altrimenti si avvia su un elenco vuoto.
if [ -r /boot/grub/grub.cfg ]; then
    VOCI=$(grep -c "^menuentry \|^\s*menuentry " /boot/grub/grub.cfg 2>/dev/null || echo 0)
    [ "$VOCI" -gt 0 ] || errore "$(gettext "the boot menu (/boot/grub/grub.cfg) has no entries.")"
    printf "  $(gettext 'entries in the boot menu: %s')\n" "$VOCI"
else
    errore "$(gettext "/boot/grub/grub.cfg is missing.")"
fi

echo "$(gettext "ZETA RAYS: boot loader installed correctly.")"
exit 0

#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — systemd user generator: the localized folder names for
# zeta-appimage.path.
#
# zeta-appimage.path watches the usual AppImage folders by their English
# names. A unit file cannot read language data, so this generator adds the
# Italian names of the same folders (i18n-data/zeta-appimage.json) as a
# drop-in in the generator folder ($1). It runs when the user's service
# manager starts and at every daemon-reload; a missing folder is simply not
# watched, as with the names in the unit itself.
out="${1:-}"
[ -n "$out" ] || exit 0
names=$(/usr/libexec/zeta-i18n-data zeta-appimage watched_folders 2>/dev/null) || exit 0
[ -n "$names" ] || exit 0
mkdir -p "$out/zeta-appimage.path.d" || exit 0
{
    echo "# generated by zeta-appimage-folders"
    echo "[Path]"
    printf '%s\n' "$names" | while IFS= read -r name; do
        [ -n "$name" ] && printf 'PathChanged=%%h/%s\n' "$name"
    done
} > "$out/zeta-appimage.path.d/50-localized-folders.conf"
exit 0

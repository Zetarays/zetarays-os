#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ZETA RAYS — on the live system, automatic login opens the ZETA RAYS session.
# live-config's 0085-sddm component writes /etc/sddm.conf with an empty session:
# here we set it to zeta.desktop.

if [ -f /etc/sddm.conf ] && grep -q '^\[Autologin\]' /etc/sddm.conf; then
  if grep -q '^Session=' /etc/sddm.conf; then
    sed -i 's/^Session=.*/Session=zeta.desktop/' /etc/sddm.conf
  else
    sed -i '/^\[Autologin\]/a Session=zeta.desktop' /etc/sddm.conf
  fi
fi

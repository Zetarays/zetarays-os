# ZETA RAYS — command-line keyboard bindings (bash)
$include /etc/inputrc
# up/down arrows: search the commands that start with what has already been
# typed (on an empty line they scroll through the whole history)
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward
# Ctrl+arrows: move word by word
"\e[1;5C": forward-word
"\e[1;5D": backward-word
set completion-ignore-case on
set show-all-if-ambiguous on
set colored-stats on
set colored-completion-prefix on
set mark-symlinked-directories on
# pasting several lines does not run them: they are shown and confirmed with Enter
set enable-bracketed-paste on

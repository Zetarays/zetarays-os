[Unit]
Description=ZETA RAYS — content indexing for search

[Service]
Type=oneshot
# Indexing (OCR included) is heavy: it always stays in the background and
# must never starve the rest of the system of memory.
Nice=19
IOSchedulingClass=idle
CPUWeight=10
# CPU only when nobody else wants it, and OCR on a single thread:
# tesseract on its own grabs every core.
CPUSchedulingPolicy=idle
Environment=OMP_THREAD_LIMIT=1
MemoryHigh=20%
MemoryMax=35%
TimeoutStartSec=1800
ExecStart=/usr/local/bin/zeta-index

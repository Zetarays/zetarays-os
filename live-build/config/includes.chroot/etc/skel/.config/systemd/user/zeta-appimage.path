# ZETA RAYS — AppImage nel menu da sole: quando in una di queste cartelle
# compare, cambia o sparisce un file, zeta-app integra le AppImage (nome e
# icona letti dal file senza eseguirlo). Lo controlla systemd (inotify):
# nessun processo in piu' resta acceso.
[Unit]
Description=ZETA RAYS: new AppImages in the usual folders

[Path]
# systemd cannot read the XDG folder names: the English and Italian ones are
# both listed (a missing folder is simply not watched)
PathChanged=%h/Applications
PathChanged=%h/Desktop
PathChanged=%h/Applicazioni
PathChanged=%h/Scaricati
PathChanged=%h/Downloads
PathChanged=%h/Scrivania
PathChanged=%h/.local/bin
PathChanged=/opt
MakeDirectory=no
TriggerLimitIntervalSec=10s
TriggerLimitBurst=20

[Install]
WantedBy=default.target

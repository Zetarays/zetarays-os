# ZETA RAYS — AppImages show up in the menu on their own: when a file appears,
# changes or disappears in one of these folders, zeta-app integrates the
# AppImages (name and icon are read from the file without running it). systemd
# does the watching (inotify): no extra process stays running.
[Unit]
Description=ZETA RAYS: new AppImages in the usual folders

[Path]
# systemd cannot read the XDG folder names: the English ones are listed here
# and the Italian names of the same folders are added by the user generator
# /usr/lib/systemd/user-generators/zeta-appimage-folders (a missing folder is
# simply not watched)
PathChanged=%h/Applications
PathChanged=%h/Desktop
PathChanged=%h/Downloads
PathChanged=%h/.local/bin
PathChanged=/opt
MakeDirectory=no
TriggerLimitIntervalSec=10s
TriggerLimitBurst=20

[Install]
WantedBy=default.target

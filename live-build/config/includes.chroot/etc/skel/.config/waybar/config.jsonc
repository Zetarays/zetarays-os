// ZETA RAYS — barra in basso con dock
{
  "layer": "top",
  "position": "bottom",
  "height": 60,
  "margin-left": 12,
  "margin-right": 12,
  "margin-bottom": 12,
  "spacing": 0,

  "modules-left": ["image#launcher", "group/spazi"],
  "modules-center": ["group/dock"],
  "modules-right": ["custom/finestre", "image#search", "image#net", "image#vol", "image#bat", "clock", "image#power"],

  "image#launcher": {
    "exec": "echo $HOME/.config/zeta/launcher.svg",
    "size": 42,
    "signal": 8,
    "tooltip": false,
    "on-click": "zeta-pannello launcher"
  },

  // Finestre ridotte a icona: il modulo compare solo quando ce n'è almeno una
  "custom/finestre": {
    "exec": "zeta-finestre conta", "interval": 30, "signal": 9,
    "tooltip": true, "tooltip-format": "Minimized windows",
    "on-click": "zeta-finestre"
  },

  "image#search": {
    "path": "/usr/share/icons/zeta/scalable/apps/zeta-cerca.svg",
    "size": 18, "tooltip": false, "on-click": "zeta-pannello cerca"
  },

  // Spazi di lavoro. Non si usa "hyprland/workspaces": per attivare uno spazio
  // manda a Hyprland la sintassi storica, che la configurazione in Lua di
  // Hyprland 0.55 rifiuta, e il clic non faceva nulla. zeta-spazi ascolta gli
  // eventi (niente interrogazioni a ripetizione) e usa la sintassi giusta.
  "group/spazi": {
    "orientation": "horizontal",
    "modules": ["custom/spazio1", "custom/spazio2", "custom/spazio3"]
  },
  "custom/spazio1": {
    "exec": "zeta-spazi stato 1", "return-type": "json", "interval": 30, "signal": 10,
    "on-click": "zeta-spazi vai 1", "tooltip": false
  },
  "custom/spazio2": {
    "exec": "zeta-spazi stato 2", "return-type": "json", "interval": 30, "signal": 10,
    "on-click": "zeta-spazi vai 2", "tooltip": false
  },
  "custom/spazio3": {
    "exec": "zeta-spazi stato 3", "return-type": "json", "interval": 30, "signal": 10,
    "on-click": "zeta-spazi vai 3", "tooltip": false
  },

  "group/dock": {
    "orientation": "horizontal",
    "modules": ["image#files", "image#terminal", "image#browser", "image#editor", "image#monitor", "image#security", "image#packages", "image#settings"]
  },
  "image#files":    { "path": "/usr/share/icons/zeta/scalable/apps/org.xfce.thunar.svg",      "size": 42, "tooltip": false, "on-click": "thunar" },
  "image#terminal": { "path": "/usr/share/icons/zeta/scalable/apps/foot.svg",                 "size": 42, "tooltip": false, "on-click": "foot" },
  "image#browser":  { "path": "/usr/share/icons/zeta/scalable/apps/firefox-esr.svg",          "size": 42, "tooltip": false, "on-click": "firefox-esr" },
  "image#editor":   { "path": "/usr/share/icons/zeta/scalable/apps/org.gnome.TextEditor.svg", "size": 42, "tooltip": false, "on-click": "gnome-text-editor" },
  "image#monitor":  { "path": "/usr/share/icons/zeta/scalable/apps/zeta-monitor.svg",         "size": 42, "tooltip": false, "on-click": "zeta-monitor" },
  "image#security": { "path": "/usr/share/icons/zeta/scalable/apps/zeta-sicurezza.svg",       "size": 42, "tooltip": false, "on-click": "zeta-sicurezza" },
  "image#packages": { "path": "/usr/share/icons/zeta/scalable/apps/synaptic.svg",             "size": 42, "tooltip": false, "on-click": "synaptic-pkexec" },
  "image#settings": { "path": "/usr/share/icons/zeta/scalable/apps/zeta-impostazioni.svg",    "size": 42, "tooltip": false, "on-click": "zeta-impostazioni" },

  "image#net": { "exec": "zeta-status net", "interval": 5, "size": 18, "tooltip": false, "on-click": "zeta-pannello rete" },
  "image#vol": { "exec": "zeta-status vol", "interval": 30, "signal": 11, "size": 18, "tooltip": false, "on-click": "zeta-pannello audio",
                 "on-scroll-up": "zeta-volume su", "on-scroll-down": "zeta-volume giu" },
  "image#bat": { "exec": "zeta-status bat", "interval": 30, "size": 20, "tooltip": false, "on-click": "zeta-pannello controllo" },
  "image#power": { "path": "/usr/share/zeta/status/power.svg", "size": 18, "tooltip": false, "on-click": "zeta-pannello energia" },
  "clock": {
    "format": "<span weight='500'>{0:%H:%M}</span>\n<span size='8.5pt' foreground='#8A8A8E'>{0:L%a %d %b}</span>",
    "justify": "right",
    "tooltip-format": "<span size='11pt'>{0:L%A %d %B %Y}</span>\n\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "",
      "format": {
        "months": "<span color='#EDEDEA'><b>{}</b></span>",
        "weekdays": "<span color='#8A8A8E'>{}</span>",
        "today": "<span color='#3A8DFF'><b>{}</b></span>"
      }
    },
    "on-click": "zeta-pannello controllo"
  }
}

---
componentName: zeta
welcomeStyleCalamares: false
welcomeExpandingLogo: false
# noexpand: the window stays 1100x600 and the content scrolls. With «normal»
# the summary with two disks made it grow beyond the screen and the
# Install/Back buttons ended up under the bottom bar.
windowExpanding: noexpand
windowSize: 1100px,600px
windowPlacement: center
strings:
    productName:         ZETA RAYS OS
    shortProductName:    ZETA RAYS
    # The version placeholders are filled in at build time by hook 0100
    # (from the repository's VERSION file, the same as /etc/os-release)
    version:             @VERSION@
    shortVersion:        @VERSION@
    versionedName:       ZETA RAYS OS @VERSION@
    shortVersionedName:  ZETA RAYS @VERSION@
    bootloaderEntryName: ZETA RAYS OS
    productUrl:          ""
    supportUrl:          ""
    knownIssuesUrl:      ""
    releaseNotesUrl:     ""
sidebar: qml
navigation: widget
images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      ""
slideshow:               "show.qml"
style:
   sidebarBackground:    "#000000"
   sidebarText:          "#A1A1A6"
   sidebarTextSelect:    "#EDEDEA"
   sidebarTextHighlight: "#3A8DFF"
slideshowAPI: 2

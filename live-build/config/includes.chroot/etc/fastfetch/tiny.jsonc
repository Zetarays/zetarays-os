// ZETA RAYS — fastfetch configuration, symbol only (14 lines × 60 columns)
// The source drawing is a negative (the fill surrounds the logo): this uses
// the positive rendering, generated by tools/gen-logo-ascii.py, so the
// symbol comes out light on the terminal's black. The drawing was neither
// redrawn nor simplified: only the resolution it is printed at changes.
// The $1 sequences are fastfetch color directives and are not printed.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/zeta/fastfetch/zeta-white-tiny.txt",
    "type": "file",
    "color": { "1": "38;2;255;255;255" },
    "padding": { "top": 0, "left": 0, "right": 3 }
  },
  // Labels and title in the accent color: this keeps the terminal output
  // consistent with the rest of the interface. The symbol stays white: it is
  // the logo, not a colorable element.
  "display": { "separator": "  ", "color": { "keys": "38;2;58;141;255", "title": "38;2;58;141;255" } },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "System     " },
    { "type": "command", "key": "Kernel     ", "text": "uname -r | sed 's/+.*//'" },
    { "type": "uptime", "key": "Uptime     " },
    { "type": "packages", "key": "Packages   " },
    { "type": "shell", "key": "Shell      " },
    { "type": "terminal", "key": "Terminal   " },
    { "type": "wm", "key": "Environment", "format": "ZETA RAYS Shell (Hyprland)" },
    { "type": "cpu", "key": "CPU        " },
    { "type": "gpu", "key": "GPU        " },
    { "type": "memory", "key": "Memory     " },
    { "type": "disk", "key": "Disk       ", "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "localip", "key": "IP         " },
    { "type": "locale", "key": "Language   " },
    "break",
    { "type": "colors", "paddingLeft": 0, "symbol": "circle" }
  ]
}

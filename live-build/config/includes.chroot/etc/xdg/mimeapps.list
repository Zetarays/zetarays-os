# ZETA RAYS — quale programma apre quale tipo di file.
#
# Senza questo elenco il sistema sceglie da solo, e sceglie male: le immagini
# finivano in «display» di ImageMagick (interfaccia X11 di trent'anni fa) e
# molti formati non si aprivano affatto.
#
# Ogni riga qui sotto punta a un programma che è davvero installato: un tipo
# associato a un programma assente è peggio che nessuna associazione, perché
# il doppio clic sembra non fare nulla.

[Default Applications]

# --- Cartelle ---------------------------------------------------------------
inode/directory=thunar.desktop

# --- Testo, codice e dati ---------------------------------------------------
text/plain=org.gnome.TextEditor.desktop
text/markdown=org.gnome.TextEditor.desktop

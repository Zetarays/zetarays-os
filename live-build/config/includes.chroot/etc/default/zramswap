# ZETA RAYS — compressed swap in RAM.
#
# Why it matters: when memory runs out, the kernel moves the least used pages
# to disk. On a slow disk (Mini PCs often ship cheap ones) that is the moment
# the computer seems frozen: every click waits for the disk. With zram the
# same pages are compressed and stay in RAM: no disk, no waiting. The cost is
# a few moments of CPU, which is always available, instead of seconds of
# disk I/O, which is not.
#
# ALGO: zstd compresses about 3:1 versus 2:1 for lz4, at a CPU cost that is
# unnoticeable on a modern processor. With 8 GB of RAM that means roughly
# 4 GB of extra usable space.
ALGO=zstd

# PERCENT: how much memory the zram device may occupy, as a percentage.
# 50 is the safe choice: even when it is completely full, half the memory is
# left for programs. Raising it further does not add headroom, it takes it.
PERCENT=50

# PRIORITY: higher than any on-disk swap, so the kernel uses compressed
# memory first and only touches the disk once that is full.
PRIORITY=100

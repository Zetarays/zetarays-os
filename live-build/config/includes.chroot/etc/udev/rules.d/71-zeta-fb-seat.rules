# ZETA RAYS — graphics adapters without a DRM driver (e.g. VirtualBox "QemuRamFB",
# generic EFI firmware): the kernel offers only the /dev/fb0 framebuffer. Without
# this rule logind doesn't consider the seat "graphical" (CanGraphical=no), SDDM
# waits forever and the screen stays black. With the tag, Xorg starts on the
# framebuffer.
SUBSYSTEM=="graphics", KERNEL=="fb[0-9]*", TAG+="seat", TAG+="master-of-seat"

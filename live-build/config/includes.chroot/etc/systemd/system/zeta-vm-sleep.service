[Unit]
Description=ZETA RAYS - macchine virtuali: sospensione disattivata, audio che parte
DefaultDependencies=no
After=local-fs.target systemd-udev-settle.service
Before=display-manager.service sddm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/zeta-vm-sleep

[Install]
WantedBy=multi-user.target

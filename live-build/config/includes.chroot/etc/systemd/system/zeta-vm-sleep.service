[Unit]
Description=ZETA RAYS - virtual machines: suspend disabled, working audio
DefaultDependencies=no
After=local-fs.target systemd-udev-settle.service
Before=display-manager.service sddm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/zeta-vm-sleep

[Install]
WantedBy=multi-user.target

[Unit]
Description=ZETA RAYS - preparazione ambiente live (utente zeta, autologin)
Before=sddm.service display-manager.service
After=live-config.service systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/zeta-live-setup

[Install]
WantedBy=multi-user.target
